<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-dol-save-backup" version="1.0.0">
    <name>DoL Save Backup</name>
    <js-module src="www/backup.js" name="backup">
        <clobbers target="cordova.plugins.dolSaveBackup" />
    </js-module>
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="DoLSaveBackup">
                <param name="android-package" value="org.dol.savebackup.DoLSaveBackup" />
            </feature>
        </config-file>
        <source-file src="src/android/DoLSaveBackup.java" target-dir="src/org/dol/savebackup" />
    </platform>
</plugin>
