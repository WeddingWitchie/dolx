:: Bailey Eden Lake Confrontation
<<effects>><<pass 5>>
<<person1>>

Eden steps towards you.
<br><br>

<<if edenFreedomStatus() is 0>>
	"There you are," <<nnpc_he "Eden">> says. "I'm glad you're alright."
<<elseif edenFreedomStatus() is 1>>
	"Where have you been?" <<nnpc_he "Eden">> asks. "I was so worried about you."
<<else>>
	"There you are!" <<nnpc_he "Eden">> shouts. "You're in so much trouble, you disobedient whore."
<</if>>
<br><br>

<<if $renttime lte 0>>
	Bailey remarks behind <<nnpc_him "Eden">>, "This one owes me rent."
	<br><br>
	<<link [[Next|Bailey Eden Lake Caught]]>><</link>>
	<br>
<<else>>
	Bailey looks at Eden, ignoring you.
	<br><br>

	Eden's eyes fall to your neck as <<nnpc_he "Eden">> approaches you.
	<br><br>

<<if $worn.neck.name is "Bailey's collar">>
	<<nnpc_He "Eden">> frowns at the lotus flower clasp on your collar.
	<br><br>

	<<nnpc_He "Eden">> spins on <<nnpc_his "Eden">> heel and growls back at Bailey. "You?"
	<br><br>

	Bailey nods, unbothered by Eden's rage. "<<pShes>> mine."
	<<set $bailey_dom += 1>><<npcincr Bailey dom 1>><<gdom "Bailey">><<npcincr Bailey love 1>><<set $bailey_love += 1>><<glove "Bailey">>
	<br><br>

	Eden looks taken aback and furious.
	<<npcincr Eden dom -1>><<ldom "Eden">><<npcincr Eden love -1>><<llove "Eden">>
	<br><br>
<<elseif $worn.neck.name is "naked" and $edencollarremove is 1>>
	"You lost your collar." <<nnpc_He "Eden">> notes, disappointed.
	<br><br>

	<<if $stockholm_active>>
		"Lost mine too." Bailey eyes your neck and scoffs. "And mine costs more."
		<br><br>
	<</if>>
<<elseif $worn.neck.collared is 1 and $worn.neck.type.includes("leash") and $worn.neck.name isnot "Whitney's collar with leash" and $worn.neck.name isnot "familiar collar">>
	<<nnpc_He "Eden">> eyes your collar, hungry.
	<<npcincr Eden lust 1>><<glust "Eden">><<npcincr Eden dom 1>><<gdom "Eden">>
	<br><br>

	<<if $stockholm_active>>
		Bailey glances at your neck before giving Eden a level stare.
		<<set $bailey_dom -= 1>><<npcincr Bailey dom -1>><<ldom "Bailey">>
		<br><br>
	<</if>>
<<elseif $worn.neck.name is "familiar collar">>
	Eden's eyes drop to your neck. <<nnpc_He "Eden">> frowns at the familiar collar. "The witch marked you."
	<br><br>

	<<if $stockholm_active>>
		Bailey eyes your neck too. "<<pShes>> in over <<pher>> head."
		<br><br>
	<</if>>
<<elseif $worn.neck.name is "Whitney's collar" or $worn.neck.name is "Whitney's collar with leash">>
	"Whose collar is that?" Eden barks.
	<br><br>

	<<if $stockholm_active>>
