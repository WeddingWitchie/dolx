:: Bailey Cheats [widget]

<<widget "cheats-bailey">>
	<<run C.npc.Bailey.dom = typeof C.npc.Bailey.dom === "number" && !isNaN(C.npc.Bailey.dom) ? C.npc.Bailey.dom : 50>>
	<<run C.npc.Bailey.love = typeof C.npc.Bailey.love === "number" && !isNaN(C.npc.Bailey.love) ? C.npc.Bailey.love : 0>>
	<<run V.syndromebaileybuild = typeof V.syndromebaileybuild === "number" && !isNaN(V.syndromebaileybuild) ? V.syndromebaileybuild : 0>>
	<<run V.bailey_offered = typeof V.bailey_offered === "number" && !isNaN(V.bailey_offered) ? V.bailey_offered : 0>>
	<<run V.bailey_wraith_seen = typeof V.bailey_wraith_seen === "number" && !isNaN(V.bailey_wraith_seen) ? V.bailey_wraith_seen : 0>>
	<<if $syndromebailey is undefined>><<set $syndromebailey to false>><</if>>
	<<if $bailey_title_unlocked is undefined>><<set $bailey_title_unlocked to false>><</if>>
	<<if $bailey_title is undefined>><<set $bailey_title to "Bailey">><</if>>
	<<if $stockholm_points is undefined>><<set $stockholm_points to {}>><</if>>
	<div class="settingsToggleItem">
		<span class="gold">Core Stats</span>
		<<numberStepper "<<iconUi 'sym-dominance-bailey.png'>> Dominance" `C.npc.Bailey.dom` { callback: value => { C.npc.Bailey.dom = value }, min: 0, max: 100 }>>
		<<numberStepper "<<symbol love>> Respect" `C.npc.Bailey.love` { callback: value => { C.npc.Bailey.love = value }, min: 0, max: 100 }>>
		<<numberStepper "<<symbol lust>> Lust" `C.npc.Bailey.lust` { callback: value => { C.npc.Bailey.lust = value }, min: 0, max: 100 }>>
	</div>
	<div class="settingsToggleItem">
		<span class="gold">Stockholm Syndrome</span>
		<<numberStepper "Stockholm Points" `V.syndromebaileybuild` { callback: value => { V.syndromebaileybuild = value }, min: 0, max: 10, step: 1, percentage: false }>>
		<<numberStepper "Times Offered" `V.bailey_offered` { callback: value => { V.bailey_offered = value }, min: 0, step: 1, percentage: false }>>
		<<numberStepper "Wraith Encounters" `V.bailey_wraith_seen` { callback: value => { V.bailey_wraith_seen = value }, min: 0, step: 1, percentage: false }>>
		<br>
		<<if $syndromebailey>>
			<<link [[Deactivate Stockholm|$passage]]>><<set $syndromebailey to false>><<set $bailey_title to "Bailey">><<if $worn.neck.name is "Bailey's collar">><<set $worn.neck.cursed to 0>><<generalUndress "wardrobe" "neck">><</if>><</link>>
			<br>
			<span class="pink">Removes Bailey's collar from your neck.</span>
		<<else>>
			<<link [[Activate Stockholm|$passage]]>><<set $syndromebailey to true>><<set $syndromebaileybuild to Math.max($syndromebaileybuild, 5)>><<run C.npc.Bailey.dom = Math.max(C.npc.Bailey.dom, 100)>><<set $stockholm_points to ($stockholm_points || {})>><<set $baileycollar to 1>><<if $worn.neck.name is "Bailey's collar">><<set $worn.neck.cursed to 1>><<else>><<if $worn.neck.cursed is 1>><<set $worn.neck.cursed to 0>><</if>><<set _collarIdx to setup.clothes.neck.findIndex(function(item) { return item.name === "Bailey's collar"; })>><<if _collarIdx gte 0>><<neckwear _collarIdx>><</if>><</if>><</link>>
			<br>
			<span class="teal">Fixes Bailey's collar on your neck. Anything worn there is returned to your wardrobe.</span>
		<</if>>
	</div>
	<div class="settingsToggleItemWide">
		<span class="gold">Title System</span> <mouse class="tooltip linkBlue">(?)<span>Lets you pick a custom name for the player to call Bailey (a pet name or honorific), used in Bailey's dialogue. Normally earned through the Stockholm storyline, unlock it here to set a title without progressing that content.</span></mouse>
		<br>
		<<if $bailey_title_unlocked>>
			<<link [[Lock Title System|$passage]]>><<set $bailey_title_unlocked to false>><<set $bailey_title to "Bailey">><</link>>
		<<else>>
			<<link [[Unlock Title System|$passage]]>><<set $bailey_title_unlocked to true>><</link>>
		<</if>>
		<<if $bailey_title_unlocked>>
			<br>
			<span class="description">Current title: <<= $bailey_title>></span>
		<</if>>
	</div>
<</widget>>
