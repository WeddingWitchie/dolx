:: Widgets speech-Bailey Expansion [widget]
<<widget "speech-bailey-expansion">>
	<<set _npc_speech to true>>
	<<set $_baileyPenetratorSize to ((window.C && C.npc && C.npc.Bailey && Number.isFinite(Number(C.npc.Bailey.penissize))) ? Number(C.npc.Bailey.penissize) : 0)>>
	<<set $_baileyColossalPenetrator to $_baileyPenetratorSize gte 5>>
	/* Pre-string: dom-aware, anger-gated */
	<<if $bailey_dom lte 30>>
		<<set $_stringsPre to "<<He>> mocks. ">>
	<<elseif $enemyanger gte 80>>
		<<set $_stringsPre to (random(0,1) is 0 ? "<<He>> spits. " : "<<He>> hisses. ")>>
	<<elseif $enemyanger gte 50>>
		<<set $_options to ["<<He>> snarls. ", "<<He>> growls. ", "<<He>> snaps. "]>>
		<<set $_stringsPre to $_options[random(0, $_options.length - 1)]>>
	<<else>>
		<<set $_stringsPre to (random(0,1) is 0 ? "<<He>> snickers. " : "<<He>> chuckles. ")>>
	<</if>>

	/* VIRGINITY TRIGGERS */
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Bailey") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Bailey")>>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"Still breathing? You should. Damaged goods are harder to sell."`,
				`"Break too badly and you'll cost me money."`,
				`"Now you know what happens when a debt gets collected in full."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $stockholm_active>>
			<<set $_strings to [
				`<<He>> speaks. "You saved it for me, didn't you?" <<He>> says it like <<he>> already knew. "Good <<girl>>. You knew it was always going to be mine."`,
				`<<He>> exhales slowly. "Mine now."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<set $_text_output to `<<He>> exhales slowly. "Mine now."`>>
		<<elseif $bailey_dom lte 30>>
			<<set $_text_output to $_stringsPre + `"That's all you're good for, you little whore."`>>
		<<else>>
			<<set $_text_output to `<<He>> sighs. "Shame. Could've gotten more for you."`>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"If you pass out, this becomes tedious."`,
				`"That's it. Take it, and don't make me write off the loss."`,
				`"You should be grateful I know when to stop. Most buyers don't."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $stockholm_active>>
			<<set $_strings to [
				`<<He>> exhales. "Every part of you belongs to me. Every hole. Every sound. Mine."`,
				`<<He>> speaks. "You'll learn to take it better." <<He>> doesn't slow down. "You have time."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<set $_text_output to `<<He>> speaks. "You'll learn to take it better." <<He>> doesn't slow down. "You have time."`>>
		<<elseif $bailey_dom lte 30>>
			<<set $_text_output to $_stringsPre + `"You should be putting out more if you're this tight." <<He>> grunts. "What do you think you're good for?"`>>
		<<else>>
			<<set $_text_output to $_stringsPre + `"Relax. You'll get used to it."`>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"Choke too hard and I have to start over."`,
				`"Open wider. You're not paid to look delicate."`,
				`"Keep your eyes on me. I want to know you're listening."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $stockholm_active>>
			<<set $_strings to [
				`<<He>> speaks. "You're going to get good at this." A pause. "For me."`,
				`<<He>> speaks. "How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<set $_text_output to `<<He>> speaks. "How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."`>>
		<<elseif $bailey_dom lte 30>>
			<<set $_text_output to $_stringsPre + `"Just shut up and choke on it, you little shit."`>>
		<<else>>
			<<set $_strings to [`"Don't get any funny ideas. Just take it."`, `"Relax. You'll get used to it."`]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Bailey">>
		<<if $stockholm_active>>
			<<set $_strings to [
				`<<He>> speaks. "Mine." <<His>> thumb traces your mouth once, like <<he>>'s marking something. "That was always going to be mine."`,
				`<<He>> speaks. "Again." <<He>> waits. "Open your mouth more."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<set $_text_output to `<<He>> speaks. "Again." <<He>> waits. "Open your mouth more."`>>
		<<elseif $bailey_dom lte 30>>
			<<set $_text_output to $_stringsPre + `"Don't flatter yourself." <<He>> wipes <<his>> mouth with the back of <<his>> hand. "That meant nothing."`>>
		<<else>>
			<<set $_strings to [
				`"First time?" <<He>> smirks. "You'll learn how to use your mouth better."`,
				`"Relax. You'll get used to it."`,
				`"Surprised, are you? You'll learn to kiss better soon."`,
				`"Don't look at me like that. It was only a kiss."`,
				`"Now stop acting like I handed you a present."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>

	/* NAMEDROP */
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if _loveInterest is "Robin">>
				<<if $stockholm_active>>
					<<set $_text_output to `<<His>> eyes darken. "Maybe I should sell <<nnpc_him "Robin">> somewhere you can't find <<nnpc_him "Robin">>."`>>
				<<elseif $robinpaid is 1>>
					<<set $_text_output to $_stringsPre + `"You pay <<nnpc_his "Robin">> debt and <<nnpc_he "Robin">> can't even watch."`>>
				<<elseif C.npc.Robin.dom gte 60>>
					<<set $_text_output to $_stringsPre + `"That brat's grown a spine thanks to you." <<He>> scoffs. "Shame <<nnpc_he "Robin">>'s not coming to save you."`>>
				<<else>>
					<<set $_strings to [
						`"That worthless brat can't save you."`,
						`"What do you expect that waif to do? Cry until I stop?"`,
						`"Robin can't pay what you owe. Sentiment doesn't clear debt."`,
						`"If Robin wants you back, <<nnpc_he "Robin">> should bring cash."`,
					]>>
					<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
		<<elseif _loveInterest is "Eden">>
				<<if $stockholm_active>>
					<<set $_strings to [
						`"Don't say <<nnpc_his "Eden">> name."`,
						`"Say that name again. See what happens."`,
					]>>
					<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
				<<elseif $bailey_dom gte 70>>
					<<set $_text_output to `"Say that name again. See what happens."`>>
				<<else>>
					<<set $_strings to [
						`"You'll be going right back to <<nnpc_him "Eden">> if you keep this up."`,
						`"That hermit had <<nnpc_his "Eden">> chance."`,
						`"<<nnpc_He "Eden">> ran. You're still here."`,
						`"Eden couldn't afford you."`,
					]>>
					<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
		<<elseif ["Black Wolf", "Great Hawk"].includes(_loveInterest)>>
				<<set $_strings to [
					`"People would pay extra to see you ${$player.penisExist ? "fuck" : "get fucked by"} some beast."`,
					`"The deviant crowd pays well. Keep it up."`,
					`"Animals get put down. You get put to work."`,
				]>>
				<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif _loveInterest is "Gwylan">>
				<<set $_strings to [
					`"Careful where you bring that name."`,
					`"Some debts can't be erased. No matter what that fox tells you."`,
					`"That witch doesn't fix anything. <<nnpc_He "Gwylan">> just hides it."`,
					`"The shopkeep pays well. I'll give <<nnpc_him "Gwylan">> that much."`,
				]>>
				<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif _loveInterest is "Whitney">>
				<<if $whitney_bailey_met>>
					<<set $_text_output to $_stringsPre + `"That ${C.npc.Whitney.pronoun is "m" ? "boy" : "girl"}'s on a leash. Mine."`>>
				<<else>>
					<<set $_strings to [
						`"That idiot's useful. Don't confuse that with important."`,
						`"That ankle biter can't help you. <<nnpc_He "Whitney">> can barely help <<nnpc_himself "Whitney">>."`,
						`"Whitney? That one makes trouble for free. I make money from it."`,
						`"Don't hide behind that brat. <<nnpc_He "Whitney">> has debts of <<nnpc_his "Whitney">> own."`,
					]>>
					<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
		<<elseif _loveInterest is "Kylar">>
				<<set $_strings to [
					`"Call for <<nnpc_him "Kylar">> louder. Maybe <<nnpc_hes "Kylar">> outside the window."`,
					`"That little freak is probably watching. Let <<nnpc_him "Kylar">>."`,
				]>>
				<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif _loveInterest is "Sydney">>
				<<if C.npc.Sydney.purity lt 0>>
					<<set $_text_output to $_stringsPre + `"You ruined <<nnpc_him "Sydney">>. You're more like me than you think."`>>
				<<else>>
					<<set $_strings to [
						`"Save it for confession."`,
						`"That brat would pray for you. I'd rather <<nnpc_he "Sydney">> paid for you."`,
					]>>
					<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
		<<elseif _loveInterest is "Avery">>
				<<if $avery_fate is "saved">>
					<<set $_text_output to $_stringsPre + `"<<nnpc_He "Avery">>'d have let you fall."`>>
				<<else>>
					<<set $_strings to [
						`"<<nnpc_He "Avery">> paid for the privilege. I don't have to."`,
						`"Call for <<nnpc_him "Avery">>. See if <<nnpc_his "Avery">> money reaches this far."`,
					]>>
					<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
		<<elseif _loveInterest is "Alex">>
				<<set $_strings to [
					`"What do you think that idiot ${C.npc.Alex.pronoun is "m" ? "cowboy" : "cowgirl"} is going to do?"`,
					`"That drunk couldn't find you if you were standing in <<nnpc_his "Alex">> field."`,
					`"Your farmer's probably face-down in a bottle somewhere."`,
				]>>
				<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
				<<set $_text_output to $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
		<</if>>

	/* BODY DISCOVERY */
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<set $_strings to [
			`"Hit me again and I'll add it to your rent."`,
			`"That little outburst just cost you."`,
			`"I will charge extra for difficult stock."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<set $_strings to [
			`"Look at me while you do it. I want to see you understand."`,
			`"Less noise. More use."`,
			`"That's better."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<set $_strings to [
				`"Clawing me now? That's damage, time, and trouble. I'll add all three to your account."`,
				`"You little shit. Do you know how expensive difficult stock becomes?"`,
				`"That's the problem with you. Always finding new ways to make yourself less profitable."`,
				`"Fine. If you want to act feral, I'll handle you like something that bites."`,
			]>>
			<<set $enemyanger += 20>><<set $enemytrust -= 35>>
		<<else>>
			<<set $_strings to [
				`"Scratching now?"`,
				`"Marks lower value unless someone's paying extra for them."`,
				`"That's one way to negotiate. A stupid one."`,
				`"Hit, scratch, bite, it doesn't matter. Debt still gets collected."`,
			]>>
			<<set $enemyanger += 10>><<set $enemytrust -= 20>>
		<</if>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechgenitals is 1>>
		<<set $_strings to [
			`<<He>> looks at your <<genitals>> with an appraising eye.`,
			`<<He>> examines your <<genitals>> like something <<he>> owns. "Not bad."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length-1)]>>
	<<elseif $speechbreasts is 1>>
		<<if $player.breastsize lte 7>>
			<<set $_strings to [
				`<<He>> looks at your chest. "Modest. Doesn't matter. You'll still sell."`,
				`<<He>> runs a hand over your chest. "Not much there. Enough for the right buyer."`,
				`<<He>> glances at your chest. "Small. Some prefer that."`,
			]>>
		<<else>>
			<<set $_strings to [
				`<<He>> looks at your <<breasts>> with an appraising eye.`,
				`<<He>> looks at your <<breasts>>. "Those'll do."`,
				`<<He>> weighs your <<breasts>> in <<his>> hands. "Not bad."`,
			]>>
		<</if>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length-1)]>>
	<<elseif $speechpregnant is 1 and $settings.pregnancySpeechEnabled>>
		<<if $pregnancyStats.playerBirths gte 1>>
			<<set $_text_output to `<<He>> sighs at your pregnant belly. "Knocked up. Typical."`>>
		<<elseif $enemyanger lte 20>>
			<<set $_strings to [
				`<<He>> frowns at your pregnant belly. "I hope you weren't planning on taking time off."`,
				`"Pregnant." <<He>> looks you over. "You're still working."`,
				`"You can still earn your keep like this."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
			<<set $_strings to [
				`"Great. Another mouth I can't afford."`,
				`"Knocked up and still causing trouble."`,
				`"Use protection next time."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`"You couldn't keep your legs together or use protection?" <<He>> scoffs. "Worthless little whore."`,
				`"You let someone do this to you?"`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>

	/* PC ACTIONS */
	<<elseif $speechplead is 1>>
		<<if $bailey_dom gte 70 and random(0,2) is 0>>
			<<set $_text_output to $_stringsPre + `"Beg harder. Maybe I'm feeling generous."`>>
		<<elseif $enemyanger lte 20>>
			<<set $_strings to [
				`"Quit whining. You'll live."`,
				`"Save your breath."`,
				`"Stay still. Let me handle it."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
			<<set $_strings to [
				`"You owe me this."`,
				`"You're done when I say you're done."`,
				`"Begging won't change what you owe me."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`"You'll shut up and take it if you know what's good for you."`,
				`"Every word out of your mouth adds to what you owe."`,
				`"Begging won't save you, you little shit."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechmoan is 1>>
		<<if $bailey_dom lte 30>>
			<<set $_strings to [
				`"Save the moaning for the customers."`,
				`"Shut up. I don't need the racket."`,
				`"Save the racket for someone who pays."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $bailey_dom gte 70>>
			<<set $_strings to [
				`"Every sound you make is mine."`,
				`"Don't hold your voice back. Let me hear them."`,
				`"There it is. Let it out."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 20>>
			<<set $_strings to [
				`"Good to know what works."`,
				`"This is what makes you valuable."`,
				`"Louder. Let's hear it."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
			<<set $_strings to [
				`"Keep it down."`,
				`"I don't need the noise."`,
				`"Just take it."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`"Not another sound, you little shit."`,
				`"Shut your mouth, brat."`,
				`"One more sound and I'll give you something to moan about."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechdemand is 1>>
		<<if $enemyanger lte 20>>
			<<set $_strings to [
				`"You're in no position to negotiate."`,
				`"You've got nerve. I'll give you that."`,
				`"Did you think that would work?"`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
			<<set $_strings to [
				`"You don't give orders here."`,
				`"That mouth is going to cost you, brat."`,
				`"You're not in a position to demand anything."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`"Mouthy little shit."`,
				`"Shut your goddamn mouth."`,
				`"You don't get to make demands. You never did."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechscream is 1>>
		<<set $speechscream to 0>>
		<<if $enemyanger lte 50>>
			<<set $_strings to [
				`"Shut up. Be quiet."`,
				`"No one's coming."`,
				`"Who exactly do you think is going to help you?"`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`<<He>> slaps you. "Shut up."`,
				`<<He>> slaps you. "You're being noisy."`,
				`<<He>> slaps you. "Be. Quiet."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechforgive is 1>>
		<<if $stockholm_active>>
			<<set $_text_output to `<<His>> rhythm falters. <<He>> presses <<his>> mouth into a hard line but does not answer.`>>
		<<elseif $enemyanger lte 20>>
			<<set $_strings to [
				`"I don't need your forgiveness."`,
				`"Shut up."`,
				`"Shut it."`,
			]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
			<<set $_strings to [
				`"Forgive me?" <<He>> sneers. "For what."`,
				`"Shut the hell up."`,
				`"Save it."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`"Shut your goddamn mouth and take it."`,
				`"Close your damn mouth or I'll close it for you."`,
			]>>
			<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechgrowl is 1 or $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<if $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<set $_strings to [
			`"Your body's already given in. The rest of you can follow."`,
			`"I have buyers who'd pay big to see you like this."`,
			`"Pull yourself together."`,
			`"Look at you. Can't even keep yourself together."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 20>>
		<<set $_strings to [
			`"This is what I get for taking in strays."`,
			`"Down, <<girl>>."`,
			`"Sit."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $enemyanger lte 100>>
		<<set $_strings to [
			`"Are you going to be difficult?"`,
			`"You little mutt."`,
			`"A muzzle would suit you."`,
		]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
		<<set $_strings to [
			`"I'll give you something to make noise about."`,
			`"Do it. Bite. See what it costs you."`,
			`"Put those away." <<He>> looks at your fangs. "Or I'll file them down."`,
		]>>
		<<set $_text_output to $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechapologiseunforgiving is 1>>
		<<set $speechapologiseunforgiving to 0>>
		<<if $enemyanger lte 100>>
			<<set $_strings to [`"Shut up. I've heard it all before."`, `"Save it. If you were sorry, you'd stop struggling."`]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [`"Do you think I give a damn, you little shit?"`, `"Did you really think I would fall for that?"`]>>
			<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<elseif $speechpenissmall is 1>>
		<<set $speechpenissmall to 0>>
		<<set $_strings to [`"Worthless. You'll have to earn with your holes, then."`,
																							`"Disappointing. That's not a dick, it's a clit."`]>>
		<<set $_text_output to $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
