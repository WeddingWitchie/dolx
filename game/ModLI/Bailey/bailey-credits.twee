:: Bailey Expansion Credits [widget]
/* I tidy up the credit and, uh, using it as addition mod credit. Sorry and thanks! */
<<widget "BaileyExpansionCredits">>
	<div class="credits-content credits-mods">
		<div class="credit-hero">
			<span class="credit-hero-icon" aria-hidden="true">&#9881;</span>
			<div><span>INTEGRATED MODS</span><strong>Creators and Contributors</strong></div>
		</div>
		<section class="credit-section">
			<h2><span aria-hidden="true">&#9881;</span> Bailey Expansion Mod</h2>
			<div class="credit-grid">
				<div class="credit-row"><span>Creator</span><strong>Reiyu GuiGui</strong></div>
				<div class="credit-row"><span>Version</span><strong>
				<a href="https://gitgud.io/reiyu/reiyusbaileyexpandedmod">0.6.3</a></strong></div>
				<div class="credit-row"><span>Links</span>
					<div class="credit-links">
						<a href="https://dolmodding.miraheze.org/wiki/Reiyu%27s_Bailey_Expansion_Mod">RBE's Dolmodding Wiki Page</a>
						<a href="https://tumblr.com/dokidokibailey">Reiyu's Tumblr</a>
						<a href="https://archiveofourown.org/users/ReiyuGuiGui">Reiyu's Ao3</a>
					</div>
				</div>
			</div>
		</section>
		<div class="credit-columns">
			<section class="credit-section">
				<h2><span aria-hidden="true">&#10022;</span> Modded LI: Poppy (OPIUM)</h2>
				<div class="credit-grid">
					<div class="credit-row"><span>Lead Writer</span><strong>Toaster</strong></div>
					<div class="credit-row"><span>Lead Coder</span><strong>D.N.A.</strong></div>
					<div class="credit-row"><span>Artist</span><strong>Kmagi</strong></div>
					<div class="credit-row"><span>Artist</span><strong>Lore&#95;potato</strong></div>
					<div class="credit-row"><span>Co-Writer</span><strong>Sakura</strong></div>
					<div class="credit-row"><span>BetaReader</span><strong>Tom</strong></div>
					<div class="credit-row"><span>Contributor</span><strong>Sei/Karl Sendis</strong></div>
				</div>
			</section>
			<section class="credit-section">
				<h2><span aria-hidden="true">&#10022;</span> Other Integrated Mods</h2>
				<div class="credit-grid">
					<div class="credit-row"><span>Dye harder hairmod</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>Wraith Addition</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>Custom makeup</span><strong>Sasa</strong></div>
					<div class="credit-row"><span>Realistic Childbirthing</span><strong>Psayne</strong></div>
					<div class="credit-row"><span>Magical Menagerie</span><strong>Grimace &amp; Zerolefox</strong></div>
					<div class="credit-row"><span>Papperdoll+</span><strong>YazawaHY</strong></div>
					<div class="credit-row"><span>HGP hairmask</span><strong>Llynkurin</strong></div>
				</div>
			</section>
		</div>
		<section class="credit-section">
			<h2><span aria-hidden="true">&#10022;</span> Transformation Credits</h2>
			<div class="credit-columns">
				<details class="credit-details" open>
					<summary><span>Water Dragon TF</span></summary>
					<div class="credit-grid">
						<div class="credit-row"><span class="teal">Creator</span><strong>NovaCyber</strong></div>
						<div class="credit-row"><span class="teal">Coders</span><strong>Isari &amp; D.N.A.</strong></div>
						<div class="credit-row"><span class="teal">Art</span><strong>Sam Storiez</strong></div>
						<div class="credit-row"><span class="teal">Vanilla Melusine wings</span><strong>Zero&#95;Otherian</strong></div>
						<div class="credit-row"><span class="teal">GooseMasc Art</span><strong>Mad.W.D</strong></div>
						<div class="credit-row"><span class="teal">Chimera TF Melusine GooseFem Art</span><strong>Axos (set) &amp; Cici (wings)</strong></div>
						<div class="credit-row"><span class="teal">Fixer</span><strong>Bec &amp; D.N.A.</strong></div>
					</div>
				</details>
				<div>
					<details class="credit-details" open>
						<summary><span>Bunny TF</span></summary>
						<div class="credit-grid">
							<div class="credit-row"><span class="pink">Creator</span><strong><a href="https://ko-fi.com/pro_penlicker">WinterPeach</a></strong></div>
							<div class="credit-row"><span class="pink">Sprite Makers</span><strong>Pinzya, Mellows, Phreia</strong></div>
							<div class="credit-row"><span class="pink">Special Thanks</span><strong>Frostberg &amp; purepersona&#95;moon</strong></div>
						</div>
					</details>
					<details class="credit-details" open>
						<summary><span>Cat Chimera TF</span></summary>
						<div class="credit-grid">
							<div class="credit-row"><span class="purple">Coders</span><strong>D.N.A.</strong></div>
							<div class="credit-row"><span class="purple">Vanilla CatSith Art</span><strong>FoxIsASalmon!?</strong></div>
							<div class="credit-row"><span class="purple">Writer</span><strong>Cappy &amp; D.N.A.</strong></div>
						</div>
					</details>
				</div>
			</div>
		</section>
	</div>
<</widget>>
