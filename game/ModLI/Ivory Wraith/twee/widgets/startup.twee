:: WLI init [widget]

<<widget "wliInit">>
	<<if $wli is undefined>>
		<<set $wli to {}>>
	<</if>>
	<<if $wli.cfg is undefined>>
		<<set $wli.cfg to {}>>
	<</if>>
	<<if $wli.cfg.bodywritinglvl is undefined>>
		<<set $wli.cfg.bodywritinglvl = 1>>
	<</if>>
	<<if $wli.cfg.tattoodream is undefined>>
		<<set $wli.cfg.tattoodream = false>>
	<</if>>
	<<if $wli.cfg.tattoobypass is undefined>>
		<<set $wli.cfg.tattoobypass = false>>
	<</if>>
	<<if $wli.cfg.nosocialrng is undefined>>
		<<set $wli.cfg.nosocialrng = false>>
	<</if>>
	<<if $wli.cfg.notentacles is undefined>>
		<<set $wli.cfg.notentacles = false>>
	<</if>>

	<<if $wli.criteria is undefined>>
		<<set $wli.criteria to 0>>
		<<wliCheckCriteria>>
	<</if>>
	<<if $wli.giftevent is undefined>>
		<<set $wli.giftevent to 0>>
	<</if>>
	<<if $wli.stability is undefined>>
		<<set $wli.stability to 0>>
	<</if>>
<</widget>>
