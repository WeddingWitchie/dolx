:: Widgets End Combat [widget]

<<widget "endcombat">>
	<<petCombatEnd>>

	/* Heat's per-turn control marker never outlives the fight it was set in. */
	<<if $xchange?.heat>>
		<<set $xchange.heat.controlActive to false>>
	<</if>>

	/* Safety net for the Wraith's mid-combat grip. */
	<<if $wraithGrip>>
		<<unset $wraithGrip>>
		<<wraithExorcise true true>>
	<</if>>

	<<combatRecapDisplay>>

	<<if $breederOrgasm>>
		<<willpower-recovery 500>>
		<<unset $breederOrgasm>>
	<<elseif !$statFreeze and playerIsXChanged() and ($xchange.pill.breederEffect or $xchange.pill.omegaEffect)>>
		<<set _recoveryMult to Math.min($orgasmcount, 5)>>
		<<set _recoveryBase to 10>>
		<<set _recovery to _recoveryBase * _recoveryMult>>
		<<willpower-recovery _recovery>>
	<<elseif $masturbating or $consensual is 1>>
		<<set _recoveryMult to Math.min($orgasmcount, 4)>>
		<<set _recoveryBase to Math.max(50, $willpower * 0.1)>>
		<<set _recovery to _recoveryBase * _recoveryMult>>
		<<willpower-recovery _recovery>>
	<<else>>
		<<willpower-recovery 50>>
	<</if>>

	<<if $orgasmcurrent gt 0>>
		<<set $pleasure to 0>>
		<<set $arousal to 0>>
	<</if>>

	<<if $enemyhealth lte 0 and !_masturbationEnded>>
		/* Beating Whitney in a fight permanently unlocks the eager options in Whitney's scenes. */
		<<if $whitneySeen and $NPCList?.some((npc, index) => namedNpcInSlot(index) is "Whitney")>>
			<<run $whitneySeen.pushUnique("fightVictory")>>
		<</if>>
		<<if $enemytype is "man">>
			<<famescrap `$enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.125))`>>
		<</if>>
		<<if $audiencepresent is 1>>
			<<set _fame to 10 * ($enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.125)))>>
			<<famescrap _fame>>
		<</if>>
		<<set $enemiesDefeatedStat += $enemynomax>>
		<<if $enemynomax gte 1>>
			/* Use the highest enemy HP reached during this fight. */
			<<set _featHP to Math.max(Number($permenemyhealthmax) || 0, Number($enemyhealthmax) || 0)>>
			<<if _featHP gte 600>>
				<<earnFeat "Starting Point">>
			<</if>>
			<<if _featHP gte 1200>>
				<<earnFeat "One Step">>
			<</if>>
			<<if _featHP gte 2500>>
				<<earnFeat "One Leap">>
			<</if>>
			<<if _featHP gte 5000>>
				<<earnFeat "Five Thousand">>
			<</if>>
			<<if _featHP gte 10000>>
				<<earnFeat "Ten Thousand">>
			<</if>>
			<<if _featHP gte 20000>>
				<<earnFeat "Twenty Thousand">>
			<</if>>
			<<if _featHP gte 50000>>
				<<earnFeat "Fifty Thousand">>
			<</if>>
			<<if _featHP gte 100000>>
				<<earnFeat "One Hundred Thousand">>
			<</if>>
			<<if _featHP gte 200000>>
				<<earnFeat "Two Hundred Thousand">>
			<</if>>
			<<if _featHP gte 500000>>
				<<earnFeat "Five Hundred Thousand">>
			<</if>>
			<<if _featHP gte 1000000>>
				<<earnFeat "One Million">>
			<</if>>
			<<if $encounterHit is undefined>>
				<<earnFeat "Hitless">>
			<</if>>
			<<if $NPCList[0].fullDescription is "Ivory Wraith" and $wraith.type is "man">>
				<<earnFeat "Ghost Buster">>
			<</if>>
		<</if>>
	<</if>>

	<<set _mod to 1>>
	<<if $backgroundTraits.includesAny("nerd", "insanity")>>
		<<set _mod *= 0.50>>
	<</if>>
	<<if $backgroundTraits.includes("delinquent")>>
		<<set _mod *= 1.50>>
	<</if>>
	<<if _masturbationEnded>>
		/* Masturbation isn't a fight, no brawling gain. */
	<<elseif $enemyhealth lte 0 and $enemynomax gte 1>>
		<<if $combatExtended.brawlingToggle is 1>>
			<<set _mod *= autismStatGainMultiplier("brawling", 5)>>
			<<if $combatExtended.brawling gt 1000 or $AMCTraits.halfGain is 1>>
				<<set $combatExtended.brawling += 5 * $enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.25)) / $AMCTraits.brawling * (($statGainMult / 100) * (1 + 0.5 * $featsBoosts.upgrades.transcend / 100)) * _mod>>
			<<else>>
				<<set $combatExtended.brawling += 5 * $enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.25)) * (($statGainMult / 100) * (1 + 0.5 * $featsBoosts.upgrades.transcend / 100)) *_mod>>
			<</if>>
			<span class="green">Your brawling skills improve.</span>
			<br>
		<</if>>
	<<elseif $enemyhealth lte ($permenemyhealthmax - 100) and $enemynomax gte 1>>
		<<if $combatExtended.brawlingToggle is 1>>
			<<set _mod *= autismStatGainMultiplier("brawling", 5)>>
			<<if $combatExtended.brawling gt 1000 or $AMCTraits.halfGain is 1>>
				<<set $combatExtended.brawling += (5 * $enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.25)) / $AMCTraits.brawling * (($statGainMult / 100) * (1 + 0.5 * $featsBoosts.upgrades.transcend / 100))) * 0.33 * _mod>>
			<<else>>
				<<set $combatExtended.brawling += (5 * $enemynomax * ($enemynomax * (1 + ($enemynomax - 1) * 0.25)) * (($statGainMult / 100) * (1 + 0.5 * $featsBoosts.upgrades.transcend / 100))) * 0.33 * _mod>>
			<</if>>
			<span class="green">Your brawling skills improve.</span>
			<br>
		<</if>>
	<</if>>

	<<if $demonabsorb gte 1 and !$stalk>>
		<<if $enemytype is "tentacles" or $enemytype is "struggle">>
			<<pain `-(5 * $demonabsorb)`>>
			<<set $stress -= (300 * $demonabsorb)>>
		<<else>>
			<<set $trauma -= (500 * $demonabsorb)>>
		<</if>>
		<<willpower-recovery `100 * $demonabsorb`>>
		<span class="lewd">You absorb the sexual essence. You feel soothed and reinvigorated.</span>
		<<set $demonabsorb to 0>>
		<<traumaClamp>>
		<<set _br to true>>
		<br>
	<</if>>

	/* Unbind any leg shackles applied during consensual sex via <<shackle_legs>>. Last check avoids removing a shackle that was destroyed before end of combat */
	<<if $legsShackledDuringCombat and $consensual is 1 and ($worn.feet.type.includes("shackle") and $worn.feet.name isnot "vines")>>
		You hear the click of a key as your $worn.feet.name are removed.
		<<remove_shackle>>
		<<set _br to true>>
		<br>
	<</if>>

	/* Check if combat is active before collecting samples to avoid collecting samples when endcombat is called while combat is not active */
	<<if $combat is 1>>
		<<if ($enemypleasure gte $enemypleasuremax || $enemyejaculated gte 1) and canCollectSamples() and !($enemytype is "plant" and $abomination is 1) and !($enemytype is "tentacles" and ["vine","root","shoot"].includes($tentacles[0]?.type)) and !$beastRitual>>
			<<set $_samplesCollected to 0>>
			<<for $_sample to 0; $_sample lt $enemyno; $_sample++>>
				<<if canCollectSampleSingle(V.NPCList[$_sample]?.type)>>
					<<if canCollectSamples() is "bound">>
						/* Ensures the bound message only shows if the player could have collected samples otherwise */
						<<set $_samplesCollected to "bound">>
						<<break>>
					<<else>>
						<<set $_sampleAmount to $npcOrgasmState?.[$_sample]?.count gte 2 ? 2 : 1>>
						<<set $_samplesToCollect to collectSample(V.NPCList[$_sample]?.type, $_sampleAmount)>>
						<<if $_samplesToCollect>>
							<<set $_samplesCollected += $_samplesToCollect>>
						<</if>>
					<</if>>
				<</if>>
			<</for>>
			<<if $_samplesCollected is "bound">>
				<span class="red">With your arms bound, you're unable to take a sample of lewd fluid.</span>
				<<set _br to true>>
				<br>
			<<elseif $_samplesCollected>>
				<<if $location is "forest_shop_garden">>
					<span class="green">Gwylan helps you collect the fluids in vials.</span> <<npcincr Gwylan lust 1>><<glust>><br>
				<<else>>
					<span class="lewd">You collect as much lewd fluid as you can in the vials <<if isGwylanAbsent() is "nobody">>Nobody<<else>>Gwylan<</if>> gave you.</span>
				<</if>>
				You obtain <span class="gold"><<number $_samplesCollected>></span> <<pluralise $_samplesCollected "sample">> of fluid.
				<<set _br to true>>
				<br>
			<</if>>
		<<elseif ($enemytype is "plant" and $abomination is 1 or $enemytype is "tentacles" and ["vine","root","shoot"].includes($tentacles[0]?.type)) and canCollectSamples() and canCollectSampleSingle("plant")>>
			<<if canCollectSamples() is "bound">>
				<span class="red">With your arms bound, you're unable to take a sample of nectar.</span>
				<<set _br to true>>
				<br>
			<<else>>
				<<set $_sampleMod to $location is "forest_shop_garden" and $beastRitual ? 1.3 : 1>>
				<<set $_fromTentacles to $combat_tentacle_record?.fluid || 1>>
				<<set $_nectarCollected to Math.ceil((1 + $_fromTentacles / 9) * $_sampleMod)>>
				/* collectSample returns what Gwylan still had room for, which is what the PC actually keeps. */
				<<set $_samplesToCollect to collectSample("plant", $_nectarCollected) || 0>>
				<<if $_samplesToCollect gt 0>>
					<<if $location is "forest_shop_garden">>
						<span class="green">Gwylan helps you collect the nectar in vials.</span> <<npcincr Gwylan lust 1>><<glust>><br>
					<<else>>
						<span class="lewd">You collect as much nectar as you can in the vials Gwylan gave you.</span>
					<</if>>
					You obtain <span class="gold"><<number $_samplesToCollect>></span> <<pluralise $_samplesToCollect "sample">> of nectar.
					<<set _br to true>>
					<br>
				<</if>>
			<</if>>
		<</if>>
	<</if>>

	/* $sexavoid/$rapeavoid only clear on penetration, so tribbing and oral are caught by either side climaxing. */
	<<set _hadSex to !_masturbationEnded and ($sexavoid is 0 or $rapeavoid is 0 or $orgasmcurrent gt 0 or $combatRecap?.npcOrgasms gt 0)>>

	<<if _hadSex and $npc.includes("Great Hawk") and !$activeNightmare>>
		<<earnFeat "Mate for life">>
	<</if>>

	<<if $transformationParts.traits.mateForLife isnot "disabled" and _hadSex and $consensual is 1>>
		<<if $enemyno is 1 and isLoveInterest($npc[$npcrow.indexOf(0)])>>
			<<if effectiveTransformationLevel("fox") gte 3>>
				<<transform fox 1>>
			<</if>>
			<<stress -10>><<trauma -5>>
			<span class="lewd">Copulating with your chosen partner fulfils an instinctual desire.</span><<llstress>><<ltrauma>>
			<<set _br to true>>
			<br>
		<</if>>
	<</if>>

	<<if $whitneyLovedBeingRapedByPC>>
		<span class="gold">Whitney won't admit it, but you know <<nnpc_he "Whitney">> felt really good.</span><<npcincr Whitney love 3>><<gglove "Whitney">>
		<<unset $whitneyLovedBeingRapedByPC>>
		<br><br>
	<</if>>

	<<if $assertive gte 1>>
		You were
		<<if $assertive lte 5>>
			<span class="pink">slightly</span>
		<<elseif $assertive lte 10>>
			<span class="pink">a little</span>
		<<elseif $assertive lte 30>>
			<span class="purple">somewhat</span>
		<<elseif $assertive lte 40>>
			<span class="blue">quite</span>
		<<elseif $assertive lte 50>>
			<span class="lblue">pretty</span>
		<<elseif $assertive lte 60>>
			<span class="teal">very</span>
		<<else>>
			<span class="green">extremely</span>
		<</if>>
		assertive.

		<<if $assertiveaction isnot 0 and $assertiveaction isnot undefined>>
			<<if $assertiveaction is "trauma">>
				<<set $trauma -= $assertive>>
				<span class="meek">I'm so naughty.</span>
				<<ltrauma>>
				<<traumaClamp>>
				<br>
			<<elseif $assertiveaction is "stress">>
				<<set $stress -= ($assertive * 10)>>
				<span class="green">That was fun.</span>
				<<lstress>>
				<br>
			<<elseif $assertiveaction is "submissive">>
				<<sub `($assertive / 40)`>>
				<<if $enemytype is "beast">>
					<<if $NPCList[0].type is "wolf">>
						<<set _plural_beast_type to "wolves">>
					<<elseif $NPCList[0].type is "fox">>
						<<set _plural_beast_type to "foxes">>
					<<else>>
						<<set _plural_beast_type to $NPCList[0].type + "s">>
					<</if>>
					<span class="meek">It's nice to make _plural_beast_type feel good.</span>
				<<elseif $enemytype is "tentacles">>
					<span class="meek">It's nice to make tentacles feel good.</span>
				<<elseif $enemytype is "struggle">>
					<span class="meek">It's nice to make creatures feel good.</span>
				<<else>>
					<span class="meek">It's nice to make people feel good.</span>
				<</if>>
				<br>
			<<elseif $assertiveaction is "defiant">>
				<<def `($assertive / 40)`>>
				<span class="brat">It's nice to be in control.</span>
				<br>
			<</if>>
			<<set $assertive to 0>>
			<<set _br to true>>
		<</if>>

	<</if>>

	<<if $orgasmCum gt 0>>
		<<set $arousal to 0>>
	<</if>>

	<<clamp>>
	
	<<if $stalk_end is "escaped" or $stalk_end is "hide" or $stalk_end is "ambush">>
		<<if $transformationParts.traits.chase isnot "disabled">>
			Your heart races.
			<span class="green">The thrill of the chase invigorates you.</span>
			<<if $stalk_taunted is "success">>
				<span class="green">Especially thanks to your bold provocation.</span> <<transform fox 1>><<promiscuity2>>
			<<else>>
				<<lstress>><<garousal>>
				<br>
				<<set _br to true>>
			<</if>>
			<<stress -8>><<arousal 200>><<transform fox 1>>
		<<elseif $stalk_taunted is "success">>
			Your heart races. <span class="green">Escaping after such a bold provocation invigorates you.</span> <<transform fox 1>><<promiscuity2>>
		<</if>>
	<</if>>

	<<if $crittermagnettrait gte 1 and ["swarm", "struggle"].includes($enemytype) and ($rapeavoid is 0 or $sexavoid is 0)>>
		<span class="lewd">Giving yourself to the critters leaves you calm and satisfied.</span>
		<<stress -10>><<trauma -5>><<llstress>><<ltrauma>>
		<br>
	<</if>>
	<<if $critterMagnetStripped>>
		<<clotheson>>
		<<unset $critterMagnetStripped>>
	<</if>>

	<!-- Angry human opponents can lock the player up at the end of a lost encounter, or take the key to a device already being worn. Named NPCs remain recorded as the holder. Both rolls scale with $settings.npcChastityLevel and stop entirely at 0. -->
	<<if $combat is 1 and $enemytype is "man" and $consensual isnot 1 and $enemyhealth gt 0 and $enemyanger gte $enemyangermax * 0.6 and !$alarm and !$rescue and !["Gwylan", "Robin", "Kylar"].includes($NPCList[0]?.fullDescription)>>
		<<set _chastityHolder to $NPCList[0]?.fullDescription || $NPCList[0]?.description || "attacker">>
		<<person1>>
		<<if playerChastity() and $worn.genitals.chastityKey is "player" and random(1, 100) lte npcChastityChance(13)>>
			<<switch _chastityHolder>>
				<<case "Whitney">>
					Whitney spots the key as you gather yourself. <<He>> snatches it before you can react and pockets it with a vicious grin. "You can ask nicely when you want out, slut."
				<<default>>
					The <<person>> spots the key to your $worn.genitals.name and tears it from your grasp. <span class="red">"<<= _chastityHolder is "attacker" ? "You won't be needing this." : "I'll hold onto this." >>"</span>
			<</switch>>
			<<loseChastityControl "stolen" _chastityHolder>>
			<br>
		<<elseif !playerChastity() and random(1, 100) lte npcChastityChance(15)>>
			<<switch _chastityHolder>>
				<<case "Whitney">>
					Whitney produces a chastity device and shoves you down. "Maybe this'll teach you to stop pissing me off." <<He>> locks it around you and pockets the key.
				<<default>>
					Still furious, the <<person>> pins you down and fastens a chastity device around your <<genitals>>. <span class="red">The lock clicks shut, and <<he>> keeps the key.</span>
			<</switch>>
			<<forceChastityFit _chastityHolder>>
			<br>
		<</if>>
	<</if>>

	<<unset $enemytype>>
	/* Insanity trait: clear per-combat state before the trauma update below, so full out-of-combat dissociation returns immediately and the next consensual encounter gets a fresh panic roll */
	<<unset $insanityDissociationLucid>><<unset $insanityDissociationTurns>><<unset $insanityConsensualPanicChecked>><<unset $oralStrainTurns>>
	<<updatePlayerTraumaState>>

	<<endevent _args[0]>>
	<<struggle_end>>

	<<set $enemytrust to 0>>
	<<set $combat to 0>>
	<<set $rapeavoid to 1>>
	<<set $sexavoid to 1>>
	<<set $orgasmdown to 0>>
	<<set $orgasmCum to 0>>
	<<set $femaleclimax to 0>>
	<<set $penisbitten to 0>>
	<<set $mouthsubmit to 0>>
	<<set $breastbitten to 0>>
	<<set $apologised to 0>>
	<<unset $removed>>
	<<unset $bodywriting_special>>
	<<unset $machine_tattoo_success>>
	<<unset $dodging>>
	<<unset $feet_planted>>
	<<unset $left_guard>>
	<<unset $right_guard>>
	<<unset $speechspraycycleplant>>
	<<unset $newlyWritten>>
	<<unset $combatBegun>>
	<<unset $combatPhase>>
	<<unset $fightTargets>>
	<<unset $pounce_delay>>
	<<unset $hypnosis_deviancy_check>>
	<<unset $animOverride>>
	<<unset $encounterDialogue>>
	<<unset $safeWordEncounter>>
	<<unset $playerWasSpikedInEncounter>>

	<<if $player.penisExist>>
		<<set $penisstate to 0>>
		<<set $penisuse to 0>>
	<<else>>
		<<set $penisstate to "none">>
		<<set $penisuse to "none">>
	<</if>>
	<<if $player.vaginaExist>>
		<<set $vaginastate to 0>>
		<<set $vaginause to 0>>
	<<else>>
		<<set $vaginastate to "none">>
		<<set $vaginause to "none">>
	<</if>>
	<<if playerHasStrapon()>>
		<<set $penisstate to 0>>
		<<set $penisuse to 0>>
		/*<<if $playerPenisSizeBackup isnot undefined>>
			<<set $player.penissize to $playerPenisSizeBackup>>
		<</if>>*/
	<</if>>

	<<set $anusstate to 0>>
	<<set $mouthstate to 0>>
	<<set $finish to 0>>
	<<unset $stalk_end>>
	<<unset $stalk_taunted>>
	<<unset $stalk_event>>
	<<unset $stalk_clothes>>
	<<unset $stalk>>
	<<unset $stalk_assess>>
	<<unset $audience_active>>
	<<unset $combat_end_text>>
	<<set $gloryhole to 0>>
	<<set $mouthuse to 0>>
	<<set $anususe to 0>>
	<<set $thighuse to 0>>
	<<set $bottomuse to 0>>
	<<if $feetuse isnot "bound">>
		<<set $feetuse to 0>>
	<</if>>
	<<if $leftarm isnot "bound">>
		<<set $leftarm to 0>>
	<</if>>
	<<if $rightarm isnot "bound">>
		<<set $rightarm to 0>>
	<</if>>
	<<set $chestuse to 0>>
	<<set $cheststate to 0>>
	<<if $head isnot "bound">>
		<<set $head to 0>>
	<</if>>
	<<set $face to 0>>
	<<if $position is "wall">>
		<<set $leftarm to 0>>
		<<set $rightarm to 0>>
		<<set $head to 0>>
	<</if>>
	<<unset $neckuse>>
	<<if $legsShackledDuringCombat>>
		<<unset $legsShackledDuringCombat>>
	<</if>>
	<<set $position to 0>>
	<<set $walltype to "wall">>
	<<set $underlowerstruggle to 0>>
	<<set $lowerstruggle to 0>>
	<<set $upperstruggle to 0>>
	<<set $overlowerstruggle to 0>>
	<<set $overupperstruggle to 0>>
	<<set $alarm to 0>>
	<<set $rescue to 0>>
	<<set $noise to 0>>
	<<set $timer to 0>>
	<<set $beastname to "none">>
	<<set $panicparalysis to 0>>
	<<set $panicviolence to 0>>
	<<unset $panicviolenceRecent>>
	<<set $pullaway to 0>>
	<<set $novaginal to 0>>
	<<set $noanal to 0>>
	<<set $nopenile to 0>>
	<<set $nochoke to 0>>
	<<unset $pullOut>>
	<<unset $pullOutAsk>>
	<<set $player.condom to false>>
	<<unset $otherFilled>>
	<<unset $noupper>>
	<<unset $noupperasked>>
	<<unset $nomask>>
	<<unset $nomaskasked>>
	<<unset $npcpillingasked>>
	<<unset $speechpill>>
	<<unset $speechpillreveal>>
	<<unset $speechPillState>>
	<<unset $xchangePillWord>>
	<<set $askedtochoke to 0>>
	<<unset $speechwheeze>>
	<<unset $speechwheezelewd>>
	<<unset $speechwheezeaskchokerough>>
	<<unset $speechwheezeaction>>
	<<set $speechorgasmweakcumcount to 0>>
	<<set $speechorgasmnocumcount to 0>>
	<<set $speechorgasmcount to 0>>
	<<set $speechorgasmrepeat to 0>>
	<<set $underwatertime to 0>>
	<<if $underwater isnot 1>>
		<<if !$oxygenRecovery>>
			<<oxygenrefresh>>
		<</if>>
		<<set $suffocating to 0>>
	<</if>>
	<<set $angelforgive to 0>>
	<<set $fallenangelretribution to 0>>
	<<set $begoneThot to 0>>
	<<set $demonseduce to 0>>
	<<unset $dragonBoostUsed>>
	<<unset $banishDisable>>
	<<unset $penisfucked>>
	<<unset $vaginafucked>>
	<<unset $anusfucked>>
	<<set $speechdisable to 0>>
	<<unset $stealstateleft>>
	<<unset $stealstateright>>
	<<unset $position_lock>>
	<<unset $handGuideLeft>>
	<<unset $handGuideRight>>
	<<unset $chestRefused>>
	<<unset $easySteal>>
	<<unset $canRescue>>
	<<unset $handOnButtPlug>>


	<<set $leftactiondefault to $leftaction>>
	<<set $rightactiondefault to $rightaction>>
	<<set $feetactiondefault to $feetaction>>
	<<set $mouthactiondefault to $mouthaction>>
	<<set $vaginaactiondefault to $vaginaaction>>
	<<set $penisactiondefault to $penisaction>>
	<<set $anusactiondefault to $anusaction>>
	<<set $thighactiondefault to $thighaction>>
	<<set $cheekactiondefault to $cheekaction>>
	<<set $chestactiondefault to $chestaction>>

	<<actioncarry>>

	<<set $penisaction to 0>>
	<<set $vaginaaction to 0>>
	<<set $anusaction to 0>>
	<<set $leftaction to 0>>
	<<set $rightaction to 0>>
	<<set $mouthaction to 0>>
