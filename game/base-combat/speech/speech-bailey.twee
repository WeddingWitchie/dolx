:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
	<<if $speechpillreveal is 1>>
		<<set $speechpillreveal to 0>><<set _npc_speech to true>>
		<<print [
			`<<He>> stares at the X-Change $xchangePillWord in your hand and goes still. "Put that away. You can't afford what happens if you try."`,
			`<<His>> eyes gaze to the X-Change $xchangePillWord, then back to your face. "Think very carefully about your next move. Damages get billed."`,
			`"Is that supposed to frighten me?" <<He>> nods at your X-Change $xchangePillWord. "Everything you do here goes on your account. That would cost you more than you've ever owed."`
		][random(0, 2)]>>
		<<set $enemyanger += 20>><<set $enemytrust -= 20>>
	<<elseif $speechpill is "herm" or $speechpill is 1>>
		<<set _baileyPilledHerm to $speechpill is "herm">><<set $speechpill to 0>><<set _npc_speech to true>>
		<<if _baileyPilledHerm>>
			<<print `<<He>> glances down at <<his>> mismatched new anatomy, scowls, then back at you. "` + [
				`Both. You gave me both. I'm charging you for two bodies' worth of inconvenience.`,
				`Don't look so pleased with yourself. Stock is stock. I'll find a use for all of it.`,
				`When I work out what this is worth, you'll be paying the difference.`
			][random(0, 2)] + `"`>>
		<<else>>
			<<print `<<He>> flexes <<his>> unfamiliar fingers like <<hes>> testing a tool <<he>> didn't order. "` + [
				`Stop staring. It's still me in here, and you still owe me.`,
				`A body's a body. This one might even turn a profit. That doesn't mean you're forgiven.`,
				`Every hour I spend like this goes on your bill. Pray it wears off fast.`
			][random(0, 2)] + `"`>>
		<</if>>
	<<elseif $stockholm_bailey gte 1 or $stockholm_active or random(1)>>
		<<speech-bailey-expansion>>
	<<else>>
	<<set _npc_speech to true>>
	<<set $_stringsPre to ($enemyanger lte 60 ? "<<He>> snickers. " : "<<He>> snarls. ")>>
	<<set $_baileyPenetratorSize to ((window.C && C.npc && C.npc.Bailey && Number.isFinite(Number(C.npc.Bailey.penissize))) ? Number(C.npc.Bailey.penissize) : 0)>>
	<<set $_baileyColossalPenetrator to $_baileyPenetratorSize gte 5>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Bailey") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Bailey")>>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"Still breathing? You should. Damaged goods are harder to sell."`,
				`"Break too badly and you'll cost me money."`,
				`"Now you know what happens when a debt gets collected in full."`
			]>>
		<<else>>
			<<set $_strings to [
				`"Fuck. Your value just depreciated a little."`,
				`"There. Something else I can add to your account."`,
				`"I collect what I'm owed."`
			]>>
		<</if>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"If you pass out, this becomes tedious."`,
				`"That's it. Take it, and don't make me write off the loss."`,
				`"You should be grateful I know when to stop. Most buyers don't."`
			]>>
		<<else>>
			<<set $_strings to [
				`"You should be putting out more if you're this tight. What do you think you're good for?"`,
				`"Tight. That's worth something, at least."`,
				`"Don't glare at me. You're the one behind on payments."`
			]>>
		<</if>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<set $_strings to [
				`"Choke too hard and I have to start over."`,
				`"Open wider. You're not paid to look delicate."`,
				`"Keep your eyes on me. I want to know you're listening."`
			]>>
		<<else>>
			<<set $_strings to [
				`"Just take it."`,
				`"You'll learn. Everyone does."`,
				`"Less hesitation next time. Time is money."`
			]>>
		<</if>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Bailey">>
		<<set $_strings to [
			`"Surprised, are you? You'll learn to kiss better soon."`,
			`"Don't look at me like that. It was only a kiss."`,
			`"Now stop acting like I handed you a present."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if $robinpaid is 1>>
					<<print $_stringsPre + `"You pay <<nnpc_his 'Robin'>> debt and <<nnpc_he 'Robin'>> can't even watch."`>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<print $_stringsPre + `"That waif's grown a spine thanks to you. Shame <<nnpc_he 'Robin'>> won't save you."`>>
				<<else>>
					<<set $_strings to [
						`"That worthless brat can't save you."`,
						`"What do you expect that waif to do? Cry until I stop?"`,
						`"Robin can't pay what you owe. Sentiment doesn't clear debt."`,
						`"If Robin wants you back, <<nnpc_he "Robin">> should bring cash."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<</if>>
			<<case "Whitney">>
				<<if $whitney_bailey_met gte 1>>
					<<set $_strings to [
						`"That idiot's useful. Don't confuse that with important."`,
						`"Whitney? That one makes trouble for free. I make money from it."`,
						`"Don't hide behind that brat. <<nnpc_He "Whitney">> has debts of <<nnpc_his "Whitney">> own."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<set $_strings to [
					`"People would pay extra to see you ${$player.penisExist ? "fuck" : "get fucked by"} some beast."`,
					`"Animals get put down. You get put to work."`,
					`"Animals, now? There's a market for everything, I suppose."`,
					`"Keep that thing away from my property unless someone pays first."`
				]>>
				<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
			<<case "Eden">>
				<<set $_strings to [
					`"You'll be going right back to <<nnpc_him 'Eden'>> if you keep this up."`,
					`"Eden thinks the woods hide everything. They don't."`
				]>>
				<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
			<<case "Gwylan">>
				<<set $_strings to [
					`"<<He>> pauses, then speaks. \"Careful where you bring that name.\"`,
					`"<<He>> goes still. \"Some names are more expensive than others. That one is dangerous.\""`
				]>>
				<<print $_strings[random(0, $_strings.length - 1)]>>
			<<case "Kylar">>
				<<if $kylar_abduction_bailey is 1>>
					<<print $_stringsPre + either(
						`"Call for <<nnpc_him 'Kylar'>> louder. Maybe <<nnpc_hes 'Kylar'>> outside the window."`,
						`"That little freak is probably watching. Let <<nnpc_him 'Kylar'>>."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Sydney">>
				<<if $temple_bailey>>
					<<print $_stringsPre + either(
						`"Save it for confession."`,
						`"That brat would pray for you. I'd rather <<nnpc_he 'Sydney'>> paid for you."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Avery">>
				<<if $avery_fate is "saved">>
					<<print $_stringsPre + `"<<nnpc_He 'Avery'>>'d have let you fall."`>>
				<<elseif $avery_mansion and $avery_fate isnot "fallen" and $avery_fate isnot "kicked" and $renttime lte 0>>
					<<print $_stringsPre + `"I had a deal with <<nnpc_him 'Avery'>>, but <<nnpc_he 'Avery'>> dried up. Take it up with <<nnpc_him 'Avery'>>."`>>
				<<elseif $bailey_avery_met>>
					<<print $_stringsPre + `"Keep calling for that idiot. See if <<nnpc_his 'Avery'>> money reaches this far."`>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Alex">>
				<<print $_stringsPre + either(
					`"What do you think that idiot ${C.npc.Alex.pronoun is "f" ? "cowgirl" : "cowboy"} is going to do?"`,
					`"Your farmer's probably face-down in a bottle somewhere."`,
					`"That drunk couldn't find you if you were standing in <<nnpc_his 'Alex'>> field."`
				)>>
			<<default>>
				<<set $_strings to [
					`"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`,
					`"Names don't settle debt. Money does."`,
					`"Tell <<nnpc_him _loveInterest>> to bring cash next time."`
				]>>
				<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</switch>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<set $_strings to [
			`"Hit me again and I'll add it to your rent."`,
			`"That little outburst just cost you."`,
			`"I will charge extra for difficult stock."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<set $_strings to [
			`"Look at me while you do it. I want to see you understand."`,
			`"Less noise. More use."`,
			`"That's better."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<set $_strings to [
			`"Brought your own $_sexToy? Resourceful. I might bill you less."`,
			`"Put that $_sexToy to use, then. Wasting equipment is wasting money."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<set $_strings to [
				`"Clawing me now? That's damage, time, and trouble. I'll add all three to your account."`,
				`"You little shit. Do you know how expensive difficult stock becomes?"`,
				`"That's the problem with you. Always finding new ways to make yourself less profitable."`,
				`"Fine. If you want to act feral, I'll handle you like something that bites."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>><<set $enemyanger += 20>><<set $enemytrust -= 35>>
		<<else>>
			<<set $_strings to [
				`"Scratching now?"`,
				`"Marks lower value unless someone's paying extra for them."`,
				`"That's one way to negotiate. A stupid one."`,
				`"Hit, scratch, bite, it doesn't matter. Debt still gets collected."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>><<set $enemyanger += 10>><<set $enemytrust -= 20>>
		<</if>>
	<<elseif $speechgenitals is 1>>
		<<print either(
			`<<He>> looks at your <<genitals>>. "That'll sell."`,
			`<<He>> looks at your <<genitals>>. "You'll earn your keep."`
		)>>
	<<elseif $speechbreasts is 1>>
		<<print either(
			`<<He>> looks at your <<breasts>>. "That'll sell."`,
			`<<He>> looks at your <<breasts>>. "You'll earn your keep."`
		)>>
	<<elseif $speechpregnant is 1 and $settings.pregnancySpeechEnabled>>
		<<if Object.values($children).some(child => child.location === "home")>>
			<<print `<<He>> sighs at your pregnant belly. "Knocked up. Typical."`>>
		<<else>>
			<<print `<<He>> looks at your pregnant belly. "Couldn't keep your legs together, could you?"`>>
		<</if>>
	<<elseif $speechplead is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"Save your breath."`,
				`"Quit whining. You'll live."`,
				`"Begging won't change what you owe me."`,
				`"Beg harder, maybe I'm feeling generous."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Every word out of your mouth adds to what you owe."`,
				`"You'll shut up and take it if you know what's good for you."`,
				`"Begging won't save you, you little shit."`
			)>>
		<</if>>
	<<elseif $speechmoan is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"Keep it down."`,
				`"Save the moaning for clients."`,
				`"Save the racket for someone who pays."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Shut your mouth, brat."`,
				`"Not another sound, you little shit."`,
				`"One more sound and I'll give you something to moan about."`
			)>>
		<</if>>
	<<elseif $speechdemand is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"You don't give orders here."`,
				`"You're in no position to negotiate."`,
				`"That mouth is going to cost you, brat."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Mouthy little shit."`,
				`"Shut your goddamn mouth."`,
				`"You don't get to make demands. You never did."`
			)>>
		<</if>>
	<<elseif $speechscream is 1>>
		<<set $speechscream to 0>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(`"Shut up."`, `"Be quiet."`, `"No one's coming."`, `"Who exactly do you think is going to help you?"`)>>
		<<else>>
			<<print $_stringsPre + either(`"Shut up."`, `"Be. Quiet."`, `"Noisy little shit."`)>>
		<</if>>
	<<elseif $speechforgive is 1>>
		<<print `<<He>> sneers. ` + either(
			`"I don't need your forgiveness."`,
			`"Forgive me? For what?"`,
			`"Close your damn mouth, or I'll close it for you."`
		)>>
	<<elseif $speechapologiseunforgiving is 1>>
		<<print $_stringsPre + either(
			`"Shut up. I've heard it all before."`,
			`"Did you really think I would fall for that?"`,
			`"Do you think I give a damn, you little shit?"`,
			`"Save it. If you were sorry, you'd stop struggling."`
		)>>
	<<elseif $speechgrowl is 1 or $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<print $_stringsPre + either(
			`"You little mutt."`,
			`"I'll muzzle you if I have to."`,
			`"Bite if you want. See what it costs you."`,
			`"This is what I get for taking in strays."`
		)>>
	<<elseif $speechstruggle is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(
				`"Stop struggling."`,
				`"You're wasting both our time."`,
				`"You're not going anywhere."`,
				`"Don't make this difficult."`,
				`"Stop fighting me."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Quit moving, you little shit."`,
				`"Stop squirming, damn brat."`,
				`"That's enough."`,
				`"Don't test my patience."`,
				`"You're only making it worse for yourself."`
			)>>
		<</if>>
	<<elseif $speechspank is 1>>
		<<if $enemyanger lte 60>>
			<<print $_stringsPre + either(`"What have we learned?"`, `"Count it against what you owe."`)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Harder? Fine."`,
				`"You asked for this."`,
				`"This is for wasting my time."`,
				`"I'll stop when you've learned your lesson."`,
				`"You've been difficult. This is what happens."`
			)>>
		<</if>>
	<<elseif $speechcum is 1>>
		<<set $_strings to [
			`"I hope you appreciate that."`,
			`"Just something to remember me by."`,
			`"We'll call that your going away gift."`,
			`"Add that to what you owe me."`,
			`"Don't waste a drop. I hate waste."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $pleasure gte ($pleasuremax * 0.95)>>
		<<set $_strings to [
			`"Nice look. Some people would pay big to see you hot and bothered like this."`,
			`"Should've brought a camera. Your profile would look great with this expression."`,
			`"That's the face that sells. Try not to ruin it."`,
			`"You're easier to manage when your body betrays you."`
		]>>
		<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
	<<elseif $enemyanger lte 60>>
		<<if $rng gte 81>>
			<<set $_options to ["default"]>>
			<<if $hairlength gte 600>>
				<<run $_options.push("hair")>>
			<</if>>
			<<if $player.breastsize gte 6 or $player.penissize gte 4>>
				<<run $_options.push("cow")>>
			<</if>>
			<<if ($athletics gte 750 or currentSkillValue('physique')) gte $physiquesize * 0.75>>
				<<run $_options.push("healthy")>>
			<</if>>
			<<switch $_options[random(0, $_options.length - 1)]>>
				<<case "hair">>
					<<set $_strings to [
						`"Kept your hair long? I know someone who will like that."`,
						`"Long hair photographs well. That's useful."`,
						`"Someone asked for hair like yours once. Paid upfront, too."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<<case "cow">>
					<<set $_strings to [
						`"Cows fetch a high price these days, you know."`,
						`"Look at you. Practically a premium listing."`,
						`"Some buyers are very specific. You're fortunate, or unlucky."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<<case "healthy">>
					<<set $_strings to [
						`"You're strong. Good. Some people pay for the fight."`,
						`"Good muscle tone. That keeps your value up."`,
						`"Fit enough to struggle, then. Some clients like that."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
				<<case "default">>
					<<set $_strings to [
						`"Don't make this harder than it needs to be."`,
						`"Be sensible. Sensible people cost me less time."`,
						`"Stay still and this stays simple."`
					]>>
					<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
			<</switch>>
		<<elseif $rng gte 61>>
			<<set $_strings to [
				`"You're so valuable!"`,
				`"Don't look surprised. I know exactly what you're worth."`,
				`"You'd be amazed what someone will pay for a familiar face."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $rng gte 41>>
			<<set $_strings to [
				`"Just relax. I'll handle everything like always."`,
				`"You never were good with accounts. Let me deal with it."`,
				`"Trust me. Or don't. The result is the same."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<elseif $rng gte 21>>
			<<print $_stringsPre + `"You were always the best looking little ` + ["bastard","shit","<<bitch>>"][random(0,2)] + `."`>>
		<<else>>
			<<set $_strings to [
				`"It's easier this way. Trust me."`,
				`"There are worse people than me waiting outside."`,
				`"You don't need to know who asked for you."`,
				`"Stay still."`,
				`"You're learning. Good."`,
				`"Keep still. I'm almost done with you."`,
				`"Hold still. You're wasting both our time."`,
				`"You've always been the most difficult one. I hope you know that."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<</if>>
	<<else>>
		<<if $rng gte 91 and $enemyanger lte 70>>
			<<set $_strings to [
				`"Maybe I should inspect you before we go."`,
				`"Stand still. I need to check what condition you're in."`,
				`"Let's see how much trouble you've caused me."`
			]>>
			<<print $_stringsPre + $_strings[random(0, $_strings.length - 1)]>>
		<<else>>
			<<set $_strings to [
				`Why do you shits have to make it harder on yourselves?`,
				`I told you to hold still.`,
				`You're making it harder on both of us.`,
				`You chose this.`,
				`Are you going to listen to me now?`,
				`I have someone willing to pay big for you.`,
				`You're coming with me, and that's that.`,
				`Keep fighting and I'll put the damage on your account.`,
				`Someone already asked for you. Don't make me disappoint them.`,
				`I know things about you that you never told me.`,
				`Stop struggling. You're only lowering your price.`,
				`You owe me for the inconvenience.`,
				`Keep fighting. See where it gets you.`,
				`You're costing me money every time you move.`,
				`This would be over already if you'd just behave.`,
				`Stop squirming, you're not going anywhere.`,
				`Every second you fight me is a second you owe me.`
			]>>
			<<print $_stringsPre + '"' + $_strings[random(0, $_strings.length - 1)] + '"'>>
		<</if>>
	<</if>>
	<</if>>
<</widget>>
