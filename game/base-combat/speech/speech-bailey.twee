				<<print `<<He>> sees the brand on your buttock. <<He>> exhales. "You came back."`>>
			<<else>>
				<<print `<<He>> sees the brand on your buttock. <<He>> exhales. "Got my money's worth, at least."`>>
			<</if>>
		<<else>>
			<<print $_stringsPre + either(
				`"Why do you shits have to make it harder on yourselves?"`,
				`"I told you to hold still."`,
				`"You're making it harder on both of us."`,
				`"You chose this."`,
				`"Are you going to listen to me now?"`,
				`"I have someone willing to pay big for you."`,
				`"You're coming with me, and that's that."`,
				`"You owe me for the inconvenience."`,
				`"Keep fighting. See where it gets you."`,
				`"You'll fetch a decent sum if you keep your mouth shut."`,
				`"Be grateful someone wants you at all."`,
				`"You're costing me money every time you move."`,
				`"This would be over already if you'd just behave."`,
				`"Stop squirming, you're not going anywhere."`,
				`"Every second you fight me is a second you owe me."`,
				`"Maybe I should inspect you before we go."`
			)>>
		<</if>>
	<</if>>
	<</if>>
<</widget>>
