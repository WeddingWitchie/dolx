:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
	<<set _npc_speech to true>>
	<<if !$baileyUniqueComments>>
		<<set $baileyUniqueComments to []>>
	<</if>>
	<<if C.npc.Bailey.dom lte 30>>
		<<set $_stringsPre to "<<He>> mocks. ">>
	<<elseif $enemyanger gte 80>>
		<<set $_stringsPre to "<<He>> hisses. ">>
	<<elseif $enemyanger gte 50>>
		<<set $_stringsPre to "<<He>> snarls. ">>
	<<else>>
		<<set $_stringsPre to "<<He>> snickers. ">>
	<</if>>
	<<speechPool "Bailey" "noMouthAction">>
	<<if $speechpillreveal is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechpillreveal to 0>><<set $enemyanger += 20>><<set $enemytrust -= 20>>
		<<speechLine>>
			<<He>> stares at the X-Change $xchangePillWord in your hand and goes still. "Put that away. You can't afford what happens if you try."
		<<speechLine>>
			<<His>> eyes gaze to the X-Change $xchangePillWord, then back to your face. "Think very carefully about your next move. Damages get billed."
		<<speechLine>>
			"Is that supposed to frighten me?" <<He>> nods at your X-Change $xchangePillWord. "Everything you do here goes on your account. That would cost you more than you've ever owed."
		<</addSpeechLine>>
	<<elseif $speechpill is "herm">>
		<<addSpeechLine "reveal">>
			<<set $speechpill to 0>>
		<<speechLine>>
			<<He>> glances down at <<his>> mismatched new anatomy, scowls, then back at you. "Both. You gave me both. I'm charging you for two bodies' worth of inconvenience."
		<<speechLine>>
			<<He>> glances down at <<his>> mismatched new anatomy, scowls, then back at you. "Don't look so pleased with yourself. Stock is stock. I'll find a use for all of it."
		<<speechLine>>
			<<He>> glances down at <<his>> mismatched new anatomy, scowls, then back at you. "When I work out what this is worth, you'll be paying the difference."
		<</addSpeechLine>>
	<<elseif $speechpill is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechpill to 0>>
		<<speechLine>>
			<<He>> flexes <<his>> unfamiliar fingers like <<hes>> testing a tool <<he>> didn't order. "Stop staring. It's still me in here, and you still owe me."
		<<speechLine>>
			<<He>> flexes <<his>> unfamiliar fingers like <<hes>> testing a tool <<he>> didn't order. "A body's a body. This one might even turn a profit. That doesn't mean you're forgiven."
		<<speechLine>>
			<<He>> flexes <<his>> unfamiliar fingers like <<hes>> testing a tool <<he>> didn't order. "Every hour I spend like this goes on your bill. Pray it wears off fast."
		<</addSpeechLine>>
	<<elseif $encounterDialogue is "baileyFlatFight">>
		<<baileyFlatFightSpeech>>
	<<else>>
		<<baileyBaseSpeech>>
	<</if>>
	<<speechSay>>
<</widget>>

<<widget "baileyBaseSpeech">>
	<<set $_baileyPenetratorSize to ((window.C && C.npc && C.npc.Bailey && Number.isFinite(Number(C.npc.Bailey.penissize))) ? Number(C.npc.Bailey.penissize) : 0)>>
	<<set $_baileyColossalPenetrator to $_baileyPenetratorSize gte 5>>
	<<if ($speechfallentransform is 1)>>
		<<if $syndromebailey>>
			<<addSpeechLine "virginity">>
				<<He>> watches you break with an unreadable expression. "Doesn't matter how many pieces you break into." <<He>> gazes at your shattered halo. "Every piece is mine."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>> watches you break with an unreadable expression. "There." <<He>> gazes at your shattered halo. "You were bound to break eventually. Now you're worth something."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<He>> watches you break with an unreadable expression. "Fallen from grace, have you?" <<He>> mocks, gazing at your shattered halo. "You were always going to end up here."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> watches you break with an unreadable expression. "Good. It was only holding you back." <<He>> gazes at your shattered halo. "You'll be able to earn more this way."
			<</addSpeechLine>>
		<</if>>
	<<elseif (($speechpenisvirgin is 1) and $player.virginity.penile is "Bailey") or (($speechvaginavirgin is 1) and $player.virginity.vaginal is "Bailey")>>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"Break too badly and you'll cost me money."
			<<speechLine>>
				<<print $_stringsPre>>"Now you know what happens when a debt gets collected in full."
			<</addSpeechLine>>
			<<if $consensual isnot 1>>
				<<addSpeechLine "virginity">>
				<<speechLine>>
					<<print $_stringsPre>>"Still breathing? You should. Damaged goods are harder to sell."
				<</addSpeechLine>>
			<</if>>
		<<elseif $syndromebailey>>
			<<addSpeechLine "virginity">>
				"You saved it for me, didn't you?" <<He>> says it like <<he>> already knew. "<<goodGirl>>. You knew it was always going to be mine."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>> exhales slowly. "Mine now."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<He>> mocks. "Fuck. Your value just depreciated a little."
			<<speechLine>>
				<<print $_stringsPre>>"That's all you're good for, you little whore."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<He>> sighs. "Shame. Could've gotten more for you."
			<<speechLine>>
				<<print $_stringsPre>>"There. Something else I can add to your account."
			<<speechLine>>
				<<print $_stringsPre>>"I collect what I'm owed."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechanusvirgin is 1) and $player.virginity.anal is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"If you pass out, this becomes tedious."
			<<speechLine>>
				<<print $_stringsPre>>"That's it. Take it, and don't make me write off the loss."
			<</addSpeechLine>>
			<<if $consensual isnot 1>>
				<<addSpeechLine "virginity">>
				<<speechLine>>
					<<print $_stringsPre>>"You should be grateful I know when to stop. Most buyers don't."
				<</addSpeechLine>>
			<</if>>
		<<elseif $syndromebailey>>
			<<addSpeechLine "virginity">>
				<<He>> exhales. "Every part of you belongs to me. Every hole. Every sound. Mine."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>> speaks. "You'll learn to take it better." <<He>> doesn't slow down. "You have time."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<print $_stringsPre>>"You should be putting out more if you're this tight. What do you think you're good for?"
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"Relax. You'll get used to it."
			<<speechLine>>
				<<print $_stringsPre>>"Tight. That's worth something, at least."
			<<speechLine>>
				<<print $_stringsPre>>"Don't glare at me. You're the one behind on payments."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNPCAnusVirgin>>
		<<if C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>> fixes you with a level stare. "Remember, I allowed this."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> sneers. "Not a word."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechmouthvirgin is 1) and $player.virginity.oral is "Bailey">>
		<<if $_baileyColossalPenetrator>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"Choke too hard and I have to start over."
			<<speechLine>>
				<<print $_stringsPre>>"Open wider. You're not paid to look delicate."
			<<speechLine>>
				<<print $_stringsPre>>"Keep your eyes on me. I want to know you're listening."
			<</addSpeechLine>>
		<<elseif $syndromebailey>>
			<<addSpeechLine "virginity">>
				<<He>> speaks. "You're going to get good at this." <<He>> pauses. "For me."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				"How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				<<print $_stringsPre>>"Just shut up and choke on it, you little shit."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				<<print $_stringsPre>>"Don't get any funny ideas. Just take it."
			<<speechLine>>
				<<print $_stringsPre>>"Relax. You'll get used to it."
			<<speechLine>>
				<<print $_stringsPre>>"You'll learn. Everyone does."
			<<speechLine>>
				<<print $_stringsPre>>"Less hesitation next time. Time is money."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechkissvirgin is 1) and $player.virginity.kiss is "Bailey">>
		<<if $syndromebailey>>
			<<addSpeechLine "virginity">>
				<<He>> snickers. "Mine. That was always going to be mine."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<addSpeechLine "virginity">>
				<<He>> speaks. "Again." <<He>> waits. "Open your mouth more."
			<</addSpeechLine>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "virginity">>
				"Don't flatter yourself." <<He>> sneers. "That meant nothing."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
			<<speechLine>>
				"First time?" <<He>> snickers. "You'll learn how to use your mouth better."
			<<speechLine>>
				<<print $_stringsPre>>"Surprised are you? You'll learn to kiss better soon."
			<<speechLine>>
				<<print $_stringsPre>>"Don't look at me like that. It was only a kiss."
			<<speechLine>>
				<<print $_stringsPre>>"Now stop acting like I handed you a present."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechspray is 1)>>
		<<if C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "pepperSpray">>
				<<He>> snarls, reeling back in pain. "You'll pay for that, you little shit."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "pepperSpray">>
				<<He>> snarls, reeling back in pain. "You'll pay for that."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechnamedrop is 1)>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if $syndromebailey and !$baileyUniqueComments.includes("namedropRobin")>>
					<<addSpeechLine "namedrop">>
						<<set $baileyUniqueComments.pushUnique("namedropRobin")>>
						<<His>> eyes darken. "Maybe I should sell <<nnpc_him "Robin">> somewhere you can't find <<nnpc_him "Robin">>."
					<</addSpeechLine>>
				<<elseif C.npc.Robin.dom gte 60>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"That brat's grown a spine thanks to you." <<He>> scoffs. "Shame <<nnpc_he "Robin">>'s not coming to save you."
					<</addSpeechLine>>
				<<elseif $robinpaid is 1 and $robinStand?.selfSufficient isnot 1>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"You pay <<nnpc_his 'Robin'>> debt and <<nnpc_he 'Robin'>> can't even watch."
					<</addSpeechLine>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"That waif's grown a spine thanks to you. Shame <<nnpc_he 'Robin'>> won't save you."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"That worthless brat can't save you."
					<<speechLine>>
						<<print $_stringsPre>>"What do you expect that waif to do? Cry until I stop?"
					<<speechLine>>
						<<print $_stringsPre>>"Robin can't pay what you owe. Sentiment doesn't clear debt."
					<<speechLine>>
						<<print $_stringsPre>>"If Robin wants you back, <<nnpc_he "Robin">> should bring cash."
					<</addSpeechLine>>
				<</if>>
			<<case "Eden">>
				<<if $syndromebailey and !$baileyUniqueComments.includes("namedropEden")>>
					<<addSpeechLine "namedrop">>
						<<set $baileyUniqueComments.pushUnique("namedropEden")>>
						"Don't say <<nnpc_his "Eden">> name."
					<</addSpeechLine>>
				<<elseif C.npc.Bailey.dom gte 70>>
					<<addSpeechLine "namedrop">>
						"Say that name again. See what happens."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"You'll be going right back to <<nnpc_him 'Eden'>> if you keep this up."
					<<speechLine>>
						<<print $_stringsPre>>"That hermit had <<nnpc_his "Eden">> chance."
					<<speechLine>>
						<<print $_stringsPre>>"<<nnpc_He "Eden">> ran. You're still here."
					<<speechLine>>
						<<print $_stringsPre>>"Eden couldn't afford you."
					<<speechLine>>
						<<print $_stringsPre>>"Eden thinks the woods hide everything. They don't."
					<</addSpeechLine>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
				<<speechLine>>
					<<print $_stringsPre>>"Animals get put down. You get put to work."
				<<speechLine>>
					<<print $_stringsPre>>"Keep that thing away from my property unless someone pays first."
				<</addSpeechLine>>
				<<if $consensual isnot 1>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"People would pay extra to see you <<if $player.penisExist>>fuck<<else>>get fucked by<</if>> some beast."
					<<speechLine>>
						<<print $_stringsPre>>"The deviant crowd pays well. Keep it up."
					<</addSpeechLine>>
				<</if>>
			<<case "Gwylan">>
				<<addSpeechLine "namedrop">>
				<<speechLine>>
					<<He>> pauses, then speaks. "Careful where you bring that name."
				<<speechLine>>
					"Some debts can't be erased. No matter what that fox tells you."
				<<speechLine>>
					"That witch doesn't fix anything. <<nnpc_He "Gwylan">> just hides it."
				<<speechLine>>
					"The shopkeep pays well. I'll give <<nnpc_him "Gwylan">> that much."
				<<speechLine>>
					<<He>> goes still. "Some names are more expensive than others. That one is dangerous."
				<</addSpeechLine>>
			<<case "Whitney">>
				<<if $whitney_bailey_met gte 1>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"That idiot's useful. Don't confuse that with important."
					<<speechLine>>
						<<print $_stringsPre>>"That <<if C.npc.Whitney.pronoun is "m">>boy<<else>>girl<</if>>'s on a leash. Mine."
					<<speechLine>>
						<<print $_stringsPre>>"That ankle biter can't help you. <<nnpc_He "Whitney">> can barely help <<nnpc_himself "Whitney">>."
					<<speechLine>>
						<<print $_stringsPre>>"Whitney? That one makes trouble for free. I make money from it."
					<<speechLine>>
						<<print $_stringsPre>>"Don't hide behind that brat. <<nnpc_He "Whitney">> has debts of <<nnpc_his "Whitney">> own."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."
					<</addSpeechLine>>
				<</if>>
			<<case "Kylar">>
				<<if $kylar_abduction_bailey is 1>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"Call for <<nnpc_him 'Kylar'>> louder. Maybe <<nnpc_hes 'Kylar'>> outside the window."
					<<speechLine>>
						<<print $_stringsPre>>"That little freak is probably watching. Let <<nnpc_him 'Kylar'>>."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."
					<</addSpeechLine>>
				<</if>>
			<<case "Sydney">>
				<<if C.npc.Sydney.purity lt 0>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"You ruined <<nnpc_him "Sydney">>. You're more like me than you think."
					<</addSpeechLine>>
				<<elseif $temple_bailey>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"Save it for confession."
					<<speechLine>>
						<<print $_stringsPre>>"That brat would pray for you. I'd rather <<nnpc_he 'Sydney'>> paid for you."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."
					<</addSpeechLine>>
				<</if>>
			<<case "Avery">>
				<<if $avery_fate is "saved">>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"<<nnpc_He 'Avery'>>'d have let you fall."
					<</addSpeechLine>>
				<<elseif isAveryPayingBailey() is 1 and $rentTime lte 0>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"I had a deal with <<nnpc_him 'Avery'>>, but <<nnpc_he 'Avery'>> dried up. Take it up with <<nnpc_him 'Avery'>>."
					<</addSpeechLine>>
				<<elseif $bailey_avery_met>>
					<<addSpeechLine "namedrop">>
					<<speechLine>>
						<<print $_stringsPre>>"Keep calling for that idiot. See if <<nnpc_his 'Avery'>> money reaches this far."
					<<speechLine>>
						<<print $_stringsPre>>"<<nnpc_He "Avery">> paid for the privilege. I don't have to."
					<<speechLine>>
						<<print $_stringsPre>>"Call for <<nnpc_him "Avery">>. See if <<nnpc_his "Avery">> money reaches this far."
					<</addSpeechLine>>
				<<else>>
					<<addSpeechLine "namedrop">>
						<<print $_stringsPre>>"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."
					<</addSpeechLine>>
				<</if>>
			<<case "Alex">>
				<<addSpeechLine "namedrop">>
				<<speechLine>>
					<<print $_stringsPre>>"What do you think that idiot <<if C.npc.Alex.pronoun is "f">>cowgirl<<else>>cowboy<</if>> is going to do?"
				<<speechLine>>
					<<print $_stringsPre>>"Your farmer's probably face-down in a bottle somewhere."
				<<speechLine>>
					<<print $_stringsPre>>"That drunk couldn't find you if you were standing in <<nnpc_his 'Alex'>> field."
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
				<<speechLine>>
					<<print $_stringsPre>>"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."
				<<speechLine>>
					<<print $_stringsPre>>"Names don't settle debt. Money does."
				<<speechLine>>
					<<print $_stringsPre>>"Tell <<nnpc_him _loveInterest>> to bring cash next time."
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if ($speechgenitals is 1)>>
		<<addSpeechLine "expose">>
		<<speechLine>>
			<<He>> looks at your <<genitals>> with an appraising eye.
		<<speechLine>>
			<<He>> examines your <<genitals>>. "Not bad."
		<<speechLine>>
			<<He>> looks at your <<genitals>>. "You'll earn your keep."
		<<speechLine>>
			<<He>> examines your <<genitals>> like something <<he>> owns. "Not bad."
		<</addSpeechLine>>
		<<if $consensual isnot 1>>
			<<addSpeechLine "expose">>
				<<He>> looks at your <<genitals>>. "That'll sell."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechbreasts is 1)>>
		<<addSpeechLine "expose">>
		<<speechLine>>
			<<He>> looks at your <<breasts>> with an appraising eye.
		<<speechLine>>
			<<He>> looks at your <<breasts>>. "Those'll do."
		<<speechLine>>
			<<He>> looks at your <<breasts>>. "You'll earn your keep."
		<</addSpeechLine>>
		<<if $consensual isnot 1>>
			<<addSpeechLine "expose">>
				<<He>> looks at your <<breasts>>. "That'll sell."
			<</addSpeechLine>>
		<</if>>
		<<if $player.breastsize lte 7>>
			<<if $consensual isnot 1>>
				<<addSpeechLine "expose">>
				<<speechLine>>
					<<He>> looks at your chest. "Modest. Doesn't matter. You'll still sell."
				<<speechLine>>
					<<He>> glances at your chest. "Small. Some prefer that."
				<</addSpeechLine>>
			<</if>>
		<</if>>
	<</if>>
	<<if ($speechpregnant is 1) and $settings.pregnancySpeechEnabled>>
		<<if getChildrenAt("home").length>>
			<<addSpeechLine "pregnant">>
				<<He>> sighs at your pregnant belly. "Knocked up. Typical."
			<</addSpeechLine>>
		<<elseif $enemyanger lte 100>>
			<<addSpeechLine "pregnant">>
			<<speechLine>>
				<<He>> looks at your pregnant belly. "Couldn't keep your legs together, could you?"
			<<speechLine>>
				<<He>> frowns at your pregnant belly. "I hope you weren't planning on taking time off."
			<<speechLine>>
				"Pregnant." <<He>> looks you over. "You're still working."
			<<speechLine>>
				<<He>> looks at your pregnant belly. "You can still earn your keep like this."
			<</addSpeechLine>>
		<<elseif $enemyanger gt 100>>
			<<addSpeechLine "pregnant">>
			<<speechLine>>
				<<print $_stringsPre>>"Great. Another mouth I can't afford."
			<<speechLine>>
				<<print $_stringsPre>>"Knocked up and still causing trouble."
			<<speechLine>>
				<<print $_stringsPre>>"Use protection next time."
			<</addSpeechLine>>
		<</if>>
		<<if C.npc.Bailey.dom lte 30>>
			<<addSpeechLine "pregnant" 3>>
				"You couldn't keep your legs together or use protection?" <<He>> scoffs. "Worthless little whore."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechplead is 1)>>
		<<if $enemyanger lte 50>>
			<<addSpeechLine "plead">>
			<<speechLine>>
				<<print $_stringsPre>>"Quit whining. You'll live."
			<<speechLine>>
				<<print $_stringsPre>>"Save your breath."
			<<speechLine>>
				<<print $_stringsPre>>"Stay still. Let me handle it."
			<</addSpeechLine>>
		<<elseif $enemyanger lte 100>>
			<<addSpeechLine "plead">>
			<<speechLine>>
				<<print $_stringsPre>>"You owe me this."
			<<speechLine>>
				<<print $_stringsPre>>"You're done when I say you're done."
			<<speechLine>>
