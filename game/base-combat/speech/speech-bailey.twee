:: Widgets speech-Bailey [widget]
<<widget "speech-bailey">>
	<<if $speechpillreveal is 1>>
		<<set $speechpillreveal to 0>><<set _npc_speech to true>>
		<<print [
			`<<He>> stares at the X-Change $xchangePillWord in your hand and goes still. "Put that away. You can't afford what happens if you try."`,
			`<<His>> eyes gaze to the X-Change $xchangePillWord, then back to your face. "Think very carefully about your next move. Damages get billed."`,
			`"Is that supposed to frighten me?" <<He>> nods at your X-Change $xchangePillWord. "Everything you do here goes on your account. That would cost you more than you've ever owed."`
		][random(0, 2)]>>
		<<set $enemyanger += 20>><<set $enemytrust -= 20>>
	<<elseif $speechpill is "herm" or $speechpill is 1>>
		<<set _baileyPilledHerm to $speechpill is "herm">><<set $speechpill to 0>><<set _npc_speech to true>>
		<<if _baileyPilledHerm>>
			<<print `<<He>> glances down at <<his>> mismatched new anatomy, scowls, then back at you. "` + [
				`Both. You gave me both. I'm charging you for two bodies' worth of inconvenience.`,
				`Don't look so pleased with yourself. Stock is stock. I'll find a use for all of it.`,
				`When I work out what this is worth, you'll be paying the difference.`
			][random(0, 2)] + `"`>>
		<<else>>
			<<print `<<He>> flexes <<his>> unfamiliar fingers like <<hes>> testing a tool <<he>> didn't order. "` + [
				`Stop staring. It's still me in here, and you still owe me.`,
				`A body's a body. This one might even turn a profit. That doesn't mean you're forgiven.`,
				`Every hour I spend like this goes on your bill. Pray it wears off fast.`
			][random(0, 2)] + `"`>>
		<</if>>
	<<else>>
	<<set _npc_speech to true>>
	<<if !$baileyUniqueComments>>
		<<set $baileyUniqueComments to []>>
	<</if>>
	<<if C.npc.Bailey.dom lte 30>>
		<<set $_stringsPre to "<<He>> mocks. ">>
	<<elseif $enemyanger gte 80>>
		<<set $_stringsPre to (random(0,1) is 0 ? "<<He>> spits. " : "<<He>> hisses. ")>>
	<<elseif $enemyanger gte 50>>
		<<set $_stringsPre to either("<<He>> snarls. ", "<<He>> growls. ", "<<He>> snaps. ")>>
	<<else>>
		<<set $_stringsPre to (random(0,1) is 0 ? "<<He>> snickers. " : "<<He>> chuckles. ")>>
	<</if>>
	<<set $_baileyPenetratorSize to ((window.C && C.npc && C.npc.Bailey && Number.isFinite(Number(C.npc.Bailey.penissize))) ? Number(C.npc.Bailey.penissize) : 0)>>
	<<set $_baileyColossalPenetrator to $_baileyPenetratorSize gte 5>>


	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Bailey") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Bailey")>>
		<<set $speechpenisvirgin to 0>><<set $speechvaginavirgin to 0>>
		<<if $_baileyColossalPenetrator>>
			<<print either(
				$_stringsPre + `"Still breathing? You should. Damaged goods are harder to sell."`,
				$_stringsPre + `"Break too badly and you'll cost me money."`,
				$_stringsPre + `"Now you know what happens when a debt gets collected in full."`
			)>>
		<<elseif $syndromebailey>>
			<<print `"You saved it for me, didn't you?" <<He>> says it like <<he>> already knew. "Good <<girl>>. You knew it was always going to be mine."`>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<print `<<He>> exhales slowly. "Mine now."`>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<print either(
				`<<He>> mocks. "Fuck. Your value just depreciated a little."`,
				$_stringsPre + `"That's all you're good for, you little whore."`
			)>>
		<<else>>
			<<print either(
				`<<He>> sighs. "Shame. Could've gotten more for you."`,
				$_stringsPre + `"There. Something else I can add to your account."`,
				$_stringsPre + `"I collect what I'm owed."`
			)>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Bailey">>
		<<set $speechanusvirgin to 0>>
		<<if $_baileyColossalPenetrator>>
			<<print either(
				$_stringsPre + `"If you pass out, this becomes tedious."`,
				$_stringsPre + `"That's it. Take it, and don't make me write off the loss."`,
				$_stringsPre + `"You should be grateful I know when to stop. Most buyers don't."`
			)>>
		<<elseif $syndromebailey>>
			<<print `<<He>> exhales. "Every part of you belongs to me. Every hole. Every sound. Mine."`>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<print `<<He>> speaks. "You'll learn to take it better." <<He>> doesn't slow down. "You have time."`>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<print $_stringsPre + `"You should be putting out more if you're this tight. What do you think you're good for?"`>>
		<<else>>
			<<print $_stringsPre + either(
				`"Relax. You'll get used to it."`,
				`"Tight. That's worth something, at least."`,
				`"Don't glare at me. You're the one behind on payments."`
			)>>
		<</if>>

	<<elseif $speechNPCAnusVirgin is 1>>
		<<set $speechNPCAnusVirgin to 0>>
		<<if C.npc.Bailey.dom gte 70>>
			<<print `<<He>> fixes you with a level stare. "Remember, I allowed this."`>>
		<<else>>
			<<print `<<He>> sneers. "Not a word."`>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Bailey">>
		<<set $speechmouthvirgin to 0>>
		<<if $_baileyColossalPenetrator>>
			<<print either(
				$_stringsPre + `"Choke too hard and I have to start over."`,
				$_stringsPre + `"Open wider. You're not paid to look delicate."`,
				$_stringsPre + `"Keep your eyes on me. I want to know you're listening."`
			)>>
		<<elseif $syndromebailey>>
			<<print either(
				`<<He>> speaks. "You're going to get good at this." <<He>> pauses. "For me."`,
				`<<He>> speaks. "How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."`
			)>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<print `"How do I taste?" <<He>> doesn't let you answer. <<He>> just uses you. "Sounds like you can't get enough."`>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<print $_stringsPre + `"Just shut up and choke on it, you little shit."`>>
		<<else>>
			<<print $_stringsPre + either(
				`"Don't get any funny ideas. Just take it."`,
				`"Relax. You'll get used to it."`,
				`"You'll learn. Everyone does."`,
				`"Less hesitation next time. Time is money."`
			)>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Bailey">>
		<<set $speechkissvirgin to 0>>
		<<if $syndromebailey>>
			<<print either(
				`<<He>> snickers. "Mine. That was always going to be mine."`,
				`<<He>> speaks. "Mine." <<His>> thumb traces your mouth once, like <<he>>'s marking something. "That was always going to be mine."`
			)>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<print `<<He>> speaks. "Again." <<He>> waits. "Open your mouth more."`>>
		<<elseif C.npc.Bailey.dom lte 30>>
			<<print $_stringsPre + `"Don't flatter yourself." <<He>> wipes <<his>> mouth with the back of <<his>> hand. "That meant nothing."`>>
		<<else>>
			<<print $_stringsPre + either(
				`"First time?" <<He>> snickers. "You'll learn how to use your mouth better."`,
				`"Surprised are you? You'll learn to kiss better soon."`,
				`"Don't look at me like that. It was only a kiss."`,
				`"Now stop acting like I handed you a present."`
			)>>
		<</if>>

	<<elseif $speechspray is 1>>
		<<set $speechspray to 0>>
		<<if C.npc.Bailey.dom lte 30>>
			<<print `<<He>> makes a sound of disgust. "Disgusting brat."`>>
		<<else>>
			<<print `<<He>> makes a sound of disgust. "You're making a mess."`>>
		<</if>>

	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<if $syndromebailey and !$baileyUniqueComments.includes("namedrop_robin")>>
					<<set $baileyUniqueComments.pushUnique("namedrop_robin")>>
					<<print `<<His>> eyes darken. "Maybe I should sell <<nnpc_him "Robin">> somewhere you can't find <<nnpc_him "Robin">>."`>>
				<<elseif C.npc.Robin.dom gte 60>>
					<<print $_stringsPre + `"That brat's grown a spine thanks to you." <<He>> scoffs. "Shame <<nnpc_he "Robin">>'s not coming to save you."`>>
				<<elseif $robinpaid is 1 and $robinStand?.selfSufficient isnot 1>>
					<<print $_stringsPre + `"You pay <<nnpc_his 'Robin'>> debt and <<nnpc_he 'Robin'>> can't even watch."`>>
				<<elseif C.npc.Robin.dom gte 50>>
					<<print $_stringsPre + `"That waif's grown a spine thanks to you. Shame <<nnpc_he 'Robin'>> won't save you."`>>
				<<else>>
					<<print $_stringsPre + either(
						`"That worthless brat can't save you."`,
						`"What do you expect that waif to do? Cry until I stop?"`
					)>>
				<</if>>
			<<case "Eden">>
				<<if $syndromebailey and !$baileyUniqueComments.includes("namedrop_eden")>>
					<<set $baileyUniqueComments.pushUnique("namedrop_eden")>>
					<<print `"Don't say <<nnpc_his "Eden">> name."`>>
				<<elseif C.npc.Bailey.dom gte 70>>
					<<print `"Say that name again. See what happens."`>>
				<<else>>
					<<print $_stringsPre + either(
						`"You'll be going right back to <<nnpc_him 'Eden'>> if you keep this up."`,
						`"That hermit had <<nnpc_his "Eden">> chance."`,
						`"<<nnpc_He "Eden">> ran. You're still here."`,
						`"Eden couldn't afford you."`
					)>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<print $_stringsPre + either(
					`"People would pay extra to see you ${$player.penisExist ? "fuck" : "get fucked by"} some beast."`,
					`"The deviant crowd pays well. Keep it up."`,
					`"Animals get put down. You get put to work."`
				)>>
			<<case "Gwylan">>
				<<print either(
					`"Careful where you bring that name."`,
					`"Some debts can't be erased. No matter what that fox tells you."`,
					`"That witch doesn't fix anything. <<nnpc_He "Gwylan">> just hides it."`,
					`"The shopkeep pays well. I'll give <<nnpc_him "Gwylan">> that much."`
				)>>
			<<case "Whitney">>
				<<if $whitney_bailey_met gte 1>>
					<<print $_stringsPre + either(
						`"That idiot's useful. Don't confuse that with important."`,
						`"That ${C.npc.Whitney.pronoun is "m" ? "boy" : "girl"}'s on a leash. Mine."`,
						`"That ankle biter can't help you. <<nnpc_He "Whitney">> can barely help <<nnpc_himself "Whitney">>."`,
						`"Whitney? That one makes trouble for free. I make money from it."`,
						`"Don't hide behind that brat. <<nnpc_He "Whitney">> has debts of <<nnpc_his "Whitney">> own."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Kylar">>
				<<if $kylar_abduction_bailey is 1>>
					<<print $_stringsPre + either(
						`"Call for <<nnpc_him 'Kylar'>> louder. Maybe <<nnpc_hes 'Kylar'>> outside the window."`,
						`"That little freak is probably watching. Let <<nnpc_him 'Kylar'>>."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Sydney">>
				<<if C.npc.Sydney.purity lt 0>>
					<<print $_stringsPre + `"You ruined <<nnpc_him "Sydney">>. You're more like me than you think."`>>
				<<elseif $temple_bailey>>
					<<print $_stringsPre + either(
						`"Save it for confession."`,
						`"That brat would pray for you. I'd rather <<nnpc_he 'Sydney'>> paid for you."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
			<<case "Avery">>
				<<if $avery_fate is "saved">>
					<<print $_stringsPre + `"<<nnpc_He 'Avery'>>'d have let you fall."`>>
				<<elseif $avery_mansion and $avery_fate isnot "fallen" and $avery_fate isnot "kicked" and $renttime lte 0>>
					<<print $_stringsPre + `"I had a deal with <<nnpc_him 'Avery'>>, but <<nnpc_he 'Avery'>> dried up. Take it up with <<nnpc_him 'Avery'>>."`>>
				<<elseif $bailey_avery_met>>
					<<print $_stringsPre + either(
						`"Keep calling for that idiot. See if <<nnpc_his 'Avery'>> money reaches this far."`,
						`"<<nnpc_He "Avery">> paid for the privilege. I don't have to."`
					)>>
				<<else>>
					<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
				<</if>>
				
			<<case "Alex">>
				<<print $_stringsPre + either(
					`"What do you think that idiot ${C.npc.Alex.pronoun is "f" ? "cowgirl" : "cowboy"} is going to do?"`,
					`"Your farmer's probably face-down in a bottle somewhere."`,
					`"That drunk couldn't find you if you were standing in <<nnpc_his 'Alex'>> field."`,
					`"Robin can't pay what you owe. Sentiment doesn't clear debt."`,
					`"If Robin wants you back, <<nnpc_he "Robin">> should bring cash."`,
					`"Whitney? That one makes trouble for free. I make money from it."`,
					`"Don't hide behind that brat. <<nnpc_He "Whitney">> has debts of <<nnpc_his "Whitney">> own."`,
					`"Call for <<nnpc_him "Avery">>. See if <<nnpc_his "Avery">> money reaches this far."`,
					`"Animals, now? There's a market for everything, I suppose."`,
					`"Keep that thing away from my property unless someone pays first."`,
					`"Eden thinks the woods hide everything. They don't."`,
					`"<<He>> pauses, then speaks. \"Careful where you bring that name.\"`,
					`"<<He>> goes still. \"Some names are more expensive than others. That one is dangerous.\""`,
					`"Names don't settle debt. Money does."`,
					`"Tell <<nnpc_him _loveInterest>> to bring cash next time."`
				)>>
			<<default>>
				<<print $_stringsPre + `"If <<nnpc_he _loveInterest>> cared about you, <<nnpc_he _loveInterest>> would pay for you."`>>
		<</switch>>

	<<elseif $speechgenitals is 1>>
		<<print either(
			$_stringsPre + `<<He>> looks at your <<genitals>> with an appraising eye.`,
			$_stringsPre + `<<He>> examines your <<genitals>>. "Not bad."`,
			$_stringsPre + `<<He>> looks at your <<genitals>>. "That'll sell."`,
			$_stringsPre + `<<He>> looks at your <<genitals>>. "You'll earn your keep."`,
			`<<He>> examines your <<genitals>> like something <<he>> owns. "Not bad."`
		)>>
	<<elseif $speechbreasts is 1>>
		<<if $player.breastsize lte 7>>
		<<print either(
			`<<He>> looks at your chest. "Modest. Doesn't matter. You'll still sell."`,
			`<<He>> runs a hand over your chest. "Not much there. Enough for the right buyer."`,
			`<<He>> glances at your chest. "Small. Some prefer that."`
		)>>
		<<else>>
		<<print either(
			$_stringsPre + `<<He>> looks at your <<breasts>> with an appraising eye.`,
			$_stringsPre + `<<He>> looks at your <<breasts>>. "Those'll do."`,
			$_stringsPre + `<<He>> looks at your <<breasts>>. "That'll sell."`,
			$_stringsPre + `<<He>> looks at your <<breasts>>. "You'll earn your keep."`,
			`<<He>> weighs your <<breasts>> in <<his>> hands. "Not bad."`
		)>>
		<</if>>
	<<elseif $speechpregnant is 1 and $settings.pregnancySpeechEnabled>>
		<<if Object.values($children).some(child => child.location === "home")>>
			<<print `<<He>> sighs at your pregnant belly. "Knocked up. Typical."`>>
		<<elseif $enemyanger lte 20>>
			<<print either(
				`<<He>> looks at your pregnant belly. "Couldn't keep your legs together, could you?"`,
				`<<He>> frowns at your pregnant belly. "I hope you weren't planning on taking time off."`,
				`<<He>> looks at your pregnant belly. "Couldn't keep your legs together, could you?"`,
				`"Pregnant." <<He>> looks you over. "You're still working."`,
				`<<He>> looks at your pregnant belly. "You can still earn your keep like this."`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"Great. Another mouth I can't afford."`,
				`"Knocked up and still causing trouble."`,
				`"Use protection next time."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"You couldn't keep your legs together or use protection?" <<He>> scoffs. "Worthless little whore."`,
				`"You let someone do this to you?"`
			)>>
		<</if>>

	<<elseif $speechplead is 1>>
		<<if C.npc.Bailey.dom gte 70 and random(0,2) is 0>>
			<<print $_stringsPre + `"Beg harder, maybe I'm feeling generous."`>>
		<<elseif $enemyanger lte 20>>
			<<print $_stringsPre + either(
				`"Quit whining. You'll live."`,
				`"Save your breath."`,
				`"Stay still. Let me handle it."`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"You owe me this."`,
				`"You're done when I say you're done."`,
				`"Begging won't change what you owe me."`
			)>>
		<<else>>
			<<print either(
				`"You'll shut up and take it if you know what's good for you."`,
				`"Every word out of your mouth adds to what you owe."`,
				`"Begging won't save you, you little shit."`
			)>>
		<</if>>
	<<elseif $speechmoan is 1>>
		<<if C.npc.Bailey.dom lte 30>>
			<<print $_stringsPre + either(
				`"Save the moaning for clients."`,
				`"Shut up. I don't need the racket."`,
				`"Save the racket for someone who pays."`,
				`"Save the moaning for the customers."`
			)>>
		<<elseif C.npc.Bailey.dom gte 70>>
			<<print $_stringsPre + either(
				`"Every sound you make is mine."`,
				`"Don't hold your voice back. Let me hear them."`,
				`"There it is. Let it out."`
			)>>
		<<elseif $enemyanger lte 20>>
			<<print $_stringsPre + either(
				`"Good to know what works."`,
				`"This is what makes you valuable."`,
				`"Louder. Let's hear it."`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"Keep it down."`,
				`"I don't need the noise."`,
				`"Just take it."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Not another sound, you little shit."`,
				`"Shut your mouth, brat."`,
				`"One more sound and I'll give you something to moan about."`
			)>>
		<</if>>
	<<elseif $speechdemand is 1>>
		<<if $enemyanger lte 20>>
			<<print $_stringsPre + either(
				`"You're in no position to negotiate."`,
				`"You've got nerve. I'll give you that."`,
				`"Did you think that would work?"`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"You don't give orders here."`,
				`"That mouth is going to cost you, brat."`,
				`"You're not in a position to demand anything."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Mouthy little shit."`,
				`"Shut your goddamn mouth."`,
				`"You don't get to make demands. You never did."`
			)>>
		<</if>>
	<<elseif $speechscream is 1>>
		<<set $speechscream to 0>>
		<<if $enemyanger lte 50>>
			<<print $_stringsPre + either(
				`"Shut up."`,
				`"Be quiet."`,
				`"No one's coming."`,
				`"Who exactly do you think is going to help you?"`,
				`"Shut up. Be quiet."`
			)>>
		<<else>>
			<<print either(
				`"Shut up."`,
				`"You're being noisy."`,
				`"Be. Quiet."`,
				`<<He>> snarls. "Noisy little shit."`,
				`<<He>> slaps you. "Shut up."`,
				`<<He>> slaps you. "You're being noisy."`,
				`<<He>> slaps you. "Be. Quiet."`
			)>>
		<</if>>
	<<elseif $speechforgive is 1>>
		<<if $syndromebailey and !$baileyUniqueComments.includes("forgive")>>
			<<set $baileyUniqueComments.pushUnique("forgive")>>
			<<print `<<His>> rhythm falters. <<He>> doesn't respond. Something in <<his>> eyes burn.`>>
		<<elseif $syndromebailey>>
			<<print `<<His>> rhythm falters. <<He>> presses <<his>> mouth into a hard line but does not answer.`>>
		<<elseif $enemyanger lte 20>>
			<<print $_stringsPre + either(
				`"I don't need your forgiveness."`,
				`"Shut up."`,
				`"Shut it."`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print either(
				`"Forgive me?" <<He>> sneers. "For what."`,
				`"Shut the hell up."`,
				`"Save it."`
			)>>
		<<else>>
			<<print either(
				`"Shut your goddamn mouth and take it."`,
				`"Close your damn mouth, or I'll close it for you."`,
				$_stringsPre + `"Forgive me? For what?"`
			)>>
		<</if>>
	<<elseif $speechgrowl is 1 or $speechgrowlheat is 1 or $speechgrowlrut is 1>>
		<<if $speechgrowlheat is 1 or $speechgrowlrut is 1>>
			<<print $_stringsPre + either(
				`"Your body's already given in. The rest of you can follow."`,
				`"I have buyers who'd pay big to see you like this."`,
				`"Pull yourself together."`,
				`"Look at you. Can't even keep yourself together."`
			)>>
		<<elseif $enemyanger lte 20>>
			<<print $_stringsPre + either(
				`"This is what I get for taking in strays."`,
				`"Down, <<girl>>."`,
				`"Sit."`
			)>>
		<<elseif $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"Are you going to be difficult?"`,
				`"You little mutt."`,
				`"A muzzle would suit you."`,
				`"I'll muzzle you if I have to."`
			)>>
		<<else>>
			<<print either(
				`"I'll give you something to make noise about."`,
				`"Do it. Bite. See what it costs you."`,
				`"Bite if you want. See what it costs you."`,
				`"Put those away." <<He>> looks at your fangs. "Or I'll file them down."`
			)>>
		<</if>>
	<<elseif $speechapologiseunforgiving is 1>>
		<<set $speechapologiseunforgiving to 0>>
		<<if $enemyanger lte 100>>
			<<print $_stringsPre + either(
				`"Shut up. I've heard it all before."`,
				`"Save it. If you were sorry, you'd stop struggling."`
			)>>
		<<else>>
			<<print $_stringsPre + either(
				`"Do you think I give a damn, you little shit?"`,
				`"Did you really think I would fall for that?"`
			)>>
		<</if>>
	<<elseif $speechpenissmall is 1>>
