					<<He>> hooks a finger under your $worn.over_lower.name. "Another barrier. I admire the optimism."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.lower.name isnot "naked" and $worn.lower.state isnot "waist">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> pats your $worn.lower.name. "Keeping these neat is going to be difficult."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.under_lower isnot undefined and $worn.under_lower.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> glances at your $worn.under_lower.name and giggles. "Oh, that's sweet. You dressed up underneath as well."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.head.name isnot "naked" and $worn.head.name isnot "sage witch hat">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> adjusts your $worn.head.name with a fond smile. "There. Can't have you looking untidy."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.face isnot undefined and $worn.face.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> touches your $worn.face.name. "Hiding your face from me? That's a little rude."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.neck.name isnot "naked" and !$worn.neck.name.includes("pendant")>>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> slips a finger beneath your $worn.neck.name. "This suits you. It draws the eye nicely."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.hands isnot undefined and $worn.hands.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> catches your hand and turns it over, admiring your $worn.hands.name. "Pretty hands. Try not to scratch me too badly."
				<</addSpeechLine>>
			<</if>>
			<<if $worn.feet isnot undefined and $worn.feet.name isnot "naked">>
				<<addSpeechLine "idle" 2>>
					<<set $gwylanUniqueComments.pushUnique("clothes")>>
					<<He>> glances down at your $worn.feet.name. "Practical. Not that they'll help you run very far."
				<</addSpeechLine>>
			<</if>>
		<</if>>

		<<addSpeechLine "idle">>
		<<speechLine>>
			<<He>> whispers. "You can just lay there, and I'll take care of you."
		<<speechLine>>
			<<He>> whispers. "Share your burden with me."
		<</addSpeechLine>>

		<<if $gwylanSeen.includes("ritual_sex") and !$gwylanSeen.includes("partners")>>
			<<addSpeechLine "idle">>
				<<He>> speaks. "Remember, no kissing."
			<</addSpeechLine>>
		<</if>>

		<<if $enemyanger gte 15>>
			<<addSpeechLine "idle">>
				"Just hold still and let me work."
			<</addSpeechLine>>
		<</if>>

		<<if $consensual isnot 1 and $enemyanger gte 20>>
			<<addSpeechLine "idle" 3>>
			<<speechLine>>
				<<He>> speaks. "Don't try to resist, dear."
			<<speechLine>>
				<<He>> speaks. "Just give in to me. I'll make everything okay."
			<<speechLine>>
				<<He>> speaks. "Shh, don't think about it. Just keep your eyes on mine."
			<<speechLine>>
				<<He>> speaks. "Sink deeper with me. The pain will go away."
			<<speechLine>>
				<<He>> speaks. "We all have to suffer a little."
			<</addSpeechLine>>
			<<if $gwylanSeen.includes("yearning")>>
				<<addSpeechLine "idle" 3>>
					<<He>> speaks. "You owe me this much after what you did, dear."
				<</addSpeechLine>>
				<<addSpeechLine "idle" 4>>
					<<He>> speaks. "Your kiss poisoned me. You will take responsibility."
				<</addSpeechLine>>
			<</if>>
			<<if $gwylanSeen.includes("romance")>>
				<<addSpeechLine "idle" 3>>
					<<He>> speaks. "Forever means forever, dear. Through sickness and health."
				<</addSpeechLine>>
			<</if>>
		<</if>>

		<<if $combat_silenced>>
			<<addSpeechLine "idle" 2>>
				<<He>> giggles. "Aww, you look like you have something to say. Don't worry, your lovely voice is safe with me."
			<</addSpeechLine>>
		<</if>>

		<<if _gwylanTF.known is true and _gwylanTF.tail is "revealed">>
			<<if _gwylanStatus.includes("heat")>>
				<<addSpeechLine "idle">>
					<<His>> face is deeply flushed, and <<he>> lets out a low whine. You wonder if <<hes>> in <<if C.npc.Gwylan.pronoun is 'm'>>rut<<else>>heat<</if>>.
				<</addSpeechLine>>
			<</if>>
			<<addSpeechLine "idle">>
				One of <<his>> fox ears twitches.
			<</addSpeechLine>>
			<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
				<<addSpeechLine "idle">>
					<<His>> tail sways back and forth quickly.
				<</addSpeechLine>>
			<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
				<<addSpeechLine "idle">>
					<<His>> tail sways back and forth.
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "idle">>
					<<His>> tail sways back and forth slowly.
				<</addSpeechLine>>
			<</if>>
		<</if>>
		/* Mod lines: X-Change pills, scratching, hissing and situational idle comments. */
		<<if $speechpillreveal is 1>>
			<<addSpeechLine "reveal">>
				<<set $speechpillreveal to 0>>
				<<print [
					`<<He>> tilts <<his>> head at the X-Change $xchangePillWord, entirely unbothered. "Oh, is that for me? How sweet of you to ask first, dear."`,
					`<<He>> glances at your X-Change $xchangePillWord without a trace of alarm. "Go on, if you like. Something tells me I'll manage just fine."`,
					`<<He>> smiles at the sight of your X-Change $xchangePillWord. "Do you think that frightens me, dear? I couldn't tell you why, but I doubt it'll be as strange as you're hoping."`
				][random(0, 2)]>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechpill is "herm" or $speechpill is 1>>
			<<addSpeechLine "reveal">>
				<<set _gwylanPilledHerm to $speechpill is "herm">><<set $speechpill to 0>>
				<<if _gwylanPilledHerm>>
					<<print `<<He>> looks down at <<his>> newly doubled anatomy and laughs softly. "` + [
						`Oh, both at once. Isn't that something.`,
						`How generous. I'll enjoy finding a use for all of it.`,
						`Mm, this feels oddly familiar. I couldn't tell you why.`
					][random(0, 2)] + `"`>>
				<<else>>
					<<print `<<He>> studies <<his>> changed body with open curiosity, entirely at peace with it. "` + [
						`There we are. Just another shape to grow used to.`,
						`Strange... this doesn't feel like the first time. Though I couldn't say when the last one was.`,
						`Give me a moment, dear, and I'll be right at home in this one too.`
					][random(0, 2)] + `"`>>
				<</if>>
				<<npcincr Gwylan lust 3>><<glust>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechscratch is 1>>
			<<addSpeechLine "playerHits">>
				<<set $speechscratch to 0>>
				<<if $consensual is 1>>
					<<print either(
						`<<He>> shivers under your nails. "That's it, dear. Don't be shy."`,
						`<<He>> touches the scratches and smiles. "I did say you could."`,
						`<<He>> presses closer, ears twitching. "Ah... just like that."`
					)>>
					<<if _gwylanStatus.includes("heat") or $enemypleasure gte ($enemypleasuremax / 5) * 4>>
						<<npcincr Gwylan lust 3>><<glust>>
					<<else>>
						<<npcincr Gwylan lust 2>><<glust>>
					<</if>>
					<<if $gwylanSeen.includes("romance") or $gwylanSeen.includes("yearning")>>
						<<set $enemytrust += 5>>
					<</if>>
				<<elseif $enemyanger gte 80 or ($consensual isnot 1 and $enemyanger gte 20)>>
					<<print either(
						`<<He>> looks at the scratches, then back at you. "Claw all you like, dear. It will not make me let go."`,
						`<<He>> winces, but <<his>> voice stays gentle. "If you need to hurt me, do it. I can bear a little pain."`,
						`<<He>> catches your wrist, expression softening in the wrong way. "If you cannot keep your hands kind, I will keep them still."`,
						`<<He>> studies the red lines. "You are making this harder for yourself, dear. Not for me."`
					)>>
					<<set $enemyanger += 15>><<set $enemytrust -= 20>>
				<<elseif $gwylanSeen.includes("romance") or $gwylanSeen.includes("yearning")>>
					<<print either(
						`<<He>> touches the scratches with a strange little smile. "You left another mark on me. How careless."`,
						`<<He>> stares at the red lines, voice going quiet. "First my heart, now my skin. You are very thorough, dear."`,
						`<<He>> presses <<his>> fingers over the marks. "Is this how you keep me? I thought we had already settled that."`,
						`<<He>> shivers, then giggles under <<his>> breath. "A mark for a mark. That almost feels fair."`
					)>>
					<<npcincr Gwylan lust 2>><<glust>>
					<<set $enemytrust -= 5>><<set $enemyanger += 5>>
				<<elseif _gwylanStatus.includes("heat") or $enemypleasure gte ($enemypleasuremax / 5) * 4>>
					<<print either(
						`<<He>> sucks in a breath, foxlike focus sharpening in <<his>> eyes. "Oh. That was not as discouraging as you hoped."`,
						`<<He>> touches the scratches, ears twitching. "Naughty thing. Do you want me to chase you, or hold you down?"`,
						`<<He>> whines softly, staring at the marks. "Ah, that stung..."`,
						`<<He>> laughs, shaky. "Dear, if you make pain feel sweet, I will start getting ideas."`
					)>>
					<<npcincr Gwylan lust 3>><<glust>><<set $enemyanger += 5>><<set $enemytrust -= 5>>
				<<else>>
					<<print either(
						`<<He>> winces, then gives you a wounded smile. "Ouch. Poor manners, dear."`,
						`<<He>> looks at the scratches and sighs. "I did ask you not to scratch me too badly."`,
						`<<He>> rubs the red lines with <<his>> thumb. "You have made your point."`,
						`<<He>> catches your hand gently. "No more claws unless you want me to hold them for you."`
					)>>
					<<set $enemyanger += 5>><<set $enemytrust -= 10>>
				<</if>>
			<</addSpeechLine>>
		<</if>>
		<<if $speechhiss is 1>>
			<<addSpeechLine "growl">>
				<<He>> giggles. "Oh, what a fierce hiss. Show me those fangs again." <<npcincr Gwylan lust 1>><<glust>><br>
			<</addSpeechLine>>
		<</if>>
		<<if $speechhissheat is 1 or $speechhissrut is 1>>
			<<addSpeechLine "growl">>
				<<He>> giggles. "Oh, what a lovely little hiss. Shh, I'll make you feel better." <<npcincr Gwylan lust 1>><<glust>><br>
			<</addSpeechLine>>
		<</if>>
		<<if $consensual is 1>>
			<<addSpeechLine "idle" 2>>
				<<He>> brushes a thumb over your skin. "Tell me if you want me to slow down. I do listen when asked nicely."
			<</addSpeechLine>>
			<<addSpeechLine "idle" 2>>
				<<He>> smiles. "Relax, dear. You're allowed to enjoy yourself."
			<</addSpeechLine>>
			<<if $gwylanSeen.includes("romance")>>
				<<addSpeechLine "idle" 3>>
					<<He>> leans close, voice soft. "I promised I'd take care of you, didn't I?"
				<</addSpeechLine>>
				<<addSpeechLine "idle" 3>>
					<<He>> giggles. "Look at you. Still mine, even when you're making such a mess of yourself."
				<</addSpeechLine>>
			<</if>>
		<<else>>
			<<addSpeechLine "idle" 2>>
				<<He>> speaks gently. "Hush now. Fighting me only makes this harder for you."
			<</addSpeechLine>>
			<<addSpeechLine "idle" 2>>
				<<He>> holds you steady. "You can glare as much as you like, dear. I'm still here."
			<</addSpeechLine>>
		<</if>>

		<<if $arousal gte ($arousalmax / 5) * 4>>
			<<addSpeechLine "idle" 3>>
				<<He>> giggles. "Your body is being very honest with me."
			<</addSpeechLine>>
		<<elseif $arousal gte ($arousalmax / 5) * 2>>
			<<addSpeechLine "idle" 2>>
				<<He>> studies your expression. "There it is. You're starting to feel it."
			<</addSpeechLine>>
		<</if>>

		<<if $enemypleasure gte ($enemypleasuremax / 5) * 4>>
			<<addSpeechLine "idle" 3>>
				<<He>> shivers, and <<his>> smile turns shaky. "Oh. I may have got a little carried away."
			<</addSpeechLine>>
		<<elseif $enemypleasure gte ($enemypleasuremax / 5) * 2>>
			<<addSpeechLine "idle" 2>>
				<<He>> exhales softly. "You're making it difficult to stay composed."
			<</addSpeechLine>>
		<</if>>

		<<if $orgasmcount gte 3>>
			<<addSpeechLine "idle" 3>>
				<<He>> giggles. "Again? My, you're greedy today."
			<</addSpeechLine>>
		<</if>>

		<<if $settings.pregnancySpeechEnabled and playerIsPregnant()>>
			<<addSpeechLine "idle" 3>>
				<<He>> places a careful hand over your <<bellyDescription>>. "I'll be gentle with the blessing you're carrying."
			<</addSpeechLine>>
		<</if>>

		<<if _gwylanStatus.includes("wantsPregnancy") and $settings.pregnancySpeechEnabled and !npcIsPregnant("Gwylan")>>
			<<addSpeechLine "idle" 3>>
				<<He>> bites <<his>> lip, gaze dropping for a moment. "Don't waste anything if you finish."
			<</addSpeechLine>>
		<</if>>

		<<if _gwylanStatus.includes("heat")>>
			<<addSpeechLine "idle" 3>>
				<<He>> whines under <<his>> breath. "I hate how much this body wants you. No, that's a lie. I like it."
			<</addSpeechLine>>
		<</if>>

		<<if playerHasStrapon()>>
			<<addSpeechLine "idle" 2>>
				<<He>> glances at your <<penisSimple>>. "I suppose toys have their place. Less warm, but easier to clean."
			<</addSpeechLine>>
		<</if>>

		<<if effectiveTransformationLevel("angel") gte 6>>
			<<addSpeechLine "idle" 3>>
				<<He>> admires you for a quiet moment. "You make holiness look terribly tempting."
			<</addSpeechLine>>
		<</if>>

		<<if effectiveTransformationLevel("fallen") gte 2>>
			<<addSpeechLine "idle" 3>>
				<<He>> gives you a knowing smile. "Still falling, dear? Or have you landed somewhere interesting?"
			<</addSpeechLine>>
		<</if>>

		<<if (effectiveTransformationLevel("wolf") gte 6) or (effectiveTransformationLevel("fox") gte 6) or (effectiveTransformationLevel("cat") gte 6)>>
			<<addSpeechLine "idle" 3>>
				<<He>> watches your tail with open amusement. "That gives you away more than your face does."
			<</addSpeechLine>>
		<</if>>

		<<if $hallucinations gte 2>>
			<<addSpeechLine "idle" 2>>
				<<He>> traces a slow shape in the air. "Stay with me. Don't look at anything that isn't real."
			<</addSpeechLine>>
		<</if>>

		<<if $stress gte 8000>>
			<<addSpeechLine "idle" 2>>
				<<He>> softens a little. "You're wound up so tight. Let me loosen the knot."
			<</addSpeechLine>>
		<</if>>

		<<if $control lte ($controlmax / 5)>>
			<<addSpeechLine "idle" 2>>
				<<He>> steadies you with both hands. "Careful. You're starting to drift."
			<</addSpeechLine>>
		<</if>>

		<<if $gwylanSeen.includes("yearning")>>
			<<addSpeechLine "idle" 2>>
				<<He>> smiles without much humour. "You left a mark on me first. I'm only returning the favour."
			<</addSpeechLine>>
		<</if>>

		<<if $gwylanSeen.includes("hypnosis_silence")>>
			<<addSpeechLine "idle" 2>>
				<<He>> brushes <<his>> fingers near your lips. "I remember how quiet you can be. Shall we keep it voluntary this time?"
			<</addSpeechLine>>
		<</if>>
		<<speechSay>>
	<</if>>
<</widget>>
