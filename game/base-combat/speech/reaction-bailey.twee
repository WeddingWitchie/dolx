:: Widgets reaction-Bailey [widget]

<<widget "pc-line-bailey-moan">>
	<<addPairedSpeechLine "Bailey" "moan">>
		<<pcLine>>"Take what's yours, <<baileyTitle>>."
	<<npcLine>>
		<<if baileyStraying()>>
			<<print $_stringsPre>>"It was never yours to offer."
		<<elseif $baileyMonogamous>>
			<<print $_stringsPre>>"You've always been mine."
		<<elseif $syndromeBailey>>
			<<print $_stringsPre>>"You're offering me what's already mine."
		<<else>>
			<<print $_stringsPre>><<print either(
				`"I don't need your permission, brat."`,
				`"I plan to collect."`
			)>>
		<</if>>
	<</addPairedSpeechLine>>
	<<addPairedSpeechLine "Bailey" "moan">>
		<<pcLine>>"Show me what I'm worth to you, <<baileyTitle>>."
	<<npcLine>>
		<<if baileyStraying()>>
			<<print $_stringsPre>>"Ask the highest bidder."
		<<elseif $baileyMonogamous>>
			<<print $_stringsPre>>"Worth enough to keep."
		<<else>>
			<<print $_stringsPre>>"Show me you're worth keeping, first."
		<</if>>
	<</addPairedSpeechLine>>
	<<if $syndromeBailey>>
		<<addPairedSpeechLine "Bailey" "moan">>
			<<pcLine>><<print either(`"I'm yours, <<baileyTitle>>. I've always been yours."`, `"It's always been you, <<baileyTitle>>."`)>>
		<<npcLine>>
			<<print $_stringsPre>><<print either(
				`"Prove it."`,
				`"I know."`,
				`"You're catching up. Good."`
			)>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>
