:: Widgets speech-Kylar [widget]
<<widget "speech-kylar">>
	<<set _kylar to statusCheck("Kylar")>>
	<<set _kylarPenisSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _kylarPenisSize to $NPCList[_n].penissize>>
	<<elseif C.npc.Kylar and C.npc.Kylar.penissize isnot undefined>>
		<<set _kylarPenisSize to C.npc.Kylar.penissize>>
	<</if>>

	<<if $speechvaginavirgin is 1 and $player.virginity.vaginal is "Kylar">>
		<<if _kylarPenisSize gte 5>>
			<<He>> gasps, eyes wet and shining. "I didn't mean to hurt you. I just... I couldn't stop once we were finally together."
		<<else>>
			<<He>> gasps. "You were a virgin too. We were meant for each other."
		<</if>>
	<<elseif $speechpenisvirgin is 1 and $player.virginity.penile is "Kylar">>
		<<He>> gasps. "You saved this for me. I knew it. I knew we were meant to be each other's first."
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Kylar">>
		<<if $player.vaginaExist and $settings.pregnancySpeechEnabled>>
			<<He>> gasps. "We can't make babies this way, but I just couldn't resist you."
		<<elseif !$player.vaginaExist and _kylar.gender is "m" and knowsAboutAnyPregnancy("pc","Kylar") and $settings.pregnancySpeechEnabled>>
			<<He>> gasps. "Is this how you got pregnant before? But you were still a virgin!"
		<<elseif _kylarPenisSize gte 5>>
			<<He>> trembles. "You're shaking so much. Please don't break. Please, please don't break before we're done."
		<<else>>
			<<He>> gasps. "Every part of you, the deepest part of you. I wanna feel it all!"
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Kylar">>
		<<if _kylarPenisSize gte 5>>
			<<He>> strokes your cheek with shaking fingers. "Careful. Slowly. I dreamt about this, but I don't want you choking because of me."
		<<else>>
			<<He>> gasps. "Finally, you're kissing the most intimate part of me. Just like in my dreams!"
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Kylar">>
		<<He>> gasps. "Iloveyouiloveyouiloveyou!!!"
		<<set $kylarSeen.pushUnique("saidLove")>>
	<<elseif $speechcrossdressaroused is 1 and $settings.pregnancySpeechEnabled>>
		<<if _kylar.gender is "h">>
			<<He>> gasps. "Oh. I thought you were..." <<He>> shakes <<his>> head with a grin. "Oh well! We can still make a family together...!"
		<<elseif $player.penisExist>>
			<<He>> gasps. "You can make me pregnant. I'd given up on making a family, but..." <<He>> starts to cry. "You can make me pregnant...!"
		<<else>>
			<<He>> gasps. "I can make you pregnant. I'd given up on making a family, but..." <<He>> starts to cry. "I can make you pregnant...!"
		<</if>>
	<<elseif $speechcrossdressdisappointed is 1>>
		<<if !$player.vaginaExist and knowsAboutAnyPregnancy("pc","Kylar")>>
			<<He>> sighs. "Oh. I thought you were..." <<He>> suddenly looks excited. "But weren't you pregnant before? Hmm, there's still a chance then."
		<<else>>
			<<He>> sighs. "Oh. I thought you were..." <<He>> shakes <<his>> head. "I-it's okay. We can always adopt."
		<</if>>
	<<elseif $speechhermaroused is 1>>
		<<if _kylar.gender is "h" and $settings.pregnancySpeechEnabled>>
			<<He>> gasps. "You have both...? Just like me...? We could make so many children...perfection..."
		<<else>>
			<<He>> gasps. "You have both...? I didn't think you could get any more perfect..."
		<</if>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if _loveInterest is "Black Wolf" or _loveInterest is "Great Hawk">>
			<<His>> eyes narrow. "I can be an animal, too. Watch!"
		<<elseif random(1, 100) lte 50>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<He>> growls. "Robin can't take care of you like I can!"
				<<case "Whitney">>
					<<He>> freezes. "W... Whitney can't stop me!"
				<<case "Sydney">>
					<<He>> growls. "Sydney doesn't know you like I do!"
					<<set $kylarSeen.pushUnique("sydneyWriting")>>
				<<default>>
					<<He>> freezes. "Who... are you talking about...?"
			<</switch>>
		<<else>>
			<<He>> freezes. "You don't need them! You only need me!"
		<</if>>
		<<npcincr Kylar rage 10>><<ggksuspicion>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<if !$player.penisExist and $NPCList[0] and $NPCList[0].vagina isnot "none" and random(0,2) isnot 0>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`U-Use it. Please, use me, use it.`, `It's a sign of our love, right?`, `If it helps you feel closer to me, then it's ours.`][random(0,2)] + `"`>>
		<<elseif ($player.penisExist or ($NPCList[0] and $NPCList[0].penis isnot "none")) and random(0,2) isnot 0>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`What... am I doing wrong...?`, `If it makes you happy, my love, but...`, `You don't need that when I'm right here.`][random(0,2)] + `"`>>
		<<else>>
			<<He>> looks at your $_sexToy and pouts. "Am I not good enough for you?"
		<</if>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<print either(
				`<<He>> stares at the scratches, breathing turning ragged. "You marked me. You marked me. Fine. Fine, I'll mark you too."`,
				`<<He>> touches the red lines and starts to laugh. "You did it first. Don't cry when I do it back."`,
				`<<He>> presses <<his>> fingers to the marks, eyes wide. "You want proof? Is that it? I'll give you proof. I'll give you so much proof."`,
				`<<He>> trembles, staring at the scratches. "Mine. Yours. Mine. Yours. You can't take it back now."`
			)>>
			<<npcincr Kylar lust 10>><<glust>><<set $enemytrust -= 15>><<set $enemyanger += 5>>
		<<elseif _loveInterest is "Kylar">>
			<<print either(
				`<<He>> looks at the scratches as if you've kissed <<him>>. "You marked me... you really marked me."`,
				`<<He>> shivers, touching the red lines with a dreamy smile. "That's yours. That's where you touched me. Everyone will know."`,
				`<<He>> stares at the marks, eyes shining. "You wanted to leave something on me. You did. You did."`,
				`<<He>> laughs under <<his>> breath, almost crying. "I knew it. I knew you wanted me to belong to you too."`
			)>>
			<<npcincr Kylar lust 10>><<gglust>><<npcincr Kylar love 5>><<gglove>><<set $enemytrust += 15>><<set $enemyanger -= 5>>
		<<else>>
			<<print either(
				`<<He>> freezes at the scratches, then smiles too wide. "You marked me. You marked me. You can't pretend that means nothing."`,
				`<<He>> rubs the red lines with shaking fingers. "That's yours now. I'm yours now. That's how this works, right?"`,
				`<<He>> stares at the marks, face flushing. "You touched me so hard it stayed. That's not nothing. That's not nothing."`,
				`<<He>> lets out a breathless laugh. "If you get to mark me, I get to mark you. That's fair. That's love."`
			)>>
			<<npcincr Kylar lust 8>><<gglust>><<set $enemytrust += 5>><<set $enemyanger -= 10>>
		<</if>>
	<<elseif $combatgoal is "strip" and $rng lte 25>>
		<<if $enemyanger gte 80>>
			<<print `<<He>> tugs at your clothes with frantic hands. "` + [`Stop hiding from me. I know what you look like underneath.`, `These keep getting between us. I hate them.`, `You don't need anything else. You have me.`][random(0,2)] + `"`>>
		<<else>>
			<<print `<<He>> fusses with your clothes, face flushed. "` + [`I just want to see you. Only me.`, `You look so pretty when you stop covering up.`, `Don't be shy. I already know you're perfect.`][random(0,2)] + `"`>>
		<</if>>
	<<elseif _silent isnot 1>>
		<<set $kylarsexcycle to $kylarsexcycle or 0>>
		<<switch $kylarsexcycle>>
			<<case 0>>
				<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or (!$genderknown.includes("Kylar") and perceivedGender() is "f"))>>
					<<He>> whispers into your ear. "We're going to make lots of babies."
				<<else>>
					"We're going to adopt lots of babies," <<he>> says.
				<</if>>
			<<case 1>>
				<<print `"You'll be the best <<pmummy>> ever," <<he>> says.`>>
			<<case 2>>
				"You're so naughty," <<he>> says. "We're not even married yet!"
			<<case 3>>
				"I want you to wear me out," <<he>> says, "and then keep going."
			<<case 4>>
				<<print `"I'm going to do this again and again until you forget about every other ${$pronoun is "m" ? "bastard" : "whore"} who's looked at you," <<he>> says.`>>
			<<case 5>>
				"I'll be the only one you ever think about," <<he>> says.
			<<case 6>>
				"Everyone is bad," <<he>> says. "Except you. You're perfect."
			<<case 7>>
				"I feel safe like this," <<he>> says. "I never want it to end."
			<<case 8>>
				"I...l-love you," <<he>> says.
				<<set $kylarSeen.pushUnique("saidLove")>>
			<<case 9>>
				"You made that sound just for me, didn't you?" <<he>> asks, smiling too wide.
			<<case 10>>
				"Don't think about anyone else," <<he>> whispers.
			<<case 11>>
				"I know every face you make," <<he>> says. "This one's my favourite."
			<<case 12>>
				"If you wanted me to stop staring, you shouldn't have been so beautiful," <<he>> says.
			<<case 13>>
				"We should run away after this," <<he>> says. "Somewhere quiet. Somewhere locked."
			<<case 14>>
				"Say my name," <<he>> pleads. "I need to hear it."
			<<default>>
				"You're so lewd and naughty and all mine," <<he>> says.
		<</switch>>
		<<set $kylarsexcycle to ($kylarsexcycle + 1) % 16>> <!-- increase by one, and reset to 0 if it hits 16 -->
	<<else>>
		"Ah...! Mnh." <<He>> moans.
	<</if>>
<</widget>>
