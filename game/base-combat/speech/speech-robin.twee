:: Widgets speech-Robin [widget]
<<widget "speech-robin">>
	<<set _npc_speech to true>>
	<<set _robinPenisSize to (C.npc.Robin.penissize or 0)>>
	<<set _robinColossalPenis to _robinPenisSize gte 5>>
	<<if $robinmist>>
		<br><br>
		<<print [
			`Robin is crying.`,
			`Robin frantically tries to look away from you, but <<he>> doesn't stop.`,
			`"I d-don't..." Robin whispers under <<his>> breath.`,
			`"I love you!" Robin says, though <<hes>> not smiling.`,
			`"I just need—" Robin gasps. <<He>> doesn't try to finish <<his>> sentence.`,
			`Robin closes <<his>> eyes, unable to meet your gaze.`,
			`Robin cries out. Tears are running down <<his>> face.`,
			`Robin shakes <<his>> head and closes <<his>> eyes.`,
			`"S-Stop it!" Robin yells, but not at you.`,
			`"I need you..." Robin says with teary eyes.`,
			`Robin grips at the sheets. "I can't think straight..."`,
			`"Please don't look at me like that," Robin says, voice shaking.`,
			`Robin bites <<his>> lip until <<his>> breath turns shaky.`,
			`"I'm sorry," Robin says, even though <<he>> does not pull away.`
		][random(0,13)]>>
		<<grtrauma>>
	<<elseif $robinMetal>>
		<<print [
			`Robin can't maintain eye contact.`,
			`"Hurry," Robin whispers. "So they'll leave you alone."`,
			`Robin struggles against <<his>> bindings.`,
			`Robin struggles against the metal tentacles holding <<him>>. They don't budge.`,
			`"Please," Robin whimpers.`,
			`Robin stifles a sob.`,
			`"I'm sorry," Robin hiccups.`,
			`"They did something to me," Robin says shamefully. "I feel... numb."`,
			`"I'm sorry it's taking so long," Robin mutters.`,
			`"They're using me against you," Robin sobs.`,
			`Robin twists against the metal, then flinches when it tightens around <<him>>.`,
			`"I don't want them watching," Robin whispers.`,
			`Robin swallows hard. "Just focus on me, okay? Not them."`,
			`"I hate this," Robin says, trembling. "I hate that they're making it feel good."`
		][random(0,13)]>>
	<<elseif $speechNPCPenisVirgin is 1 or $speechNPCVaginaVirgin is 1>>
		<<if _robinColossalPenis>>
			<<He>> clings to you, overwhelmed. "That was... a lot. I thought I was ready, but I still feel like I'm shaking everywhere."
		<<else>>
			<<print [
				`<<He>> clings to you, face buried against your shoulder. "That was my first time. I'm glad it was with you."`,
				`<<He>> gasps softly. "I was so nervous, but it felt right with you."`,
				`Robin trembles in your arms. "Please stay close for a bit. I don't want to move yet."`,
				`<<He>> blushes and gives you a shy smile. "I think... I think I'm happy it happened like this."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechNPCAnusVirgin is 1>>
		<<if _robinColossalPenis>>
			<<He>> hides <<his>> face against you. "I didn't know it could feel that intense. Please don't tease me if I walk funny."
		<<else>>
			<<print [
				`<<He>> squeaks, then covers <<his>> mouth. "Don't laugh. That was new for me."`,
				`Robin's face turns bright red. "I can't believe we did that. I can't believe I liked it."`,
				`<<He>> squirms, embarrassed. "I need a minute. Maybe two."`,
				`<<He>> looks away, smiling despite <<himself>>. "That was... really naughty."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechNPCKissVirgin is 1>>
		<<print [
			`Robin stares at you, stunned. "That was my first kiss." <<He>> smiles shyly. "I'm glad."`,
			`<<He>> touches <<his>> lips with trembling fingers. "I always wondered what that would feel like."`,
			`Robin giggles, then immediately looks embarrassed. "Sorry. I just... that was nice."`,
			`<<He>> leans closer, voice tiny. "Can we do that again later? When everything is less scary?"`
		][random(0,3)]>>
	<<elseif ($speechpenisvirgin is 1 and $player.virginity.penile is "Robin") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Robin")>>
		<<if $speechvaginavirgin is 1 and $player.virginity.vaginal is "Robin" and _robinColossalPenis>>
			<<He>> freezes, eyes wide with worry. "That was too much, wasn't it? I should have been gentler." Tears roll down <<his>> cheeks as <<he>> holds you close.
		<<else>>
			<<print [
				`<<He>> gasps. "You saved yourself for me. I don't deserve something so special. Thank you." Tears roll down <<his>> cheeks.`,
				`<<He>> looks at you as if afraid to blink. "I was your first? Really? ...Thank you."`,
				`Robin presses <<his>> forehead to yours. "I'll remember this forever. I promise."`,
				`<<He>> smiles through tears. "I don't know what to say. I just feel lucky."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Robin">>
		<<if _robinColossalPenis>>
			<<He>> trembles, panic evident in <<his>> voice. "I didn't hurt you too badly, did I? That looked impossible. Please tell me you're okay."
		<<else>>
			<<print [
				`<<He>> gasps. "This is so naughty!"`,
				`<<He>> blushes so hard <<his>> voice nearly disappears. "I can't believe you let me do that."`,
				`Robin squirms, embarrassed. "That was your first time there? With me?"`,
				`<<He>> covers <<his>> face. "I feel like we crossed a line. A really exciting line."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Robin">>
		<<if _robinColossalPenis>>
			<<He>> strokes your hair. "Please don't force yourself. I don't want you getting hurt because of me."
		<<else>>
			<<print [
				`<<He>> gasps. "You're making me feel funny down there."`,
				`Robin's breath catches. "That was your first time doing that? You're... you're really good."`,
				`<<He>> looks down at you, face flushed. "I don't know where to put my hands."`,
				`<<He>> swallows hard. "Tell me if I get too excited, okay?"`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Robin">>
		<<print [
			`Robin blinks, then smiles so softly it almost hurts. "Was that your first kiss? I'm honoured."`,
			`<<He>> touches your cheek. "I wanted that to be gentle. Was it okay?"`,
			`Robin's face turns pink. "I hope that was a good first kiss. I practised in my head."`,
			`<<He>> giggles nervously. "I think my heart forgot how to behave."`
		][random(0,3)]>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Whitney">>
				<<He>> goes pale. "Whitney? But <<nnpc_he "Whitney">> hurts you. Why would you say <<nnpc_his "Whitney">> name now?"
			<<case "Kylar">>
				Robin looks away, wounded. "Kylar already watches you enough. Do you think about <<him>> when you're with me too?"
			<<case "Sydney">>
				<<He>> swallows hard. "Sydney is so kind. I don't know how I'm supposed to compete with that."
			<<case "Gwylan">>
				Robin gives a tiny, nervous laugh. "Gwylan? I... I don't even know what to say to that."
			<<case "Avery">>
				<<He>> stiffens. "Avery can buy you nice things. I know I can't. But I'm still here."
			<<case "Eden">>
				Robin's eyes widen. "Eden? That's... that's dangerous, isn't it?"
			<<case "Black Wolf" "Great Hawk">>
				<<He>> stares at you, upset. "I don't understand. Are you trying to scare me?"
			<<case "Zephyr">>
				Robin frowns. "W-Who...?"
			<<default>>
				Robin's voice turns small. "Do you really wish I was someone else? So you're a cheater in more ways than one..."
		<</switch>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<if C.npc.Robin.dom gte 70>>
			<<print `<<He>> looks at your $_sexToy and giggles. "` + [`I've wanted to do this with you for a while.`, `This is so dirty...`, `Let me try to be brave with it.`, `If you trust me, I'll try to make it feel good.`][random(0,3)] + `"`>>
		<<elseif C.npc.Robin.dom lte 30>>
			<<print `<<He>> looks at your $_sexToy and blushes. "` + [`Woah! Don't you feel embarrassed?`, `Just take it slow, okay?`, `That's bigger than I expected.`, `Maybe we should read the instructions first.`][random(0,3)] + `"`>>
		<<else>>
			<<print `<<He>> looks at your $_sexToy and giggles. "` + [`I can't believe you're touching that.`, `This is so dirty...`, `I feel nervous just looking at it.`, `Okay. We can try it together.`][random(0,3)] + `"`>>
		<</if>>
	<<elseif $speechaskrough is 1>>
		<<print [
			`<<He>> speaks. "You want me to be more rough? I'm sorry, I'm already being as rough as I can."`,
			`Robin looks nervous. "I can try, but please tell me if I get it wrong."`,
			`<<He>> swallows. "Rougher? I don't want to hurt you. Not really."`,
			`Robin tries to look stern, but <<his>> blush ruins it. "Fine. I'll try. A little."`
		][random(0,3)]>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if C.npc.Robin.dom gte 70>>
			<<print either(
				`Robin hisses through <<his>> teeth, then looks wounded by <<his>> own reaction. "Ow. I wasn't going to hurt you."`,
				`<<He>> catches your wrist for a second, startled. "Don't. Please don't make me scared of you."`,
				`Robin stares at the scratch. "I-I... can be rough if you ask, but not like that."`
			)>>
			<<npcincr Robin love -5>><<lllove>><<set $enemytrust -= 25>><<set $enemyanger += 10>>
		<<else>>
			<<print either(
				`Robin flinches hard, staring at the red lines. "Ow... why would you do that?"`,
				`<<He>> pulls back, eyes wet. "That hurt. I thought you trusted me."`,
				`Robin touches the scratch with trembling fingers. "Please don't... uh..."`,
				`<<He>> looks at you as if you slapped <<him>>. "I wasn't trying to hurt you."`
			)>>
			<<npcincr Robin love -5>><<lllove>><<set $enemytrust -= 30>><<set $enemyanger += 5>>
		<</if>>
	<<elseif $speechvaginapenetrated is 1 or $speechvagina is 1>>
		<<set $speechvaginapenetrated to 0>>
		<<set $speechvagina to 0>>
		<<if _robinColossalPenis>>
			<<print [
				`<<He>> sucks in a sharp breath. "I-I know it's a lot. Keep breathing for me."`,
				`Robin's voice shakes. "Tell me if I need to stop. I mean it."`,
				`<<He>> braces <<himself>>, eyes fixed on you. "Slow. We have to go slow."`,
				`Robin whispers, "I don't want to hurt you. I just want to stay close."`
			][random(0,3)]>>
		<<else>>
			<<print [
				`<<He>> starts whispering under <<his>> breath. "Keep the tempo. Keep the tempo..."`,
				`Robin blushes and tries to laugh. "Sorry. I'm counting beats in my head again."`,
				`<<He>> murmurs, "One, two, three, breathe. One, two, three, breathe."`,
				`Robin clings to the rhythm. "Okay. I can do this."`,
				`<<He>> starts whispering under <<his>> breath. "Up, up, down, down, left, right, left, right, B, A, Start."`,
				`Robin mutters something about timing windows and then blushes when <<he>> realises you heard.`,
				`<<He>> takes a shaky breath. "Sorry. I get nervous when it's quiet."`,
				`Robin glances at you, then away. "I'm still here. I promise."`,
				`<<He>> whispers, "Save point. We need a save point."`
			][random(0,3)]>>
		<</if>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
