:: Widgets speech-Robin [widget]
<<widget "speech-robin">>
	<<set _npc_speech to true>>
	<<rng>>
	<<set _robinPenisSize to (C.npc.Robin.penissize or 0)>>
	<<set _robinColossalPenis to _robinPenisSize gte 5>>
	<<if !$robinUniqueComments>>
		<<set $robinUniqueComments to []>>
	<</if>>
	<<if $robinmist>>
		<<speechPool "Robin" "noMouthAction">>
		<<if $speechPlayerHits>>
			<<addSpeechLine "playerHits">>
			<<speechLine>>
				<<He>> flinches as you strike. "Ugh!"
			<<speechLine>>
				<<He>> recoils as you hit <<him>>.
			<</addSpeechLine>>
		<</if>>
		<<if $speechScreamForHelp>>
			<<addSpeechLine "screamForHelp">>
			<<speechLine>>
				It goes over <<his>> head.
			<<speechLine>>
				<<He>> doesn't react.
			<<speechLine>>
				Robin tries to react to your screams, but fails.
			<</addSpeechLine>>
		<</if>>
		<<if $speechPepperSpray>>
			<<addSpeechLine "pepperSpray">>
				"Ouch!" <<He>> recoils with <<his>> hands over eyes. <<stress 6>><<gstress>>
			<</addSpeechLine>>
		<</if>>
		<<addSpeechLine "idle">>
			<br><br>
			<<print either(
				`Robin is crying.`,
				`Robin frantically tries to look away from you, but <<he>> doesn't stop.`,
				`"I d-don't...<<if $robinromance isnot 1>> I don't want to...<</if>>" Robin whispers under <<his>> breath.`,
				`<<if $robinromance is 1>>"I love you!" Robin says, though <<hes>> not smiling.<<else>>"I'm so sorry!" Robin says, looking horrified.<</if>>`,
				`"P-please, I just need—" Robin gasps. <<He>> doesn't try to finish <<his>> sentence.`,
				`Robin closes <<his>> eyes, unable to meet your gaze.`,
				`Robin cries out. Tears are running down <<his>> face.`,
				`Robin shakes <<his>> head and closes <<his>> eyes.`,
				`"S-stop it!" Robin yells, but not at you.`,
				`"<<if $robinromance is 1>>I need you...<<else>>I'm sorry... I'm sorry... I need to...<</if>>" Robin says with teary eyes.`,
				`Robin grips at the sheets. "I can't think straight..."`,
				`"Please don't look at me like that," Robin says, voice shaking.`,
				`Robin bites <<his>> lip until <<his>> breath turns shaky.`,
				`"I'm sorry," Robin says, even though <<he>> does not pull away.`
			)>>
			<<grtrauma>>
		<</addSpeechLine>>
		<<speechSay>>
	<<elseif $robinMetal>>
		<<speechPool "Robin" "noMouthAction">>
		<<addSpeechLine "idle">>
			<<print either(
				`Robin can't maintain eye contact.`,
				`<<if $robinromance is 1>>"Hurry," Robin whispers. "So they'll leave you alone."<<else>>"Please don't hate me," Robin whispers. "You have to... I'm sorry."<</if>>`,
				`Robin struggles against <<his>> bindings.`,
				`Robin struggles against the metal tentacles holding <<him>>. They don't budge.`,
				`"Please," Robin whimpers.`,
				`Robin stifles a sob.`,
				`"I'm sorry," Robin hiccups.`,
				`"They did something to me," Robin says shamefully. "I feel... numb."`,
				`"<<if $robinromance is 1>>I'm sorry it's taking so long," Robin mutters.<<else>>"I'm so sorry," Robin mutters. "I'm trying to, I... I can't..."<</if>>`,
				`"<<if $robinromance is 1>>They're using me against you," Robin sobs.<<else>>"You're my friend," Robin sobs. "I don't want to do this..."<</if>>`,
				`Robin twists against the metal, then flinches when it tightens around <<him>>.`,
