:: Widgets speech-Leighton [widget]
<<widget "speech-leighton">>
	<<set _npc_speech to true>>
	<<set _leightonSize to 0>>
	<<if def _n and $NPCList[_n] and $NPCList[_n].penissize isnot undefined>>
		<<set _leightonSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _leightonColossal to _leightonSize gte 5>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Leighton") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Leighton")>>
		<<if $speechvaginavirgin is 1 and _leightonColossal>>
			<<He>> smiles. "Still conscious? Good. We'll call that adequate progress, though your technique needs urgent correction."
		<<else>>
			<<He>> smirks. "<<print either("Far from satisfactory. Come see me again for further improvement.", "A poor first attempt, but not beyond correction.", "There is potential there. Very little, but enough to work with.", "You need far more practice before I would call that acceptable.")>>"
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Leighton">>
		<<if _leightonColossal>>
			<<He>> smiles. "I know it feels impossible, but discipline means doing it even when it's uncomfortable."
		<<else>>
			<<He>> smirks. "<<print either("You'll need plenty of training.", "That was clumsy. We'll have to repeat it until you learn.", "A difficult lesson, but one you plainly needed.", "Try not to look so shocked. You were always going to require strict instruction.")>>"
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Leighton">>
		<<if _leightonColossal>>
			<<He>> smiles. "I expect obedience, not choking panic. Open properly."
		<<else>>
			<<He>> smirks. "<<print either("You lack skill... For now.", "Poor form. Keep practising.", "You can do better than that. I expect you to prove it.", "That mouth of yours needs discipline as much as the rest of you.")>>"
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Leighton">>
		<<He>> smirks. "<<print either("Not terrible for a first time.", "A little eager, weren't you? Don't worry, I noticed.", "That was almost respectable. Almost.", "You may keep pretending that meant nothing, if it helps you behave.")>>"
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<He>> smirks. "Another student? Perhaps I should invite <<nnpc_him "Robin">> to my office."
			<<case "Kylar">>
				<<He>> frowns. "<<print either("Kylar? That explains a lot of things.", "Kylar again. I should have known your standards were that poor.", "That obsessive wretch? You do collect problems.")>>"
			<<case "Whitney">>
				<<He>> frowns. "<<print either("You and that delinquent? I'm not surprised.", "Whitney? Of course. Vulgarity does attract vulgarity.", "That delinquent has taught you some terrible habits. I'll correct them.")>>"
			<<case "Sydney">>
				<<if $sydneySeen.includes("spank")>>
					<<if random(1, 2) is 1>>
						<<He>> smirks. "Sydney? We could do <<nnpc_his "Sydney">> punishment in my office next time."
					<<else>>
						<<He>> smiles. "Sydney has already learned how useful my office can be. Perhaps you both need another lesson."
					<</if>>
				<<else>>
					<<if random(1, 2) is 1>>
						<<He>> smirks. "Sydney? I plan to have <<nnpc_him "Sydney">> in my office soon."
					<<else>>
						<<He>> smiles. "Sydney is overdue for a private appointment. You may have just reminded me."
					<</if>>
				<</if>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>> frowns. "<<print either("An animal? This requires extra discipline.", "That is not romance. That is evidence of a complete lack of self-control.", "I see. Your correction will need to be more thorough than I thought.")>>"
			<<default>>
				<<He>> smirks. "<<print either("I'm not familiar. This is a private matter, anyway.", "Another distraction? How tiresome.", "Whoever it is, they clearly haven't taught you enough restraint.", "You may keep your attachment. It won't help you here.")>>"
		<</switch>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<He>> laughs out loud. "<<print either("Maybe now you'll finally listen and behave!", "Good. Pain is an excellent teacher when words fail.", "I have your attention at last.", "Don't glare. It makes you look even more guilty.")>>"
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if _leightonColossal>>
			<<He>> smiles. "Do not disappoint me."
		<<else>>
			<<He>> smiles. "<<print either("You've been good, so here's your reward.", "There we are. Much better when your mouth is occupied.", "Keep your eyes on me while you learn.", "Silence suits you when it comes with effort.")>>"
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<He>> looks at your $_sexToy and smirks. "<<print either("I can teach you a thing or two with that.", "Planning to practise without supervision? How irresponsible.", "Bring that to my office and I may approve its use.", "At least you're finally showing some initiative.")>>"
	<<elseif $speechaskrough is 1>>
		<<set $speechaskrough to 0>>
		<<He>> smirks. "<<print either("Asking for stricter discipline? How honest of you.", "You want rough? Then stop whining when I correct you properly.", "A request like that belongs in my office.")>>"
	<<elseif $speechchastity is 1>>
		<<set $speechchastity to 0>>
		<<if playerChastity()>>
			<<He>> smirks. "<<print either("Locked up?", "A sensible precaution. You plainly can't be trusted otherwise.")>>"
		<<else>>
			<<He>> smiles. "I should consider putting you under stricter control. You invite supervision."
		<</if>>
	<<elseif $speechvaginapenetrated is 1 or $speechvagina is 1>>
		<<set $speechvaginapenetrated to 0>>
		<<set $speechvagina to 0>>
		<<if _leightonColossal>>
			<<He>> smiles. "Too much? No. You can take the lesson. Prove it."
		<<else>>
			<<He>> smirks. "<<print either("Settle down. Squirming won't improve your grade.", "You're learning how to take instruction.", "Keep still and I might call this progress.", "There is no need to make such a scene. You're managing.")>>"
		<</if>>
	<<elseif $speechanuspenetrated is 1 or $speechanus is 1>>
		<<set $speechanuspenetrated to 0>>
		<<set $speechanus to 0>>
		<<if _leightonColossal>>
			<<He>> smiles. "That look suits you. Shock, effort, and finally some respect for the scale of your lesson."
		<<else>>
			<<He>> smirks. "<<print either("You'll adjust. Complaining is not the same as failing.", "That is a difficult lesson, but difficulty builds character.", "You wanted attention. Now you have mine.")>>"
		<</if>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<print either(
				`<<He>> goes still, staring at the scratches with cold fury. "That was a mistake. You have just made this much worse for yourself."`,
				`<<He>> touches the marks, then fixes you with a hard look. "Violence now? Good. Then I no longer need to be gentle about correcting you."`,
				`<<He>> breathes in slowly, jaw tight. "You will regret that before this lesson is over."`,
				`<<He>> looks at the red lines, voice dropping. "I was being patient. You have mistaken that for weakness."`
			)>>
			<<set $enemyanger += 25>><<set $enemytrust -= 50>>
		<<else>>
			<<print either(
				`<<He>> frowns at the scratches. "Claws out? How undisciplined. We will correct that immediately."`,
				`<<He>> examines the marks, irritation sharpening <<his>> expression. "That is an invitation to stricter punishment."`,
				`<<He>> catches your wrist, eyes narrowing. "Do that again, and I will make the lesson far less comfortable."`,
				`<<He>> clicks <<his>> tongue. "Temper, violence, and poor judgement. You are making quite the case for harsher discipline."`
			)>>
			<<set $enemyanger += 15>><<set $enemytrust -= 30>>
		<</if>>
	<<elseif $speechcum is 1>>
		<<set $speechcum to 0>>
		<<He>> smirks. "<<print either("How undignified. Do try to compose yourself.", "Messy, but instructive.", "There. A measurable improvement in enthusiasm, if not decorum.", "I hope you're not expecting praise for losing control that quickly.")>>"
	<<else>>
		<<if random(1, 6) is 1>>
			<<He>> frowns. "<<print either("Eyes forward. I dislike repeating myself.", "Behave, and this may remain a private correction.", "You are making a poor case for leniency.", "Discipline is wasted on most fools. Try not to prove you are one of them.", "I expect better posture than that.", "This is why you require supervision.")>>"
		<<else>>
			<<print [
				`<<He>> clicks <<his>> tongue. "Tense, clumsy, and far too loud. We will correct that."`,
				`<<He>> raises an eyebrow. "Your technique needs work. Fortunately for you, I am an excellent tutor."`,
				`<<He>> gives you an appraising look. "A rough first effort. We can refine it."`,
				`<<He>> smirks. "See? Your body understands instruction even when you do not."`,
				`<<He>> watches you closely. "That response will do. We will work on your composure."`,
				`<<He>> hums. "There may be potential there, buried under all that impatience."`
			][random(0,5)]>>
		<</if>>
	<</if>>
<</widget>>