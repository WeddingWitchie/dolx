:: Widgets speech-Morgan [widget]
<<widget "speech-morgan">>
	<<set _npc_speech to true>>
	<<set _morganPenisSize to 0>>
	<<if C.npc.Morgan and C.npc.Morgan.penissize>>
		<<set _morganPenisSize to C.npc.Morgan.penissize>>
	<<elseif def _n and $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _morganPenisSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _morganColossalPenis to _morganPenisSize gte 5>>
	<<if $possessed>>
		<<switch random(1,13)>>
			<<case 1>>
				<<He>> roars. "I won't let you hurt <<phim "Morgan">>!"
			<<case 2>>
				<<He>> pleads. "Fight it, <<charles>>! Fight back!"
			<<case 3>>
				<<He>> spits. "Return to mist!"
			<<case 4>>
				<<He>> scowls. "Get out of here. Get out of <<phim "Morgan">>!"
			<<case 5>>
				<<He>> scowls. "I can see you falling apart."
			<<case 6>>
				<<He>> hisses. "Don't make me repeat myself."
			<<case 7>>
				<<He>> screeches incoherently.
			<<case 8>>
				<<He>> meets your eye and nods reassuringly.
			<<case 9>>
				<<He>> babbles under <<his>> breath.
			<<case 10>>
				<<He>> shakes <<his>> head. "You'll fall. You'll fall, and you won't get back up."
			<<case 11>>
				<<He>> bares <<his>> teeth. "You smell wrong. You sound wrong. Let <<phim "Morgan">> go."
			<<case 12>>
				<<He>> growls low in <<his>> throat. "Mist breaks. Bodies break. You will break first."
			<<case 13>>
				<<He>> whispers, "Listen to my voice, <<charles>>. Follow it back."
		<</switch>>
	<<elseif ($speechpenisvirgin is 1 and $player.virginity.penile is "Morgan") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Morgan")>>
		<<if _morganColossalPenis>>
			<<print [
				`Morgan holds you still, suddenly serious. "Breathe, <<charles>>. <<Mummy>> won't let the size swallow you whole."`,
				`<<He>> smiles. "Still with me? I was afraid I might break my favourite living thing."`,
				`Morgan strokes your cheek. "Poor thing."`,
				`<<He>> exhales slowly. "Don't rush. You took something enormous, and <<mummy>> is very proud."`
			][random(0,3)]>>
		<<else>>
			<<print [
				`<<He>> smiles. "This feels like your first time again. How did you do that, <<charles>>?"`,
				`Morgan tilts <<his>> head, delighted. "A first time with <<mummy>>. Doesn't that sound nice?"`,
				`<<He>> laughs softly. "You were so warm. So nervous. I could have eaten the moment whole."`,
				`Morgan cups your face. "There. Now that memory belongs to us."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Morgan">>
		<<if _morganColossalPenis>>
			<<print [
				`<<He>> keeps one hand on you. "That was a cruel size for a first time. Stay still. Let <<mummy>> check you're still in one piece."`,
				`Still smiling, Morgan starts to look worried. "I know, I know. It felt impossible. But you did so well, <<charles>>."`,
				`Morgan strokes your back. "That nearly made you disappear under me. <<Mummy>> saw."`
			][random(0,2)]>>
		<<else>>
			<<print [
				`<<He>> smiles. "<<charles>>, I got to pop your other cherry too! Isn't it wonderful?"`,
				`Morgan gives a pleased hum. "Another first for <<mummy>>. You're spoiling me."`,
				`<<He>> leans close. "You'll remember that whenever you sit down."`,
				`Morgan laughs softly. "So bashful. I thought you'd be used to haunting by now."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Morgan">>
		<<if _morganColossalPenis>>
			<<print [
				`Morgan threads <<his>> fingers through your hair. "Slowly. Wider. That's it, <<charles>>. Don't let pride choke you."`,
				`<<He>> watches your struggle with delight. "Poor mouth. <<Mummy>> should have warned you how greedy the dead can be."`,
				`Morgan's breath hitches. "Easy. It's a dreadful size to learn on, isn't it?"`,
				`<<He>> cups your cheek. "If you need air, take it. I want you haunted, not broken."`
			][random(0,3)]>>
		<<else>>
			<<print [
				`<<He>> smiles. "Did you forget how to do this?"`,
				`Morgan sighs, pleased. "Careful teeth, sweet thing. <<Mummy>> is sensitive."`,
				`<<He>> tilts <<his>> head. "Your mouth is warmer than memory."`,
				`Morgan strokes your hair. "There you are. Learning so nicely."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Morgan">>
		<<print [
			`<<He>> smiles. "Don't you remember my taste?"`,
			`Morgan lingers close to your lips. "First kiss? Oh, <<charles>>, you sentimental little thing."`,
			`<<He>> laughs softly. "You gave that to <<mummy>>. How romantic."`
		][random(0,2)]>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<default>>
				<<He>> snarls. "<<charles>>, you belong to <<mummy>>!"
		<</switch>>
	<<elseif ($NPCList[_n].vagina is "feet" or $NPCList[_n].penis is "feet") and random(1, 10) is 1 and $settings.footFetishEnabled>>
		<<print [
			`<<He>> moans. "Oh, <<charles>>, your feet...!"`,
			`Morgan shivers. "Even your feet are warm. How unfair."`,
			`<<He>> presses closer with a needy sound. "Don't stop moving them."`,
			`Morgan laughs breathlessly. "<<Mummy>> did not expect to enjoy that so much."`
		][random(0,3)]>> /* I hate you I hate you I hate you */
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<print `<<He>> looks at your $_sexToy and speaks. "` + [
			`<<charles>>, what is that?`,
			`Is that supposed to make <<mummy>> jealous?`,
			`Shameless.`,
			`Careful with that. It has no manners.`
		][random(0,3)] + `"`>>
	<<elseif $speechaskrough is 1>>
		<<print [
			`Morgan smiles slowly. "Rougher?"`,
			`<<He>> strokes your cheek. "Try ask sweetly, <<charles>>."`,
			`Morgan hums. "I can be rough. I can be gentle. The fun is choosing when to change."`
		][random(0,2)]>>
	<<elseif $speechchastity is 1>>
		<<print [
			`Morgan studies your chastity. "Locked away? Does it ache when <<mummy>> looks?"`,
			`<<He>> taps your chastity with one finger. "Someone was sensible enough to keep you contained."`,
			`Morgan smiles. "A cage is just another little house for want."`,
			`<<He>> whispers, "Locked or not, <<charles>>, I can still make you squirm."`
		][random(0,3)]>>
	<<elseif $speechvaginapenetrated is 1 or $speechvagina is 1>>
		<<set $speechvaginapenetrated to 0>>
		<<set $speechvagina to 0>>
		<<if _morganColossalPenis>>
			<<print [
				`Morgan steadies you. "It's a dreadful size, I know. Let <<mummy>> guide you through it."`,
				`<<He>> watches your face closely. "Still there, <<charles>>? Don't let it steal all your air."`,
				`Morgan's voice drops to a purr. "That's it."`,
				`<<He>> groans. "So tight around something that big. You really are reckless."`
			][random(0,3)]>>
		<<else>>
			<<print [
				`<<He>> smiles. "There you are, <<charles>>. Let <<mummy>> feel you."`,
				`Morgan sighs against your ear. "Living bodies are so noisy when they want something."`,
				`<<He>> murmurs, "Don't drift away from me now."`
			][random(0,2)]>>
		<</if>>
	<<elseif $speechanuspenetrated is 1 or $speechanus is 1>>
		<<set $speechanuspenetrated to 0>>
		<<set $speechanus to 0>>
		<<if _morganColossalPenis>>
			<<print [
				`Morgan holds you. "That size does not forgive impatience."`,
				`<<He>> exhales. "Poor <<charles>>."`,
				`Morgan strokes your back. "Breathe before <<mummy>> moves again."`,
				`<<He>> smiles. "Too much? Say so before you vanish under me."`
			][random(0,3)]>>
		<<else>>
			<<print [
				`Morgan gives a soft, pleased laugh. "That hole is shy. <<Mummy>> likes shy things."`,
				`<<He>> murmurs, "There. See? You can make room for me."`,
				`Morgan's eyes glitter. "I can feel every little twitch."`,
				`<<He>> hums. "You clench, <<charles>>."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if _morganColossalPenis>>
			<<print [
				`<<He>> watches your mouth stretch with a smile. "That's a size to make even silence gag."`,
				`Morgan whispers, "Let your jaw remember how to open."`,
				`<<He>> shivers. "Careful, <<charles>>. Mummy wants your mouth ruined, not broken."`
			][random(0,2)]>>
		<<else>>
			<<print [
				`Morgan strokes your hair. "Good. Warm your tongue for <<mummy>>."`,
				`<<He>> sighs. "Such a soft little mouth for such strange work."`,
				`Morgan taps your cheek. "Look up. I want to see you learning."`,
				`<<He>> smiles. "There. You remember after all."`
			][random(0,3)]>>
		<</if>>
	<<elseif $speechcum is 1>>
		<<print [
			`<<He>> smiles. "Messy little <<charles>>. <<Mummy>> saw everything."`,
			`Morgan leans in. "Did that feel like relief, or surrender?"`,
			`<<He>> laughs under <<his>> breath. "Again? No? Your face says maybe."`
		][random(0,2)]>>
	<<else>>
		<<if random(1,5) is 1>>
			<<print [
				`Morgan hums a tuneless little lullaby under <<his>> breath.`,
				`Morgan murmurs, "Still warm, <<charles>>?"`,
				`<<He>> watches you with affection.`,
				`Morgan whispers, "<<Mummy>> is right here."`
			][random(0,3)]>>
		<<else>>
			<<set _noNameComment to true>>
		<</if>>
	<</if>>
<</widget>>