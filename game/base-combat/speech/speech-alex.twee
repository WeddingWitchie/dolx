:: Widgets speech-Alex [widget]
<<widget "speech-alex">>
	<<set _npc_speech to true>>
	<<set _alexPartner to ($alex_countdown is undefined and $farm_stage gte 7)>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Alex") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Alex")>>
		<<if _alexPartner>>
			<<He>> smiles. "<<print either("Your first time with me? I'll make it good for you, partner.", "I'll make sure you remember this kindly.", "That's a lot of trust. I won't waste it.", "First time, eh? Then I'll be careful, but I won't let you forget me.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> smiles. "<<print either("Your first time? Oh, nice! I'll make it worth it.", "First time? Then do as I say and don't rush.", "I'll work extra hard, but you need to keep up.", "That makes it special.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> smiles, a little nervous. "<<print either("Your first time? All right. We'll take it slow.", "That's a lot to give me. I'll be good to you.", "Tell me if you need me to stop. I mean it.", "First time, then. I hope I do right by you.")>>"
		<<else>>
			<<He>> smiles. "<<print either("Your first time? I'll work extra hard to make it memorable.", "First time? Then let's not make a mess of it.", "I'll be careful with you. Promise.", "That's special. I'll try to earn it.")>>"
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Alex">>
		<<if _alexPartner>>
			<<He>> smiles. "<<print either("I'll go steady.", "Stay with me, partner. We'll take it slow.", "I'm here with you. No rush.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> smiles. "<<print either("It's tight. Keep still and let me handle it.", "You'll get used to it if you stop fighting me.", "I won't tell anyone, but I will remember that look.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> swallows. "<<print either("Are you sure? All right. I'll be careful.", "That's new for you? Then we go slow.", "Tell me if it's too much. I don't want to hurt you.", "Right. Slow and steady, then.")>>"
		<<else>>
			<<He>> smiles. "It's tight. I won't tell anyone you let me fuck your bottom."
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Alex">>
		<<if _alexPartner>>
			<<He>> smiles. "<<print either("First time with your mouth? Careful, then. No teeth.", "Don't worry. You don't have to be perfect, I'll guide you.", "Take your time. I'll tell you what feels good.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> grins. "<<print either("You haven't used your mouth like this before, have you? Keep your chompers away.", "Mind your teeth and I'll try not to move too much.", "First time? Then listen close and don't bite.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> blushes. "<<print either("You don't have to rush. Just be careful.", "First time? That's fine. We'll figure it out.", "Go slow. I trust you.")>>"
		<<else>>
			<<He>> smiles. "<<print either("Careful with your teeth, and we'll be fine.", "No need to look so worried. Start slow.", "You'll get the hang of it.")>>"
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Alex">>
		<<if _alexPartner>>
			<<He>> smiles. "<<print either("Your first kiss too? You're full of surprises, partner.", "That's sweet...", "First kiss? Then I'm glad it was me.", "Town <<girls>> are cute, but you're trouble as well.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> grins. "<<print either("Town <<girls>> are so cute.", "First kiss? You made that easy to notice.", "Cute. You nearly forgot how to breathe.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> smiles softly. "<<print either("That was your first? I hope it was all right.", "You looked nervous. It was sweet.", "First kiss? I feel lucky, then.", "That was nice. Better than nice, really.")>>"
		<<else>>
			<<He>> smiles. "First kiss? That's not something I'll forget."
		<</if>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<if $alex_countdown is undefined and $farm_stage gte 7>>
			<<switch _loveInterest>>
				<<case "Bailey">>
					<<He>> pauses. "Bailey? That arsehole?"
				<<case "Black Wolf">>
					<<He>> deflates. "<<print either("You're two-timing me with a wolf? I need another drink...", "A wolf? I don't even know how to argue with that.", "Please tell me you're joking.", "I work with animals, but I don't date against them.")>>"
				<<case "Great Hawk">>
					<<He>> glares. "<<print either("Did your brain get pecked in the moor? Stay out of there.", "The moor's dangerous enough, partner. Don't give it more reason to hurt you.", "I need another drink before I try to understand that...")>>"
				<<default>>
					<<He>> glares. "<<print either("You're two-timing me?", "Whoever that is, I don't like hearing their name right now.", "I thought we had something honest, partner.", "Say it plainly. Am I your partner or not?")>>"
			<</switch>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Black Wolf" "Great Hawk">>
					"<<print either("I think I had one too many.", "Nope. I am not drunk enough for that.", "That's enough nonsense for one night.", "I'm going to pretend I heard that wrong.")>>" <<he>> says. "<<print either("You're speaking nonsense.", "Animals don't count as dates.", "Don't make me picture it.", "Town talk gets stranger every day.")>>"
				<<default>>
					"<<print either("I think I had one too many.", "I'm not sure I wanted to hear that.", "Right. That's a name, then.", "You sure know how to spoil the mood.")>>" <<he>> says, holding <<his>> forehead.
			<</switch>>
		<</if>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<if C.npc.Alex.dom gte 30>>
			<<He>> snaps. "<<print either("Oi. Don't start that with me.", "Ugh. I've had animals kick with better manners.", "I can take a knock, but I won't take disrespect.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> flinches. "<<print either("What was that for?", "Hey. Easy. I didn't mean to upset you.", "Careful, please. That hurt.", "All right. I heard you.")>>"
		<<else>>
			<<He>> rubs the spot. "<<print either("Ow. You've got a mean hand on you.", "If that was flirting, you need practice.", "Right. Message received.")>>"
		<</if>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if _alexPartner>>
			<<He>> exhales. "<<print either("Easy, partner.", "Keep your eyes on me.", "Slow down. We've got time.", "That's it. You're doing fine.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> grins. "<<print either("That's better, partner. Easier when you listen, isn't it?", "No teeth.", "Look at me while you do it.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> shudders. "<<print either("I don't want to be rough with your mouth.", "Slow, please. I won't last if you rush.", "You're better at that than you think.")>>"
		<<else>>
			<<He>> breathes out. "<<print either("Easy does it?", "Mind your teeth and keep going.", "You're doing fine.")>>"
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<if C.npc.Alex.dom gte 30>>
			<<print `<<He>> looks at your $_sexToy and grins. "` + [`Now we're getting somewhere.`, `You better know how to use it.`, `Is that the best thing town has to offer?`, `Brought help, did you? Hope it can keep up.`][random(0,3)] + `"`>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<print `<<He>> looks at your $_sexToy and hesitates. "` + [`All right. I trust your judgement.`, `Hope you know how to use that thing.`, `You always know just how to have a good time.`, `If that's what you want, I'm game.`][random(0,3)] + `"`>>
		<<else>>
			<<print `<<He>> looks at your $_sexToy and smiles. "` + [`I like where your head's at.`, `Looks like we're in for a wild ride.`, `So this is what sells in town.`, `Didn't know you were bringing farm equipment of your own.`][random(0,3)] + `"`>>
		<</if>>
	<<elseif $speechaskrough is 1>>
		<<set $speechaskrough to 0>>
		<<if _alexPartner>>
			<<He>> gives you a searching look. "<<print either("Rougher? Say the word if it gets too much, partner.", "I can do rough, but I'm still looking after you.", "All right. Hold on to me, then.", "If that's what you want, I'll give it to you. Just don't be stubborn if you need a break.")>>"
		<<elseif C.npc.Alex.dom gte 30>>
			<<He>> grins. "<<print either("Rougher? You sure? I work hard for a living.", "I don't want to hurt you. Tell me if I do.", "All right. Keep up, then.")>>"
		<<elseif C.npc.Alex.dom lte -30>>
			<<He>> hesitates. "<<print either("Rougher? I can try, if you're sure.", "All right. Just... tell me if it's too much.", "I'll do my best. Don't laugh if I'm rubbish at it.")>>"
		<<else>>
			<<He>> gives a low laugh. "Rougher? All right, but don't say I didn't warn you."
		<</if>>
	<<elseif $speechchastity is 1>>
		<<set $speechchastity to 0>>
		<<if playerChastity()>>
			<<if _alexPartner>>
				<<He>> looks at the lock. "<<print either("Locked up, partner? I hope someone treats you right when they hold the key.", "That looks uncomfortable. You all right in that?", "Suppose it keeps you out of trouble.")>>"
			<<else>>
				<<He>> looks at the lock. "<<print either("Locked up, are you? That's one way to stay out of trouble.", "Looks tight. You managing all right?", "Someone's got you under control, then.")>>"
			<</if>>
		<<else>>
			<<if C.npc.Alex.dom gte 30>>
				<<He>> smirks. "<<print either("Might do you good, being locked up for a bit.", "You get into enough trouble when you're left to yourself.", "A lock might teach you patience.")>>"
			<<else>>
				<<He>> shrugs. "<<print either("Can't say I know much about that, but I can learn.", "Not my usual kind of kit, but town folk like strange things.", "A lock for that? Huh. Suppose it has its uses.", "If that's your thing, I won't judge.")>>"
			<</if>>
		<</if>>
	<<else>>
		<<unset _npc_speech>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
