:: Widgets speech-Alex [widget]
<<widget "speech-alex">>
	<<set _npc_speech to true>>
	<<set _alexPartner to ($alex_countdown is undefined and $farm_stage gte 7)>>
	<<speechPool "Alex">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Alex") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Alex")>>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Your first time with me? I'll make it good for you, partner."
			<<speechLine>>
				"I'll make sure you remember this kindly."
			<<speechLine>>
				"That's a lot of trust. I won't waste it."
			<<speechLine>>
				"First time, eh? Then I'll be careful, but I won't let you forget me."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Your first time? Oh, nice! I'll make it worth it."
			<<speechLine>>
				"First time? Then do as I say and don't rush."
			<<speechLine>>
				"I'll work extra hard, but you need to keep up."
			<<speechLine>>
				"That makes it special."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>> smiles, a little nervous.
			<<speechLine>>
				"Your first time? All right. We'll take it slow."
			<<speechLine>>
				"That's a lot to give me. I'll be good to you."
			<<speechLine>>
				"Tell me if you need me to stop. I mean it."
			<<speechLine>>
				"First time, then. I hope I do right by you."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Your first time? I'll work extra hard to make it memorable."
			<<speechLine>>
				"First time? Then let's not make a mess of it."
			<<speechLine>>
				"I'll be careful with you. Promise."
			<<speechLine>>
				"That's special. I'll try to earn it."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"I'll go steady."
			<<speechLine>>
				"Stay with me, partner. We'll take it slow."
			<<speechLine>>
				"I'm here with you. No rush."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"It's tight. Keep still and let me handle it."
			<<speechLine>>
				"You'll get used to it if you stop fighting me."
			<<speechLine>>
				"I won't tell anyone, but I will remember that look."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>> swallows.
			<<speechLine>>
				"Are you sure? All right. I'll be careful."
			<<speechLine>>
				"That's new for you? Then we go slow."
			<<speechLine>>
				"Tell me if it's too much. I don't want to hurt you."
			<<speechLine>>
				"Right. Slow and steady, then."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles. "It's tight. I won't tell anyone you let me fuck your bottom."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"First time with your mouth? Careful, then. No teeth."
			<<speechLine>>
				"Don't worry. You don't have to be perfect, I'll guide you."
			<<speechLine>>
				"Take your time. I'll tell you what feels good."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>> grins.
			<<speechLine>>
				"You haven't used your mouth like this before, have you? Just keep your chompers away."
			<<speechLine>>
				"Mind your teeth and I'll try not to move too much."
			<<speechLine>>
				"First time? Then listen close and don't bite."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>> blushes.
			<<speechLine>>
				"You don't have to rush. Just be careful."
			<<speechLine>>
				"First time? That's fine. We'll figure it out."
			<<speechLine>>
				"Go slow. I trust you."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Careful with your teeth, and we'll be fine."
			<<speechLine>>
				"No need to look so worried. Start slow."
			<<speechLine>>
				"You'll get the hang of it."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Alex">>
		<<if _alexPartner>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Your first kiss too? You're full of surprises, partner."
			<<speechLine>>
				"That's sweet..."
			<<speechLine>>
				"First kiss? Then I'm glad it was me."
			<<speechLine>>
				"Town <<girls>> are cute, but you're trouble as well."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "virginity">>
				<<He>> grins.
			<<speechLine>>
				"Town <<girls>> are so cute."
			<<speechLine>>
				"First kiss? You made that easy to notice."
			<<speechLine>>
				"Cute. You nearly forgot how to breathe."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "virginity">>
				<<He>> smiles softly.
			<<speechLine>>
				"That was your first? I hope it was all right."
			<<speechLine>>
				"You looked nervous. It was sweet."
			<<speechLine>>
				"First kiss? I feel lucky, then."
			<<speechLine>>
				"That was nice. Better than nice, really."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles. "First kiss? That's not something I'll forget."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechLINameDrop>>
		<<if _alexPartner>>
			<<switch _loveInterest>>
				<<case "Bailey">>
					<<addSpeechLine "namedrop">>
						<<He>> pauses. "Bailey? That arsehole?"
					<</addSpeechLine>>
				<<case "Black Wolf">>
					<<addSpeechLine "namedrop">>
						<<He>> deflates.
					<<speechLine>>
						"You're two-timing me with a wolf? I need another drink..."
					<<speechLine>>
						"A wolf? I don't even know how to argue with that."
					<<speechLine>>
						"Please tell me you're joking."
					<<speechLine>>
						"I work with animals, but I don't date against them."
					<</addSpeechLine>>
				<<case "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>> glares.
					<<speechLine>>
						"Did your brain get pecked in the moor? Stay out of there."
					<<speechLine>>
						"The moor's dangerous enough, partner. Don't give it more reason to hurt you."
					<<speechLine>>
						"I need another drink before I try to understand that..."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>> glares.
					<<speechLine>>
						"You're two-timing me?"
					<<speechLine>>
						"Whoever that is, I don't like hearing their name right now."
					<<speechLine>>
						"I thought we had something honest, partner."
					<<speechLine>>
						"Say it plainly. Am I your partner or not?"
					<</addSpeechLine>>
			<</switch>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Black Wolf" "Great Hawk">>
					<<addSpeechLine "namedrop">>
						"<<print either("I think I had one too many.", "Nope. I am not drunk enough for that.", "That's enough nonsense for one night.", "I'm going to pretend I heard that wrong.")>>" <<he>> says.
					<<speechLine>>
						"You're speaking nonsense."
					<<speechLine>>
						"Animals don't count as dates."
					<<speechLine>>
						"Don't make me picture it."
					<<speechLine>>
						"Town talk gets stranger every day."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						"<<print either("I think I had one too many.", "I'm not sure I wanted to hear that.", "Right. That's a name, then.", "You sure know how to spoil the mood.")>>" <<he>> says, holding <<his>> forehead.
					<</addSpeechLine>>
			<</switch>>
		<</if>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<if C.npc.Alex.dom gte 30>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>> snaps.
			<<speechLine>>
				"Oi. Don't start that with me."
			<<speechLine>>
				"Ugh. I've had animals kick with better manners."
			<<speechLine>>
				"I can take a knock, but I won't take disrespect."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>> flinches.
			<<speechLine>>
				"What was that for?"
			<<speechLine>>
				"Hey. Easy. I didn't mean to upset you."
			<<speechLine>>
				"Careful, please. That hurt."
			<<speechLine>>
				"All right. I heard you."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "playerHits">>
				<<set $speechPlayerHits to 0>><<He>> rubs the spot.
			<<speechLine>>
				"Ow. You've got a mean hand on you."
			<<speechLine>>
				"If that was flirting, you need practice."
			<<speechLine>>
				"Right. Message received."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<if _alexPartner>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> exhales.
			<<speechLine>>
				"Easy, partner."
			<<speechLine>>
				"Keep your eyes on me."
			<<speechLine>>
				"Slow down. We've got time."
			<<speechLine>>
				"That's it. You're doing fine."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> grins.
			<<speechLine>>
				"That's better, partner. Easier when you listen, isn't it?"
			<<speechLine>>
				"No teeth."
			<<speechLine>>
				"Look at me while you do it."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> shudders.
			<<speechLine>>
				"I don't want to be rough with your mouth."
			<<speechLine>>
				"Slow, please. I won't last if you rush."
			<<speechLine>>
				"You're better at that than you think."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> breathes out.
			<<speechLine>>
				"Easy does it?"
			<<speechLine>>
				"Mind your teeth and keep going."
			<<speechLine>>
				"You're doing fine."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<if C.npc.Alex.dom gte 30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>><<He>> looks at your $_sexToy and grins.
			<<speechLine>>
				"Now we're getting somewhere."
			<<speechLine>>
				"Cute toy. You better know how to use it."
			<<speechLine>>
				"Is that the best thing town has to offer?"
			<<speechLine>>
				"Brought help, did you? Hope it can keep up."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>><<He>> looks at your $_sexToy and hesitates.
			<<speechLine>>
				"All right. I trust your judgement."
			<<speechLine>>
				"Hope you know how to use that thing."
			<<speechLine>>
				"You always know just how to have a good time."
			<<speechLine>>
				"If that's what you want, I'm game."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>><<He>> looks at your $_sexToy and smiles.
			<<speechLine>>
				"I like where your head's at."
			<<speechLine>>
				"Looks like we're in for a wild ride."
			<<speechLine>>
				"So this is what sells in town."
			<<speechLine>>
				"Didn't know you were bringing farm equipment of your own."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAskRough is 1>>
		<<if _alexPartner>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>> gives you a searching look.
			<<speechLine>>
				"Rougher? Say the word if it gets too much, partner."
			<<speechLine>>
				"I can do rough, but I'm still looking after you."
			<<speechLine>>
				"All right. Hold on to me, then."
			<<speechLine>>
				"If that's what you want, I'll give it to you. Just don't be stubborn if you need a break."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>> grins.
			<<speechLine>>
				"Rougher? You sure? I work hard for a living."
			<<speechLine>>
				"I don't want to hurt you. Tell me if I do."
			<<speechLine>>
				"All right. Keep up, then."
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>> hesitates.
			<<speechLine>>
				"Rougher? I can try, if you're sure."
			<<speechLine>>
				"All right. Just... tell me if it's too much."
			<<speechLine>>
				"I'll do my best. Don't laugh if I'm rubbish at it."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "askRough">>
				<<set $speechAskRough to 0>><<He>> gives a low laugh. "Rougher? All right, but don't say I didn't warn you."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechChastity is 1>>
		<<if playerChastity()>>
			<<if _alexPartner>>
				<<addSpeechLine "chastity">>
					<<set $speechChastity to 0>><<He>> looks at the lock.
				<<speechLine>>
					"Locked up, partner? I hope someone treats you right when they hold the key."
				<<speechLine>>
					"That looks uncomfortable. You all right in that?"
				<<speechLine>>
					"Suppose it keeps you out of trouble."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "chastity">>
					<<set $speechChastity to 0>><<He>> looks at the lock.
				<<speechLine>>
					"Locked up, are you? That's one way to stay out of trouble."
				<<speechLine>>
					"Looks tight. You managing all right?"
				<<speechLine>>
					"Someone's got you under control, then."
				<</addSpeechLine>>
			<</if>>
		<<elseif C.npc.Alex.dom gte 30>>
			<<addSpeechLine "chastity">>
				<<set $speechChastity to 0>><<He>> smirks.
			<<speechLine>>
				"Might do you good, being locked up for a bit."
			<<speechLine>>
				"You get into enough trouble when you're left to yourself."
			<<speechLine>>
				"A lock might teach you patience."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "chastity">>
				<<set $speechChastity to 0>><<He>> shrugs.
			<<speechLine>>
				"Can't say I know much about that, but I can learn."
			<<speechLine>>
				"Not my usual kind of kit, but town folk like strange things."
			<<speechLine>>
				"A lock for that? Huh. Suppose it has its uses."
			<<speechLine>>
				"If that's your thing, I won't judge."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<speechSay>>
<</widget>>
