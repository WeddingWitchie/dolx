:: Widgets speech-Harper [widget]
<<widget "speech-harper">>
	<<set _npc_speech to true>>
	<<set _harperPenetratorSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _harperPenetratorSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _harperColossalPenetrator to _harperPenetratorSize gte 5>>
	<<speechPool "Harper">>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Harper") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Harper")>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>> studies your face closely.
			<<speechLine>>
				"Pupils blown wide. Breathing shallow. Stay conscious for me, I need to see how you respond."
			<<speechLine>>
				"Your body is trying very hard to reject the intrusion. That is normal. The fact it is failing is the interesting part."
			<<speechLine>>
				"Extreme dilation, acute shock response, and still no loss of consciousness. Good. Keep breathing."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"This will only hurt a bit."
			<<speechLine>>
				"Hold still. I need to check your blood pressure."
			<<speechLine>>
				"First penetration recorded. Try not to tense during the assessment."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Harper">>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>> watches you with focus.
			<<speechLine>>
				"Severe anal stretch. Jaw clenched, pulse racing, breathing compromised. Stay with me."
			<<speechLine>>
				"That nearly overwhelmed you? Good. I want to know exactly where your limit is."
			<<speechLine>>
				"Do not faint. I cannot assess your full response if you go limp too soon."
			<</addSpeechLine>>
		<<elseif $player.sex is "f">>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"I am going to administer a suppository. Please, try to relax."
			<<speechLine>>
				"Tense muscles make this worse. Let me conduct the examination properly."
			<<speechLine>>
				"A little pressure is expected. Your reaction is the part I need to observe."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"You are overdue for a prostate examination. Please, try to relax."
			<<speechLine>>
				"Do not squirm. It makes the prostate harder to assess."
			<<speechLine>>
				"There. Direct pressure. Tell me when it becomes difficult to think."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechOralVirgin is 1 and $player.virginity.oral is "Harper">>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "virginity">>
				<<He>> tilts your chin up.
			<<speechLine>>
				"Airway response is the priority."
			<<speechLine>>
				"Jaw strain already visible. Interesting. Open as far as you can."
			<<speechLine>>
				"That is too large for comfort, which makes your effort all the more instructive."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "virginity">>
				<<He>> smiles.
			<<speechLine>>
				"Say 'Ahh'..."
			<<speechLine>>
				"Open wide. I need a clear look at your throat."
			<<speechLine>>
				"Mind your teeth. This is an examination."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Harper">>
		<<addSpeechLine "virginity">>
			<<He>> smiles.
		<<speechLine>>
			"How is my bedside manner?"
		<<speechLine>>
			"Pulse elevated from a kiss. How sweet."
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechHermAroused to 0>><<He>> looks at you with interest.
		<<speechLine>>
			"Both sets. Unusual, but not without precedent in this town."
		<<speechLine>>
			"A complex presentation. I will need a longer examination."
		<<speechLine>>
			"Fascinating anatomy. Try not to look so nervous."
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
			<<set $speechCrossdressAroused to 0>><<He>> adjusts <<his>> glasses.
		<<speechLine>>
			"Presentation and anatomy do not always agree. That is hardly news."
		<<speechLine>>
			"Noted. Your response to being seen is more interesting than the clothing."
		<<speechLine>>
			"An anxious reaction. Shame, arousal, or both?"
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop>>
		<<switch _loveInterest>>
			<<case "Gwylan">>
				<<addSpeechLine "namedrop">>
					<<He>> speaks.
				<<speechLine>>
					"Interesting. You have a very healthy imagination, to give your hallucination such a name."
				<<speechLine>>
					"Still clinging to that delusion? I should increase observation."
				<</addSpeechLine>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
					<<He>> shakes <<his>> head.
				<<speechLine>>
					"As I have said, such animals do not exist."
				<<speechLine>>
					"Bestial fixation. Noted. We should discuss that in a controlled setting."
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
					<<He>> nods.
				<<speechLine>>
					"Prior attachments. Noted."
				<<speechLine>>
					"Another name for the chart. We will return to that."
				<<speechLine>>
					"Emotional complications. They always show up eventually."
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if $speechscratch is 1>>
		<<if $enemyanger gte 80>>
			<<addSpeechLine "playerHits">>
				<<set $speechscratch to 0>><<set $enemyanger += 20>><<set $enemytrust -= 35>><<He>> looks from the scratches to you.
			<<speechLine>>
				"Patient aggression escalating. We will need firmer restraints."
			<<speechLine>>
				"You are becoming difficult to examine safely. I can correct that."
			<<speechLine>>
				"Interesting. Pain response in me, panic response in you. Let us see which one lasts longer."
			<<speechLine>>
				"Clawing at your doctor is poor judgement. I will make a note of that."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "playerHits">>
				<<set $speechscratch to 0>><<set $enemyanger += 10>><<set $enemytrust -= 20>><<He>> touches the red lines, then watches your face with interest.
			<<speechLine>>
				"Reflexive aggression. Predictable."
			<<speechLine>>
				"Defensive behaviour noted. I should account for that before continuing."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechPlayerHits is 1>>
		<<addSpeechLine "playerHits">>
			<<set $speechPlayerHits to 0>><<He>> touches the mark and smiles.
		<<speechLine>>
			"Pain response intact. Good."
		<<speechLine>>
			"Reflex aggression. A little predictable, but useful."
		<<speechLine>>
			"You hit harder when frightened. I will remember that."
		<</addSpeechLine>>
	<</if>>
	<<if $speechMouthPenetrated is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> watches your throat work around <<him>>.
			<<speechLine>>
				"Your gag reflex is fighting admirably."
			<<speechLine>>
				"That size leaves you little room for mistakes."
			<<speechLine>>
				"Exceptional strain. Hold that position while I observe."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "oral">>
				<<set $speechMouthPenetrated to 0>><<He>> speaks softly.
			<<speechLine>>
				"Keep your jaw loose. That is better."
			<<speechLine>>
				"Your gag reflex is learning."
			<<speechLine>>
				"Much improved."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy is 1>>
		<<addSpeechLine "sexToy">>
			<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>><<He>> looks at your $_sexToy and smiles.
		<<speechLine>>
			"Self-administered treatment? How proactive."
		<<speechLine>>
			"Bring that closer. I want to see whether you chose the right size."
		<<speechLine>>
			"Interesting equipment. We can make that part of the examination."
		<</addSpeechLine>>
	<</if>>
	<<if $speechExposeGenitals is 1 and playerChastity()>>
		<<addSpeechLine "expose">>
			<<set $speechExposeGenitals to 0>><<He>> studies your <<printChastity>>.
		<<speechLine>>
			"Restriction device noted. Any swelling, numbness, or poor decisions?"
		<<speechLine>>
			"That looks uncomfortable. Fortunately, discomfort is measurable."
		<<speechLine>>
			"A neat intervention. Who prescribed it?"
		<</addSpeechLine>>
	<</if>>
	<<if $speechVaginaPenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "penetrated">>
				<<He>> speaks over your ragged breathing.
			<<speechLine>>
				"Extreme pressure, but still responsive. Good."
			<<speechLine>>
				"Your body is adapting faster than expected."
			<<speechLine>>
				"That expression says more than your chart ever could."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "penetrated">>
				<<He>> observes you calmly.
			<<speechLine>>
				"Breathing uneven. Hips responsive. You are doing well."
			<<speechLine>>
				"Relax your stomach. You are making this harder than it needs to be."
			<<speechLine>>
				"That reaction is quite clear, even if you refuse to say it."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechAnusPenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<addSpeechLine "penetrated">>
				<<He>> keeps <<his>> voice low.
			<<speechLine>>
				"Severe pressure, trembling legs, shallow breath. Stay awake."
			<<speechLine>>
				"Your limit is close. I want to see whether it moves."
			<<speechLine>>
				"You are taking a dangerous amount. Clinically impressive."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "penetrated">>
				<<He>> speaks.
			<<speechLine>>
				"Do not clench. It makes the examination less precise."
			<<speechLine>>
				"That response is exactly what I expected."
			<<speechLine>>
				"A tight reaction, but manageable."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechPlayerOrgasm is 1 and random(1, 3) is 1>>
		<<addSpeechLine "playerOrgasm">>
			<<He>> watches your reaction with interest.
		<<speechLine>>
			"Peak response recorded."
		<<speechLine>>
			"There it is. Much easier to read than your words."
		<<speechLine>>
			"A clear result. I do enjoy clean data."
		<</addSpeechLine>>
	<</if>>
	<<addSpeechLine "idle">>
		<<He>> exhales, then gives you a measured smile.
	<<speechLine>>
		"First contact recorded. Your technique requires work, but the result is promising."
	<<speechLine>>
		"Interesting. My pulse is higher than expected."
	<<speechLine>>
		"A little clumsy, but clinically useful. Continue."
	<</addSpeechLine>>
	<<speechSay>>
<</widget>>
