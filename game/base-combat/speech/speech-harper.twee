:: Widgets speech-Harper [widget]
<<widget "speech-harper">>
	<<set _harperPenetratorSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _harperPenetratorSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _harperColossalPenetrator to _harperPenetratorSize gte 5>>

	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Harper") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Harper")>>
		<<if _harperColossalPenetrator>>
			<<He>> studies your face closely. <<= either('"Pupils blown wide. Breathing shallow. Stay conscious for me, I need to see how you respond."','"Your body is trying very hard to reject the intrusion. That is normal. The fact it is failing is the interesting part."','"Extreme dilation, acute shock response, and still no loss of consciousness. Good. Keep breathing."')>>
		<<else>>
			<<He>> smiles. <<= either('"This will only hurt a bit."','"Hold still. I need to check your blood pressure."','"First penetration recorded. Try not to tense during the assessment."')>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Harper">>
		<<if _harperColossalPenetrator>>
			<<He>> watches you with focus. <<= either('"Severe anal stretch. Jaw clenched, pulse racing, breathing compromised. Stay with me."','"That nearly overwhelmed you? Good. I want to know exactly where your limit is."','"Do not faint. I cannot assess your full response if you go limp too soon."')>>
		<<elseif $player.sex is "f">>
			<<He>> smiles. <<= either('"I am going to administer a suppository. Please, try to relax."','"Tense muscles make this worse. Let me conduct the examination properly."','"A little pressure is expected. Your reaction is the part I need to observe."')>>
		<<else>>
			<<He>> smiles. <<= either('"You are overdue for a prostate examination. Please, try to relax."','"Do not squirm. It makes the prostate harder to assess."','"There. Direct pressure. Tell me when it becomes difficult to think."')>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Harper">>
		<<if _harperColossalPenetrator>>
			<<He>> tilts your chin up. <<= either('"Airway response is the priority."','"Jaw strain already visible. Interesting. Open as far as you can."','"That is too large for comfort, which makes your effort all the more instructive."')>>
		<<else>>
			<<He>> smiles. <<= either('"Say ahh."','"Open wide. I need a clear look at your throat."','"Mind your teeth. This is an examination."')>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Harper">>
		<<He>> smiles. <<= either('"How is my bedside manner?"','"Pulse elevated from a kiss. How sweet."')>>
	<<elseif $speechhermaroused is 1>>
		<<set $speechhermaroused to 0>>
		<<He>> looks at you with interest. <<= either('"Both sets. Unusual, but not without precedent in this town."','"A complex presentation. I will need a longer examination."','"Fascinating anatomy. Try not to look so nervous."')>>
	<<elseif $speechcrossdressaroused is 1>>
		<<set $speechcrossdressaroused to 0>>
		<<He>> adjusts <<his>> glasses. <<= either('"Presentation and anatomy do not always agree. That is hardly news."','"Noted. Your response to being seen is more interesting than the clothing."','"An anxious reaction. Shame, arousal, or both?"')>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Gwylan">>
				<<He>> speaks. <<= either('"Interesting. You have a very healthy imagination, to give your hallucination such a name."','"Still clinging to that delusion? I should increase observation."')>>
			<<case "Black Wolf" "Great Hawk">>
				<<He>> shakes <<his>> head. <<= either('"As I have said, such animals do not exist."','"Bestial fixation. Noted. We should discuss that in a controlled setting."')>>
			<<default>>
				<<He>> nods. <<= either('"Prior attachments. Noted."','"Another name for the chart. We will return to that."','"Emotional complications. They always show up eventually."')>>
		<</switch>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<He>> looks from the scratches to you. <<= either(
				'"Patient aggression escalating. We will need firmer restraints."',
				'"You are becoming difficult to examine safely. I can correct that."',
				'"Interesting. Pain response in me, panic response in you. Let us see which one lasts longer."',
				'"Clawing at your doctor is poor judgement. I will make a note of that."'
			)>>
			<<set $enemyanger += 20>><<set $enemytrust -= 35>>
		<<else>>
			<<He>> touches the red lines, then watches your face with interest. <<= either('"Reflexive aggression. Predictable."', '"Defensive behaviour noted. I should account for that before continuing."')>>
			<<set $enemyanger += 10>><<set $enemytrust -= 20>>
		<</if>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<He>> touches the mark and smiles. <<= either('"Pain response intact. Good."','"Reflex aggression. A little predictable, but useful."','"You hit harder when frightened. I will remember that."')>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if _harperColossalPenetrator>>
			<<He>> watches your throat work around <<him>>. <<= either('"Your gag reflex is fighting admirably."','"That size leaves you little room for mistakes."','"Exceptional strain. Hold that position while I observe."')>>
		<<else>>
			<<He>> speaks softly. <<= either('"Keep your jaw loose. That is better."','"Your gag reflex is learning."','"Much improved."')>>
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<He>> looks at your $_sexToy and smiles. <<= either('"Self-administered treatment? How proactive."','"Bring that closer. I want to see whether you chose the right size."','"Interesting equipment. We can make that part of the examination."')>>
	<<elseif $speechgenitals is 1 and playerChastity()>>
		<<set $speechgenitals to 0>>
		<<He>> studies your <<printChastity>>. <<= either('"Restriction device noted. Any swelling, numbness, or poor decisions?"','"That looks uncomfortable. Fortunately, discomfort is measurable."','"A neat intervention. Who prescribed it?"')>>
	<<elseif $speechvaginapenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<He>> speaks over your ragged breathing. <<= either('"Extreme pressure, but still responsive. Good."','"Your body is adapting faster than expected."','"That expression says more than your chart ever could."')>>
		<<else>>
			<<He>> observes you calmly. <<= either('"Breathing uneven. Hips responsive. You are doing well."','"Relax your stomach. You are making this harder than it needs to be."','"That reaction is quite clear, even if you refuse to say it."')>>
		<</if>>
	<<elseif $speechanuspenetrated is 1 and random(1, 4) is 1>>
		<<if _harperColossalPenetrator>>
			<<He>> keeps <<his>> voice low. <<= either('"Severe pressure, trembling legs, shallow breath. Stay awake."','"Your limit is close. I want to see whether it moves."','"You are taking a dangerous amount. Clinically impressive."')>>
		<<else>>
			<<He>> speaks. <<= either('"Do not clench. It makes the examination less precise."','"That response is exactly what I expected."','"A tight reaction, but manageable."')>>
		<</if>>
	<<elseif $speechcum is 1 and random(1, 3) is 1>>
		<<He>> watches your reaction with interest. <<= either('"Peak response recorded."','"There it is. Much easier to read than your words."','"A clear result. I do enjoy clean data."')>>
	<<else>>
		<<He>> exhales, then gives you a measured smile. <<= either('"First contact recorded. Your technique requires work, but the result is promising."','"Interesting. My pulse is higher than expected."','"A little clumsy, but clinically useful. Continue."')>>
	<</if>>
<</widget>>