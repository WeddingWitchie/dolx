:: Widgets speech-Avery [widget]
<<widget "speech-avery">>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is "Avery") or ($speechvaginavirgin is 1 and $player.virginity.vaginal is "Avery")>>
		<<He>> laughs. "<<print either("How splendid. Your virginity is a wonderful gift.", "Something precious, given to someone who understands its value.", "A proper gift at last. I expect you to remember who took care of you.", "Lovely. Don't look so startled. I told you I know how to make this memorable.")>>"
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is "Avery">>
		<<He>> laughs. "<<print either("This may hurt a bit, but you'll feel good soon. Trust me.", "A little discomfort is nothing. I can be very generous when you're good for me.", "You're with me, not some penniless fool who doesn't know what they're doing.")>>"
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is "Avery">>
		<<He>> laughs. "<<print either("Have you never done this before? Don't worry. I'll teach you.", "Never? Then listen carefully. I paid for your time, not your panic.", "You still have a lot to learn, but I can fix that. Pay attention.", "Don't be shy now. I'll show you what I expect.")>>"
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is "Avery">>
		<<He>> laughs. "<<print either("I hope you enjoyed it as much as I did.", "Your first proper kiss. Try not to waste the next one on cheap company.", "Sweet. A little clumsy, but sweet.", "Remember that. I dislike sharing what I've just improved.")>>"
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Robin">>
				<<His>> face darkens. "<<print either("The little brat I keep seeing you with? I should've known.", "Robin? That hanger-on? Don't tell me you've been wasting yourself on charity.", "That needy shadow of yours? I thought you had better taste when someone was paying for it.", "I see. Perhaps I should stop being so generous if you're spending your affection elsewhere.")>>"
			<<case "Whitney">>
				<<His>> face darkens. "<<print either("Whitney? That thug? I should have known someone vulgar had been pawing at what's mine.", "That brute? I pay to keep you above people like that.", "You embarrass me when you lower yourself like that.")>>"
			<<case "Black Wolf" "Great Hawk">>
				<<His>> face darkens. "<<print either("I don't pay you to let a filthy animal have its way with you.", "An animal? Don't test how quickly my generosity can turn ugly.")>>"
			<<default>>
				<<He>> wordlessly eyes you with contempt.
		<</switch>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> snaps. "<<print either("Mind your tone. I'll spoil you when you behave, but I won't be spoken to like that.", "Don't think I've gone soft just because I've let this slide.", "I spoil you because I choose to. Remember that before you test me again.", "That temper of yours is going to cost you.")>>"
		<<else>>
			<<He>> snarls. "<<print either("Enough. You don't get to act like that with me.", "Do that again, and don't expect another penny from me.", "I paid to be indulged, not insulted.", "You're very brave for someone who still expects me to be generous.")>>"
		<</if>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> smiles. "<<print either("There we are. Much better when you're showing gratitude.", "Look at me. I like knowing you understand who is treating you well.", "Keep that up and I may feel generous.", "Slow down. You're not being paid to rush.")>>"
		<<else>>
			<<He>> grips your chin. "<<print either("Don't bite. Don't make me repeat myself.", "You will not embarrass me with poor manners.", "Don't mess this up. I'm not in the mood.", "Look at me when I talk to you. Behave yourself, and drop the attitude.")>>"
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<if C.npc.Avery.rage lte 60>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`Well, this is a nice change of pace.`, `Everyone has their tools of the trade.`, `Planning to make me compete with that? How bold.`, `At least you brought something interesting.`][random(0,3)] + `"`>>
		<<else>>
			<<print `<<He>> looks at your $_sexToy and speaks. "` + [`Oh, no. I'm paying you too much for this.`, `You put that back this instant.`, `Don't be stupid. I'm not being pushed aside for some toy.`, `Put it away before I lose what little patience I have left.`][random(0,3)] + `"`>>
			<<set $enemyanger += 50>><<set $enemytrust -= 50>>
		<</if>>
	<<elseif $speechaskrough is 1>>
		<<set $speechaskrough to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> laughs. "<<print either("Rough? Mind what you ask for. I might give you exactly that.", "Asking me to stop being gentle? How expensive of you.", "Very well. But don't pout when I give you exactly what you asked for.")>>"
		<<else>>
			<<He>> gives you a hard look. "<<print either("You want rough while I'm already angry? Reckless thing.", "Don't ask for trouble and then act surprised when it arrives.", "Fine. No patience.", "You just made this much easier for me.")>>"
		<</if>>
	<<elseif $speechvaginapenetrated is 1 or $speechvagina is 1>>
		<<set $speechvaginapenetrated to 0>>
		<<set $speechvagina to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> smiles. "<<print either("Let me treat you like you deserve.", "You're worth every penny when you behave like this.", "You make a much better impression when you stop fighting me.", "Lovely. I do enjoy getting what I paid for.")>>"
		<<else>>
			<<He>> scowls. "<<print either("Keep still. I'm tired of your performances.", "Don't whine now. You pushed my patience this far.", "You wanted my attention. Now you have it.", "Behave, and perhaps I'll remember why I liked spoiling you.")>>"
		<</if>>
	<<elseif $speechanuspenetrated is 1 or $speechanus is 1>>
		<<set $speechanuspenetrated to 0>>
		<<set $speechanus to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> laughs. "<<print either("You're worth every penny and more. Let me spoil you with something else.", "Anything good takes some effort.", "Difficult, but you're managing.", "I do like seeing you work for my approval.")>>"
		<<else>>
			<<He>> speaks through his teeth. "<<print either("Don't make a scene. You know exactly why I'm angry.", "You can take a lesson in manners while you're at it.", "I'm not feeling very kind today.", "You should have behaved better if you wanted comfort.")>>"
		<</if>>
	<<elseif $speechcum is 1>>
		<<set $speechcum to 0>>
		<<if C.npc.Avery.rage lte 60>>
			<<He>> laughs. "<<print either("Wasn't it nicer when you let me take care of you?", "Try not to make a state of my clothes. They're worth more than your pride.", "I do like proof that my money isn't being wasted.")>>"
		<<else>>
			<<He>> sneers. "<<print either("Finished making a mess of yourself?", "How undignified. I hope that was worth testing me.", "Look at you. Still expecting me to be pleased.", "Clean yourself up before you embarrass me further.")>>"
		<</if>>
	<<else>>
		<<if C.npc.Avery.rage gte 60>>
			<<print [
				`<<His>> jaw tightens. "Do not make me repeat myself."`,
				`<<He>> glares at you. "I am very close to deciding you're more trouble than you're worth."`,
				`<<He>> speaks quietly. "You will stop embarrassing me now."`,
				`<<He>> exhales through <<his>> nose. "I can be patient, but not endlessly."`,
				`<<He>> looks down at you. "I spoil you enough already. Don't start acting like it."`,
				`<<He>> smile. "I don't put up with brats."`
			][random(0,5)]>>
		<<else>>
			<<set _noNameComment to true>>
		<</if>>
	<</if>>
<</widget>>
