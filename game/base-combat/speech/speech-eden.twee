:: Widgets speech-Eden [widget]
<<widget "speech-eden">>
	<<set _npc_speech to true>>
	<<set _edenSpeech to "">>
	<<set _edenVirginityName to "Eden">>
	<<set _edenPenetratorSize to 0>>
	<<if $NPCList[_n] and $NPCList[_n].penissize>>
		<<set _edenPenetratorSize to $NPCList[_n].penissize>>
	<</if>>
	<<set _edenColossalPenetrator to _edenPenetratorSize gte 5>>
	<<if ($speechpenisvirgin is 1 and $player.virginity.penile is _edenVirginityName) or ($speechvaginavirgin is 1 and $player.virginity.vaginal is _edenVirginityName)>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`Eden's voice drops. "Breathe. If you pass out on me, I'll stop, and neither of us wants that."`,
				`<<He>> holds you still with care. "Too big? I know. That's why you need to relax before you hurt yourself."`,
				`Eden watches your face closely. "I want you to remember exactly who claimed you."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>> speaks. "I felt your virginity. I couldn't help it. I needed to take you."`,
				`Eden presses closer. "No one from that town gets to take this from you now."`,
				`<<He>> exhales hard. "Mine. You hear me? Mine."`
			)>>
		<</if>>
	<<elseif $speechanusvirgin is 1 and $player.virginity.anal is _edenVirginityName>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`<<He>> growls against your ear. "That's the hard part done. Stay with me. Don't you dare go limp."`,
				`Eden's grip tightens. "You're shaking like a snared rabbit."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>> speaks, "I know this hurts now, but you'll get used to it soon."`,
				`Eden strokes your side. "Fighting it only makes it worse."`,
				`<<He>> growls. "Let me in. I'll make you strong enough for it."`
			)>>
		<</if>>
	<<elseif $speechmouthvirgin is 1 and $player.virginity.oral is _edenVirginityName>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`Eden grips your hair, then forces <<his>> hand to loosen. "Too much for your throat. Breathe through your nose and don't panic."`,
				`<<He>> looks down at you. "Damn. Seems that's a lot for you to take. Slow, then."`,
				`Eden's voice turns rough. "Open as far as you can. I'll handle the rest."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`<<He>> speaks, "Damn, you feel great. We're definitely doing this more often."`,
				`Eden exhales through <<his>> teeth. "You're learning where you belong."`,
				`<<He>> strokes your hair. "That's it. Don't waste a breath whining."`
			)>>
		<</if>>
	<<elseif $speechkissvirgin is 1 and $player.virginity.kiss is _edenVirginityName>>
		<<set _edenSpeech to either(
			`<<He>> speaks. "How was that? I'm not done, though."`,
			`Eden lingers close. "First kiss? Good. The town didn't get everything."`,
			`<<He>> brushes <<his>> thumb over your mouth. "Soft. I could get used to that."`
		)>>
	<<elseif $speechhermaroused is 1>>
		<<set $speechhermaroused to 0>>
		<<set _edenSpeech to either(
			`<<He>> gives a low grunt. "Doesn't matter what you are. I know your scent."`,
			`Eden's gaze sharpens. "Useful body. Dangerous too, if you know how to use it."`
		)>>
	<<elseif $speechcrossdressaroused is 1>>
		<<set $speechcrossdressaroused to 0>>
		<<set _edenSpeech to either(
			`Eden tugs at your clothes. "Trying to hide what you are, or show me something?"`,
			`<<He>> snorts. "Cloth doesn't fool me. I know what's under it."`,
			`Eden's eyes drag over you. "Wear what you want. I'll still find every weak spot."`
		)>>
	<<elseif $speechnamedrop is 1>>
		<<set $speechnamedrop to 0>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<set _edenSpeech to either(
					`<<He>> speaks, "That thing will tear you apart the first chance it gets. Stay away from it."`,
					`Eden snarls. "You think beasts care about you? They care about hunger."`
				)>>
			<<case "Gwylan">>
				<<set _edenSpeech to either(
					`<<He>> freezes. "That damned witch is trying to steal you from me, too?!"`,
					`Eden grips you tighter. "That damned witch can keep <<nnpc_his "Gwylan">> tricks. You're not vanishing on me."`
				)>>
			<<default>>
				<<set _edenSpeech to either(
					`<<He>> speaks. "Whoever that is, forget them." <<He>> sounds hurt.`,
					`Eden goes quiet. "Another town name. Another reason to keep you here."`,
					`<<He>> growls. "Names don't matter. I can scare them off all the same."`
				)>>
		<</switch>>
	<<elseif $speechscratch is 1>>
		<<set $speechscratch to 0>>
		<<if $enemyanger gte 80>>
			<<set _edenSpeech to either(
				`Eden sees the scratches and something wild breaks across <<his>> face. <<He>> slams you down before either of you can breathe. "Don't. Claw. Me."`,
				`<<He>> flinches from the marks, then lunges, panic sharpening into fury. "Hands off. Hands off!"`,
				`Eden stares at the red lines as if they are teeth marks. <<His>> voice turns ragged. "I said don't fight me like that."`,
				`For a second, Eden looks somewhere else entirely. Then <<he>> catches you hard. "No claws. Not from you."`
			)>>
			<<npcincr Eden love -10>><<llllove>><<npcincr Eden dom -2>><<ldom>><<pain 6>><<ggpain>><<set $enemytrust -= 50>><<set $enemyanger += 25>>
		<<else>>
			<<set _edenSpeech to either(
				`Eden jerks at the scratches, panic crossing <<his>> face before anger buries it. "Don't do that."`,
				`<<He>> catches your wrist too fast, breathing rough. "Claws out? Are you trying to make me forget myself?"`,
				`Eden looks at the red lines, and for a moment <<he>> looks hunted. Then <<his>> grip tightens. "Bad idea."`,
				`<<He>> flinches from the scratch. "Wolves scratch when they want blood. Don't make me think of you like that."`,
				`Eden pins your hand away from <<him>>. "No. You don't get to claw at me."`
			)>>
			<<npcincr Eden love -10>><<llllove>><<npcincr Eden dom -1>><<ldom>><<pain 6>><<ggpain>><<set $enemytrust -= 35>><<set $enemyanger += 15>>
		<</if>>
	<<elseif $speechhit is 1>>
		<<set $speechhit to 0>>
		<<set _edenSpeech to either(
			`Eden catches the blow and grins. "There. That's the bite I wanted to see."`,
			`<<He>> wipes <<his>> mouth with the back of <<his>> hand. "Hit harder if you mean it."`,
			`Eden's eyes brighten. "Nice. You're not helpless yet."`
		)>>
	<<elseif $speechmouthpenetrated is 1>>
		<<set $speechmouthpenetrated to 0>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`Eden's hand stills in your hair. "That size will choke you if you panic."`,
				`<<He>> growls low. "Your throat's tight. Slow down before you hurt yourself."`,
				`Eden watches you struggle. "That's a dangerous mouthful, little stray."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`Eden breathes hard. "Keep your jaw loose."`,
				`<<He>> strokes your hair. "That's it. Learn the shape of me."`,
				`Eden gives a rough laugh. "Careful with your teeth."`
			)>>
		<</if>>
	<<elseif $speechsextoy is 1>>
		<<set $speechsextoy to 0>>
		<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
		<<set _edenSpeech to either(
			`Eden looks at your $_sexToy. "Toys like that aren't necessary," <<he>> says. "They might even get in the way."`,
			`Eden snorts at your $_sexToy. "Town rubbish."`,
			`<<He>> eyes your $_sexToy. "If you brought that to make me jealous, it worked."`
		)>>
	<<elseif $speechgenitals is 1 and playerChastity()>>
		<<set $speechgenitals to 0>>
		<<set _edenSpeech to either(
			`Eden studies your <<printChastity>> with a scowl. "Who locked you up?"`,
			`<<He>> hooks a to your <<printChastity>>. "Looks like a trap. I hate traps that aren't mine."`,
			`Eden's voice lowers. "If someone put that on you without asking, give me a name."`
		)>>
	<<elseif $speechvaginapenetrated is 1 and random(1, 4) is 1>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`Eden holds you. "That's more than your body wants to take, but you're taking it."`,
				`<<He>> growls against your neck. "Too deep? Good. Remember how far I can reach."`,
				`Eden's grip turns careful. "Stay awake."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`Eden speaks close to your ear. "Stop fighting your own body."`,
				`<<He>> growls. "That's it. Let the forest hear you."`,
				`Eden's hands tighten. "You're safest when you're under me."`
			)>>
		<</if>>
	<<elseif $speechanuspenetrated is 1 and random(1, 4) is 1>>
		<<if _edenColossalPenetrator>>
			<<set _edenSpeech to either(
				`Eden's breath catches at your reaction. "That nearly got past your limit. Hold still."`,
				`<<He>> growls. "Don't clench. With this size, that only makes it worse."`,
				`Eden keeps you pinned. "You're shaking hard."`
			)>>
		<<else>>
			<<set _edenSpeech to either(
				`Eden breathes against your shoulder. "Don't run from it."`,
				`<<He>> grunts. "Tight. Dangerous. Mine."`,
				`Eden's voice roughens. "You'll get used to me. I'll make sure of it."`
			)>>
		<</if>>
	<<elseif $speechcum is 1 and random(1, 3) is 1>>
		<<set _edenSpeech to either(
			`Eden gives a low growl. "That's what I wanted from you."`,
			`<<He>> watches your face. "There you are. No town mask left."`,
			`Eden's grip eases. "Catch your breath. I'm not done hunting you."`
		)>>
	<<elseif random(1, 5) is 1>>
		<<set _edenSpeech to either(
			`Eden watches you like prey that wandered too close to the cabin. "Still thinking about running?"`,
			`<<He>> speaks quietly, "The forest is listening. Try not to sound too frightened."`,
			`Eden's eyes glances over you. "You're safer here than you ever were in town."`,
			`<<He>> gasp. "Stay close. I don't share what I drag home."`
		)>>
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
	<<if $daily.eden.huntCaught gte 1>>
		<<switch $daily.eden.huntCaught>>
			<<case 1>> <<set _edenSpeech to `"How dare they touch you?" Eden growls.`>>
			<<case 2>> <<set _edenSpeech to `"You belong to me," Eden snaps.`>>
			<<case 3>> <<set _edenSpeech to `"You're mine," Eden says. "Only mine."`>>
			<<case 4>> <<set _edenSpeech to `"I'm the only one who's allowed to do this to you," Eden says.`>>
			<<case 5>> <<set _edenSpeech to `"If anyone else lays their hands on you," Eden says, "they're dead."`>>
			<<case 6>> <<set _edenSpeech to `"Only I can touch you like this," Eden seethes.`>>
			<<case 7>> <<set _edenSpeech to `"Say it," Eden growls. "Tell me that you're mine."`>>
			<<case 8>> <<set _edenSpeech to `"You're my possession," Eden says. "Mine alone."`>>
			<<case 9>> <<set _edenSpeech to `"Don't forget who you belong to," Eden says.`>>
			<<case 10>> <<set _edenSpeech to `"I own every single part of you," Eden growls.`>>
		<</switch>>
		<<set $daily.eden.huntCaught to ($daily.eden.huntCaught + 1) % 10>>
		<<unset _noNameComment>>
	<</if>>
	<<if $daily.eden.robinCrash gte 1>>
		<<switch $daily.eden.robinCrash>>
			<<case 1>> <<set _edenSpeech to `"<<nnpc_He "Robin">> can't protect you," Eden snarls.`>>
			<<case 2>> <<set _edenSpeech to `"Only I can," Eden says.`>>
			<<case 3>> <<set _edenSpeech to `"I'm the one who provides for you," Eden says.`>>
			<<case 4>> <<set _edenSpeech to `"I'm the one who cares for you," Eden shouts.`>>
			<<case 5>> <<set _edenSpeech to `"<<nnpc_He "Robin">> didn't rescue you from the town," Eden sneers, "I did."`>>
			<<case 6>> <<set _edenSpeech to `"You're the only one I need," Eden says.`>>
			<<case 7>> <<set _edenSpeech to `"And I'm the only one you need," Eden says.`>>
			<<case 8>> <<set _edenSpeech to `"Everyone else is just noise," Eden says.`>>
			<<case 9>> <<set _edenSpeech to `"I'm never going to let you go," Eden says.`>>
			<<case 10>> <<set _edenSpeech to `"You belong to me and only me," Eden growls. "I'll make sure you forget about everyone else."`>>
		<</switch>>
		<<set $daily.eden.robinCrash to ($daily.eden.robinCrash + 1) % 10>>
		<<unset _noNameComment>>
	<</if>>
	<<print _edenSpeech>>
<</widget>>