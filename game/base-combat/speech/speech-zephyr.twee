:: Widgets speech-Zephyr [widget]
<<widget "speech-zephyr">>
	<<set _npc_speech to true>>
	<<if $possessed>>
		<<if $control gte $controlmax>>
			<<He>> scoffs. "Now leave, and leave <<phim "Zephyr">> be."
		<<elseif $npcspeechcycle is 0>>
			<<He>> raises <<his>> telescope to <<his>> eye for a moment, before putting it away.
		<<else>>
			<<He>> stares you down, silent.
		<</if>>
	<<else>>
		<<set _zephyrPenisSize to 0>>
		<<if def _n and $NPCList and $NPCList[_n] and $NPCList[_n].penissize>>
			<<set _zephyrPenisSize to $NPCList[_n].penissize>>
		<<elseif C.npc and C.npc.Zephyr and C.npc.Zephyr.penissize>>
			<<set _zephyrPenisSize to C.npc.Zephyr.penissize>>
		<</if>>

		<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Zephyr") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Zephyr")>>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<print `<<He>> ${[`lets out a low laugh. "Still breathing? I thought that colossal thing might split you in two."`, `gives a low whistle. "Still breathing? Thought I might have split my prize in two."`][random(0,1)]}`>>
				<<case 4>>
					<<He>> grins. "Hah. You took that better than I thought."
				<<case 3>>
					<<He>> smirks. "There's no hiding that look. You felt every inch."
				<<case 1>>
					<<He>> clicks <<his>> tongue. "First time, and that's all it took to leave you shaking?"
				<<default>>
					<<print `<<He>> ${[`smirks. "So that's your first taste of me. Try not to look so dazed."`, `grins. "That's one first time lost at sea. Try not to look so shocked, <<lass>>."`][random(0,1)]}`>>
			<</switch>>
		<<elseif $speechAnusVirgin is 1 and $player.virginity.anal is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<He>> <<print [`watches you struggle for breath, amusement clear in <<his>> eyes. "That's it. Let the waves settle before you try standing."`, `steadies you. "That nearly sank you. Breathe before I move again."`][random(0,1)]>>
				<<case 4>>
					<<He>> gives a satisfied huff. "Rough waters for a first voyage. You survived."
				<<case 3>>
					<<He>> smirks. "I doubt you'll forget that in a hurry."
				<<case 1>>
					<<He>> snorts. "That was your first time back there? You're full of surprises."
				<<default>>
					<<He>> <<print [`tilts <<his>> head. "First claim made."`, `chuckles. "That look says I found uncharted waters."`][random(0,1)]>>
			<</switch>>
		<<elseif $speechOralVirgin is 1 and $player.virginity.oral is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<print `<<He>> ${[`laughs. "Almost drowned you, didn't it? Breathe while you can."`, `brushes a thumb along your jaw. "A brave mouth for something that size. Don't bite, and I'll call it seamanship."`][random(0,1)]}`>>
				<<case 4>>
					<<He>> grins. "Bite down and I'll make you regret it."
				<<case 3>>
					<<He>> wipes <<his>> thumb over your lip. "Not bad for your first try."
				<<case 1>>
					<<He>> raises an eyebrow. "Your first? Hah. I expected more panic."
				<<default>>
					<<print `<<He>> ${[`smirks. "Remember the taste. You'll know it next time."`, `laughs. "First time with your mouth? Then mind your teeth, <<lass>>."`][random(0,1)]}`>>
			<</switch>>
		<<elseif $speechKissVirgin is 1 and $player.virginity.kiss is "Zephyr">>
			<<print `<<He>> ${[`pauses, then grins. "Your first kiss? That's a dangerous thing to hand to a pirate."`, `smiles. "First kiss, eh? A pirate's stolen worse, but rarely anything so sweet."`][random(0,1)]}`>>
		<<elseif $speechLINameDrop is 1>>
			<<set $speechLINameDrop to 0>>
			<<switch _loveInterest>>
				<<case "Gwylan">>
					<<print `<<He>> ${[`speaks. "Hah! How's little seabird doing?"`, `speaks. "The little seabird! <<nnpc_He "Gwylan">> flapping around after you?"`][random(0,1)]}`>>
				<<case "Black Wolf">>
					<<print `<<He>> ${[`chortles. "Oh, you're full of tales."`, `chortles. "You've got stranger tales than most crews I've sailed with."`][random(0,1)]}`>>
				<<case "Great Hawk">>
					<<print `<<He>> ${[`chortles. "Oh, you're full of tales."`, `laughs. "Aim high, do you? Mind the talons."`][random(0,1)]}`>>
				<<default>>
					<<He>> smirks. "A lover on land or a heart at sea, pick one."
			<</switch>>
		<<elseif $speechNoticeSexToy is 1>>
			<<set $speechNoticeSexToy to 0>>
			<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<print `<<He>> eyes your ${_sexToy} with a crooked smile. "${[`Brought your own gear? Thoughtful.`, `Planning to keep yourself entertained, are you?`, `Careful where you wave that. Pirates steal useful things.`, `Cute toy. I hope you know how to use it.`, `Brought your own treasure, did you? Bold of you.`][random(0,4)]}"`>>
		<<elseif $speechChastity is 1>>
			<<if $worn.genitals.name is "chastity parasite">>
				<<print `<<He>> eyes the parasite with a grimace. "That's a cursed-looking thing. Can't say I envy you, <<lass>>."`>>
			<<elseif $worn.genitals.name isnot "naked">>
				<<print `<<He>> taps the front of your chastity. "Locked cargo, eh? Someone's worried about thieves."`>>
			<<else>>
				<<print `<<He>> smirks. "No lock? Brave choice around pirates."`>>
			<</if>>
		<<elseif $clothesspeech is 1>>
			<<if $worn.upper.exposed gte 2 or $worn.lower.exposed gte 2>>
				<<print `<<He>> looks you over. "Showing that much skin at sea would start a mutiny."`>>
			<<elseif $worn.upper.name isnot "naked" or $worn.lower.name isnot "naked">>
				<<print `<<He>> gives your outfit a quick glance. "Not exactly shipshape, but you'll do."`>>
			<<else>>
				<<print `<<He>> laughs. "That's one way to travel light."`>>
			<</if>>
		<<else>>
			<<set _noNameComment to true>>
		<</if>>
	<</if>>
<</widget>>
