:: Widgets speech-Zephyr [widget]
<<widget "speech-zephyr">>
	<<set _npc_speech to true>>
	<<if $possessed>>
		<<if $control gte $controlmax>>
			<<He>> scoffs. "Now leave, and leave <<phim "Zephyr">> be."
		<<elseif $npcspeechcycle is 0>>
			<<He>> raises <<his>> telescope to <<his>> eye for a moment, before putting it away.
		<<else>>
			<<He>> stares you down, silent.
		<</if>>
	<<else>>
		<<set _zephyrPenisSize to 0>>
		<<if def _n and $NPCList and $NPCList[_n] and $NPCList[_n].penissize>>
			<<set _zephyrPenisSize to $NPCList[_n].penissize>>
		<<elseif C.npc and C.npc.Zephyr and C.npc.Zephyr.penissize>>
			<<set _zephyrPenisSize to C.npc.Zephyr.penissize>>
		<</if>>
		<<speechPool "Zephyr">>
		<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Zephyr") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Zephyr")>>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						lets out a low laugh. "Still breathing? I thought that colossal thing might split you in two."
					<<speechLine>>
						gives a low whistle. "Still breathing? Thought I might have split my prize in two."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>> grins. "Hah. You took that better than I thought."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>> smirks. "There's no hiding that look. You felt every inch."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>> clicks <<his>> tongue. "First time, and that's all it took to leave you shaking?"
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						smirks. "So that's your first taste of me. Try not to look so dazed."
					<<speechLine>>
						grins. "That's one first time lost at sea. Try not to look so shocked, <<lass>>."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechAnusVirgin is 1 and $player.virginity.anal is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						watches you struggle for breath, amusement clear in <<his>> eyes. "That's it. Let the waves settle before you try standing."
					<<speechLine>>
						steadies you. "That nearly sank you. Breathe before I move again."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>> gives a satisfied huff. "Rough waters for a first voyage. You survived."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>> smirks. "I doubt you'll forget that in a hurry."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>> snorts. "That was your first time back there? You're full of surprises."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						tilts <<his>> head. "First claim made."
					<<speechLine>>
						chuckles. "That look says I found uncharted waters."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechOralVirgin is 1 and $player.virginity.oral is "Zephyr">>
			<<switch _zephyrPenisSize>>
				<<case 5>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						laughs. "Almost drowned you, didn't it? Breathe while you can."
					<<speechLine>>
						brushes a thumb along your jaw. "A brave mouth for something that size. Don't bite, and I'll call it seamanship."
					<</addSpeechLine>>
				<<case 4>>
					<<addSpeechLine "virginity">>
						<<He>> grins. "Bite down and I'll make you regret it."
					<</addSpeechLine>>
				<<case 3>>
					<<addSpeechLine "virginity">>
						<<He>> wipes <<his>> thumb over your lip. "Not bad for your first try."
					<</addSpeechLine>>
				<<case 1>>
					<<addSpeechLine "virginity">>
						<<He>> raises an eyebrow. "Your first? Hah. I expected more panic."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "virginity">>
						<<He>>
					<<speechLine>>
						smirks. "Remember the taste. You'll know it next time."
					<<speechLine>>
						laughs. "First time with your mouth? Then mind your teeth, <<lass>>."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechKissVirgin is 1 and $player.virginity.kiss is "Zephyr">>
			<<addSpeechLine "virginity">>
				<<He>>
			<<speechLine>>
				pauses, then grins. "Your first kiss? That's a dangerous thing to hand to a pirate."
			<<speechLine>>
				smiles. "First kiss, eh? A pirate's stolen worse, but rarely anything so sweet."
			<</addSpeechLine>>
		<</if>>
		<<if $speechLINameDrop>>
			<<switch _loveInterest>>
				<<case "Gwylan">>
					<<addSpeechLine "namedrop">>
						<<He>> speaks.
					<<speechLine>>
						"Hah! How's little seabird doing?"
					<<speechLine>>
						"The little seabird! <<nnpc_He "Gwylan">> flapping around after you?"
					<</addSpeechLine>>
				<<case "Black Wolf">>
					<<addSpeechLine "namedrop">>
						<<He>> chortles.
					<<speechLine>>
						"Oh, you're full of tales."
					<<speechLine>>
						"You've got stranger tales than most crews I've sailed with."
					<</addSpeechLine>>
				<<case "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>>
					<<speechLine>>
						chortles. "Oh, you're full of tales."
					<<speechLine>>
						laughs. "Aim high, do you? Mind the talons."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>> smirks. "A lover on land or a heart at sea, pick one."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<if $speechNoticeSexToy is 1>>
			<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<addSpeechLine "sexToy">>
				<<He>> eyes your _sexToy with a crooked smile.
			<<speechLine>>
				"Brought your own gear? Thoughtful."
			<<speechLine>>
				"Planning to keep yourself entertained, are you?"
			<<speechLine>>
				"Careful where you wave that. Pirates steal useful things."
			<<speechLine>>
				"Cute toy. I hope you know how to use it."
			<<speechLine>>
				"Brought your own treasure, did you? Bold of you."
			<</addSpeechLine>>
		<</if>>
		<<if $speechChastity is 1>>
			<<if $worn.genitals.name is "chastity parasite">>
				<<addSpeechLine "chastity">>
					<<He>> eyes the parasite with a grimace. "That's a cursed-looking thing. Can't say I envy you, <<lass>>."
				<</addSpeechLine>>
			<<elseif $worn.genitals.name isnot "naked">>
				<<addSpeechLine "chastity">>
					<<He>> taps the front of your chastity. "Locked cargo, eh? Someone's worried about thieves."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "chastity">>
					<<He>> smirks. "No lock? Brave choice around pirates."
				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<addSpeechLine "idle">>
			<<if $worn.upper.exposed gte 2 or $worn.lower.exposed gte 2>>
				<<He>> looks you over. "Showing that much skin at sea would start a mutiny."
			<<elseif $worn.upper.name isnot "naked" or $worn.lower.name isnot "naked">>
				<<He>> gives your outfit a quick glance. "Not exactly shipshape, but you'll do."
			<<else>>
				<<He>> laughs. "That's one way to travel light."
			<</if>>
		<</addSpeechLine>>
		<<speechSay>>
	<</if>>
<</widget>>
