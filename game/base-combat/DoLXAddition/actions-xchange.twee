:: Combat Actions XChange Widgets [widget]
    <<widget "combat-apply-spike">>
        /* _args[0]: "anal" when the pill was pushed into the anus instead of swallowed. */
        <<set _spikeAnal to (_args[0] is "anal")>>
        <<set _isPure to false>>
        <<if !playerIsXChanged() and $xchange isnot undefined and ($xchange.combatPillingPureRatio !== undefined ? $xchange.combatPillingPureRatio : 0) gte 1>>
            <<set _pureRatio to ($xchange.combatPillingPureRatio !== undefined ? $xchange.combatPillingPureRatio : 0)>>
            <<set _isPure to (random(1, 100) lte _pureRatio)>>
        <</if>>

        <<if !playerMayBeSpiked()>>
            /* Carrying, or spiking switched off, since the pill was drawn. The dose still goes down, it just can't take hold. */
            <<if xchangeTherapyActive()>>
                /* The widget applies nothing here and prints the treatment's own line, so it doesn't need saying twice. */
                <<xchange-random-spike>>
            <<else>>
                <<if _spikeAnal>>
                    <br>The pill dissolves inside you, but <span class="blue">nothing happens</span>. Whatever effect it was supposed to have, it does not affect your body.<br><br>
                <<else>>
                    <br><span class="blue">You swallow the pill, but nothing happens</span>. Whatever effect it was supposed to have, it does not affect your body.<br><br>
                <</if>>
            <</if>>
        <<elseif _isPure>>
            /* Clean Pink/Blue pill that the same as one from the Hospital. Picked by body sex: the assailant grabs whichever pill actually works on what's between your legs. */
            <<if $player.sex is "m">>
                <<xchange-pink 1>>
            <<else>>
                <<xchange-blue 1>>
            <</if>>
            <<if _spikeAnal>>
                <br>It feels like <span class="blue">a normal X-Change pill</span> from the pharmacy, just taken the wrong way.<br><br>
            <<else>>
                <br>It tastes like <span class="blue">a normal X-Change pill</span> from the pharmacy.<br><br>
            <</if>>
        <<else>>
            /* Suspicious pill: random extras (and side effects, if the toggle is on; handled inside xchange-random-spike). */
            <<xchange-random-spike "suppress">>
            <<if $xchange isnot undefined and ($xchange.spikeSideEffectsEnabled !== undefined ? $xchange.spikeSideEffectsEnabled : 1)>>
                <<if _spikeAnal>>
                    <br><span class="pink">The pill burns</span> as it melts inside your rear. Your skin starts to hurt soon after. Whatever was in that pill, it was more than a normal X-Change dose.<<gstress>><<stress 4>><<gpain>><<pain 3>><br><br>
                <<else>>
                    <br>The pill leaves a bitter taste in your mouth and <span class="pink">burns your throat</span> as you swallow it. Your skin starts to hurt soon after. Whatever was in that pill, it was more than a normal X-Change dose.<<gstress>><<stress 4>><<gpain>><<pain 3>><br><br>
                <</if>>
            <<else>>
                <<if _spikeAnal>>
                    <br>The pill feels different from a normal X-Change pill, but <span class="pink">you cannot tell what was added to it</span>.<<trauma 3>><<gtrauma>><br><br>
                <<else>>
                    <br>The pill tastes different from a normal X-Change pill, but <span class="pink">you cannot tell what was added to it</span>.<<trauma 3>><<gtrauma>><br><br>
                <</if>>
            <</if>>
        <</if>>
        <<set $playerWasSpikedInEncounter to 1>>
    <</widget>>

    <<widget "combat-hand-on-xchange-pill">>
        <<set _hand to _args[0]>>
        <<set _rng to random(1, 100)>>
        <<set _assholeIsExposed to $worn.under_lower.type.includes("naked")>>
        /* Beast-type assailants have no clothes to pocket a pill in, and only monster people can talk. */
        <<set _pillNoPockets to ($enemytype is "beast")>>
        <<set _pillNoSpeech to (_pillNoPockets and $NPCList[_n]?.monster isnot "monster")>>

        <<if $playerWasSpikedInEncounter>>
            <<if _pillNoPockets>>
                Seeing as you've already been pilled, <<he>> <span class="blue">lets <<his>> own pill drop to the ground</span> since it's no longer necessary.
            <<else>>
                Seeing as you've already been pilled, <<he>> <span class="blue">pockets <<his>> own pill</span> since it's no longer necessary.
            <</if>>
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
        <<elseif _rng gte 96>>
            <<if _pillNoPockets>>
                <<He>> <span class="blue">changes <<his>> mind</span> and lets the pill fall.
            <<else>>
                <<He>> <span class="blue">changes <<his>> mind</span> and pockets the pill once again.
            <</if>>
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
        <<elseif $worn.face.type.includes("face_covering") or $worn.face.type.includes("gag")>>
            <<if _pillNoSpeech>>
                <<He>> paws at your $worn.face.name, trying to drag it out of the way. <<if $worn.face.integrity - 10 lte 0>><span class="purple">It gives way with a tear.</span><</if>>
            <<else>>
                <<He>> sees your $worn.face.name. "That thing is in the way. Take it off," <<he>> tugs at it with force. <<if $worn.face.integrity - 10 lte 0>><span class="purple">It gives way with a tear.</span><</if>>
            <</if>>
            <<damageFaceCover 10>>
        <<elseif $mouthuse is 0>>
            <<if $rng gte 33>>
                <<if _pillNoSpeech>>
                    <<= either(
                        `<<He>> holds the pill against your lips, but <span class="purple">they stay shut</span>.`,
                        `<<He>> tries to push the pill into your mouth. <span class="purple">You keep it closed</span>.`,
                        `<<He>> presses the pill to your face, <span class="purple">waiting for you to open up</span>.`
                    )>>
                <<else>>
                    <<= either(
                        `<<He>> taunts you while <span class="purple">holding the pill in your face</span>. "I wonder how's your pretty little ass gonna look."`,
                        `<<He>> tries to force the pill into your mouth, but <span class="purple">your lips are sealed shut</span>.`,
                        `<<He>> forces the pill into your mouth, but <span class="purple">you spit it out</span>. "Stop making this difficult, you <<bitch>>!"`,
                        `<<He>> <span class="purple">fiddles around with the pill</span> in <<his>> hand. "They say <<girls>> like you turn into sluts after taking these."`,
                        `<<He>> holds the pill against your lips, <span class="purple">trying to coax them to open</span>. "Come on... You'll feel real good. I promise."`,
                        `<<He>> grins and <span class="purple">taps the pill against your lower lip</span>. "Once this gets into you, you'll be begging to show off what it does to your body."`,
                        `<<He>> <span class="purple">rolls the pill between <<his>> fingers</span> and laughs under <<his>> breath. "Bet you'll look real pretty after this. Softer. Sluttier. Easier."`,
                        `<<He>> <span class="purple">presses the pill to your mouth and sneers</span>. "Quit clenching up. You'll swallow it sooner or later, and then we'll see what kind of little toy it turns you into."`
                    )>>
                <</if>>
            <<else>>
                /* forced pilling */
                <span class="pink"><<He>> forces <<his>> pill down your throat.</span>
                <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                <<combat-apply-spike>>
            <</if>>
        <<elseif $anususe is 0 and !playerChastity("anus")>>
            /* forced pilling */
            Confident your focus is on keeping your mouth closed off and guarded, <<he>> goes for your rear instead. In a blink, <span class="pink">the pill slips up inside your anus</span>.
            <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
            <<combat-apply-spike "anal">>
        
        <<else>>
            <<if $mouthuse is "righthand" or $mouthuse is "lefthand">>
                <<if $mouthuse is "righthand">>
                    <<selectNpcWithPartInPosition "hand" "mouth">>
                <<else>>
                    <<selectNpcWithPartInPosition "lefthand" "mouth">>
                <</if>>
                <<if $NPCList[_n] is _npc>>
                    <<if $rng gte 66>>
                        <<if _pillNoSpeech>>
                                <<= either(
                                    `<<He>> holds the pill against your lips, but <span class="purple">they stay shut</span>.`,
                                    `<<He>> tries to push the pill into your mouth. <span class="purple">You keep it closed</span>.`
                                )>>
                        <<else>>
                                <<= either(
                                    `<<He>> taunts you while <span class="purple">holding the pill in your face</span>. "I wonder how's your pretty little ass gonna look."`,
                                    `<<He>> tries to force the pill into your mounth, but <span class="purple">your lips are sealed shut</span>.`,
                                    `<<He>> forces the pill into your mouth. but <span class="purple">you spit it out</span>. "Stop making this difficult, you <<bitch>>!"`,
                                    `<<He>> <span class="purple">fiddles around with the pill</span> in <<his>> hand. "They say <<girls>> like you turn into sluts after taking these."`,
                                    `<<He>> holds the pill against your lips, <span class="purple">trying to coax them to open</span>. "Come on... You'll feel real good. I promise.`
                                )>>
                        <</if>>
                    <<elseif $anususe is 0 and !playerChastity("anus") and $rng gt 33>>
                        /* forced pilling */
                        Confident your focus is on keeping your mouth closed off and guarded, <<he>> goes for your rear instead. In a blink, <span class="pink">the pill slips up inside your anus</span>.
                        <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                        <<combat-apply-spike "anal">>
                    <<else>>
                        /* forced pilling */
                        <span class="pink"><<He>> forces <<his>> pill down your throat.</span>
                        <<combat-reset-hand _args[0]>><<set $NPCList[_n][_hand + "tool"] to 0>>
                        <<combat-apply-spike>>
                    <</if>>
                <<else>>
                    <<He>> fiddles with the pill in <<his>> hand, <span class="purple">looking for a chance to feed it to you</span>.
                <</if>>
            <<else>>
                <<He>> fiddles with the pill in <<his>> hand, <span class="purple">looking for a chance to feed it to you</span>.
            <</if>>
        <</if>>
        <<if $xchange._combatRecalcPending>>
            <<set $xchange._combatRecalcPending to false>>
        <</if>>

    <</widget>>

    <<widget "combat-pill-selection">>
        <<set _hand to _args[0]>>
        <<combat-set-hand-target _hand "xchange_pill">>
        /* This NPC's single carried pill is now in their hand. 
        Mark as no longer in pocket so that whacking or using it doesn't get re-rolled into another from nowhere. */
        <<if $NPCList[_n] isnot undefined>>
            <<set $NPCList[_n]._hasCombatPill to false>>
        <</if>>
    <</widget>>

    <<widget "leftpillwhack">>
        <<if $lefttarget isnot "self">>
            <<if $NPCList[$lefttarget].lefthand is "xchange_pill" or $NPCList[$lefttarget].righthand is "xchange_pill">>
                <<set _leftaction["Whack the pill away"] to "pillwhack">>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "rightpillwhack">>
        <<if $righttarget isnot "self">>
            <<if $NPCList[$righttarget].lefthand is "xchange_pill" or $NPCList[$righttarget].righthand is "xchange_pill">>
                <<set _rightaction["Whack the pill away"] to "pillwhack">>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectspillwhack">>
        <<if $leftaction is "pillwhack">>
            <<set $leftaction to 0>>
            <<personselect $lefttarget>>
            <<set $_target to $NPCList[$lefttarget]>>
            <<if $whackRandom and random(1,5) lte 2>>
                <span class="brat">You fail to whack the pill</span> from the <<personselect $lefttarget>><<persons>> hand.
                <<brat 5 $lefttarget>>
            <<else>>
                <<if $_target>>
                    <<if $_target.lefthand is "xchange_pill">>
                        <<combat-reset-hand "left">>
                    <<elseif $_target.righthand is "xchange_pill">>
                        <<combat-reset-hand "right">>
                    <</if>>
                <</if>>
                You whack the pill away from <<personselect $lefttarget>><<combatpersons>> hand. <<He>> clenches <<his>> fist.
                <<brat 10 $lefttarget>>
            <</if>>
        <</if>>

        <<if $rightaction is "pillwhack">>
            <<set $rightaction to 0>>
            <<personselect $righttarget>>
            <<set $_target to $NPCList[$righttarget]>>
            <<if $whackRandom and random(1,5) lte 2>>
                <span class="brat">You fail to whack the pill</span> from the <<personselect $righttarget>><<persons>> hand.
                <<brat 5 $righttarget>>
            <<else>>
                <<if $_target>>
                    <<if $_target.lefthand is "xchange_pill">>
                        <<combat-reset-hand "left">>
                    <<elseif $_target.righthand is "xchange_pill">>
                        <<combat-reset-hand "right">>
                    <</if>>
                <</if>>
                You whack the pill away from <<personselect $righttarget>><<combatpersons>> hand. <<He>> clenches <<his>> fist.
                <<brat 10 $righttarget>>
            <</if>>
        <</if>>
    <</widget>>