:: XChange NPC Targeted Actions Widgets [widget]

    <<widget "pickupXchangePill">>
        <<if $enemytype is "man">>
            <<set $_hand to _args[0]>>
            <<set $_pills to window.listUniqueCarriedXchangePills()>>

            <<if $_hand is "left" and ($lefttarget isnot "self" or $options.targetYourself is false or _targetnumber is 1)>>
                <<if $_pills.length gt 0>>
                    <<set _pillsLeft to {}>>

                    <<run $_pills.forEach(pill => {
                        if ($currentXchangePillRight is undefined or pill.name isnot $currentXchangePillRight.name){
                            _pillsLeft[pill.name] = pill;
                        }
                    })>>
                    <<if Object.keys(_pillsLeft).length gte 1>>
                        <<set _leftaction["Pick up pill:"] to "pickupXchangePill">>
                    <</if>>
                <</if>>
            <</if>>

            <<if $_hand is "right" and ($righttarget isnot "self" or $options.targetYourself is false or _targetnumber is 1)>>
                <<if $_pills.length gt 0>>
                    <<set _pillsRight to {}>>

                    <<run $_pills.forEach(pill => {
                        if ($currentXchangePillLeft is undefined or pill.name isnot $currentXchangePillLeft.name){
                            _pillsRight[pill.name] = pill;
                        }
                    })>>
                    <<if Object.keys(_pillsRight).length gte 1>>
                        <<set _rightaction["Pick up pill:"] to "pickupXchangePill">>
                    <</if>>
                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "heldXchangePill">>
        <<if _args[0] isnot undefined>>
            <<if _args[0] is "left">>
                /* rest */
                <<set _leftaction["Rest"] to "heldXchangePill">>

                /* Drop pill */
                <<set _leftaction["Pocket your pill"] to "dropXchangePill">>

                /* Pill the targeted NPC (non-pillable named NPCs slap it away on resolve) */
                <<if $lefttarget isnot undefined and $lefttarget isnot "self">>
                    <<set _actiontext to ($npcpillingasked is $lefttarget ? "Pill ": "Attempt to pill ")+$NPCList[$lefttarget].pronouns.him>>
                    <<set _leftaction[_actiontext] to "xchangePillOther">>
                <</if>>

                /* Pill yourself */
                <<if !playerIsXChanged() and ($lefttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
                    <<set _leftaction["Pill yourself"] to "xchangePillSelf">>
                <</if>>
            <</if>>

            <<if _args[0] is "right">>
                /* rest */
                <<set _rightaction["Rest"] to "heldXchangePill">>

                /* Drop pill */
                <<set _rightaction["Pocket your pill"] to "dropXchangePill">>

                /* Pill the targeted NPC (non-pillable named NPCs slap it away on resolve) */
                <<if $righttarget isnot undefined and $righttarget isnot "self">>
                    <<set _actiontext to ($npcpillingasked is $righttarget ? "Pill ": "Attempt to pill ")+$NPCList[$righttarget].pronouns.him>>
                    <<set _rightaction[_actiontext] to "xchangePillOther">>
                <</if>>

                /* Pill yourself */
                <<if !playerIsXChanged() and ($righttarget is "self" or $options.targetYourself is false or _targetnumber is 1)>>
                    <<set _rightaction["Pill yourself"] to "xchangePillSelf">>
                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsPickupXchangePill">>
        /* Start with a pill on hand: Before combat do this: <<set $leftarm to "heldXchangePill">><<set $currentXchangePillLeft to clone(setup.pills[0])>> */
        /* That will effectively mimic this widget so that a player starts combat holding a pill */
        <<if $leftaction is "pickupXchangePill" and $rightaction is "pickupXchangePill" and $selectedXchangePillRight.name is $selectedXchangePillLeft.name>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to "heldXchangePill">>
                <<set $currentXchangePillRight to $selectedXchangePillRight>><<set $xchangePillReveal to 1>>
                You pull out a $currentXchangePillRight.name pill and hold it with your right hand.
        <<else>>
            <<if $leftaction is "pickupXchangePill" and $selectedXchangePillLeft>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to "heldXchangePill">>
                <<set $currentXchangePillLeft to $selectedXchangePillLeft>><<set $xchangePillReveal to 1>>
                You pull out a $currentXchangePillLeft.name pill with your left hand.
            <</if>>
            <<if $rightaction is "pickupXchangePill" and $selectedXchangePillRight>>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to "heldXchangePill">>
                <<set $currentXchangePillRight to $selectedXchangePillRight>><<set $xchangePillReveal to 1>>
                You pull out a $currentXchangePillRight.name pill with your right hand.
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsDropXchangePill">>
        <<if $leftaction is "dropXchangePill" and $rightaction is "dropXchangePill">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
            You pocket your pills.
            <<unset $currentXchangePillLeft>><<unset $currentXchangePillRight>>
        <<else>>
            <<if $leftaction is "dropXchangePill">>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                You pocket the $currentXchangePillLeft.name in your left hand.
                <<unset $currentXchangePillLeft>>
            <</if>>
            <<if $rightaction is "dropXchangePill">>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                You pocket the $currentXchangePillRight.name in your right hand.
                <<unset $currentXchangePillRight>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "xchange-pilled-descriptor">><<set _t to _args[0]>><<set _pilledHerm to !!($NPCList[_t].xchange and $NPCList[_t].xchange.hermEffect)>><<if ["Whitney","Robin","Kylar","Sydney","Bailey","Gwylan"].includes($NPCList[_t].fullDescription)>><<set $speechpill to (_pilledHerm ? "herm" : 1)>><</if>><<= ($NPCList[_t].teen ? $NPCList[_t].pronouns.boy : $NPCList[_t].pronouns.man) + (_pilledHerm ? " sporting both a stiff cock and a needy pussy" : "")>><</widget>>

    <<widget "xchange-pilled-subject">><<set _sn to $NPCList[_args[0]]>><<if $NPCNameList.includes(_sn.fullDescription) or _sn.name is _sn.fullDescription>><<= _sn.fullDescription>><<else>>the previously <<= _sn.fullDescription>><</if>><</widget>>

    <<widget "xchange-raul-pill-flavour">>
        <<if $statFreeze and $NPCList[_args[0]] and $NPCList[_args[0]].fullDescription is "Raul">>
            None of this is in the book. You're the one imagining it, so <span class="purple">Raul changes anyway</span>.
        <</if>>
    <</widget>>

    <<widget "xchange-pilled-fury">>
        <<set _ft to _args[0]>>
        <<if $NPCList[_ft].fullDescription is "Bailey">>
            <<personselect _ft>>
            <br><br>
            Bailey goes very still as the change settles. <<He>> looks down at <<his>> unfamiliar body once, slowly, like <<hes>> tallying the damage, then back up at you. You've seen Bailey annoyed. You've seen Bailey angry. You've never seen this.
            <<set _furyFreeHand to ($NPCList[_ft].lefthand is 0 ? "lefthand" : ($NPCList[_ft].righthand is 0 ? "righthand" : 0))>>
            <<set _furyCanChoke to $settings.asphyxiaLevel gte 1 and $nochoke isnot 1 and $neckuse isnot "hand" and !($worn.neck.name is "familiar collar" and $worn.neck.cursed is 1)>>
            <<if _furyFreeHand and _furyCanChoke>>
                "Do you have any idea what you've just cost yourself?" <<His>> hand <span class="red">snaps around your throat and squeezes</span>. "I'm going to collect every penny of this out of your hide."
                <<set $NPCList[_ft][_furyFreeHand] to "throat">><<set $neckuse to "hand">><<violence 4>>
            <<elseif _furyFreeHand>>
                <<He>> seizes a fistful of your hair and <span class="red">wrenches your head back</span>, <<his>> face an inch from yours. "You'll pay for this. With interest."
                <<set $NPCList[_ft][_furyFreeHand] to "hair">><<set $speechhair to 1>><<violence 3>>
            <<else>>
                <<He>> <span class="red">wrenches your head back by the hair</span> hard enough to make your eyes water. "You'll pay for this. Every hour of it."
                <<violence 3>>
            <</if>>
            <<set $enemyanger += 60>><<set $enemytrust -= 40>>
        <</if>>
    <</widget>>

    /* The pill fails to land. Two reasons, in order:
    - $statFreeze: a flashback, vision or dream. The scene already went the way it went, so the pill
      does nothing and the NPC has no reaction to give. Raul is exempt (see npcXchangePillable).
    - Otherwise a named NPC who refuses on their own account, and is angered by the attempt.
    _args[0] = "left"/"right" hand, _args[1] = target index. Resets the holding hand and unsets the held pill. */
    <<widget "xchange-pill-slap">>
        <<set _slapHand to _args[0]>><<set _slapTarget to _args[1]>><<set _slapFrozen to !!$statFreeze>>
        <<if _slapHand is "left">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<unset $currentXchangePillLeft>>
        <<else>>
            <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>><<unset $currentXchangePillRight>>
        <</if>>
        <<if _slapFrozen>>
            <<personselect _slapTarget>>
            You force the pill into <<his>> mouth. <span class="purple">Nothing happens</span>. None of this is real, and the pill has nothing real to work on.
        <<elseif $NPCList[_slapTarget].fullDescription is "Whitney">>
            Whitney's hand snaps up and <span class="red">smacks the pill clean out of your grip</span>. "You think you can pull that shit on me, slut? Not a fucking chance."
            <<set $enemyanger += 50>><<set $enemytrust -= 30>>
        <<else>>
            <<= $NPCList[_slapTarget].fullDescription>> <span class="red">knocks the pill from your hand</span> with a furious snarl. "Get that thing away from me!"
            <<set $enemyanger += 50>><<set $enemytrust -= 30>>
        <</if>>
    <</widget>>

    <<widget "effectsUseXchangePill">>
        <<if $leftaction is "xchangePillSelf" and $rightaction is "xchangePillSelf">>
            <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>><<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
            You swallow the pills, <span class="purple">surrendering yourself to the change.</span>
            <<run $currentXchangePillLeft.effects.forEach(effect => {
                Wikifier.wikifyEval(effect);
            })>>
            <<run $currentXchangePillRight.effects.forEach(effect => {
                Wikifier.wikifyEval(effect);
            })>>
            <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
            <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
            <<unset $currentXchangePillLeft>><<unset $currentXchangePillRight>>
        <<else>>
            <<if $leftaction is "xchangePillSelf">>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                You swallow the $currentXchangePillLeft.name in your left hand, <span class="purple">surrendering to the change.</span>
                <<run $currentXchangePillLeft.effects.forEach(effect => {
                    Wikifier.wikifyEval(effect);
                })>>
                <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
                <<unset $currentXchangePillLeft>>
            <</if>>
            <<if $rightaction is "xchangePillSelf">>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                You swallow the $currentXchangePillRight.name in your right hand, <span class="purple">surrendering to the change.</span>
                <<run $currentXchangePillRight.effects.forEach(effect => {
                    Wikifier.wikifyEval(effect);
                })>>
                <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
                <<unset $currentXchangePillRight>>
            <</if>>
        <</if>>

        <<if $leftaction is "xchangePillOther">>
            <<set $sexStats.pills.pills[$currentXchangePillLeft.name].owned-->>
            <<if $npcpillingasked is $lefttarget>>
                <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                You present $NPCList[$lefttarget].pronouns.him the pill, and $NPCList[$lefttarget].pronouns.he <span class="lewd">opens $NPCList[$lefttarget].pronouns.his mouth</span> allowing you to feed it to $NPCList[$lefttarget].pronouns.him.
                The change is instantaneous, <<xchange-pilled-subject $lefttarget>> is now nothing more than a
                <<npc-select-xchange-target $lefttarget>>
                <<run $currentXchangePillLeft.npcEffects.forEach(npcEffect => {
                    Wikifier.wikifyEval(npcEffect);
                })>>
                <<xchange-pilled-descriptor $lefttarget>>.
                <<xchange-pilled-fury $lefttarget>>
                <<xchange-raul-pill-flavour $lefttarget>>
                <<unset $currentXchangePillLeft>>

            <<elseif not npcXchangePillable($lefttarget)>>
                <<xchange-pill-slap "left" $lefttarget>>

            <<else>>
                You throw yourself onto<<= (!$NPCNameList.includes($NPCList[$lefttarget].fullDescription) and $NPCList[$lefttarget].name isnot $NPCList[$lefttarget].fullDescription) ? " the":"">> $NPCList[$lefttarget].fullDescription, and after some struggle

                <<set _physiquemin to ($NPCList[$lefttarget].skills.athletics - ($enemyhealthmax - $enemyhealth) * ($NPCList[$lefttarget].skills.athletics/$enemyhealthmax)) * 16>>
                <<set _physiquemax to 15000 - ($enemyhealthmax - $enemyhealth) * ($NPCList[$lefttarget].skills.athletics/$enemyhealthmax) * 16>>
                <<silently>><<physiquedifficulty _physiquemin _physiquemax>><</silently>>

                <<if $physiqueSuccess>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    you manage to outmaneuver $NPCList[$lefttarget].pronouns.him, <span class="green">shoving your pill into $NPCList[$lefttarget].pronouns.his mouth</span> and forcing $NPCList[$lefttarget].pronouns.him to swallow.
                    The change is instantaneous, <<xchange-pilled-subject $lefttarget>> is now nothing more than a
                    <<npc-select-xchange-target $lefttarget>>
                    <<run $currentXchangePillLeft.npcEffects.forEach(npcEffect => {
                        Wikifier.wikifyEval(npcEffect);
                    })>>
                    <<xchange-pilled-descriptor $lefttarget>>.
                    <<xchange-pilled-fury $lefttarget>>
                    <<xchange-raul-pill-flavour $lefttarget>>
                    <<unset $currentXchangePillLeft>>

                <<elseif !playerIsXChanged() and playerMayBeSpiked()>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    $NPCList[$lefttarget].pronouns.he overpowers you, taking the pill away from you and <span class="red">forcing it down your throat</span>.
                    <<run $currentXchangePillLeft.effects.forEach(effect => {
                        Wikifier.wikifyEval(effect);
                    })>>
                    <<unset $currentXchangePillLeft>>

                <<else>>
                    <<set $leftaction to 0>><<set $leftactiondefault to "rest">><<set $leftarm to 0>>
                    $NPCList[$lefttarget].pronouns.he <span class="brat">whacks the pill away from your hand</span>.
                    <<unset $currentXchangePillLeft>>

                <</if>>
            <</if>>
            
        <</if>>
        <<if $rightaction is "xchangePillOther">>
            <<set $sexStats.pills.pills[$currentXchangePillRight.name].owned-->>
            <<if $npcpillingasked is $righttarget>>
                <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                You present $NPCList[$righttarget].pronouns.him the pill, and $NPCList[$righttarget].pronouns.he <span class="lewd">opens $NPCList[$righttarget].pronouns.his mouth</span> allowing you to feed it to $NPCList[$righttarget].pronouns.him.
                The change is instantaneous, <<xchange-pilled-subject $righttarget>> is now nothing more than a
                <<npc-select-xchange-target $righttarget>>
                <<run $currentXchangePillRight.npcEffects.forEach(npcEffect => {
                    Wikifier.wikifyEval(npcEffect);
                })>>
                <<xchange-pilled-descriptor $righttarget>>.
                <<xchange-pilled-fury $righttarget>>
                <<xchange-raul-pill-flavour $righttarget>>
                <<unset $currentXchangePillRight>>

            <<elseif not npcXchangePillable($righttarget)>>
                <<xchange-pill-slap "right" $righttarget>>

            <<else>>
                You throw yourself onto<<= (!$NPCNameList.includes($NPCList[$righttarget].fullDescription) and $NPCList[$righttarget].name isnot $NPCList[$righttarget].fullDescription) ? " the":"">> $NPCList[$righttarget].fullDescription, and after some struggle

                <<set _physiquemin to ($NPCList[$righttarget].skills.athletics - ($enemyhealthmax - $enemyhealth) * ($NPCList[$righttarget].skills.athletics/$enemyhealthmax)) * 16>>
                <<set _physiquemax to 15000 - ($enemyhealthmax - $enemyhealth) * ($NPCList[$righttarget].skills.athletics/$enemyhealthmax) * 16>>
                <<silently>><<physiquedifficulty _physiquemin _physiquemax>><</silently>>

                <<if $physiqueSuccess>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    you manage to outmaneuver $NPCList[$righttarget].pronouns.him, <span class="green">shoving your pill into $NPCList[$righttarget].pronouns.his mouth</span> and forcing $NPCList[$righttarget].pronouns.him to swallow.
                    The change is instantaneous, <<xchange-pilled-subject $righttarget>> is now nothing more than a
                    <<npc-select-xchange-target $righttarget>>
                    <<run $currentXchangePillRight.npcEffects.forEach(npcEffect => {
                        Wikifier.wikifyEval(npcEffect);
                    })>>
                    <<xchange-pilled-descriptor $righttarget>>.
                    <<xchange-pilled-fury $righttarget>>
                    <<xchange-raul-pill-flavour $righttarget>>
                    <<unset $currentXchangePillRight>>

                <<elseif !playerIsXChanged() and playerMayBeSpiked()>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    $NPCList[$righttarget].pronouns.he overpowers you, taking the pill away from you and <span class="red">forcing it down your throat</span>.
                    <<run $currentXchangePillRight.effects.forEach(effect => {
                        Wikifier.wikifyEval(effect);
                    })>>
                    <<unset $currentXchangePillRight>>

                <<else>>
                    <<set $rightaction to 0>><<set $rightactiondefault to "rest">><<set $rightarm to 0>>
                    $NPCList[$righttarget].pronouns.he <span class="brat">whacks the pill away from your hand</span>.
                    <<unset $currentXchangePillRight>>

                <</if>>
            <</if>>
        <</if>>
    <</widget>>

    <<widget "effectsAskNpcXchangePill">>
        <<if $mouthaction is "ask" and $askAction is "askXchangePill">>
			<<set $mouthaction to 0>><<set _sound to 1>>
			<<if $neckuse is "hand" and $oxygen lt $oxygenmax and $asphyxiaLvl gte 2>>
				<<wheeze "ask <<him>> to let you pill <<him>">>
			<<else>>
				<<set $mouthactiondefault to "rest">>
                <<brat 5 demanding>><<if !$gloryhole and $gamemode isnot "soft">><<seductionskillusecombat>><</if>><<unset $askAction>>
                You ask <<him>> to let you pill <<him>>.

                <<if $NPCList[$mouthtarget].fullDescription is "Whitney" and npcXchangePillable($mouthtarget)>>
                    <<set $npcpillingasked to $mouthtarget>><<He_Short>> grins and tips <<his>> head back, <span class="green">mouth open in amused acceptance</span>.
                    <span class="gold">You may now pill <<him>> without opposition.</span>

                <<elseif $role is "islander" and (!$islander_language or $islander_language lt 100)>>
                    <span class="red"><<if $enemyno gte 2>>They don't<<else>><<He>> doesn't<</if>> understand your words,</span> and <<if $enemyno gte 2>>ignore<<else>>ignores<</if>> them.

                <<elseif $combatgoal is "strip">>
                    "<span class="pink">No</span>," <<if $enemyno gte 2>>they laugh<<else>><<he>> laughs<</if>>. <<if !playerIsXChanged()>>"If anything, I should be pilling you."<<else>>"Don't even think about it."<</if>>
                    
                <<elseif npcXchangePillable($mouthtarget) and combatSkillCheck("seduction", $mouthtarget, $NPCList[$mouthtarget].fullDescription)>>
                    <<set $npcpillingasked to $mouthtarget>><span class="green"><<He_Short>> nods in acknowledgement.</span>
                    <span class="gold">You may now pill <<him>> without opposition.</span>

                <<elseif $enemyanger gte $enemyangermax * (2/5)>>
                    <<His>> answer arrives within a single breath, "<span class="red">Stupid slut</span>, you think you are in any position to be asking for anything?"

                <<else>> 
                    <<He>> pauses for a moment to ponder, <span class="red">"No, I don't think I'd want that."</span>
                
                <</if>>
			<</if>>
		<</if>>
    <</widget>>

    /* Reaction when the player reveals/brandishes an X-Change pill in combat.
       Called from init.twee when $xchangePillReveal is set. Mirrors the sextoy-reveal
       Uses $xchangePillWord (a story var) so the text survives the deferred event pool. */
    <<widget "npc-reaction-pill">>
        <<set $xchangePillWord to ($rightarm is "heldXchangePill" and $leftarm is "heldXchangePill" ? "pills" : "pill")>>

        <<if $enemyno gte 2>>
            <<set $speechPillState to $speechPillState or either("curious", "aroused", "wary", "angry")>>
            <<cleareventpool>>
            <<switch $speechPillState>>
                <<case "curious">>
                    <<addinlineevent>>They eye the X-Change $xchangePillWord in your hand with open curiosity.<</addinlineevent>>
                    <<addinlineevent>>They murmur amongst themselves, intrigued by your X-Change $xchangePillWord.<</addinlineevent>>
                <<case "aroused">>
                    <<addinlineevent>>They grin at the sight of your X-Change $xchangePillWord, excited by the idea.<<set $enemyarousal += 40>><</addinlineevent>>
                <<case "wary">>
                    <<addinlineevent 0.5>>They tense, eyeing your X-Change $xchangePillWord warily.<<set $enemytrust -= 30>><</addinlineevent>>
                <<default>>
                    <<addinlineevent 0.5>>They recoil from your X-Change $xchangePillWord. "Keep that away from us!"<<set $enemyanger += 40>><<set $enemytrust -= 30>><</addinlineevent>>
            <</switch>>
            <<runeventpool>>
        <<elseif $NPCList[0] and npcXchangePillable(0) and ["Whitney", "Robin", "Kylar", "Sydney", "Bailey", "Gwylan"].includes($NPCList[0].fullDescription)>>
            /* Pillable named NPCs voice their own reaction in their speech file. */
            <<set $speechpillreveal to 1>>
        <<elseif $NPCList[0] and $NPCNameList.includes($NPCList[0].fullDescription)>>
            /* Named but not pillable (incl. Whitney when love/dom fails): they want nothing to do with it. */
            <<cleareventpool>>
            <<addinlineevent>><<He>> notices the X-Change $xchangePillWord and sneers. "Don't even think about using that on me."<<set $enemyanger += 20>><<set $enemytrust -= 20>><</addinlineevent>>
            <<runeventpool>>
        <<else>>
            <<set $speechPillState to $speechPillState or either("curious", "aroused", "wary", "angry")>>
            <<cleareventpool>>
            <<switch $speechPillState>>
                <<case "curious">>
                    <<addinlineevent>><<He>> eyes the X-Change $xchangePillWord in your hand with curiosity.<</addinlineevent>>
                    <<addinlineevent>><<He>> studies your X-Change $xchangePillWord, trying to work out what you intend.<</addinlineevent>>
                <<case "aroused">>
                    <<addinlineevent>><<His>> breath quickens at the sight of your X-Change $xchangePillWord, excited by the possibilities.<<set $enemyarousal += 50>><</addinlineevent>>
                    <<addinlineevent>><<He>> licks <<his>> lips at your X-Change $xchangePillWord. "Now that could be fun."<<set $enemyarousal += 40>><</addinlineevent>>
                <<case "wary">>
                    <<addinlineevent 0.5>><<He>> eyes your X-Change $xchangePillWord warily, unsure of your intentions.<<set $enemytrust -= 30>><</addinlineevent>>
                <<default>>
                    <<addinlineevent 0.5>><<He>> glares at your X-Change $xchangePillWord. "Keep that away from me."<<set $enemyanger += 40>><<set $enemytrust -= 30>><</addinlineevent>>
            <</switch>>
            <<runeventpool>>
        <</if>>
    <</widget>>

<!--
Shared knot reaction. Prints the "locked together" narration plus a personality or situation-flavoured line for the NPC the player is knotted inside.
_args[0] = hole the knot caught in ("vagina" or "anus").
