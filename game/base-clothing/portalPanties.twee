			<<set $_text_output to "<span class='red'>Your penis virginity is taken.</span><<fallenTransform>>">>
		<</if>>
<</switch>>
<</silently>><<if _firstItem>><br><<set _firstItem to false>><</if>><<print $_text_output>>
<</widget>>

<<widget "portalPantiesPortalCum">>
	<<switch _args[0]>>
		<<case "anus">>
