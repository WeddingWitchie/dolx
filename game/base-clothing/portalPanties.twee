:: Portal Panties [widget]

/* Witten for a bit of fun over a couple of hours, feel free to mod it in or re-work it. Follow the comments to run in the game. Lollipop Scythe */

/*Run at the start of the game and in version update*/
<<widget "portalPantiesSetup">>
	<<if $portalPanties is undefined>>
		<<set $portalPanties to {
			toPass: 0,
			totalPassed: 0,
			cooldown: random(300,720),
			state: {
				anus: undefined,
				vagina: undefined,
			},
			ownPenisOrgasms: {
				anus: 0,
				vagina: 0,
			},
			portalPenisOrgasms: {
				anus: 0,
				vagina: 0,
			},
			message: {
				entrance: [],
				imminent: [],
				started: [],
				continued: [],
				disappeared: [],
				resumed: [],
				finished: [],
			}
		}>>
	<</if>>
	<<if $portalPanties.message.resumed is undefined>>
		<<set $portalPanties.message.resumed to []>>
	<</if>>
	<<if $portalPanties.message.entrance is undefined>>
		<<set $portalPanties.message.entrance to []>>
		<<set $portalPanties.message.imminent to []>>
	<</if>>
<</widget>>

/* Place '<<portalPantiesPass $pass>>' within <<widget "pass">> */
<<widget "portalPantiesPass">>
	<<if $event or playerChastity("hidden")>>/*Prevents it from running during events or if the player has a chastity belt*/
	<<elseif $portalPantiesEnabled and ($worn.under_lower.type.includes("portal") or $xchangePill.portalEffect)>>
		<<set $portalPanties.totalPassed += _args[0]>>
		<<set _totalToPass to _args[0]>>
		<<set _remainingCooldown to $portalPanties.cooldown || 1>>
		<<for _totalToPass gt 0>>
			<<if $portalPanties.cooldown gte 0 and _args[0] gt 0>>
				<<set $portalPanties.cooldown to Math.clamp($portalPanties.cooldown - _totalToPass, 0, 1440)>>
			<</if>>
			<<set _totalToPass to Math.max(_totalToPass - $portalPanties.cooldown, 0)>>
			<<if ["anus","vagina"].find((location) => $portalPanties.state[location])>>
				<<set $portalPanties.toPass to Math.clamp($portalPanties.toPass + _args[0], 0, 1440)>>
			<</if>>
			<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
			<<if $portalPanties.cooldown lte 0 and !$NPCList[0].name and !$event>>
				/* Attempt to fill a hole */
				<<set $_free to []>>
				<<if !$portalPanties.state.anus>><<run $_free.pushUnique("anus")>><</if>>
				<<if !$portalPanties.state.vagina>><<run $_free.unshiftUnique("vagina")>><</if>>
				<<if !$_free.length>><<break>><</if>>

				<<set $_playersPPFree to $player.penisExist and $player.penissize gte 0 and !playerChastity("cage") and !$_penisLocation>>
				<<set $_toFill to $_free.shift()>>
				<<if $_toFill>>
					<<portalPantiesFillHole $_toFill $_playersPPFree `_totalToPass gt 30? _totalToPass / 10 : 1`>>
				<</if>>
				<<if $portalPanties.state.anus or $portalPanties.state.vagina>>
					/* Sets the cooldown, 1440 is 1 day */
					<<if between($portalPanties.totalPassed, 0, 1440 * 2)>>
						<<set $portalPanties.cooldown to random(540,720)>>
					<<elseif between($portalPanties.totalPassed, 1440 * 2, 1440 * 5)>>
						<<set $portalPanties.cooldown to random(270,540)>>
					<<elseif between($portalPanties.totalPassed, 1440 * 5, 1440 * 10)>>
						<<set $portalPanties.cooldown to random(135,270)>>
					<<elseif between($portalPanties.totalPassed, 1440 * 10, 1440 * 20) or random(0,1)>>
						<<set $portalPanties.cooldown to random(45,135)>>
					<<else>>
						<<set $portalPanties.cooldown to random(15,45)>>
					<</if>>
				<</if>>
			<</if>>
		<</for>>
		
	<<else>>
		/*Stop the effect if it should no longer apply */
		<<set $portalPanties.toPass to 0>>
		<<portalPantiesClear "vagina">>
		<<portalPantiesClear "anus">>
	<</if>>
<</widget>>

<<widget "portalPantiesFillHole">>
	<<if !$portalPanties.state[_args[0]]>>
		<<set $portalPanties.state[_args[0]] to {
			owner: _args[1] ? "pc" : "portal",
			size: _args[1] ? $player.penissize : random(1,4),
			timer: _args[1] ? null : random(5,31),
			type:  _args[1] ? "human" : "human",
			new: _args[2] gt 3? 0 : Math.ceil(_args[2]),
			tempRemoval: false,
			tempTimer: 0,
		}>>
		<<set $portalPanties.overloaded to _args[2] gt 1>>
	<</if>>
<</widget>>

<<widget "portalPantiesFuck">>
	<<set _arousalIncrease to 0>>
	<<set _toPass to Math.min($portalPanties.toPass, $portalPanties.state[_args[0]]?.timer || 31)>>
	<<set _penisSize to $portalPanties.state[_args[0]] and [3,0].includes($portalPanties.state[_args[0]].new)? _args[1] : 1>>
	<<if $portalPanties.state[_args[0]] and !$portalPanties.state[_args[0]].tempRemoval>>
		<<switch $portalPanties.state[_args[0]].new>>
		<<case 3>>
			<<set _arousalIncrease to 100>>
			<<if $portalPanties.state[_args[0]].timer>>
				<<set $portalPanties.state[_args[0]].timer -= _toPass>>
			<</if>>
			<<set _toPass to Math.max(_toPass, 10)>>
		<<case 1 2>>
			<<set _arousalIncrease to 200>>
		<<case 0>>
			<<set _arousalIncrease to 200>>
			<<if $portalPanties.state[_args[0]].timer>>
				<<set $portalPanties.state[_args[0]].timer -= _toPass>>
			<</if>>
			<<set _toPass to Math.max(_toPass, 1)>>
		<</switch>>
	<<elseif $portalPanties.state[_args[0]] and $portalPanties.state[_args[0]].tempRemoval>>
		<<set $portalPanties.state[_args[0]].tempTimer -= $portalPanties.toPass>>
	<</if>>
	<<penetrationPainCalculate>>
	<<set _toPass to ([1,2].includes($portalPanties.state[_args[0]]?.new)? 1 : _toPass)>>
	<<switch _args[0]>>
		<<case "vagina">>
			<<arousal `_toPass * _args[1] * _arousalIncrease` "vagina">>
		<<case "anus">>
			<<arousal `_toPass * _args[1] * _arousalIncrease` "anus">>
	<</switch>>
<</widget>>

<<widget "portalPantiesClear">>
	<<set $portalPanties.state[_args[0]] to undefined>>
<</widget>>

/* Place '<<portalPantiesDisplay>>' within '<<widget "effects">>' */
<<widget "portalPantiesDisplay">><<silently>>
	/*Runs the 'fucking' effect */
	<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<if $player.vaginaExist>>
		<<portalPantiesFuck "vagina" `$_penisLocation === "vagina" ? 2 : 1`>>
	<</if>>
	<<portalPantiesFuck "anus" `$_penisLocation === "anus" ? 2 : 1`>>

	/*Displays the respective message */
	<<if $worn.under_lower.type.includes("portal") or $xchangePill.portalEffect>>
		<<if $player.vaginaExist>>
			<<portalPantiesDisplayItem "vagina">>
		<</if>>
		<<portalPantiesDisplayItem "anus">>
	<</if>>
	<</silently>><<portalPantiesDisplayMessage>>

	<<set $portalPanties.toPass to 0>>
<</widget>>

<<widget "portalPantiesDisplayItem">>
	<<if $portalPanties.state[_args[0]]>>
		<<set _relevantWetness to {"vagina":$vaginaWetness, "anus":$anusWetness}[_args[0]]>>
		<<set $_disabled to !!$event or !!$NPCList[0].name>>
		<<if $_disabled and !$portalPanties.state[_args[0]].tempRemoval and $portalPanties.state[_args[0]].new is 0 and (random(1,3) is 1)>>
			<<set $portalPanties.message.disappeared.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].tempRemoval to true>>
			<<set $portalPanties.state[_args[0]].tempTimer to random(1,10)>>
			<<run console.warn("Disappeared!")>>
		<<elseif $_disabled>>
			<<run console.warn("Nothing!")>>
			/* Nothing */

		<<elseif !$_disabled and $portalPanties.state[_args[0]].tempRemoval and !$portalPanties.state[_args[0]].new and $portalPanties.state[_args[0]].tempTimer lte 0>>
			<<set $portalPanties.message.resumed.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].tempRemoval to false>>
			<<run console.warn("Resumed!")>>
		<<elseif $portalPanties.state[_args[0]].new is 1>>
			<<set $portalPanties.message.entrance.push(_args[0])>>
			<<if (_relevantWetness gte ($portalPanties.state[_args[0]].size * 15) + random(1, 40) or random(1, 2) is 2)>><<set $portalPanties.state[_args[0]].new+=2>><<else>><<set $portalPanties.state[_args[0]].new++>><</if>>
			<<run console.warn("Entrance!")>>
		<<elseif $portalPanties.state[_args[0]].new is 2>>
			<<set $portalPanties.message.imminent.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].new++>>
			<<run console.warn("Imminent!")>>
		<<elseif $portalPanties.state[_args[0]].new is 3>>
			<<set $portalPanties.message.started.push(_args[0])>>
			<<set $portalPanties.state[_args[0]].new to 0>>
			<<run console.warn("Started!")>>
		<<else>>
			<<if $portalPanties.state[_args[0]].owner is "pc">>
				<<set $portalPanties.message.continued.push(_args[0])>>
				<<run console.warn("Ongoing!")>>
			<<else>>
				<<if $portalPanties.state[_args[0]].timer lte 0>>
					<<set $portalPanties.message.finished.push(_args[0])>>
					<<run console.warn("Finished!")>>
				<<elseif $portalPanties.state[_args[0]].tempTimer lte 0>>
					<<set $portalPanties.message.continued.push(_args[0])>>
					<<run console.warn("Ongoing!")>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "portalPantiesDisplayMessage">>
	<<penetrationPainCalculate>>
	<<set _awareOfPenis to $awareness gte 300>>
	<<set $_entrance to $portalPanties.message.entrance>>
	<<set $_imminent to $portalPanties.message.imminent>>
	<<set $_started to $portalPanties.message.started>>
	<<set $_continued to $portalPanties.message.continued>>
	<<set $_finished to $portalPanties.message.finished>>
	<<set $_disappeared to $portalPanties.message.disappeared>>
	<<set $_resumed to $portalPanties.message.resumed>>
	<<set $_startedPlayerPenis to $_started.find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<set $_continuedPlayerPenis to $_continued.find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>
	<<set $_penisLocation to ["anus","vagina"].find((location) => $portalPanties.state[location] and $portalPanties.state[location].owner is "pc")>>

	<<set _portalArousalLevel to Math.min($portalPanties.state.vagina?.timer || 100, $portalPanties.state.anus?.timer || 100) / 6>>
	<<if _portalArousalLevel gte 4>>
		<<set _animspeed to "mid">>
	<<elseif _portalArousalLevel gte 3>>
		<<set _animspeed to "fast">>
	<<else>>
		<<set _animspeed to "vfast">>
	<</if>>

	<<if $_entrance.length>>
		<span class="purple">
			You feel something <<= ["poking at","prodding at","kissing","licking"].random()>> your <<= formatList($_entrance)>>.
		</span>
		<br>
	<</if>>
	<<if $_imminent.length>>
		<span class="purple">
			The intrusion<<= $_imminent.length gt 1? "s are": " is">> pushing into your <<= formatList($_imminent)>>, seeking to gain entry. 
		</span>
		<span class="red">
			<<= $_imminent.length gt 1? "They're": "It's">> about to penetrate!
		</span>
		<br>
	<</if>>
	<<if $_started.length>>
		<span class="pink">You gasp in surprise as you suddenly feel
		<<set _penisSize to ["","big","large","huge","massive"][$portalPanties.state[$_started[0]].size-1]>>
		<<if _awareOfPenis>>
			<<print ($_started.length gt 1) ? `<<= $portalPanties.state[$_started[0]].size is 1? ["some mysterious","some alien","some unknown"].random(): _penisSize>> penises` : `<<= $portalPanties.state[$_started[0]].size is 1? ["a mysterious","an alien","an unknown"].random() : "a "+_penisSize>> penis`>>
		<<else>>
			<<print ($_started.length gt 1) ? `<<= $portalPanties.state[$_started[0]].size is 1? ["mysterious","some alien","some unknown"].random(): _penisSize>> objects` : `<<= $portalPanties.state[$_started[0]].size is 1? ["a mysterious","an alien","an unknown"].random() : "a "+_penisSize>> object`>>
		<</if>>
		<<= ["penetrate","invade","ravage"].random()>> your <<print formatList($_started)>><<if $_startedPlayerPenis>>, while at the same time your penis is suddenly enveloped by <<if _awareOfPenis>>a <<print $_penisLocation>><<else>>something foreign<</if>><</if>>.</span><span class="lewd"> Your knees buckle on the sudden intrusion.</span><<ggarousal>>
		<br>
		<<if $options.hidePortalXray>>
			<<if window.document.body.clientWidth lt 650>>
				<div id="divandroidsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
				</div>
				<<xrayimg>>
			<<else>>
				<div id="divsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
					<<xrayimg>>
				</div>
			<</if>>
			<<run combatCharacterShadow()>>
		<</if>>
	<</if>>
	<<if $_continued.length>>
		<span class="lewd">
		<<if $portalPanties.asleep>>
			You awake to <<= ($_continued.length gt 1) ? "several" : "a">> 
		<<else>>
			<<= $portalPanties.overloaded? `<<= ($_continued.length gt 1) ? "Several" : "A">>` : "The">> 
		<</if>>
		<<if _awareOfPenis>>
			<<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> penis<<print ($_continued.length gt 1) ? "es" : "">>
		<<else>>
			<<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> object<<print ($_continued.length gt 1) ? "s" : "">>
		<</if>>
		<<= $portalPanties.asleep? "":`keep<<= ($_continued.length gt 1) ? "" : "s">>`>> <<= ["rhythmically","constantly", "continuously", "madly", "sporadically"].random()>> <<= ["thrusting","pistoning","pounding"].random()>> into your <<print formatList($_continued)>><<if $_continuedPlayerPenis>>, just as your penis is forced <<if _awareOfPenis>>into a <<print $_penisLocation>><<else>>in and out of something<</if>><</if>>.</span><<garousal>>
		<br>
		<<if $options.hidePortalXray>>
			<<if window.document.body.clientWidth lt 650>>
				<div id="divandroidsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
				</div>
				<<xrayimg>>
			<<else>>
				<div id="divsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
					<<xrayimg>>
				</div>
			<</if>>
			<<run combatCharacterShadow()>>
		<</if>>
	<</if>>
	<<if $_finished.length>>
		<span class="purple">
		<<if _awareOfPenis>>
			<<= $portalPanties.overloaded? `<<= ($_finished.length gt 1) ? "Several" : "A">>` : "The">> <<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> penis<<print ($_finished.length gt 1) ? "es" : "">>
		<<else>>
			<<= $portalPanties.overloaded? `<<= ($_finished.length gt 1) ? "Several" : "A">>` : "The">> <<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> object<<print ($_finished.length gt 1) ? "s" : "">>
		<</if>>
		inside you suddenly begin<<= ($_finished.length gt 1) ? "" : "s">> expanding erractically before releasing their <<= ["sticky", "gooey", "wet", "slimey"].random()>> load into your <<print formatList($_finished)>> and then disappearing.</span>
		<br>
		<<for $_item range $_finished>>
			<<portalPantiesPortalCum $_item>>
		<</for>>
		<<if $options.hidePortalXray>>
			<<if window.document.body.clientWidth lt 650>>
				<div id="divandroidsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
				</div>
				<<xrayimg>>
			<<else>>
				<div id="divsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
					<<xrayimg>>
				</div>
			<</if>>
			<<run combatCharacterShadow()>>
		<</if>>
		<<for $_item range $_finished>>
			<<portalPantiesClear $_item>>
		<</for>>
	<</if>>
	<<if $_disappeared.length>>
		<span class="lblue">
		<<if _awareOfPenis>>
			The <<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> penis<<print ($_disappeared.length gt 1) ? "es" : "">>
		<<else>>
			The <<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> object<<print ($_disappeared.length gt 1) ? "s" : "">>
		<</if>>
		in your <<print formatList($_disappeared)>> suddenly disappear<<print ($_disappeared.length gt 1) ? "" : "s">>. Leaving you feeling both empty and oddly frustrated.</span>
		<br>
	<</if>>
	<<if $_resumed.length>>
		<span class="purple">
		A familiar sensation returns, as the
		<<if _awareOfPenis>>
			<<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> penis<<print ($_resumed.length gt 1) ? "es" : "">>
		<<else>>
			<<= ["voracious","ravenous","invading","ravaging","assailing"].random()>> object<<print ($_resumed.length gt 1) ? "s" : "">>
		<</if>>
		resume<<print ($_resumed.length gt 1) ? "" : "s">> <<= ["violating","plundering","ransacking","despoiling"].random()>> your <<= formatList($_resumed)>>.</span>
		<br>
		<<if $options.hidePortalXray>>
			<<if window.document.body.clientWidth lt 650>>
				<div id="divandroidsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
				</div>
				<<xrayimg>>
			<<else>>
				<div id="divsex" @class="colourContainerClasses() + ($options.combatAnimations isnot false ? '':' noAnimations')">
					<<xrayimg>>
				</div>
			<</if>>
			<<run combatCharacterShadow()>>
		<</if>>
	<</if>>
	<<set _firstItem to true>>
	<<for $_item range $portalPanties.message.started>>
		<<portalPantiesDisplayVirginity $_item>>
	<</for>>
	<<if $_penisLocation>>
		<<portalPantiesDisplayVirginity "penis">>
	<</if>>
	/* NO. DO NOT DO THIS. IT BREAKS EVENTS */
	/* Orgasm if your climax is reached
	<<if $arousal gte $arousalmax>>
		<<orgasm>>
	<</if>> */
	<<set $portalPanties.message.entrance to []>>
	<<set $portalPanties.message.imminent to []>>
	<<set $portalPanties.message.started to []>>
	<<set $portalPanties.message.continued to []>>
	<<set $portalPanties.message.finished to []>>
	<<set $portalPanties.message.disappeared to []>>
	<<set $portalPanties.message.resumed to []>>
	<<unset $portalPanties.asleep>>
	<<unset $portalPanties.overloaded>>
	<<unset $portalEjacA>>
	<<unset $portalEjacV>>
<</widget>>

/*Every widget below here might need to be checked for issues, didn't spent too long on it */
<<widget "portalPantiesDisplayVirginity">><<silently>>
<<switch _args[0]>>
	<<case "vagina">>
		<<if $player.virginity.vaginal is true>>
			<<takeVirginity "Portal Panties" "vaginal">>
			<<run console.log($vaginalPain, $portalPanties.state[_args[0]].size, $vaginalPain * (1.5 / (5 - ($portalPanties.state[_args[0]].size))))>>
			<<pain `$vaginalPain * $portalPanties.state[_args[0]].size`>>
			<<if $sexStats.vagina.pregnancy.totalBirthEvents gt 0>>
				<<set $_text_output to "<span class='red'>Despite your lack of a hymen, you feel <<if _awareOfPenis>>a penis<<else>>something<</if>> inside you change as your virginity and purity are taken.</span><<fallenTransform>><<ggpain>>">>
