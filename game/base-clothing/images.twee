:: Widgets Img [widget]
<<widget "img">>
	<<if !_thermoDisable>>
		<<thermometer>>
	<</if>>

	<div id="imgInv">
		<div><<currentSexSidebar>></div>
		<div id="condomsSidebar">
			<<if $condoms>>
				<<condomsSidebar>>
			<</if>>
		</div>
		<<if $spraymax>>
			<div><<peppersprays>></div>
		<</if>>
		<<if $worn.handheld.type.includes("fishing_rod") and $options.fishingBaitSelection isnot "dropdown">>
			<div class="bait-sidebar-row"><<baitSidebar>></div>
		<</if>>
	</div>
	<div id="img" class="doll-expand" title="View full doll" onclick="wikifier('overlayReplace &quot;dollCanvas&quot;')">
		<<canvasimg "mainCanvas">>
	</div>
	<div id="characterTooltip"></div>
<</widget>>

:: Widgets Clothes Img [widget]

<<widget "player-base-body">>
	<div id="img">
		<<canvas-player-base-body>>
	</div>
<</widget>>
