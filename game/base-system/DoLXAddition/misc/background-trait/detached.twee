:: Detached Widgets [widget]

/* Prints the original blush sentence, or the Detached version of it.
   The optional second argument is the same action with the blush removed, printed after the Detached line. */
<<widget "blushText">>
	<<if !playerIsDetached()>>
		<<print _args[0]>>
	<<elseif detachedCracks()>>
		For once, your face shows what you feel. <<print _args[0]>>
	<<else>>
		<<if $arousal gte $arousalmax * 0.8>>
			Your body is very aroused, but your face stays still.
		<<else>>
			<<print either(
				"You feel something, but it doesn't show on your face.",
				"You feel it, but your expression doesn't change.",
				"Your face stays still, even though you feel something."
			)>>
		<</if>>
		<<if _args[1]>> <<print _args[1]>><</if>>
	<</if>>
<</widget>>

/* After a compliment, flirt, or kind gesture: the NPC sometimes can't read the PC. Uses the current person's pronouns. */
<<widget "detachedRead">>
	<<if playerIsDetached() and !detachedCracks() and random(1, 3) is 1>>
		<<print either(
			"<<He>> looks at your face for a reaction and doesn't find one.",
			"<<He>> can't tell if you liked that.",
			"<<He>> watches you for a moment, unsure what you're thinking.",
			"Your calm face makes <<him>> hesitate."
		)>>
	<</if>>
<</widget>>
