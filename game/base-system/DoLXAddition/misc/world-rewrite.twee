:: World Gender Override Widgets [widget]
<<widget "worldGenderOverrideInstallUiHelpers">>
	<<script>>
		window.refreshWorldGenderOverrideSettingsSlot = function () {
			if (typeof window.jQuery !== "function") return;
			var $slot = jQuery("#worldGenderOverrideSettingsSlot");
			if (!$slot.length) return;
			$slot.empty();
			new Wikifier($slot[0], "<<worldGenderOverrideSettingsBody>>");
		};

		window.setWorldGenderOverrideRiskAccepted = function (value) {
			if (typeof State === "undefined" || !State.variables) return;
			State.variables.settings = State.variables.settings || {};
			State.variables.settings.genderOverrideRiskAccepted = !!value;
			window.refreshWorldGenderOverrideSettingsSlot();
		};
	<</script>>
<</widget>>

<<widget "worldGenderOverrideInit">>
	<<run ensureWorldGenderOverrideState()>>
<</widget>>

<<widget "worldGenderOverrideSettings">>
	<div class="solidBorderContainer settings-container">
		<div id="worldGenderOverrideSettingsSlot">
			<<worldGenderOverrideSettingsBody>>
		</div>
	</div>
<</widget>>

<<widget "worldGenderOverrideSettingsBody">>
	<<worldGenderOverrideInstallUiHelpers>>
	<div id="worldGenderOverrideSettingsBody" class="settingsGrid">
		<div class="settingsHeader">World Override</div>

		<div class="settingsToggleItemWide">
			<span class="gold">Current Mode:</span>
			<<print worldGenderOverrideModeLabel()>>
		</div>
		<div class="settingsToggleItemWide">
			<span class="gold">Choose Mode</span>

			<div class="inline-choice-row world-override-row">
				<span class="buttonSettings"><<button "Mixed (Off)">>
					<<if $settings.genderOverrideMode isnot "off">>
						<<set $settings.genderOverridePendingMode to "off">>
						<<set $settings.genderOverrideShowDisableConfirm to true>>
						<<set $settings.genderOverrideShowWarning to false>>
						<<set $settings.genderOverrideRiskAccepted to false>>
						<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
					<</if>>
				<</button>></span>

				<span class="buttonSettings"><<button "Female Only">>
					<<set $settings.genderOverridePendingMode to "femaleOnly">>
					<<set $settings.genderOverrideShowWarning to true>>
					<<set $settings.genderOverrideShowDisableConfirm to false>>
					<<set $settings.genderOverrideRiskAccepted to false>>
					<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
				<</button>></span>

				<span class="buttonSettings"><<button "Male Only">>
					<<set $settings.genderOverridePendingMode to "maleOnly">>
					<<set $settings.genderOverrideShowWarning to true>>
					<<set $settings.genderOverrideShowDisableConfirm to false>>
					<<set $settings.genderOverrideRiskAccepted to false>>
					<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
				<</button>></span>
			</div>
		</div>
		<<if $settings.genderOverrideShowWarning and ["femaleOnly", "maleOnly"].includes($settings.genderOverridePendingMode)>>
			<div class="settingsToggleItemWide">
				<span class="red"><b>Warning: this setting performs a rewrite.</b></span><br>
					<div class="small-description">
					You are about to force world gender presentation toward 
					<span class="gold"><<print worldGenderOverrideModeLabel($settings.genderOverridePendingMode)>></span>. NPC pronouns, type suffixes (boy/girl), titles, and descriptions will be locked. Body sliders (genitals, breast, and penis size) are <i>not</i> affected, so pregnancy compatibility still uses anatomy.
					</div>
					<ul class="small-description" style="margin:0.5em 0 0 1.2em;">
						<li>NPCs already loaded in this save will be rewritten on the next passage.</li>
						<li>Narration, dialogue, crowds, and characters also follow this setting, which may make some scenes differ from canon. Anatomy and events itself remain unchanged.</li>
						<li>Turning this setting off later restores your saved gender-chance sliders and NNPC display preferences, but NPCs already rewritten will keep their forced pronouns.</li>
					</ul>
				<<if $settings.genderOverrideRiskAccepted>>
					<label>
						<input type="checkbox" checked onchange="window.setWorldGenderOverrideRiskAccepted(this.checked)">
						I understand the risks and want to continue.
					</label>
				<<else>>
					<label>
						<input type="checkbox" onchange="window.setWorldGenderOverrideRiskAccepted(this.checked)">
						I understand the risks and want to continue.
					</label>
				<</if>>

				<br>

				<div class="inline-choice-row world-override-row">
					<<if $settings.genderOverrideRiskAccepted>>
						<<button "Apply Confirmed Override">>
							<<run applyWorldGenderOverride($settings.genderOverridePendingMode)>>
							<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
						<</button>>
					<</if>>
					<<button "Cancel">>
						<<set $settings.genderOverridePendingMode to "">>
						<<set $settings.genderOverrideShowWarning to false>>
						<<set $settings.genderOverrideRiskAccepted to false>>
						<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
					<</button>>
				</div>
			</div>
		<</if>>

		<<if $settings.genderOverrideShowDisableConfirm and $settings.genderOverridePendingMode is "off">>
			<div class="settingsToggleItemWide">
				<span class="gold"><b>Turn override off?</b></span><br>
				<div class="small-description">
					This restores your saved gender-chance sliders and NNPC display preferences for future generation. NPCs already rewritten in this save and any children already born under the override will keep their forced pronouns.
				</div>

				<div class="inline-choice-row world-override-row">
					<<button "Disable Override">>
						<<run applyWorldGenderOverride("off")>>
						<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
					<</button>>
					<<button "Cancel">>
						<<set $settings.genderOverridePendingMode to "">>
						<<set $settings.genderOverrideShowDisableConfirm to false>>
						<<replace "#worldGenderOverrideSettingsSlot">><<worldGenderOverrideSettingsBody>><</replace>>
					<</button>>
				</div>
			</div>
		<</if>>
	</div>
<</widget>>
