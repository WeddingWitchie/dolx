		</div>

		<<run (function () {
			function syncFromState() {
				$(".gi-body-toggle").each(function () {
					var key = this.getAttribute("data-gi-key");
					var boxId = this.getAttribute("data-gi-box");
					var enabled = State.variables.xchange && State.variables.xchange[key];
					var box = document.getElementById(boxId);
					if (box) box.style.display = enabled ? "" : "none";
				});
			}

			if (setup.giBodyToggleInstalled) {
				setTimeout(syncFromState, 0);
				return;
			}
			setup.giBodyToggleInstalled = true;

			$(document).on("change", ".gi-body-toggle input[type=checkbox]", function () {
				var label = this.closest(".gi-body-toggle");
				if (!label) return;
				var boxId = label.getAttribute("data-gi-box");
				var box = document.getElementById(boxId);
				if (box) box.style.display = this.checked ? "" : "none";
			});

		/* Mark category as configured once the player interacts with anything inside it.
		Use click for inputs so selecting "Unaccepted" (false->false) still counts as chosen. */
		function markGiConfigured(el) {
			var box = el.closest(".settingsToggleItem[data-gi-config]");
			if (!box) return;
			var ckey = box.getAttribute("data-gi-config");
			if (!ckey) return;
			if (!State.variables.xchange) State.variables.xchange = {};
			State.variables.xchange[ckey] = true;
		}

		/* inputs (checkbox/radio) */
		$(document).on("click", ".settingsToggleItem[data-gi-config] input", function () {
			markGiConfigured(this);
		});

		/* selects */
		$(document).on("change", ".settingsToggleItem[data-gi-config] select", function () {
			markGiConfigured(this);
		});
			setTimeout(syncFromState, 0);
		})();>>

