:: X-Change Gender Identity Widgets [widget]

<!-- LEGACY -->
	<<widget "genderidentity-orgasm">>
		<<if $player.vaginaExist>>
			<<identitySelector "Vagina">>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -2 1>><<trauma -2>>
				<</if>>
			<</if>>
		<</if>>
		<<set _manlyUse to ["othervagina", "otheranus", "othermouth", "tentacle"]>>
		<<if $player.penisExist and _manlyUse.includes($penisuse)>>
			<<set _penis to identityCharacteristicCategory("Penis")>>
			<<identitySelector _penis>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -2 1>><<trauma -2>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "genderidentity">>
		<<if _args[0] and $xchange.genderIdentityEnabled is true and $xchange.giAutoEnabled is true>>
			/* If it's a dream, reduce change to 10% */
			<<set _multiplier to $statFreeze isnot true ? 2 : 0.2>> 
			<<set _range to ($xchange.giRange is undefined ? 1500 : $xchange.giRange)>>
			<<set _identityCapFloor to Math.round(_range * 0.625)>>

			/* These traits use the player's original sex and should not flip after X-Change. Positive values move identity towards feminine, negative towards masculine. */
			<<set _origSex to playerOriginalSex()>>
			<<set _towardsOppositeSex to (_origSex is "m" ? _args[0] > 0 : _args[0] < 0)>>
			<<if $backgroundTraits.includes("crossdresser") and !$background.transgender>><<set _multiplier *= _towardsOppositeSex ? 1.25 : 0.50 >><</if>>
			<<if $backgroundTraits.includes("genderAnxious")>><<set _multiplier *= _towardsOppositeSex ? 0.50 : 1.25 >><</if>>

			<<set $genderidentity += _args[0] * _multiplier>>
			<<set $genderidentity to Math.clamp($genderidentity,0, _range)>>
			<<if $identityCap>>
				<<if ($genderidentity < _identityCapFloor)>>
					<<set $identityCapMessage to true>><<set $effectsmessage to 1>>
					<<stress 10>><<trauma 10>>
				<</if>>
				<<set $genderidentity to Math.clamp($genderidentity,_identityCapFloor, _range)>>
			<</if>>
		<</if>>
	<</widget>>

	/* Yesterday's outfit line in the daily report, printed by xchange.js from $genderIdentityMessage. */
	<<widget "genderidentity-text">>
		<<if $xchange.genderIdentityEnabled>>
			<<if _args[0] is "f">>
				<span class="pink">Yesterday, you dressed feminine.</span>
			<<elseif _args[0] is "m">>
				<span class="blue">Yesterday, you dressed masculine.</span>
			<</if>>
		<</if>>
	<</widget>>


<!-- AELXER'S IDENTITY -->
	<<widget "identitySettings">>
		/* Imports and the Random start set reject/accepted/preferred independently, which can leave impossible combinations on screen. */
		<<run identityNormalisePresentation()>>

		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">Identity Mechanics:</span><br>
				<ul class="small-description">
					<li><b>Accepted:</b> Accepted characteristics do not cause negative effects. You can also choose one accepted characteristic in each category as Preferred. Having your Preferred characteristic slightly lowers Stress and Trauma.</li>
					<li><b>Dysphoria:</b> Having a characteristic you have not accepted causes Dysphoria, which increases Stress and Trauma.</li>
					<li><b>Tolerance:</b> You slowly gain Tolerance each day towards characteristics you have but have not accepted. At maximum Tolerance, that characteristic becomes Accepted.</li>
					<li><b>Rejected:</b> Rejected characteristics do not give you Trauma, but you also cannot gain Tolerance towards them. Letting Dysphoria from a Rejected characteristic reach its maximum is dangerous.</li>
					<li><b>Begrudged:</b> If Dysphoria from a Rejected characteristic reaches its maximum and your Willpower runs out, you are forced to put up with it. It can then cause Trauma, but repeated Dysphoria will no longer drain your current Willpower. You cannot Reject or Accept it while it is Begrudged. To remove Begrudged, stop having that characteristic, remove it as Preferred if needed, then wait for its Tolerance to fall. After that, you can Reject it again if you want.</li>
				</ul>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				Gender Presentation
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Pronouns </span> <mouse class="tooltip linkBlue">(?)<span>These preferences control the pronouns and gendered words used for your character in game text. Unaccepted characteristics will cause dysphoria. You can prefer multiple pronoun types. When all three are preferred, dynamic pronoun modes become available.</span></mouse>
				<br><span class="small-description">Currently used: <span id="pronoun-current-label"><<= pronounSummaryLabel()>></span></span>
				<br>
				Masculine:
				<br> 
				<label data-target='["identity.presentation.pronouns.masculine.acceptance", "identity.presentation.pronouns.masculine.reject"]' data-disabledif="V.identity.presentation.pronouns.masculine.acceptance && !V.identity.presentation.pronouns.masculine.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredMasculine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredMasculine || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.masculine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.masculine.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredMasculine" false true autocheck>></label>
				<br>
				Feminine:
				<br>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance", "identity.presentation.pronouns.feminine.reject"]' data-disabledif="V.identity.presentation.pronouns.feminine.acceptance && !V.identity.presentation.pronouns.feminine.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredFeminine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredFeminine || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.feminine.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredFeminine" false true autocheck>></label>
				<br>
				Neutral:
				<br> 
				<label data-target='["identity.presentation.pronouns.neutral.acceptance", "identity.presentation.pronouns.neutral.reject"]' data-disabledif="V.identity.presentation.pronouns.neutral.acceptance && !V.identity.presentation.pronouns.neutral.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredNeutral", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredNeutral || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.neutral.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.neutral.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.neutral.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredNeutral" false true autocheck>></label>
				<br>

				<<run updatePronounSummary()>>

				<div data-target='["identity.presentation.pronouns.preferredMasculine", "identity.presentation.pronouns.preferredFeminine", "identity.presentation.pronouns.preferredNeutral"]' data-disabledif="!(V.identity.presentation.pronouns.preferredMasculine && V.identity.presentation.pronouns.preferredFeminine && V.identity.presentation.pronouns.preferredNeutral)">
					<span class="gold">Preferred pronouns based on: </span>
					<br> 
					<label>Current Sex <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "body" autocheck>></label> |
					<label>Clothing <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "clothing" autocheck>></label> |
					<label>Appearance <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "appearance" autocheck>></label> |
					<label>Posture <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "posture" autocheck>></label>
				</div>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Gender Appearance </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria. Your overall appearance includes your body, hair, clothes and posture. Androgynous means neither clearly masculine nor feminine.</span></mouse>
				<br>
				Masculine: 
				<br> 
				<label data-target='["identity.presentation.appearance.masculine.acceptance", "identity.presentation.appearance.masculine.reject"]' data-disabledif="V.identity.presentation.appearance.masculine.acceptance && !V.identity.presentation.appearance.masculine.reject" class="red">Reject <<checkbox "$identity.presentation.appearance.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'm' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.appearance.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.appearance.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.masculine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.masculine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.appearance.preferred" "m" autocheck>></label>
				<br>
				Feminine:
				<br> 
				<label data-target='["identity.presentation.appearance.feminine.acceptance", "identity.presentation.appearance.feminine.reject"]' data-disabledif="V.identity.presentation.appearance.feminine.acceptance && !V.identity.presentation.appearance.feminine.reject" class="red">Reject <<checkbox "$identity.presentation.appearance.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'f' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.appearance.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.appearance.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.feminine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.feminine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.appearance.preferred" "f" autocheck>></label>
				<br>
				Androgynous:
				<br>
				<label data-target='["identity.presentation.appearance.neutral.acceptance", "identity.presentation.appearance.neutral.reject"]' data-disabledif="V.identity.presentation.appearance.neutral.acceptance && !V.identity.presentation.appearance.neutral.reject" class="red">Reject <<checkbox "$identity.presentation.appearance.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.appearance.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.neutral.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.appearance.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.neutral.acceptance"]' data-disabledif="!V.identity.presentation.appearance.neutral.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.appearance.preferred" "n" autocheck>></label>
				<br>
			</div>
			<div class="settingsToggleItem identity-clothing-settings">
				<span class="gold">Clothing Preference </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted outfit styles cause dysphoria when you change clothes and while worn. Preferred styles provide comfort while worn. Neutral prefers clothing that looks neither masculine nor feminine. "Don't Care" disables clothing dysphoria and comfort.</span></mouse>
				<br>
				Masculine:
				<br>
				<label data-target='["identity.presentation.clothing.masculine.acceptance", "identity.presentation.clothing.masculine.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.masculine.acceptance && !V.identity.presentation.clothing.masculine.reject)" class="red">Reject <<checkbox "$identity.presentation.clothing.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'm' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.clothing.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.masculine.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.clothing.masculine.acceptance" true autocheck>></label> |
				<</if>>
				/* Deliberately still clickable while Neutral: these two are the only way back out of it. */
				<label data-target='["identity.presentation.clothing.masculine.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.masculine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.clothing.preferred" "m" autocheck>></label>
				<br>
				Feminine:
				<br>
				<label data-target='["identity.presentation.clothing.feminine.acceptance", "identity.presentation.clothing.feminine.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.feminine.acceptance && !V.identity.presentation.clothing.feminine.reject)" class="red">Reject <<checkbox "$identity.presentation.clothing.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'f' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.clothing.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.feminine.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.clothing.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.feminine.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.feminine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.clothing.preferred" "f" autocheck>></label>
				<br>
				Androgynous:
				<br>
				<label data-target='["identity.presentation.clothing.neutral.acceptance", "identity.presentation.clothing.neutral.reject", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || (V.identity.presentation.clothing.neutral.acceptance && !V.identity.presentation.clothing.neutral.reject)" class="red">Reject <<checkbox "$identity.presentation.clothing.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'u' || V.identity.presentation.clothing.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.clothing.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.neutral.reject", "identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'n' || V.identity.presentation.clothing.neutral.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.clothing.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.neutral.acceptance", "identity.presentation.clothing.preferred"]' data-disabledif="V.identity.presentation.clothing.preferred !== 'n' && !V.identity.presentation.clothing.neutral.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.clothing.preferred" "u" autocheck>></label>
				<br>
				<label class="teal">Don't care <<radiobutton "$identity.presentation.clothing.preferred" "n" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>Clothes are just clothes to you.</span></mouse>
				<br>

				/* Clothing controls have side effects that a click alone wouldn't produce, since clicking only repaints the setting rather than re-rendering the passage:
				  - switching to Neutral has to park both options as accepted right away, so the masculine/feminine "Preferred" radios stay a valid way back out instead of leaving the player stuck on Neutral;
				  - character creation previews the starting outfit, which is chosen from this preference;
				  - rejecting the style already being worn has to land immediately. */
				<<run (function () {
					if (setup.clothingPreferenceChangeInstalled) return;
					setup.clothingPreferenceChangeInstalled = true;
					const preferenceInput = Util.slugify("identity.presentation.clothing.preferred");
					$(document).on("change", ".identity-clothing-settings input", function () {
						if ((this.name || "").endsWith(preferenceInput)) {
							Wikifier.wikifyEval("<<normaliseNeutralClothing>><<startingPlayerImageUpdate>>");
						}
						clothingIdentityChangeCheck();
					});
				})();>>
			</div>
			<div class="settingsToggleItem identity-makeup-settings">
				<span class="gold">Makeup Preference </span> <mouse class="tooltip linkBlue">(?)<span>Choose how you feel about wearing makeup or having a bare face. The makeup currently on your face determines which characteristic is active. Depending on the NPC makeup interference setting, human NPCs may force makeup onto male characters or remove it from female characters during non-consensual encounters once they can reach an uncovered face.</span></mouse>
				<br>
				Wearing makeup:
				<br>
				<label data-target='["identity.presentation.makeup.wearing.acceptance", "identity.presentation.makeup.wearing.reject", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || (V.identity.presentation.makeup.wearing.acceptance && !V.identity.presentation.makeup.wearing.reject)" class="red">Reject <<checkbox "$identity.presentation.makeup.wearing.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'wearing' || V.identity.presentation.makeup.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.makeup.wearing.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.makeup.wearing.reject", "identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || V.identity.presentation.makeup.wearing.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.makeup.wearing.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.makeup.wearing.acceptance", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred !== 'n' && !V.identity.presentation.makeup.wearing.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.makeup.preferred" "wearing" autocheck>></label>
				<br>
				Bare face:
				<br>
				<label data-target='["identity.presentation.makeup.bare.acceptance", "identity.presentation.makeup.bare.reject", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || (V.identity.presentation.makeup.bare.acceptance && !V.identity.presentation.makeup.bare.reject)" class="red">Reject <<checkbox "$identity.presentation.makeup.bare.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'bare' || V.identity.presentation.makeup.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.makeup.bare.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.makeup.bare.reject", "identity.presentation.makeup.preferred", "identity.init"]' data-disabledif="V.identity.presentation.makeup.preferred === 'n' || V.identity.presentation.makeup.bare.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.makeup.bare.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.makeup.bare.acceptance", "identity.presentation.makeup.preferred"]' data-disabledif="V.identity.presentation.makeup.preferred !== 'n' && !V.identity.presentation.makeup.bare.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.makeup.preferred" "bare" autocheck>></label>
				<br>
				<label class="teal">Don't care <<radiobutton "$identity.presentation.makeup.preferred" "n" autocheck>></label> <mouse class="tooltip linkBlue">(?)<span>Makeup and bare faces do not affect your identity. NPCs can still apply or remove makeup.</span></mouse>
				<<run (function () {
					if (setup.makeupPreferenceChangeInstalled) return;
					setup.makeupPreferenceChangeInstalled = true;
					const preferenceInput = Util.slugify("identity.presentation.makeup.preferred");
					$(document).on("change", ".identity-makeup-settings input", function () {
						if ((this.name || "").endsWith(preferenceInput)) Wikifier.wikifyEval("<<normaliseMakeupPreference>>");
					});
				})();>>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				Body
			</div>

		<div class="settingsToggleItemWide">
			<span class="gold bold">Body identity toggles:</span><br>
				<label class="gi-body-toggle" data-gi-key="giBreastSizeEnabled" data-gi-box="gi-box-breasts" data-target='["xchange.giBreastSizeEnabled"]'>Breast Size <<checkbox "$xchange.giBreastSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giAssSizeEnabled" data-gi-box="gi-box-ass" data-target='["xchange.giAssSizeEnabled"]'>Ass Size <<checkbox "$xchange.giAssSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giGenitalsEnabled" data-gi-box="gi-box-genitals" data-target='["xchange.giGenitalsEnabled"]'>Genitals <<checkbox "$xchange.giGenitalsEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giHairLengthEnabled" data-gi-box="gi-box-hair" data-target='["xchange.giHairLengthEnabled"]'>Hair Length <<checkbox "$xchange.giHairLengthEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giBodySizeEnabled" data-gi-box="gi-box-bodysize" data-target='["xchange.giBodySizeEnabled"]'>Body Size <<checkbox "$xchange.giBodySizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giFecundityEnabled" data-gi-box="gi-box-fecundity" data-target='["xchange.giFecundityEnabled"]'>Fecundity <<checkbox "$xchange.giFecundityEnabled" false true autocheck>></label>
