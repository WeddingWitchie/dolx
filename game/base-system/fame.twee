			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "fameProse">>
	<<switch _args[0]>>
		<<case "scrap">>
			<<set $_output to "combat">>
		<<case "good">>
			<<set $_output to "kindness">>
		<<case "social">>
			<<set $_output to "socialite">>
		<<case "model">>
			<<set $_output to "modelling">>
		<<case "impreg">>
			<<set $_output to "impregnation">>
		<<default>>
			<<set $_output to _args[0]>>
	<</switch>>
	<<print $_output>>
<</widget>>
