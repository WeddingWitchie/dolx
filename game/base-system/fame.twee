:: Widgets Fame [widget]
<<widget "fame">>
	<!-- Usage: <<fame 10 "scrap" "good">>. Raises fames regardless of mask, gloryhole, etc. -->
	<<if _args.length gte 2 and $statFreeze isnot true>>
		<<set [$_gain, ...($_fameTypes)] to _args>> <!-- remove first element of array since it's the number -->
		<<run $_fameTypes.forEach(fameType => $fame[fameType] += $_gain * 2)>> <!-- add the specified amount to each specified fame type -->
		<<fameclamp>>
	<</if>>
<</widget>>

<<widget "fameexhibitionism">>
	<<if _args[0] and $statFreeze isnot true>>
		<<if !$gloryhole and !($npc.length is 1 and ["Eden", "Robin", "Kylar", "Sydney", "Gwylan"].includes($npc[0])) or _args[2] is true>>
			<!-- A mask/covered face fully hides you below 500 fame in this category, only halves recognition from 500-999, and stops concealing you at all at 1000+: you're too recognisable by then regardless of your face. -->
			<<if _args[2] is true or ($face isnot "covered" and !$worn.face.type.includes("mask"))>>
				<<set _maskFactor to 1>>
			<<elseif $fame.exhibitionism gte 1000>>
				<<set _maskFactor to 1>>
			<<elseif $fame.exhibitionism gte 500>>
				<<set _maskFactor to 0.5>>
			<<else>>
				<<set _maskFactor to 0>>
			<</if>>
			<<if _maskFactor gt 0>>
				<<set _mod to _maskFactor>>
				<<if $backgroundTraits.includes("exhibitionist")>>
					<<set _mod *= 0.25>>
				<</if>>
				<<set $fame.exhibitionism += _args[0] * 0.5 * _mod * 2>>
				<<set $fame.exhibitionism to Math.clamp($fame.exhibitionism, 0, 2000)>>
				<<if !$xchange.blackmail.hasMaterial and $xchange.blackmail.penaltyThreat.exhibitionism + _args[0] * _mod gte 100>>
					<<blackmail-newmaterial "exhibitionism">>
				<</if>>
				<<set $xchange.blackmail.penaltyThreat.exhibitionism += _args[0] * _mod>>
				<<set $xchange.blackmail.penaltyThreat.exhibitionism = Math.min(1000,$xchange.blackmail.penaltyThreat.exhibitionism)>>
				<<set $xchange.blackmail.historicFame.exhibitionism += _args[0] * 0.5 * _mod>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "fameprostitution">>
	<<if _args[0] and $statFreeze isnot true>>
		<<if !$gloryhole or _args[2] is true>>
			<<if _args[2] is true or ($face isnot "covered" and !$worn.face.type.includes("mask"))>>
				<<set _maskFactor to 1>>
			<<elseif $fame.prostitution gte 1000>>
				<<set _maskFactor to 1>>
			<<elseif $fame.prostitution gte 500>>
				<<set _maskFactor to 0.5>>
			<<else>>
				<<set _maskFactor to 0>>
			<</if>>
			<<if _maskFactor gt 0>>
				<<set $fame.prostitution += _args[0] * _maskFactor * 2>>
				<<set $fame.prostitution to Math.clamp($fame.prostitution, 0, 2000)>>
				<<if !$xchange.blackmail.hasMaterial and $xchange.blackmail.penaltyThreat.prostitution + _args[0] * 2 * _maskFactor gte 100>>
					<<blackmail-newmaterial "prostitution">>
				<</if>>
				<<set $xchange.blackmail.penaltyThreat.prostitution += _args[0] * 2 * _maskFactor>>
				<<set $xchange.blackmail.penaltyThreat.prostitution = Math.min(1000,$xchange.blackmail.penaltyThreat.prostitution)>>
				<<set $xchange.blackmail.historicFame.prostitution += _args[0] * _maskFactor>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

