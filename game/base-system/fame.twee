<<widget "famepregnancy">>
	<<if _args[0] and $statFreeze isnot true and playerBellyVisible()>>
		<<if !$gloryhole or _args[2] is true>>
			<<if _args[2] is true or ($face isnot "covered" and !$worn.face.type.includes("mask"))>>
				<<set _maskFactor to 1>>
			<<elseif $fame.pregnancy gte 1000>>
				<<set _maskFactor to 1>>
			<<elseif $fame.pregnancy gte 500>>
				<<set _maskFactor to 0.5>>
			<<else>>
				<<set _maskFactor to 0>>
			<</if>>
			<<if _maskFactor gt 0>>
				<<if $fame.pregnancy gte 2000 and $AMCTraits.halfGain is 1>>
					<<set $fame.pregnancy += _args[0] * _maskFactor / $AMCTraits.pregnancyFame>>
				<<else>>
					<<set $fame.pregnancy += _args[0] * _maskFactor>>
				<</if>>
				<<set $fame.pregnancy to Math.clamp($fame.pregnancy, 0, Math.clamp(playerNormalPregnancyTotal() + 1,1,8) * 250 * $AMCTraits.pregnancyFame)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

