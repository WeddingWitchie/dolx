<</widget>>

<<widget "famedance">>
	<<exposure>>
	<<if !$gloryhole and $statFreeze isnot true>>
		<<if $face isnot "covered" and !$worn.face.type.includes("mask")>>
			<<set _maskFactor to 1>>
		<<elseif $fame.exhibitionism gte 1000>>
			<<set _maskFactor to 1>>
		<<elseif $fame.exhibitionism gte 500>>
			<<set _maskFactor to 0.5>>
		<<else>>
			<<set _maskFactor to 0>>
		<</if>>
		<<if _maskFactor gt 0>>
			<<set _mod to _maskFactor>>
			<<if $backgroundTraits.includes("exhibitionist")>>
				<<set _mod *= 0.25>>
			<</if>>
			<<if $fame.exhibitionism gte 2000 and $AMCTraits.halfGain is 1>>
				<<if $exposed is 1>>
					<<set $fame.exhibitionism += $audience * _mod / $AMCTraits.exhibitionismFame * 2>>
					<<set $fame.exhibitionism to Math.clamp($fame.exhibitionism, 0, 2000 * $AMCTraits.exhibitionismFame)>>
				<<elseif $exposed gte 2>>
					<<set $fame.exhibitionism += ($audience * 2) * _mod / $AMCTraits.exhibitionismFame * 2>>
					<<set $fame.exhibitionism to Math.clamp($fame.exhibitionism, 0, 2000 * $AMCTraits.exhibitionismFame)>>
				<</if>>
			<<else>>
				<<if $exposed is 1>>
					<<set $fame.exhibitionism += $audience * _mod * 2>>
					<<set $fame.exhibitionism to Math.clamp($fame.exhibitionism, 0, 2000 * $AMCTraits.exhibitionismFame)>>
				<<elseif $exposed gte 2>>
					<<set $fame.exhibitionism += ($audience * 2) * _mod * 2>>
					<<set $fame.exhibitionism to Math.clamp($fame.exhibitionism, 0, 2000 * $AMCTraits.exhibitionismFame)>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

