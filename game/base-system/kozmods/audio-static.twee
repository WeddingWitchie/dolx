:: Audio Static Widgets [widget]

    <<widget "audioInit">>
        <<set setup.initializedPlaylists to []>>
    <</widget>>

    <<widget "init-playlist">>

        <<if setup.playlists is undefined>>
            <<set setup.playlists to {}>>
        <</if>>

        /* Skip initialization if already initialized */
        <<if setup.initializedPlaylists.includes(_args[0])>>
            <<exit>>
        <</if>>

        <<switch _args[0]>>
            /* BGM - background music meant to be player on loop */
            <<case "arcade">>
                <<cacheaudio "arcade1" "audio/bgm/arcade/HoliznaCC0 - Mutant Club.mp3">>
                    <<createplaylist "arcade">>
                        <<track "arcade1">>
                    <</createplaylist>>
            <<case "asylum">>
                <<cacheaudio "asylum1" "audio/bgm/asylum/Pulse Burst - The Organization of Society and the Conditions of Health & Safety.mp3">>
                    <<createplaylist "asylum">>
                        <<track "asylum1">>
                    <</createplaylist>>
            <<case "beach">>
                <<cacheaudio "beach1" "audio/bgm/beach/Anthem of Rain - Bad Nostalgia (Instrumental).mp3">>
                    <<createplaylist "beach">>
                        <<track "beach1">>
                    <</createplaylist>>
            <<case "brothel">>
                <<cacheaudio "brothel1" "audio/bgm/brothel/Beat Mekanik - Pink Soul.mp3">>
                    <<createplaylist "brothel">>
                        <<track "brothel1">>
                    <</createplaylist>>
            <<case "cafe">>
                <<cacheaudio "cafe1" "audio/bgm/cafe/Mr Smith - Constance Chill.mp3">>
                    <<createplaylist "cafe">>
                        <<track "cafe1">>
                    <</createplaylist>>
            <<case "dance_studio">>
