:: Audio Widgets [widget]

<<widget "audioInit">>
	/* BGV - voice sounds meant to be played on loop */
	<<cacheaudio "breath_vslow1" "aud/bgv/breath/breath-veryslow01.ogg">>
	<<cacheaudio "breath_vslow2" "aud/bgv/breath/breath-veryslow02.ogg">>
	<<cacheaudio "breath_slow1" "aud/bgv/breath/breath-slow01.ogg">>
	<<cacheaudio "breath_slow2" "aud/bgv/breath/breath-slow02.ogg">>
	<<cacheaudio "breath_slow3" "aud/bgv/breath/breath-slow03.ogg">>
	<<cacheaudio "breath1" "aud/bgv/breath/breath-01.ogg">>
	<<cacheaudio "breath2" "aud/bgv/breath/breath-02.ogg">>
	<<cacheaudio "breath3" "aud/bgv/breath/breath-03.ogg">>
	<<cacheaudio "breath4" "aud/bgv/breath/breath-04.ogg">>
	<<cacheaudio "breath5" "aud/bgv/breath/breath-05.ogg">>
	<<cacheaudio "breath_fast1" "aud/bgv/breath/breath-fast01.ogg">>
	<<cacheaudio "breath_fast2" "aud/bgv/breath/breath-fast02.ogg">>
	<<cacheaudio "breath_fast3" "aud/bgv/breath/breath-fast03.ogg">>
		<<createplaylist "breath_vvslow">>
			<<track "breath_vslow1" volume 0.5>>
			<<track "breath_vslow2" volume 0.5>>
		<</createplaylist>>
		<<createplaylist "breath_vslow">>
			<<track "breath_vslow1" copy>>
			<<track "breath_vslow2" copy>>
		<</createplaylist>>
		<<createplaylist "breath_slow">>
			<<track "breath_slow1">>
			<<track "breath_slow2">>
			<<track "breath_slow3">>
		<</createplaylist>>
		<<createplaylist "breath">>
			<<track "breath1">>
			<<track "breath2">>
			<<track "breath3">>
			<<track "breath4">>
			<<track "breath5">>
		<</createplaylist>>
		<<createplaylist "breath_fast">>
			<<track "breath_fast1">>
			<<track "breath_fast2">>
			<<track "breath_fast3">>
		<</createplaylist>>

	<<cacheaudio "moan_slow1" "aud/bgv/moan/moan-slow01.ogg">>
	<<cacheaudio "moan_slow2" "aud/bgv/moan/moan-slow02.ogg">>
	<<cacheaudio "moan_slow3" "aud/bgv/moan/moan-slow03.ogg">>
	<<cacheaudio "moan_slow4" "aud/bgv/moan/moan-slow04.ogg">>
	<<cacheaudio "moan1" "aud/bgv/moan/moan-01.ogg">>
	<<cacheaudio "moan2" "aud/bgv/moan/moan-02.ogg">>
	<<cacheaudio "moan3" "aud/bgv/moan/moan-03.ogg">>
	<<cacheaudio "moan_fast1" "aud/bgv/moan/moan-fast01.ogg">>
	<<cacheaudio "moan_fast2" "aud/bgv/moan/moan-fast02.ogg">>
	<<cacheaudio "moan_fast3" "aud/bgv/moan/moan-fast03.ogg">>
	<<cacheaudio "moan_fast4" "aud/bgv/moan/moan-fast04.ogg">>
		<<createplaylist "moan_slow">>
			<<track "moan_slow1">>
			<<track "moan_slow2">>
			<<track "moan_slow3">>
			<<track "moan_slow4">>
		<</createplaylist>>
		<<createplaylist "moan">>
			<<track "moan1">>
			<<track "moan2">>
			<<track "moan3">>
		<</createplaylist>>
		<<createplaylist "moan_fast">>
			<<track "moan_fast1">>
			<<track "moan_fast2">>
			<<track "moan_fast3">>
			<<track "moan_fast4">>
		<</createplaylist>>

	<<cacheaudio "chupa_vslow1" "aud/bgv/chupa/chupa-veryslow01.ogg">>
	<<cacheaudio "chupa_slow1" "aud/bgv/chupa/chupa-slow01.ogg">>
	<<cacheaudio "chupa1" "aud/bgv/chupa/chupa-01.ogg">>
	<<cacheaudio "chupa2" "aud/bgv/chupa/chupa-02.ogg">>
	<<cacheaudio "chupa3" "aud/bgv/chupa/chupa-03.ogg">>
	<<cacheaudio "chupa4" "aud/bgv/chupa/chupa-04.ogg">>
	<<cacheaudio "chupa_fast1" "aud/bgv/chupa/chupa-fast01.ogg">>
		<<createplaylist "chupa_vslow">>
			<<track "chupa_vslow1">>
		<</createplaylist>>
		<<createplaylist "chupa_slow">>
			<<track "chupa_slow1">>
		<</createplaylist>>
		<<createplaylist "chupa">>
			<<track "chupa1">>
			<<track "chupa2">>
			<<track "chupa3">>
			<<track "chupa4">>
		<</createplaylist>>
		<<createplaylist "chupa_fast">>
			<<track "chupa_fast1">>
		<</createplaylist>>

	/* VO - voiceovers meant to be played as oneshots */
	<<cacheaudio "chupa_orgasm1" "aud/ve/orgasm/chupa_orgasm01.ogg">>
	<<cacheaudio "chupa_orgasm2" "aud/ve/orgasm/chupa_orgasm02.ogg">>
	<<cacheaudio "chupa_orgasm3" "aud/ve/orgasm/chupa_orgasm03.ogg">>
	<<cacheaudio "breath_orgasm1" "aud/ve/orgasm/breath_orgasm01.ogg">>
	<<cacheaudio "breath_orgasm2" "aud/ve/orgasm/breath_orgasm02.ogg">>
	<<cacheaudio "breath_orgasm3" "aud/ve/orgasm/breath_orgasm03.ogg">>
	<<cacheaudio "breath_orgasm4" "aud/ve/orgasm/breath_orgasm04.ogg">>
	<<cacheaudio "orgasm1" "aud/ve/orgasm/orgasm-01.ogg">>
	<<cacheaudio "orgasm2" "aud/ve/orgasm/orgasm-02.ogg">>
	<<cacheaudio "orgasm3" "aud/ve/orgasm/orgasm-03.ogg">>
	<<cacheaudio "orgasm4" "aud/ve/orgasm/orgasm-04.ogg">>
	<<cacheaudio "orgasm5" "aud/ve/orgasm/orgasm-05.ogg">>
	<<cacheaudio "orgasm6" "aud/ve/orgasm/orgasm-06.ogg">>
		<<set setup.breath_orgasm to [
			"breath_orgasm1",
			"breath_orgasm2",
			"breath_orgasm3",
			"breath_orgasm4"
		]>>
		<<set setup.chupa_orgasm to [
			"chupa_orgasm1",
			"chupa_orgasm2",
			"chupa_orgasm3",
			"chupa_orgasm4"
		]>>
		<<set setup.orgasm to [
			"orgasm1",
			"orgasm2",
			"orgasm3",
			"orgasm4",
			"orgasm5",
			"orgasm6"
		]>>

	/* BGS - sound effects meant to be played on loop */
	<<cacheaudio "sex_slow1" "aud/bgs/sex/slow_heavy1.ogg">>
	<<cacheaudio "sex_slow2" "aud/bgs/sex/slow_heavy2.ogg">>
	<<cacheaudio "sex_slow3" "aud/bgs/sex/slow_normal1.ogg">>
	<<cacheaudio "sex_slow4" "aud/bgs/sex/slow_normal2.ogg">>
	<<cacheaudio "sex_middle1" "aud/bgs/sex/middle_normal.ogg">>
	<<cacheaudio "sex_fast1" "aud/bgs/sex/fast_normal.ogg">>
	<<cacheaudio "sex_fast2" "aud/bgs/sex/fast_normal2.ogg">>
	<<cacheaudio "sex_fast3" "aud/bgs/sex/fast_normal3.ogg">>
	<<cacheaudio "sex_fast4" "aud/bgs/sex/fast_right2.ogg">>
		<<createplaylist "sex_slow">>
			<<track "sex_slow1">>
			<<track "sex_slow2">>
			<<track "sex_slow3">>
			<<track "sex_slow4">>
		<</createplaylist>>
		<<createplaylist "sex_middle">>
			<<track "sex_middle1">>
		<</createplaylist>>
		<<createplaylist "sex_fast">>
			<<track "sex_fast1">>
			<<track "sex_fast2">>
			<<track "sex_fast3">>
			<<track "sex_fast4">>
		<</createplaylist>>

	<<cacheaudio "rub1" "aud/bgs/rub/rub-01.ogg">>
	<<cacheaudio "rub2" "aud/bgs/rub/rub-02.ogg">>
	<<cacheaudio "rub3" "aud/bgs/rub/rub-03.ogg">>
	<<cacheaudio "rub_damp1" "aud/bgs/rub/rub_damp01.ogg">>
	<<cacheaudio "rub_wet1" "aud/bgs/rub/rub_wet01.ogg">>
	<<cacheaudio "rub_wet2" "aud/bgs/rub/rub_wet02.ogg">>
	<<cacheaudio "rub_wet3" "aud/bgs/rub/rub_wet03.ogg">>
	<<cacheaudio "rub_wet4" "aud/bgs/rub/rub_wet04.ogg">>
	<<cacheaudio "rub_wet5" "aud/bgs/rub/rub_wet05.ogg">>
	<<cacheaudio "rub_wet6" "aud/bgs/rub/rub_wet06.ogg">>
		<<createplaylist "rub">>
			<<track "rub1">>
			<<track "rub2">>
			<<track "rub3">>
		<</createplaylist>>
		<<createplaylist "rub_damp">>
			<<track "rub_damp1">>
		<</createplaylist>>
		<<createplaylist "rub_wet">>
			<<track "rub_wet1">>
			<<track "rub_wet2">>
			<<track "rub_wet3">>
			<<track "rub_wet4">>
			<<track "rub_wet5">>
			<<track "rub_wet6">>
		<</createplaylist>>

	<<cacheaudio "rotor_slow1" "aud/bgs/rotor/rotor1_loop.ogg">>
	<<cacheaudio "rotor_fast1" "aud/bgs/rotor/rotor2_loop.ogg">>
	<<cacheaudio "piston_rotor1" "aud/bgs/rotor/piston_vibe_fast.ogg">>
		<<createplaylist "rotor_slow">>
			<<track "rotor_slow1">>
		<</createplaylist>>
		<<createplaylist "rotor_fast">>
			<<track "rotor_fast1">>
		<</createplaylist>>
		<<createplaylist "piston_rotor">>
			<<track "piston_rotor1">>
		<</createplaylist>>

	<<waitforaudio>>

<</widget>>

<<widget "update-audio">>
	<<if $options.audio is 1>>
		/* Lists of relevant states */
		<<set _penisPenetration to ["penetrated", "othervagina", "otheranus"]>>
		<<set _penisRubbing to ["otherhand", "othermouth", "tentacle"]>>
		<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
		<<set _rubbing to ["otherhand", "othermouth", "othervagina"]>>

		<<set _NPCpenetration to ["penis", "otheranus"]>>
		<<set _NPCrubbing to ["lefthand", "righthand"]>>

		/* Consider adding a check for NPC genitals being rubbed/penetrated by checking $NPCList[_n].vagina is "penis" for example, but remember to check if $NPCList[_n].vagina isnot "none"	 */

		/* Update BGS */
		<<if _penetration.includes($vaginastate) or _penetration.includes($anusstate) or _penisPenetration.includes($penisstate)>>
			<<sex-sound>>
		<<elseif _rubbing.includes($vaginastate) or _rubbing.includes($anusstate) or _penisRubbing.includes($penisstate) or $fingersInVagina gte 1>>
			<<rub-sound>>
		<<else>>
			<<bgs "stop">>
		<</if>>

		/* Update BGV */
		<<if $options.voiceoverAudio and $player.sex is "f">>
			<<if _penetration.includes($mouthstate)>>
				<<chupa-voice>>
			<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
				<<sex-voice>>
			<<elseif $arousal gte $arousalmax * 0.1>>
				<<arousal-voice>>
			<<else>>
				<<bgv "stop">>
			<</if>>
		<<else>>
			<<bgv "stop">>
		<</if>>
	
	<<else>>
		<<bgs "stop">>
		<<bgv "stop">>
	<</if>>

<</widget>>

<<widget "bgs">>
	<<if setup.bgsCurrentPlaylist is undefined>>
		<<set setup.bgsCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>
	<<if _args[0] is "stop" and setup.bgsCurrentPlaylist isnot "none">>
		/* Stop the current BGS playlist */
		<<playlist setup.bgsCurrentPlaylist stop>>
		<<set setup.bgsCurrentPlaylist to "none">>
	
	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgsCurrentPlaylist and $voiceoverActive is "f">>
		/* Stop the previous BGS playlist */
		<<if setup.bgsCurrentPlaylist isnot "none">>
			<<playlist setup.bgsCurrentPlaylist stop>>
		<</if>>

		/* Start playing the current BGS playlist */
		<<set setup.bgsCurrentPlaylist to _args[0]>>
		<<playlist setup.bgsCurrentPlaylist volume 0>>
		<<playlist setup.bgsCurrentPlaylist fadein loop shuffle>>

	<</if>>	
<</widget>>

<<widget "bgv">>
	<<if setup.bgvCurrentPlaylist is undefined>>
		<<set setup.bgvCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>
	<<if _args[0] is "stop" and setup.bgvCurrentPlaylist isnot "none">>
		/* Stop the current BGV playlist */
		<<playlist setup.bgvCurrentPlaylist stop>>
		<<set setup.bgvCurrentPlaylist to "none">>

	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgvCurrentPlaylist and ($voiceoverActive is "f" or _args[1] is "override")>>
		/* Stop the previous BGV playlist */
		<<if setup.bgvCurrentPlaylist isnot "none">>
			<<playlist setup.bgvCurrentPlaylist stop>>
		<</if>>

		/* Start playing the current BGV playlist */
		<<set setup.bgvCurrentPlaylist to _args[0]>>
		<<playlist setup.bgvCurrentPlaylist volume 0>>
		<<playlist setup.bgvCurrentPlaylist fadein loop shuffle>>
	
	<</if>>	
<</widget>>

<<widget "voiceover">>
	<<if setup.bgvCurrentPlaylist isnot "none">>
		/* Fade out the BGV */
		<<playlist setup.bgvCurrentPlaylist volume 1>>
		<<playlist setup.bgvCurrentPlaylist fadeout>>
		<<set setup.bgvCurrentPlaylist to "none">>
		<<set $voiceoverActive to "t">>

		<<timed 4500ms>>
			/* Play the voiceover */
			<<audio _args[0][random(0,_args[0].length-1)] play>>
			
			<<if $fingersInVagina gte 1 and setup.bgsCurrentPlaylist isnot "none">>
				<<playlist setup.bgsCurrentPlaylist fadeout>>
				<<set setup.bgsCurrentPlaylist to "none">>
			<</if>>

			<<set $voiceoverActive to "f">>
			
			/* Wait 6 seconds and then resume the BGV */
			<<next 6s>>
				/* <<playlist setup.bgvCurrentPlaylist volume 0 >> */
				/* <<arousal-voice "override">> */
				<<if $player.sex is "f">>
					<<if _penetration.includes($mouthstate)>>
						<<chupa-voice "override">>
					<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
						<<sex-voice "override">>
					<<else>>
						<<arousal-voice "override">>
					<</if>>
				<</if>>

		<</timed>>

	<</if>>
<</widget>>

<<widget "sex-sound">>
	<<if $enemyarousal gte $enemyarousalmax * 0.7>>
		<<bgs "sex_fast">>
	<<elseif $enemyarousal gte $enemyarousalmax * 0.5>>
		<<bgs "sex_middle">>
	<<else>>
		<<bgs "sex_slow">>
	<</if>>
<</widget>>

<<widget "rub-sound">>
	<<if $vaginaArousalWetness gte 10 or $anusWetness gte 10 or $penisWetness gte 10>>
		<<bgs "rub_wet">>
	<<elseif $vaginaArousalWetness gte 5 or $anusWetness gte 5 or $penisWetness gte 5>>
		<<bgs "rub_damp">>
	<<else>>
		<<bgs "rub">>
	<</if>>
<</widget>>

<<widget "chupa-voice">>
	<<if $arousal gte $arousalmax * 0.8>>
		<<bgv "chupa_fast">>
	<<elseif $arousal gte $arousalmax * 0.4 or $orgasmcurrent gte 1>>
		<<bgv "chupa">>
	<<elseif $arousal gte $arousalmax * 0.2>>
		<<bgv "chupa_slow">>
	<<else>>
		<<bgv "chupa_vslow">>
	<</if>>	
<</widget>>

<<widget "sex-voice">>
	<<if $arousal gte $arousalmax * 0.8>>
		<<bgv "moan_fast" _args[0]>>
	<<elseif $arousal gte $arousalmax * 0.4 or $orgasmcurrent gte 1>>
		<<bgv "moan" _args[0]>>
	<<else>>
		<<bgv "moan_slow" _args[0]>>
	<</if>>	
<</widget>>

<<widget "arousal-voice">>
	<<if $arousal gte $arousalmax * 0.8>>
		<<bgv "breath_fast" _args[0]>>
	<<elseif $arousal gte $arousalmax * 0.6 or $orgasmcurrent gte 1>>
		<<bgv "breath" _args[0]>>
	<<elseif $arousal gte $arousalmax * 0.4>>
		<<bgv "breath_slow" _args[0]>>
	<<elseif $arousal gte $arousalmax * 0.2>>
		<<bgv "breath_vslow" _args[0]>>
	<<elseif $arousal gte $arousalmax * 0.1>>
		<<bgv "breath_vvslow" _args[0]>>
	<</if>>	
<</widget>>

<<widget "orgasm-voice">>
	<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
	<<if _penetration.includes($mouthstate)>>
		<<voiceover setup.chupa_orgasm>>
	<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
		<<voiceover setup.orgasm>>
	<<else>>
		<<voiceover setup.breath_orgasm>>
	<</if>>
	
<</widget>>
