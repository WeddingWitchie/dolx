				<<set setup.m_orgasm to [
					"m_orgasm1",
					"m_orgasm2",
					"m_orgasm3"
				]>>

	<</switch>>

	<<run setup.initializedPlaylists.pushUnique(_args[0])>>

<</widget>>

<<widget "update-audio">>
	<<master-audio-update>>
	<<if $options.audio is 1>>
		/* Lists of relevant states */
		<<set _penisPenetration to ["penetrated", "othervagina", "otheranus"]>>
		<<set _penisRubbing to ["otherhand", "othermouth", "tentacle"]>>
		<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
		<<set _rubbing to ["otherhand", "othermouth", "othervagina"]>>
		<<set _NPCrubbing to ["leftarm", "rightarm"]>>
		<<set _vibration to ["mpenisvibrate", "mvaginaclitvibrate", "mvaginaclitvibrateparasite", "mchestvibrate"]>>
		<<set _vibeDildo to ["dildoSelfPussy", "dildoSelfAnus", "dildoOtherPussyFuck", "dildoOtherAnusFuck"]>>
		<<set _machineVibe to ["entrance","imminent","penentrated"]>>

		/* Condition shorthands */
		<<set _beingPenetrated to 
			_penetration.includes($vaginastate) or _penetration.includes($anusstate) or 
			($portalPanties.state.vagina and !$portalPanties.state.vagina.new and !$portalPanties.state.vagina.tempRemoval) or 
			($portalPanties.state.anus and !$portalPanties.state.anus.new and !$portalPanties.state.anus.tempRemoval)
		>>
		<<set _beingVibePenetrated to _vibeDildo.includes($rightaction) or _vibeDildo.includes($leftaction)>>
		<<set _penetrating to _penisPenetration.includes($penisstate)>>
		<<set _beingRubbed to 
			_rubbing.includes($vaginastate) or _rubbing.includes($anusstate) or 
			_penisRubbing.includes($penisstate) or $fingersInVagina gte 1
		>>
		<<set _vibrationEnabled to $machine and 
			(($machine.vaginal and _machineVibe.includes($machine.vaginal.state)) or 
			($machine.anal and _machineVibe.includes($machine.anal.state)))
		>>
		<<for _n = 0; _n lt $NPCList.length; _n++>>
			<<if _NPCrubbing.includes($NPCList[_n].vagina) or _NPCrubbing.includes($NPCList[_n].anus)>>
				<<set _anyNPCRubbed to "t">>
			<<elseif _anyNPCRubbed isnot "t" and _NPCrubbing.includes($NPCList[_n].penis)>>
				<<set _anyNPCRubbed to "penis">>
			<</if>>
		<</for>>

		/* Update BGM */
		<<set _npcWithTheme to ["Ivory Wraith", "Eden", "Avery", "Bailey", "Wren", "Gwylan", "Whitney", "Zephyr", "Kylar", "Robin", "Sydney"]>>
		<<for _name range _npcWithTheme>>
			<<if $NPCList.flatMap((n)=> n.fullDescription).includes(_name)>>
				<<set _npcFound to 1>>
				<<set _nameNoSpace to _name.replace(/\s+/g, "")>>
				<<bgm-intermission _nameNoSpace>>
				<<break>>
			<</if>>
		<</for>>
		<<if _npcFound isnot 1>>
			<<if $combat is 1 or $masturbating is 1>>
				<<if $consensual is 1 or $masturbating is 1>>
					<<bgm-intermission "encounter-consensual">>
				<<else>>
					<<bgm-intermission "encounter-noncon">>
				<</if>>
			<<else>>
				<<switch $location>>
					<<case "town" "flats" "alley" "canals" "police_station" "market" "spa" "chalets" "home" "museum" "docks">>
						<<if Time.dayState is "night" or Time.dayState is "dusk">>
							<<bgm "town-night">>
						<<else>>
							<<bgm "town-day">>
						<</if>>
					<<case "drain" "sewers" "underground">>
						<<bgm "sewers">>
					<<case "farm" "alex_cottage" "alex_farm" "estate">>
						<<if Time.dayState is "night" or Time.dayState is "dusk">>
							<<bgm "farm-night">>
						<<else>>
							<<bgm "farm-day">>
						<</if>>
					<<case "park">>
						<<if Time.dayState is "night" or Time.dayState is "dusk">>
							<<bgm "park-night">>
						<<else>>
							<<bgm "park-day">>
						<</if>>
					<<case "meadow" "coastpath" "riding_school">>
						<<bgm "meadow">>
					<<case "school" "pool">>
						<<if !["early", "late", "earlynoschool", "latenoschool", "daynoschool"].includes($schoolstate)>>
							<<bgm "school">>
						<<else>>
							<<bgm "afterschool">>
						<</if>>
					<<case "forest" "lake" "bog" "wolf_cave" "churchyard" "lake_ruin">>
						<<bgm "forest">>
					<<case "sea" "seabeach" "searocks" "seacliffs" "pirate_ship">>
						<<bgm "sea">>
					<<case "old_temple">>
						<<if ["cell","guardhouse"].includes($bus)>>
							<<bgm "sewers">>
						<<else>>
							<<bgm "old_temple">> 
						<</if>>
					<<case "pub" "beach" "asylum" "office" "arcade" "brothel" "cafe" "dance_studio" "shopping_centre" "mma_gym" "studio" "strip_club" "temple" "moor" "hospital" "island" "meadow" "tentworld" "prison" "home">>
						<<bgm $location>>
					<<case "forest_shop">>
						<<bgm "Gwylan">>
					<<default>>
						<<bgm "stop">>
				<</switch>>
			<</if>>
		<<else>>
			<<if $combat is 1>>
				<<if $consensual isnot 1>>
					<<bgm-intermission "encounter-noncon">>
				<</if>>
			<</if>>
		<</if>>

		/* Consider adding a check for NPC genitals being rubbed/penetrated by checking $NPCList[_n].vagina is "penis" for example, but remember to check if $NPCList[_n].vagina isnot "none"	 */

		/* Update BGS */
		<<if _beingPenetrated or _penetrating or $vaginause is "mdildopenetrate" or $anususe is "mdildopenetrate">>
			<<sex-sound>>
		<<elseif _beingRubbed>>
			<<rub-sound>>
		<<elseif _anyNPCRubbed>>  <!-- This feels weird if you can't hear the NPC orgasm -->
			<<rub-sound _anyNPCRubbed>>
		<<else>>
			<<bgs "stop">>
		<</if>>

		/* Update BGV */
		<<if $options.voiceoverAudio and ($player.gender_posture is "f" or ($player.sex is "f" and $player.gender_posture is "n"))>>
			<<if _penetration.includes($mouthstate) or $portalPanties.state.mouth isnot undefined>>
				<<chupa-voice>>
			<<elseif _beingPenetrated>>
				<<sex-voice>>
			<<elseif $arousal gte $arousalmax * 0.1>>
				<<arousal-voice>>
			<<else>>
				<<bgv "stop">>
			<</if>>
		<<elseif $options.voiceoverAudio and ($player.gender_posture is "m" or ($player.sex is "m" and $player.gender_posture is "n"))>>
			<<if $arousal gte $arousalmax * 0.1>>
				<<arousal-voice>>
			<<else>>
				<<bgv "stop">>
			<</if>>
		<<else>>
			<<bgv "stop">>
		<</if>>
	
	<<else>>
		<<bgm "stop">>
		<<bgs "stop">>
		<<bgv "stop">>
	<</if>>

<</widget>>

<<widget "master-audio-update">>
	<<if $options.muteonhide>>
		<<masteraudio muteonhide>>
	<<else>>
		<<masteraudio nomuteonhide>>
	<</if>>
	<<masteraudio volume `$options.mastervolume ?? 0`>>
	<<if setup.bgmCurrentPlaylist isnot "none" and setup.bgmCurrentPlaylist isnot undefined>>
		<<playlist setup.bgmCurrentPlaylist volume `$options.bgm_volume ?? 1`>>
	<</if>>
	<<if setup.bgsCurrentPlaylist isnot "none" and setup.bgsCurrentPlaylist isnot undefined>>
		<<playlist setup.bgsCurrentPlaylist volume `$options.bgs_volume ?? 1`>>
	<</if>>
	<<if setup.bgvCurrentPlaylist isnot "none" and setup.bgvCurrentPlaylist isnot undefined>>
		<<playlist setup.bgvCurrentPlaylist volume `$options.voice_volume ?? 1`>>
	<</if>>
<</widget>>

<<widget "bgm">>
	<<run console.log("Now playing: "+_args[0])>>
	<<if setup.bgmCurrentPlaylist is undefined>>
		<<set setup.bgmCurrentPlaylist to "none">>
	<</if>>

	<<if _args[0] is "stop" and setup.bgmCurrentPlaylist isnot "none">>
		/* Stop the current BGM playlist */
		<<playlist setup.bgmCurrentPlaylist stop>>
		<<set setup.bgmCurrentPlaylist to "none">>
	
	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgmCurrentPlaylist>>
		/* Stop the previous BGM playlist */
		<<if setup.bgmCurrentPlaylist isnot "none">>
			<<playlist setup.bgmCurrentPlaylist stop>>
		<</if>>

		/* Start playing the current BGM playlist */
		<<set setup.bgmCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgmCurrentPlaylist>>
		<<playlist setup.bgmCurrentPlaylist volume 0>>
		<<playlist setup.bgmCurrentPlaylist fadeto $options.bgm_volume loop shuffle>>
		
	<</if>>	
<</widget>>

<<widget "bgm-intermission">>
	<<run console.log("Now playing: "+_args[0])>>
	<<if setup.bgmCurrentPlaylist is undefined>>
		<<set setup.bgmCurrentPlaylist to "none">>
	<</if>>

	<<if _args[0] isnot setup.bgmCurrentPlaylist>>
		/* Pause the previous BGM playlist */
		<<if setup.bgmCurrentPlaylist isnot "none">>
			<<playlist setup.bgmCurrentPlaylist pause>>
		<</if>>

		/* Start playing the intermission BGM playlist */
		<<set setup.bgmCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgmCurrentPlaylist>>
		<<playlist setup.bgmCurrentPlaylist volume $options.bgm_volume>>
		<<playlist setup.bgmCurrentPlaylist play loop shuffle>>
		
	<</if>>	
<</widget>>

<<widget "bgs">>
	<<if setup.bgsCurrentPlaylist is undefined>>
		<<set setup.bgsCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>

	<<if _args[0] is "stop" and setup.bgsCurrentPlaylist isnot "none">>
		/* Stop the current BGS playlist */
		<<playlist setup.bgsCurrentPlaylist stop>>
		<<set setup.bgsCurrentPlaylist to "none">>
	
	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgsCurrentPlaylist and $voiceoverActive is "f">>
		/* Stop the previous BGS playlist */
		<<if setup.bgsCurrentPlaylist isnot "none">>
			<<playlist setup.bgsCurrentPlaylist stop>>
		<</if>>

		/* Start playing the current BGS playlist */
		<<set setup.bgsCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgsCurrentPlaylist>>
		<<playlist setup.bgsCurrentPlaylist volume 0>>
		<<playlist setup.bgsCurrentPlaylist fadeto $options.bgs_volume loop shuffle>>
		
	<</if>>	
<</widget>>

<<widget "bgv">>
	<<if setup.bgvCurrentPlaylist is undefined>>
		<<set setup.bgvCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>
	<<if _args[0] is "stop" and setup.bgvCurrentPlaylist isnot "none">>
		/* Stop the current BGV playlist */
		<<playlist setup.bgvCurrentPlaylist stop>>
		<<set setup.bgvCurrentPlaylist to "none">>

	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgvCurrentPlaylist and ($voiceoverActive is "f" or _args[1] is "override")>>
		/* Stop the previous BGV playlist */
		<<if setup.bgvCurrentPlaylist isnot "none">>
			<<playlist setup.bgvCurrentPlaylist stop>>
		<</if>>

		/* Start playing the current BGV playlist */
		<<set setup.bgvCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgvCurrentPlaylist>>
		<<playlist setup.bgvCurrentPlaylist volume 0>>
		<<playlist setup.bgvCurrentPlaylist fadeto $options.voice_volume loop shuffle>>
	
	<</if>>	
<</widget>>

<<widget "voiceover">>
	<<if ($options.audio is 1 and $options.voiceoverAudio is 1) and _args[1] is undefined and setup.bgvCurrentPlaylist isnot "none">>
		/* Fade out the BGV */
		<<playlist setup.bgvCurrentPlaylist volume 1>>
		<<playlist setup.bgvCurrentPlaylist fadeout>>
		<<set setup.bgvCurrentPlaylist to "none">>
		<<set $voiceoverActive to "t">>

		<<timed 3000ms>>
			/* Play the voiceover */
			<<set _VOList to _args[0]>>
			<<audio _VOList[random(0,_args[0].length-1)] play volume $options.voice_volume>>
			
			<<if $fingersInVagina gte 1 and setup.bgsCurrentPlaylist isnot "none">>
				<<playlist setup.bgsCurrentPlaylist fadeout>>
				<<set setup.bgsCurrentPlaylist to "none">>
			<</if>>

			<<set $voiceoverActive to "f">>
			
			/* Wait 6 seconds and then resume the BGV */
			<<next 6s>>
				/* <<playlist setup.bgvCurrentPlaylist volume 0 >> */
				/* <<arousal-voice "override">> */
				<<if ($player.gender_posture is "f" or ($player.sex is "f" and $player.gender_posture is "n"))>>
					<<if _penetration.includes($mouthstate)>>
						<<chupa-voice "override">>
					<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
						<<sex-voice "override">>
					<<else>>
						<<arousal-voice "override">>
					<</if>>
				<<elseif ($player.gender_posture is "m" or ($player.sex is "m" and $player.gender_posture is "n"))>>
					<<arousal-voice "override">>
				<</if>>

		<</timed>>
	
	<<elseif ($options.audio is 1 and $options.voiceoverAudio is 1) and (_args[1] is "npc_f" or _args[1] is "npc_m")>>
		<<set _VOList to _args[0]>>
		<<audio _VOList[random(0,_args[0].length-1)] play volume `0.7 * $options.bgs_volume`>>
	<</if>>
<</widget>>

<<widget "ejaculation-sound">>
	<<if ($options.audio is 1 and $options.voiceoverAudio is 1)>>
