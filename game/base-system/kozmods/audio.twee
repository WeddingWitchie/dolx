				<<init-playlist "chupa_orgasm">>
				<<voiceover setup.chupa_orgasm>>
			<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
				<<init-playlist "orgasm">>
				<<voiceover setup.orgasm>>
			<<else>>
				<<init-playlist "breath_orgasm">>
				<<voiceover setup.breath_orgasm>>
			<</if>>
		<<elseif ($player.gender_posture is "m" or ($player.sex is "m" and $player.gender_posture is "n"))>>
			<<init-playlist "m_orgasm">>
			<<voiceover setup.m_orgasm>>
			<<ejaculation-sound>>
		<</if>>
	<<else>>
		<<if _args[0] is "npc_f">>
			<<init-playlist "breath_orgasm">>
			<<voiceover setup.breath_orgasm _args[0]>>
		<<elseif _args[0] is "npc_m">>
			<<init-playlist "m_orgasm">>
			<<voiceover setup.m_orgasm _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "npc-orgasm-voice">>
	<!-- Count males and females to decide which orgasm voice to play -->
	<<set _femaleCount to 0>><<set _maleCount to 0>>
	<<set _anyMale to false>>
	<<for _n=0; _n lt $NPCList.length; _n++>>
		<<if $NPCList[_n].pronoun is "f">>
			<<set _femaleCount++>>
		<<elseif $NPCList[_n].pronoun is "m">>
			<<set _maleCount++>>
			<<set _anyMale to true>>
		<</if>>
	<</for>>

	<<if _femaleCount gte _maleCount>>
		/* <<set $enemyarousal to $enemyarousalmax * (1/3) + random(0,$enemyarousalmax*(1/3)-1)>> */
		<<orgasm-voice "npc_f">>
	<<else>>
		/* <<set $enemyarousal to 0>> */
		<<orgasm-voice "npc_m">>
	<</if>>
	<<if _anyMale>><<ejaculation-sound>><</if>>
<</widget>>
