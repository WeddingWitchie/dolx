:: Audio Widgets [widget]

<<widget "update-audio">>
	<<master-audio-update>>
	<<if $options.audio is 1>>
		/* Lists of relevant states */
		<<set _penisPenetration to ["penetrated", "othervagina", "otheranus"]>>
		<<set _penisRubbing to ["otherhand", "othermouth", "tentacle"]>>
		<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
		<<set _rubbing to ["otherhand", "othermouth", "othervagina"]>>
		<<set _NPCrubbing to ["leftarm", "rightarm"]>>
		<<set _vibration to ["mpenisvibrate", "mvaginaclitvibrate", "mvaginaclitvibrateparasite", "mchestvibrate"]>>
		<<set _vibeDildo to ["dildoSelfPussy", "dildoSelfAnus", "dildoOtherPussyFuck", "dildoOtherAnusFuck"]>>
		<<set _machineVibe to ["entrance","imminent","penetrated"]>>

		/* Condition shorthands */
		<<set _beingPenetrated to
			_penetration.includes($vaginastate) or _penetration.includes($anusstate) or 
			($portalPanties.state.vagina and !$portalPanties.state.vagina.new and !$portalPanties.state.vagina.tempRemoval) or 
			($portalPanties.state.anus and !$portalPanties.state.anus.new and !$portalPanties.state.anus.tempRemoval)
		>>
		<<set _beingVibePenetrated to _vibeDildo.includes($rightaction) or _vibeDildo.includes($leftaction)>>
		<<set _penetrating to _penisPenetration.includes($penisstate)>>
		<<set _beingRubbed to 
			_rubbing.includes($vaginastate) or _rubbing.includes($anusstate) or 
			_penisRubbing.includes($penisstate) or $fingersInVagina gte 1
		>>
		<<set _vibrationEnabled to $machine and 
			(($machine.vaginal and _machineVibe.includes($machine.vaginal.state)) or 
			($machine.anal and _machineVibe.includes($machine.anal.state)))
		>>
		<<for _n = 0; _n lt $NPCList.length; _n++>>
			<<if $NPCList[_n] and $NPCList[_n].vagina isnot undefined and $NPCList[_n].anus isnot undefined>>
			<<if _NPCrubbing.includes($NPCList[_n].vagina) or _NPCrubbing.includes($NPCList[_n].anus)>>
				<<set _anyNPCRubbed to "t">>
			<<elseif _anyNPCRubbed isnot "t" and $NPCList[_n].penis isnot undefined and _NPCrubbing.includes($NPCList[_n].penis)>>
				<<set _anyNPCRubbed to "penis">>
			<</if>>
			<</if>>
		<</for>>

		/* Update BGM */
		<<set _npcWithTheme to ["Ivory Wraith", "Eden", "Avery", "Bailey", "Wren", "Gwylan", "Whitney", "Zephyr", "Kylar", "Robin", "Sydney", "Poppy"]>>
		<<set _npcDescriptions to $NPCList.flatMap((n)=> n.fullDescription)>>
		<<for _name range _npcWithTheme>>
			<<if _npcDescriptions.includes(_name)>>
				<<set _npcFound to 1>>
				<<set _npcTheme to _name.replace(/\s+/g, "")>>
				<<break>>
			<</if>>
		<</for>>
		<<if $combat is 1 and $consensual isnot 1>>
			<<bgm-intermission "encounter-noncon">>
		<<elseif _npcFound is 1>>
			<<bgm-intermission _npcTheme>>
		<<elseif $combat is 1 or $masturbating is 1>>
			<<bgm-intermission "encounter-consensual">>
		<<else>>
			<<switch $location>>
				<<case "town" "alley" "canals" "canal" "police_station" "market" "spa" "chalets" "home" "museum" "docks" "avery_mansion" "landfill" "compound" "factory" "pound" "townhall" "kylarmanor_outside" "kylarmanor_grounds" "industrial">>
					<<if Time.dayState is "night" or Time.dayState is "dusk">>
						<<bgm "town-night">>
					<<else>>
						<<bgm "town-day">>
					<</if>>
				<<case "flats">>
					<<bgm "cafe">>
				<<case "drain" "sewers" "underground" "catacombs" "sepulchre" "mines" "kylarmanor">>
					<<bgm "sewers">>
				<<case "farm" "alex_cottage" "alex_farm" "estate" "farm_manors">>
					<<if Time.dayState is "night" or Time.dayState is "dusk">>
						<<bgm "farm-night">>
					<<else>>
						<<bgm "farm-day">>
					<</if>>
				<<case "park">>
					<<if Time.dayState is "night" or Time.dayState is "dusk">>
						<<bgm "park-night">>
					<<else>>
						<<bgm "park-day">>
					<</if>>
				<<case "meadow" "coastpath" "riding_school" "farmroad3">>
					<<bgm "meadow">>
				<<case "school" "pool" "school_rear_courtyard">>
					<<if !["early", "late", "earlynoschool", "latenoschool", "daynoschool"].includes($schoolstate)>>
						<<bgm "school">>
					<<else>>
						<<bgm "afterschool">>
					<</if>>
				<<case "forest" "lake" "bog" "wolf_cave" "churchyard" "lake_ruin" "cabin" "lake_office">>
					<<bgm "forest">>
				<<case "sea" "seabeach" "searocks" "seacliffs" "pirate_ship" "prison_beach">>
					<<bgm "sea">>
				<<case "old_temple">>
					<<if ["cell","guardhouse"].includes($bus)>>
						<<bgm "sewers">>
					<<else>>
						<<bgm "old_temple">>
					<</if>>
				<<case "tower" "moor" "castle">>
					<<bgm "moor">>
				<<case "adult_shop" "brothel">>
					<<bgm "brothel">>
				<<case "officeBuilding" "office" "office_building">>
					<<bgm "office">>
				<<case "shopping_centre" "changingroom">>
					<<bgm "shopping_centre">>
				<<case "pub" "beach" "asylum" "arcade" "cafe" "dance_studio" "shopping_centre" "mma_gym" "studio" "strip_club" "temple" "hospital" "island" "meadow" "tentworld" "prison" "home">>
					<<bgm $location>>
				<<case "forest_shop" "forest_shop_garden">>
					<<bgm "Gwylan">>
				<<case "avery_skyscraper">>
					<<bgm "Avery">>
				<<default>>
					<<bgm "stop">>
			<</switch>>
		<</if>>

		/* Consider adding a check for NPC genitals being rubbed/penetrated by checking $NPCList[_n].vagina is "penis" for example, but remember to check if $NPCList[_n].vagina isnot "none"	 */

		/* Update BGS */
		<<if _beingPenetrated or _penetrating or $vaginause is "mdildopenetrate" or $anususe is "mdildopenetrate">>
			<<sex-sound>>
		<<elseif _beingRubbed>>
			<<rub-sound>>
		<<elseif _anyNPCRubbed>>  <!-- This feels weird if you can't hear the NPC orgasm -->
			<<rub-sound _anyNPCRubbed>>
		<<else>>
			<<bgs "stop">>
		<</if>>

		/* Update BGV - voice path resolved by playerVoiceSettings() (sex + posture + herm + per-category config) */
		<<if $options.voiceoverAudio and playerVoiceIsFemale()>>
			<<if _penetration.includes($mouthstate) or $mouthstate is "kiss" or $portalPanties.state.mouth isnot undefined>>
				<<chupa-voice>>
			<<elseif _beingPenetrated>>
				<<sex-voice>>
			<<elseif $pleasure gte $pleasuremax * 0.1>>
				<<arousal-voice>>
			<<else>>
				<<bgv "stop">>
			<</if>>
		<<elseif $options.voiceoverAudio and playerVoiceIsMale()>>
			<<if $pleasure gte $pleasuremax * 0.1>>
				<<arousal-voice>>
			<<else>>
				<<bgv "stop">>
			<</if>>
		<<else>>
			<<bgv "stop">>
		<</if>>
	
	<<else>>
		<<bgm "stop">>
		<<bgs "stop">>
		<<bgv "stop">>
		/* Failsafe: kill any orphaned loops (e.g. playlists started before a save load) */
		<<masteraudio stop>>
	<</if>>

<</widget>>

<<widget "master-audio-update">>
	<<if $options.npcVoiceoverAudio is undefined>><<set $options.npcVoiceoverAudio to 1>><</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
			<<set $voiceoverActiveSince to 0>>
	<</if>>
	<<if $voiceoverActiveSince is undefined>>
		<<set $voiceoverActiveSince to 0>>
	<</if>>
	<<if $voiceoverActive is "t" and $voiceoverActiveSince gt 0 and (Date.now() - $voiceoverActiveSince) > 8000>>
		<<set $voiceoverActive to "f">>
		<<set $voiceoverActiveSince to 0>>
	<</if>>
	<<if $options.muteonhide>>
		<<masteraudio muteonhide>>
	<<else>>
		<<masteraudio nomuteonhide>>
	<</if>>
	<<masteraudio volume `$options.mastervolume ?? 0`>>
	<<if setup.bgmCurrentPlaylist isnot "none" and setup.bgmCurrentPlaylist isnot undefined>>
		<<playlist setup.bgmCurrentPlaylist volume `$options.bgm_volume ?? 1`>>
	<</if>>
	<<if setup.bgsCurrentPlaylist isnot "none" and setup.bgsCurrentPlaylist isnot undefined>>
		<<playlist setup.bgsCurrentPlaylist volume `$options.bgs_volume ?? 1`>>
	<</if>>
	<<if setup.bgvCurrentPlaylist isnot "none" and setup.bgvCurrentPlaylist isnot undefined>>
		<<init-playlist setup.bgvCurrentPlaylist>>
		<<if SimpleAudio.lists.has(setup.bgvCurrentPlaylist)>>
			<<playlist setup.bgvCurrentPlaylist volume `$options.voice_volume ?? 1`>>
		<</if>>
	<</if>>
<</widget>>

<<widget "audio-release-playlist">>
	<<if _args[0] isnot undefined and _args[0] isnot "none" and SimpleAudio.lists.has(_args[0])>>
		<<playlist _args[0] stop>>
		<<playlist _args[0] unload>>
		<<removeplaylist _args[0]>>
		<<run setup.initializedPlaylists.delete(_args[0])>>
	<</if>>
<</widget>>

<<widget "bgm">>
	<<if $debug is 1>><<run console.log("Now playing: "+_args[0])>><</if>>
	<<if setup.bgmCurrentPlaylist is undefined>>
		<<set setup.bgmCurrentPlaylist to "none">>
	<</if>>
	<<if setup.bgmPausedPlaylist is undefined>>
		<<set setup.bgmPausedPlaylist to "none">>
	<</if>>

	<<if _args[0] is "stop">>
		/* Release both the current theme and any ambient theme paused by an intermission. */
		<<audio-release-playlist setup.bgmCurrentPlaylist>>
		<<if setup.bgmPausedPlaylist isnot setup.bgmCurrentPlaylist>>
			<<audio-release-playlist setup.bgmPausedPlaylist>>
		<</if>>
		<<set setup.bgmCurrentPlaylist to "none">>
		<<set setup.bgmPausedPlaylist to "none">>
	
	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgmCurrentPlaylist>>
		<<if _args[0] is setup.bgmPausedPlaylist>>
			/* Resume the exact ambient track paused for the intermission. */
			<<audio-release-playlist setup.bgmCurrentPlaylist>>
			<<set setup.bgmCurrentPlaylist to setup.bgmPausedPlaylist>>
			<<set setup.bgmPausedPlaylist to "none">>
			<<playlist setup.bgmCurrentPlaylist volume $options.bgm_volume>>
			<<playlist setup.bgmCurrentPlaylist play loop>>
		<<else>>
			/* A real location change supersedes both the active and paused themes. */
			<<audio-release-playlist setup.bgmCurrentPlaylist>>
			<<if setup.bgmPausedPlaylist isnot setup.bgmCurrentPlaylist>>
				<<audio-release-playlist setup.bgmPausedPlaylist>>
			<</if>>
			<<set setup.bgmCurrentPlaylist to _args[0]>>
			<<set setup.bgmPausedPlaylist to "none">>
			<<init-playlist setup.bgmCurrentPlaylist>>
			<<playlist setup.bgmCurrentPlaylist volume $options.bgm_volume>>
			<<playlist setup.bgmCurrentPlaylist play loop shuffle>>
		<</if>>
	<</if>>	
<</widget>>

<<widget "bgm-intermission">>
	<<if $debug is 1>><<run console.log("Now playing: "+_args[0])>><</if>>
	<<if setup.bgmCurrentPlaylist is undefined>>
		<<set setup.bgmCurrentPlaylist to "none">>
	<</if>>
	<<if setup.bgmPausedPlaylist is undefined>>
		<<set setup.bgmPausedPlaylist to "none">>
	<</if>>

	<<if _args[0] isnot setup.bgmCurrentPlaylist>>
		/* Preserve one ambient theme. Superseded intermission themes are released. */
		<<if setup.bgmPausedPlaylist is "none" and setup.bgmCurrentPlaylist isnot "none">>
			<<set setup.bgmPausedPlaylist to setup.bgmCurrentPlaylist>>
			<<playlist setup.bgmCurrentPlaylist pause>>
		<<else>>
			<<audio-release-playlist setup.bgmCurrentPlaylist>>
		<</if>>

		/* Start playing the intermission BGM playlist */
		<<set setup.bgmCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgmCurrentPlaylist>>
		<<playlist setup.bgmCurrentPlaylist volume $options.bgm_volume>>
		<<playlist setup.bgmCurrentPlaylist play loop shuffle>>
	<</if>>	
<</widget>>

<<widget "bgs">>
	<<if setup.bgsCurrentPlaylist is undefined>>
		<<set setup.bgsCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>

	<<if _args[0] is "stop" and setup.bgsCurrentPlaylist isnot "none">>
		/* Stop the current BGS playlist */
		<<audio-release-playlist setup.bgsCurrentPlaylist>>
		<<set setup.bgsCurrentPlaylist to "none">>
	
	<<elseif _args[0] isnot "stop" and _args[0] isnot setup.bgsCurrentPlaylist and $voiceoverActive is "f">>
		/* Release the previous BGS playlist. */
		<<audio-release-playlist setup.bgsCurrentPlaylist>>

		/* Start playing the current BGS playlist */
		<<set setup.bgsCurrentPlaylist to _args[0]>>
		<<init-playlist setup.bgsCurrentPlaylist>>
		<<playlist setup.bgsCurrentPlaylist volume $options.bgs_volume>>
		<<playlist setup.bgsCurrentPlaylist play loop shuffle>>
	<</if>>	
<</widget>>

<<widget "bgv-halt-current">>
	<<if setup.bgvCurrentPlaylist isnot undefined and setup.bgvCurrentPlaylist isnot "none">>
		<<init-playlist setup.bgvCurrentPlaylist>>
		<<if SimpleAudio.lists.has(setup.bgvCurrentPlaylist)>>
			<<audio-release-playlist setup.bgvCurrentPlaylist>>
		<</if>>
	<</if>>
	<<set setup.bgvCurrentPlaylist to "none">>
<</widget>>

<<widget "bgv">>
	<<if setup.bgvCurrentPlaylist is undefined>>
		<<set setup.bgvCurrentPlaylist to "none">>
	<</if>>
	<<if $voiceoverActive is undefined>>
		<<set $voiceoverActive to "f">>
	<</if>>
	/* Resolve the player's current voice (sex + posture + herm + per-category config) */
	<<set _vs to playerVoiceSettings()>>

	/* Build the full (prefixed) playlist name up front so the change-detection below compares like with like.
	The old code compared the unprefixed _args[0] (e.g. "moan") against the prefixed tracker (e.g. "v1_moan"), which never matched, so the BGV restarted on every passage.
	Male voice playlists already arrive prefixed ("m_breath"), so only the female set ("v1"/"v2") gets a prefix here. */
	<<set _bgvTarget to "stop">>
	<<if _args[0] isnot "stop">>
		<<set _prefix to "">>
		<<if _vs.enabled and (_vs.voice is "v1" or _vs.voice is "v2")>>
			<<set _prefix += _vs.voice + "_">>
			<<if _vs.voice is "v2">>
				<<if $mouthuse is "gagged">>
					<<set _prefix += "gagged_">>
				<<elseif $consensual isnot 1>>
					<<set _prefix += "noncon_">>
				<</if>>
			<</if>>
		<</if>>
		<<set _bgvTarget to _prefix + _args[0]>>
	<</if>>

	<<if _args[0] is "stop" and setup.bgvCurrentPlaylist isnot "none">>
		/* Stop the current BGV playlist */
		<<bgv-halt-current>>
	<<elseif _args[0] isnot "stop" and _bgvTarget isnot setup.bgvCurrentPlaylist and ($voiceoverActive is "f" or _args[1] is "override")>>
		/* Stop the previous BGV playlist */
		<<bgv-halt-current>>

		/* Start playing the current BGV playlist */
		<<set setup.bgvCurrentPlaylist to _bgvTarget>>
		<<init-playlist setup.bgvCurrentPlaylist>>
		<<playlist setup.bgvCurrentPlaylist volume $options.voice_volume>>
		<<playlist setup.bgvCurrentPlaylist play loop shuffle>>
	<</if>>	
<</widget>>

<<widget "voiceover">>
	<<if ($options.audio is 1 and $options.voiceoverAudio is 1) and _args[1] is undefined>>
		/* Stop and release the BGV before the one-shot voiceover. */
		<<if setup.bgvCurrentPlaylist isnot "none" and setup.bgvCurrentPlaylist isnot undefined>>
			<<bgv-halt-current>>
		<</if>>
		<<set $voiceoverActiveSince to Date.now()>>
		<<set $voiceoverActive to "t">>

		<<timed 3000ms>>
			/* Play the voiceover (dedupe) */
			<<set _nowVO to Date.now()>>
			<<if $lastPlayerVoiceoverPlayAt is undefined>><<set $lastPlayerVoiceoverPlayAt to 0>><</if>>
			<<if $lastPlayerVoiceoverOrgasmcurrent is undefined>><<set $lastPlayerVoiceoverOrgasmcurrent to -1>><</if>>

			<<set _dupeVO to ((_nowVO - $lastPlayerVoiceoverPlayAt lt 1500) or (($orgasmcurrent is $lastPlayerVoiceoverOrgasmcurrent) and (_nowVO - $lastPlayerVoiceoverPlayAt lt 8000)))>>

			<<if _dupeVO is false>>
				<<set $lastPlayerVoiceoverPlayAt to _nowVO>>
				<<set $lastPlayerVoiceoverOrgasmcurrent to $orgasmcurrent>>
				<<set _VOList to _args[0]>>
				<<set _clip to _VOList[random(0,_VOList.length-1)]>>
				<<audio _clip play volume $options.voice_volume>>
			<</if>>
			
			<<if $fingersInVagina gte 1 and setup.bgsCurrentPlaylist isnot "none">>
				<<audio-release-playlist setup.bgsCurrentPlaylist>>
				<<set setup.bgsCurrentPlaylist to "none">>
			<</if>>

			<<set $voiceoverActive to "f">>
			
			/* Wait 6 seconds and then resume the BGV */
			<<next 6s>>
				<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
				/* <<playlist setup.bgvCurrentPlaylist volume 0 >> */
				/* <<arousal-voice "override">> */
				<<if playerVoiceIsFemale()>>
					<<if _penetration.includes($mouthstate)>>
						<<chupa-voice "override">>
					<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
						<<sex-voice "override">>
					<<else>>
						<<arousal-voice "override">>
					<</if>>
				<<elseif playerVoiceIsMale()>>
					<<arousal-voice "override">>
				<</if>>
		<</timed>>

		<<elseif ($options.audio is 1) and (_args[1] is "npc_f" or _args[1] is "npc_m") and npcVoiceAllowed(_args[1] is "npc_f" ? "f" : "m")>>
		<<set _VOList to _args[0]>>
		<<set _npc_volume to _args[1] is "npc_f"? 1 : 0.8>>
		<<audio _VOList[random(0,_args[0].length-1)] play volume `_npc_volume * $options.voice_volume`>>
	<</if>>
<</widget>>

<<widget "ejaculation-sound">>
	<<if $options.audio is 1 and ((_args[0] is "npc" and npcVoiceAllowed("m")) or (_args[0] isnot "npc" and $options.voiceoverAudio is 1))>>
		<<init-playlist "squirt">>
		<<audio `"squirt"+random(1,4)` play volume `0.8 * $options.bgs_volume`>>
		<<timed 1000ms>>
		<<audio `"squirt"+random(1,4)` play volume `0.8 * $options.bgs_volume`>>
		<</timed>>
		<<timed 2000ms>>
		<<audio `"squirt"+random(1,4)` play volume `0.8 * $options.bgs_volume`>>
		<</timed>>
	<</if>>
<</widget>>

<<widget "sex-sound">>
	<<if $portalPanties.state.vagina or $portalPanties.state.anus>>
		<<set _portalArousalLevel to Math.min($portalPanties.state.vagina?.timer || 100, $portalPanties.state.anus?.timer || 100) / 6>>
		<<if _portalArousalLevel gte 4>>
			<<set _animspeed to "mid">>
		<<elseif _portalArousalLevel gte 3>>
			<<set _animspeed to "fast">>
		<<else>>
			<<set _animspeed to "vfast">>
		<</if>>
	<</if>>
	<<if _animspeed is "vfast" or $enemypleasure gte $enemypleasuremax * 0.7>>
		<<bgs "sex_fast">>
	<<elseif _animspeed is "fast" or $enemypleasure gte $enemypleasuremax * 0.5>>
		<<bgs "sex_middle">>
	<<else>>
		<<bgs "sex_slow">>
	<</if>>
<</widget>>

<<widget "rub-sound">>
	<<if _args[0] is undefined>>
		<<if $vaginaArousalWetness gte 10 or $anusWetness gte 10 or $penisWetness gte 10>>
			<<bgs "rub_wet">>
		<<elseif $vaginaArousalWetness gte 5 or $anusWetness gte 5 or $penisWetness gte 5>>
			<<bgs "rub_damp">>
		<<else>>
			<<bgs "rub">>
		<</if>>
	<<elseif _args[0] is "penis">>
		<<bgs "rub">>
	<<else>>
		<<if $enemyarousal gte ($enemyarousalmax * (2/3))>>
			<<bgs "rub_wet">>
		<<elseif $enemyarousal gte ($enemyarousalmax * (1/3))>>
			<<bgs "rub_damp">>
		<<else>>
			<<bgs "rub">>
		<</if>>
	<</if>>
<</widget>>

<<widget "vibe-sound">>
	<<if _args[0] is "piston">>
		<<bgs "piston_rotor">>
	<<elseif $pleasure gte ($pleasuremax * 0.5)>>
		<<bgs "rotor_fast">>
	<<else>>
		<<bgs "rotor_slow">>
	<</if>>
<</widget>>

<<widget "chupa-voice">>
	<<if $pleasure gte $pleasuremax * 0.8>>
		<<bgv "chupa_fast">>
	<<elseif $pleasure gte $pleasuremax * 0.4 or $orgasmcurrent gte 1>>
		<<bgv "chupa">>
	<<elseif $pleasure gte $pleasuremax * 0.2>>
		<<bgv "chupa_slow">>
	<<else>>
		<<bgv "chupa_vslow">>
	<</if>>	
<</widget>>

<<widget "sex-voice">>
	<<if $pleasure gte $pleasuremax * 0.8>>
		<<bgv "moan_fast" _args[0]>>
	<<elseif $pleasure gte $pleasuremax * 0.4 or $orgasmcurrent gte 1>>
		<<bgv "moan" _args[0]>>
	<<elseif $pleasure gte $pleasuremax * 0.2>>
		<<bgv "moan_slow" _args[0]>>
	<<else>>
		<<bgv "chupa_vslow">>
	<</if>>	
<</widget>>

<<widget "arousal-voice">>
	/* Local rub detection so this widget is safe to call from anywhere */
	<<set _penisRubbingLocal to ["otherhand", "othermouth", "tentacle"]>>
	<<set _rubbingLocal to ["otherhand", "othermouth", "othervagina"]>>
	<<set _beingRubbedLocal to _rubbingLocal.includes($vaginastate) or _rubbingLocal.includes($anusstate) or _penisRubbingLocal.includes($penisstate) or $fingersInVagina gte 1>>

	<<if playerVoiceIsFemale()>>
		<<if $pleasure gte $pleasuremax * 0.8 and _beingRubbedLocal>>
			<<bgv "breath_fast" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.6 or $orgasmcurrent gte 1>>
			<<bgv "breath" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.4>>
			<<bgv "breath_slow" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.2>>
			<<bgv "breath_vslow" _args[0]>>
		<<else>>
			<<bgv "stop">>
		<</if>>
	<<elseif playerVoiceIsMale()>>
		<<if $pleasure gte $pleasuremax * 0.8>>
			<<bgv "m_breath_fast" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.6 or $orgasmcurrent gte 1>>
			<<bgv "m_breath" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.4>>
			<<bgv "m_breath_slow" _args[0]>>
		<<elseif $pleasure gte $pleasuremax * 0.2>>
			<<bgv "m_breath_vslow" _args[0]>>
		<<else>>
			<<bgv "stop">>
		<</if>>	
	<</if>>
<</widget>>

<<widget "orgasm-voice">>

	<<set _penetration to ["penetrated", "doublepenetrated", "tentacle", "tentacledeep"]>>
	<<if _args[0] is undefined>>
		/* Play player orgasm voice once per orgasm (blocks double-trigger) */
		<<set _now to Date.now()>>
		<<if $lastPlayerOrgasmVoiceAt is undefined>><<set $lastPlayerOrgasmVoiceAt to 0>><</if>>
		<<if $lastPlayerOrgasmVoiceOrgasmcurrent is undefined>><<set $lastPlayerOrgasmVoiceOrgasmcurrent to -1>><</if>>
		<<set _isDupe to ($orgasmcurrent is $lastPlayerOrgasmVoiceOrgasmcurrent) and (_now - $lastPlayerOrgasmVoiceAt lt 8000)>>
		<<if _isDupe is false>>
			<<set $lastPlayerOrgasmVoiceAt to _now>>
			<<set $lastPlayerOrgasmVoiceOrgasmcurrent to $orgasmcurrent>>

		<<if playerVoiceIsFemale()>>
			<<set _vs to playerVoiceSettings()>>
			<<set _prefix to _vs.voice + "_">>
			<<if _vs.voice is "v2">>
				<<if $mouthuse is "gagged">>
					<<set _prefix += "gagged_">>
				<<elseif $consensual isnot 1>>
					<<set _prefix += "noncon_">>
				<</if>>
			<</if>>
			<<if _penetration.includes($mouthstate)>>
				<<set _playlist to _prefix + "chupa_orgasm">>
			<<elseif _penetration.includes($vaginastate) or _penetration.includes($anusstate)>>
				<<set _playlist to _prefix + "orgasm">>
			<<else>>
				<<set _playlist to _prefix + "breath_orgasm">>
			<</if>>
			<<init-playlist _playlist>>
			<<voiceover setup.playlists[_playlist]>>
		<<elseif playerVoiceIsMale()>>
			<<init-playlist "m_orgasm">>
			<<voiceover setup.playlists.m_orgasm>>
			<<ejaculation-sound>>
		<</if>>
		<</if>>

	<<else>>
		<<if _args[0] is "npc_f">>
			<<init-playlist "npc_f">>
			<<voiceover setup.playlists.npc_f _args[0]>>
		<<elseif _args[0] is "npc_m">>
			<<init-playlist "npc_m">>
			<<voiceover setup.playlists.npc_m _args[0]>>
		<</if>>
	<</if>>
<</widget>>

<<widget "npc-orgasm-voice">>
	<!-- Only use actual encounter participants, not every NPC record in the passage pool. -->
	<<set _activeNPCs to []>>

	<<for _n = 0; _n lt $NPCList.length; _n++>>
		<<if $NPCList[_n] and $NPCList[_n].active is "active" and $NPCList[_n].stance isnot "defeated">>
			<<run _activeNPCs.push($NPCList[_n])>>
		<</if>>
	<</for>>

	/* Fallback for single-target scenes where active flags may not be populated yet. */
	<<if _activeNPCs.length is 0 and $NPCList[$active_enemy] and $NPCList[$active_enemy].stance isnot "defeated">>
		<<run _activeNPCs.push($NPCList[$active_enemy])>>
	<<elseif _activeNPCs.length is 0 and $NPCList[$index] and $NPCList[$index].stance isnot "defeated">>
		<<run _activeNPCs.push($NPCList[$index])>>
	<<elseif _activeNPCs.length is 0 and $NPCList[0] and $NPCList[0].stance isnot "defeated">>
		<<run _activeNPCs.push($NPCList[0])>>
	<</if>>

	<<for _n = 0; _n lt _activeNPCs.length; _n++>>
		<<set _npc to _activeNPCs[_n]>>
		<<set _delay to random(0,3000) + "ms">>
		<<if _npc.pronoun is "f" and npcVoiceAllowed("f")>>
			<<timed _delay>>
				<<orgasm-voice "npc_f">>
			<</timed>>
		<<elseif _npc.pronoun is "m" and npcVoiceAllowed("m")>>
			<<timed _delay>>
				<<orgasm-voice "npc_m">>
				<<next 5s>>
					<<ejaculation-sound "npc">>
			<</timed>>
		<</if>>
	<</for>>
<</widget>>
