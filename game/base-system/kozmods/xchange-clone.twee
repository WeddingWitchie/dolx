:: XChange Clone Pill Widgets [widget]

<<widget "xchange-clone">>
	<<set _npcName to _args[1]>>
	<<if _npcName is undefined>>
		<<error {
			message	: `Widget 'xchange-clone' was called without any arguments.`,
			source	: `Previous passage: ${$passagePrev} | phase: ${$phase} | rng: ${$rng}.`
		}>>
	<</if>>

	<<xchange-effects _args[0] _args.slice(2)>>
	<<save-body>>

	<<if $xchange.pill.clonedBody[_npcName] isnot undefined>>
		<<load-body "cloned" _npcName>>
	<<else>>
		<<if C.npc[_npcName].gender is "m">>
			<<if $player.gender isnot "m">><<xchange-addeffect "genderflip">>
			<<else>><<become-boy>><</if>>
		<<elseif C.npc[_npcName].gender is "f">>
			<<if $player.gender isnot "f">><<xchange-addeffect "genderflip">>
			<<else>><<become-girl>><</if>>
		<</if>>
		<<set-xchange-clone-body _npcName>>
	<</if>>

	<<set-xchange-clone-hairstyle _npcName>>
	<<set-xchange-clone-social _npcName>>
	<<set-xchange-clone-misc _npcName>>
	
	<!-- repair facial style/variant after clone -->
	<<set _fvo to setup.faceVariantOptions>>
	<<if _fvo and !_fvo[$facestyle]>>
		<<set $facestyle to Object.keys(_fvo)[0]>>
	<</if>>
	<<set _opts to _fvo ? _fvo[$facestyle] : null>>
	<<if _opts and !_opts[$facevariant]>>
		<<set $facevariant to Object.keys(_opts)[0]>>
	<</if>>

	<<set $xchange.pill.clone to _npcName>>
	<<save-body "cloned" _npcName>>

<</widget>>

<<widget "set-xchange-clone-body">>
	<<set _npcName to _args[0]>>

	<!-- Set the npc's body type -->
	<<if C.npc[_npcName].pronoun is "m" and C.npc[_npcName].gender is "m">>
		<<set $player.gender_body to "m">>
	<<elseif C.npc[_npcName].pronoun is "f" and C.npc[_npcName].gender is "f">>
		<<set $player.gender_body to "f">>
	<<else>>
		<<set $player.gender_body to "a">>
	<</if>>

	<<if C.npc[_npcName].penis isnot "none">>
		<<set $player.penissize to C.npc[_npcName].penissize>>
		<<set $player.ballssize to C.npc[_npcName].ballssize>>
	<</if>>

	<<set $player.breastsize to Number(C.npc[_npcName].breastsize) || 0>>
	<<set $player.breastsize to Math.clamp(Math.floor($player.breastsize), 0, setup.breastsizes.length - 1)>>

	<<set $player.bottomsize to C.npc[_npcName].bottomsize>>

	<<set $haircolour to C.npc[_npcName].hairColour>>
	<<set $hairfringecolour to C.npc[_npcName].hairColour>>

	<<set $leftEyeColour to C.npc[_npcName].eyeColour>>
	<<set $rightEyeColour to C.npc[_npcName].eyeColour>>

	<<if C.npc[_npcName].skincolour is "black">>
		<<set $skinColor.natural to ["dark", "ydark", "dark", "ydark", "medium", "ymedium"].pluck()>>
	<<elseif C.npc[_npcName].skincolour is "white">>
		<<set $skinColor.natural to ["light", "ylight", "light", "ylight", "medium", "ymedium"].pluck()>>
	<<else>>
		<<set $skinColor.natural to C.npc[_npcName].skincolour>>
	<</if>>
<</widget>>


<<widget "set-xchange-clone-hairstyle">>
	<<set _npcName to _args[0]>>

	<<switch _npcName>>
	<<case "Whitney">>
		<<if C.npc[_npcName].pronoun is "m">>
			<<set $hairtype to "neat">>
		<<else>>
			<<set $hairtype to "fluffy ponytail">>
		<</if>>
		<<set $fringetype to "emo left">>
		<<set $hairposition to "back">>
		<<set $earposition to "back">>
	<</switch>>

	<!-- Defaults for everyone else (prevents bald / broken hair UI) -->
	<<if $hairtype is undefined or $hairtype is "">>
		<<set $hairtype to "neat">>
	<</if>>
	<<if $fringetype is undefined or $fringetype is "">>
		<<set $fringetype to "emo left">>
	<</if>>
	<<if $hairposition is undefined or $hairposition is "">>
		<<set $hairposition to "back">>
	<</if>>
	<<if $earposition is undefined or $earposition is "">>
		<<set $earposition to "back">>
	<</if>>

	<!-- ensure we don't end up bald / hair UI disappearing -->
	<<set $hairlength to Math.floor(Number($hairlength) || 200)>>
	<<if $hairlength lte 0>>
		<<set $hairlength to 200>>
	<</if>>

	<<set $ruffledisable to "t">>
<</widget>>

<<widget "set-xchange-clone-social">>
	<<set _npcName to _args[0]>>

	<<switch _npcName>>
	<<case "Whitney">>
		<<set $cool to $coolmax * (2/3)>>
		<<set $delinquency to 1000>>
	<</switch>>
<</widget>>

<<widget "set-xchange-clone-misc">>
	<<set _npcName to _args[0]>>

	<<switch _npcName>>
	<<case "Whitney">>
		<<set $bodysize to 3>>
		<<set $physiquesize to 16000>>
		<<set $physique to 8000>>
		<<set $beauty to ($beautymax / 7) * 3 + ($player.sex is "f"? 3000 : 0)>>
		<<if ["ylight", "medium", "ymedium"].includes($skinColor.natural)>>
			<<set $skinColor.natural to "light">>
		<</if>>
	<</switch>>
<</widget>>