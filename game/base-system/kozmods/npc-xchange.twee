:: X-Change NPC-targeted Widgets [widget]

    /* Selects which NPC will be affected by the widgets listed below this one */
    <<widget "npc-select-xchange-target">>
        <<if isNumber(_args[0])>>
		    <<set _npcno to _args[0]>>
        <<else>>
            <<set _npcname to _args[0]>>
        <</if>>

        /* Check if the targeted NPC is a Named NPC */
        <<if _npcno isnot undefined and $NPCNameList.includes($NPCList[_npcno].fullDescription)>>
            <<set _npcname to $NPCList[_npcno].fullDescription>>
        <</if>>

        <<if _npcname isnot undefined>>
            <<set _npcnameindex to $NPCNameList.indexOf(_npcname)>>
        <</if>>

        <<set $xchange.npcTargetNo to _npcno>>
        <<set $xchange.npcTargetName to _npcname>>
        <<set $xchange.npcTargetNameIndex to _npcnameindex>>

		<<if $debug is 1>><<run console.log("NPC selection: ", _npcno, _npcname,_npcnameindex)>><</if>>
    <</widget>>

    <<widget "xchange-pronoun">>
        <<if _args[0] and typeof _args[0] is "object" and _args[0].pronoun>>
            <<set $pronoun to _args[0].pronoun>>
        <<elseif typeof _args[0] is "string" and C.npc[_args[0]] and C.npc[_args[0]].pronoun>>
            <<set $pronoun to C.npc[_args[0]].pronoun>>
        <<else>>
            <<run console.warn("[xchange] <<xchange-pronoun>> got no usable pronoun in passage " + V.passage)>>
        <</if>>
    <</widget>>

    <<widget "npc-take-xchange">>
        <<set _targetNo to $xchange.npcTargetNo>>
        <<set _targetName to $xchange.npcTargetName>>
        <<set _targetNameIndex to $xchange.npcTargetNameIndex>>
		<<set _duration to _args[0]>>
        <<set _effects to _args.slice(1)>>

        /* Check if target is invalid */
        <<if (_targetNo is undefined and !_targetName) or _targetNo gte 6 or _targetNo lt 0>>
            <<error { message: "Tried to pill an NPC without first selecting a target. Please report this to Akoz, along with your exported save file." }>>
            <<npc-deselect-xchange-target>>
            <<exit>>
        <</if>>

        <<if _targetNo is undefined>>
            <<set _xchangeTargetId to _targetName>>
        <<else>>
            <<set _xchangeTargetId to _targetNo>>
        <</if>>
        <<if !npcIsXChanged(_xchangeTargetId)>>
            <<if _targetName>><<npc-xchange-save _targetName>><</if>>
            <<npc-xchange-effects _duration _effects>>
        <</if>>

		<<if $xchange.npcTimesTaken is undefined>><<set $xchange.npcTimesTaken to {}>><</if>>

		<<if _targetName>>
			<<if $xchange.npcTimesTaken[_targetName] is undefined>><<set $xchange.npcTimesTaken[_targetName] to 0>><</if>>
			<<set $xchange.npcTimesTaken[_targetName]++>>
		<</if>>

        <<npc-deselect-xchange-target>>
	<</widget>>


    <<widget "npc-xchange-save">>
        <<set _targetName to _args[0]>>

        <<if $xchange is undefined>><<set $xchange to {}>><</if>>
        <<if $xchange.savedNpcBodies is undefined>><<set $xchange.savedNpcBodies to {}>><</if>>
        <<if $xchange.savedNpcBodies[_targetName] is undefined>><<set $xchange.savedNpcBodies[_targetName] to {}>><</if>>

        <<set _npcSave to undefined>>
        <<if $NPCNameList.includes(_targetName)>>
            <<set _npcSave to $NPCName[$NPCNameList.indexOf(_targetName)]>>
        <</if>>
        <<if _npcSave is undefined>><<set _npcSave to C.npc[_targetName]>><</if>>

        <<if _npcSave is undefined>>
            <<run console.warn("npc-xchange-save: NPC not found:", _targetName)>>
        <<else>>
            <<set _data to {
                gender: _npcSave.gender,
                pronoun: _npcSave.pronoun,
                breastsize: _npcSave.breastsize,
                breastdesc: _npcSave.breastdesc,
                breastsdesc: _npcSave.breastsdesc,
                penis: _npcSave.penis,
                penissize: _npcSave.penissize,
                penisdesc: _npcSave.penisdesc,
                vagina: _npcSave.vagina
            }>>

            <<if _args[1] is undefined>>
                <<set $xchange.savedNpcBodies[_targetName].original to clone(_data)>>
            <<elseif _args[1] is "genderswapped">>
                <<set $xchange.savedNpcBodies[_targetName].genderswap to clone(_data)>>
            <<elseif _args[1] is "herm">>
                <<set $xchange.savedNpcBodies[_targetName].herm to clone(_data)>>
            <</if>>
        <</if>>
    <</widget>>

	<<widget "npc-xchange-load">>
		<<set _targetName to _args[0]>>
		<<set _mode to _args[1]>>
		<<if _args.length gte 2 and ["nosave","genderswapped","herm"].includes(_args[1]) is false>>
			<<set _targetName to _args[0] + " " + _args[1]>>
			<<set _mode to _args[2]>>
		<</if>>

		<<if $xchange is undefined>><<set $xchange to {}>><</if>>
		<<if $xchange.savedNpcBodies is undefined>><<set $xchange.savedNpcBodies to {}>><</if>>

		/* Resolve the live NPC object we actually want to update */
		<<set _npcLoad to undefined>>
		<<set _npcLoadIndex to undefined>>
		<<if $NPCNameList.includes(_targetName)>>
			<<set _npcLoadIndex to $NPCNameList.indexOf(_targetName)>>
			<<set _npcLoad to $NPCName[_npcLoadIndex]>>
		<</if>>
		<<if _npcLoad is undefined>><<set _npcLoad to C.npc[_targetName]>><</if>>

		<<if _npcLoad is undefined>>
			<<run console.warn("npc-xchange-load: NPC not found:", _targetName, "mode:", _mode)>>
		<<else>>
			<<if $xchange.savedNpcBodies[_targetName] is undefined>>
				<<set $xchange.savedNpcBodies[_targetName] to {}>>
			<</if>>

			<<if $xchange.savedNpcBodies[_targetName].original is undefined>>
				<<set $xchange.savedNpcBodies[_targetName].original to {
					gender: _npcLoad.gender,
					pronoun: _npcLoad.pronoun,
					breastsize: _npcLoad.breastsize,
					breastdesc: _npcLoad.breastdesc,
					breastsdesc: _npcLoad.breastsdesc,
					penis: _npcLoad.penis,
					penissize: _npcLoad.penissize,
					penisdesc: _npcLoad.penisdesc,
					vagina: _npcLoad.vagina
				}>>
			<</if>>

			<<set _data to $xchange.savedNpcBodies[_targetName].original>>
			<<if _mode is "genderswapped" and $xchange.savedNpcBodies[_targetName].genderswap isnot undefined>>
				<<set _data to $xchange.savedNpcBodies[_targetName].genderswap>>
			<<elseif _mode is "herm" and $xchange.savedNpcBodies[_targetName].herm isnot undefined>>
				<<set _data to $xchange.savedNpcBodies[_targetName].herm>>
			<</if>>

			<<if _data>>
				<<set _bodyKeys to ["gender","pronoun","breastsize","breastdesc","breastsdesc","penis","penissize","penisdesc","vagina"]>>
				<<for _key range _bodyKeys>>
					<<if _data[_key] isnot undefined>><<set _npcLoad[_key] to clone(_data[_key])>><</if>>
				<</for>>
				<<if _npcLoad.pronoun>><<generatePronouns _npcLoad>><</if>>
			<</if>>

			<<if _npcLoadIndex isnot undefined>><<set $NPCName[_npcLoadIndex] to _npcLoad>><</if>>
			<<npc-xchange-sync-active-target _targetName _npcLoadIndex>>
		<</if>>
	<</widget>>

	<<widget "npc-xchange-sync-active-target">>
		<<set _syncName to _args[0]>>
		<<set _syncIndex to _args[1]>>
		<<set _preserveGenitalState to _args[2] is true>>
		<<if _syncName is undefined>><<set _syncName to _targetName>><</if>>
		<<if _syncIndex is undefined>><<set _syncIndex to _targetNameIndex>><</if>>
		<<set _syncSource to undefined>>

		<<if _syncIndex is undefined and _syncName and $NPCNameList.includes(_syncName)>>
			<<set _syncIndex to $NPCNameList.indexOf(_syncName)>>
		<</if>>
		<<if _syncIndex isnot undefined and $NPCName[_syncIndex]>>
			<<set _syncSource to $NPCName[_syncIndex]>>
		<<elseif _syncName and C.npc[_syncName]>>
			<<set _syncSource to C.npc[_syncName]>>
		<</if>>

		<<if _syncSource>>
			<<set _syncKeys to ["gender","pronoun","breastsize","breastdesc","breastsdesc","penis","penissize","penisdesc","vagina","xchange"]>>

			/* Keep C.npc updated without assigning directly into C.npc[...] as a macro target. */
			<<if _syncName and C.npc[_syncName]>>
				<<set _syncNpc to C.npc[_syncName]>>
				<<for _key range _syncKeys>>
					<<if _syncSource[_key] isnot undefined>><<set _syncNpc[_key] to clone(_syncSource[_key])>><</if>>
				<</for>>
				<<if _syncNpc.pronoun>><<generatePronouns _syncNpc>><</if>>
			<</if>>

			/* Keep an already-spawned sex-scene copy from using stale pronouns/body parts. */
			<<if $NPCList>>
				<<for _slot range $NPCList>>
					<<if _slot and (_slot.description is _syncName or _slot.fullDescription is _syncName or _slot.nam is _syncName or _slot.name is _syncName)>>
						<<for _key range _syncKeys>>
							<<if _syncSource[_key] isnot undefined>>
								<<if _preserveGenitalState and (_key is "penis" or _key is "vagina")>>
									<<if _slot[_key] is "none">>
										/* A naked combat NPC must stay naked here, or the new hole comes back "clothed" and can't be penetrated. */
										<<set _counterpartGenital to (_key is "penis") ? _slot.vagina : _slot.penis>>
										<<set _slot[_key] to (_counterpartGenital is "clothed") ? "clothed" : 0>>
									<</if>>
									/* else: keep the live positional state (e.g. "vaginaentrance") as-is */
								<<else>>
									<<set _slot[_key] to clone(_syncSource[_key])>>
								<</if>>
							<</if>>
						<</for>>
						<<if _slot.pronoun>><<generatePronouns _slot>><</if>>
					<</if>>
				<</for>>
			<</if>>
		<</if>>
	<</widget>>

    <<widget "npc-xchange-effects">>
        <<set _days to _args[0]>>
		<<set _effectsList to _args[1]>>
        <<set _pill to {}>>
		
		<<set _pill.duration to _days * 24 - 1>> <!-- duration now in hours instead of days -->
		<<set _pill.fertile to false>>
		<<set _pill.effectsKnown to true>>

		<<set _pill.genderflipEffect to false>>
		<<set _pill.genderificationEffect to false>>
		<<set _pill.hermEffect to false>>
		<<set _pill.breederEffect to false>>
		<<set _pill.bullEffect to false>>
		<<set _pill.resistanceEffect to false>>
		<<set _pill.continueEffect to false>>
		<<set _pill.passionEffect to false>>
		<<set _pill.dumbBitchEffect to false>>
		<<set _pill.portalEffect to false>>
		<<set _pill.portalEffectTimer to 0>>
		<<set _pill.innocenceEffect to false>>

		<<for _effect range _effectsList>>

			/* Skip adding continue or resistance effects if not also genderflipped */
			<<if ["continue", "resistance"].includes(_effect) && !_effectsList.includes("genderflip")>>
				<<continue>>
			<</if>>
			
			/* Add each effect */
			<<npc-xchange-addeffect _effect _days>>

		<</for>>

        /* Attach the effects to the NPC */
        <<if _targetNo isnot undefined>>
            <<set $NPCList[_targetNo].xchange to _pill>>
        <</if>>
        <<if _targetName>>
            <<set $NPCName[_targetNameIndex].xchange to _pill>>
            <<set _syncNpc to C.npc[_targetName]>>
            <<if _syncNpc>><<set _syncNpc.xchange to clone(_pill)>><</if>>
            /* Additive herm pills must preserve a live combat copy's in-use genital state; genderflip pills still overwrite so the swapped genitals propagate. */
            <<npc-xchange-sync-active-target _targetName _targetNameIndex `_pill.hermEffect && !_pill.genderflipEffect`>>
        <</if>>

    <</widget>>

    <<widget "npc-xchange-addeffect">>

        <<switch _args[0]>>
		<<case "genderflip">>
			<<if !_pill.genderflipEffect>>
				<<set _pill.genderflipEffect to true>>
				/* Record whether this pill also flipped the NPC's gender (pronouns/description), for UI display. */
				<<set _pill.genderChanged to $xchange.npcPillChangesGender isnot 0>>

				<<if npcStartingSexIs(_targetNo, _targetName, "m")>>
					<<npc-become-girl>>
				<<elseif npcStartingSexIs(_targetNo, _targetName, "f")>>
					<<npc-become-boy>>
				<</if>>
				<<if npcStartingSexIs(_targetNo, _targetName, "f")>>
					<<set _pill.breederEffect to false>>
					<<set _pill.fertile to false>>
					/* <<set $sexStats.vagina.menstruation.running = false>> */
				<</if>>
				<<if npcStartingSexIs(_targetNo, _targetName, "m")>>
					<<set _pill.bullEffect to false>>
				<</if>>
			<</if>>
		<<case "crossdress">>
			<<if !_pill.genderificationEffect>>
				<<set _pill.genderificationEffect to true>>
				<<if !_pill.genderflipEffect && !_pill.hermEffect>>
					<<if npcStartingSexIs(_targetNo, _targetName, "m")>>
						<<npc-sissify>>
					<<elseif npcStartingSexIs(_targetNo, _targetName, "f")>>
						<<npc-butchify>>
					<</if>>
				<</if>>
			<</if>>
		<<case "herm">>
			/* Herm keeps the NPC's original presentation (gender/pronoun/breasts) and only
			   adds whichever genital they're missing, so they end up with both. */
			<<if !_pill.hermEffect>>
				<<set _pill.hermEffect to true>>
				<<npc-hermify>>
			<</if>>
		<<case "resistance">>
			<<if !_pill.resistanceEffect>>
				<<set _pill.resistanceEffect to true>>
				<<set _pill.resistanceChance to 100>>
				<<set _pill.resistanceOrgasmsStat to 0>>
			<</if>>
		<<case "continue">>
			<<set _pill.continueEffect to true>>
		<<case "fertile">>
			<<set _pill.fertile to true>>
			/* <<set $sexStats.vagina.menstruation.running = true>> */
		<<case "breeder">>
			<<set _pill.breederEffect to true>>
			<<set _pill.breederEdgingCount to 0>>
			<<set _pill.breederEdgingStress to 100>>
		<<case "bull">>
			<<set _pill.bullEffect to true>>
		<<case "portal">>
			<<set _duration to _args[1] ?? 1>>
			<<set _pill.portalEffect to true>>
			<<set _pill.portalEffectTimer to _duration * 24 - 1>>
		<<case "passion">>
			<<set _pill.passionEffect to true>>
		<<case "dumb-bitch">>
			<<set _pill.dumbBitchEffect to true>>
		<<case "innocence">>
			<<set _pill.innocenceEffect to true>>
			/* <<set $xchange.awareness to $awareness>>
			<<set $awareness to -200>>
			<<set $innocencestate to 1>>
			<<if $xchange.awareness gte 0>>
				<<set $innocencemessage to "start">>
			<</if>> */
		<<case "choice">>
			<<npc-xchange-setpermanent>>
			/* <<set $xchangePermanenceMessage to 0>> */
			<<set _pill.choiceEffect to true>>
		<<case "spike" "unknown">>
			<<set _pill.effectsKnown to false>>
		<<case "random">>
			<<xchange-get-spikepool>>
			/* Omega/Alpha are player-only mechanics (anal pregnancy, alpha knot in the player's encounters); NPCs have no handling for them, so keep them out of NPC rolls. */
			<<run _effectPool.deleteWith((val)=>val==="omega" || val==="alpha")>>
			<<npc-xchange-addeffect _effectPool.random()>>
		<<default>>
		<</switch>>
    <</widget>>
    
    <<widget "npc-xchange-removeeffect">>
		<<switch _args[0]>>
		<<case "genderflip">>
			<<set _pill.genderflipEffect to false>>
			<<if npcStartingSexIs(_targetNo, _targetName, "m")>>
				<<npc-become-boy>>
			<<elseif npcStartingSexIs(_targetNo, _targetName, "f")>>
				<<npc-become-girl>>
			<</if>>
			<<load-body>>
		<<case "crossdress">>
			<<set _pill.genderificationEffect to false>>
		<<case "resistance">>
			<<set _pill.resistanceEffect to false>>
		<<case "continue">>
			<<set _pill.continueEffect to false>>
		<<case "fertile">>
			<<set _pill.fertile to false>>
			/* <<set $sexStats.vagina.menstruation.running = false>> */
		<<case "breeder">>
			<<set _pill.breederEffect to false>>
		<<case "portal">>
			<<set _pill.portalEffect to false>>
			<<set _pill.portalEffectTimer to 0>>
		<<case "passion">>
			<<set _pill.passionEffect to false>>
		<<case "dumb-bitch">>
			<<set _pill.dumbBitchEffect to false>>		
		<<case "innocence">>
			<<set _pill.innocenceEffect to false>>
			/* <<set $awareness to $xchange.awareness>>
			<<if $awareness gte 0>>
				<<set $innocencestate to 0>>
				<<set $innocencemessage to "end">>
			<</if>> */
		<<case "spike" "unknown">>
			<<set _pill.effectsKnown to true>>
		<<default>>
		<</switch>>
	<</widget>>

	<<widget "npc-xchange-restore">>
		<<set _targetName to _args[0]>>
		<<set _mode to _args[1]>>
		<<if _args.length gte 2 and ["nosave","genderswapped","herm"].includes(_args[1]) is false>>
			<<set _targetName to _args[0] + " " + _args[1]>>
			<<set _mode to _args[2]>>
		<</if>>

		/* $NPCName is a numeric-indexed array, so resolve the slot index from the name. */
		<<set _targetNameIndex to $NPCNameList.indexOf(_targetName)>>

		/* npc temp pill/effects object (can be undefined) */
		<<set _pill to $NPCName[_targetNameIndex]?.xchange>>
		<<if _pill is undefined>><<set _pill to C.npc[_targetName]?.xchange>><</if>>

		<<if $debug is 1>><<run console.log("NPC Restore:", _targetName, "mode:", _mode, "pill:", _pill)>><</if>>

		<<if _mode isnot "nosave">>
			<<if _pill and _pill.hermEffect>>
				<<npc-xchange-save _targetName "herm">>
			<<elseif _pill and _pill.genderflipEffect>>
				<<npc-xchange-save _targetName "genderswapped">>
			<</if>>

			<<if C.npc[_targetName]>>
				<<if C.npc[_targetName].startingSex is "m">>
					<<npc-become-boy>>
				<<elseif C.npc[_targetName].startingSex is "f">>
					<<npc-become-girl>>
				<</if>>
			<</if>>
		<</if>>

		<<npc-xchange-load _targetName>>

		/* Queue up pill messages */
		/* <<set $effectsmessage to 1>> */
		/* <<if $xchange_fame gte 1000 && !$xchangeFameMerged>>
			<<set $xchangeFameMessage to 1>>
		<</if>> */

		/* <<if _pill.resistanceEffect && _pill.resistanceChance lt 100>>
			<<set $xchangeRestoreMessage to 2>>
		<<elseif _pill.genderflipEffect>>
			<<set $xchangeRestoreMessage to 1>>
		<<elseif _pill.effectsKnown>>
			<<set $xchangeRestoreMessage to 3>>
		<</if>> */

		/* Clear pill effects */
		/* <<if _pill.passionEffect>><<set $drugged to 0>><</if>> */
		/* <<set _pill.genderflipEffect to false>>
		<<set _pill.portalEffect to false>>
		<<set _pill.portalEffectTimer to 0>>
		<<set _pill.passionEffect to false>>
		<<set _pill.choiceEffect to false>>
		<<set _pill.innocenceEffect to false>>
		<<set _pill.swellEffect to false>>
		<<set _pill.bimboEffect to false>>
		<<set _pill.cumcureEffect to false>>
		<<unset _pill.shouldHaveEnded>> */
		<<if _targetNameIndex gte 0 and $NPCName[_targetNameIndex] and $NPCName[_targetNameIndex].xchange isnot undefined>>
			<<run delete $NPCName[_targetNameIndex].xchange>>
		<</if>>
		<<set _restoreNpc to C.npc[_targetName]>>
		<<if _restoreNpc and _restoreNpc.xchange isnot undefined>>
			<<run delete _restoreNpc.xchange>>
		<</if>>
	<</widget>>

	<<widget "npc-xchange-setpermanent">>
		/* Only override the (shared) target name when an explicit one is passed, so calls
		   from <<npc-xchange-addeffect "choice">> (no arg) keep using the active target.
		   Use a private temp var so we never clobber the caller's _pill. */
		<<if _args[0] isnot undefined>><<set _targetName to _args[0]>><</if>>

		<<set _permPill to C.npc[_targetName]?.xchange>>
		<<if _permPill is undefined and _targetName>>
			<<set _permIndex to $NPCNameList.indexOf(_targetName)>>
			<<if _permIndex gte 0>><<set _permPill to $NPCName[_permIndex]?.xchange>><</if>>
		<</if>>

		<<if _permPill isnot undefined>>
			<<set _permPill.duration to -1>>
			<<if C.npc[_targetName]?.startingSex is "f">>
				/* <<set $sexStats.vagina.menstruation.running = true>> */
				<<set _permPill.fertile to true>>
			<</if>>
			<<set _permPill.continueEffect to false>>
			<<set _permPill.resistanceEffect to false>>
		<<else>>
			<<run console.warn("npc-xchange-setpermanent: no active pill for NPC:", _targetName)>>
		<</if>>

		/* <<set $effectsmessage to 1>> */
		/* <<set $xchangePermanenceMessage to 1>> */
	<</widget>>

    <<widget "npc-deselect-xchange-target">>
        <<unset $xchange.npcTargetNo>>
        <<unset $xchange.npcTargetName>>
        <<unset $xchange.npcTargetNameIndex>>
    <</widget>>

    /* Small hoverable "X-Changed" tag shown next to a pilled Named NPC's name in the Social overlay.
	Always pink; hover just points to the NPC Traits entry for the full details. Expects the $NPCName entry as arg 0. */
    <<widget "npc-xchange-relation-tag">>
        <<set _xcTagStatus to npcXchangePillStatus(_args[0] ? _args[0].nam : undefined)>>
        <<if _xcTagStatus>>
            <mouse class="tooltip"><small class="relation-title pink"><i>_xcTagStatus.label</i></small><span><small>See the NPC traits for more info.</small></span></mouse>
        <</if>>
    <</widget>>

    <<widget "npc-become-girl">>
		<<set _npcTemp to $NPCList[_targetNo]>>
        <<set _npc to $NPCName[_targetNameIndex]>>

        /* Sex-only pilling: snapshot the current identity so it can be reapplied after the body swap. */
        <<set _keepNpcGender to $xchange.npcPillChangesGender is 0>>
        <<set _keptNpcPronoun to _npc ? _npc.pronoun : (_npcTemp ? _npcTemp.pronoun : undefined)>>
        <<set _keptNpcFullDescription to _npcTemp ? _npcTemp.fullDescription : undefined>>

        <<set _brdes to ["nipple","budding","tiny","small","pert","modest","full","large","ample","massive","huge","gigantic","enormous"]>>

		<<if _npc and _npc.startingSex isnot "f" && $xchange.savedNpcBodies[_targetName] isnot undefined && $xchange.savedNpcBodies[_targetName].genderswap isnot undefined && Object.keys($xchange.savedNpcBodies[_targetName].genderswap).length gt 0>>
			<<npc-xchange-load _targetName "genderswapped">>

			<<for _key range Object.keys(_npc)>>
				<<if !_npcTemp>><<break>><</if>>
				<<if _npcTemp[_key] isnot undefined>>
					<<set _npcTemp[_key] to _npc[_key]>>
				<</if>>
			<</for>>
		<<elseif _npc>>
			<<set _npc.gender to "f">>
			<<set _npc.pronoun to "f">>
			<<generatePronouns _npc>>

			<<set _npc.breastsize to random(1,_brdes.length-1)>>
			<<set _npc.breastdesc to _brdes[_npc.breastsize] + " breast">>
			<<set _npc.breastsdesc to _brdes[_npc.breastsize] + " breasts">>
			/* <<set _npc.ballssize to 1>> */
			<<set _npc.vagina to _npc.penis is "clothed" ? "clothed" : (_npcTemp and _npcTemp.penis is "idle") ? "idle" : 0>>
			<<set _npc.penis to "none">>
			<<set _npc.penisdesc to "none">>
			<<set _npc.penissize to 0>>

			<<for _key range Object.keys(_npc)>>
				<<if !_npcTemp>><<break>><</if>>
				<<if _npcTemp[_key] isnot undefined>>
					<<set _npcTemp[_key] to _npc[_key]>>
				<</if>>
			<</for>>

		<<elseif _npcTemp>>
			<<set _npcTemp.gender to "f">>
			<<set _npcTemp.pronoun to "f">>
			<<generatePronouns _npcTemp>>

			<<set _npcTemp.fullDescription to _npcTemp.description + " ">>
			<<if _npcTemp.role isnot "normal">>
				<<set _npcTemp.fullDescription += _npcTemp.role>>
			<<elseif _npcTemp.pronoun is "m">>
				<<set _npcTemp.fullDescription += (_npcTemp.teen is 1 ? "boy" : "man")>>
			<<elseif _npcTemp.pronoun is "f">>
				<<set _npcTemp.fullDescription += (_npcTemp.teen is 1 ? "girl" : "woman")>>
			<</if>>

			<<set _npcTemp.breastsize to random(1,_brdes.length-1)>>
			<<set _npcTemp.breastdesc to _brdes[_npcTemp.breastsize] + " breast">>
			<<set _npcTemp.breastsdesc to _brdes[_npcTemp.breastsize] + " breasts">>
			/* <<set _npcTemp.ballssize to 1>> */
			<<set _npcTemp.vagina to _npcTemp.penis is "clothed"? "clothed" : _npcTemp.penis is "idle"? "idle" : 0>>
			<<set _npcTemp.penis to "none">>
			<<set _npcTemp.penisdesc to "none">>
			<<set _npcTemp.penissize to 0>>
		<</if>>
		<<npc-xchange-keep-gender "f">>
		<<if _targetName>><<npc-xchange-sync-active-target _targetName _targetNameIndex>><</if>>
    <</widget>>

    <<widget "npc-become-boy">>
		<<set _npcTemp to $NPCList[_targetNo]>>
        <<set _npc to $NPCName[_targetNameIndex]>>

        /* Sex-only pilling: snapshot the current identity so it can be reapplied after the body swap. */
        <<set _keepNpcGender to $xchange.npcPillChangesGender is 0>>
        <<set _keptNpcPronoun to _npc ? _npc.pronoun : (_npcTemp ? _npcTemp.pronoun : undefined)>>
        <<set _keptNpcFullDescription to _npcTemp ? _npcTemp.fullDescription : undefined>>

        <<set _swap to undefined>>
        <<if $xchange.savedNpcBodies[_targetName]>>
            <<set _swap to $xchange.savedNpcBodies[_targetName].genderswap>>
        <</if>>
        <<set _swapValidBoy to _swap and _swap.gender is "m" and _swap.penissize isnot undefined and _swap.penissize gt 0 and _swap.penisdesc and _swap.penisdesc isnot "none">>

        <<set _penissizes to [1, 2,2,2,2, 3,3,3, 4] >>
        <<set _penisdescs to [
            "tiny penis", 
            "penis",
            either("thick cock", "hefty cock", "big cock", "veiny cock", "large cock"),
            either("massive cock","huge cock","humongous cock","immense cock","gigantic cock","enormous cock"),
            either("colossal cock", "monstrous cock", "titanic cock", "towering cock", "immense cock"),
        ]>>

		<<if _npc and _npc.startingSex isnot "m" and _swapValidBoy>>
			<<npc-xchange-load _targetName "genderswapped">>

			<<for _key range Object.keys(_npc)>>
				<<if !_npcTemp>><<break>><</if>>
				<<if _npcTemp[_key] isnot undefined>>
					<<set _npcTemp[_key] to _npc[_key]>>
				<</if>>
			<</for>>

		<<elseif _npc>>
			<<set _npc.gender to "m">>
			<<set _npc.pronoun to "m">>
			<<generatePronouns _npc>>

			<<set _npc.breastsize to 0>>
			<<set _npc.breastdesc to "nipple">>
			<<set _npc.breastsdesc to "nipples">>
			/* <<set _npc.ballssize to 1>> */
			<<set _npc.penis to _npc.vagina is "clothed" ? "clothed" : (_npcTemp and _npcTemp.vagina is "idle") ? "idle" : 0>>
			<<set _npc.penissize to _penissizes.random()>>
			<<if _npc.penissize is 4 and ($settings.npcColossalPenisChance || 0) gt 0 and random(1, 100) lte $settings.npcColossalPenisChance>>
				<<set _npc.penissize to 5>>
			<</if>>
			<<set _npc.penisdesc to _penisdescs[_npc.penissize-1]>>
			<<set _npc.vagina to "none">>

			<<for _key range Object.keys(_npc)>>
				<<if !_npcTemp>><<break>><</if>>
				<<if _npcTemp[_key] isnot undefined>>
					<<set _npcTemp[_key] to _npc[_key]>>
				<</if>>
			<</for>>

		<<elseif _npcTemp>>
			<<set _npcTemp.gender to "m">>
			<<set _npcTemp.pronoun to "m">>
			<<generatePronouns _npcTemp>>

			<<set _npcTemp.fullDescription to _npcTemp.description + " ">>
			<<if _npcTemp.role isnot "normal">>
				<<set _npcTemp.fullDescription += _npcTemp.role>>
			<<elseif _npcTemp.pronoun is "m">>
				<<set _npcTemp.fullDescription += (_npcTemp.teen is 1 ? "boy" : "man")>>
			<<elseif _npcTemp.pronoun is "f">>
				<<set _npcTemp.fullDescription += (_npcTemp.teen is 1 ? "girl" : "woman")>>
			<</if>>

			<<set _npcTemp.breastsize to 0>>
			<<set _npcTemp.breastdesc to "nipple">>
			<<set _npcTemp.breastsdesc to "nipples">>
			/* <<set _npcTemp.ballssize to 1>> */
			<<set _npcTemp.penis to _npcTemp.vagina is "clothed"? "clothed" : _npcTemp.vagina is "idle"? "idle" : 0>>
			<<set _npcTemp.penissize to _penissizes.random()>>
			<<if _npcTemp.penissize is 4 and ($settings.npcColossalPenisChance || 0) gt 0 and random(1, 100) lte $settings.npcColossalPenisChance>>
				<<set _npcTemp.penissize to 5>>
			<</if>>
			<<set _npcTemp.penisdesc to _penisdescs[_npcTemp.penissize-1]>>
			<<set _npcTemp.vagina to "none">>
		<</if>>
		<<npc-xchange-keep-gender "m">>
		<<if _targetName>><<npc-xchange-sync-active-target _targetName _targetNameIndex>><</if>>
    <</widget>>

    <<widget "npc-xchange-keep-gender">>
		<<if _keepNpcGender and _keptNpcPronoun isnot undefined>>
			<<if _npc>>
				<<set _npc.pronoun to _keptNpcPronoun>>
				<<generatePronouns _npc>>
			<</if>>
			<<if _npcTemp>>
				<<set _npcTemp.pronoun to _keptNpcPronoun>>
				<<generatePronouns _npcTemp>>
				<<if _keptNpcFullDescription isnot undefined>><<set _npcTemp.fullDescription to _keptNpcFullDescription>><</if>>
			<</if>>
		<<elseif !_keepNpcGender and _args[0]>>
			<<if _npc and _npc.pronoun isnot _args[0]>>
				<<set _npc.pronoun to _args[0]>>
				<<generatePronouns _npc>>
			<</if>>
			<<if _npcTemp and _npcTemp.pronoun isnot _args[0]>>
				<<set _npcTemp.pronoun to _args[0]>>
				<<generatePronouns _npcTemp>>
			<</if>>
		<</if>>
    <</widget>>

