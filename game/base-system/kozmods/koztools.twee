					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<glowstatbar 0 $pleasure $pleasuremax _showCaptionText>>
			</div>
		<</if>>
	<</widget>>

	<<widget "enemypleasure">>
		<<set _change to _args[0]>>
		<<set _arousalModifier to $enemyarousal / $enemyarousalmax>>
		<<set _enemySexModifier to _enemies gt 1 or $NPCList[0].gender isnot "m" or _change lt 0 or $timer? 1 : 0.5>>
		<<set $enemypleasure += _change * _arousalModifier * _enemySexModifier>>
	<</widget>>

	<<widget "enemypleasure-edge">>
		<<set _change to _args[0]>>
		<<set _initialpleasure to $enemypleasure>>

		<<enemypleasure _change>>
		<<set $enemypleasure to Math.clamp($enemypleasure, Math.min(_initialpleasure, $enemypleasuremax / 5), $enemypleasuremax)>>
	<</widget>>

	<<widget "xchangeSkinColourVariableCombine">>
		<<if _xchangeSkinTone is "no">><<set _xchangeSkinShade to "change">><</if>>
		<<set $xchange.customisedSkinColour to _xchangeSkinTone + _xchangeSkinShade>>
	<</widget>>
