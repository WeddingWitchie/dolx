							"Hah..."
						<<case 1>>
							"Ngh..."
						<<case 2>>
							"Fuck..."
						<<case 3>>
							"Hah..."
						<<case 4>>
							"Hn... Ngh..."
						<<default>>
							"Ngh..."
					<</switch>>
