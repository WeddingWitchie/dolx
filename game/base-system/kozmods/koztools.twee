	<<widget "pleasurecaption">>
		<<if Number.isFinite($pleasure)>>
			<div id="pleasurecaption" @title="'Pleasure: ' + $pleasure.toFixed(2)">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					Pleasure:
					<<if $options.showCaptionText is true>>
						<<if $pleasure gte $pleasuremax>>
							<span class="red">About to burst.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 4>>
							<span class="pink">A climax rises.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 3>>
							<span class="purple">You feel flushed.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
							<span class="blue">You feel hot.</span>
						<<elseif $pleasure gte $pleasuremax / 5>>
							<span class="lblue">You feel tingly.</span>
						<<elseif $pleasure gte 1>>
							<span class="teal">You feel itchy.</span>
