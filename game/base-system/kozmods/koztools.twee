:: X-Change Misc Widgets [widget]
	<!-- Usage: <<fame 10 "scrap" "good">>. Raises fames regardless of mask, gloryhole, etc. -->
    <<widget "fame-propagate">>
		<<if _args.length gte 2 and $statFreeze isnot true>>
			<<set [$_gain, ...($_fameTypes)] to _args>> <!-- remove first element of array since it's the number -->
			<<if Object.keys($xchange.pill.changedBody).length gt 0>>
				<<run $_fameTypes.forEach(fameType => $xchange.pill.changedBody.fame[fameType] += $_gain * 2)>> <!-- add the specified amount to each specified fame type -->
			<</if>>
			<<if Object.keys($xchange.pill.originalBody).length gt 0>>
				<<run $_fameTypes.forEach(fameType => $xchange.pill.originalBody.fame[fameType] += $_gain * 2)>> <!-- add the specified amount to each specified fame type -->
			<</if>>
			<<if Object.keys($xchange.pill.hermBody).length gt 0>>
				<<run $_fameTypes.forEach(fameType => $xchange.pill.hermBody.fame[fameType] += $_gain * 2)>> <!-- add the specified amount to each specified fame type -->
			<</if>>
			<<fameclamp>>
		<</if>>
	<</widget>>

	<!-- Usage: <<xchange-fame 10>>, or <<xchange-fame 10 true>> to apply regardless of mask/gloryhole (e.g. a third party doing it for you, rather than you being recognised in person). -->
	<<widget "xchange-fame">>
		<<if _args[0] and $statFreeze isnot true>>
			<<if _args[1] is true>>
				<<set _maskFactor to 1>>
			<<elseif playerIsXChanged() and !$gloryhole>>
				<!-- A mask/covered face fully hides you below 500 X-Change fame, only halves recognition from 500-999, and stops concealing you at all at 1000 (max): you're too recognisable by then regardless of your face. -->
				<<if $face isnot "covered" and !$worn.face.type.includes("mask")>>
					<<set _maskFactor to 1>>
				<<elseif $xchange_fame gte 1000>>
					<<set _maskFactor to 1>>
				<<elseif $xchange_fame gte 500>>
					<<set _maskFactor to 0.5>>
				<<else>>
					<<set _maskFactor to 0>>
				<</if>>
			<<else>>
				<<set _maskFactor to 0>>
			<</if>>
			<<if _maskFactor gt 0>>
				<<set $xchange_fame += _args[0] * _maskFactor * 2>>
				<<set $xchange_fame to Math.clamp($xchange_fame, 0, 1000)>>
				<<if $xchange_fame gte 1000>>
					<<for _name range $NPCNameList>>
						<<set $xchange.known.pushUnique(_name)>>
					<</for>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "xchange-seen">>
		<<if $xchange.pill.genderflipEffect>>
			<<set _increase to 10 * _args[0]>>
			<<xchange-fame _increase>>
		<</if>>
	<</widget>>

	<<widget "currentSexSidebar">>
		<<if $options.showCurrentSexIcon>>
			<div id="bodysex-sidebar" class="bodysex-sidebar">
				<<if playerIsXChanged() and $xchange.pill.hermEffect and !$statFreeze>>
					<div tooltip="<span class='green'>Herm</span>"><img dragable="false" src="img/misc/icon/unisex.png"></div>
					
				<<elseif $player.sex is "f">>
					<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and !$xchange.pill.genderflipEffect>>
						<div tooltip="<span class='blue'>Butch</span>"><img dragable="false" src="img/misc/icon/butch.png"></div>
					<<else>>
						<div tooltip="<span class='meek'>Female</span>"><img dragable="false" src="img/misc/icon/female.png"></div>
					<</if>>
				<<elseif $player.sex is "m">>
					<<if !$statFreeze and playerIsXChanged() and $xchange.pill.genderificationEffect and !$xchange.pill.genderflipEffect>>
						<div tooltip="<span class='meek'>Sissy</span>"><img dragable="false" src="img/misc/icon/sissy.png"></div>
					<<else>>
						<div tooltip="<span class='blue'>Male</span>"><img dragable="false" src="img/misc/icon/male.png"></div>
					<</if>>
				<</if>>
			</div>
		<</if>>
	<</widget>>

	<<widget "arousal-wetness">>
		<<if $arousal gte $arousalmax * 0.6>>
			<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 10)>>
		<<elseif $arousal gte $arousalmax * 0.3>>
			<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 5)>>
		<</if>>
	<</widget>>

	<<widget "breeder-heat">>
		<<willpowercombatcheck>>
		<<if !$willpowerSuccess or !$xchange.heat.resistWithWillpower>>
			/* Breeding holes: a vagina always counts; omega (and other butt-pregnancy) heat breeds through the anus. Being bred in any eligible hole satisfies the compulsion. */
			<<set _heatVaginal to $player.vaginaExist and !playerChastity("vagina") and $vaginatarget isnot undefined and $NPCList[$vaginatarget] isnot undefined>>
			<<set _heatAnal to canBeMPregnant() and !playerChastity("anus")>>
			<<set _heatAnalTargeted to _heatAnal and $anustarget isnot undefined and $NPCList[$anustarget] isnot undefined>>
			<<set _vaginalBred to _heatVaginal and ($vaginastate is "penetrated" or $vaginastate is "doublepenetrated")>>
			<<set _analBred to _heatAnal and ($anusstate is "penetrated" or $anusstate is "doublepenetrated")>>
			<<set _beingBred to _vaginalBred or _analBred>>
			<<if _heatVaginal and !_heatAnal>>
				<<if $anusstate is "entrance" and $vaginastate isnot "doublepenetrated">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "penispussy">>
				<</if>>
				<<if $anusstate is "imminent" and $vaginastate isnot "penetrated">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "escape">>
				<</if>>
			<</if>>
			<<if $cheekaction is "rub" and !_beingBred and !_heatAnal>>
				<<set $xchange.heat.message to true>>
				<<set $cheekaction to "stop">>					
			<</if>>
			<<if ($mouthstate is "entrance" or $mouthstate is "imminent" or ($mouthstate is "penetrated" and $head isnot "grappled" and $head isnot "bound")) and !_beingBred>>
				<<set $xchange.heat.message to true>>
				<<set $mouthaction to "pullaway">>
			<</if>>
			<<if $chestuse is "penis" and !_beingBred>>
				<<set $xchange.heat.message to true>>
				<<set $chestaction to "stop">>
			<</if>>
			<<if _heatVaginal and !wearingCondom($vaginatarget) and $vaginastate is "penetrated" and $NPCList[$vaginatarget].penis is "vagina" and $leglocktarget is undefined and $leftleg isnot "bound" and $rightleg isnot "bound">> 
				<<set $xchange.heat.message to true>>
				<<set $feettarget to $vaginatarget>>
				<<set $feetaction to "legLock">>
			<</if>>
			<<if _heatVaginal and !wearingCondom($vaginatarget) and $feetaction is "legRelease">>
				<<set $xchange.heat.message to true>>
				<<set $feetaction to "legLocked">>
			<</if>>
			<<if _heatVaginal and !_beingBred and (($vaginaaction is "penisanus" and !_heatAnal) or $vaginaaction is "penisthighs" or $vaginaaction is "penismouth")>>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "penistease">>
			<</if>>
			<<if _heatVaginal and !_beingBred and !wearingCondom($vaginatarget) and $worn.under_lower.vagina_exposed is 1 and $worn.lower.vagina_exposed is 1 and ($NPCList[$vaginatarget].penis is "vaginaentrance" or $NPCList[$vaginatarget].penis is "vaginaimminent")>>			
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "vaginapenisfuck">>
			<</if>>
			<<if _heatVaginal and !_beingBred and !wearingCondom($vaginatarget) and $NPCList[$vaginatarget].penis is 0 and $NPCList[$vaginatarget].stance isnot "topface" and ($enemytype isnot "man" or ($NPCList[$vaginatarget].location.genitals is 0 and $NPCList[$vaginatarget].location.head isnot "genitals")) and !npcHasStrapon($vaginatarget)>>			
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "vaginatopenis">>
			<</if>>
			<<if $askAction is "condoms">>
				<<set $xchange.heat.message to true>>
				<<set $askAction to "noCondoms">>
			<</if>>
			<<if $askAction is "novaginal" or $askAction is "askPullOut" or $askAction is "finish" or ($askAction is "noanal" and _heatAnal)>>
				<<set $xchange.heat.bypassAsk to true>>
			<</if>>
			<<if _heatVaginal and ($vaginastate is "penetrated" or $vaginastate is "doublepenetrated") and wearingCondom($vaginatarget) and $mouthstate is 0>>
				<<set $xchange.heat.message to true>>
				<<set $mouthtarget to $vaginatarget>>
				<<set $mouthaction to "ask">>
				<<set $askAction to "noCondoms">> 
			<</if>>
			<<if $thighuse is "penis">>
				<<set $xchange.heat.message to true>>
				<<set $thighaction to "stop">>
			<</if>>
			<<if _heatVaginal and $vaginastate is "othermouthimminent">>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "othermouthescape">>
			<</if>>
			<<if _heatVaginal and $vaginastate is "othermouthentrance">>
				<<set $xchange.heat.message to true>>
				<<set $vaginaaction to "thighbay">>
			<</if>>
			/*Arm Actions */
			<<if _heatVaginal and $leftarm isnot "bound" and $rightarm isnot "bound" and !_beingBred>>
				<<set $lefttarget to $vaginatarget>><<set $righttarget to $vaginatarget>>
				<<if $leftaction is "leftcovervaginameek" or $leftaction is "leftcovervaginalewd" or $leftaction is "leftcovervagina" or $leftaction is "leftgrab">>
				<<set $xchange.heat.message to true>>
					<<set $leftaction to "rest">>
				<</if>>
				<<if $rightaction is "rightcovervaginameek" or $rightaction is "rightcovervaginalewd" or $rightaction is "rightcovervagina" or $rightaction is "rightgrab">>
				<<set $xchange.heat.message to true>>
					<<set $rightaction to "rest">>
				<</if>>
				<<if $NPCList[$vaginatarget].penis is "clothed">>
				<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightUndressOther">>
					<<set $undressRightTarget to "lower">>		
				<</if>>
				<<if $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>			
				<<set $xchange.heat.message to true>>
					<<set $leftaction to "lower">><<set $rightaction to "lower">>
					<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
						<<set $xchange.heat.message to true>>
						<<set $rightaction to "under_lower">>	
					<</if>>
				<</if>>
				<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon()) and ($worn.lower.state isnot wornSetupClothes("lower").state_base or wornSetupClothes("lower").skirt is 1 or $worn.lower.type.includes("naked"))>>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "under_lower">>			
				<</if>>
				<<if wearingCondom($vaginatarget)>>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "npcremovecondom">>		
				<</if>>
				<<if (($NPCList[$lefttarget].lefthand and $NPCList[$lefttarget].lefthand.startsWith("vagina")) or ($NPCList[$lefttarget].righthand and $NPCList[$lefttarget].righthand.startsWith("vagina")))>>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "handpullvagina">>
				<</if>>
				<<if $NPCList[$lefttarget].mouth and $NPCList[$lefttarget].mouth.startsWith("vagina")>>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "stoporal">>
				<</if>>
				<<if $leftarm is "vagina">>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "leftstopvagina">>
				<</if>>
				<<if $rightarm is "vagina">>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightstopvagina">>
				<</if>>
				<<if $leftaction is "leftwork">>
					<<set $xchange.heat.message to true>>
					<<set $leftaction to "leftstoppenis">>
				<</if>>
				<<if $rightaction is "rightwork">>
					<<set $xchange.heat.message to true>>
					<<set $rightaction to "rightstoppenis">>
				<</if>>
			<</if>>
			/* Omega: the anus is a breeding hole in its own right — steer toward it, never away from it */
			<<if _heatAnalTargeted>>
				<<if !_beingBred and ["anusentrance","anusimminent"].includes($NPCList[$anustarget].penis) and !wearingCondom($anustarget)>>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "anuspenisfuck">>
				<</if>>
				<<if !_beingBred and (($anusaction is "penispussy" and !_heatVaginal) or ($anusaction is "penispussydap" and !_heatVaginal) or $anusaction is "penismouth" or $anusaction is "penischeeks")>>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "penistease">>
				<</if>>
				<<if !wearingCondom($anustarget) and $anusstate is "penetrated" and $NPCList[$anustarget].penis is "anus" and $leglocktarget is undefined and $leftleg isnot "bound" and $rightleg isnot "bound">>
					<<set $xchange.heat.message to true>>
					<<set $feettarget to $anustarget>>
					<<set $feetaction to "legLock">>
				<</if>>
				<<if _analBred and !wearingCondom($anustarget) and $feetaction is "legRelease">>
					<<set $xchange.heat.message to true>>
					<<set $feetaction to "legLocked">>
				<</if>>
				<<if _analBred and wearingCondom($anustarget) and $mouthstate is 0>>
					<<set $xchange.heat.message to true>>
					<<set $mouthtarget to $anustarget>>
					<<set $mouthaction to "ask">>
					<<set $askAction to "noCondoms">>
				<</if>>
				<<if $anusstate is "othermouthimminent">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "othermouthescape">>
				<</if>>
				<<if $anusstate is "othermouthentrance">>
					<<set $xchange.heat.message to true>>
					<<set $anusaction to "bottombay">>
				<</if>>
				<<if !_heatVaginal>>
					<<if !_beingBred and !wearingCondom($anustarget) and $NPCList[$anustarget].penis is 0 and $NPCList[$anustarget].stance isnot "topface" and ($enemytype isnot "man" or ($NPCList[$anustarget].location.genitals is 0 and $NPCList[$anustarget].location.head isnot "genitals")) and !npcHasStrapon($anustarget)>>
						<<set $xchange.heat.message to true>>
						<<set $anusaction to "anustopenis">>
					<</if>>
					/*Arm Actions */
					<<if $leftarm isnot "bound" and $rightarm isnot "bound" and !_beingBred>>
						<<set $lefttarget to $anustarget>><<set $righttarget to $anustarget>>
						<<if $NPCList[$anustarget].penis is "clothed">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightUndressOther">>
							<<set $undressRightTarget to "lower">>
						<</if>>
						<<if $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "lower">><<set $rightaction to "lower">>
							<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
								<<set $xchange.heat.message to true>>
								<<set $rightaction to "under_lower">>
							<</if>>
						<</if>>
						<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon()) and ($worn.lower.state isnot wornSetupClothes("lower").state_base or wornSetupClothes("lower").skirt is 1 or $worn.lower.type.includes("naked"))>>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "under_lower">>
						<</if>>
						<<if wearingCondom($anustarget)>>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "npcremovecondom">>
						<</if>>
						<<if (($NPCList[$lefttarget].lefthand and $NPCList[$lefttarget].lefthand.startsWith("anus")) or ($NPCList[$lefttarget].righthand and $NPCList[$lefttarget].righthand.startsWith("anus")))>>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "handpullanus">>
						<</if>>
						<<if $leftarm is "anus">>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "leftstopanus">>
						<</if>>
						<<if $rightarm is "anus">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightstopanus">>
						<</if>>
						<<if $leftaction is "leftwork">>
							<<set $xchange.heat.message to true>>
							<<set $leftaction to "leftstoppenis">>
						<</if>>
						<<if $rightaction is "rightwork">>
							<<set $xchange.heat.message to true>>
							<<set $rightaction to "rightstoppenis">>
						<</if>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "breeder-heat-chastity">>
		<<willpowercombatcheck>>
		<<if !$willpowerSuccess or !$xchange.heat.resistWithWillpower>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">Your heat consumes you,</span> <span class="pink">but your $worn.genitals.name keeps you from being bred.</span>
			<<else>>
				<span class="red">An overwhelming need to breed overcomes you,</span> <span class="pink">but your $worn.genitals.name is in the way.</span>
			<</if>>
			<<if $leftarm isnot "bound" and $rightarm isnot "bound" and $worn.lower.state is wornSetupClothes("lower").state_base and (wornSetupClothes("lower").skirt isnot 1 or (wornSetupClothes("lower").skirt is 1 and $worn.lower.skirt_down is 1)) and !$worn.lower.type.includes("naked")>>
				/* The device is still hidden: tear at the clothes covering it, mirroring the unlocked undress compulsion */
				<span class="purple">Your hands tear at the clothes covering it.</span>
				<<set $leftaction to "lower">><<set $rightaction to "lower">>
				<<if $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
					<<set $rightaction to "under_lower">>
				<</if>>
			<<elseif $leftarm isnot "bound" and $rightarm isnot "bound" and $worn.under_lower.state is wornSetupClothes("under_lower").state_base and !$worn.under_lower.type.includes("naked") and !($penisstate isnot 0 and playerHasStrapon())>>
				<span class="purple">Your hands tear at the clothes covering it.</span>
				<<set $rightaction to "under_lower">>
			<<elseif $worn.genitals.name is "chastity parasite">>
				<span class="purple">You grab at the creature clinging to your groin and try to pull it away,</span> <span class="lewd">but it tightens around you, making your arousal worse.</span>
				<<set $worn.genitals.integrity -= 5>><<arousal 100 "genitals">>
				<<integritycheck>>
			<<elseif $leftarm isnot "bound" and $rightarm isnot "bound">>
				<span class="purple">Your hands claw and wrench at the device, straining against its lock.</span>
				<<set $worn.genitals.integrity -= 20>>
				<<integritycheck>>
			<<elseif $leftarm isnot "bound" or $rightarm isnot "bound">>
				<span class="purple">Your free hand claws and tugs at the device, straining against its lock.</span>
				<<set $worn.genitals.integrity -= 10>>
				<<integritycheck>>
			<<else>>
				<span class="purple">Restrained, you can only writhe and grind against the device.</span>
			<</if>>
			<<if playerAwareTheyCanBePregnant()>>
				<span class="lewd">Part of you desperately wants someone to come over the seams, hoping some of it slips through.</span>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "effectsman-xchange">>
		/*Heat Message */
		<<if $xchange.heat.systemOn and playerHeatMinArousal() and $position isnot "stalk">>
			/* A combined Alpha/Breeder/Omega body follows its dominant rut while its penis is usable. If caged, receptive heat can still take over. */
			<<set _alphaDominantHeat to !$statFreeze and playerIsXChanged() and $xchange.pill.alphaEffect and $player.penisExist and !playerChastity("penis")>>
			<<set _heatVaginalTrigger to false>>
			<<set _heatAnalTrigger to false>>
			<<if $player.vaginaExist and !playerChastity("vagina") and $vaginatarget isnot undefined>>
				<<set _vaginaNpc to $NPCList[$vaginatarget]>>
				<<set _vaginaNpcPenisLocked to (_vaginaNpc and _vaginaNpc.chastity and _vaginaNpc.chastity.penis and _vaginaNpc.chastity.penis.includes("chastity"))>>
				<<set _heatVaginalTrigger to _vaginaNpc isnot undefined and _vaginaNpc.penis isnot "none" and $vaginastate isnot "othermouth" and !_vaginaNpcPenisLocked>>
			<</if>>
			/* Omega (and other butt-pregnancy) heat also answers to the anus */
			<<if canBeMPregnant() and !playerChastity("anus") and $anustarget isnot undefined>>
				<<set _anusNpc to $NPCList[$anustarget]>>
				<<set _anusNpcPenisLocked to (_anusNpc and _anusNpc.chastity and _anusNpc.chastity.penis and _anusNpc.chastity.penis.includes("chastity"))>>
				<<set _heatAnalTrigger to _anusNpc isnot undefined and _anusNpc.penis isnot "none" and $anusstate isnot "othermouth" and !_anusNpcPenisLocked>>
			<</if>>
			<<if (_heatVaginalTrigger or _heatAnalTrigger) and !_alphaDominantHeat>>
				<<breeder-heat>>
			<<elseif !_alphaDominantHeat and !($player.vaginaExist and !playerChastity("vagina")) and !(canBeMPregnant() and !playerChastity("anus"))>>
				/* Every eligible breeding hole is locked behind chastity: heat rails against the device instead of going quiet */
				<<set _heatLockedNpcPresent to $NPCList.some(npc => npc && npc.active === "active" && npc.penis !== "none" && !(npc.chastity && npc.chastity.penis && npc.chastity.penis.includes("chastity")))>>
				<<if _heatLockedNpcPresent>>
					<<breeder-heat-chastity>>
				<</if>>
			<</if>>
		<</if>>
		<<if $xchange.heat.message>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">Your heat consumes you.</span> <span class="gold">Lust overrides your actions.</span>
			<<else>>
				<span class="red">An overwhelming need to breed overcomes you.</span> <span class="gold">Lust overrides your actions.</span>
			<</if>>
			<<set $xchange.heat.message to false>>
		<</if>>
