<</widget>>

	<<widget "pleasurecaption">>
		<<if Number.isFinite($pleasure)>>
			<div id="pleasurecaption" @title="'Pleasure: ' + $pleasure.toFixed(2)">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					Pleasure:
					<<if $options.showCaptionText is true>>
						<<if $pleasure gte $pleasuremax>>
							<span class="red">About to burst.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 4>>
							<span class="pink">A climax rises.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 3>>
							<span class="purple">You feel flushed.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
							<span class="blue">You feel hot.</span>
						<<elseif $pleasure gte $pleasuremax / 5>>
							<span class="lblue">You feel tingly.</span>
						<<elseif $pleasure gte 1>>
							<span class="teal">You feel itchy.</span>
						<<else>>
							<span class="green">You feel normal.</span>
						<</if>>
					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<glowstatbar 0 $pleasure $pleasuremax _showCaptionText>>
			</div>
		<</if>>
	<</widget>>

	<<widget "enemypleasure">>
		<<set _change to _args[0]>>
		<<set _arousalModifier to $enemyarousal / $enemyarousalmax>>
		<<set _enemySexModifier to _enemies gt 1 or $NPCList[0].gender isnot "m" or _change lt 0 or $timer? 1 : 0.5>>
		<<set $enemypleasure += _change * _arousalModifier * _enemySexModifier>>
	<</widget>>

	<<widget "enemypleasure-edge">>
		<<set _change to _args[0]>>
		<<set _initialpleasure to $enemypleasure>>

		<<enemypleasure _change>>
		<<set $enemypleasure to Math.clamp($enemypleasure, Math.min(_initialpleasure, $enemypleasuremax / 5), $enemypleasuremax)>>
	<</widget>>

	<<widget "effectsman-xchange">>
		/*Heat Message */

		<<if $vaginatarget isnot undefined and $xchange.heat.systemOn and !playerChastity("vagina") and playerHeatMinArousal()>>
			<<set _vaginaNpc to $NPCList[$vaginatarget]>>
			<<set _vaginaNpcPenisLocked to (_vaginaNpc and _vaginaNpc.chastity and _vaginaNpc.chastity.penis and _vaginaNpc.chastity.penis.includes("chastity"))>>
			<<if $position isnot "stalk" and _vaginaNpc and _vaginaNpc.penis isnot "none" and $vaginastate isnot "othermouth" and !_vaginaNpcPenisLocked>>
				<<breeder-heat>>
			<</if>>
		<</if>>

		<<if $xchange.heat.message>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">Your heat consumes you.</span> <span class="gold">Lust overrides your actions.</span>
			<<else>>
				<span class="red">An overwhelming need to breed overcomes you.</span> <span class="gold">Lust overrides your actions.</span>
			<</if>>
			<<set $xchange.heat.message to false>>
		<</if>>

		<<encounterIdentityEffects>>
	<</widget>>

	<<widget "xchangeSkinColourVariableCombine">>
		<<if _xchangeSkinTone is "no">><<set _xchangeSkinShade to "change">><</if>>
		<<set $xchange.customisedSkinColour to _xchangeSkinTone + _xchangeSkinShade>>
	<</widget>>

<<widget "xchange-suspicious-pill">>
	<<set _dur to random(1,3)>>

	/* Always flip */
	<<set _effects to ["genderflip"]>>

	/* Add 1 totally random extra effect (NOT using spikepool) */
	<<set _pool to ["genderflip","crossdress","herm","breeder","passion","innocence","swell","bimbo","cumcure","bull","xtend"]>>
	<<if $portalPantiesEnabled>><<run _pool.push("portal")>><</if>>

	<<run _effects.push(_pool.random())>>

	/* Optional: 25% chance of a second extra effect */
	<<if random(1,100) lte 25>>
		<<run _effects.push(_pool.random())>>
	<</if>>

	/* Optional: remove duplicates */
	<<run _effects = [...new Set(_effects)]>>

	<<if !playerIsXChanged()>>
		<<save-body>>
		<<xchange-effects _dur _effects>>
		<<exposedcheck>>

		<<if $xchange.pill.genderflipEffect>>
			<<if $xchange.blackmail.intro>><<set $xchange.blackmail.hasGenderswapped to true>><</if>>
			<<if $xchange.blackmail.activeQuest>><<set $xchange.blackmail.hasGenderswappedRecently to true>><</if>>
		<</if>>

		<<set $xchange.timesTaken.player++>>
	<</if>>
<</widget>>