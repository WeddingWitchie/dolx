			<<set $speechcycle to random(0,7)>>
			<<if $speechcycle gte 7>>
				<<set $speechcycle to 0>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "willpowercaption">>
		<<if Number.isFinite($arousal)>>
			<div id="willpowercaption" @title="'Willpower: ' + $xchange.willpowerPoints.toFixed(2)">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					Willpower:
					<<if $options.showCaptionText is true>>
						<<if $xchange.willpowerPoints gte $willpowermax * (6/5)>>
							<span class="gold">You are ironclad.</span>
						<<elseif $xchange.willpowerPoints gte $willpowermax>>
							<span class="green">You are resolute.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 4>>
							<span class="teal">You feel tenacious.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 3>>
							<span class="lblue">You feel resolved.</span>
						<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 2>>
							<span class="blue">You feel determined.</span>
						<<elseif $xchange.willpowerPoints gte $willpowermax / 5>>
							<span class="purple">You are faltering.</span>
						<<elseif $xchange.willpowerPoints gte 1>>
							<span class="pink">You are wavering.</span>
						<<else>>
							<span class="red">You surrender.</span>
						<</if>>
					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<amcstatbarinverted $xchange.willpowerPoints $willpowermax _showCaptionText>>
				<div style="clear:both;"></div>
			</div>
		<</if>>
	<</widget>>

	<<widget "willpowercombatcheck">>
		<<if $xchange.willpowerSystemEnabled is 1>>
			<<if $arousal gte ($arousalmax * 3 / 5) or $orgasmcount gt 0>>
				<<silently>><<willpowerdifficulty 1 800>><</silently>>
				<<if $willpowerSuccess>>
					<<willpowersuccess>>
				<<else>>
					<<willpowerfailure>>
				<</if>>
			<<else>>
				<<set $willpowerSuccess to 1>>
			<</if>>
		<<else>>
			<<set $willpowerSuccess to 1>>
		<</if>>
	<</widget>>

	<<widget "willpowercheck">>
		<<if _args[0] isnot undefined>>
			<<set _difficulty to _args[0]>>
		<<else>>
			<<set _difficulty to 1000>>
		<</if>>
		<<silently>><<willpowerdifficulty 1 _difficulty>><</silently>>
		<<if $xchange.willpowerSystemEnabled is 1>>
			<<if $willpowerSuccess>>
				<<willpowersuccess>>
			<<else>>
				<<willpowerfailure>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "willpowersuccess">>
		<<willpower-spending $xchange.willpowerSuccessCost>>
	<</widget>>

	<<widget "willpowerfailure">>
		<<willpower-spending $xchange.willpowerFailureCost>>
	<</widget>>

	<<widget "willpower-spending">>
		<<if _args[0] is undefined>>
			<<set _willpowerExpenditure to 25>>
		<<else>>
			<<set _willpowerExpenditure to _args[0]>>
		<</if>>

		<<set $xchange.willpowerPoints -= _willpowerExpenditure>>
		<<willpowerpoints-clamp>>
	<</widget>>

	<<widget "willpower-recovery">>
		<<if _args[0] is undefined>>
			<<set _willpowerRecovery to 25>>
		<<else>>
			<<set _willpowerRecovery to _args[0]>>
		<</if>>

		<<set $xchange.willpowerPoints += _willpowerRecovery>>
		<<willpowerpoints-clamp>>
	<</widget>>

	<<widget "willpowerpoints-clamp">>
		<<set $xchange.willpowerPoints to Math.clamp($xchange.willpowerPoints, 0, Math.max(200, $willpower))>>
	<</widget>>

	<<widget "willpower-orgasm">>
		<<set _deniedOrgasm to _args[0]>>
