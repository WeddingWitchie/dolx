	<<widget "location-danger">>
		<<set _locationDanger to 0>>
		<<if $location is "town">>
			<<switch $bus>>
				<<case "barb">>
					<<set _locationDanger to 500>>
				<<case "cliff">>
					<<set _locationDanger to 500>>
				<<case "connudatus">>
					<<set _locationDanger to 1000>>
				<<case "danube">>
					<<set _locationDanger to 0>>
				<<case "domus">>
					<<set _locationDanger to 500>>
				<<case "elk">>
					<<set _locationDanger to 2000>>
				<<case "harvest">>
					<<set _locationDanger to 1500>>
				<<case "high">>
					<<set _locationDanger to 1000>>
				<<case "mer">>
					<<set _locationDanger to 1000>>
				<<case "nightingale">>
					<<set _locationDanger to 1000>>
				<<case "oxford">>
					<<set _locationDanger to 1000>>
				<<case "starfish">>
					<<set _locationDanger to 1000>>
				<<case "wolf">>
					<<set _locationDanger to 500>>
			<</switch>>	

		<<elseif $location is "alley">>
			<<switch $bus>>
				<<case "commercial">>
					<<set _locationDanger to 1500>>
				<<case "industrial">>
					<<set _locationDanger to 2000>>
				<<case "park">>
					<<set _locationDanger to 1000>>
				<<case "residential">>
					<<if $town_projects.thicket is 4>>
						<<set _locationDanger to 500>>
					<<else>>
						<<set _locationDanger to 1000>>
					<</if>>

			<</switch>>

		<<elseif $location is "flats">>
			<<set _locationDanger to 1000>>
			
		<<elseif $location is "canals">>
			<<set _locationDanger to 1500>>

		<</if>>
	<</widget>>

