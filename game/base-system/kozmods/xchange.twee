					<label data-target='["identity.body.bottom.medium.reject", "identity.init"]' data-disabledif="V.identity.body.bottom.medium.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bottom.medium.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bottom.medium.acceptance"]' data-disabledif="!V.identity.body.bottom.medium.acceptance" class="green">Preferred <<radiobutton "$identity.body.bottom.preferred" "medium" autocheck>></label>
				<br>
				Big: 
				<br> 
				<label data-target='["identity.body.bottom.big.acceptance"]' data-disabledif="V.identity.body.bottom.big.acceptance" class="red">Reject <<checkbox "$identity.body.bottom.big.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.bottom.preferred", "identity.init"]' data-disabledif="V.identity.body.bottom.preferred === 'big' || V.identity.init">Unaccepted <<radiobutton "$identity.body.bottom.big.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.bottom.big.reject", "identity.init"]' data-disabledif="V.identity.body.bottom.big.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bottom.big.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bottom.big.acceptance"]' data-disabledif="!V.identity.body.bottom.big.acceptance" class="green">Preferred <<radiobutton "$identity.body.bottom.preferred" "big" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Genitals </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Vagina: 
				<br> 
				<label data-target='["identity.body.genitals.vagina.acceptance"]' data-disabledif="V.identity.body.genitals.vagina.acceptance" class="red">Reject <<checkbox "$identity.body.genitals.vagina.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.genitals.preferred", "identity.init"]' data-disabledif="V.identity.body.genitals.preferred === 'vagina' || V.identity.init">Unaccepted <<radiobutton "$identity.body.genitals.vagina.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.genitals.vagina.reject", "identity.init"]' data-disabledif="V.identity.body.genitals.vagina.reject || V.identity.init">Accepted <<radiobutton "$identity.body.genitals.vagina.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.genitals.vagina.acceptance"]' data-disabledif="!V.identity.body.genitals.vagina.acceptance" class="green">Preferred <<radiobutton "$identity.body.genitals.preferred" "vagina" autocheck>></label>
				<br>
				Small Penis: 
				<br> 
				<label data-target='["identity.body.genitals.smallpenis.acceptance"]' data-disabledif="V.identity.body.genitals.smallpenis.acceptance" class="red">Reject <<checkbox "$identity.body.genitals.smallpenis.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.genitals.preferred", "identity.init"]' data-disabledif="V.identity.body.genitals.preferred === 'smallpenis' || V.identity.init">Unaccepted <<radiobutton "$identity.body.genitals.smallpenis.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.genitals.smallpenis.reject", "identity.init"]' data-disabledif="V.identity.body.genitals.smallpenis.reject || V.identity.init">Accepted <<radiobutton "$identity.body.genitals.smallpenis.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.genitals.smallpenis.acceptance"]' data-disabledif="!V.identity.body.genitals.smallpenis.acceptance" class="green">Preferred <<radiobutton "$identity.body.genitals.preferred" "smallpenis" autocheck>></label>
				<br>
				Medium Penis: 
				<br> 
				<label data-target='["identity.body.genitals.mediumpenis.acceptance"]' data-disabledif="V.identity.body.genitals.mediumpenis.acceptance" class="red">Reject <<checkbox "$identity.body.genitals.mediumpenis.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.genitals.preferred", "identity.init"]' data-disabledif="V.identity.body.genitals.preferred === 'mediumpenis' || V.identity.init">Unaccepted <<radiobutton "$identity.body.genitals.mediumpenis.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.genitals.mediumpenis.reject", "identity.init"]' data-disabledif="V.identity.body.genitals.mediumpenis.reject || V.identity.init">Accepted <<radiobutton "$identity.body.genitals.mediumpenis.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.genitals.mediumpenis.acceptance"]' data-disabledif="!V.identity.body.genitals.mediumpenis.acceptance" class="green">Preferred <<radiobutton "$identity.body.genitals.preferred" "mediumpenis" autocheck>></label>
				<br>
				Big Penis: 
				<br> 
				<label data-target='["identity.body.genitals.bigpenis.acceptance"]' data-disabledif="V.identity.body.genitals.bigpenis.acceptance" class="red">Reject <<checkbox "$identity.body.genitals.bigpenis.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.genitals.preferred", "identity.init"]' data-disabledif="V.identity.body.genitals.preferred === 'bigpenis' || V.identity.init">Unaccepted <<radiobutton "$identity.body.genitals.bigpenis.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.genitals.bigpenis.reject", "identity.init"]' data-disabledif="V.identity.body.genitals.bigpenis.reject || V.identity.init">Accepted <<radiobutton "$identity.body.genitals.bigpenis.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.genitals.bigpenis.acceptance"]' data-disabledif="!V.identity.body.genitals.bigpenis.acceptance" class="green">Preferred <<radiobutton "$identity.body.genitals.preferred" "bigpenis" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Hair Length </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Short: 
				<br> 
				<label data-target='["identity.body.hairlength.short.acceptance"]' data-disabledif="V.identity.body.hairlength.short.acceptance" class="red">Reject <<checkbox "$identity.body.hairlength.short.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.hairlength.preferred", "identity.init"]' data-disabledif="V.identity.body.hairlength.preferred === 'short' || V.identity.init">Unaccepted <<radiobutton "$identity.body.hairlength.short.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.hairlength.short.reject", "identity.init"]' data-disabledif="V.identity.body.hairlength.short.reject || V.identity.init">Accepted <<radiobutton "$identity.body.hairlength.short.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.hairlength.short.acceptance"]' data-disabledif="!V.identity.body.hairlength.short.acceptance" class="green">Preferred <<radiobutton "$identity.body.hairlength.preferred" "short" autocheck>></label>
				<br>
				Medium: 
				<br> 
				<label data-target='["identity.body.hairlength.medium.acceptance"]' data-disabledif="V.identity.body.hairlength.medium.acceptance" class="red">Reject <<checkbox "$identity.body.hairlength.medium.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.hairlength.preferred", "identity.init"]' data-disabledif="V.identity.body.hairlength.preferred === 'medium' || V.identity.init">Unaccepted <<radiobutton "$identity.body.hairlength.medium.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.hairlength.medium.reject", "identity.init"]' data-disabledif="V.identity.body.hairlength.medium.reject || V.identity.init">Accepted <<radiobutton "$identity.body.hairlength.medium.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.hairlength.medium.acceptance"]' data-disabledif="!V.identity.body.hairlength.medium.acceptance" class="green">Preferred <<radiobutton "$identity.body.hairlength.preferred" "medium" autocheck>></label>
				<br>
				Long: 
				<br> 
				<label data-target='["identity.body.hairlength.long.acceptance"]' data-disabledif="V.identity.body.hairlength.long.acceptance" class="red">Reject <<checkbox "$identity.body.hairlength.long.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.hairlength.preferred", "identity.init"]' data-disabledif="V.identity.body.hairlength.preferred === 'long' || V.identity.init">Unaccepted <<radiobutton "$identity.body.hairlength.long.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.hairlength.long.reject", "identity.init"]' data-disabledif="V.identity.body.hairlength.long.reject || V.identity.init">Accepted <<radiobutton "$identity.body.hairlength.long.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.hairlength.long.acceptance"]' data-disabledif="!V.identity.body.hairlength.long.acceptance" class="green">Preferred <<radiobutton "$identity.body.hairlength.preferred" "long" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Body Size </span> <mouse class = "tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Tiny: 
				<br> 
				<label data-target='["identity.body.bodysize.tiny.acceptance"]' data-disabledif="V.identity.body.bodysize.tiny.acceptance" class="red">Reject <<checkbox "$identity.body.bodysize.tiny.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.bodysize.preferred", "identity.init"]' data-disabledif="V.identity.body.bodysize.preferred === 'tiny' || V.identity.init">Unaccepted <<radiobutton "$identity.body.bodysize.tiny.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.bodysize.tiny.reject", "identity.init"]' data-disabledif="V.identity.body.bodysize.tiny.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bodysize.tiny.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bodysize.tiny.acceptance"]' data-disabledif="!V.identity.body.bodysize.tiny.acceptance" class="green">Preferred <<radiobutton "$identity.body.bodysize.preferred" "tiny" autocheck>></label>
				<br>
				Small: 
				<br> 
				<label data-target='["identity.body.bodysize.small.acceptance"]' data-disabledif="V.identity.body.bodysize.small.acceptance" class="red">Reject <<checkbox "$identity.body.bodysize.small.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.bodysize.preferred", "identity.init"]' data-disabledif="V.identity.body.bodysize.preferred === 'small' || V.identity.init">Unaccepted <<radiobutton "$identity.body.bodysize.small.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.bodysize.small.reject", "identity.init"]' data-disabledif="V.identity.body.bodysize.small.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bodysize.small.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bodysize.small.acceptance"]' data-disabledif="!V.identity.body.bodysize.small.acceptance" class="green">Preferred <<radiobutton "$identity.body.bodysize.preferred" "small" autocheck>></label>
				<br>
				Normal: 
				<br> 
				<label data-target='["identity.body.bodysize.normal.acceptance"]' data-disabledif="V.identity.body.bodysize.normal.acceptance" class="red">Reject <<checkbox "$identity.body.bodysize.normal.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.bodysize.preferred", "identity.init"]' data-disabledif="V.identity.body.bodysize.preferred === 'normal' || V.identity.init">Unaccepted <<radiobutton "$identity.body.bodysize.normal.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.bodysize.normal.reject", "identity.init"]' data-disabledif="V.identity.body.bodysize.normal.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bodysize.normal.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bodysize.normal.acceptance"]' data-disabledif="!V.identity.body.bodysize.normal.acceptance" class="green">Preferred <<radiobutton "$identity.body.bodysize.preferred" "normal" autocheck>></label>
				<br>
				Large: 
				<br> 
				<label data-target='["identity.body.bodysize.large.acceptance"]' data-disabledif="V.identity.body.bodysize.large.acceptance" class="red">Reject <<checkbox "$identity.body.bodysize.large.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.bodysize.preferred", "identity.init"]' data-disabledif="V.identity.body.bodysize.preferred === 'large' || V.identity.init">Unaccepted <<radiobutton "$identity.body.bodysize.large.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.bodysize.large.reject", "identity.init"]' data-disabledif="V.identity.body.bodysize.large.reject || V.identity.init">Accepted <<radiobutton "$identity.body.bodysize.large.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.bodysize.large.acceptance"]' data-disabledif="!V.identity.body.bodysize.large.acceptance" class="green">Preferred <<radiobutton "$identity.body.bodysize.preferred" "large" autocheck>></label>
				<br>
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Fecundity </span> <mouse class = "tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Lactation: 
				<br> 
				<label data-target='["identity.body.lactation.acceptance"]' data-disabledif="V.identity.body.lactation.acceptance" class="red">Reject <<checkbox "$identity.body.lactation.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.lactation.preferred", "identity.init"]' data-disabledif="V.identity.body.lactation.preferred === 'lactation' || V.identity.init">Unaccepted <<radiobutton "$identity.body.lactation.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.lactation.reject", "identity.init"]' data-disabledif="V.identity.body.lactation.reject || V.identity.init">Accepted <<radiobutton "$identity.body.lactation.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.lactation.acceptance"]' data-disabledif="!V.identity.body.lactation.acceptance" class="green">Preferred <<checkbox "$identity.body.lactation.preferred" "none" "lactation" autocheck>></label>
				<br>
				Pregnancy: 
				<br> 
				<label data-target='["identity.body.pregnancy.acceptance"]' data-disabledif="V.identity.body.pregnancy.acceptance" class="red">Reject <<checkbox "$identity.body.pregnancy.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.body.pregnancy.preferred", "identity.init"]' data-disabledif="V.identity.body.pregnancy.preferred === 'pregnancy' || V.identity.init">Unaccepted <<radiobutton "$identity.body.pregnancy.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.pregnancy.reject", "identity.init"]' data-disabledif="V.identity.body.pregnancy.reject || V.identity.init">Accepted <<radiobutton "$identity.body.pregnancy.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.pregnancy.acceptance"]' data-disabledif="!V.identity.body.pregnancy.acceptance" class="green">Preferred <<checkbox "$identity.body.pregnancy.preferred" "none" "pregnancy" autocheck>></label>
				<br>
			</div>

		</div>

	<</widget>>

	<<widget "lockInIdentitySetting">>
		<div class="settingsGrid">
			<div class="settingsToggleItem">
				<label data-target="['identity.init']" data-disabledif="V.identity.init > 1">Lock Choices <<if $identity.init lt 2>><<checkbox "$identity.init" $identity.init 1 autocheck>><<else>><<checkbox "$identity.init" $identity.init 2 autocheck>><</if>></label>
			</div>
		</div>
	<</widget>>
	
	<<widget "dysphoriaBar">>
		<div @class="(_args[3] is true ? 'rightMeter' : 'meter')">
			<<if _args[1] is 0>>
			<<else>>
				<<set _percent to Math.floor((_args[1]/_args[2])*100)>>
				<<set _minPercent to Math.clamp(Math.floor((_args[0]/_args[2])*100), 0, _percent)>>
				<<set _pin to Math.clamp(Math.floor((_args[4]/_args[2])*100), 0, _args[2])>>
				<<switch Math.floor(_percent/10)>>
					<<case 7 8>><<set _statColor to "pinkbar">>
					<<case 5 6>><<set _statColor to "purplebar">>
					<<case 3 4>><<set _statColor to "bluebar">>
					<<case 1 2>><<set _statColor to "lbluebar">>
					<<case 0>><<set _statColor to "tealbar">>
					<<default>><<set _statColor to "redbar">>
				<</switch>>
				<<set _tolPercent to 100>>
				<div class="whitebar" style="width:100%">
				<div class="meter" @style="'width:' + _tolPercent + '%'"></div>
				</div>
				<div @class="_statColor" @style="'width:' + _percent + '%'"></div>
			<</if>>
		</div>
	<</widget>>

	<<widget "identity-box-simple">>
		<<set _boxConfig = _args[0]>>
		<div class="relation-box" @style="(_boxConfig.style || '')">
			<<if _boxConfig.name>>
				<div class="relation-top-line">
					_boxConfig.icon
					<span class="relation-name">_boxConfig.name: _boxConfig.status</span>		
				</div>
			<</if>>
			<div class="identity-description">
				Tolerance
				_boxConfig.tolerance
			</div>
			<div class="identity-description">
				<<if _boxConfig.active>>
					<span @class="'red ' + basicJitterCss()">Dysphoria</span>
				<<else>>
					Dysphoria
				<</if>>
				_boxConfig.dysphoria
			</div>
		</div>
	<</widget>>

	<<widget "identityStatus">>
		<<if _args[1]>>
			<<if !_args[0].reject>>
				<span class="green">Preferred</span>
			<<else>>
				<span @class="'red ' + basicJitterCss()">Preferred</span>
			<</if>>
		<<elseif _args[0].acceptance>>
			<<if !_args[0].reject>>
				<span class="blue">Accepted</span>
			<<else>>
				<span @class="'red ' + basicJitterCss()">Begrudged</span>
			<</if>>
		<<elseif !_args[0]?.reject>>
			<span class="purple">Not accepted</span>
		<<else>>
			<span class="red">Rejected</span>
		<</if>>
	<</widget>>

	<<widget "identityScreen">>	
		<div class="identity-box-list">
			<div class="settingsGrid">
				<div class="settingsToggleItemWide">
					<ul class="small-description">
						<li>Accepted characteristics don't have negative effects. You can have one preferred characteristic from accepted characterisitcs in each category, which grants minor Stress and Trauma reduction when you have them.</li>
						<li>You gain dysphoria for each characterisitc you have that you haven't accepted, which increases Stress and Trauma.</li>
						<li>You gain daily tolerance towards characteristics you have that you haven't accepted, until you reach acceptance at max tolerance.</li>
						<li>You don't gain Trauma from Rejected characteristics, but you don't gain Tolerance towards it either. Staying at maximum Dysphoria in a Rejected characteristic is dangerous.</li>
					</ul>
				</div>
				<<for _categoryName, _category range setup.identityIndex>>
					<div class="settingsHeader">
						<span class="gold bold">_categoryName</span><br>
					</div>
					<<for _char, _icon range _category>>
						<<identitySelector _char>>
						<<if $identityOption>>
							<<silently>>
								<<set _active to (playerHasCharacteristic(_char) and (!$identityOption.acceptance or $identityOption.reject))>>
								<<set _identityConfig = { 
									name: _char, 
									icon: _icon,
									status: "<<identityStatus $identityOption $identityPreference>>", 
									tolerance: "<<statbarinverted $identityOption.tolerance 100>>", 
									dysphoria: "<<statbar 0 $identityOption.dysphoria 100>>", 
									active: _active
								}>>
							<</silently>>
							<<identity-box-simple _identityConfig>>
						<</if>>
					<</for>>
				<</for>>
			</div>
		</div>
	<</widget>>

	<<widget "titleIdentity">>
		<<setupTabs>>
		<div id="overlayTabs" class="tab">
			<<closeButtonMobile>>
			<<button "Characteristics">>
				<<toggleTab>>
				<<replace #customOverlayContent>><<characteristics>><</replace>>
			<</button>>
			<<button "Identity">>
				<<toggleTab>>
				<<set $tempDisable to true>>
				<<replace #customOverlayContent>><<identityScreen>><</replace>>
			<</button>>
			<<colourCodes>>
		</div>
		<<closeButton>>
	<</widget>>

	<<widget "identitySelector">>
		<<if _args[0] isnot undefined>>
			<<switch _args[0]>>
			<<case "Masculine Clothing">>
				<<set $identityOption to $identity.presentation.clothing.masculine>>
				<<set $identityPreference to $identity.presentation.clothing.preferred is "m" ? true : false>>
			<<case "Feminine Clothing">>
				<<set $identityOption to $identity.presentation.clothing.feminine>>
				<<set $identityPreference to $identity.presentation.clothing.preferred is "f" ? true : false>>
			<<case "Masculine Appearance">>
				<<set $identityOption to $identity.presentation.appearance.masculine>>
				<<set $identityPreference to $identity.presentation.appearance.preferred is "m" ? true : false>>
			<<case "Feminine Appearance">>
				<<set $identityOption to $identity.presentation.appearance.feminine>>
				<<set $identityPreference to $identity.presentation.appearance.preferred is "f" ? true : false>>
			<<case "Masculine Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.masculine>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "m" ? true : false>>
			<<case "Feminine Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.feminine>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "f" ? true : false>>
			<<case "Neutral Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.neutral>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "n" ? true : false>>
			<<case "Flat Chest">>
				<<set $identityOption to $identity.body.chest.flat>>
				<<set $identityPreference to $identity.body.chest.preferred is "flat" ? true : false>>
			<<case "Small Breasts">>
				<<set $identityOption to $identity.body.chest.small>>
				<<set $identityPreference to $identity.body.chest.preferred is "small" ? true : false>>
			<<case "Medium Breasts">>
				<<set $identityOption to $identity.body.chest.medium>>
				<<set $identityPreference to $identity.body.chest.preferred is "medium" ? true : false>>
			<<case "Big Breasts">>
				<<set $identityOption to $identity.body.chest.big>>
				<<set $identityPreference to $identity.body.chest.preferred is "big" ? true : false>>
			<<case "Small Ass">>
				<<set $identityOption to $identity.body.bottom.small>>
				<<set $identityPreference to $identity.body.bottom.preferred is "small" ? true : false>>
			<<case "Medium Ass">>
				<<set $identityOption to $identity.body.bottom.medium>>
				<<set $identityPreference to $identity.body.bottom.preferred is "medium" ? true : false>>
			<<case "Big Ass">>
				<<set $identityOption to $identity.body.bottom.big>>
				<<set $identityPreference to $identity.body.bottom.preferred is "big" ? true : false>>
			<<case "Vagina">>
				<<set $identityOption to $identity.body.genitals.vagina>>
				<<set $identityPreference to $identity.body.genitals.preferred is "vagina" ? true : false>>
			<<case "Small Penis">>
				<<set $identityOption to $identity.body.genitals.smallpenis>>
				<<set $identityPreference to $identity.body.genitals.preferred is "smallpenis" ? true : false>>
			<<case "Medium Penis">>
				<<set $identityOption to $identity.body.genitals.mediumpenis>>
				<<set $identityPreference to $identity.body.genitals.preferred is "mediumpenis" ? true : false>>
			<<case "Big Penis">>
				<<set $identityOption to $identity.body.genitals.bigpenis>>
				<<set $identityPreference to $identity.body.genitals.preferred is "bigpenis" ? true : false>>
			<<case "Short Hair">>
				<<set $identityOption to $identity.body.hairlength.short>>
				<<set $identityPreference to $identity.body.hairlength.preferred is "short" ? true : false>>
			<<case "Medium Hair">>
				<<set $identityOption to $identity.body.hairlength.medium>>
				<<set $identityPreference to $identity.body.hairlength.preferred is "medium" ? true : false>>
			<<case "Long Hair">>
				<<set $identityOption to $identity.body.hairlength.long>>
				<<set $identityPreference to $identity.body.hairlength.preferred is "long" ? true : false>>
			<<case "Tiny Body">>
				<<set $identityOption to $identity.body.bodysize.tiny>>
				<<set $identityPreference to $identity.body.bodysize.preferred is "tiny" ? true : false>>
			<<case "Small Body">>
				<<set $identityOption to $identity.body.bodysize.small>>
				<<set $identityPreference to $identity.body.bodysize.preferred is "small" ? true : false>>
			<<case "Normal Body">>
				<<set $identityOption to $identity.body.bodysize.normal>>
				<<set $identityPreference to $identity.body.bodysize.preferred is "normal" ? true : false>>
			<<case "Large Body">>
				<<set $identityOption to $identity.body.bodysize.large>>
				<<set $identityPreference to $identity.body.bodysize.preferred is "large" ? true : false>>
			<<case "Lactation">>
				<<set $identityOption to $identity.body.lactation>>
				<<set $identityPreference to $identity.body.lactation.preferred is "lactation" ? true : false>>
			<<case "Pregnancy">>
				<<set $identityOption to $identity.body.pregnancy>>
				<<set $identityPreference to $identity.body.pregnancy.preferred is "pregnancy" ? true : false>>
			<<default>>
			<</switch>>
		<</if>>
	<</widget>>

	<<widget "dysphoria">>
		<<if _args[0] isnot undefined>>
			<<set _mod to _args[0]>>
			<<if $identityOption>>
				<<if (!$identityOption.acceptance or $identityOption.reject) and _mod gt 0>>
					<<set $effectsmessage to 1>>
					<<set $dysphoriaMessage to true>>
					<<set $identityOption.dysphoria to $identityOption.dysphoria + _mod>>
					<<if $identityOption.dysphoria gt 100>>
						<<set _shift to _mod>>
					<<else>>
						<<set _shift to Math.ceil(_mod / 2)>>
					<</if>>
					<<if !$identityOption.acceptance>>
						<<stress _shift>>
						<<if !$identityOption.reject>>
							<<trauma _shift>>
						<</if>>
					<<elseif $identityOption.reject>>
						<<trauma _shift>>
					<</if>>
					<<set $identityOption.dysphoria to Math.clamp($identityOption.dysphoria, 0, 100)>>
					<<if (!$identityOption.acceptance and $identityOption.reject)>>
						<<willpower 1>>
						<<rejectionBreakdown>>
					<</if>>
				<<elseif _mod lt 0 and $identityOption.dysphoria gt 0>>
					<<set $identityOption.dysphoria to Math.clamp($identityOption.dysphoria + _mod, 0, 100)>>
					<<if $identityOption.reject>>
						<<set _shift to 0 - _mod>>
						<<stress _mod>><<trauma _mod>><<control _shift>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityEffects">>
		<<if $identityOption.dysphoria gt 0>>
			<<set _shift to $identityOption.dysphoria / 20>>
			<<if !$identityOption.acceptance>>
				<<stress _shift>>
				<<if !$identityOption.reject>>
					<<trauma $identityOption.dysphoria>>
				<</if>>
			<<elseif $identityOption.reject>>
				<<trauma $identityOption.dysphoria>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "rejectionBreakdown">>
		<<if $identityOption.dysphoria gte 100>>
			<<willpowercheck 500>>
			<<if !$willpowerSuccess>>
				<<set $identityOption.dysphoria to 0>>
				<<set $identityOption.tolerance to 100>>
				<<set $identityOption.acceptance to true>>
				<<willpower -25>>
				<<set $effectsmessage to 1>>
				<<set $breakdownMessage to true>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "lockInIdentity">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char, _icon range _category>>
				<<identitySelector _char>>
				<<if $identityPreference>>
					<<set $identityOption.tolerance to 200>>
				<<elseif $identityOption?.acceptance>>
					<<set $identityOption.tolerance to 100>>
				<</if>>
			<</for>>
		<</for>>
		<<set $identity.init to 2>>
	<</widget>>

	<<widget "tolerance">>
		<<if _args[0] isnot undefined>>
			<<set _mod to _args[0]>>
			<<if $identityOption>>
				<<set $identityOption.tolerance to Math.clamp($identityOption.tolerance + _mod, 0, 200)>>
				<<if $identityOption.tolerance gte 100 and !$identityOption.acceptance>>
					<<set $identityOption.acceptance to true>>
					<<set $effectsmessage to 1>>
					<<set $identityAcceptanceMessage to true>>
				<<elseif $identityOption.tolerance is 0 and $identityOption.acceptance>>
					<<set $identityOption.acceptance to false>>
					<<set $effectsmessage to 1>>
					<<set $breakdownEndMessage to true>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "hourlyIdentityEffects">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char,_icon range _category>>
				<<identitySelector _char>>
				<<if $identityOption>>
					<<if playerHasCharacteristic(_char)>>
						<<if $identityOption.acceptance and !$identityOption.reject>>
							<<tolerance 2>>
						<</if>>
						<<set _shift to ($identityOption.tolerance/50).toFixed(2)>>
						<<set _shift to Math.clamp(3-_shift, 1, 3)>>
						<<dysphoria _shift>>
						<<if $identityPreference>>
							<<stress -5>><<trauma -5>>
						<</if>>
						<<identityCleanup>>
					<<elseif $identityOption.dysphoria gt 0>>
						<<dysphoria -5>>
					<</if>>
				<</if>>
			<</for>>
		<</for>>
	<</widget>>

	<<widget "dailyIdentityEffects">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char,_icon range _category>>
				<<identitySelector _char>>
				<<if $identityOption>>
					<<if $identityOption.dysphoria is 0>>
						<<if !playerHasCharacteristic(_char) and !$identityPreference>>
							<<tolerance -3>>
						<</if>>
					<<elseif !$identityOption.reject>>
						<<set _shift to Math.ceil(0 - ($identityOption.dysphoria / 2))>>
						<<tolerance 5>>
						<<dysphoria _shift>>
						<<sub `_shift * -0.1`>>
						<<willpower `_shift * 0.1`>>
						<<set $effectsmessage to 1>>
						<<set $dysphoriaProcessingMessage to 1>>
					<</if>>
				<</if>>
			<</for>>
		<</for>>
	<</widget>>

	<<widget "misgender">>
		<<if $player.gender_appearance is "m">>
			<<identitySelector "Masculine Pronouns">>
			<<if !$identityOption.acceptance>>
				<<dysphoria 10>>
			<<else>>
				<<dysphoria -1>>
				<<if $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<<elseif $player.gender_appearance is "f">>
			<<identitySelector "Feminine Pronouns">>
			<<if !$identityOption.acceptance>>
				<<dysphoria 10>>
			<<else>>
				<<dysphoria -1>>
				<<if $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "encounterIdentityEffects">>
		<<if $player.vaginaExist and $vaginastate>>
			<<identitySelector "Vagina">>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $player.penisExist and $penisstate>>
			<<set _penis to identityCharacteristicCategory("Penis")>>
			<<identitySelector _penis>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $chestuse>>
			<<set _chest to identityCharacteristicCategory("Breasts")>>
			<<identitySelector _chest>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $bottomuse>>
			<<set _bottom to identityCharacteristicCategory("Ass")>>
			<<identitySelector _bottom>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $speechhair>>
			<<set _hair to identityCharacteristicCategory("Hair")>>
			<<identitySelector _hair>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityBodyCheck">>
		<<set _body to identityCharacteristicCategory("Size")>>
			<<identitySelector _body>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
	<</widget>>

	<<widget "identityCreampie">>
		<<set _bodyparts to _args[0]>>
		<<set _liquids to _args[1]>>
		<<set _amount to _args[2]>>
		<<identitySelector "Pregnancy">>
		<<if $identityOption and playerAwareTheyCanBePregnant()  and _bodyparts.includes("vagina") and _liquids.includesAny("cum", "semen") and _amount gte 1>>
			<<if (!$identityOption.acceptance or $identityOption.reject)>>
				<<dysphoria 10>>
			<</if>>
			<<if $identityPreference>>
				<<stress -10>><<trauma -10>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityCleanup">>
		<<if $identityOption?.misgendered>>
			<<set $identityOption.misgendered to 0>>
		<</if>>
	<</widget>>

	<<widget "g-genderidentity">>
	<</widget>>
	<<widget "gg-genderidentity">>
	<</widget>>
	<<widget "ggg-genderidentity">>
	<</widget>>
	<<widget "l-genderidentity">>
	<</widget>>
	<<widget "ll-genderidentity">>
	<</widget>>
	<<widget "lll-genderidentity">>
	<</widget>>

	<<widget "xchangeSkinColourVariableCombine">>
		<<if _xchangeSkinTone is "no">><<set _xchangeSkinShade to "change">><</if>>
		<<set $xchange.customisedSkinColour to _xchangeSkinTone + _xchangeSkinShade>>
	<</widget>>