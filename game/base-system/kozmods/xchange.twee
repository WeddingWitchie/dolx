:: X-Change Pill Widgets [widget]

<<widget "become-girl">>
	<<wash>>
	<<set $facestyle to ["default","fem"].random()>>
	<<set $player.gender_body to "f">>

	<<if $player.gender !== "f" && Object.keys($xchangePill.changedBody).length gt 0>>
		<<load-body "genderswapped">>
	<<else>>
		<<set $bodysize to Math.clamp($bodysize-1, 0,3)>>
		<<set $player.breastsize to random($breastsizemin,$breastsizemax)>>
		<<set $player.bottomsize to random($bottomsizemin,$bottomsizemax)>>
		<<set $player.penissize to -2>>
		<<set $ballsssize to -2>>
		<<if $hairlength lt 400>>
			<<set _hairLengthLevels to [400,400,400,600,600,800,1000]>>
			<<set $hairlength to _hairLengthLevels[random(0,_hairLengthLevels.length-1)]>>
		<</if>>
		<<if $fringelength lt 200>>
			<<set $fringelength to Math.clamp($hairlength - 200, 200, 600)>>
		<</if>>
		<<set $beauty += 5000 * $AMCTraits.beauty>>
		<<set _physiquesizes to [6000, 10000, 12000, 16000]>>
		<<set _physiquesize_old to $physiquesize>>
		<<set $physiquesize to _physiquesizes[$bodysize]>>
		<<set $physique *= $physiquesize / _physiquesize_old>>
		<<set $physique to Math.clamp($physique * $xchange.femininePhysiqueChangePercent / 100, 0, $physiquesize)>>
		<<set $breastsensitivity to Math.min($breastsensitivity+$xchange.pillSensitivityChange, 6)>>
		<<set $bottomsensitivity to Math.min($bottomsensitivity+$xchange.pillSensitivityChange, 3)>>
		<<set $genitalsensitivity to Math.min($genitalsensitivity+$xchange.pillSensitivityChange, 10)>>
		<<set $penisgrowthtimer to 500>>
		<<set $bottomgrowthtimer to 500>>
		<<set $breastgrowthtimer to 500>>
		<<if !$xchangeFameMerged>>
			<<set $fame to  {
				bestiality: 0,
				business: 0,
				exhibitionism: 0,
				good: 0,
				impreg: 0,
				model: 0,
				pimp: 0,
				pregnancy: 0,
				prostitution: 0,
				rape: 0,
				scrap: 0,
				sex: 0,
				social: 0,
			}>>
			<<set $cool to 120>>
			<<set $crime to {}>>
			<<for _cr range Object.keys(setup.crimeNames)>>
				<<set $crime[_cr] to {current: 0, history: 0, daily: 0, count: 0, countHistory: 0}>>
			<</for>>
			<<set $crime.events to {}>>
		<</if>>

		<<clamp>>
		<<calchairlengthstage>>
	<</if>>

	<<set $vaginause to 0>>
	<<set $vaginastate to 0>>
	<<set $penisuse to "none">>
	<<set $penisstate to "none">>
	<<set $player.sex to "f">>
	<<set $player.ballsExist to false>>
	<<set $player.penisExist to false>>
	<<set $player.vaginaExist to true>>
	<<if Array.isArray(_args[0]) and _args[0].includes("fertile")>>
		<<set $sexStats.vagina.menstruation.running = true>>
	<<else>>
		<<set $sexStats.vagina.menstruation.running = false>>
	<</if>>
<</widget>>

<<widget "become-boy">>
	<<wash>>
	<<set $facestyle to "masc">>
	<<set $player.gender_body to "m">>

	<<if $player.gender !== "m" && Object.keys($xchangePill.changedBody).length gt 0>>
		<<load-body "genderswapped">>
	<<else>>
		<<set $bodysize to Math.clamp($bodysize+1, 0,3)>>
		<<set $player.breastsize to 0>>
		<<set $player.bottomsize to 0>>
		<<set $player.penissize to random($penissizemin,$penissizemax)>>
		<<set $ballsssize to random(-2,3)>>
		<<if $hairlength gte 200>>
			<<set $hairlength to 0>>
		<</if>>
		<<if $fringelength gte 200>>
			<<set $fringelength to 0>>
		<</if>>
		<<set $beauty += 2000 * $AMCTraits.beauty>>
		<<set _physiquesizes to [6000, 10000, 12000, 16000]>>
		<<set _physiquesize_old to $physiquesize>>
		<<set $physiquesize to _physiquesizes[$bodysize]>>
		<<set $physique *= $physiquesize / _physiquesize_old>>
		<<set $physique to Math.clamp($physique * $xchange.masculinePhysiqueChangePercent / 100, 0, $physiquesize)>>
		<<set $breastsensitivity to Math.clamp($breastsensitivity-$xchange.pillSensitivityChange, 1, 4)>>
		<<set $bottomsensitivity to Math.clamp($bottomsensitivity-$xchange.pillSensitivityChange, 1, 4)>>
		<<set $genitalsensitivity to Math.clamp($genitalsensitivity-$xchange.pillSensitivityChange, 1, 4)>>
		<<set $penisgrowthtimer to 500>>
		<<set $bottomgrowthtimer to 500>>
		<<set $breastgrowthtimer to 500>>
		<<if !$xchangeFameMerged>>
			<<set $fame to  {
				bestiality: 0,
				business: 0,
				exhibitionism: 0,
				good: 0,
				impreg: 0,
				model: 0,
				pimp: 0,
				pregnancy: 0,
				prostitution: 0,
				rape: 0,
				scrap: 0,
				sex: 0,
				social: 0,
			}>>
			<<set $cool to 120>>
			<<set $crime to {}>>
			<<for _cr range Object.keys(setup.crimeNames)>>
				<<set $crime[_cr] to {current: 0, history: 0, daily: 0, count: 0, countHistory: 0}>>
			<</for>>
			<<set $crime.events to {}>>
		<</if>>

		<<clamp>>
		<<calchairlengthstage>>
	<</if>>

	<<set $vaginause to "none">>
	<<set $vaginastate to "none">>
	<<set $penisuse to 0>>
	<<set $penisstate to 0>>
	<<set $player.sex to "m">>
	<<set $player.ballsExist to true>>
	<<set $player.penisExist to true>>
	<<set $player.vaginaExist to false>>
	<<set $sexStats.vagina.menstruation.running = false>>

<</widget>>

<<widget "save-body">>
	/* 	args 0: chooses which slot to save the body into. 
			"genderswapped" for your xchanged body
			"cloned" for a cloned npc body
		args 1: used to specify which npc by name
	 */

	<<set _savedbody to {
		bodysize: $bodysize,
		facestyle: $facestyle,
		gender_body: $player.gender_body,
		breastsize: $player.breastsize,
		bottomsize: $player.bottomsize,
		penissize: $player.penissize,
		ballssize: $ballssize,
		leftEyeColour: $leftEyeColour,
		rightEyeColour: $rightEyeColour,
		haircolour: $haircolour,
		hairtype: $hairtype,
		hairlength: $hairlength,
		hairfringecolour: $hairfringecolour,
		fringetype: $fringetype,
		fringelength: $fringelength,
		skinColor: $player.skin.color,
		beauty: $beauty,
		physique: $physique,
		physiquesize: $physiquesize,
		breastsensitivity: $breastsensitivity,
		bottomsensitivity: $bottomsensitivity,
		genitalsensitivity: $genitalsensitivity,
		penisgrowthtimer: $penisgrowthtimer,
		bottomgrowthtimer: $bottomgrowthtimer,
		breastgrowthtimer: $breastgrowthtimer,
		fame: $fame,
		cool: $cool,
		crime: $crime,
	}>>

	<<if _args[0] is undefined>>
		<<set $xchangePill.originalBody to _savedbody>>
	<<elseif _args[0] is "genderswapped">>
		<<set $xchangePill.changedBody to _savedbody>>
	<<elseif _args[0] is "cloned" and _args[1] isnot undefined>>
		<<set _npcName to _args[1]>>
		<<set $xchangePill.clonedBody[_npcName] to _savedbody>>
	<</if>>
<</widget>>

<<widget "load-body">>
	<<if _args[0] is undefined>>
		<<set _body to $xchangePill.originalBody>>
	<<elseif _args[0] is "genderswapped">>
		<<set _body to $xchangePill.changedBody>>
	<<elseif _args[0] is "cloned" and _args[1] isnot undefined>>
		<<set _npcName to _args[1]>>
		<<set _body to $xchangePill.clonedBody[_npcName]>>
	<</if>>

	<<set $bodysize to _body.bodysize>>
	<<set $facestyle to _body.facestyle>>
	<<set $player.gender_body to _body.gender_body>>
	<<set $player.breastsize to _body.breastsize>>
	<<set $player.bottomsize to _body.bottomsize>>
	<<set $player.penissize to _body.penissize>>
	<<set $ballsize to _body.ballsize>>
	<<set $leftEyeColour to _body.leftEyeColour>>
	<<set $rightEyeColour to _body.rightEyeColour>>
	<<set $haircolour to _body.haircolour>>
	<<set $hairtype to _body.hairtype>>
	<<set $hairfringecolour to _body.hairfringecolour>>
	<<set $fringetype to _body.fringetype>>
	<<set $hairlength to _body.hairlength>>
	<<set $fringelength to _body.fringelength>>
	<<set $player.skin.color to _body.skinColor>>
	<<set $beauty to _body.beauty>>
	<<set $physique to _body.physique>>
	<<set $physiquesize to _body.physiquesize>>
	<<set $breastsensitivity to _body.breastsensitivity>>
	<<set $bottomsensitivity to _body.bottomsensitivity>>
	<<set $genitalsensitivity to _body.genitalsensitivity>>
	<<set $penisgrowthtimer to _body.penisgrowthtimer>>
	<<set $bottomgrowthtimer to _body.bottomgrowthtimer>>
	<<set $breastgrowthtimer to _body.breastgrowthtimer>>
	<<if !$xchangeFameMerged>>
		<<set $fame to _body.fame>>
		<<if _body.cool isnot undefined>>
			<<set $cool to _body.cool>>
		<<elseif _body isnot $xchangePill.originalBody>>
			<<set $cool to 120>>
		<</if>>
		<<if _body.crime isnot undefined>>
			<<set $crime to _body.crime>>
		<<else>>
			<<set $crime to {}>>
			<<for _cr range Object.keys(setup.crimeNames)>>
				<<set $crime[_cr] to {current: 0, history: 0, daily: 0, count: 0, countHistory: 0}>>
			<</for>>
			<<set $crime.events to {}>>
		<</if>>
	<</if>>
	<<if $penisgrowthtimer is undefined or $bottomgrowthtimer is undefined or $breastgrowthtimer is undefined>>
		<<set $penisgrowthtimer to 500>>
		<<set $bottomgrowthtimer to 500>>
		<<set $breastgrowthtimer to 500>>	
	<</if>>

	<<if $xchange_fame gte 400 and !$xchangeFameMerged>>
		<<set _ogFame to $xchangePill.originalBody.fame>>
		<<set _newFame to $xchangePill.changedBody.fame>>
		<<set $fame to {
			bestiality: 	Math.max(_ogFame.bestiality, _newFame.bestiality),
			business: 		Math.max(_ogFame.business, _newFame.business),
			exhibitionism: 	Math.max(_ogFame.exhibitionism, _newFame.exhibitionism),
			good: 			Math.max(_ogFame.good, _newFame.good),
			impreg: 		Math.max(_ogFame.impreg, _newFame.impreg),
			model: 			Math.max(_ogFame.model, _newFame.model),
			pimp: 			Math.max(_ogFame.pimp, _newFame.pimp),
			pregnancy: 		Math.max(_ogFame.pregnancy, _newFame.pregnancy),
			prostitution: 	Math.max(_ogFame.prostitution, _newFame.prostitution),
			rape: 			Math.max(_ogFame.rape, _newFame.rape),
			scrap: 			Math.max(_ogFame.scrap, _newFame.scrap),
			sex: 			Math.max(_ogFame.sex, _newFame.sex),
			social: 		Math.max(_ogFame.social, _newFame.social),
		}>>
		<<set $xchangePill.originalBody.fame to $fame>>
		<<set $xchangePill.changedBody.fame to $fame>>

		<<set _ogCool to $xchangePill.originalBody.cool>>
		<<set _newCool to $xchangePill.changedBody.cool>>
		<<set $cool to (_ogCool + _newCool) / 2>>
		<<set $xchangePill.originalBody.cool to $cool>>
		<<set $xchangePill.changedBody.cool to $cool>>

		<<set _ogCrime = $xchangePill.originalBody.crime>>
		<<set _newCrime = $xchangePill.changedBody.crime>>
		<<set $crime to {}>>
		<<for _cr range Object.keys(setup.crimeNames)>>
			<<set $crime[_cr] to {
				current: 		_ogCrime[_cr].current + _newCrime[_cr].current, 
				history: 		_ogCrime[_cr].history + _newCrime[_cr].history, 
				daily: 			_ogCrime[_cr].daily + _newCrime[_cr].daily, 
				count: 			_ogCrime[_cr].count + _newCrime[_cr].count, 
				countHistory: 	_ogCrime[_cr].countHistory + _newCrime[_cr].countHistory}>>
		<</for>>
		<<set $crime.events to {...(_ogCrime.events), ...(_newCrime.events)}>>
		<<set $xchangePill.originalBody.crime to $crime>>
		<<set $xchangePill.changedBody.crime to $crime>>

		<<set $xchangeFameMerged to true>>
	<</if>>

	<<calchairlengthstage>>
<</widget>>

<<widget "xchange-effects">>
	<<set $xchangePill.active to true>>
	<<set $xchangePill.duration to _args[0] * 24 - 1>> <!-- duration now in hours instead of days -->
	<<set $xchangePill.fertile to false>>
	<<set $xchangePill.effectsKnown to true>>

	<<set $xchangePill.breederEffect to false>>
	<<set $xchangePill.resistanceEffect to false>>
	<<set $xchangePill.continueEffect to false>>
	<<set $xchangePill.passionEffect to false>>
	<<set $xchangePill.portalEffect to false>>
	<<set $xchangePill.portalEffectTimer to 0>>

	<<for _effect range _args[1]>>
		<<xchange-addeffect _effect>>
	<</for>>
<</widget>>

<<widget "xchange-addeffect">>
	<<switch _args[0]>>
	<<case "resistance">>
		<<set $xchangePill.resistanceEffect to true>>
		<<set $xchangePill.resistanceChance to 100>>
	<<case "continue">>
		<<set $xchangePill.continueEffect to true>>
	<<case "fertile">>
		<<set $xchangePill.fertile to true>>
	<<case "breeder">>
		<<set $xchangePill.breederEffect to true>>
	<<case "portal">>
		<<if $portalPantiesEnabled>>
			<<set $xchangePill.portalEffect to true>>
			<<set $xchangePill.portalEffectTimer to _args[1] * 24 - 1>>
		<</if>>
	<<case "passion">>
		<<set $xchangePill.passionEffect to true>>
	<<case "spike" "unknown">>
		<<set $xchangePill.effectsKnown to false>>
	<<default>>
	<</switch>>
<</widget>>

<<widget "xchange-pink">>
/* 	args[0]: duration of the pill
	args[1]: "fertile" to enable fertility cycle 
			 "resistance" enables resistance effect
			 "continue" enables continue effect 
*/	
	<<set _duration to _args[0]>>
	<<set _effects to _args.slice(1)>>

	<<if !playerIsXChanged() and ($xchange.nonconEnabled or !_effects.includes("spike"))>>
		<<xchange-effects _duration _effects>>

		<<save-body>>
		<<become-girl _args.slice(1)>>
		<<exposedcheck>>

		<<if $xchange.blackmail.intro>><<set $xchange.blackmail.hasGenderswapped to true>><</if>>
		<<if $xchange.blackmail.activeQuest>><<set $xchange.blackmail.hasGenderswappedRecently to true>><</if>>
	<</if>>
<</widget>>

<<widget "xchange-blue">>
/* 	args[0]: duration of the pill
	args[1]: "fertile" to enable fertility cycle 
			 "resistance" enables resistance effect
			 "continue" enables continue effect 
*/
	<<set _duration to _args[0]>>
	<<set _effects to _args.slice(1)>>

	<<if !playerIsXChanged() and ($xchange.nonconEnabled or !_effects.includes("spike"))>>
		<<xchange-effects _duration _effects>>

		<<save-body>>
		<<become-boy>>
		<<exposedcheck>>

		<<if $xchange.blackmail.intro>><<set $xchange.blackmail.hasGenderswapped to true>><</if>>
		<<if $xchange.blackmail.activeQuest>><<set $xchange.blackmail.hasGenderswappedRecently to true>><</if>>
	<</if>>
<</widget>>

<<widget "xchange-restore">>
	<<set $xchangePill.active to false>>
	<<set $xchangePill.portalEffect to false>>
	<<set $xchangePill.portalEffectTimer to 0>>
	<<set $xchangePill.passionEffect to false>>

	<<if _args[0] isnot "nosave">>
		<<save-body "genderswapped">>
	<</if>>

	<<if $player.gender is "m">>
		<<become-boy>>
	<<elseif $player.gender is "f">>
		<<become-girl "fertile">>
	<</if>>

	<<if $xchange_fame gte 400 && !$xchangeFameMerged>>
		<span>People have been gossiping about your X-Change escapades, and even the law has fully caught on.</span><br> 
		<span class="red">You no longer benefit from having two identities.</span>
		<br>
	<</if>>

	<<load-body>>

	<<if $xchangePill.resistanceEffect && $xchangePill.resistanceChance lt 100>>
		<span class="blue">Despite having climaxed under the effects of Resistance, the pill did not become permanent.</span>
	<<else>>
		<span class="blue">Your body twists and turns as it returns to its original form.</span>
	<</if>>
	<br><br>


<</widget>>

<<widget "xchange-setpermanent">>
	<<set $xchangePill.duration to -1>>
	<<if $player.sex is "f">>
		<<set $sexStats.vagina.menstruation.running = true>>
		<<set $xchangePill.fertile to true>>
	<</if>>
	<<set $xchangePill.continueEffect to false>>
	<<set $xchangePill.resistanceEffect to false>>
	<span class="red">You didn't turn back. Your pill's effects have become permanent.</span>
	<br>
<</widget>>

<<widget "xchange-orgasm">>
	<<set _pill to $xchangePill>>
	<<if _pill.resistanceEffect>>
		<<set _pill.resistanceChance to (_pill.resistanceChance * 0.7)>>
	<</if>>
	<<if _pill.continueEffect and !(pillIsPermanent() or pillTimerPaused())>>
		<<set _pill.duration += 1 * 16>>
	<</if>>
<</widget>>

<<widget "genderidentity-orgasm">>
	<<set _manlyUse to ["othervagina", "otheranus", "othermouth", "tentacle"]>>
	<<if $player.gender is "m" and $player.penisExist and _manlyUse.includes($penisuse)>>
		<<genderidentity 1>>
	<<elseif $player.gender isnot "m" and $player.penisExist and _manlyUse.includes($penisuse)>>
		<<genderidentity -3>>
	<</if>>
	<<if $player.gender is "f" and $player.vaginaExist>>
		<<genderidentity 1>>
	<<elseif $player.gender isnot "f" and $player.vaginaExist>>
		<<genderidentity -3>>
	<</if>>
<</widget>>

<<widget "fame-propagate">>
	<!-- Usage: <<fame 10 "scrap" "good">>. Raises fames regardless of mask, gloryhole, etc. -->
	<<if _args.length gte 2 and $statFreeze isnot true>>
		<<set [$_gain, ...($_fameTypes)] to _args>> <!-- remove first element of array since it's the number -->
		<<if Object.keys($xchangePill.changedBody).length gt 0>>
			<<run $_fameTypes.forEach(fameType => $xchangePill.changedBody.fame[fameType] += $_gain)>> <!-- add the specified amount to each specified fame type -->
		<</if>>
		<<if Object.keys($xchangePill.originalBody).length gt 0>>
			<<run $_fameTypes.forEach(fameType => $xchangePill.originalBody.fame[fameType] += $_gain)>> <!-- add the specified amount to each specified fame type -->
		<</if>>
		<<fameclamp>>
	<</if>>
<</widget>>

<<widget "xchange-fame">>
	<<if _args[0] and $statFreeze isnot true>>
		<<if playerIsXChanged() and $face isnot "covered" and !$worn.face.type.includes("mask") and !$gloryhole>>
			<<set $xchange_fame += _args[0]>>
			<<set $xchange_fame to Math.clamp($xchange_fame, 0, 2000)>>
			<<if $xchange_fame gte 400>>
				<<for _name range $NPCNameList>>
					<<set $xchange.known.pushUnique(_name)>>
				<</for>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "xchange-seen">>
	<<set _increase to 10 * _args[0]>>
	<<xchange-fame _increase>>
<</widget>>

<<widget "xchange-random-spike">>
	<<if playerMayBeSpiked()>>
		<<if $player.gender is "m">>
			<<rng>><<xchange-pink 1 "spike">>
			<<set _effectPool to [
				"none","none","none","none","none","none","none",
				"breeder","breeder",
				"continue","continue","continue",
				"resistance","resistance","resistance",
			]>>
			<<xchange-addeffect _effectPool.random()>>
			<<rng>><<if $rng gt 85>><<xchange-addeffect "fertile">><</if>>
			<<rng>><<if $rng gt 90>><<xchange-addeffect "passion">><</if>>
			<<rng>><<if $rng gt 50>><<xchange-addeffect "portal" 1>><</if>>
			/* <<if $rng lte 10>>
				<<xchange-pink 1 "breeder" "spike">>
			<<elseif $rng lte 15>>
				<<xchange-pink 1 "breeder" "fertile" "spike">>
			<<elseif $rng lte 35>>
				<<xchange-pink 1 "continue" "spike">>
			<<elseif $rng lte 55>>
				<<xchange-pink 1 "resistance" "spike">>
			<<elseif $rng lte 70 and $portalPantiesEnabled>>
				<<xchange-pink 1 "portal" "spike">>
			<<else>>
				<<xchange-pink 1 "spike">>
			<</if>> */
		<<elseif $player.gender is "f">>
			<<xchange-blue 1 "spike">>
			<<set _effectPool to [
				"none","none","none","none","none","none","none",
				"continue","continue","continue",
				"resistance","resistance","resistance",
			]>>
			<<xchange-addeffect _effectPool.random()>>
			<<rng>><<if $rng gt 90>><<xchange-addeffect "passion">><</if>>
			<<rng>><<if $rng gt 50>><<xchange-addeffect "portal" 1>><</if>>
			/* <<if $rng lte 20>>
				<<xchange-blue 1 "continue" "spike">>
			<<elseif $rng lte 40>>
				<<xchange-blue 1 "resistance" "spike">>
			<<else>>
				<<xchange-blue 1 "spike">>
			<</if>> */
		<</if>>
		<<if _args[0] isnot "suppress">>
			<span class="pink">You got spiked with an unknown pill.</span>
			<br><br>
		<</if>>
	<<elseif $portalPantiesEnabled>>
		<<rng>>
		<<if $rng gt 50>>
			<<xchange-addeffect "portal" 1>>
			<<xchange-addeffect "spike">>
			<<if _args[0] isnot "suppress">>
				<span class="pink">Your crotch is feeling oddly breezy.</span>
				<br><br>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "xchange-antidote">>
	<<if !isNaN(_args[0])>>
		<<set _decrease to _args[0] * 24>>
		<<if playerIsXChanged() and !(pillIsPermanent() or pillTimerPaused())>>
			<<set $xchangePill.duration to Math.max($xchangePill.duration - _decrease, 0)>>
			<<pain 200>><<set $stress += Math.max($stressmax * (_args[0] / 8), $stressmax * 0.66)>>
		<</if>>
	<<else>>
		<<error {
			message	: `Received either no argument or a NaN value in the xchange-antidote widget.`,
			source	: `Previous passage: ${$passagePrev} | phase: ${$phase} | rng: ${$rng}.`
		}>>
	<</if>>
<</widget>>

<<widget "xchange-test">>
	<<set $xchangePill.effectsKnown to true>>
	<br>
	<<set $xchangePill.testPending to false>>
	The display indicates that, you're under the following effects:
	<ul>
		<<if $xchangePill.continueEffect>><li>Continue Effect.
			<mouse class="tooltip linkBlue">(?)<span>Extends its duration every time you climax.</span></mouse></li><</if>>
		<<if $xchangePill.resistanceEffect>><li>Resistance Effect.
			<mouse class="tooltip linkBlue">(?)<span>Less likely to expire after its full lapse with each orgasm.</span></mouse></li><</if>>
		<<if $xchangePill.breederEffect>><li>Breeder Effect.
			<mouse class="tooltip linkBlue">(?)<span>Enhances your fertility. Triggers orgasms upon insemination. And dimishes stress while sperm remains inside the vagina.</span></mouse>
		</li><</if>>
		<<if $xchangePill.passionEffect>><li>Passion Effect.
			<mouse class="tooltip linkBlue">(?)<span>Steadily dissolves aphrodisiacs into your bloodstream at an hourly rate.</span></mouse></li><</if>>
		<<if $xchangePill.portalEffect>><li>Portal Effect: <span class="teal"><<print-portalduration>></span> remaining.
			<mouse class="tooltip linkBlue">(?)<span>Allows random NPCs to fuck you remotely, regardless of your consent.</span></mouse></li><</if>>
		<<if $xchangePill.clone isnot "none">><li>Clone '<<print $xchangePill.clone>>' Effect.</li><</if>>
		<<if $xchangePill.fertile>><li>You can become pregnant.</li><</if>>
		<li>Duration: 
			<<if pillTimerPaused() or pillIsPermanent()>>
				<span class="teal">Indefinite.</span>
			<<else>><span class="teal"><<print-pillduration>></span> remaining.
			<</if>>
		</li>
	</ul>
<</widget>>

<<widget "print-pillduration">>
	<<if $xchangePill.duration gte 36>>
		<<print (Math.ceil($xchangePill.duration/24))>> days
	<<elseif $xchangePill.duration gte 24>>
		1 day
	<<elseif $xchangePill.duration gte 1>>
		<<print ($xchangePill.duration)>> hours
	<<else>>
		1 hour
	<</if>>
<</widget>>

<<widget "print-portalduration">>
	<<set _duration to Math.min($xchangePill.duration, $xchangePill.portalEffectTimer)>>
	<<if _duration gte 36>>
		<<print (Math.ceil(_duration/24))>> days
	<<elseif _duration gte 24>>
		1 day
	<<elseif _duration gte 1>>
		<<print (_duration)>> hours
	<<else>>
		1 hour
	<</if>>
<</widget>>

<<widget "currentSexSidebar">>
	<div id="bodysex-sidebar" class="bodysex-sidebar">
		<<if $player.sex is "f">>
			<img src="img/misc/icon/female.png">
		<<elseif $player.sex is "m">>
			<img src="img/misc/icon/male.png">
		<<else>>
			<img src="img/misc/icon/unisex.png">
		<</if>>
	</div>
<</widget>>

<<widget "pill-characteristics">>
	<<if $xchangePill.effectsKnown>>
		You're under a pill with the following effects: 
		<ul>
			<<if $xchangePill.continueEffect>><li>Continue Effect.
				<mouse class="tooltip linkBlue">(?)<span>Extends its duration every time you climax.</span></mouse></li><</if>>
			<<if $xchangePill.resistanceEffect>><li>Resistance Effect.
				<mouse class="tooltip linkBlue">(?)<span>Less likely to expire after its full lapse with each orgasm.</span></mouse></li><</if>>
			<<if $xchangePill.breederEffect>><li>Breeder Effect.
				<mouse class="tooltip linkBlue">(?)<span>Enhances your fertility. Triggers orgasms upon insemination. And dimishes stress while sperm remains inside the vagina.</span></mouse>
			</li><</if>>
			<<if $xchangePill.passionEffect>><li>Passion Effect.
				<mouse class="tooltip linkBlue">(?)<span>Steadily dissolves aphrodisiacs into your bloodstream at an hourly rate.</span></mouse></li><</if>>
			<<if $xchangePill.portalEffect>><li>Portal Effect: <span class="teal"><<print-portalduration>></span> remaining.
				<mouse class="tooltip linkBlue">(?)<span>Allows random NPCs to fuck you remotely, regardless of your consent.</span></mouse></li><</if>>
			<<if $xchangePill.clone isnot "none">><li>Clone '<<print $xchangePill.clone>>' Effect.</li><</if>>
			<<if $xchangePill.fertile>><li>You can become pregnant.</li><</if>>
			<li>Duration: 
				<<if pillTimerPaused() or pillIsPermanent()>>
					<span class="teal">Indefinite.</span>
				<<else>><span class="teal"><<print-pillduration>></span> remaining.
				<</if>>
			</li>
		</ul>
	<<else>>
		<span class="purple">You don't know what kind of pill you're currently on.</span>
		<br><br>
	<</if>>
<</widget>>

<<widget "arousal-wetness">>
	<<if $arousal gte $arousalmax * 0.6>>
		<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 10)>>
	<<elseif $arousal gte $arousalmax * 0.3>>
		<<set $vaginaArousalWetness to Math.max($vaginaArousalWetness, 5)>>
	<</if>>
<</widget>>

<<widget "arousal-moan">>
	<<set _gain to _args[0]>>
	<<set _sensitivity to _args[1]>>
	<<if $player.sex is "f" and _gain gte 400 and _sensitivity gt 1>>
		<<if $arousal lt $arousalmax * 0.2 and $orgasmcurrent lt 1>>
		<<elseif $arousal lt $arousalmax * 0.4 and $orgasmcurrent lt 1>>
			<<switch $speechcycle>>
				<<case 0>>
					"M-mh!" 
				<<case 1>>
					"Mmph..." 
				<<case 2>>
					"Ngh..." 
				<<case 3>>
					"M-mh!" 
				<<case 4>>
					"Ngh..." 
				<<default>>
					"Mmph..." 
			<</switch>>
			<span class="pink">A muffled moan escapes your lips.</span>
		<<elseif $arousal lt $arousalmax * 0.6 and $orgasmcurrent lt 1>>
			<<switch $speechcycle>>
				<<case 0>>
					"A-Ah!<<hearticon>>" 
				<<case 1>>
					"Mmmh...<<hearticon>>" 
				<<case 2>>
					"Ngh...<<hearticon>>" 
				<<case 3>>
					"A-Ah!<<hearticon>>" 
				<<case 4>>
					"Ngh... Ah...<<hearticon>>" 
				<<default>>
					"Mmmh...<<hearticon>>" 
			<</switch>>
			<span class="pink">You moan softly.</span>
		<<elseif $arousal lt $arousalmax * 0.8>>
			<<switch $speechcycle>>
				<<case 0>>
					"A-Ah!...<<hearticon>> Ah...<<hearticon>>" 
				<<case 1>>
					"Mmmmh...<<hearticon>> Ah!<<hearticon>>" 
				<<case 2>>
					"Ngh...<<hearticon>> Ah!<<hearticon>>" 
				<<case 3>>
					"Hah...<<hearticon>> Hah...<<hearticon>>" 
				<<case 4>>
					"Ngh...<<hearticon>> Ah!<<hearticon>>" 
				<<default>>
					"Hah...<<hearticon>> Hah...<<hearticon>>" 
			<</switch>>
			<span class="pink">You're moaning rhythmically.</span>	
		<<elseif $arousal lte $arousalmax>>
			<<switch $speechcycle>>
				<<case 0>>
					"A-Ah!...<<hearticon>> Hah...<<hearticon>> Hah...<<hearticon>>" 
				<<case 1>>
					"Ahn!...<<hearticon>> Hah...<<hearticon>> Hah...<<hearticon>>" 
				<<case 2>>
					"Fuck...<<hearticon>> Hah...<<hearticon>> Hah...<<hearticon>>" 
				<<case 3>>
					"Hah...<<hearticon>> Hah...<<hearticon>> Hah...<<hearticon>>" 
				<<case 4>>
					"Ah!<<hearticon>> Ah!<<hearticon>> Fuck!<<hearticon>>" 
				<<default>>
					"Ah!...<<hearticon>> Hah...<<hearticon>> Hah...<<hearticon>>" 
			<</switch>>
			<<if $arousal is $arousalmax>>
				<span class="pink">Your climax approaches.</span>
			<<else>>
				<span class="pink">You are gasping uncontrollably.</span>	
			<</if>>
		<</if>>
		<<set $speechcycle to random(0,7)>>
		<<if $speechcycle gte 7>>
			<<set $speechcycle to 0>>
		<</if>>
	<</if>>
<</widget>>

<<widget "genderidentity">>
	<<if _args[0] and $statFreeze isnot true>>
		<<set $genderidentity += _args[0] * 0.5>>
		<<set $genderidentity to Math.clamp($genderidentity,0, 1000)>>
	<</if>>
<</widget>>

<<widget "genderidentity-text">>
	<<if $xchange.genderIdentityEnabled>>
		<<if _args[0] is "f">>
			<span class="pink">Yesterday, you dressed feminine.</span><br>
		<<elseif _args[0] is "m">>
			<span class="blue">Yesterday, you dressed masculine.</span><br>
		<</if>>
	<</if>>
<</widget>>

<<widget "willpowercaption">>
	<<if Number.isFinite($arousal)>>
		<div id="willpowercaption" @title="'Willpower: ' + $xchange.willpowerPoints.toFixed(2)">
			<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
				Willpower:
				<<if $options.showCaptionText is true>>
					<<if $xchange.willpowerPoints gte $willpowermax * (6/5)>>
						<span class="gold">You are ironclad.</span>
					<<elseif $xchange.willpowerPoints gte $willpowermax>>
						<span class="green">You are resolute.</span>
					<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 4>>
						<span class="teal">You feel tenacious.</span>
					<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 3>>
						<span class="lblue">You feel resolved.</span>
					<<elseif $xchange.willpowerPoints gte ($willpowermax / 5) * 2>>
						<span class="blue">You feel determined.</span>
					<<elseif $xchange.willpowerPoints gte $willpowermax / 5>>
						<span class="purple">You are faltering.</span>
					<<elseif $xchange.willpowerPoints gte 1>>
						<span class="pink">You are wavering.</span>
					<<else>>
						<span class="red">You can no longer resist.</span>
					<</if>>
				<</if>>
			</div>
			<<set _showCaptionText to !$options.showCaptionText>>
			<<amcstatbarinverted $xchange.willpowerPoints $willpowermax _showCaptionText>>
			<div style="clear:both;"></div>
		</div>
	<</if>>
<</widget>>

<<widget "willpowercombatcheck">>
	<<if $xchange.willpowerSystemEnabled is 1>>
		<<if $arousal gte ($arousalmax * 2 / 5) or $orgasmcount gt 0>>
			<<silently>><<willpowerdifficulty 1 1000>><</silently>>
			<<if $willpowerSuccess>>
				<<willpowersuccess>>
			<<else>>
				<<willpowerfailure>>
			<</if>>
		<<else>>
			<<set $willpowerSuccess to 1>>
		<</if>>
	<<else>>
		<<set $willpowerSuccess to 1>>
	<</if>>
<</widget>>

<<widget "willpowercheck">>
	<<if _args[0] isnot undefined>>
		<<set _difficulty to _args[0]>>
	<<else>>
		<<set _difficulty to 1000>>
	<</if>>
	<<silently>><<willpowerdifficulty 1 _difficulty>><</silently>>
	<<if $xchange.willpowerSystemEnabled is 1>>
		<<if $willpowerSuccess>>
			<<willpowersuccess>>
		<<else>>
			<<willpowerfailure>>
		<</if>>
	<</if>>
<</widget>>

<<widget "willpowersuccess">>
	<<willpower-spending $xchange.willpowerSuccessCost>>
<</widget>>

<<widget "willpowerfailure">>
	<<willpower-spending $xchange.willpowerFailureCost>>
<</widget>>

<<widget "willpower-spending">>
	<<if _args[0] is undefined>>
		<<set _willpowerExpenditure to 25>>
	<<else>>
		<<set _willpowerExpenditure to _args[0]>>
	<</if>>

	<<set $xchange.willpowerPoints -= _willpowerExpenditure>>
	<<willpowerpoints-clamp>>
<</widget>>

<<widget "willpower-recovery">>
	<<if _args[0] is undefined>>
		<<set _willpowerRecovery to 25>>
	<<else>>
		<<set _willpowerRecovery to _args[0]>>
	<</if>>

	<<set $xchange.willpowerPoints += _willpowerRecovery>>
	<<willpowerpoints-clamp>>
<</widget>>

<<widget "willpowerpoints-clamp">>
	<<set $xchange.willpowerPoints to Math.clamp($xchange.willpowerPoints, 0, Math.max(200, $willpower))>>
<</widget>>

<<widget "willpower-orgasm">>
	<<set _deniedOrgasm to _args[0]>>
	<<if _deniedOrgasm or (playerIsXChanged() and $xchangePill.breederEffect)>>
		<<set _willpowerExpenditure to 25 * $orgasmcount>>
	<<elseif $masturbating or $consensual is 1>>
		<<set _willpowerExpenditure to 5 * $orgasmcount>>
	<<else>>
		<<set _willpowerExpenditure to 10 * $orgasmcount>>
	<</if>>
	<<willpower-spending _willpowerExpenditure>>
<</widget>>

<<widget "breeder-orgasm">>
	<<set _bodyparts to _args[0]>>
	<<set _liquids to _args[1]>>
	<<set _amount to _args[2]>>

	<<if playerIsXChanged() and $xchangePill.breederEffect and _bodyparts.includes("vagina") and _liquids.includesAny("cum", "semen") and _amount gte 1>>
		<<arousal 10000 "vagina">>
		<<set $breederOrgasm to 1>>
	<</if>>
<</widget>>
