	<<widget "location-danger">>
		<<set _locationDanger to 0>>
		<<if $location is "town">>
			<<switch $bus>>
				<<case "barb">>
					<<set _locationDanger to 500>>
				<<case "cliff">>
					<<set _locationDanger to 500>>
				<<case "connudatus">>
					<<set _locationDanger to 1000>>
				<<case "danube">>
					<<set _locationDanger to 0>>
				<<case "domus">>
					<<set _locationDanger to 500>>
				<<case "elk">>
					<<set _locationDanger to 2000>>
				<<case "harvest">>
					<<set _locationDanger to 1500>>
				<<case "high">>
					<<set _locationDanger to 1000>>
				<<case "mer">>
					<<set _locationDanger to 1000>>
				<<case "nightingale">>
					<<set _locationDanger to 1000>>
				<<case "oxford">>
					<<set _locationDanger to 1000>>
				<<case "starfish">>
					<<set _locationDanger to 1000>>
				<<case "wolf">>
					<<set _locationDanger to 500>>
			<</switch>>	

		<<elseif $location is "alley">>
			<<switch $bus>>
				<<case "commercial">>
					<<set _locationDanger to 1500>>
				<<case "industrial">>
					<<set _locationDanger to 2000>>
				<<case "park">>
					<<set _locationDanger to 1000>>
				<<case "residential">>
					<<if $town_projects.thicket is 4>>
						<<set _locationDanger to 500>>
					<<else>>
						<<set _locationDanger to 1000>>
					<</if>>

			<</switch>>

		<<elseif $location is "flats">>
			<<set _locationDanger to 1000>>
			
		<<elseif $location is "canals">>
			<<set _locationDanger to 1500>>

		<</if>>
	<</widget>>

	<<widget "chitchat">>
		<<= either(
			`"...So I told <<him>>: 'Are you mad? There's no way I'm ever doing that!'," <<he>> recounts with outrage.`,
			`"...Can you believe it? That police officer really did that. No joke," <<he>> recounts, baffled at the absurdity of the tale.`,
			`"...And then a dog comes, sticks it in there, and begins to plow furiously. Utterly insane," <<he>> looks slightly flushed as <<he>> recounts the tale.`,
			`"...So the psycho pulls a knife, and starts threatening everyone with it...," <<he>> recounts, allowing the terror of the tale to sink in.`,
			`"...So I just open the door, and there's this man with a raging erection, just standing there...," <<his>> cheeks dye a little red as <<he>> remembers <<his>> tale.`,
			`"...And then this librarian starts writing 'Book Criminal' on <<his>> bloody forehead. I swear we all bursted out laughing when we saw...," <<he>> laughs heartily.`,
			`"...And then she pulls his pants. But the boy was going commando!," <<he>> exclaims as <<he>> recounts that part of the tale.`,
			`"...And then Leighton took pictures of it all! The poor girl was about to cry...," <<he>> sighs, seemingly feeling empathetic.`,
			`"...So then he takes the drink without a clue, and lo and behold, he turns into a bloody woman! And fuck, was she hot, I tell you...," <<he>> recounts with such enthusiasm <<he>> might explode.`,
			`"...So we dared her to take the pill. And later all her friends were drooling all over her new body like hungry hyenas!...," <<he>> narrates with an air of superiority as if <<he>> was above that.`,
			`"...And I heard he went to the lake, deep into the night as a test of courage, but was never ever seen again...," pale as a ghost, <<he>> insists this is a real story.`,
			`"...So if you press all of the buttons at the same time, you can pull off a finisher that all but guarantees you the win...," <<he>> shares some of <<his>> leet strats and insights.`,
			`"...And then he tasted the bun. His eyes instantly glazed, as if remembering the happiest time of his life, before eagerly gobling it all up...," <<he>> narrates with an expression as if <<he>> lived it <<himself>> as well.`,
			`"...And we were chased by it all they way until we got out. We were ghastly from what happened...," <<he>> laughs proudly, as if boasting of <<his>> foolish courage.`,
			`"...So we smelled this mossy stuff. And minutes later we could barely keep our sanity with how horny we were...," <<he>> seems bashful as <<he>> remembers how it felt.`,
			`"...And then she tells me she jumped the bloke into a sweet tight embrace. The happiest she's ever been. Or so she claimed...," <<he>> comments offhandedly.`,
			`"...And apparently, he liked the abuse. Like, he claimed that getting choked until almost blacking out made him orgasm explosively...," <<he>> recounts in disbelief.`
		)>> 
	<</widget>>

	<<widget "cheesy-pickup-line">>
		"<<print [
			`${$player.gender_appearance is "f"? "Girl" : "Boy"}, you look hella cute. But I suspect that's the least interesting thing about you,`,
			`Hey, cutie! What's your name?`,
			`Hey, ${$NPCList[0].gender is "m"? "my cock just died. May I bury it in your ass?" : "my plumbing's a bit leaky. Would you care to check it for me?"}`,
			`Excuse me, I couldn't help but notice you look an awful lot like my next ${$player.gender_appearance is "f"? "girl": "boy"},`,
			"Hey, babe! Why don't you sit on my lap and we talk about the first thing that pops up.",
			"Hey, my hands are cold. Should I warm them up in your pants?",
			"Do you know what winks and fucks like a tiger?",
			"If I said you have a nice body, would you hold it against me?",
			"Wanna know how I know we are having sex tonight? I'm stronger than you,",
			`You look killer in ${$worn.lower.plural? "those":"that"} ${$worn.lower.name}. Care to share some of that booty?`,
			`I just can't look at you and breathe at the same time... Grace me with your beauty, please,`,
			`${$player.gender_appearance is "f"? "Nice legs. What time do they open?": "Hey there, postman... Is that package for me?"}`,
			"You know, if I were you, I’d have sex with me. Immediately,",
		].random()>>".
		<<if $NPCList[0].skills.security gte 800>><<arousal 500>><<ggarousal>><<elseif $NPCList[0].skills.security gte 400>><<arousal 200>><<garousal>><</if>>
	<</widget>>

	<<widget "pleasurecaption">>
		<<if Number.isFinite($pleasure)>>
			<div id="pleasurecaption" @title="'Pleasure: ' + $pleasure.toFixed(2)">
				<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
					Pleasure:
					<<if $options.showCaptionText is true>>
						<<if $pleasure gte $pleasuremax>>
							<span class="red">About to burst.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 4>>
							<span class="pink">A climax rises.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 3>>
							<span class="purple">You feel flushed.</span>
						<<elseif $pleasure gte ($pleasuremax / 5) * 2>>
							<span class="blue">You feel hot.</span>
						<<elseif $pleasure gte $pleasuremax / 5>>
							<span class="lblue">You feel tingly.</span>
						<<elseif $pleasure gte 1>>
							<span class="teal">You feel itchy.</span>
						<<else>>
							<span class="green">You feel normal.</span>
						<</if>>
					<</if>>
				</div>
				<<set _showCaptionText to !$options.showCaptionText>>
				<<glowstatbar 0 $pleasure $pleasuremax _showCaptionText>>
			</div>
		<</if>>
	<</widget>>

	<<widget "enemypleasure">>
		<<set _change to _args[0]>>
		<<set _arousalModifier to $enemyarousal / $enemyarousalmax>>
		<<set _enemySexModifier to _enemies gt 1 or $NPCList[0].gender isnot "m" or _change lt 0 or $timer? 1 : 0.5>>
		<<set $enemypleasure += _change * _arousalModifier * _enemySexModifier>>
	<</widget>>

	<<widget "enemypleasure-edge">>
		<<set _change to _args[0]>>
		<<set _initialpleasure to $enemypleasure>>

		<<enemypleasure _change>>
		<<set $enemypleasure to Math.clamp($enemypleasure, Math.min(_initialpleasure, $enemypleasuremax / 5), $enemypleasuremax)>>
	<</widget>>

	<<widget "effectsman-xchange">>
		/*Heat Message */

		<<if $vaginatarget isnot undefined and $xchange.heat.systemOn and !playerChastity("vagina") and playerHeatMinArousal()>>	
			<<if $position isnot "stalk" and $NPCList[$vaginatarget].penis isnot "none" and $vaginastate isnot "othermouth" and !$NPCList[$vaginatarget].chastity.penis.includes("chastity")>>
				<<breeder-heat>>
			<</if>>
		<</if>>

		<<if $xchange.heat.message>>
			<<if playerAwareTheyAreInHeat()>>
				<span class="red">Your heat consumes you.</span> <span class="gold">Lust overrides your actions.</span>
			<<else>>
				<span class="red">An overwhelming need to breed overcomes you.</span> <span class="gold">Lust overrides your actions.</span>
			<</if>>
			<<set $xchange.heat.message to false>>
		<</if>>

		<<encounterIdentityEffects>>
	<</widget>>

	/* IDENTITY */
	<<widget "identitySettings">>

		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">Identity Mechanics:</span><br>
				<ul class="small-description">
					<li>Accepted characteristics don't have negative effects. You can have one preferred characteristic from accepted characterisitcs in each category, which grants minor Stress and Trauma reduction when you have them.</li>
					<li>You gain dysphoria for each characterisitc you have that you haven't accepted, which increases Stress and Trauma.</li>
					<li>You gain daily tolerance towards characteristics you have that you haven't accepted, until you reach acceptance at max tolerance.</li>
					<li>You don't gain Trauma from Rejected characteristics, but you don't gain Tolerance towards it either. Staying at maximum Dysphoria in a Rejected characteristic is dangerous.</li>
				</ul>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				Gender Presentation
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Pronouns </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Masculine:
				<br> 
				<label data-target='["identity.presentation.pronouns.masculine.acceptance"]' data-disabledif="V.identity.presentation.pronouns.masculine.acceptance" class="red">Reject <<checkbox "$identity.presentation.pronouns.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.presentation.pronouns.preferred", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferred === 'm' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.masculine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.masculine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.pronouns.preferred" "m" autocheck>></label>
				<br>
				Feminine:
				<br>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance"]' data-disabledif="V.identity.presentation.pronouns.feminine.acceptance" class="red">Reject <<checkbox "$identity.presentation.pronouns.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.presentation.pronouns.preferred", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferred === 'f' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance"' data-disabledif="!V.identity.presentation.pronouns.feminine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.pronouns.preferred" "f" autocheck>></label>
				<br>
				Neutral:
				<br> 
				<label data-target='["identity.presentation.pronouns.neutral.acceptance"]' data-disabledif="V.identity.presentation.pronouns.neutral.acceptance" class="red">Reject <<checkbox "$identity.presentation.pronouns.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2>>
					<label data-target='["identity.presentation.pronouns.preferred", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferred === 'n' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.neutral.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" true autocheck>></label> |
