						"M-mh!" 
					<<case 1>>
						"Mmph..." 
					<<case 2>>
						"Ngh..." 
					<<case 3>>
						"M-mh!" 
					<<case 4>>
						"Ngh..." 
					<<default>>
						"Mmph..." 
				<</switch>>
				<span class="pink">A muffled moan escapes your lips.</span>
			<<elseif $pleasure lt $pleasuremax * 0.6 and $orgasmcurrent lt 1>>
				<<switch $speechcycle>>
					<<case 0>>
						"A-Ah!<<hearticon>>" 
					<<case 1>>
						"Mmmh...<<hearticon>>" 
					<<case 2>>
						"Ngh...<<hearticon>>" 
					<<case 3>>
						"A-Ah!<<hearticon>>" 
