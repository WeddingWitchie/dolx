			</div>
			<div class="settingsToggleItem" id="gi-box-fecundity" data-gi-config="giFecundityConfigured" style="display:none;">
				<span class="gold">Fecundity </span> <mouse class = "tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Lactation: 
				<br> 
				<label data-target='["identity.body.lactation.acceptance", "identity.body.lactation.reject"]' data-disabledif="V.identity.body.lactation.acceptance && !V.identity.body.lactation.reject" class="red">Reject <<checkbox "$identity.body.lactation.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or !$xchange.giFecundityConfigured>>
					<label data-target='["identity.body.lactation.preferred", "identity.init"]' data-disabledif="V.identity.body.lactation.preferred === 'lactation'">Unaccepted <<radiobutton "$identity.body.lactation.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.lactation.reject", "identity.init"]' data-disabledif="V.identity.body.lactation.reject">Accepted <<radiobutton "$identity.body.lactation.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.lactation.acceptance"]' data-disabledif="!V.identity.body.lactation.acceptance" class="green">Preferred <<checkbox "$identity.body.lactation.preferred" "none" "lactation" autocheck>></label>
				<br>
				Pregnancy: 
				<br> 
				<label data-target='["identity.body.pregnancy.acceptance", "identity.body.pregnancy.reject"]' data-disabledif="V.identity.body.pregnancy.acceptance && !V.identity.body.pregnancy.reject" class="red">Reject <<checkbox "$identity.body.pregnancy.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or !$xchange.giFecundityConfigured>>
					<label data-target='["identity.body.pregnancy.preferred", "identity.init"]' data-disabledif="V.identity.body.pregnancy.preferred === 'pregnancy'">Unaccepted <<radiobutton "$identity.body.pregnancy.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.pregnancy.reject", "identity.init"]' data-disabledif="V.identity.body.pregnancy.reject">Accepted <<radiobutton "$identity.body.pregnancy.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.pregnancy.acceptance"]' data-disabledif="!V.identity.body.pregnancy.acceptance" class="green">Preferred <<checkbox "$identity.body.pregnancy.preferred" "none" "pregnancy" autocheck>></label>
				<br>
			</div>
		</div>
	<</widget>>

	<<widget "lockInIdentitySetting">>
		<div class="settingsGrid">
			<div class="settingsToggleItem">
				<label data-target="['identity.init']" data-disabledif="V.identity.init > 1">Lock Choices <<if $identity.init lt 2>><<checkbox "$identity.init" $identity.init 1 autocheck>><<else>><<checkbox "$identity.init" $identity.init 2 autocheck>><</if>></label>
			</div>
		</div>
	<</widget>>
	
	<<widget "dysphoriaBar">>
		<div @class="(_args[3] is true ? 'rightMeter' : 'meter')">
			<<if _args[1] is 0>>
			<<else>>
				<<set _percent to Math.floor((_args[1]/_args[2])*100)>>
				<<set _minPercent to Math.clamp(Math.floor((_args[0]/_args[2])*100), 0, _percent)>>
				<<set _pin to Math.clamp(Math.floor((_args[4]/_args[2])*100), 0, _args[2])>>
				<<switch Math.floor(_percent/10)>>
					<<case 7 8>><<set _statColor to "pinkbar">>
					<<case 5 6>><<set _statColor to "purplebar">>
					<<case 3 4>><<set _statColor to "bluebar">>
					<<case 1 2>><<set _statColor to "lbluebar">>
					<<case 0>><<set _statColor to "tealbar">>
					<<default>><<set _statColor to "redbar">>
				<</switch>>
				<<set _tolPercent to 100>>
				<div class="whitebar" style="width:100%">
				<div class="meter" @style="'width:' + _tolPercent + '%'"></div>
				</div>
				<div @class="_statColor" @style="'width:' + _percent + '%'"></div>
			<</if>>
		</div>
	<</widget>>

	<<widget "identity-box-simple">>
		<<set _boxConfig = _args[0]>>
		<div class="relation-box" @style="(_boxConfig.style || '')">
			<<if _boxConfig.name>>
				<div class="relation-top-line">
					_boxConfig.icon
					<span class="relation-name">_boxConfig.name: _boxConfig.status</span>		
				</div>
			<</if>>
			<div class="identity-description">
				Tolerance
				_boxConfig.tolerance
			</div>
			<div class="identity-description">
				<<if _boxConfig.active>>
					<span @class="'red ' + basicJitterCss()">Dysphoria</span>
				<<else>>
					Dysphoria
				<</if>>
				_boxConfig.dysphoria
			</div>
		</div>
	<</widget>>

	<<widget "identityStatus">>
		<<if _args[1]>>
			<<if !_args[0].reject>>
				<span class="green">Preferred</span>
			<<else>>
				<span @class="'red ' + basicJitterCss()">Preferred</span>
			<</if>>
		<<elseif _args[0].acceptance>>
			<<if !_args[0].reject>>
				<span class="blue">Accepted</span>
			<<else>>
				<span @class="'red ' + basicJitterCss()">Begrudged</span>
			<</if>>
		<<elseif !_args[0]?.reject>>
			<span class="purple">Not accepted</span>
		<<else>>
			<span class="red">Rejected</span>
		<</if>>
	<</widget>>

	<<widget "identityScreen">>
	<<xchange-ensure-bodysize-identity>>

		<div class="identity-box-list">
			<div class="settingsGrid">
				<div class="settingsToggleItemWide">
					<ul class="small-description">
						<li>Accepted characteristics don't have negative effects. You can have one preferred characteristic from accepted characterisitcs in each category, which grants minor Stress and Trauma reduction when you have them.</li>
						<li>You gain dysphoria for each characterisitc you have that you haven't accepted, which increases Stress and Trauma.</li>
						<li>You gain daily tolerance towards characteristics you have that you haven't accepted, until you reach acceptance at max tolerance.</li>
						<li>You don't gain Trauma from Rejected characteristics, but you don't gain Tolerance towards it either. Staying at maximum Dysphoria in a Rejected characteristic is dangerous.</li>
					</ul>
				</div>

				<<for _categoryName, _category range setup.identityIndex>>
					<<set _hasAny to false>>
					<<for _char, _icon range _category>>
						<<identitySelector _char>>
						<<if $identityOption>>
							<<set _hasAny to true>>
						<</if>>
					<</for>>

					<<if _hasAny>>
						<div class="settingsHeader">
							<span class="gold bold">_categoryName</span><br>
						</div>

						<<for _char, _icon range _category>>
							<<identitySelector _char>>
							<<if $identityOption>>
								<<silently>>
									<<set _active to (playerHasCharacteristic(_char) and (!$identityOption.acceptance or $identityOption.reject))>>
									<<set _identityConfig = { 
										name: _char, 
										icon: _icon,
										status: "<<identityStatus $identityOption $identityPreference>>", 
										tolerance: "<<statbarinverted $identityOption.tolerance 100>>", 
										dysphoria: "<<statbar 0 $identityOption.dysphoria 100>>", 
										active: _active
									}>>
								<</silently>>
								<<identity-box-simple _identityConfig>>
							<</if>>
						<</for>>
					<</if>>
				<</for>>
			</div>
		</div>
	<</widget>>

	<<widget "titleIdentity">>
		<<setupTabs>>
		<div id="overlayTabs" class="tab">
			<<closeButtonMobile>>
			<<button "Characteristics">>
				<<toggleTab>>
				<<replace #customOverlayContent>><<characteristics>><</replace>>
			<</button>>
			<<button "Identity">>
				<<toggleTab>>
				<<set $tempDisable to true>>
				<<replace #customOverlayContent>><<identityScreen>><</replace>>
			<</button>>
			<<colourCodes>>
		</div>
		<<closeButton>>
	<</widget>>

	<<widget "identitySelector">>
	<<set $identityTopic to _args[0]>>
		<<set $identityOption to undefined>>
		<<set $identityPreference to false>>
		<<if _args[0] isnot undefined>>
			<<switch _args[0]>>
			<<case "Masculine Clothing">>
				<<set $identityOption to $identity.presentation.clothing.masculine>>
				<<set $identityPreference to $identity.presentation.clothing.preferred is "m" ? true : false>>
			<<case "Feminine Clothing">>
				<<set $identityOption to $identity.presentation.clothing.feminine>>
				<<set $identityPreference to $identity.presentation.clothing.preferred is "f" ? true : false>>
			<<case "Masculine Appearance">>
				<<set $identityOption to $identity.presentation.appearance.masculine>>
				<<set $identityPreference to $identity.presentation.appearance.preferred is "m" ? true : false>>
			<<case "Feminine Appearance">>
				<<set $identityOption to $identity.presentation.appearance.feminine>>
				<<set $identityPreference to $identity.presentation.appearance.preferred is "f" ? true : false>>
			<<case "Masculine Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.masculine>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "m" ? true : false>>
			<<case "Feminine Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.feminine>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "f" ? true : false>>
			<<case "Neutral Pronouns">>
				<<set $identityOption to $identity.presentation.pronouns.neutral>>
				<<set $identityPreference to $identity.presentation.pronouns.preferred is "n" ? true : false>>
			<<case "Flat Chest">>
				<<if $xchange.giBreastSizeEnabled>>
					<<set $identityOption to $identity.body.chest.flat>>
					<<set $identityPreference to $identity.body.chest.preferred is "flat" ? true : false>>
				<</if>>
			<<case "Small Breasts">>
				<<if $xchange.giBreastSizeEnabled>>
					<<set $identityOption to $identity.body.chest.small>>
					<<set $identityPreference to $identity.body.chest.preferred is "small" ? true : false>>
				<</if>>
			<<case "Medium Breasts">>
				<<if $xchange.giBreastSizeEnabled>>
					<<set $identityOption to $identity.body.chest.medium>>
					<<set $identityPreference to $identity.body.chest.preferred is "medium" ? true : false>>
				<</if>>
			<<case "Big Breasts">>
				<<if $xchange.giBreastSizeEnabled>>
					<<set $identityOption to $identity.body.chest.big>>
					<<set $identityPreference to $identity.body.chest.preferred is "big" ? true : false>>
				<</if>>
			<<case "Small Ass">>
				<<if $xchange.giAssSizeEnabled>>
					<<set $identityOption to $identity.body.bottom.small>>
					<<set $identityPreference to $identity.body.bottom.preferred is "small" ? true : false>>
				<</if>>
			<<case "Medium Ass">>
				<<if $xchange.giAssSizeEnabled>>
					<<set $identityOption to $identity.body.bottom.medium>>
					<<set $identityPreference to $identity.body.bottom.preferred is "medium" ? true : false>>
				<</if>>
			<<case "Big Ass">>
				<<if $xchange.giAssSizeEnabled>>
					<<set $identityOption to $identity.body.bottom.big>>
					<<set $identityPreference to $identity.body.bottom.preferred is "big" ? true : false>>
				<</if>>
			<<case "Vagina">>
				<<if $xchange.giGenitalsEnabled>>
					<<set $identityOption to $identity.body.genitals.vagina>>
					<<set $identityPreference to $identity.body.genitals.preferred is "vagina" ? true : false>>
				<</if>>
			<<case "Small Penis">>
				<<if $xchange.giGenitalsEnabled>>
					<<set $identityOption to $identity.body.genitals.smallpenis>>
					<<set $identityPreference to $identity.body.genitals.preferred is "smallpenis" ? true : false>>
				<</if>>
			<<case "Medium Penis">>
				<<if $xchange.giGenitalsEnabled>>
					<<set $identityOption to $identity.body.genitals.mediumpenis>>
					<<set $identityPreference to $identity.body.genitals.preferred is "mediumpenis" ? true : false>>
				<</if>>
			<<case "Big Penis">>
				<<if $xchange.giGenitalsEnabled>>
					<<set $identityOption to $identity.body.genitals.bigpenis>>
					<<set $identityPreference to $identity.body.genitals.preferred is "bigpenis" ? true : false>>
				<</if>>
			<<case "Short Hair">>
				<<if $xchange.giHairLengthEnabled>>
					<<set $identityOption to $identity.body.hairlength.short>>
					<<set $identityPreference to $identity.body.hairlength.preferred is "short" ? true : false>>
				<</if>>
			<<case "Medium Hair">>
				<<if $xchange.giHairLengthEnabled>>
					<<set $identityOption to $identity.body.hairlength.medium>>
					<<set $identityPreference to $identity.body.hairlength.preferred is "medium" ? true : false>>
				<</if>>
			<<case "Long Hair">>
				<<if $xchange.giHairLengthEnabled>>
					<<set $identityOption to $identity.body.hairlength.long>>
					<<set $identityPreference to $identity.body.hairlength.preferred is "long" ? true : false>>
				<</if>>
			<<case "Miniature Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.miniature>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "miniature" ? true : false>>
				<</if>>
			<<case "Tiny Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.tiny>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "tiny" ? true : false>>
				<</if>>
			<<case "Small Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.small>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "small" ? true : false>>
				<</if>>
			<<case "Normal Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.normal>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "normal" ? true : false>>
				<</if>>
			<<case "Tall Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.tall>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "tall" ? true : false>>
				<</if>>
			<<case "Large Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.large>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "large" ? true : false>>
				<</if>>
			<<case "Giant Body">>
				<<if $xchange.giBodySizeEnabled>>
					<<set $identityOption to $identity.body.bodysize.giant>>
					<<set $identityPreference to $identity.body.bodysize.preferred is "giant" ? true : false>>
				<</if>>
			<<case "Lactation">>
				<<if $xchange.giFecundityEnabled>>
					<<set $identityOption to $identity.body.lactation>>
					<<set $identityPreference to $identity.body.lactation.preferred is "lactation" ? true : false>>
				<</if>>
			<<case "Pregnancy">>
				<<if $xchange.giFecundityEnabled>>
					<<set $identityOption to $identity.body.pregnancy>>
					<<set $identityPreference to $identity.body.pregnancy.preferred is "pregnancy" ? true : false>>
				<</if>>
			<<default>>
			<</switch>>
		<</if>>
	<</widget>>

	<<widget "dysphoria">>
		<<if _args[0] isnot undefined>>
			<<set _mod to _args[0]>>

			<<if $identityOption>>
				<<if (!$identityOption.acceptance or $identityOption.reject) and _mod gt 0>>

				/* Reason message (optional override via _args[1]) */
				<<set _reason to (typeof _args[1] is "string") ? _args[1].trim() : "">>
				/* Default reasons (only if no custom string was passed) */
				<<if _reason is "">>
					<<switch $identityTopic>>
						<<case "Pregnancy">>
							<<set _reason to "You recoil at the thought and possibility of pregnancy.">>
						<<case "Lactation">>
							<<set _reason to "You recoil at the thought and possibility of lactating.">>
						<<case "Masculine Appearance">>
							<<set _reason to "Catching yourself looking masculine makes your stomach twist.">>
						<<case "Feminine Appearance">>
							<<set _reason to "Catching yourself looking feminine makes your stomach twist.">>
						<<case "Vagina">>
							<<set _reason to "Being reminded you have a vagina disgusts you.">>
						<<case "Small Penis">>
							<<set _reason to "Being reminded you have a small penis disgusts you.">>
						<<case "Medium Penis">>
							<<set _reason to "Being reminded you have an average penis disgusts you.">>
						<<case "Big Penis">>
							<<set _reason to "Being reminded you have a big penis disgusts you.">>
						<<case "Masculine Pronouns" "Feminine Pronouns" "Neutral Pronouns">>
							<<set _reason to "Someone refers to you with wrong pronouns. It makes your skin crawl.">>
						<<case "Masculine Clothing" "Feminine Clothing">>
							<<set _reason to "The fabric and silhouette cling in all the wrong ways, making you painfully aware of yourself.">>
						<<case "Flat Breasts">>
							<<set _reason to "Your chest looks empty in a way that leaves a sharp ache.">>
						<<case "Small Breasts">>
							<<set _reason to "Your chest looks not enough in a way that leaves a sharp ache.">>
						<<case "Medium Breasts">>
							<<set _reason to "Your chest looks average in a way that leaves a sharp ache.">>
						<<case "Big Breasts">>
							<<set _reason to "Your chest looks big in a way that leaves a sharp ache.">>
						<<case "Short Hair" "Medium Hair" "Long Hair">>
							<<set _reason to "The length of your hair makes you feel trapped in the wrong image.">>
						<<case "Miniature Body" "Tiny Body" "Small Body" "Normal Body" "Tall Body" "Large Body" "Giant Body">>
							<<set _reason to "Your body size doesn't match the space you want to take up, it sits wrong in your gut.">>
						<<case "Small Ass" "Medium Ass" "Big Ass">>
							<<set _reason to "Your ass size doesn't feels right and maddeningly hard to ignore.">>
					<</switch>>
				<</if>>
				/* Store it for the UI (works for both custom and default) */
				<<if _reason isnot "">>
					<<set $dysphoriaReasonMessage to _reason>>
				<</if>>
				
					<<set $effectsmessage to 1>>
					<<set $dysphoriaMessage to true>>
					<<set $identityOption.dysphoria to $identityOption.dysphoria + _mod>>
					<<if $identityOption.dysphoria gt 100>>
						<<set _shift to _mod>>
					<<else>>
						<<set _shift to Math.ceil(_mod / 2)>>
					<</if>>
					<<if !$identityOption.acceptance>>
						<<stress _shift>>
						<<if !$identityOption.reject>>
							<<trauma _shift>>
						<</if>>
					<<elseif $identityOption.reject>>
						<<trauma _shift>>
					<</if>>
					<<set $identityOption.dysphoria to Math.clamp($identityOption.dysphoria, 0, 100)>>
					<<if (!$identityOption.acceptance and $identityOption.reject)>>
						<<willpower 1>>
						<<rejectionBreakdown>>
					<</if>>
				<<elseif _mod lt 0 and $identityOption.dysphoria gt 0>>
					<<set $identityOption.dysphoria to Math.clamp($identityOption.dysphoria + _mod, 0, 100)>>
					<<if $identityOption.reject>>
						<<set _shift to 0 - _mod>>
						<<stress _mod>><<trauma _mod>><<control _shift>>
					<</if>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityEffects">>
		<<if $identityOption.dysphoria gt 0>>
			<<set _shift to $identityOption.dysphoria / 20>>
			<<if !$identityOption.acceptance>>
				<<stress _shift>>
				<<if !$identityOption.reject>>
					<<trauma $identityOption.dysphoria>>
				<</if>>
			<<elseif $identityOption.reject>>
				<<trauma $identityOption.dysphoria>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "rejectionBreakdown">>
		<<if $identityOption.dysphoria gte 100>>
			<<willpowercheck 500>>
			<<if !$willpowerSuccess>>
				<<set $identityOption.dysphoria to 0>>
				<<set $identityOption.tolerance to 100>>
				<<set $identityOption.acceptance to true>>
				<<willpower -25>>
				<<set $effectsmessage to 1>>
				<<set $breakdownMessage to true>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "lockInIdentity">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char, _icon range _category>>
				<<identitySelector _char>>
				<<if $identityPreference>>
					<<set $identityOption.tolerance to 200>>
				<<elseif $identityOption?.acceptance>>
					<<set $identityOption.tolerance to 100>>
				<</if>>
			<</for>>
		<</for>>

		/* When identity is locked, mark enabled body categories as configured so the UI actually locks them. */
		<<if $xchange.giBreastSizeEnabled>><<set $xchange.giBreastSizeConfigured to true>><</if>>
		<<if $xchange.giAssSizeEnabled>><<set $xchange.giAssSizeConfigured to true>><</if>>
		<<if $xchange.giGenitalsEnabled>><<set $xchange.giGenitalsConfigured to true>><</if>>
		<<if $xchange.giHairLengthEnabled>><<set $xchange.giHairLengthConfigured to true>><</if>>
		<<if $xchange.giBodySizeEnabled>><<set $xchange.giBodySizeConfigured to true>><</if>>
		<<if $xchange.giFecundityEnabled>><<set $xchange.giFecundityConfigured to true>><</if>>

		<<set $identity.init to 2>>
	<</widget>>

	<<run (function () {
		/* Auto-finalise identity locking picked during character creation.
		   - Character creation can set V.identity.init = 1 ("pending lock") but never runs <<lockInIdentity>>.
		   - After the game fully starts, some init code may recreate V.xchange, which can wipe the *Configured* flags.
		   This hook:
		     (1) commits init=1 -> init=2 by running <<lockInIdentity>> once setup.identityIndex exists
		     (2) ensures enabled body categories are marked *Configured* whenever identity is locked (init>=2),
		         so the UI actually hides the Unaccepted/Accepted radios and stays locked. */
		if (setup.giAutoCommitIdentityLockInstalled) return;
		setup.giAutoCommitIdentityLockInstalled = true;

		function ensureConfiguredFlags(V) {
			if (!V.xchange) V.xchange = {};
			/* Mark categories configured if they are enabled AND identity is locked.
			   (The UI keeps categories editable when !Configured, even if init==2.) */
			if (V.identity && V.identity.init >= 2) {
				if (V.xchange.giBreastSizeEnabled)   V.xchange.giBreastSizeConfigured   = true;
				if (V.xchange.giAssSizeEnabled)      V.xchange.giAssSizeConfigured      = true;
				if (V.xchange.giGenitalsEnabled)     V.xchange.giGenitalsConfigured     = true;
				if (V.xchange.giHairLengthEnabled)   V.xchange.giHairLengthConfigured   = true;
				if (V.xchange.giBodySizeEnabled)     V.xchange.giBodySizeConfigured     = true;
				if (V.xchange.giFecundityEnabled)    V.xchange.giFecundityConfigured    = true;
			}
		}

		function autoCommitIdentityLock() {
			var V = State && State.variables;
			if (!V || !V.identity) return;

			/* If we are already locked, just make sure config flags didn't get wiped. */
			if (V.identity.init >= 2) {
				ensureConfiguredFlags(V);
				return;
			}

			/* Pending lock: wait until identity index exists (defined by base game / other mod files). */
			if (V.identity.init !== 1) return;
			if (!setup.identityIndex) return;

			if (setup.giAutoCommitIdentityLockInProgress) return;
			setup.giAutoCommitIdentityLockInProgress = true;

			try {
				new Wikifier(null, "<<lockInIdentity>>"); /* sets init=2 */
				ensureConfiguredFlags(V);
			} catch (e) {
				console.error("[X-Change GI] auto-commit identity lock failed", e);
			} finally {
				setup.giAutoCommitIdentityLockInProgress = false;
			}
		}

		$(document).on(":passagedisplay", autoCommitIdentityLock);
		setTimeout(autoCommitIdentityLock, 0);
	})();>>>

	<<widget "tolerance">>
		<<if _args[0] isnot undefined>>
			<<set _mod to _args[0]>>
			<<if $identityOption>>
				<<set $identityOption.tolerance to Math.clamp($identityOption.tolerance + _mod, 0, 200)>>
				<<if $identityOption.tolerance gte 100 and !$identityOption.acceptance>>
					<<set $identityOption.acceptance to true>>
					<<set $effectsmessage to 1>>
					<<set $identityAcceptanceMessage to true>>
				<<elseif $identityOption.tolerance is 0 and $identityOption.acceptance>>
					<<set $identityOption.acceptance to false>>
					<<set $effectsmessage to 1>>
					<<set $breakdownEndMessage to true>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "hourlyIdentityEffects">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char,_icon range _category>>
				<<identitySelector _char>>
				<<if $identityOption>>
					<<if playerHasCharacteristic(_char)>>
						<<if $identityOption.acceptance and !$identityOption.reject>>
							<<tolerance 2>>
						<</if>>
						<<set _shift to ($identityOption.tolerance/50).toFixed(2)>>
						<<set _shift to Math.clamp(3-_shift, 1, 3)>>
						<<dysphoria _shift>>
						<<if $identityPreference>>
							<<stress -5>><<trauma -5>>
						<</if>>
						<<identityCleanup>>
					<<elseif $identityOption.dysphoria gt 0>>
						<<dysphoria -5>>
					<</if>>
				<</if>>
			<</for>>
		<</for>>
	<</widget>>

	<<widget "dailyIdentityEffects">>
		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char,_icon range _category>>
				<<identitySelector _char>>
				<<if $identityOption>>
					<<if $identityOption.dysphoria is 0>>
						<<if !playerHasCharacteristic(_char) and !$identityPreference>>
							<<tolerance -3>>
						<</if>>
					<<elseif !$identityOption.reject>>
						<<set _shift to Math.ceil(0 - ($identityOption.dysphoria / 2))>>
						<<tolerance 5>>
						<<dysphoria _shift>>
						<<sub `_shift * -0.1`>>
						<<willpower `_shift * 0.1`>>
						<<set $effectsmessage to 1>>
						<<set $dysphoriaProcessingMessage to 1>>
					<</if>>
				<</if>>
			<</for>>
		<</for>>
		<<gi-auto-update>>
	<</widget>>

	<<widget "misgender">>
		<<if $player.gender_appearance is "m">>
			<<identitySelector "Masculine Pronouns">>
			<<if !$identityOption.acceptance>>
				<<dysphoria 10>>
			<<else>>
				<<dysphoria -1>>
				<<if $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<<elseif $player.gender_appearance is "f">>
			<<identitySelector "Feminine Pronouns">>
			<<if !$identityOption.acceptance>>
				<<dysphoria 10>>
			<<else>>
				<<dysphoria -1>>
				<<if $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "encounterIdentityEffects">>
		<<if $player.vaginaExist and $vaginastate>>
			<<identitySelector "Vagina">>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $player.penisExist and $penisstate>>
			<<set _penis to identityCharacteristicCategory("Penis")>>
			<<identitySelector _penis>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $chestuse>>
			<<set _chest to identityCharacteristicCategory("Breasts")>>
			<<identitySelector _chest>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $bottomuse>>
			<<set _bottom to identityCharacteristicCategory("Ass")>>
			<<identitySelector _bottom>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
		<<if $speechhair>>
			<<set _hair to identityCharacteristicCategory("Hair")>>
			<<identitySelector _hair>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityBodyCheck">>
		<<set _body to identityCharacteristicCategory("Size")>>
			<<identitySelector _body>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 1>>
				<<elseif $identityPreference>>
					<<stress -1>><<trauma -1>>
				<</if>>
			<</if>>
	<</widget>>

	<<widget "identityCreampie">>
		<<set _bodyparts to _args[0]>>
		<<set _liquids to _args[1]>>
		<<set _amount to _args[2]>>
		<<identitySelector "Pregnancy">>
		<<if $identityOption and playerAwareTheyCanBePregnant()  and _bodyparts.includes("vagina") and _liquids.includesAny("cum", "semen") and _amount gte 1>>
			<<if (!$identityOption.acceptance or $identityOption.reject)>>
				<<dysphoria 10>>
			<</if>>
			<<if $identityPreference>>
				<<stress -10>><<trauma -10>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "identityCleanup">>
		<<if $identityOption?.misgendered>>
			<<set $identityOption.misgendered to 0>>
		<</if>>
	<</widget>>

	<<widget "g-genderidentity">>
	<</widget>>
	<<widget "gg-genderidentity">>
	<</widget>>
	<<widget "ggg-genderidentity">>
	<</widget>>
	<<widget "l-genderidentity">>
	<</widget>>
	<<widget "ll-genderidentity">>
	<</widget>>
	<<widget "lll-genderidentity">>
	<</widget>>


<!-- DNA'S TWEAK -->
	<<widget "xchange-ensure-bodysize-identity">>
		<<set $identity to $identity || {}>>
		<<set $identity.body to $identity.body || {}>>
		<<set $identity.body.bodysize to $identity.body.bodysize || {}>>

		<<if $identity.body.bodysize.preferred is undefined>>
			<<set $identity.body.bodysize.preferred to "normal">>
		<</if>>

		<<for _k range ["miniature","tiny","small","normal","tall","large","giant"]>>
			<<if $identity.body.bodysize[_k] is undefined>>
				<<set $identity.body.bodysize[_k] to {acceptance:false, reject:false, dysphoria:0, tolerance:0}>>
			<</if>>
		<</for>>
	<</widget>>

	<<widget "ensure-sexstats-min">>
		/* Only fill missing sub-fields that some widgets read. Avoid touching pregnancy/other complex structures. */
		<<if $sexStats is undefined>>
			<<set $sexStats = {}>>
		<</if>>

		<<if $sexStats.breasts is undefined>>
			<<set $sexStats.breasts = { playedWith : 0 }>>
		<<elseif $sexStats.breasts.playedWith is undefined>>
			<<set $sexStats.breasts.playedWith = 0>>
		<</if>>

		<<if $sexStats.creampie is undefined>>
			<<set $sexStats.creampie = {}>>
		<</if>>
		<<if $sexStats.creampie.self is undefined>>
			<<set $sexStats.creampie.self = { anus: 0, mouth: 0, vagina: 0 }>>
		<</if>>
		<<if $sexStats.creampie.npc is undefined>>
			<<set $sexStats.creampie.npc = { anus: 0, mouth: 0, vagina: 0 }>>
		<</if>>

		/* Some X-Change effects reference menstruation. Keep it lightweight. */
		<<if $sexStats.vagina is undefined>>
			<<set $sexStats.vagina = {}>>
		<</if>>
		<<if $sexStats.vagina.menstruation is undefined>>
			<<set $sexStats.vagina.menstruation = { running: false }>>
		<<elseif $sexStats.vagina.menstruation.running is undefined>>
			<<set $sexStats.vagina.menstruation.running = false>>
		<</if>>
	<</widget>>

	<<if $xchange.genderIdentityEnabled is undefined>>
		<<set $xchange.genderIdentityEnabled to true>>
	<</if>>
	<<if $genderidentity is undefined>>
		<<set $genderidentity to 500>>  /* midpoint of 0..1000 */
	<</if>>

	<<widget "gi-compute-target">>
		/* Produces:
			$xchange.giAxis    = absolute axis in [-1..1] where +1 = masculine, -1 = feminine
			$xchange.giTarget  = target $genderidentity in [0..giRange] relative to $player.gender
		*/

		<<set _sum to 0>>
		<<set _wsum to 0>>

		<<for _categoryName, _category range setup.identityIndex>>
			<<for _char,_icon range _category>>
				<<identitySelector _char>>
				<<if $identityOption>>

					/* Direction on absolute axis */
					<<set _dir to 0>>
					<<set _w to 1>>

					<<switch _char>>
						/* Masculine-leaning */
						<<case "Masculine Clothing">>
						<<case "Masculine Appearance">>
						<<case "Masculine Pronouns">>
						<<case "Small Penis">>
						<<case "Medium Penis">>
						<<case "Big Penis">>
						<<case "Flat Chest">>
						<<case "Short Hair">>
						<<case "Tall Body">>
						<<case "Large Body">>
						<<case "Giant Body">>
							<<set _dir to 1>>

						/* Feminine-leaning */
						<<case "Feminine Clothing">>
						<<case "Feminine Appearance">>
						<<case "Feminine Pronouns">>
						<<case "Vagina">>
						<<case "Small Breasts">>
						<<case "Medium Breasts">>
						<<case "Big Breasts">>
						<<case "Small Ass">>
						<<case "Medium Ass">>
						<<case "Big Ass">>
						<<case "Long Hair">>
						<<case "Pregnancy">>
						<<case "Lactation">>
							<<set _dir to -1>>

						/* Neutral-ish (pulls average toward 0 by adding weight but no signed sum) */
						<<case "Neutral Pronouns">>
						<<case "Medium Hair">>
						<<case "Miniature Body">>
						<<case "Tiny Body">>
						<<case "Normal Body">>
							<<set _dir to 0>>
							<<set _w to 1.25>>
					<</switch>>

					/* Build “support” for this option from preferred/accepted/rejected + dysphoria.
					This is intentionally bounded so it can’t explode.
					*/
					<<set _support to 0>>

					<<if $identityPreference>>
						<<set _support += 0.6>>
					<</if>>

					<<if $identityOption.acceptance>>
						<<set _support += 0.3>>
					<</if>>

					<<if $identityOption.reject>>
						<<set _support -= 0.8>>
					<</if>>

					<<set _dys to ($identityOption.dysphoria is undefined ? 0 : $identityOption.dysphoria)>>
					<<set _support -= Math.clamp((_dys / 100) * 0.4, 0, 0.4)>>

					<<set _support to Math.clamp(_support, -1, 1)>>

					<<set _sum += (_dir * _support * _w)>>
					<<set _wsum += _w>>

				<</if>>
			<</for>>
		<</for>>

		<<set _axis to (_wsum is 0 ? 0 : Math.clamp(_sum / _wsum, -1, 1))>>

		<<set _range to ($xchange.giRange is undefined ? 1000 : $xchange.giRange)>>
		<<set _absVal to Math.round(((_axis + 1) / 2) * _range)>>

		/* Convert absolute axis into the *existing* “relative to player.gender” meaning:
		- male: higher = more masculine
		- female: higher = more feminine
		*/
		<<set $xchange.giAxis to _axis>>
		<<set $xchange.giTarget to ($player.gender is "m" ? _absVal : (_range - _absVal))>>
	<</widget>>

	<<widget "gi-auto-update">>
		<<ensure-sexstats-min>>

		<<if !$xchange.genderIdentityEnabled or !$xchange.giAutoEnabled>>
			<<return>>
		<</if>>

		<<gi-compute-target>>

		<<set _range to ($xchange.giRange is undefined ? 1000 : $xchange.giRange)>>
		<<set _step to ($xchange.giStepPerDay is undefined ? 8 : $xchange.giStepPerDay)>>

		/* One-time init (migration) if save predates $genderidentity */
		<<if $genderidentity is undefined>>
			<<set $genderidentity to Math.round(_range / 2)>>
			<<set $xchange.giMigrationWarning to true>>
		<</if>>

		<<set _delta to Math.clamp($xchange.giTarget - $genderidentity, 0 - _step, _step)>>

		<<if _delta isnot 0>>
			<<set $genderidentity += _delta>>
			<<set $genderidentity to Math.clamp($genderidentity, 0, _range)>>
			<<gi-transform-from-drift _delta>>
		<</if>>

		/* --- Extra: drift from current GI position ("pressure"), so body keeps shifting even when GI has settled --- */
		<<if $xchange.giTransformEnabled>>
			<<set _mid to Math.floor(_range / 2)>>
			<<if _mid > 0>>
				<<set _pressureRaw to Math.abs($genderidentity - _mid)>>
				/* scale so it behaves the same whether range is 8 or 1000 */
				<<set _pressure to Math.round(Math.min(_step, (_pressureRaw / _mid) * _step))>>

				<<if _pressure > 0>>
					/* Signed so gi-transform-from-drift keeps using its own direction logic */
					<<set _signed to (($player.gender === "m")
						? (($genderidentity <= _mid) ? -_pressure : _pressure)
						: (($genderidentity >= _mid) ?  _pressure : -_pressure)
					)>>

					<<gi-transform-from-drift _signed>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "gi-transform-from-drift">>
		<<if !$xchange.giTransformEnabled>>
			<<return>>
		<</if>>

		<<set _delta to _args[0]>>
		<<if _delta is 0>>
			<<return>>
		<</if>>

		<<set _range to ($xchange.giRange is undefined ? 1000 : $xchange.giRange)>>
		<<set _mid to Math.floor(_range / 2)>>
		<<set _th to ($xchange.giTransformThreshold is undefined ? 30 : $xchange.giTransformThreshold)>>

		<<if $xchange.giDrift is undefined>><<set $xchange.giDrift to 0>><</if>>
		<<if $xchange.giShiftMode is undefined>><<set $xchange.giShiftMode to "">><</if>>
		<<if $xchange.giShiftStage is undefined>><<set $xchange.giShiftStage to 0>><</if>>

		/* Direction (matches "relative" GI meaning from gi-compute-target) */
		<<set _feminising to false>>
		<<if $player.gender is "m">>
			<<set _feminising to (_delta lt 0)>>
		<<else>>
			<<set _feminising to (_delta gt 0)>>
		<</if>>

		/* Which side of the meter are we CURRENTLY on? */
		<<set _onFeminineSide to false>>
		<<if $player.gender is "m">>
			<<set _onFeminineSide to ($genderidentity lte _mid)>>
		<<else>>
			<<set _onFeminineSide to ($genderidentity gte _mid)>>
		<</if>>

		/* Guard: don't change body until meter on the matching side */
		<<if (_feminising and not _onFeminineSide) or ((not _feminising) and _onFeminineSide)>>
			<<set $xchange.giDrift to 0>>
			<<return>>
		<</if>>

		/* Reset stage machine when direction flips */
		<<if _feminising and $xchange.giShiftMode isnot "f">>
			<<set $xchange.giShiftMode to "f">>
			<<set $xchange.giShiftStage to 0>>
		<<elseif (not _feminising) and $xchange.giShiftMode isnot "m">>
			<<set $xchange.giShiftMode to "m">>
			<<set $xchange.giShiftStage to 0>>
		<</if>>

		<<set $xchange.giDrift += Math.abs(_delta)>>

		<<for _iter = 0; _iter < 200 && $xchange.giDrift >= _th; _iter++>>
			<<set $xchange.giDrift -= _th>>
			<<if _feminising>>
				<<gi-feminise-step>>
			<<else>>
				<<gi-masculinise-step>>
			<</if>>
		<</for>>
	<</widget>>

	<<widget "gi-feminise-step">>
		/* Stage machine init */
		<<if $xchange.giShiftMode isnot "f">>
			<<set $xchange.giShiftMode to "f">>
			<<set $xchange.giShiftStage to 0>>
		<</if>>

		/* Stage 0: setup */
		<<if $xchange.giShiftStage is 0>>
			<<if $player.gender is "m">>
				<<set $xchange.giMaxGenderIdentityShift to 900>>
			<</if>>
			<<set $xchange.giShiftStage to 1>>
		<</if>>

		/* Stage 1: keep shrinking penis until it can be removed */
		<<if $xchange.giShiftStage is 1>>
			<<if $player.penisExist>>
				<<if $player.penissize gt 0>>
					<<set $player.penissize -= 1>>
					<<return>>
				<<else>>
					<<set $player.penisExist to false>>
					<<set $player.vaginaExist to true>>
					<<set $player.penissize to -2>>
					<<set $xchange.giShiftStage to 2>>
				<</if>>
			<<else>>
				<<if !$player.vaginaExist>>
					<<set $player.vaginaExist to true>>
				<</if>>
				<<set $xchange.giShiftStage to 2>>
			<</if>>
		<</if>>

		/* Stage 2: secondary sex characteristics (one change per step) */
		<<if $xchange.giShiftStage is 2>>
			<<if $player.breastsize lt 5>>
				<<set $player.breastsize += 1>>
				<<return>>
			<</if>>
			<<if $player.bottomsize lt 4>>
				<<set $player.bottomsize += 1>>
				<<return>>
			<</if>>
			<<set $xchange.giShiftStage to 3>>
		<</if>>

		/* Stage 3: align physical sex */
		<<if $xchange.giShiftStage is 3>>
			<<if $player.sex is "m">>
				<<set $player.sex to "f">>
			<</if>>
			<<set $xchange.giShiftStage to 2>>
		<</if>>
	<</widget>>

	<<widget "gi-masculinise-step">>
		/* Stage machine init */
		<<if $xchange.giShiftMode isnot "m">>
			<<set $xchange.giShiftMode to "m">>
			<<set $xchange.giShiftStage to 0>>
		<</if>>

		/* Stage 0: setup */
		<<if $xchange.giShiftStage is 0>>
			<<if $player.gender is "f">>
				<<set $xchange.giMaxGenderIdentityShift to 900>>
			<</if>>
			<<set $xchange.giShiftStage to 1>>
		<</if>>

		/* Stage 1: keep growing penis until it exists; then remove vagina */
		<<if $xchange.giShiftStage is 1>>
			<<if !$player.penisExist>>
				<<set $player.penisExist to true>>
				<<set $player.penissize to 0>>
				<<return>>
			<</if>>

			<<if $player.penissize lt 0>>
				<<set $player.penissize += 1>>
				<<return>>
			<</if>>

			<<if $player.vaginaExist>>
				<<set $player.vaginaExist to false>>
				<<return>>
			<</if>>

			<<set $xchange.giShiftStage to 2>>
		<</if>>

		/* Stage 2: secondary characteristics (one change per step) */
		<<if $xchange.giShiftStage is 2>>
			<<if $player.breastsize gt 0>>
				<<set $player.breastsize -= 1>>
				<<return>>
			<</if>>
			<<if $player.bottomsize gt 0>>
				<<set $player.bottomsize -= 1>>
				<<return>>
			<</if>>
			<<set $xchange.giShiftStage to 3>>
		<</if>>

		/* Stage 3: align physical sex */
		<<if $xchange.giShiftStage is 3>>
			<<if $player.sex is "f">>
				<<set $player.sex to "m">>
			<</if>>
			<<set $xchange.giShiftStage to 2>>
		<</if>>
	<</widget>>

	<<widget "ensureSexStatsForPhysicalAdjustments">>
		/* Root */
		<<if $sexStats is undefined or $sexStats is null>>
			<<set $sexStats to {}>>
		<</if>>

		/* Breasts */
		<<if $sexStats.breasts is undefined or $sexStats.breasts is null>>
			<<set $sexStats.breasts to {}>>
		<</if>>
		<<if $sexStats.breasts.playedWith is undefined>>
			<<set $sexStats.breasts.playedWith to 0>>
		<</if>>

		/* Creampie buckets */
		<<if $sexStats.creampie is undefined or $sexStats.creampie is null>>
			<<set $sexStats.creampie to {}>>
		<</if>>
		<<if $sexStats.creampie.self is undefined or $sexStats.creampie.self is null>>
			<<set $sexStats.creampie.self to {}>>
		<</if>>
		<<if $sexStats.creampie.npc is undefined or $sexStats.creampie.npc is null>>
			<<set $sexStats.creampie.npc to {}>>
		<</if>>

		<<if $sexStats.creampie.self.anus is undefined>><<set $sexStats.creampie.self.anus to 0>><</if>>
		<<if $sexStats.creampie.self.mouth is undefined>><<set $sexStats.creampie.self.mouth to 0>><</if>>
		<<if $sexStats.creampie.self.vagina is undefined>><<set $sexStats.creampie.self.vagina to 0>><</if>>

		<<if $sexStats.creampie.npc.anus is undefined>><<set $sexStats.creampie.npc.anus to 0>><</if>>
		<<if $sexStats.creampie.npc.mouth is undefined>><<set $sexStats.creampie.npc.mouth to 0>><</if>>
		<<if $sexStats.creampie.npc.vagina is undefined>><<set $sexStats.creampie.npc.vagina to 0>><</if>>

		/* Vagina / Anus + pregnancy chain */
		<<if $sexStats.vagina is undefined or $sexStats.vagina is null>>
			<<set $sexStats.vagina to {}>>
		<</if>>
		<<if $sexStats.vagina.pregnancy is undefined or $sexStats.vagina.pregnancy is null>>
			<<set $sexStats.vagina.pregnancy to {}>>
		<</if>>
		<<if $sexStats.vagina.pregnancy.fetus is undefined>><<set $sexStats.vagina.pregnancy.fetus to []>><</if>>
		<<if $sexStats.vagina.pregnancy.potentialFathers is undefined>><<set $sexStats.vagina.pregnancy.potentialFathers to []>><</if>>
		<<if $sexStats.vagina.pregnancy.parasiteBirthEvents is undefined>><<set $sexStats.vagina.pregnancy.parasiteBirthEvents to 0>><</if>>
		<<if $sexStats.vagina.pregnancy.parasiteFeltMovement is undefined>><<set $sexStats.vagina.pregnancy.parasiteFeltMovement to false>><</if>>
		<<if $sexStats.vagina.pregnancy.timeEnd is undefined>><<set $sexStats.vagina.pregnancy.timeEnd to null>><</if>>

		<<if $sexStats.anus is undefined or $sexStats.anus is null>>
			<<set $sexStats.anus to {}>>
		<</if>>
		<<if $sexStats.anus.pregnancy is undefined or $sexStats.anus.pregnancy is null>>
			<<set $sexStats.anus.pregnancy to {}>>
		<</if>>
		<<if $sexStats.anus.pregnancy.fetus is undefined>><<set $sexStats.anus.pregnancy.fetus to []>><</if>>
		<<if $sexStats.anus.pregnancy.potentialFathers is undefined>><<set $sexStats.anus.pregnancy.potentialFathers to []>><</if>>
		<<if $sexStats.anus.pregnancy.parasiteBirthEvents is undefined>><<set $sexStats.anus.pregnancy.parasiteBirthEvents to 0>><</if>>
		<<if $sexStats.anus.pregnancy.parasiteFeltMovement is undefined>><<set $sexStats.anus.pregnancy.parasiteFeltMovement to false>><</if>>
		<<if $sexStats.anus.pregnancy.timeEnd is undefined>><<set $sexStats.anus.pregnancy.timeEnd to null>><</if>>

		/* Pills structures used by physicalAdjustments */
		<<if $sexStats.pills is undefined or $sexStats.pills is null>>
			<<set $sexStats.pills to {}>>
		<</if>>
		<<if $sexStats.pills.mostTaken is undefined or $sexStats.pills.mostTaken is null>>
			<<set $sexStats.pills.mostTaken to {}>>
		<</if>>
		<<if $sexStats.pills["pills"] is undefined or $sexStats.pills["pills"] is null>>
			<<set $sexStats.pills["pills"] to {}>>
		<</if>>

		<<if $sexStats.pills.mostTaken["breast"] is undefined>><<set $sexStats.pills.mostTaken["breast"] to "">><</if>>
		<<if $sexStats.pills.mostTaken["penis"] is undefined>><<set $sexStats.pills.mostTaken["penis"] to "">><</if>>
		<<if $sexStats.pills.mostTaken["bottom"] is undefined>><<set $sexStats.pills.mostTaken["bottom"] to "">><</if>>

		<<if $sexStats.pills["pills"]["breast growth"] is undefined>><<set $sexStats.pills["pills"]["breast growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["breast reduction"] is undefined>><<set $sexStats.pills["pills"]["breast reduction"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["penis growth"] is undefined>><<set $sexStats.pills["pills"]["penis growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["penis reduction"] is undefined>><<set $sexStats.pills["pills"]["penis reduction"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["bottom growth"] is undefined>><<set $sexStats.pills["pills"]["bottom growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["bottom reduction"] is undefined>><<set $sexStats.pills["pills"]["bottom reduction"] to {doseTaken:0, overdose:0}>><</if>>
	<</widget>>
