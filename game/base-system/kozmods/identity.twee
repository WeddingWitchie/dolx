:: X-Change Gender Identity Widgets [widget]

<!-- LEGACY -->
	<<widget "genderidentity-orgasm">>
		<<if $player.vaginaExist>>
			<<identitySelector "Vagina">>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -10>><<trauma -10>>
				<</if>>
			<</if>>
		<</if>>
		<<set _manlyUse to ["othervagina", "otheranus", "othermouth", "tentacle"]>>
		<<if $player.penisExist and _manlyUse.includes($penisuse)>>
			<<set _penis to identityCharacteristicCategory("Penis")>>
			<<identitySelector _penis>>
			<<if $identityOption>>
				<<if !$identityOption.acceptance or $identityOption.reject>>
					<<dysphoria 10>>
				<<elseif $identityPreference>>
					<<stress -10>><<trauma -10>>
				<</if>>
			<</if>>
		<</if>>
	<</widget>>

	<<widget "genderidentity">>
		<<if _args[0]>>
			/* If it's a dream, reduce change to 10% */
			<<set _multiplier to $statFreeze isnot true ? 2 : 0.2>> 
			<<set _range to ($xchange.giRange is undefined ? 1500 : $xchange.giRange)>>
			<<set _identityCapFloor to Math.round(_range * 0.625)>>

			/* NOTE: This math bypass the GI attitude setting */
			<<if $backgroundTraits.includes("crossdresser") and !$background.transgender>><<set _multiplier *= _args[0] < 0 ? 1.25 : 0.50 >><</if>>
			<<if $backgroundTraits.includes("genderAnxious")>><<set _multiplier *= _args[0] > 0 ? 1.25 : 0.50 >><</if>>

			<<set $genderidentity += _args[0] * _multiplier>>
			<<set $genderidentity to Math.clamp($genderidentity,0, _range)>>
			<<if !$identityCap>>
				<<set $genderidentity to Math.clamp($genderidentity,0, _range)>>
			<<else>>
				<<if ($genderidentity < _identityCapFloor)>>
					<<set $identityCapMessage to true>>
					<<stress 10>><<trauma 10>>
				<</if>>
				<<set $genderidentity to Math.clamp($genderidentity,_identityCapFloor, _range)>>
			<</if>>
		<</if>>
	<</widget>>

	/* Is this even do anything right now? */
	<<widget "genderidentity-text">>
		<<if $xchange.genderIdentityEnabled>>
			<<if _args[0] is "f">>
				<span class="pink">Yesterday, you dressed feminine.</span>
			<<elseif _args[0] is "m">>
				<span class="blue">Yesterday, you dressed masculine.</span>
			<</if>>
		<</if>>
	<</widget>>


<!-- AELXER'S IDENTITY -->
	<<widget "identitySettings">>

		<div class="settingsGrid">
			<div class="settingsToggleItemWide">
				<span class="gold bold">Identity Mechanics:</span><br>
				<ul class="small-description">
					<li>Accepted characteristics don't have negative effects. You can have one preferred characteristic from accepted characteristics in each category, which grants minor Stress and Trauma reduction when you have them.</li>
					<li>You gain dysphoria for each characterisitc you have that you haven't accepted, which increases Stress and Trauma.</li>
					<li>You gain daily tolerance towards characteristics you have that you haven't accepted, until you reach acceptance at max tolerance.</li>
					<li>You don't gain Trauma from Rejected characteristics, but you don't gain Tolerance towards it either. Staying at maximum Dysphoria in a Rejected characteristic is dangerous.</li>
				</ul>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				Gender Presentation
			</div>

			<div class="settingsToggleItem">
				<span class="gold">Pronouns </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria. You can prefer multiple pronoun types. When all three are preferred, dynamic pronoun modes become available.</span></mouse>
				<br>
				Masculine:
				<br> 
				<label data-target='["identity.presentation.pronouns.masculine.acceptance", "identity.presentation.pronouns.masculine.reject"]' data-disabledif="V.identity.presentation.pronouns.masculine.acceptance && !V.identity.presentation.pronouns.masculine.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredMasculine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredMasculine || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.masculine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.masculine.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredMasculine" false true autocheck>></label>
				<br>
				Feminine:
				<br>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance", "identity.presentation.pronouns.feminine.reject"]' data-disabledif="V.identity.presentation.pronouns.feminine.acceptance && !V.identity.presentation.pronouns.feminine.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredFeminine", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredFeminine || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.feminine.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.feminine.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredFeminine" false true autocheck>></label>
				<br>
				Neutral:
				<br> 
				<label data-target='["identity.presentation.pronouns.neutral.acceptance", "identity.presentation.pronouns.neutral.reject"]' data-disabledif="V.identity.presentation.pronouns.neutral.acceptance && !V.identity.presentation.pronouns.neutral.reject" class="red">Reject <<checkbox "$identity.presentation.pronouns.neutral.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.pronouns.preferredNeutral", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.preferredNeutral || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.pronouns.neutral.reject", "identity.init"]' data-disabledif="V.identity.presentation.pronouns.neutral.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.pronouns.neutral.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.pronouns.neutral.acceptance"]' data-disabledif="!V.identity.presentation.pronouns.neutral.acceptance" class="green">Preferred <<checkbox "$identity.presentation.pronouns.preferredNeutral" false true autocheck>></label>
				<br>

				<<silently>>
					/* Ensure preferred booleans can't be true when acceptance is false */
					<<if $identity.presentation.pronouns.preferredMasculine and !$identity.presentation.pronouns.masculine.acceptance>>
						<<set $identity.presentation.pronouns.preferredMasculine to false>>
					<</if>>
					<<if $identity.presentation.pronouns.preferredFeminine and !$identity.presentation.pronouns.feminine.acceptance>>
						<<set $identity.presentation.pronouns.preferredFeminine to false>>
					<</if>>
					<<if $identity.presentation.pronouns.preferredNeutral and !$identity.presentation.pronouns.neutral.acceptance>>
						<<set $identity.presentation.pronouns.preferredNeutral to false>>
					<</if>>

					/* Count how many are individually preferred */
					<<set _prefPronCount to (
						($identity.presentation.pronouns.preferredMasculine ? 1 : 0) +
						($identity.presentation.pronouns.preferredFeminine ? 1 : 0) +
						($identity.presentation.pronouns.preferredNeutral ? 1 : 0)
					)>>

					/* Clear dynamic mode if not all three are preferred */
					<<if _prefPronCount lt 3 and ["body","clothing","appearance","posture"].includes($identity.presentation.pronouns.pronounDynamicMode)>>
						<<set $identity.presentation.pronouns.pronounDynamicMode to "">>
						<<set $effectsmessage to 1>>
						<<set $xchange.pronounPrefAutoFix to true>>
					<</if>>

					/* Sync legacy preferred field for backward compat */
					<<if _prefPronCount gte 3 and ["body","clothing","appearance","posture"].includes($identity.presentation.pronouns.pronounDynamicMode)>>
						<<set $identity.presentation.pronouns.preferred to $identity.presentation.pronouns.pronounDynamicMode>>
					<<elseif $identity.presentation.pronouns.preferredNeutral>>
						<<set $identity.presentation.pronouns.preferred to "n">>
					<<elseif $identity.presentation.pronouns.preferredFeminine>>
						<<set $identity.presentation.pronouns.preferred to "f">>
					<<elseif $identity.presentation.pronouns.preferredMasculine>>
						<<set $identity.presentation.pronouns.preferred to "m">>
					<<else>>
						<<set $identity.presentation.pronouns.preferred to "n">>
					<</if>>
				<</silently>>

				<<if $xchange.pronounPrefAutoFix>>
					<br><span class="red">Your dynamic pronoun mode was cleared because not all pronoun types are preferred.</span>
					<<set $xchange.pronounPrefAutoFix to false>>
				<</if>>

				<div data-target='["identity.presentation.pronouns.preferredMasculine", "identity.presentation.pronouns.preferredFeminine", "identity.presentation.pronouns.preferredNeutral"]' data-disabledif="!(V.identity.presentation.pronouns.preferredMasculine && V.identity.presentation.pronouns.preferredFeminine && V.identity.presentation.pronouns.preferredNeutral)">
					<span class="gold">Preferred pronouns based on: </span>
					<br> 
					<label>Current Sex <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "body" autocheck>></label> |
					<label>Clothing <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "clothing" autocheck>></label> |
					<label>Appearance <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "appearance" autocheck>></label> |
					<label>Posture <<radiobutton "$identity.presentation.pronouns.pronounDynamicMode" "posture" autocheck>></label>
				</div>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Gender Appearance </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Masculine: 
				<br> 
				<label data-target='["identity.presentation.appearance.masculine.acceptance", "identity.presentation.appearance.masculine.reject"]' data-disabledif="V.identity.presentation.appearance.masculine.acceptance && !V.identity.presentation.appearance.masculine.reject" class="red">Reject <<checkbox "$identity.presentation.appearance.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'm' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.appearance.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.appearance.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.masculine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.masculine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.appearance.preferred" "m" autocheck>></label>
				<br>
				Feminine:
				<br> 
				<label data-target='["identity.presentation.appearance.feminine.acceptance", "identity.presentation.appearance.feminine.reject"]' data-disabledif="V.identity.presentation.appearance.feminine.acceptance && !V.identity.presentation.appearance.feminine.reject" class="red">Reject <<checkbox "$identity.presentation.appearance.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.appearance.preferred", "identity.init"]' data-disabledif="V.identity.presentation.appearance.preferred === 'f' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.appearance.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.appearance.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.appearance.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.appearance.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.appearance.feminine.acceptance"]' data-disabledif="!V.identity.presentation.appearance.feminine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.appearance.preferred" "f" autocheck>></label>
				<br>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Clothing Preference </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Masculine: 
				<br> 
				<label data-target='["identity.presentation.clothing.masculine.acceptance", "identity.presentation.clothing.masculine.reject"]' data-disabledif="V.identity.presentation.clothing.masculine.acceptance && !V.identity.presentation.clothing.masculine.reject" class="red">Reject <<checkbox "$identity.presentation.clothing.masculine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'm' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.clothing.masculine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.masculine.reject", "identity.init"]' data-disabledif="V.identity.presentation.clothing.masculine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.clothing.masculine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.masculine.acceptance"]' data-disabledif="!V.identity.presentation.clothing.masculine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.clothing.preferred" "m" autocheck>></label>
				<br>
				Feminine:
				<br> 
				<label data-target='["identity.presentation.clothing.feminine.acceptance", "identity.presentation.clothing.feminine.reject"]' data-disabledif="V.identity.presentation.clothing.feminine.acceptance && !V.identity.presentation.clothing.feminine.reject" class="red">Reject <<checkbox "$identity.presentation.clothing.feminine.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender>>
					<label data-target='["identity.presentation.clothing.preferred", "identity.init"]' data-disabledif="V.identity.presentation.clothing.preferred === 'f' || V.identity.init">Unaccepted <<radiobutton "$identity.presentation.clothing.feminine.acceptance" false autocheck>></label> |
					<label data-target='["identity.presentation.clothing.feminine.reject", "identity.init"]' data-disabledif="V.identity.presentation.clothing.feminine.reject || V.identity.init">Accepted <<radiobutton "$identity.presentation.clothing.feminine.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.presentation.clothing.feminine.acceptance"]' data-disabledif="!V.identity.presentation.clothing.feminine.acceptance" class="green">Preferred <<radiobutton "$identity.presentation.clothing.preferred" "f" autocheck>></label>
				<br>
			</div>
		</div>
		<hr>
		<div class="settingsGrid">
			<div class="settingsHeader">
				Body
			</div>

		<div class="settingsToggleItemWide">
			<span class="gold bold">Body identity toggles:</span><br>
				<label class="gi-body-toggle" data-gi-key="giBreastSizeEnabled" data-gi-box="gi-box-breasts" data-target='["xchange.giBreastSizeEnabled"]'>Breast Size <<checkbox "$xchange.giBreastSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giAssSizeEnabled" data-gi-box="gi-box-ass" data-target='["xchange.giAssSizeEnabled"]'>Ass Size <<checkbox "$xchange.giAssSizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giGenitalsEnabled" data-gi-box="gi-box-genitals" data-target='["xchange.giGenitalsEnabled"]'>Genitals <<checkbox "$xchange.giGenitalsEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giHairLengthEnabled" data-gi-box="gi-box-hair" data-target='["xchange.giHairLengthEnabled"]'>Hair Length <<checkbox "$xchange.giHairLengthEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giBodySizeEnabled" data-gi-box="gi-box-bodysize" data-target='["xchange.giBodySizeEnabled"]'>Body Size <<checkbox "$xchange.giBodySizeEnabled" false true autocheck>></label> |
				<label class="gi-body-toggle" data-gi-key="giFecundityEnabled" data-gi-box="gi-box-fecundity" data-target='["xchange.giFecundityEnabled"]'>Fecundity <<checkbox "$xchange.giFecundityEnabled" false true autocheck>></label>
				<mouse class="tooltip linkBlue">(?)<span>Enable which Body topics are active for dysphoria/tolerance. Disabled categories are hidden and have no effect.</span></mouse>
		</div>

		<<run (function () {
			if (setup.giBodyToggleInstalled) return;
			setup.giBodyToggleInstalled = true;

			function syncFromState() {
				$(".gi-body-toggle").each(function () {
					var key = this.getAttribute("data-gi-key");
					var boxId = this.getAttribute("data-gi-box");
					var enabled = State.variables.xchange && State.variables.xchange[key];
					var box = document.getElementById(boxId);
					if (box) box.style.display = enabled ? "" : "none";
				});
			}

			$(document).on("change", ".gi-body-toggle input[type=checkbox]", function () {
				var label = this.closest(".gi-body-toggle");
				if (!label) return;
				var boxId = label.getAttribute("data-gi-box");
				var box = document.getElementById(boxId);
				if (box) box.style.display = this.checked ? "" : "none";
			});

		/* Mark category as configured once the player interacts with anything inside it.
		Use click for inputs so selecting "Unaccepted" (false->false) still counts as chosen. */
		function markGiConfigured(el) {
			var box = el.closest(".settingsToggleItem[data-gi-config]");
			if (!box) return;
			var ckey = box.getAttribute("data-gi-config");
			if (!ckey) return;
			if (!State.variables.xchange) State.variables.xchange = {};
			State.variables.xchange[ckey] = true;
		}

		/* inputs (checkbox/radio) */
		$(document).on("click", ".settingsToggleItem[data-gi-config] input", function () {
			markGiConfigured(this);
		});

		/* selects */
		$(document).on("change", ".settingsToggleItem[data-gi-config] select", function () {
			markGiConfigured(this);
		});
		$(document).on(":passagedisplay", syncFromState);
			setTimeout(syncFromState, 0);
		})();>>

			<div class="settingsToggleItem" id="gi-box-breasts" data-gi-config="giBreastSizeConfigured" style="display:none;">
				<span class="gold">Breast Size </span> <mouse class="tooltip linkBlue">(?)<span>Unaccepted characteristics will cause dysphoria.</span></mouse>
				<br>
				Flat: 
				<br> 
				<label data-target='["identity.body.chest.flat.acceptance", "identity.body.chest.flat.reject"]' data-disabledif="V.identity.body.chest.flat.acceptance && !V.identity.body.chest.flat.reject" class="red">Reject <<checkbox "$identity.body.chest.flat.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender or !$xchange.giBreastSizeConfigured>>
					<label data-target='["identity.body.chest.preferred", "identity.init"]' data-disabledif="V.identity.body.chest.preferred === 'flat'">Unaccepted <<radiobutton "$identity.body.chest.flat.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.chest.flat.reject", "identity.init"]' data-disabledif="V.identity.body.chest.flat.reject">Accepted <<radiobutton "$identity.body.chest.flat.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.chest.flat.acceptance"]' data-disabledif="!V.identity.body.chest.flat.acceptance" class="green">Preferred <<radiobutton "$identity.body.chest.preferred" "flat" autocheck>></label>
				<br>
				Small: 
				<br> 
				<label data-target='["identity.body.chest.small.acceptance", "identity.body.chest.small.reject"]' data-disabledif="V.identity.body.chest.small.acceptance && !V.identity.body.chest.small.reject" class="red">Reject <<checkbox "$identity.body.chest.small.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender or !$xchange.giBreastSizeConfigured>>
					<label data-target='["identity.body.chest.preferred", "identity.init"]' data-disabledif="V.identity.body.chest.preferred === 'small'">Unaccepted <<radiobutton "$identity.body.chest.small.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.chest.small.reject", "identity.init"]' data-disabledif="V.identity.body.chest.small.reject">Accepted <<radiobutton "$identity.body.chest.small.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.chest.small.acceptance"]' data-disabledif="!V.identity.body.chest.small.acceptance" class="green">Preferred <<radiobutton "$identity.body.chest.preferred" "small" autocheck>></label>
				<br>
				Medium: 
				<br> 
				<label data-target='["identity.body.chest.medium.acceptance", "identity.body.chest.medium.reject"]' data-disabledif="V.identity.body.chest.medium.acceptance && !V.identity.body.chest.medium.reject" class="red">Reject <<checkbox "$identity.body.chest.medium.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender or !$xchange.giBreastSizeConfigured>>
					<label data-target='["identity.body.chest.preferred", "identity.init"]' data-disabledif="V.identity.body.chest.preferred === 'medium'">Unaccepted <<radiobutton "$identity.body.chest.medium.acceptance" false autocheck>></label> |
					<label data-target='["identity.body.chest.medium.reject", "identity.init"]' data-disabledif="V.identity.body.chest.medium.reject">Accepted <<radiobutton "$identity.body.chest.medium.acceptance" true autocheck>></label> |
				<</if>>
				<label data-target='["identity.body.chest.medium.acceptance"]' data-disabledif="!V.identity.body.chest.medium.acceptance" class="green">Preferred <<radiobutton "$identity.body.chest.preferred" "medium" autocheck>></label>
				<br>
				Big: 
				<br> 
				<label data-target='["identity.body.chest.big.acceptance", "identity.body.chest.big.reject"]' data-disabledif="V.identity.body.chest.big.acceptance && !V.identity.body.chest.big.reject" class="red">Reject <<checkbox "$identity.body.chest.big.reject" false true autocheck>></label> |
				<<if $identity.init isnot 2 or $background.transgender or !$xchange.giBreastSizeConfigured>>
					<label data-target='["identity.body.chest.preferred", "identity.init"]' data-disabledif="V.identity.body.chest.preferred === 'big'">Unaccepted <<radiobutton "$identity.body.chest.big.acceptance" false autocheck>></label> |
