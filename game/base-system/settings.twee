			</div>
			<div class="settingsToggleItem">
				<span class="gold bold">Genderflipped Skin Colour:</span><br>
				<label>Same as before <<radiobutton "$xchange.customisedSkinColour" "nochange" autocheck>></label> |
				<label>Random <<radiobutton "$xchange.customisedSkinColour" "random" autocheck>></label>
				<br><br>
				<span class="gold">Reddish:</span><br>
				<label>Light <<radiobutton "$xchange.customisedSkinColour" "light" autocheck>></label> |
				<label>Medium <<radiobutton "$xchange.customisedSkinColour" "medium" autocheck>></label> |
				<label>Dark <<radiobutton "$xchange.customisedSkinColour" "dark" autocheck>></label> |
				<label>Gyaru <<radiobutton "$xchange.customisedSkinColour" "gyaru" autocheck>></label>
				<br><br>
