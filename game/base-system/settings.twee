				<label><span class="mediumpurple">Medium Purple</span> <<radiobutton "$xchange.customisedHairColour" "mediumpurple" autocheck>></label> |
				<label><span class="brightpurple">Bright Purple</span> <<radiobutton "$xchange.customisedHairColour" "brightpurple" autocheck>></label> |
				<label><span class="white">White</span> <<radiobutton "$xchange.customisedHairColour" "white" autocheck>></label> |
