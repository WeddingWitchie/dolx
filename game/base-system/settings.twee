				<label><span class="lime-green">Lime Green</span> <<radiobutton "$xchange.customisedEyeColour" "lime green" autocheck>></label> |
				<label><span class="red">Red</span> <<radiobutton "$xchange.customisedEyeColour" "red" autocheck>></label> |
				<label><span class="pink">Pink</span> <<radiobutton "$xchange.customisedEyeColour" "pink" autocheck>></label> |
				<label><span class="grey">Grey</span> <<radiobutton "$xchange.customisedEyeColour" "grey" autocheck>></label> |
				<label><span class="light-grey">Light Grey</span> <<radiobutton "$xchange.customisedEyeColour" "light grey" autocheck>></label> |
				<label><span>Random</span> <<radiobutton "$xchange.customisedEyeColour" "random" autocheck>></label>
			</div>
			<div class="settingsToggleItemWide">
				<span class="gold bold">Genderflipped Hair Colour:</span><br>
				<label><span>Same as before</span> <<radiobutton "$xchange.customisedHairColour" "nochange" autocheck>></label> |
				<label><span class="red">Red</span> <<radiobutton "$xchange.customisedHairColour" "red" autocheck>></label> |
				<label><span class="jetblack">Jet Black</span> <<radiobutton "$xchange.customisedHairColour" "jetblack" autocheck>></label> |
