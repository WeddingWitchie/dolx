				<label><span class="burntorange">Burnt Orange</span> <<radiobutton "$xchange.customisedHairColour" "burntorange" autocheck>></label> |
				<label><span class="strawberry">Strawberry blond</span> <<radiobutton "$xchange.customisedHairColour" "strawberryblond" autocheck>></label> |
				<label><span class="tangerine">Ginger</span> <<radiobutton "$xchange.customisedHairColour" "ginger" autocheck>></label> |
				<label><span class="gold">Blond</span> <<radiobutton "$xchange.customisedHairColour" "blond" autocheck>></label> |
