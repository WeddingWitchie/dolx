:: Cheats Mod [widget]
<<widget "cheat-set-pill-duration">>
	/* args[0]: duration in hours (number), or the string "permanent" */
	<<if _args[0] is "permanent">>
		/* Force the permanence setting on, otherwise xchange.js force-reverts permanent pills on the next tick */
		<<set $xchange.pillPermanence to 1>>
		<<xchange-setpermanent>>
	<<else>>
		<<set $xchange.pill.duration to _args[0]>>
		<<set $xchange.pill.countdown to 0>>
		<<unset $xchange.pill.shouldHaveEnded>>
		<<unset $xchange.pill.resistanceFakeout>>
	<</if>>
<</widget>>

<<widget "cheatXchange">>
	<<linkreplace "Force pill to end">>Forced pill to end<<xchange-restore>><<updatesidebarimg>><</linkreplace>>
	<br><br>
	Pill duration: <<if pillIsPermanent()>><span class="green">Permanent</span><<else>><span class="teal"><<print-pillduration>></span><</if>>
	<br>
	Set duration:
	<<link "1 day">><<cheat-set-pill-duration 24>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "3 days">><<cheat-set-pill-duration 72>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "1 week">><<cheat-set-pill-duration 168>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "1 month">><<cheat-set-pill-duration 720>><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>> |
	<<link "Permanent">><<cheat-set-pill-duration "permanent">><<updatesidebarimg>><<replace "#cheat-xchange-pills">><<cheatXchange>><</replace>><</link>>
	<br><br>
	Sissy/Butch: <span id="xchange-crossdress"><<= $xchange.pill.genderificationEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.genderificationEffect to $xchange.pill.genderificationEffect? false : true>><<replace "#xchange-crossdress">><<= $xchange.pill.genderificationEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br>
	Resistance: <span id="xchange-resistance"><<= $xchange.pill.resistanceEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.resistanceEffect to $xchange.pill.resistanceEffect? false : true>><<set $xchange.pill.resistanceChance to 100>><<replace "#xchange-resistance">><<= $xchange.pill.resistanceEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br>
	Continue: <span id="xchange-continue"><<= $xchange.pill.continueEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.continueEffect to $xchange.pill.continueEffect? false : true>><<replace "#xchange-continue">><<= $xchange.pill.continueEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br>
	<<if $player.sex isnot "m" or (playerIsXChanged() and $xchange.pill.hermEffect)>>
		Breeder:
		<span id="xchange-breeder"><<= $xchange.pill.breederEffect ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
		<<link "Change">><<if $xchange.pill.breederEffect>><<xchange-removeeffect "breeder">><<else>><<xchange-addeffect "breeder">><</if>><<replace "#xchange-breeder">><<= $xchange.pill.breederEffect ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
		<br>
		Fertile:
		<span id="xchange-fertile"><<= $xchange.pill.fertile ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
		<<link "Change">><<if $xchange.pill.fertile>><<xchange-removeeffect "fertile">>	<<else>><<xchange-addeffect "fertile">>	<</if>>
		<<replace "#xchange-fertile">><<= $xchange.pill.fertile ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
		<br>
	<</if>>
	<<if $player.sex isnot "f" or (playerIsXChanged() and $xchange.pill.hermEffect)>>
		Bull: <span id="xchange-bull"><<= $xchange.pill.bullEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.bullEffect to $xchange.pill.bullEffect? false : true>><<replace "#xchange-bull">><<= $xchange.pill.bullEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
		<br>
	<</if>>
	Passion: <span id="xchange-passion"><<= $xchange.pill.passionEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.passionEffect to $xchange.pill.passionEffect? false : true>><<replace "#xchange-passion">><<= $xchange.pill.passionEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br>
	Dumb Bitch: <span id="xchange-bitch"><<= $xchange.pill.dumbBitchEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.dumbBitchEffect to $xchange.pill.dumbBitchEffect? false : true>><<replace "#xchange-bitch">><<= $xchange.pill.dumbBitchEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br>
	<<if $portalPantiesEnabled>>
		Portal: <span id="xchange-portal"><<= $xchange.pill.portalEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.portalEffect to $xchange.pill.portalEffect? false : true>><<set $xchange.pill.portalEffectTimer to $xchange.pill.duration>><<replace "#xchange-portal">><<= $xchange.pill.portalEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
		<br>
	<</if>>

	/* New effects */
	Innocence:
	<span id="xchange-innocence"><<= $innocencestate is 1 ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
	<<link "Change">>
		<<if $innocencestate is 1>>
			<<xchange-removeeffect "innocence">>
		<<else>>
			<<xchange-addeffect "innocence">>
		<</if>>
		<<replace "#xchange-innocence">><<= $innocencestate is 1 ? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>>
	<</link>>
	<br>
	Swell: <span id="xchange-swell"><<= $xchange.pill.swellEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
	<<link "Change">>
		<<if $xchange.pill.swellEffect>>
			<<xchange-removeeffect "swell">>
		<<else>>
			<<xchange-addeffect "swell">>
		<</if>>
		<<replace "#xchange-swell">><<= $xchange.pill.swellEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>>
	<</link>>
	<br>
	Bimbo: <span id="xchange-bimbo"><<= $xchange.pill.bimboEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
	<<link "Change">>
		<<if $xchange.pill.bimboEffect>>
			<<xchange-removeeffect "bimbo">>
		<<else>>
			<<xchange-addeffect "bimbo">>
		<</if>>
		<<replace "#xchange-bimbo">><<= $xchange.pill.bimboEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>>
	<</link>>
	<br>
	Cumcure: <span id="xchange-cumcure"><<= $xchange.pill.cumcureEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> |
	<<link "Change">>
		<<if $xchange.pill.cumcureEffect>>
			<<xchange-removeeffect "cumcure">>
		<<else>>
			<<xchange-addeffect "cumcure">>
		<</if>>
		<<replace "#xchange-cumcure">><<= $xchange.pill.cumcureEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>>
	<</link>>
	<br>
	X-Tend: <span id="xchange-xtend"><<= $xchange.pill.xtendEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.xtendEffect to $xchange.pill.xtendEffect? false : true>><<set $xchange.pill.xtendTracker to {orgasmed: 0, penisSizeGains: 0}>><<replace "#xchange-xtend">><<= $xchange.pill.xtendEffect? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br><br>

	Effects Known: <span id="xchange-spike"><<= $xchange.pill.effectsKnown? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">></span> | <<link "Change">><<set $xchange.pill.effectsKnown to $xchange.pill.effectsKnown? false : true>><<replace "#xchange-spike">><<= $xchange.pill.effectsKnown? "<span class=\"green\">On</span>" : "<span class=\"red\">Off</span>">><</replace>><</link>>
	<br><br>
<</widget>>


<<widget "cheats-alex">>
	<u>Animal Respect</u>
	<br>

	<<link "<<<">><<set $farm.beasts.horses -= 20>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>> |
	<<link "<<">><<set $farm.beasts.horses -= 5>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>> |
	<<link "<">><<set $farm.beasts.horses -= 1>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>> |
	Steeds' respect: <span id="horse_respect"><<print Math.trunc($farm.beasts.horses)>></span>
	| <<link ">">><<set $farm.beasts.horses += 1>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>>
	| <<link ">>">><<set $farm.beasts.horses += 5>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>>
	| <<link ">>>">><<set $farm.beasts.horses += 20>><<set $farm.beasts.horses = Math.clamp($farm.beasts.horses, -30, 30)>><<replace "#horse_respect">><<print Math.trunc($farm.beasts.horses)>><</replace>><</link>>
	<br>
	<<link "<<<">><<set $farm.beasts.pigs -= 20>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>> |
	<<link "<<">><<set $farm.beasts.pigs -= 5>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>> |
	<<link "<">><<set $farm.beasts.pigs -= 1>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>> |
	Pigs' respect: <span id="pig_respect"><<print Math.trunc($farm.beasts.pigs)>></span>
	| <<link ">">><<set $farm.beasts.pigs += 1>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>>
	| <<link ">>">><<set $farm.beasts.pigs += 5>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>>
	| <<link ">>>">><<set $farm.beasts.pigs += 20>><<set $farm.beasts.pigs = Math.clamp($farm.beasts.pigs, -30, 30)>><<replace "#pig_respect">><<print Math.trunc($farm.beasts.pigs)>><</replace>><</link>>
	<br>
	<<link "<<<">><<set $farm.beasts.cattle -= 20>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>> |
	<<link "<<">><<set $farm.beasts.cattle -= 5>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>> |
	<<link "<">><<set $farm.beasts.cattle -= 1>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>> |
	Cattle respect: <span id="cattle_respect"><<print Math.trunc($farm.beasts.cattle)>></span>
	| <<link ">">><<set $farm.beasts.cattle += 1>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>>
	| <<link ">>">><<set $farm.beasts.cattle += 5>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>>
	| <<link ">>>">><<set $farm.beasts.cattle += 20>><<set $farm.beasts.cattle = Math.clamp($farm.beasts.cattle, -30, 30)>><<replace "#cattle_respect">><<print Math.trunc($farm.beasts.cattle)>><</replace>><</link>>
	<br>
	<<link "<<<">><<set $farm.beasts.dogs -= 20>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>> |
	<<link "<<">><<set $farm.beasts.dogs -= 5>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>> |
	<<link "<">><<set $farm.beasts.dogs -= 1>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>> |
	Dogs' respect: <span id="dog_respect"><<print Math.trunc($farm.beasts.dogs)>></span>
	| <<link ">">><<set $farm.beasts.dogs += 1>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>>
	| <<link ">>">><<set $farm.beasts.dogs += 5>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>>
	| <<link ">>>">><<set $farm.beasts.dogs += 20>><<set $farm.beasts.dogs = Math.clamp($farm.beasts.dogs, -30, 30)>><<replace "#dog_respect">><<print Math.trunc($farm.beasts.dogs)>><</replace>><</link>>
	<br><br>

	<u>Farm</u>

	<br>
	<<if $farm_stage gte 6 and $farm_countdown is undefined and $wardrobes.alexFarm.unlocked is false>>
		<<set $farm_countdown to 7>>
		<<set $alex_countdown to 3>>
		<<set $wardrobes.alexFarm.unlocked to true>>
	<</if>>

	<<farmcheatsync>>
	Farm Plots: <span id="farm_stage_cheat"><<print Math.trunc($farm_stage_cheat)>></span>
	<<link ">">><<farmincrcheat>><<set $farm_stage_cheat = Math.clamp($farm_stage_cheat, 1, 9)>><<replace "#farm_stage_cheat">><<print Math.trunc($farm_stage_cheat)>><</replace>><</link>>
	<br>
	Note: The above may or may not break the farm.
	<br>
	<<if $farm.clearing is undefined>>
		<<set $farm.clearing to 0>>
	<</if>>
	<<link "<<<">><<set $farm.clearing -= 100>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>> |
	<<link "<<">><<set $farm.clearing -= 50>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>> |
	<<link "<">><<set $farm.clearing -= 1>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>> |
	Farm Clearing: <span id="farm_clearing"><<print Math.trunc($farm.clearing)>></span>
	| <<link ">">><<set $farm.clearing += 1>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>>
	| <<link ">>">><<set $farm.clearing += 50>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>>
	| <<link ">>>">><<set $farm.clearing += 100>><<set $farm.clearing = Math.clamp($farm.clearing, 0, 100)>><<replace "#farm_clearing">><<print Math.trunc($farm.clearing)>><</replace>><</link>>
	<br><br>
	<<if $farm_stage gte 8>>
		<<if $farm.wall is undefined>>
			<<set $farm.wall to 0>>
		<</if>>
		<<link "<<<">><<set $farm.wall -= 3>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>> |
		<<link "<<">><<set $farm.wall -= 2>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>> |
		<<link "<">><<set $farm.wall -= 1>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>> |
		Farm Wall: <span id="farm_wall"><<print Math.trunc($farm.wall)>></span>
		| <<link ">">><<set $farm.wall += 1>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>>
		| <<link ">>">><<set $farm.wall += 2>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>>
		| <<link ">>>">><<set $farm.wall += 3>><<set $farm.wall = Math.clamp($farm.wall, 0, 4)>><<replace "#farm_wall">><<print Math.trunc($farm.wall)>><</replace>><</link>>
		<br>
		<<if $farm.tower is undefined>>
			<<set $farm.tower to 0>>
		<</if>>
		<<if $farm.tower gte 1 and !$farm.tower_guard>>
			<<set $farm.tower_guard_can_hire to true>>
		<<elseif $farm.tower lte 0>>
			<<set $farm.tower_guard_can_hire to false>>
			<<unset $farm.tower_guard>>
		<</if>>
		<<link "<<">><<set $farm.tower -= 2>><<set $farm.tower = Math.clamp($farm.tower, 0, 2)>><<replace "#farm_tower">><<print Math.trunc($farm.tower)>><</replace>><</link>> |
		<<link "<">><<set $farm.tower -= 1>><<set $farm.tower = Math.clamp($farm.tower, 0, 2)>><<replace "#farm_tower">><<print Math.trunc($farm.tower)>><</replace>><</link>> |
		Farm Tower: <span id="farm_tower"><<print Math.trunc($farm.tower)>></span>
		| <<link ">">><<set $farm.tower += 1>><<set $farm.tower = Math.clamp($farm.tower, 0, 2)>><<replace "#farm_tower">><<print Math.trunc($farm.tower)>><</replace>><</link>>
		| <<link ">>">><<set $farm.tower += 2>><<set $farm.tower = Math.clamp($farm.tower, 0, 2)>><<replace "#farm_tower">><<print Math.trunc($farm.tower)>><</replace>><</link>>
		<br>
		<<if $farm.woodland is undefined>>
			<<set $farm.woodland to 0>>
		<</if>>
		<<link "<<<">><<set $farm.woodland -= 3>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>> |
		<<link "<<">><<set $farm.woodland -= 2>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>> |
		<<link "<">><<set $farm.woodland -= 1>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>> |
		Farm Woodland: <span id="farm_woodland"><<print Math.trunc($farm.woodland)>></span>
		| <<link ">">><<set $farm.woodland += 1>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>>
		| <<link ">>">><<set $farm.woodland += 2>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>>
		| <<link ">>>">><<set $farm.woodland += 3>><<set $farm.woodland = Math.clamp($farm.woodland, 0, 7)>><<replace "#farm_woodland">><<print Math.trunc($farm.woodland)>><</replace>><</link>>
		<br>
		<<if $farm.kennel is undefined>>
			<<set $farm.kennel to 0>>
		<</if>>
		<<link "<">><<set $farm.kennel -= 1>><<set $farm.kennel = Math.clamp($farm.kennel, 0, 1)>><<replace "#farm_kennel">><<print Math.trunc($farm.kennel)>><</replace>><</link>> |
		Farm Kennel: <span id="farm_kennel"><<print Math.trunc($farm.kennel)>></span>
