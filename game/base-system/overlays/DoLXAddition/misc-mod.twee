:: Pregnancy Birth Hospital Poppy
<<set $outside to 0>><<set $location to "hospital">><<effects>>
<<endevent>><<npc "Poppy">><<person1>>
<<run poppySchedule()>><<run markPoppyInteraction()>>
<<run delete $poppy_pregnancy>>
<<getChildrenIds>><<childSelect _childrenIds.last()>>
Poppy is on <<his>> feet the moment <<he>> sees you, crossing the ward before the midwife can get a word out.
<br><br>
"My jewel," <<he>> breathes, taking your hands in <<his>>. "You did it. You actually did it."
<<if $litter_size gte 2>>
	<<He>> glances to where <<childrenNames $bornChildrenIds>> lie swaddled in their cradles, and <<his>> breath catches. "Look at them. Look at what we made."
<<else>>
	<<He>> glances to where <<childname>> lies swaddled in the cradle, and <<his>> breath catches. "Look at <<childhim>>. Look at what we made."
<</if>>
<br><br>
Poppy leans down and brushes the backs of <<his>> fingers over <<if $litter_size gte 2>>the nearest tiny cheek<<else>><<childname>>'s cheek<</if>>, careful as though afraid of leaving a mark.
A faint powdery scent follows <<him>>, and for once you're too worn out to mind it.
<br><br>
"I'm so proud of you." <<He>> presses a lingering kiss to your damp forehead. "Rest now. I'll take care of everything else. That's a promise."<<lllstress>><<stress -20>><<glove>><<npcincr Poppy love 2>>
<<poppyOpiumPulse>>
<<link [[Next|Pregnancy Birth Hospital 6]]>><<endevent>><</link>>
<br>

:: Cheats Mod [widget]
<<widget "cheats-alex">>
	<div class="settingsGrid">
		<div class="settingsHeader options">Animal Respect</div>
		<<numberStepper "🐎 Steeds' Respect" $farm.beasts.horses {callback: value => V.farm.beasts.horses = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐖 Pigs' Respect" $farm.beasts.pigs {callback: value => V.farm.beasts.pigs = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐄 Cattle Respect" $farm.beasts.cattle {callback: value => V.farm.beasts.cattle = value, min: -30, max: 30, step: 1, percentage: false}>>
		<<numberStepper "🐕 Dogs' Respect" $farm.beasts.dogs {callback: value => V.farm.beasts.dogs = value, min: -30, max: 30, step: 1, percentage: false}>>
	</div>

	<<if $farm_stage gte 6 and $farm_countdown is undefined and $wardrobes.alexFarm.unlocked is false>>
		<<set $farm_countdown to 7>>
		<<set $alex_countdown to 3>>
		<<set $wardrobes.alexFarm.unlocked to true>>
	<</if>>
	<<farmcheatsync>>

	<div class="settingsGrid">
		<div class="settingsHeader options">Farm Progress</div>
		<div class="settingsToggleItemWide description">Farm plots can only be advanced because each new plot also initialises its gameplay data. As before, forcing progress may disrupt an unfinished farm quest.</div>
		<<numberStepper "🌱 Farm Plots" $farm_stage_cheat {
			callback: value => {
				if (value > V.farm_stage_cheat) Wikifier.wikifyEval("<<farmincrcheat>>");
			},
			min: $farm_stage_cheat, max: 9, step: 1, activeButtons: ["single"], percentage: false
		}>>
		<<set $farm.clearing ||= 0>>
		<<numberStepper "🪓 Farm Clearing" $farm.clearing {callback: value => V.farm.clearing = value, min: 0, max: 100, step: 1, percentage: false}>>
	</div>

	<<if $farm_stage gte 8>>
		<<set $farm.wall ||= 0>>
		<<set $farm.tower ||= 0>>
		<<set $farm.woodland ||= 0>>
		<<set $farm.kennel ||= 0>>
		<<set $farm.barn ||= 0>>
		<<set $farm.stable ||= 0>>
		<<set $farm.coop ||= 0>>
		<<set $farm.tractor ||= 0>>
		<<set $farm.tractorplough = $farm.tractorplough is true>>
		<<set $farm.tractorseeddrill = $farm.tractorseeddrill is true>>
		<<set $farm.tractorharvester = $farm.tractorharvester is true>>
		<<set $farm.tractorloader = $farm.tractorloader is true>>
		<<set $farm.compostbin ||= 0>>
		<<set $farm.compostToProduce ||= 0>>
		<<set $farm.compostWaiting ||= 0>>
		<<set $farm.compostProducing ||= [-1, -1, -1, -1]>>
		<<set $farm.compostReady ||= 0>>
		<<set $farm.extract ||= 0>>
		<<set $farm.net ||= 0>>
		<<set $farm.cooler ||= 0>>
		<<set $farm.waterField ||= 0>>
		<<set $farm.irrigation ||= 0>>
		<<set $farm.parasitebarn ||= 0>>
		<<set $farm.greenhouse ||= 0>>
		<<set $alex_greenhouse ||= 0>>

		<div class="settingsGrid">
			<div class="settingsHeader options">Buildings & Land</div>
			<<numberStepper "🧱 Farm Wall" $farm.wall {callback: value => V.farm.wall = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "🗼 Farm Tower" $farm.tower {callback: value => {
				V.farm.tower = value;
				V.farm.tower_guard_can_hire = value > 0 && !V.farm.tower_guard;
				if (value <= 0) delete V.farm.tower_guard;
			}, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🌳 Farm Woodland" $farm.woodland {callback: value => V.farm.woodland = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🐕 Farm Kennel" $farm.kennel {callback: value => V.farm.kennel = value, min: 0, max: 1, step: 1, percentage: false}>>
			<<numberStepper "🏚️ Farm Barn" $farm.barn {callback: value => V.farm.barn = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🐎 Farm Stable" $farm.stable {callback: value => V.farm.stable = value, min: 0, max: 1, step: 1, percentage: false}>>
			<<numberStepper "🐔 Farm Coop" $farm.coop {callback: value => V.farm.coop = value, min: 0, max: 7, step: 1, percentage: false}>>
			<<numberStepper "🌿 Farm Greenhouse" $farm.greenhouse {callback: value => V.farm.greenhouse = value, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🏡 Orphanage Greenhouse" $alex_greenhouse {callback: value => V.alex_greenhouse = value, min: 0, max: 3, step: 1, percentage: false}>>
		</div>

		<div class="settingsGrid">
			<div class="settingsHeader options">Equipment & Upgrades</div>
			<<numberStepper "🚜 Farm Tractor" $farm.tractor {callback: value => V.farm.tractor = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "⚙️ Tractor Plough" `$farm.tractorplough ? 1 : 0` {callback: value => V.farm.tractorplough = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "On" : "Off"}>>
			<<numberStepper "🌾 Tractor Seed Drill" `$farm.tractorseeddrill ? 1 : 0` {callback: value => V.farm.tractorseeddrill = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "On" : "Off"}>>
			<<numberStepper "🌽 Tractor Harvester" `$farm.tractorharvester ? 1 : 0` {callback: value => V.farm.tractorharvester = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "On" : "Off"}>>
			<<numberStepper "📦 Tractor Loader" `$farm.tractorloader ? 1 : 0` {callback: value => V.farm.tractorloader = value === 1, min: 0, max: 1, step: 1, percentage: false, valueFormat: value => value ? "On" : "Off"}>>
			<<numberStepper "♻️ Compost Bin" $farm.compostbin {callback: value => V.farm.compostbin = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "🧪 Aphrodisiac Extraction" $farm.extract {callback: value => V.farm.extract = value, min: 0, max: 2, step: 1, percentage: false}>>
			<<numberStepper "🥅 Farm Net" $farm.net {callback: value => V.farm.net = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "❄️ Farm Cooler" $farm.cooler {callback: value => V.farm.cooler = value, min: 0, max: 3, step: 1, percentage: false}>>
			<<numberStepper "💧 Water Field" $farm.waterField {callback: value => V.farm.waterField = value, min: 0, max: 4, step: 1, percentage: false}>>
			<<numberStepper "🚿 Farm Irrigation" $farm.irrigation {callback: value => V.farm.irrigation = value, min: 0, max: 9, step: 1, percentage: false}>>
			<<numberStepper "🪱 Parasite Barn" $farm.parasitebarn {callback: value => V.farm.parasitebarn = value, min: 0, max: 2, step: 1, percentage: false}>>
		</div>
	<</if>>
<</widget>>

:: Feats Mod [widget]
/* X-Change: pick which Hopeless Cycle endings to buy.
Like any feat boost, these can be purchased outright with VrelCoins. */
<<widget "hopelessEndingsFeatUI">>
	<br>
	<div class="settingsHeader" style="margin-bottom: 0.5em">Endings To Read</div>
	<<for _hcEndKey range ["S","A","B","C","D","E","F"]>>
		<<set _hcEndData to setup.hopelessCycleEndingCosts[_hcEndKey]>>
		<<set _hcEndCost to _hcEndData.cost>>
		<<capture _hcEndKey, _hcEndData, _hcEndCost>>
			<<set _hcEndAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - _hcEndCost gte 0>>
			<div class="settingsToggleItem">
				<<if $featsBoosts.hopelessEndings[_hcEndKey]>>
					<<link "[✓] Ending _hcEndKey">>
						<<set $featsBoosts.hopelessEndings[_hcEndKey] to false>>
						<<updateFeatsPointsMenu "hopelessEndings" _hcEndCost "subtract">>
					<</link>>
					<span @class="_hcEndData.colour"><<print _hcEndData.name>></span>
					<span class="gold">(<<print _hcEndCost>> <<pluralise _hcEndCost "VrelCoin">>)</span>
				<<elseif _hcEndAfford>>
					<<link "[ ] Ending _hcEndKey">>
						<<set $featsBoosts.hopelessEndings[_hcEndKey] to true>>
						<<updateFeatsPointsMenu "hopelessEndings" _hcEndCost>>
					<</link>>
					<span @class="_hcEndData.colour"><<print _hcEndData.name>></span>
					<span class="gold">(<<print _hcEndCost>> <<pluralise _hcEndCost "VrelCoin">>)</span>
				<<else>>
					<span class="black">[ ] Ending _hcEndKey <span @class="_hcEndData.colour"><<print _hcEndData.name>></span></span>
					<span class="red">Not enough VrelCoins (<<print _hcEndCost>>)</span>
				<</if>>
			</div>
		<</capture>>
	<</for>>
<</widget>>

/* X-Change: links to read endings bought via the "Hopeless Cycle Endings" feat boost, skipping the full sequence.
Each sets up the gaoler context (freeze/morph), then jumps straight to that ending's narrative, which funnels into "Hopeless Cycle End" and awards the prize. */
<<widget "hopelessCycleQuickReadLinks">>
	<<set $hcBoughtEndings ||= []>>
	<<set _quickReadList to ["S","A","B","C","D","E","F"].filter(e => $hcBoughtEndings.includes(e))>>
	<<if _quickReadList.length>>
		<span class="gold">Some of these tales feel as though you've already lived them. You could recount one straight to its conclusion:</span>
		<br>
		<<for _qrEnd range _quickReadList>>
			<<capture _qrEnd>>
				<<set _qrData to setup.hopelessCycleEndingCosts[_qrEnd]>>
				<<link `"Read the ending of " + _qrData.name + " (" + _qrEnd + ")"`>>
					<<hopelessCycleStart>>
					<<goto `"Hopeless Cycle Ending " + _qrEnd`>>
				<</link>>
				<br>
			<</capture>>
		<</for>>
		<br>
	<</if>>
<</widget>>
