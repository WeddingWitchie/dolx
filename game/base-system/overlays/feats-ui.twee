:: FeatsUI [widget]
<<widget "feats">>
	<<updateFeats>>
	<br>
	As you play through Degrees of Lewdity, you will obtain <span class="gold">feats</span> by completing different tasks. The more feats you earn, the more <span class="gold">VrelCoins</span> you will earn. When you start a new game, your VrelCoins can be used to purchase <span class="gold">feat boosters</span>. These boosters grant you bonuses in your next game.
	<br><br>
	This tab displays all the feats that have been unlocked in your <span class="gold">most recently loaded save</span>, which will carry over to your next playthrough. VrelCoins are earned linearly, over the course of a single playthrough. <span class="red">Save-hopping may cause your VrelCoins and unlocked feats to disappear from this page.</span>
	<br><br>
	Multiple runs are necessary in order to achieve all feats. If you have multiple saves with different feats earned, you will be able to combine these feats when you start a new game by using the <span class="gold">Import all feats</span> button on the Feat Boosters page. Keep this in mind if you are aiming for 100% completion!
	<br><br>
	Some feats display as earned as soon as you meet the requirements, while others won't trigger until the next in-game hour. Happy hunting!
	<br><br>

	<<if $feats.locked>>
		<span class="red">You can't earn feats as you have enabled cheats at some point.</span>
	<<elseif $debug is 1>>
		<span class="red">Feats are disabled during debug mode.</span>
	<<elseif $replayScene isnot undefined>>
		<span class="red">Feats are disabled during replay mode.</span>
	<<elseif $feats.soft or $feats.pregnancyLocked or $feats.pregnancySillyLocked>>
		<span class="red">Some feats are locked in this current game.</span>
	<<else>>
		<span class="green">You can earn feats.</span>
	<</if>>
	<br><br>
	<<set _keysSetup to Object.keys(setup.feats)>>
	<<set _keysSave to Object.keys($feats.currentSave)>>
	<<set _keysAll to Object.keys($feats.allSaves).filter(f => !["points", "specialClothes", "seeds"].includes(f))>>
	You currently have <<if $feats.allSaves.points isnot undefined>><span class="gold"><<print $feats.allSaves.points>></span><<else>><span class="red">0</span><</if>> <<pluralise $feats.allSaves.points "VrelCoin">>.
	You have obtained
	<<if _keysSave.length gte 1>><span class="gold"><<print _keysSave.length>></span> <<pluralise _keysSave.length "feat">> in this save and <</if>>
	<<if _keysAll.length gte 1>><span class="gold"><<print _keysAll.length>></span><<else>><span class="red">0</span><</if>> <<pluralise _keysAll.length "feat">> in total, out of a possible <span class="gold"><<print _keysSetup.length>></span>.
	<br><br>
	<<set $feats.filter to "General">>
	Filter by:
	<select id="featTypes" name="featTypes" onchange="V.feats.filter = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="General" selected>General</option>
		<option value="Stats">Stats</option>
		<option value="Social">Social</option>
		<option value="Transformation">Transformation</option>
		<option value="Discoveries-Town">Discoveries - In Town</option>
		<option value="Discoveries-Other">Discoveries - Outside Town</option>
		<option value="Special">Special</option>
		<option value="Pregnancy">Pregnancy</option>
		<option value="AMC Traits">AMC Traits</option>
		<option value="Combat Extended">Combat Extended</option>
		<option value="All">Show All</option>
		<option value="General" hidden="hidden" selected="selected">General</option>
	</select>
	<br>
	<<set $feats.sort to "None">>
	Sort by:
	<select id="featSort" name="featSort" onchange="V.feats.sort = this.value; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')">
		<option value="None" selected>None</option>
		<option value="Date">Date</option>
		<option value="None" hidden="hidden" selected="selected">None</option>
	</select>
	<br>
	<<set $feats.shownew to true>>
	<input type="checkbox" checked name="showNew" onchange="V.feats.shownew = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> Show New |
	<<set $feats.showold to true>>
	<input type="checkbox" checked name="showOld" onchange="V.feats.showold = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> Show Old |
	<<set $feats.showmissing to true>>
	<input type="checkbox" checked name="showMissing" onchange="V.feats.showmissing = this.checked; Wikifier.wikifyEval('<<replace #featsList>><<featsList>><</replace>>')" /> Show Missing
	<br><br>
	<div id="featsList">
		<<featsList>>
	</div>
<</widget>>

<<widget "featsList">>
	<<set _skip to []>>
	<<set _sorting to []>>
	<<for _i to 0; _i lt _keysSetup.length; _i++>>
		<<set _setup to setup.feats[_keysSetup[_i]]>>
		<<if !_setup.filter.includes($feats.filter)>>
			<<continue>>
		<</if>>
		<<if _keysSave.includes(_keysSetup[_i])>>
			<<if !$feats.shownew>><<continue>><</if>>
			<<set _owned to 2>>
			<<set _date to new Date($feats.currentSave[_keysSetup[_i]])>>
		<<elseif _keysAll.includes(_keysSetup[_i])>>
			<<if !$feats.showold>><<continue>><</if>>
			<<set _owned to 1>>
			<<set _date to new Date($feats.allSaves[_keysSetup[_i]])>>
		<<else>>
			<<if !$feats.showmissing>><<continue>><</if>>
			<<if _setup.hidden or _skip.includes(_setup.series)>>
				<<continue>>
			<</if>>
			<<if _setup.series isnot "">>
				<<set _skip.push(_setup.series)>>
			<</if>>
			<<set _owned to 0>>
			<<set _date to 0>>
		<</if>>
		<<set _sorting.push( { key: _keysSetup[_i], owned: _owned, date: _date } )>>
	<</for>>
	<<if $feats.sort is "Date">>
		<<set _sorting to _sorting.sort(function(a, b) { return b.date - a.date; })>>
	<</if>>
	<<for _i to 0; _i lt _sorting.length; _i++>>
		<<set _feat to _sorting[_i]>>
		<<set _setup to setup.feats[_feat.key]>>
		<div class="feat">
			<div class="featImage">
				<<if _feat.owned gt 0>>
					<<set _featType to ["copper", "silver", "gold", "platinum", "jeweled"][_setup.difficulty - 1]>>
					<img @src="'img/ui/coin-'+_featType+(_feat.owned is 1 ? '-dull':'')+'.png'" class="featCoin" @style="(_feat.owned is 1 ? 'filter:brightness(65%) contrast(85%);':'')">
				<<else>>
					<img class="dot">
				<</if>>
			</div>
			<div class="featText">
				<<if ($feats.pregnancyLocked and _setup.pregnancyLockable) or ($feats.pregnancySillyLocked and _setup.pregnancySillyLockable) or ($feats.soft and _setup.softLockable) or $feats.locked or ($gamemode is "soft" or $settings.allureModifier lt 1)>>
					<<set _titleColor to " lblue">>
				<<else>>
					<<set _titleColor to "">>
				<</if>>
				<<if _feat.owned gt 0 or _setup.hint is undefined>>
					<span @class="'title' + _titleColor"><<print (Scripting.evalTwineScript(_setup.altCond ?? "false") && _feat.owned is 2) ? _setup.alt : _setup.title>></span>
					<span class="text"><<print _setup.desc>></span>
				<<else>>
					<span @class="'title' + _titleColor">?????</span>
					<span class="text"><<print _setup.hint>></span>
				<</if>>
				<br>
				<<if _feat.owned is 2>>
					<span class="text">Earned on: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<<elseif _feat.owned is 1>>
					<span class="text">Originally Earned on: <<print _feat.date.toLocaleString(returnTimeFormat())>></span>
				<</if>>
			</div>
		</div>
	<</for>>
<</widget>>

/*Feat Points Menu*/
<<widget "featsPointsMenu">>
	<div id="featsStats" class="settingsToggleIndent">
		<<if $feats.allSaves.points is undefined or $feats.allSaves.points is 0>>
			You have earned a lifetime total of <span class="red">0 VrelCoins</span> and cannot purchase Feat Boosters.
			<br>
			<span class="black small-description">If this is incorrect, please load your last save and restart.</span>
		<<else>>
			You have earned a lifetime total of <span class="green"><<print $feats.allSaves.points>> <<pluralise $feats.allSaves.points "VrelCoin">>.</span>
		<</if>>
	</div>
	/*Have to do this due to the `????` names*/
	<<set _listbox to '<<listbox "_upgradeNameID" autoselect>>'>>
	<<for $_i to 0; $_i lt _upgradeNames.length; $_i++>>
		<<if !$featsBoosts.hidden[_upgradeNames[$_i]]>>
			<<set _listbox += '<<option _visibleUpgradeNames[' + $_i + '] _visibleUpgradeIDs[' + $_i + ']>>'>>
		<</if>>
	<</for>>
	<<set _upgradeName to _upgradeNames[_upgradeNameID or 0]>>
	<<set _listbox += '<</listbox>>'>>
	<span class="gold settingsToggleIndent">Jump to a specific feat boost:</span>
	<<print _listbox>>
	<<run $(() => {
		$('#featsPointsMenu > select.macro-listbox').off('change.featBoostJump').on('change.featBoostJump', () => {
			new Wikifier(null, '<<set _upgradeName to _upgradeNames[_upgradeNameID]>><<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>');
		});
	})>>

	<div class="settingsGridFeats">
		<div class="settingsHeader">
			<span id="featName"><<featName>></span>
			<br>
			<span style="font-size:80%;">
				<<link "Previous">>
					<<set _upgradeNameID-->>
					<<if _upgradeNameID lt 0>>
						<<set _upgradeNameID to _upgradeNames.length - 1>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID-->>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>> |
				<<link "Next">>
					<<set _upgradeNameID++>>
					<<if _upgradeNameID gte _upgradeNames.length>>
						<<set _upgradeNameID to 0>>
					<</if>>
					<<if $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]>>
						<<for _upgradeNameID; $featsBoosts.hidden[_upgradeNames[_upgradeNameID]]; _upgradeNameID++>>
							<<if (_upgradeNameID + 1) gte _upgradeNames.length>>
								<<set _upgradeNameID to 0>>
								<<break>>
							<</if>>
						<</for>>
					<</if>>
					<<set _upgradeName to _upgradeNames[_upgradeNameID]>>
					<<updateFeatsPointsMenu>>
					<<updateFeatName>>
				<</link>>
			</span>
		</div>
		/*<<set _upgradeName to _upgradeNames[_upgradeNameID]>>*/
		<div @id="'feats-' + _upgradeName" class="settingsToggleItem">
			<<if _upgradeName is "sexRapeTraits">>
				<<sexRapeTraitsFeatUI>>
			<<elseif _upgradeName is "sexSkills">>
				<<sexSkillsFeatUI>>
			<<elseif _upgradeName is "basicSkills">>
				<<basicSkillsFeatUI>>
			<<elseif _upgradeName is "advancedTraits">>
				<<advancedTraitsFeatUI>>
			<<elseif _upgradeName is "transformations">>
				<<transformationsFeatUI>>
			<<elseif _upgradeName is "sadoMaso">>
				<<sadoMasoFeatUI>>
			<<elseif _upgradeName is "coreCharacteristics">>
				<<coreCharacteristicsFeatUI>>
			<<else>>
				<<featsMenu _upgradeName>>
			<</if>>
			<<if $featsBoosts.pointsUsed isnot 0>>
				<hr>
				Purchased Feat Boosts:
				<ul>
					<<for $_i to 0; $_i lt _allUpgradeNames.length; $_i++>>
						<<if $featsBoosts.upgrades[_allUpgradeNames[$_i]] gt 0>>
							<li>
							<<switch _allUpgradeNames[$_i]>>
								<<case "randomClothing">>
									<<= ($featsBoosts.clothingGender is "Either" ? "Male and Female" : $featsBoosts.clothingGender)>> <<print $featsBoosts.name[_allUpgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "coin">>
								<<case "specialClothing">>
									Special Clothing: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "coin">>
									<br>
										<<foldout false "_unlockedSets">>
											<span class="gold">Unlocked Sets</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.specialClothesSets)
												.filter(k => $featsBoosts.specialClothesSets[k])
												.map(k => `${k.replace(/_/g," ").toUpperFirst()}: <span class="gold">${setup.specialClothesSets[k].featCost * ($featsBoosts.upgradeDetails.specialClothing.purchased >= 3 ? 2 : 1)}</span> coins`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<case "xchangePremiumPills">>
									X-Change Premium Pills: <span class="gold"><<print $featsBoosts.upgradeDetails[_allUpgradeNames[$_i]].purchased>></span> <<pluralise $featsBoosts.upgradeDetails[_allUpgradeNames[$_i]].purchased "pack">>
								<<case "seeds">>
									Starting Seeds: <span class="gold"><<print $featsBoosts.upgrades[_upgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_upgradeNames[$_i]] "coin">>
									<br>
										<<foldout false "_unlockedSeed">>
											<span class="gold">Unlocked Seeds</span>
											<span class="descriptunlocked-hint">
												<<= Object.keys($featsBoosts.seeds)
												.filter(k => $featsBoosts.seeds[k])
												.map(k => `${k.replace(/_/g," ").toUpperFirst()}: <span class="gold">${setup.foodstuff[k].tending.featCost}</span> coins`)
												.join("<br>")>>
											</span>
										<</foldout>>
								<<default>>
									<<= $featsBoosts.name[_allUpgradeNames[$_i]]>>: <span class="gold"><<print $featsBoosts.upgrades[_allUpgradeNames[$_i]]>></span> <<pluralise $featsBoosts.upgrades[_allUpgradeNames[$_i]] "coin">>
							<</switch>>
							</li>
						<</if>>
					<</for>>
				</ul>
				<<set _pointsRemaining to $feats.allSaves.points - $featsBoosts.pointsUsed>>
				You have<span class="green"> <<print _pointsRemaining>> <<pluralise _pointsRemaining "VrelCoin">></span> left to spend on Feat Boosts.
			<</if>>
		</div>
	</div>
<</widget>>

<<widget "updateFeatName">>
	<<replace #featName>>
		<<featName>>
	<</replace>>
<</widget>>

<<widget "featName">>
	<<if _upgradeName is "sexRapeTraits">>
		<span class="gold">Sex-Rape Traits</span>
	<<elseif _upgradeName is "sexSkills">>
		<span class="gold">Sex Skill Grades</span>
	<<elseif _upgradeName is "basicSkills">>
		<span class="gold">Basic Skill Grades</span>
	<<elseif _upgradeName is "advancedTraits">>
		<span class="gold">Special Advanced Traits</span>
	<<elseif _upgradeName is "transformations">>
		<span class="gold">Transformation</span>
	<<elseif _upgradeName is "sadoMaso">>
		<span class="gold">Sado-Maso</span>
	<<elseif _upgradeName is "coreCharacteristics">>
		<span class="gold">Core Characteristic Grades</span>
	<<else>>
		<<set _details to $featsBoosts.upgradeDetails[_upgradeName]>>
		<<if _details.max gte 1>>
		<<switch _upgradeName>>
			<<case "money">>
				<span class="gold">Starting Money</span>
			<<case "grades">>
				<span class="gold">School Performance Grades</span>
			<<case "purity" "impurity">>
				<span class="gold" style="text-transform: capitalize;">Daily _upgradeName Boost</span>
			<<case "newLife">>
				<span class="gold">A New Life</span>
			<<case "aNewBestFriend">>
				<span class="gold">A New Best Friend</span>
			<<case "randomClothing">>
				<span class="gold">Random Clothing</span>
			<<case "tattoos">>
				<span class="gold">Starting Tattoos</span>
			<<case "specialClothing">>
				<span class="gold">Special Clothing</span>
			<<case "hopelessEndings">>
				<span class="gold">Hopeless Cycle Endings</span>
			<<case "xchangeGrayAgentTrait">>
				<span class="gold">X-Change Gray Agent</span>
			<<case "xchangePremiumPills">>
				<span class="gold">X-Change Premium Pills</span>
			<<case "seeds">>
				<span class="gold">Starting Seeds</span>
			<<case "sexToys">>
				<span class="gold">Sex Toys</span>
			<<case "orgasmTrait" "chokeTrait" "ejacTrait" "molestTrait" "rapeTrait" "bestialityTrait" "tentacleTrait" "critterMagnetTrait" "milkDrankTrait">>
				<span class="gold"><<print $featsBoosts.name[_upgradeName]>></span>
			<<case "divineTFs">>
				<span class="gold">Divine Transformation</span>
			<<case "animalTFs">>
				<span class="gold">Animal Transformation</span>
			<<case "sadism" "masochism">>
			<span class="gold" style="text-transform: capitalize;">Daily _upgradeName Boost</span>
			<<case "adaptiveGenes">>
				<span class="gold">Adaptive Genes</span>
			<<default>>
				<span class="gold" style="text-transform: capitalize;">Starting _upgradeName Grade</span>
		<</switch>>
		<<else>>
			<span class="red">?????</span>
		<</if>>
	<</if>>
<</widget>>

<<widget "sexSkillsFeatUI">>
	Purchase starting grades for any of your sex skills. Each skill keeps its own unlock level, maximum grade, and VrelCoin cost.
	<div class="groupedFeatGrid">
		<<for _sexSkillName range _sexSkillUpgradeNames>>
			<div class="groupedFeatCard" @data-sex-skill="_sexSkillName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_sexSkillName].max>>
						<span class="gold"><<print _sexSkillName is "seduction" ? "Seduction" : $featsBoosts.name[_sexSkillName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _sexSkillName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "basicSkillsFeatUI">>
	Purchase starting grades for any of your basic skills. Each skill keeps its own unlock level, maximum grade, and VrelCoin cost.
	<div class="groupedFeatGrid">
		<<for _basicSkillName range _basicSkillUpgradeNames>>
			<div class="groupedFeatCard" @data-basic-skill="_basicSkillName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_basicSkillName].max>>
						<span class="gold"><<print $featsBoosts.name[_basicSkillName].replace(" Grade", "")>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _basicSkillName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "advancedTraitsFeatUI">>
	Purchase any combination of special advanced traits and boosts. Each keeps its own unlock level, maximum rank, and VrelCoin cost.
	<div class="groupedFeatGrid">
		<<for _advancedTraitName range _advancedTraitUpgradeNames>>
			<div class="groupedFeatCard" @data-advanced-trait="_advancedTraitName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_advancedTraitName].max>>
						<span class="gold"><<print $featsBoosts.name[_advancedTraitName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _advancedTraitName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "transformationsFeatUI">>
	Purchase a divine transformation, an animal transformation, or both. Each category keeps its own unlocks and VrelCoin cost.
	<div class="groupedFeatGrid">
		<<for _transformationName range ["divineTFs", "animalTFs"]>>
			<div class="groupedFeatCard" @data-transformation="_transformationName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_transformationName].max>>
						<span class="gold"><<print $featsBoosts.name[_transformationName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _transformationName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "sadoMasoFeatUI">>
	Purchase daily sadism or masochism gains, and optionally start with either or both related traits.
	<div class="groupedFeatGrid">
		<<for _sadoMasoBoostName range ["sadism", "masochism"]>>
			<div class="groupedFeatCard" @data-sado-maso-boost="_sadoMasoBoostName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_sadoMasoBoostName].max>>
						<span class="gold"><<print $featsBoosts.name[_sadoMasoBoostName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _sadoMasoBoostName>>
				</div>
			</div>
		<</for>>
		<<for _sadoMasoTraitName range ["sadistTrait", "masochistTrait"]>>
			<<set _sadoMasoTraitDetails to $featsBoosts.upgradeDetails[_sadoMasoTraitName]>>
			<<set _sadoMasoTraitPurchased to _sadoMasoTraitDetails.purchased gt 0>>
			<<set _canPurchaseSadoMasoTrait to _sadoMasoTraitPurchased or ($feats.allSaves.points - $featsBoosts.pointsUsed gte _sadoMasoTraitDetails.cost)>>
			<div class="groupedFeatCard" @data-sado-maso-trait="_sadoMasoTraitName">
				<div class="groupedFeatTitle">
					<<if _sadoMasoTraitDetails.max>>
						<span class="gold"><<print $featsBoosts.name[_sadoMasoTraitName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<if _sadoMasoTraitDetails.max>>
						<<if _sadoMasoTraitName is "sadistTrait">>
							Your defiant acts inflict more pain. Inflicting pain increases arousal.
						<<else>>
							Provides resistance to most sources of pain. Those sources increase arousal instead.
						<</if>>
						<br>
						<label>
							<<if _sadoMasoTraitPurchased>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" checked onchange="const trait = this.dataset.sadoMasoTraitChoice; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 0; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + ' &quot;subtract&quot;>' + '>');">
							<<elseif _canPurchaseSadoMasoTrait>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" onchange="const trait = this.dataset.sadoMasoTraitChoice; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 1; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + '>' + '>');">
							<<else>>
								<input type="checkbox" @data-sado-maso-trait-choice="_sadoMasoTraitName" disabled>
							<</if>>
							Start with this trait
						</label>
						<div class="black small-description" style="margin-top:10px;">(<span class="gold"><<print _sadoMasoTraitDetails.cost>> <<pluralise _sadoMasoTraitDetails.cost "VrelCoin">></span> to purchase)</div>
					<<else>>
						<span class="red"><<print $featsBoosts.missing[_sadoMasoTraitName]>></span>
					<</if>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "coreCharacteristicsFeatUI">>
	Purchase starting grades or daily changes for your core characteristics. Each keeps its own unlock level, maximum rank, and VrelCoin cost.
	<div class="groupedFeatGrid">
		<<for _characteristicName range _coreCharacteristicUpgradeNames>>
			<div class="groupedFeatCard" @data-core-characteristic="_characteristicName">
				<div class="groupedFeatTitle">
					<<if $featsBoosts.upgradeDetails[_characteristicName].max>>
						<span class="gold"><<print $featsBoosts.name[_characteristicName]>></span>
					<<else>>
						<span class="red">?????</span>
					<</if>>
				</div>
				<div class="groupedFeatBody">
					<<featsMenu _characteristicName>>
				</div>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "sexRapeTraitsFeatUI">>
	Choose any combination of sexual and rape-related starting traits. Each selected trait costs its normal amount of VrelCoins.
	<div style="margin-top:10px;">
		<<for _traitName range _traitUpgradeNames>>
			<<set _traitDetails to $featsBoosts.upgradeDetails[_traitName]>>
			<<set _traitPurchased to $featsBoosts.upgrades[_traitName] gt 0>>
			<<set _canPurchaseTrait to _traitPurchased or ($feats.allSaves.points - $featsBoosts.pointsUsed gte _traitDetails.cost)>>
			<<set _traitDescription to {
				orgasmTrait: "So many orgasms have had a physiological effect. Cumming is harder, but orgasms relieve more stress. Repeated orgasms give less relief and can eventually add stress, though much less than normal.",
				chokeTrait: "You've come to love the feeling of lack of oxygen. Getting choked makes sex more pleasurable.",
				ejacTrait: "You've become accustomed to the scent of ejaculate and can take advantage of its calming effect. Your stress is reduced hourly depending on how much slime and semen covers you.",
				molestTrait: "You've learned to better cope with psychological trauma. Being molested no longer removes your sense of control (rape still does).",
				rapeTrait: "You've been raped so much that you've learned how to cope. Trauma increases more slowly.",
				bestialityTrait: "Animals have tried to " + ($settings.pregnancySpeechEnabled ? "breed" : "mate") + " with you so often that you're used to it. Trauma increases more slowly when attacked by animals.",
				tentacleTrait: "Many tentacles have had their way with your body. Trauma increases more slowly when attacked by tentacles.",
				critterMagnetTrait: "You cannot resist swarms and small creatures. You strip and submit to them, and critter sex relieves stress and trauma.",
				milkDrankTrait: "You take full advantage of the nutrition in fresh breast milk. Drinking it invigorates your body, improving physique.",
			}[_traitName]>>
			<div class="settingsToggleItem">
				<label>
					<<if _traitPurchased>>
						<input type="checkbox" @data-trait="_traitName" checked onchange="const trait = this.dataset.trait; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 0; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + ' &quot;subtract&quot;>' + '>');">
					<<elseif _traitDetails.max and _canPurchaseTrait>>
						<input type="checkbox" @data-trait="_traitName" onchange="const trait = this.dataset.trait; const details = V.featsBoosts.upgradeDetails[trait]; details.purchased = 1; new Wikifier(null, '<' + '<updateFeatsPointsMenu &quot;' + trait + '&quot; ' + details.cost + '>' + '>');">
					<<else>>
						<input type="checkbox" @data-trait="_traitName" disabled>
					<</if>>
					<<if _traitDetails.max>>
						<span class="lewd"><<print $featsBoosts.name[_traitName]>><span>
						<mouse class="tooltip linkBlue" @data-trait-tooltip="_traitName">(?)<span><<print _traitDescription>></span></mouse>
						<span class="black small-description">(<span class="gold"><<print _traitDetails.cost>> <<pluralise _traitDetails.cost "VrelCoin">></span>)</span>
					<<else>>
						<span class="red">?????</span>
						<span class="black small-description"><<print $featsBoosts.missing[_traitName]>></span>
					<</if>>
				</label>
			</div>
		<</for>>
	</div>
<</widget>>

<<widget "featsMenu">>
	<<set _name to _args[0]>>
	<<capture _name>>
		<<set _details to $featsBoosts.upgradeDetails[_name]>>
		<<set _maxUpgrades to _details.max>>
		<<set _purchasedUpgrades to _details.purchased>>
		<<if _maxUpgrades>>
			<<if !$feats.allSaves.points>>
				<span class="red">Earn some VrelCoins in order to purchase this feat boost!</span>
			<<else>>
				<<switch _name>>
					<<case "money">>
						You will start the game with <span class="green"> £<<= 5 + _purchasedUpgrades * _maxUpgrades * 25>>.00</span>.
					<<case "grades">>
						You will start the game with
						<<switch _details.purchased>>
							<<case 4>><span class="green">A*</span>
							<<case 3>><span class="green">A</span>
							<<case 2>><span class="lblue">B</span>
							<<case 1>><span class="blue">C</span>
							<<default>><span class="purple">D</span>
						<</switch>>
						grades.
					<<case "purity">>
						<<if !_purchasedUpgrades>>
							You will always gain <span class="green">1</span> point of purity per day. Each purchased boost adds one more point of purity every day. It still adds up when other effects are making you lose purity, so you can end the day with a net gain. <i>Actions you take can negate or amplify your purity gains.</i>
						<<else>>
							You will gain <span class="green"><<print 1 + _purchasedUpgrades>></span> points of purity per day from this and the daily point combined. Other effects are added on top, and the total can still be a gain when they cost you purity. <i>Actions you take can negate or amplify your purity gains.</i>
						<</if>>
					<<case "impurity">>
						<<switch _purchasedUpgrades>>
							<<case 0>>
								You will always gain <span class="green">1</span> point of purity per day. Each purchased boost takes away one point of purity every day. Once it has used up the daily point, it keeps taking purity away. <i>Actions you take can negate or amplify your purity losses.</i>
							<<case 1>>
								Your daily purity change is <span class="red">0</span>: the boost uses up the daily point. <i>Actions you take can negate or amplify your purity losses.</i>
							<<default>>
								You will lose <span class="red"><<= _purchasedUpgrades - 1>></span> <<= _purchasedUpgrades is 2 ? "point" : "points">> of purity per day from this and the daily point combined. Other effects are added on top. <i>Actions you take can negate or amplify your purity losses.</i>
						<</switch>>
					<<case "newLife">>
						You will start the game
						<span @class="$featsBoosts.upgrades.newLife ? 'green' : 'red'">
							<<= $featsBoosts.upgrades.newLife ? "with" : "without">>
						</span>
						a parasite.
					<<case "aNewBestFriend">>
						You will start the game
						<<switch $featsBoosts.upgrades.aNewBestFriend>>
							<<case 0>><span class='red'>without</span> an ear slime.
							<<case 10>><span class='green'>with</span> an ear slime.
							<<case 20>><span class='green'>with two</span> ear slimes.
						<</switch>>
					<<case "randomClothing">>
						You will start the game with <span class="gold"><<= 3 * _purchasedUpgrades>></span> random clothing items.
					<<case "tattoos">>
						<<if _purchasedUpgrades is 0>>
							You will start the game with <span class="red">no</span> tattoos.
						<<elseif _purchasedUpgrades is 1>>
							You will start the game with <span class="green">1</span> tattoo.
						<<else>>
							You will start the game with <span class="green">_purchasedUpgrades</span> tattoos.
						<</if>>
					<<case "specialClothing">>
						<<if _purchasedUpgrades is 0>>
							You will start the game with special clothing from the Forest Shop <span class='red'>locked</span>.
						<<elseif _purchasedUpgrades is 1>>
							You can purchase <span class="teal">up to half</span> of special clothing sets from the Forest Shop to start the game with them <span class="green">unlocked</span>, if you've unlocked it in any other save.
						<<elseif _purchasedUpgrades is 2>>
							You can purchase <span class="teal">any amount</span> of special clothing sets from the Forest Shop to start the game with them <span class="green">unlocked</span>, if you've unlocked it in any other save.
						<<else>>
							You can purchase <span class="teal">any amount</span> of previously unlocked special clothing sets at <span class="gold">twice their normal VrelCoin price</span> and start with their <span class="green">normal story dialogue available</span>.
						<</if>>
					<<case "hopelessEndings">>
						Purchase any of the <span class="gold">Hopeless Cycle</span> endings to <span class="green">read them directly</span> from the painting next game, claiming their rewards without playing the whole sequence again. Buy all, some, or none. <i>The harder the ending, the more it costs.</i>
					<<case "xchangePremiumPills">>
						<<set _premiumPillTotal to _purchasedUpgrades * 5>>
						You will start the game with
						<<if _premiumPillTotal>>
							<span class="green"><<print _premiumPillTotal>></span> <<pluralise _premiumPillTotal "X-Change Premium pill">> in your medicine drawer.
						<<else>>
							<span class="red">no</span> X-Change Premium pills.
						<</if>>
					<<case "seeds">>
						<<if _purchasedUpgrades is 0>>
							You will start the game <span class='red'>without</span> any seeds.
						<<elseif _purchasedUpgrades is 1>>
							You can purchase <span class="teal">up to half</span> of seeds to start the game with them <span class="green">unlocked</span>, if you've unlocked them in any other save.
						<<else>>
							You can purchase <span class="teal">any amount</span> of seeds to start the game with them <span class="green">unlocked</span>, if you've unlocked them in any other save.
						<</if>>
					<<case "sexToys">>
						You will start the game with
						<<if _purchasedUpgrades>>
							<span class="green"><<print 3 * _purchasedUpgrades>></span> sex toys.
						<<else>>
							<span class="red">no</span> sex toys.
						<</if>>
					<<case "greenThumb">>
						You will start the game with the <span class="green">Green Thumb</span> trait.
					<<case "xchangePurityTrait">>
						You will start the game permanently <span class="blue">pure of X-Change pill effects</span>.
					<<case "xchangeGrayAgentTrait">>
						You will start the game with the <span class="teal">Gray Agent</span> in your blood.
					<<case "orgasmTrait" "chokeTrait" "ejacTrait" "molestTrait" "rapeTrait" "bestialityTrait" "tentacleTrait" "critterMagnetTrait" "milkDrankTrait">>
						You will start the game with the <span class="green"><<print $featsBoosts.name[_name]>></span> trait.
					<<case "divineTFs">>
						You will start the game with a divine transformation.
					<<case "animalTFs">>
						You will start the game with an animal transformation.
					<<case "sadism">>
						<<if ($featsBoosts.upgrades[_name] / _details.cost) is 0>>
						Purchased sadism boosts will increase your daily sadism gain. <i>Actions you take can amplify your sadism gains.</i>
						<<else>>
						You will gain <span class="green"><<print 1+$featsBoosts.upgrades[_name] / _details.cost>></span> points of sadism per day. <i>Actions you take can amplify your sadism gains.</i>
						<</if>>
					<<case "masochism">>
						<<if ($featsBoosts.upgrades[_name] / _details.cost) is 0>>
						Purchased masochism boosts will increase your daily masochism gain. <i>Actions you take can amplify your masochism gains.</i>
						<<else>>
						You will gain <span class="green"><<print 1+$featsBoosts.upgrades[_name] / _details.cost>></span> points of masochism per day. <i>Actions you take can amplify your masochism gains.</i>
						<</if>>
					<<case "physique">>
						<<switch $bodysize>>
							<<case -1>><<set _previewPhysiqueSize to 3000>>
							<<case 0>><<set _previewPhysiqueSize to 6000>>
							<<case 1>><<set _previewPhysiqueSize to 8000>>
							<<case 2>><<set _previewPhysiqueSize to 10000>>
							<<case 2.5>><<set _previewPhysiqueSize to 12000>>
							<<case 3>><<set _previewPhysiqueSize to 14000>>
							<<case 4>><<set _previewPhysiqueSize to 15000>>
						<</switch>>
						<<set _previewPhysique to (_previewPhysiqueSize / 7) * 3>>
						<<if $background.athlete is true>>
							<<set _previewPhysique += (_previewPhysiqueSize * 2 / 7)>>
						<</if>>
						<<if $background.delinquent is true>>
							<<set _previewPhysique += (_previewPhysiqueSize / 7)>>
						<</if>>
						<<set _previewPhysique += $featsBoosts.upgrades[_name] / _details.cost * 1500>>
						You will start the game with _name at 
						<<if _previewPhysique gte (_previewPhysiqueSize / 7) * 6>>
							<span class="green"><<print Math.trunc(_previewPhysique)>></span>.
						<<elseif _previewPhysique gte (_previewPhysiqueSize / 7) * 5>>
							<span class="teal"><<print Math.trunc(_previewPhysique)>></span>.
						<<elseif _previewPhysique gte (_previewPhysiqueSize / 7) * 4>>
							<span class="lblue"><<print Math.trunc(_previewPhysique)>></span>.
						<<elseif _previewPhysique gte (_previewPhysiqueSize / 7) * 3>>
							<span class="blue"><<print Math.trunc(_previewPhysique)>></span>.
						<<elseif _previewPhysique gte (_previewPhysiqueSize / 7) * 2>>
							<span class="purple"><<print Math.trunc(_previewPhysique)>></span>.
						<<elseif _previewPhysique gte (_previewPhysiqueSize / 7) * 1>>
							<span class="pink"><<print Math.trunc(_previewPhysique)>></span>.
						<<else>>
							<span class="red"><<print Math.trunc(_previewPhysique)>></span>.
						<</if>>
					<<case "willpower">>
						<<set _previewWillpower to 350 + $featsBoosts.upgrades[_name] / _details.cost * 200>>
						You will start the game with _name at 
						<<if _previewWillpower gte (1000 / 7) * 6>>
							<span class="green"><<print _previewWillpower>></span>.
						<<elseif _previewWillpower gte (1000 / 7) * 5>>
							<span class="teal"><<print _previewWillpower>></span>.
						<<elseif _previewWillpower gte (1000 / 7) * 4>>
							<span class="lblue"><<print _previewWillpower>></span>.
						<<elseif _previewWillpower gte (1000 / 7) * 3>>
							<span class="blue"><<print _previewWillpower>></span>.
						<<elseif _previewWillpower gte (1000 / 7) * 2>>
							<span class="purple"><<print _previewWillpower>></span>.
						<<elseif _previewWillpower gte (1000 / 7) * 1>>
							<span class="pink"><<print _previewWillpower>></span>.
						<<else>>
							<span class="red"><<print _previewWillpower>></span>.
						<</if>>
					<<case "oral" "chest" "hands" "buttocks" "penile" "anal" "vaginal" "feet" "thighs">>
						You will start the game with
						<<if $featsBoosts.upgrades[_name] / _details.cost is 1>>
							_name at level <span class="purple">D</span>.
						<<elseif $featsBoosts.upgrades[_name] / _details.cost is 2>>
							_name at level <span class="blue">C</span>.
						<<elseif $featsBoosts.upgrades[_name] / _details.cost is 3>>
							_name at level <span class="lblue">B</span>.
						<<elseif $featsBoosts.upgrades[_name] / _details.cost is 4>>
							_name at level <span class="teal">A</span>.
						<<elseif $featsBoosts.upgrades[_name] / _details.cost is 5>>
							_name at level <span class="green">S</span>.
						<<else>>
							<span class="red">no</span> proficiency in _name.
						<</if>>
					<<case "promiscuity" "exhibitionism" "deviancy">>
						You will start the game with an additional <span class="blue"><<print $featsBoosts.upgrades[_name] / _details.cost * 15>></span> _name.
					<<case "transcend">>
						You will gain <span class="gold"><<print $featsBoosts.upgrades[_name] / _details.cost * 50>>%</span> more when grinding skills.
					<<case "adaptiveGenes">>
						You will gain <span class="gold"><<print $featsBoosts.upgrades[_name] * 2>>%</span> more transformation points.
					<<default>>
						You will start the game with
						<<switch _purchasedUpgrades>>
							<<case 1>>
								_name at level <span class="pink">F+</span>.
							<<case 2>>
								_name at level <span class="purple">D</span>.
							<<case 3>>
								_name at level <span class="purple">D+</span>.
							<<case 4>>
								_name at level <span class="blue">C</span>.
							<<case 5>>
								_name at level <span class="blue">C+</span>.
							<<case 6>>
								_name at level <span class="lblue">B</span>.
							<<case 7>>
								_name at level <span class="lblue">B+</span>.
							<<case 8>>
								_name at level <span class="teal">A</span>.
							<<case 9>>
								_name at level <span class="teal">A*</span>.
							<<case 10>>
								_name at level <span class="green">S</span>.
							<<default>>
								<span class="red">no</span> proficiency in _name.
						<</switch>>
				<</switch>>
				<<if _name is "randomClothing">>
					<br>
					<span class="gold bold">Clothing Type: </span>
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Either" ' + ($featsBoosts.clothingGender is "Either" ? "checked" : "") + '>>'>> Either</label> |
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Male" ' + ($featsBoosts.clothingGender is "Male" ? "checked" : "") + '>>'>> Male</label> |
					<label><<print '<<radiobutton "$featsBoosts.clothingGender" "Female" ' + ($featsBoosts.clothingGender is "Female" ? "checked" : "") + '>>'>> Female</label>
					<br>
					<span class="gold bold">Enable Custom Colour (expect crazy results): </span>
						<label><<print '<<radiobutton "$featsBoosts.clothingCustomColors" false ' + ($featsBoosts.clothingCustomColors is false ? "checked" : "") + '>>'>> No</label> |
						<label><<print '<<radiobutton "$featsBoosts.clothingCustomColors" true ' + ($featsBoosts.clothingCustomColors is true ? "checked" : "") + '>>'>> Yes</label>
				<</if>>
				<<if _name is "hopelessEndings">>
					<div id="hopelessEndings"><<hopelessEndingsFeatUI>></div>
				<<elseif !_details.exclusive or $featsBoosts.upgrades[_details.exclusive] is 0>>
					<<featsPointsMenuButtons _name _details>>
				<<else>>
					<span class="red">Remove _details.exclusive upgrades to make use of this upgrade.</span>
				<</if>>

				<<if _name is "tattoos">>
					<<set _totalTattoos to $featsBoosts.upgrades.tattoos / _details.cost>>
					<<if _tattooNumber is undefined or _tattooNumber gt _totalTattoos>>
						<<set _tattooNumber to Math.clamp(_totalTattoos, 1, $featsBoosts.upgradeDetails.tattoos.max)>>
					<</if>>

					<<if _totalTattoos gt 0>>
						<div class="settingsGrid" style="margin:10px 0px">
							<div class="settingsHeader">Tattoo <<print _tattooNumber>>
							<br>
								<<if _tattooNumber gte 1 and _totalTattoos gt 1>>
								<span style="font-size:80%;">
									<<link "Previous Tattoo">>
										<<set _tattooNumber-->>
										<<if _tattooNumber lte 0>>
											<<set _tattooNumber to _totalTattoos>>
										<</if>>
										<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
									<</link>> |
									<<link "Next Tattoo">>
										<<set _tattooNumber++>>
										<<if _tattooNumber gt _totalTattoos>>
											<<set _tattooNumber to 1>>
										<</if>>
										<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
									<</link>>
								</span>
								<</if>>
							</div>
							<div class="settingsToggleItem">
								<span class="listMargin">
									<span class="gold">Tattoo Type:</span>
									<<set _penOptions to ["Tattoo","Brand"]>>
									<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].pen"` autoselect>>
										<<optionsfrom _penOptions>>
									<</listbox>>
								</span>
							</div>
							<div class="settingsToggleItem">
								<span class="gold">Tattoo Location:</span>
								<<set _bodyPartOptions to ["Forehead","Left cheek","Right cheek","Left shoulder","Right shoulder","Back","Breasts","Left bottom","Right bottom","Left thigh","Right thigh","Pubic"]>>
								<<for _l to 1; _l lte _totalTattoos; _l++>>
									<<if _tattooNumber is _l>>
										<<continue>>
									<</if>>
									<<run _bodyPartOptions.delete($featsBoosts.tattoos[_l].bodypart)>>
								<</for>>
								<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].bodypart"` autoselect>>
									<<option "Random">>
									<<optionsfrom _bodyPartOptions>>
								<</listbox>>
							</div>
							<div @id="_tattooNumber + 'tattooFilter'" class="settingsToggleItem">
								<<tattooFilter>>
							</div>
							<div @id="_tattooNumber + 'tattooList'" class="settingsToggleItem">
								<<tattooList>>
							</div>
						</div>
						<<run $(() => {
						const currentList = '#' + _tattooNumber + 'tattooList';
						const currentFilterId = '#' + _tattooNumber + 'tattooFilter';
							$(currentFilterId + ' select').on('input change', e => {
							new Wikifier(null, `<<print "${currentList}">> <<replace "${currentList}">><<tattooList>><</replace>>`);
							}).trigger('change');
						})>>
					<</if>>
				<</if>>
				<<if _name is "sexToys">>
					<div id="sexToys"><<sexToysFeatUI>></div>
				<</if>>
				<<if _name is "aNewBestFriend" and $featsBoosts.upgradeDetails.aNewBestFriend.purchased gte 2>>
					<div id="aNewBestFriend">
						<label>Earslime starting type:
							<<listbox "$featsBoosts.earSlimeType" autoselect>>
								<<option "Immature and passive" "immaturePassive">>
								<<option "Immature and aggressive" "immatureAggressive">>
								<<option "Partly grown and aggressive" "grownAggressive">>
							<</listbox>>
						</label>
					</div>
				<</if>>
				<<set _keys to Object.keys($feats.allSaves)>>
				<<if _name is "divineTFs" and $featsBoosts.upgrades.divineTFs gt 0>>
					<<set _options = {}>>
					<<if _keys.count("Angel")>>
						<<set _options["Angel"] = "angel">>
					<</if>>
					<<if _keys.count("Fallen Angel")>>
						<<set _options["Fallen Angel"] = "fallenAngel">>
					<</if>>
					<<if _keys.count("Demon")>>
						<<set _options["Demon"] = "demon">>
					<</if>>
					<<if _keys.count("Demon of Purity")>>
						<<set _options["Virgin Demon"] = "virginDemon">>
					<</if>>
					<label>Divine Transformation:
						<<listbox "$featsBoosts.divineTFs" autoselect>>
							<<optionsfrom _options>>
						<</listbox>>
					</label>
				<</if>>
				<<if _name is "animalTFs" and $featsBoosts.upgrades.animalTFs gt 0>>
					<<set _options = {}>>
					<<if _keys.count("Neko") gt 0>>
						<<set _options["Cat"] = "cat">>
					<</if>>
					<<if _keys.count("Wolf") gt 0>>
						<<set _options["Wolf"] = "wolf">>
					<</if>>
					<<if _keys.count("Cattle") gt 0>>
						<<set _options["Cow"] = "cow">>
					<</if>>
					<<if _keys.count("Lost Legacy") gt 0>>
							<<set _options["Water Dragon"] = "waterdragon">>
						<</if>>
						<<if _keys.count("Bear") gt 0>>
						<<set _options["Bear"] = "bear">>
					<</if>>
					<<if _keys.count("Harpy") gt 0>>
						<<set _options["Harpy"] = "harpy">>
					<</if>>
					<<if _keys.count("Fox") gt 0>>
						<<set _options["Fox"] = "fox">>
					<</if>>
					<<if _keys.count("Bunny") gt 0>>
						<<set _options["Bunny"] = "bunny">>
					<</if>>
					<label>Animal Transformation:
						<<listbox "$featsBoosts.animalTFs" autoselect>>
							<<optionsfrom _options>>
						<</listbox>>
					</label>
				<</if>>
				<<if _name is "specialClothing">>
					<div id="specialClothing"><<specialClothingFeatUI>></div>
				<</if>>
				<<if _name is "seeds">>
					<div id="seeds"><<seedsFeatUI>></div>
				<</if>>
			<</if>>
		<<else>>
			<span class="red"><<print $featsBoosts.missing[_name]>></span>
		<</if>>
	<</capture>>
<</widget>>

<<widget "tattooFilter">>
	<span class="gold">Filter designs by:</span>
	<<set _tattooFilters = {
		"All" : "all",
		"Image" : "object",
		"Text" : "text",
		"Masculine" : "m",
		"Feminine" : "f",
		"Bestiality" : "bestiality",
		"Cattle" : "cattle",
		"Combat" : "combat",
		"Criminal" : "criminal",
		"Exhibitionism" : "exhibitionism",
		"Prostitution" : "prostitution",
		"Rape" : "rape",
		"Sex" : "sex",
		"Violence" : "violence",
		"Pregnancy" : "pregnancy",
		"Impreg" : "impreg",
		}>>
	<<listbox `"$tattooFilter"+_tattooNumber` autoselect>>
		<<optionsfrom _tattooFilters>>
	<</listbox>>
<</widget>>

<<widget "tattooList">>
	<span class="gold">Tattoo Design:</span>
	<<featsTattooOptions>>
	<<listbox `"$featsBoosts.tattoos["+_tattooNumber+"].tattoo"` autoselect>>
		<<option "Random">>
		<<optionsfrom _featsTattooOptions>>
	<</listbox>>
<</widget>>

<<widget "featsTattooOptions">>
	<<if _featsTattooAll is undefined>>
		<<set _featsTattooAll to []>>
		<<for _value range setup.bodywriting>>
			<<if _value.featSkip is true>>
				<<continue>>
			<</if>>
			<<run _featsTattooAll.push(_value.writing)>>
		<</for>>
	<</if>>
	<<set _featsTattooOptions to {}>>
	<<switch _tattooNumber>>
		<<case 1>><<set _tattooFilter to $tattooFilter1>>
		<<case 2>><<set _tattooFilter to $tattooFilter2>>
		<<case 3>><<set _tattooFilter to $tattooFilter3>>
		<<case 4>><<set _tattooFilter to $tattooFilter4>>
		<<case 5>><<set _tattooFilter to $tattooFilter5>>
	<</switch>>
	<<for _value range setup.bodywriting>>
		<<if (_tattooFilter is "all" and _value.featSkip)
		or (_tattooFilter is "object" and (_value.featSkip or _value.type isnot _tattooFilter))
		or (_tattooFilter is "text" and (_value.featSkip or _value.type isnot _tattooFilter))
		or (_tattooFilter is "m" and (_value.featSkip or _value.gender isnot _tattooFilter))
		or (_tattooFilter is "f" and (_value.featSkip or _value.gender isnot _tattooFilter))
		or (_tattooFilter isnot "all" and _tattooFilter isnot "object" and _tattooFilter isnot "text" and _tattooFilter isnot "m" and _tattooFilter isnot "f" and (_value.featSkip or _value.special isnot _tattooFilter))>>
			<<continue>>
		<</if>>
		<<set _label to _value.writing.replace(/<[^>]*>/g, "")>>
		<<run _featsTattooOptions[_label] = _value.writing>>
	<</for>>
<</widget>>

<<widget "featsPointsMenuButtons">>
	<<set _type to _args[0]>>
	<<set _details to _args[1]>>
	<<set _cost to _details.cost>>
	<<set _maxUpgrades to _details.max>>
	<<set _purchasedUpgrades to _details.purchased>>
	<<set _remainingUpgrades to _maxUpgrades - _purchasedUpgrades>>
	<<set _availableCoins to $feats.allSaves.points - $featsBoosts.pointsUsed>>
	<<set _specialClothingBaseCost to _type is "specialClothing" ? Object.entries($featsBoosts.specialClothesSets).reduce((total, entry) => total + (entry[1] ? setup.specialClothesSets[entry[0]].featCost : 0), 0) : 0>>
	<<set _nextUpgradeCost to _type is "specialClothing" and _purchasedUpgrades is 2 ? _specialClothingBaseCost : _cost>>
	<<set _maxUpgradeCost to _type is "specialClothing" and _maxUpgrades gte 3 and _purchasedUpgrades lt 3 ? _specialClothingBaseCost : _remainingUpgrades * _cost>>
	<br><br>
	<span class="gold bold">Upgrades:</span>
	<br>
	<div style="margin-bottom:10px;">
	<<switch _name>>
		<<case "money">>
			Each purchased upgrade will add <span class="green">£<<print _maxUpgrades * 25>></span> to your starting money.
		<<case "grades">>
			Each purchased upgrade will raise your starting school grades by <span class="green">one letter grade.</span>
		<<case "purity">>
			Each purchased upgrade will increase your daily purity by one point per level.
		<<case "impurity">>
			Each purchased upgrade will decrease your daily purity by one point per level.
		<<case "newLife">>
			<<if _maxUpgrades is 2>>
				Purchase the first upgrade to start the game with a hermaphrodite tentacle parasite. Purchase the second upgrade to give it perfect activity; otherwise it will have random activity.
			<<else>>
				Purchase the first upgrade to start the game with a hermaphrodite tentacle parasite with random activity. Acquire a second broodmother feat to give it perfect activity.
			<</if>>
		<<case "aNewBestFriend">>
			Purchase this upgrade to start the game with an ear slime parasite.
		<<case "randomClothing">>
			Each purchased upgrade gives you three random clothing items of the specified gender.
		<<case "tattoos">>
			Each purchased upgrade will allow you to get one starting tattoo or brand of your choice.
		<<case "specialClothing">>
			<<if _maxUpgrades gte 3>>
				The first rank allows up to half of previously unlocked special clothing sets. The second allows any amount. The third charges twice each set's normal price and makes selected sets count as normally unlocked, enabling their route dialogue.
			<<elseif _maxUpgrades is 2>>
				Select the first upgrade to purchase up to half of previously unlocked special clothes. Purchase the second rank to purchase any number of previously unlocked special clothes.
			<<else>>
				Select the first upgrade to purchase up to half of previously unlocked special clothes. Acquire a secret feat to purchase any number of previously unlocked special clothes.
			<</if>>
		<<case "seeds">>
			<<if _maxUpgrades is 2>>
				Select the first upgrade to purchase up to half of previously unlocked seeds. Purchase the second rank to purchase more seeds.
			<<else>>
				Select the first upgrade to purchase up to half of previously unlocked seeds. Acquire a feat 'Breedy' to purchase more seeds.
			<</if>>
		<<case "sexToys">>
			Each purchased upgrade will give you three starting sex toys of your choice.
		<<case "xchangePremiumPills">>
			Each purchased pack gives you five X-Change Premium pills.
		<<case "greenThumb">>
			Purchase this upgrade to start with the <span class="green">Green Thumb</span> trait.
		<<case "xchangePurityTrait">>
			Purchase this upgrade to <span class="green">make all X-Change pills permanently harmless</span>. Pills can still be applied and recognised by events, but their transformations and other X-Change effects will not working.
		<<case "xchangeGrayAgentTrait">>
			Purchase this upgrade to turn any pill <span class="lewd">forced on you</span> into a <span class="green">gray pill</span>, where its effects still apply, but it can no longer change your sex. Pills you take willingly still work normally.
		<<case "orgasmTrait" "chokeTrait" "ejacTrait" "molestTrait" "rapeTrait" "bestialityTrait" "tentacleTrait" "critterMagnetTrait" "milkDrankTrait">>
			Purchase this upgrade to start with the <span class="green"><<print $featsBoosts.name[_type]>></span> trait.
		<<case "divineTFs">>
			Purchase this upgrade to start with a divine transformation.
		<<case "animalTFs">>
			Purchase this upgrade to start with an animal transformation.
		<<case "sadism">>
			Each purchased upgrade will increase your daily sadism by one point per level.
		<<case "masochism">>
			Each purchased upgrade will increase your daily masochism by one point per level.
		<<case "transcend">>
			Each purchased upgrade will increase the amount of skill, grades, physique and willpower points gained by <span class=gold>50%</span>.
		<<case "adaptiveGenes">>
			Each purchased upgrade will increase the amount of transformation points gained by <span class=gold>100%</span>.
		<<default>>
			Each purchased upgrade will raise your _type level by <span class="green">one letter grade.</span>
	<</switch>>
	</div>
	<<capture _type _cost _specialClothingBaseCost _nextUpgradeCost _maxUpgradeCost>>
		<div class="featButtonContainer">
			<<if _purchasedUpgrades gte 1>>
				<div class="featButton roundl">
					<<button "<span class='fa-icon fa-left'></span><span class='fa-icon fa-left'></span>">>
						<<set _currentPurchased to $featsBoosts.upgradeDetails[_type].purchased>>
						<<if _currentPurchased gt 0>>
							<<set $featsBoosts.upgradeDetails[_type].purchased to 0>>
							<<if _type is "specialClothing">>
								<<set _refundCost to -1 * $featsBoosts.upgrades.specialClothing>>
								<<run Object.keys($featsBoosts.specialClothesSets).forEach(set => $featsBoosts.specialClothesSets[set] = false)>>
							<<else>>
								<<set _refundCost to -1 * _currentPurchased * _cost>>
							<</if>>
							<<updateFeatsPointsMenu _type _refundCost>>
						<</if>>
					<</button>>
				</div>
				<div class="featButton">
					<<button "<span class='fa-icon fa-left'></span>">>
						<<if $featsBoosts.upgradeDetails[_type].purchased gt 0>>
							<<set _currentPurchased to $featsBoosts.upgradeDetails[_type].purchased>>
							<<set $featsBoosts.upgradeDetails[_type].purchased-->>
							<<if _type is "specialClothing" and _currentPurchased is 3>>
								<<set _refundCost to -1 * _specialClothingBaseCost>>
							<<elseif _type is "specialClothing" and _currentPurchased is 2>>
								<<set _refundCost to -1 * $featsBoosts.upgrades.specialClothing>>
								<<run Object.keys($featsBoosts.specialClothesSets).forEach(set => $featsBoosts.specialClothesSets[set] = false)>>
							<<elseif _type is "specialClothing" and _currentPurchased is 1>>
								<<set _refundCost to -1 * $featsBoosts.upgrades.specialClothing>>
								<<run Object.keys($featsBoosts.specialClothesSets).forEach(set => $featsBoosts.specialClothesSets[set] = false)>>
							<<else>>
								<<set _refundCost to -1 * _cost>>
							<</if>>
							<<updateFeatsPointsMenu _type _refundCost>>
						<</if>>
					<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey roundl">
					<<button "<span class='fa-icon fa-left'></span><span class='fa-icon fa-left'></span>">>
					<</button>>
				</div>
				<div class="featButtonGrey">
					<<button "<span class='fa-icon fa-left'></span>">>
					<</button>>
				</div>
			<</if>>
			<div class="gold featButton buttonDisable">
				<<button "_purchasedUpgrades / _maxUpgrades">>
				<</button>>
			</div>
			<<if _purchasedUpgrades lt _maxUpgrades and (_availableCoins gte _nextUpgradeCost)>>
				<div class="featButton">
				<<button "<span class='fa-icon fa-right'></span>">>
					<<set _currentDetails to $featsBoosts.upgradeDetails[_type]>>
					<<if _currentDetails.purchased lt _currentDetails.max and $feats.allSaves.points - $featsBoosts.pointsUsed gte _nextUpgradeCost>>
						<<set _currentDetails.purchased++>>
						<<updateFeatsPointsMenu _type _nextUpgradeCost>>
					<</if>>
				<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey">
					<<button "<span class='fa-icon fa-right'></span>">>
					<</button>>
				</div>
			<</if>>
			<<if _purchasedUpgrades lt _maxUpgrades and (_availableCoins gte _maxUpgradeCost)>>
				<div class="featButton roundr">
				<<button "<span class='fa-icon fa-right'></span><span class='fa-icon fa-right'></span>">>
					<<set _currentDetails to $featsBoosts.upgradeDetails[_type]>>
					<<set _currentRemaining to _currentDetails.max - _currentDetails.purchased>>
					<<set _currentCost to _type is "specialClothing" and _currentDetails.max gte 3 and _currentDetails.purchased lt 3 ? _specialClothingBaseCost : _currentRemaining * _cost>>
					<<if _currentRemaining gt 0 and $feats.allSaves.points - $featsBoosts.pointsUsed gte _currentCost>>
						<<set _currentDetails.purchased to _currentDetails.max>>
						<<updateFeatsPointsMenu _type _currentCost>>
					<</if>>
				<</button>>
				</div>
			<<else>>
				<div class="featButtonGrey roundr">
					<<button "<span class='fa-icon fa-right'></span><span class='fa-icon fa-right'></span>">>
					<</button>>
				</div>
			<</if>>
		</div>
		<<if _type isnot "specialClothing">>
			<div class=" black small-description" style="margin-top:10px;">
				(<span class="gold">_details.cost <<pluralise _details.cost "VrelCoin">></span> per <<= _type is "xchangePremiumPills" ? "pack" : "upgrade">>)
			</div>
		<</if>>

	<</capture>>
<</widget>>

<<widget "sexToysFeatUI">>
	<<set _totalToys to $featsBoosts.upgrades.sexToys / 10>>
	<<if _toyNumber is undefined or _toyNumber gt _totalToys>>
		<<set _toyNumber to 0>>
	<</if>>
	<<if _toys is undefined>>
		<<set _toys to {}>>
		<<run Object.values(setup.sextoys.filter(item => !item.shop.includes("forest"))).forEach(toy => T.toys[toy.namecap] = toy.index)>>
	<</if>>
	<<if _totalToys gt 1>>
		<div class="settingsGrid" style="margin:10px 0px">
			<div class="settingsHeader">Toy <<print _toyNumber+1>>
			<br>
				<<if _toyNumber gte 0 and _totalToys gt 1>>
				<span style="font-size:80%;">
					<<link "Previous Toy">>
						<<set _toyNumber-->>
						<<if _toyNumber lt 0>>
							<<set _toyNumber to _totalToys-1>>
						<</if>>
						<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
					<</link>> |
					<<link "Next Toy">>
						<<set _toyNumber++>>
						<<if _toyNumber+1 gt _totalToys>>
							<<set _toyNumber to 0>>
						<</if>>
						<<replace #featsPointsMenu>><<featsPointsMenu>><</replace>>
					<</link>>
				</span>
				<</if>>
			</div>
			<div class="settingsToggleItem">
				<span class="gold">Sex Toy:</span>
				<div id="sexToysFeatUIIndex">
					<<listbox "$featsBoosts.sexToys[_toyNumber].index" autoselect>>
						<<option "Random" -1>>
						<<optionsfrom _toys>>
					<</listbox>>
				</div>
			</div>
			<div id="sexToysFeatUIColour">
				<<sexToysFeatUIColour>>
			</div>
		</div>
		<<run $(() => { $('#sexToysFeatUIIndex select').on('input change', e => {
			new Wikifier(null, "<<replace '#sexToysFeatUIColour'>><<sexToysFeatUIColour>><</replace>>");
		}).trigger('change') })>>
	<</if>>
<</widget>>

<<widget "sexToysFeatUIColour">>
	<<if $featsBoosts.sexToys[_toyNumber].index isnot undefined and $featsBoosts.sexToys[_toyNumber].index isnot -1>>
		<<set _toyColours to {}>>
		<<set _selectedToy to Object.values(setup.sextoys).find(toy => toy.index === V.featsBoosts.sexToys[T.toyNumber].index)>>
		<<if _selectedToy and _selectedToy.colour_options and _selectedToy.colour_options.length>>
			<<run _selectedToy.colour_options.forEach(colour => _toyColours[colour] = colour)>>
		<</if>>
	<<else>>
		<<set _toyColours to {}>>
	<</if>>
	<<if Object.values(_toyColours).length gt 1>>
		<div class="settingsToggleItem">
			<span class="gold">Colour:</span><br>
			<<listbox "$featsBoosts.sexToys[_toyNumber].colour" autoselect>>
				<<option "Random" -1>>
				<<optionsfrom _toyColours>>
			<</listbox>>
		</div>
	<</if>>
<</widget>>

<<widget "specialClothingFeatUI">>
		<<if $featsBoosts.upgradeDetails.specialClothing.purchased>>
		<<set _totalSpecialClothesSets to getSpecialSets(set => set.feat)>>
		<<set _totalUnlockedSets to $feats.allSaves.specialClothes>>
		<<set _totalUnlockedSetsLimit to $featsBoosts.upgradeDetails.specialClothing.purchased gte 2 ? _totalUnlockedSets.length : Math.ceil(_totalUnlockedSets.length / 2)>>
		<<set _specialClothingCostMultiplier to $featsBoosts.upgradeDetails.specialClothing.purchased gte 3 ? 2 : 1>>
		<<if !Object.values($featsBoosts.specialClothesSets).length>>
			<!-- Populate object -->
			<<for $_labelPop, $_valuePop range _totalSpecialClothesSets>>
				<<set $featsBoosts.specialClothesSets[$_valuePop] to false>>
			<</for>>
		<</if>>
		<<run $(() => { $('[data-limit-group]').first().trigger('change.macros') })>>
		<br>
		<div class="settingsHeader" style="margin-bottom: 0.5em">Sets To Unlock</div>
		<<if _specialClothingCostMultiplier is 2>>
			<div class="gold" style="margin-bottom: 0.5em;">Stage 3 story unlocks cost twice each set's normal VrelCoin price.</div>
		<</if>>
		<form>
			<fieldset class="specialClothesFeatFieldset">
				<legend>Select up to _totalUnlockedSetsLimit sets</legend>
					<div class="red" style="padding-left: 10px">If you find that certain sets aren't unlocked when they should be, try loading a save with the set unlocked, move a passage, and save.</div>
					<div class="settingsGridSmall specialClothesFeatGrid">
						<<for $_labelC, $_valueC range $featsBoosts.specialClothesSets>>
							<label>
								<div class="settingsToggleItem specialClothesFeatBooster">
									<<capture $_labelC>>
										<<set $_clothingObject to clone(setup.specialClothesSets[$_labelC])>>
										<<set $_listFromSets to []>><<set $_hints to []>>
										<<set $_clothesToPush to setup.specialClothes.filter(fromSets => fromSets.sets.includes($_labelC))>>
										<<run $_clothesToPush.forEach(clothing => $_listFromSets.push(clothing.name.toUpperFirst()))>>
										<<set $_setFeatCost to $_clothingObject.featCost * _specialClothingCostMultiplier>>
										<<set $_canAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - $_setFeatCost gte 0>>
										<<set $_costDisplay to "<<print setup.specialClothesSets[$_labelC].featCost * _specialClothingCostMultiplier>>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : "Vrelcoins")>>

										<<if _totalUnlockedSets.includes($_labelC)>>
											<<if $_canAfford or $featsBoosts.specialClothesSets[$_labelC]>>
												<<set $_listText to "Includes: <span class='green'>" + formatList($_listFromSets, 'and', true) + "</span>">>
												<<checkbox "$featsBoosts.specialClothesSets[$_labelC]" false true autocheck "specialClothingFeatSets" _totalUnlockedSetsLimit "<span class='red'>Selection limit reached!</span>">>
											<<else>>
												<<set $_listText to "<span class='red'>Not enough VrelCoins!</span><br> Includes: <span class='green'>" + formatList($_listFromSets, 'and', true) + "</span>">>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="Includes: $_listText" disabled>
											<</if>>
												<<if $_clothingObject.icon is "clothes">>
													<<set $_cIcon to clone(setup.clothes[$_clothingObject.iconSlot][$_clothingObject.iconIndex])>>
													<<set $_cIcon.colour to $_clothingObject.iconColor>><<set $_cIcon.accessory_colour to $_clothingObject.iconAccColor>>
													<<clothingicon $_cIcon $_clothingObject.iconSlot>>
												<<else>>
													<<set $_cIcon to $_clothingObject.icon>>
													<<icon $_cIcon>>
												<</if>>
												<span class="gold tooltip-anchor" @tooltip="$_listText"><<print $_labelC.replace(/_/g," ").toUpperFirst()>></span>
												<div class="gold" style="display:inline-block">($_costDisplay)</div>
										<<else>>
												<<if setup.specialClothesSets[$_labelC].subsetOf>>
													<<run setup.specialClothesSets[$_labelC].subsetOf.forEach(subset => {
														if (setup.specialClothesSets[subset].hint) $_hints.pushUnique(setup.specialClothesSets[subset].hint);
													})>>
												<</if>>
												<<if setup.specialClothesSets[$_labelC].hint>>
													<<set $_hints.pushUnique(setup.specialClothesSets[$_labelC].hint)>>
												<</if>>
												<<set $_hintText to $_hints.length ? "<br><span class='black'>Hint: " + formatList($_hints, 'or', true).toUpperFirst() + "</span>" : "">>
												<<set $_listText to "<span class='red'>Not earned!</span><br> Includes: <span class='black'>" + formatList($_listFromSets, 'and', true) + "</span>" + $_hintText>>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="Includes: $_listText" disabled>
												<<lockicon>>
												<span class="black tooltip-anchor" @tooltip="Includes: $_listText"><<print $_labelC.replace(/_/g," ").toUpperFirst()>></span>
												<div class="black" style="display:inline-block">($_costDisplay)</div>
										<</if>>
									<</capture>>
								</div>
							</label>
						<</for>>
					</div>
			</fieldset>
		</form>
			<<run $(document).off("change.specialClothesFeat").on("change.specialClothesFeat",
				'input[type="checkbox"][data-limit-group="specialClothingFeatSets"]',
				function () {
					const id = $(this).attr("id").replace(/^checkbox-featsboostsspecialclothessets-/, "").replace(/-/g, "_");
					const multiplier = V.featsBoosts.upgradeDetails.specialClothing.purchased >= 3 ? 2 : 1;
					const cost = setup.specialClothesSets[id].featCost * multiplier;
					if ($(this).prop("checked")) {
						new Wikifier(null, `<<updateFeatsPointsMenu "specialClothing" ${cost}>>`);
					} else {
						new Wikifier(null, `<<updateFeatsPointsMenu "specialClothing" ${cost} "subtract">>`);
					}
				}
			);
		>>
	<</if>>
<</widget>>

<<widget "seedsFeatUI">>
	<<if $featsBoosts.upgradeDetails.seeds.purchased>>
		<<set _totalSeeds to Object.keys(setup.foodstuff).filter(food => setup.foodstuff[food].tending?.featCost)>>
		<<set _totalUnlockedSeeds to $feats.allSaves.seeds>>
		<<set _totalUnlockedSeedsLimit to $featsBoosts.upgradeDetails.seeds.purchased gte 2 ? Math.ceil(_totalUnlockedSeeds.length / 1) : Math.ceil(_totalUnlockedSeeds.length / 2)>>
		<<if !Object.values($featsBoosts.seeds).length>>
			<!-- Populate object -->
			<<for $_labelPop, $_valuePop range _totalSeeds>>
				<<set $featsBoosts.seeds[$_valuePop] to false>>
			<</for>>
		<</if>>
		<<run $(() => { $('[data-limit-group]').first().trigger('change.macros') })>>
		<br>
		<div class="settingsHeader" style="margin-bottom: 0.5em">Seeds To Unlock</div>
		<form>
			<fieldset>
				<legend>Select up to _totalUnlockedSeedsLimit seeds</legend>
					<div class="red" style="padding-left: 10px">If you find that certain seeds aren't unlocked when they should be, try loading a save with the seed unlocked, move a passage, and save.</div>
					<div class="settingsGridSmall">
						<<for $_labelC, $_valueC range $featsBoosts.seeds>>
							<label>
								<div class="settingsToggleItem" id="specialClothesFeatBooster">
									<<capture $_labelC>>
										<<set $_seed to clone(setup.foodstuff[$_labelC])>>
										<<set $_canAfford to ($feats.allSaves.points - $featsBoosts.pointsUsed) - $_seed.tending.featCost gte 0>>
										<<set $_costDisplay to "<<print $_seed.tending.featCost>>"+ ($options.images is 1 ? " <img class='imgButton' src='img/ui/coin-gold.gif'/>" : "Vrelcoins")>>

										<<if _totalUnlockedSeeds.includes($_labelC)>>
											<<if $_canAfford or $featsBoosts.seeds[$_labelC]>>
												<<checkbox "$featsBoosts.seeds[$_labelC]" false true autocheck "seedsFeatSelect" _totalUnlockedSeedsLimit "<span class='red'>Selection limit reached!</span>">>
												<<icon `"tending/" + $_seed.icon`>>
												<span class="gold"><<print $_seed.name.toUpperFirst()>></span>
											<<else>>
												<<set $_listText to "<span class='red'>Not enough VrelCoins!</span>">>
												<input type="checkbox" class="black tooltip-anchor" @tooltip="$_listText" disabled>
												<<icon `"tending/" + $_seed.icon`>>
												<span class="gold tooltip-anchor" @tooltip="$_listText"><<print $_seed.name.toUpperFirst()>></span>
											<</if>>
											<div class="gold" style="display:inline-block">($_costDisplay)</div>
										<<else>>
											<<set $_hints to []>>
											<<set $_hintText to $_hints.length ? "<br><span class='black'>Hint: " + formatList($_hints, 'or', true).toUpperFirst() + "</span>" : "">>
											<<set $_listText to "<span class='red'>Not earned!</span>" + $_hintText>>
											<input type="checkbox" class="black tooltip-anchor" @tooltip="$_listText" disabled>
											<<lockicon>>
											<span class="black tooltip-anchor" @tooltip="$_listText"><<print $_seed.name.toUpperFirst()>></span>
											<div class="black" style="display:inline-block">($_costDisplay)</div>
										<</if>>
									<</capture>>
								</div>
							</label>
						<</for>>
					</div>
			</fieldset>
		</form>
			<<run $(document).off("change.specialClothesFeat").on("change.specialClothesFeat", /* ???? */
				'input[type="checkbox"][data-limit-group="seedsFeatSelect"]',
				function () {
					const id = $(this).attr("id").replace(/^checkbox-featsboostsseeds-/, "").replace(/-/g, "_"); /* featsboostsseeds is $featsBoosts.seeds[$_labelC] */
					if ($(this).prop("checked")) {
						new Wikifier(null, `<<updateFeatsPointsMenu "seeds" setup.foodstuff["${id}"].tending.featCost>>`);
					} else {
						new Wikifier(null, `<<updateFeatsPointsMenu "seeds" setup.foodstuff["${id}"].tending.featCost "subtract">>`);
					}
				}
			);
		>>
	<</if>>
<</widget>>

<<widget "updateFeatsPointsMenu">>
	<<set _cost to _args[2] is "subtract" ? _args[1] * -1 : _args[1]>>
	<<if $feats.allSaves.points - $featsBoosts.pointsUsed gte _cost or _cost lt 0>>
		<<set $featsBoosts.upgrades[_args[0]] += _cost>>
		<<set $featsBoosts.pointsUsed += _cost>>
		<<set $featsBoosts.pointsUsed = Math.max(0, $featsBoosts.pointsUsed)>>
	<</if>>
	<<replace #featsPointsMenu>>
		<<featsPointsMenu>>
	<</replace>>
<</widget>>

/* Fake feats, for when you want to gaslight the player. Used for the Wraith, primarily */
<<widget "displayFeatFake">>
	<<if _args[0] and $feats.locked is false and $cheatsEnabled is false and $debug is 0 and $gamemode isnot "soft" and $settings.allureModifier gte 1>>
		<<silently>>
			<<if _featsCount is undefined>>
				<<set _featsCount to 0>>
			<<else>>
				<<set _featsCount++>>
			<</if>>
		<</silently>>
		<div @id="'feat-' + _featsCount" class="feat feat-overlay">
			<div class="featImage">
				<<switch setup.feats[_args[0]].difficulty>>
					<<case 1>><img src="img/ui/coin-copper-fake.gif" class="featCoin">
					<<case 2>><img src="img/ui/coin-silver-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-gold-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-platinum-fake.gif" class="featCoin">
					<<case 3>><img src="img/ui/coin-jeweled-fake.gif" class="featCoin">
				<</switch>>
			</div>
			<div class="featText">
				<<switch _args[0]>>
					<<case "It Belongs in a Museum">>
						<span class="title">It Belongs in a Museum?</span>
					<<default>>
						<<if setup.feats[_args[0]].title.endsWith("?")>>
							<span class="title"><<print setup.feats[_args[0]].title>></span>
						<<else>>
							<span class="title"><<print setup.feats[_args[0]].title>>?</span>
						<</if>>
				<</switch>>
				<br>
				<<switch _args[0]>>
					<<case "No More Control">>
						<span class="text">You don't know how to get lewder... right?</span>
					<<case "Teachers Nightmare">>
						<span class="text">You are a terror... right?</span>
					<<case "Anti-Social Moth">>
						<span class="text">Who needs friends... right?</span>
					<<default>>
						<<if setup.feats[_args[0]].desc.endsWith(".")>>
							<span class="text"><<print setup.feats[_args[0]].desc>>.. right?</span>
						<<else>>
							<span class="text"><<print setup.feats[_args[0]].desc>>... right?</span>
						<</if>>
				<</switch>>
			</div>
			<div @id="'closeFeat-' + _featsCount" class="closeFeat" @onclick="'closeFeats('+ _featsCount +')'"></div>
		</div>
	<</if>>
<</widget>>
