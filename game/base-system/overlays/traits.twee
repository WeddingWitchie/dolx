					name: () => playerAwareTheyArePregnant() ? "Acceptance: Pregnant Belly" : "Acceptance: Pregnant Looking Belly",
					colour: "green",
					has: $acceptance_pregnancy gte 1000 and playerBellySize() gte 8,
					text: () => playerAwareTheyArePregnant() ? "You're proud of your lifebearing belly." : "You're proud of your large belly.",
				},
			],
		},
		{
			title: "???",
			traits: [
				{
					name: "Elk-scarred",
					colour: "red",
					has: $auriga_scar is 1,
					text: "An invisible wound hangs over your heart. Trauma and awareness increase over time. Purity decreases over time. Your animal transformations no longer lose progress.",
					textColour: "red",
				},
				{
					name: "Elk-marked",
					colour: "red",
					has: $auriga_scar is 2,
					text: "A crackling wound surrounds your heart. You're harder to notice, and to recognise as human. Your animal transformations no longer lose progress.",
					textColour: "red",
				},
				{
					name: "Elk-bitten",
					colour: "red",
					has: $auriga_scar is 3,
					text: "A hole threatens to swallow your black heart. Something seeks to escape. Your animal transformations no longer lose progress.",
					textColour: "red",
				},
				{
					name: "Elk-ruptured",
					colour: "red",
					has: $auriga_scar is 4,
					text: "A rupture severs your black, unbeating heart. Damnation is imminent. Your animal transformations no longer lose progress.",
					textColour: "red",
				},
				{
					name: "Elk-spawned",
					colour: "red",
					has: $auriga_scar gte 5,
					text: "Damnation. Your animal transformations no longer lose progress.",
					textColour: "red",
				},
			],
		},
	]>>

	/* X-Change: mastery traits, earned by taking a pair of related skills to the top grade. See mastery-traits.js. */
	<<run (function () {
		const held = masteryTraitsHeld();
		if (!held.length) return;
		T.traitLists.push({
			title: "Mastery Traits",
			traits: held.map(trait => ({
				name: trait.name,
				colour: trait.colour,
				has: true,
				text: `[${trait.requires}] ${trait.text}`,
			})),
		});
	})()>>

	/* X-Change: append a live status entry to "NPC Traits" for every pilled Named NPC, covering the body change, whether their gender flipped with it, and time remaining. */
	<<run (function () {
		const list = T.traitLists.find(l => l.title === "NPC Traits");
		if (!list || !Array.isArray(V.NPCNameList)) return;
		for (const name of V.NPCNameList) {
			const status = npcXchangePillStatus(name);
			if (!status) continue;
			list.traits.push({
				name: `${status.label}: ${name}`,
				colour: status.colour,
				has: true,
				text: status.text,
			});
		}
	})()>>

	<div id="traitListsSearch">
		<<traitListsSearch>>
	</div>
	<br>
	<div id="traitLists">
		<<traitLists>>
	</div>
<</widget>>

<<widget "traitListsSearch">>
	<<if $options.traitOverlayFormat is undefined>><<set $options.traitOverlayFormat to "table">><</if>>
	<<set _traitSearch to "">>
	<<foldout false "_traitFilterFoldout">>
		<span>Filter</span>
		<label>Search: <<textbox "_traitSearch" _traitSearch>></label>
		<br><br>
		<label>
			Display Format:
			<<listbox "$options.traitOverlayFormat" autoselect>>
				<<option "Table" "table">>
				<<option "Reduced Table" "reducedTable">>
				<<option "List" "list">>
			<</listbox>>
		</label>
		<br><br>
		<<link Update>>
			<<replace "#traitLists">><<traitLists>><</replace>>
		<</link>> |
		<<link Clear>>
			<<set _traitSearch to "">>
			<<replace "#traitListsSearch">><<traitListsSearch>><</replace>>
			<<replace "#traitLists">><<traitLists>><</replace>>
		<</link>> |
	<</foldout>>
<</widget>>

<<widget "traitLists">>
	<<set _traitSearch2 to _traitSearch.toLowerCase()>>
	<<for $_traitList range _traitLists>>
		<<if $statFreeze and $_traitList.title is "X-Change Traits">><<continue>><</if>>
		<<if !$_traitList.traits.find(trait => trait.has &&
			(T.traitSearch2 === "" ||
			(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
			(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
			(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
			(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
		)>>
			<<continue>>
		<</if>>
		<<if ["table","reducedTable"].includes($options.traitOverlayFormat)>>
			<div @class="$options.traitOverlayFormat is 'table' ? 'traitList' : 'traitListReducedText'">
				<div class="traitHeading">
					<<print $_traitList.title>>
				</div>
				<div class="traits">
				<<for $_trait range $_traitList.traits.filter(trait => trait.has &&
					(T.traitSearch2 === "" ||
					(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
					(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
				)>>
					<div class="trait">
						<<set $_name to typeof $_trait.name is "function" ? $_trait.name() : $_trait.name>>
						<<set $_colour to typeof $_trait.colour is "function" ? $_trait.colour() : $_trait.colour>>
						<<set $_style to typeof $_trait.style is "function" ? $_trait.style() : $_trait.style>>
						<<set $_text to typeof $_trait.text is "function" ? $_trait.text() : $_trait.text>>
						<<set $_textColour to typeof $_trait.textColour is "function" ? $_trait.textColour() : $_trait.textColour>>
						<<set $_meter to $_trait.meter>>
						<span @class="$_colour" @style="$_style">
							<<print $_name>>
						</span>
						<<if !$_text>>
						<<elseif $options.traitOverlayFormat is "table">>
							- <small @class="$_textColour"><<print $_text>></small>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor(($_meter.value - $_floor) / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<<else>>
							<mouse class="tooltip linkBlue">Info (?)<span @class="$_textColour"><<print $_text>></span></mouse>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor($_meter.value / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<</if>>
					</div>
				<</for>>
				</div>
			</div>
			<br>
		<</if>>
		<<if $options.traitOverlayFormat is "list">>
			<div>
				<h4>
					<<print $_traitList.title>>
				</h4>
				<<for $_trait range $_traitList.traits.filter(trait => trait.has &&
					(T.traitSearch2 === "" ||
					(typeof trait.name === "function" && trait.name().toLowerCase().includes(T.traitSearch2)) ||
					(typeof trait.name !== "function" && trait.name.toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text === "function" && trait.text().toLowerCase().includes(T.traitSearch2)) ||
					(trait.text && typeof trait.text !== "function" && trait.text.toLowerCase().includes(T.traitSearch2)))
				)>>
					<div class="trait">
						<<set $_name to typeof $_trait.name is "function" ? $_trait.name() : $_trait.name>>
						<<set $_colour to typeof $_trait.colour is "function" ? $_trait.colour() : $_trait.colour>>
						<<set $_style to typeof $_trait.style is "function" ? $_trait.style() : $_trait.style>>
						<<set $_text to typeof $_trait.text is "function" ? $_trait.text() : $_trait.text>>
						<<set $_textColour to typeof $_trait.textColour is "function" ? $_trait.textColour() : $_trait.textColour>>
						<<set $_meter to $_trait.meter>>
						<span @class="$_colour" @style="$_style">
							<<print $_name>>
						</span>
						<<if $_text>>
							- <span @class="$_textColour"><<print $_text>></span>
							<<if $_meter?.has and !$_meter.hide>>
								<<set $_floor to $_meter.min || 0>>
								<<set $_timeTotal to ($_meter.max - $_floor)>>
								<<set $_percent to Math.floor($_meter.value / $_timeTotal * 100)>>
								<div class="meter">
									<<print '<div @class="$_meter.colour" style="width:' + $_percent + '%"></div>'>>
								</div>
							<</if>>
						<</if>>
					</div>
				<</for>>
			</div>
			<br>
		<</if>>
	<</for>>
<</widget>>
