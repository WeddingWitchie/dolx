:: Traits [widget]
<<widget "traits">>
	<<if $sexStats and $sexStats.pills>>
		<<set _pills to $sexStats.pills.pills>>
	<</if>>
	<<set _amcTraitName to (name, stat) => `<mouse class='tooltip green'>${name}<span>
		Modifiers:
		<ul>
			<li class='green'>+100% maximum ${stat} points cap.</li>
		</ul>
	</span></mouse>`>>
	<<set _traitLists to [
		{
			title: "General Traits",
			traits: [
				{
					name: "Virgin",
					colour: "green",
					has: playerCountsAsVirgin(),
					text: "Your purity recovers faster. Your virginity might be worth something.",
				},
				{
					name: "Chastity Vow",
					colour: "blue",
					has: $player.virginity.temple is true or $player.virginity.temple is 1,
					text: "Lost when your <<if $player.penisExist>>penis is enveloped<</if>><<if $player.penisExist and $player.vaginaExist>> or your <</if>><<if $player.vaginaExist>>vagina is penetrated<</if>>. The temple will know.",
				},
				{
					name: "Broken Vow",
					colour: "red",
					has: $player.virginity.temple isnot true and $player.virginity.temple isnot 1 and $temple_rank isnot "prospective" and $temple_rank isnot undefined,
					text: "The temple will know.",
				},
				{
					name: "Temple Burden: $temple_burden%",
					colour: "blue",
					has: $temple_burden gte 1,
					text: "You are carrying part of the world's corruption within yourself. Physique, willpower, athletics, dancing, skulduggery, swimming, tending, housekeeping, and English skill checks have a $temple_burden% chance to automatically fail.",
				},
				{
					name: "Purity Boost",
					colour: "green",
					has: $featsPurityBoost gt 0,
					text: () => {
						let dailyPurity = 1;
						if (Transformations.effectiveLevel("fallen") >= 2) dailyPurity -= 10;
						if (playerCountsAsVirgin()) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "You are gaining purity daily.";
						if (dailyPurity + V.featsPurityBoost === 0) return "You are not losing purity daily.";
						return "You are losing less purity daily.";
					},
				},
				{
					name: "Impurity Boost",
					colour: "red",
					has: $featsPurityBoost lt 0,
					text: () => {
						let dailyPurity = 1;
						if (Transformations.effectiveLevel("fallen") >= 2) dailyPurity -= 10;
						if (playerCountsAsVirgin()) dailyPurity += 2;
						if (dailyPurity + V.featsPurityBoost > 0) return "You are gaining less purity daily.";
						if (dailyPurity + V.featsPurityBoost === 0) return "You are not gaining purity daily.";
						return "You are losing purity daily.";
					},
				},
				{
					name: "Sadism boost",
					colour: "red",
					has: $featsSadismBoost gt 0,
					text: () => {
						let dailySadism = 1;
						if (dailySadism + V.featsSadismBoost > 0) return "You are gaining sadism daily.";
						if (dailySadism + V.featsSadismBoost === 0) return "You are not gaining sadism daily.";
						return "You are gaining sadism daily.";
					},
				},
				{
					name: "Masochism boost",
					colour: "pink",
					has: $featsMasochismBoost gt 0,
					text: () => {
						let dailyMasochism = 1;
						if (dailyMasochism + V.featsMasochismBoost > 0) return "You are gaining masochism daily.";
						if (dailyMasochism + V.featsMasochismBoost === 0) return "You are not gaining masochism daily.";
						return "You are gaining masochism daily.";
					},
				},
				{
					name: () => [
						"<mouse class='tooltip'><span style='background: linear-gradient(to right, rgb(139, 0, 0) 0%, rgb(255, 60, 60) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: bold;'>iNSaNiTY</span><span>",
						"The weight of the air is torture. You don't know who you are anymore.",
						"<br><br>",
						"Modifiers:",
						"<ul>",
						"<li class='red'>-75% gains to physique.</li>",
						"<li class='red'>-75% gains to swimming.</li>",
						"<li class='red'>-75% gains to willpower.</li>",
						"<li class='red'>-50% gains to brawling.</li>",
						"<li class='red'>-25% gains to footwork.</li>",
						"<li class='red'>-25% gains to striking.</li>",
						"<li class='red'>-25% gains to kicking.</li>",
						"<li class='red'>-25% gains to athletics.</li>",
						"<li class='red'>-25% gains to dancing.</li>",
						"<li class='red'>-50% gains to academics.</li>",
						"<li class='red'>+50% gains to crime.</li>",
						"<li class='red'>+25% gains to delinquency.</li>",
						V.background?.insanity === true ? "<li class='orange'>Forces all character talents active, and doubles all skill caps.</li>" : "",
						"<li class='orange'>Sensitivity increases are severely dampened.</li>",
						"</ul>",
						"Decay:",
						"<ul>",
						"<li class='red'>+25% decay to physique.</li>",
						"</ul>",
						"</span></mouse>",
					].join(""),
					colour: "red",
					has: $backgroundTraits.includes("insanity"),
					text: () => {
						const base = V.insanityPermanent
							? "Psychopathy has taken deep root. The darkness is absolute, and this fractured illusion is now your permanent reality."
							: "The shadows are creeping in. Prolonged trauma has shattered your perception, blurring the lines of who you used to be.";
						return V.innocencestate === 1
							? base + " <i>Innocence eases the strain on your mind.</i>"
							: base;
					},
				},
				{
					name: "<mouse class='tooltip lblue'>Crossdresser<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to gender opposite to original sex.</li>
							<li class='red'>-50% gains to gender matching original sex.</li>
							<li class='orange'>These multipliers bypass the Gender Identity attitude setting and always apply regardless of configuration.</li>
						</ul>
					</span></mouse>",
					colour: "pink",
					has: $backgroundTraits.includes("crossdresser") and !$background.transgender and playerOriginalSex() is "m",
					text: "Stress decays faster while dressed as a girl, but slower when dressed as a boy. Additionally, it's much easier to see yourself as a girl as well.",
				},
				{
					name: "<mouse class='tooltip lblue'>Crossdresser<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to gender opposite to original sex.</li>
							<li class='red'>-50% gains to gender matching original sex.</li>
							<li class='orange'>These multipliers bypass the Gender Identity attitude setting and always apply regardless of configuration.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("crossdresser") and !$background.transgender and playerOriginalSex() is "f",
					text: "Stress decays faster while dressed as a boy, but slower when dressed as a girl. Additionally, it's much easier to see yourself as a boy as well.",
				},
				{
					name: "<mouse class='tooltip lblue'>Transgender<span class='green'>You've always known yourself to be a different gender than the one you were born into, and no amount of dressing differently will change that (your identity is yours to define, not the world's to assign).</span></mouse>",
					colour: "lblue",
					has: $background.transgender,
					text: "You know yourself to be a different gender than the one you were born into.",
				},
				{
					name: "<mouse class='tooltip lblue'>Gender-Anxious<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to gender matching original sex.</li>
							<li class='red'>-50% gains to gender opposite to original sex.</li>
							<li class='orange'>These multipliers bypass the Gender Identity attitude setting and always apply regardless of configuration.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("genderAnxious") and playerOriginalSex() is "m",
					text: "You find it harder to accept your feminine side. Stress decays faster while dressed as a boy, but slower when dressed as a girl.",
				},
				{
					name: "<mouse class='tooltip lblue'>Gender-Anxious<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to gender matching original sex.</li>
							<li class='red'>-50% gains to gender opposite to original sex.</li>
							<li class='orange'>These multipliers bypass the Gender Identity attitude setting and always apply regardless of configuration.</li>
						</ul>
					</span></mouse>",
					colour: "pink",
					has: $backgroundTraits.includes("genderAnxious") and playerOriginalSex() is "f",
					text: "You find it harder to accept your masculine side. Stress decays faster while dressed as a girl, but slower when dressed as a boy.",
				},
				{
					name: "<mouse class='tooltip lblue'>Nerd<span>
						Modifiers:
						<ul>
							<li class='green'>+100% gains to academics.</li>
							<li class='green'>+100% gains to willpower.</li>
							<li class='green'>+100% gains to good fames.</li>
							<li class='green'>-75% gains to delinquency.</li>
							<li class='green'>-50% gains to crime.</li>
							<li class='red'>-75% gains to physique.</li>
							<li class='red'>-75% gains to swimming.</li>
							<li class='red'>-50% gains to brawling.</li>
							<li class='red'>-25% gains to footwork.</li>
							<li class='red'>-25% gains to striking.</li>
							<li class='red'>-25% gains to kicking.</li>
							<li class='red'>-25% gains to athletics.</li>
							<li class='red'>-25% gains to dancing.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>+25% decay to physique.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("nerd"),
					text: "You learn much faster at school. But you'll struggle at anything remotely athletic. And, it will also be harder to raise your school status.",
				},
				{
					name: "<mouse class='tooltip lblue'>Delinquent<span>
						Modifiers:
						<ul>
							<li class='green'>+50% gains to brawling.</li>
							<li class='green'>+25% gains to skulduggery.</li>
							<li class='green'>+25% gains to school status.</li>
							<li class='green'>+25% gains to footwork.</li>
							<li class='green'>+25% gains to striking.</li>
							<li class='green'>+25% gains to kicking.</li>
							<li class='red'>+50% gains to crime.</li>
							<li class='red'>+25% gains to delinquency.</li>
							<li class='red'>-50% gains to academics.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("delinquent"),
					text: "People naturally think you're cool, so your school status raises easier. And you're also talented at skulduggery. But you'll struggle with academics.",
				},
				{
					name: "<mouse class='tooltip lblue'>Athlete<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to physique.</li>
							<li class='green'>+25% gains to athletics.</li>
							<li class='green'>+25% gains to swimming.</li>
							<li class='green'>+10% gains to dancing.</li>
							<li class='red'>-25% gains to academics.</li>
						</ul>
						Decay:
						<ul>
							<li class='green'>-75% decay to physique.</li>
						</ul>
					</span></mouse>",
					colour: "lblue",
					has: $backgroundTraits.includes("athlete"),
					text: "You excel at sports and physical self-expression. So your physique reflects that. But academics kinda go way over your head.",
				},
				{
					name: "<mouse class='tooltip lblue'>Promiscuous<span>
						Modifiers:
						<ul>
							<li class='green'>+25% gains to seduction.</li>
							<li class='green'>+25% gains to sexual skills.</li>
							<li class='red'>+25% gains to awareness.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>-50% decay to awareness.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
					has: $backgroundTraits.includes("promiscuous"),
					text: "You are fairly experienced. Sexual skill and seduction just come naturally to you. Yet with that comes an uncanny awareness of what others ignore.",
				},
				{
					name: "<mouse class='tooltip lblue'>Exhibitionist<span>
						Modifiers:
						<ul>
							<li class='green'>-75% gains to exhibitionist fame.</li>
							<li class='red'>+25% gains to awareness.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>-50% decay to awareness.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
					has: $backgroundTraits.includes("exhibitionist"),
					text: "Your body has always craved the freedom that comes with your naked form. Yet being so enlightened comes with an uncanny awareness of what others ignore.",
				},
				{
					name: "<mouse class='tooltip lblue'>Deviant<span>
						Modifiers:
						<ul>
							<li class='red'>+25% gains to awareness.</li>
						</ul>
						Decay:
						<ul>
							<li class='red'>-50% decay to awareness.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
					has: $backgroundTraits.includes("deviant"),
					text: "What others find freaky, to you is so very alluring. However, this candid exploration has left you very aware of the darkest corners of the world.",
				},
				{
					name: "<mouse class='tooltip lblue'>Lustful<span>
						Modifiers:
						<ul>
							<li class='green'>+15% gains to seduction.</li>
						</ul>
					</span></mouse>",
					colour: "lewd",
					has: $backgroundTraits.includes("lustful"),
					text: "Arousal increases over time and needs to be managed.",
				},
				{
					name: `<mouse class='tooltip purple'>Autism Spectrum
						<span class='tooltiptext'>
							You are sensitive to sensory and social demands, prefer familiar routines, and can focus deeply on your interests. The same traits can help or drain you depending on your environment.
						</span>
					</mouse>`,
					colour: "purple",
					has: playerHasAutismSpectrum(),
					text: "Familiar structure and focused interests help, but sensory input, abrupt changes, and accumulated demands can wear you down.",
				},
				{
					name: () => {
						const capacity = autismSpectrumPhase();
						const heading = capacity === "settled" ? "Settled" : capacity === "burnout" ? "Burnout" : "Strained";
						const colour = capacity === "settled" ? "green" : capacity === "burnout" ? "red" : "gold";

						const effects = {
							settled: `
								<li class='green'>All stat gains are increased by 5%.</li>
								<li class='green'>School grade gains are increased by 25%.</li>
							`,
							strained: `
								<li class='default-colour'>No bonus or penalty.</li>
							`,
							burnout: `
								<li class='red'>All stat gains are reduced by 20%.</li>
								<li class='red'>School grade gains are reduced by 30%.</li>
								<li class='red'>Study-related demands cause twice as much stress.</li>
								<li class='red'>Practising skills can cause trauma.</li>
							`,
						};

						return `<mouse class='tooltip ${colour}'>${heading}: ${autismLoadPercent()}% Load
							<span class='tooltiptext'>
								Comes from Autism Spectrum. Load shows how much ongoing demands are wearing you down.
								<br><br>

								Current effects:
								<ul>
									${effects[capacity] || effects.strained}
								</ul>

								<i class='red'>Load increases from sudden changes, crowds, noise, bright midday light, heat, unclear social situations, and going too long without rest.</i>
								<i class='green'>Load decreases from sleep, quiet time, calm activities, and spending time on your current interest.</i>
								<br><br>
								You can still recover <b class='gold'>${autismRecoveryLeftToday()}</b> Load today.
								<b class='gold'>${autismDeliberateLeftToday()}</b> of that requires deliberate regulation.
								<br><br>
								Your willpower affects when Strained and Burnout begin.
								<br>
								<b class='gold'>Strained: ${autismStrainedThreshold()}% Load</b>
								<br>
								<b class='red'>Burnout: ${autismBurnoutThreshold()}% Load</b>
								<br><br>
								A meltdown can happen at <b class='red'>${autismMeltdownLoadValue()}% Load</b> while you also have <b class='red'>${autismMeltdownStressPercent()}% stress</b>.
								Staying at <b class='red'>${autismLoadTraumaValue()}% Load</b> for a full day without resting causes trauma.
							</span>
						</mouse>`;
					},
					colour: () => {
						const capacity = autismSpectrumPhase();
						return capacity === "settled" ? "green" : capacity === "burnout" ? "red" : "gold";
					},
					has: playerHasAutismSpectrum(),
					text: () => {
						const capacity = autismSpectrumPhase();

						if (capacity === "settled") return "Your Load is low, making daily demands easier to handle.";
						if (capacity === "burnout") return "Your Load is very high, reducing your gains and making some activities more harmful.";
						return "Your Load is high enough that you no longer receive the benefits of low Load.";
					},
				},
				{
					name: () => {
						const items = autismObligationLabels();
						return `<mouse class='tooltip red'>Outstanding: ${items.length}
							<span class='tooltiptext'>
								Comes from Autism Spectrum. These are tasks or problems you know about but have not dealt with yet.
								<br><br>
								<ul>
									${items.map(item => `<li class='red'>${item.toUpperFirst()}</li>`).join("")}
								</ul>
								<b class='red'>Each outstanding item adds Load every day until you deal with it.</b>
								Once you deal with an item, it stops adding Load.
							</span>
						</mouse>`;
					},
					colour: "red",
					has: playerHasAutismSpectrum() && autismObligationLabels().length > 0,
					text: "Things you know you still need to deal with add Load each day.",
				},
				{
					name: () => {
						const masking = autismMaskingLevel();
						const colour = masking >= 70 ? "red" : masking >= 35 ? "gold" : "purple";
						const active = autismMaskingActive()
							? "<b class='gold'>You are masking right now.</b>"
							: "You are not masking right now.";
						const composure =
							autismComposureLeft() > 0
								? "<b class='green'>You prepared yourself beforehand. For about " +
									autismComposureLeft() +
									" more minutes, Masking builds more slowly.</b>"
								: "";
						return `<mouse class='tooltip ${colour}'>Masking: ${masking}%
							<span class='tooltiptext'>
								Comes from Autism Spectrum. Masking means changing how you act to match what other people expect.
								<br><br>
								${active}
								<br><br>
								Modifiers:
								<ul>
									<li class='red'>Masking adds Load. Higher Masking adds Load faster.</li>
									<li class='red'>Masking for too long makes shutdown more likely during an overload.</li>
									<li class='green'>Stopping Masking in private removes some of the Load and lowers stress.</li>
								</ul>
								Masking builds faster around strangers and slower around people you trust.
								It does not build when you are alone or asleep. Sleeping also lowers your masking without adding Load.
								People you live with count as being around you while they are at home.
								<br><br>
								${composure}
							</span>
						</mouse>`;
					},
					colour: () => {
						const masking = autismMaskingLevel();
						return masking >= 70 ? "red" : masking >= 35 ? "gold" : "purple";
					},
					has: playerHasAutismSpectrum(),
					text: () => {
						const masking = autismMaskingLevel();

						if (!autismMaskingActive()) return masking > 0 ? "You are not masking right now. Your Masking level is gradually decreasing as you recover." : "You are not masking.";
						if (masking >= 70) return "Masking is taking most of your attention.";
						if (masking >= 35) return "Masking is taking steady effort.";
						if (masking > 0) return "You are masking with little effort.";
						return "You are beginning to mask.";
					},
					meter: {
						has: playerHasAutismSpectrum(),
						value: autismMaskingLevel(),
						min: 0,
						max: 100,
						colour: "purplebar",
					},
				},
				{
					name: () => `<mouse class='tooltip gold'>Current Interest: ${autismHyperfixationName().toUpperFirst()}
						<span class='tooltiptext'>
							Comes from Autism Spectrum. This is the activity drawing you most strongly for the next few weeks.
							It can help you regulate.
							<br><br>
							Modifiers:
							<ul>
								<li class='green'>Practising it lowers stress and Load.</li>
								<li class='red'>Abruptly changing tasks raises stress and Load.</li>
								<li class='red'>More than 2 hours of continuous practice can reduce gains by up to 25%.</li>
								<li class='orange'>A 3-hour break clears this practice penalty.</li>
								<li class='orange'>Lessons, studying, swimming, dancing, tending, housekeeping, and training count as practice.</li>
							</ul>
						</span>
					</mouse>`,
					colour: "gold",
					has: playerHasAutismSpectrum(),
					text: () => {
						const days = autismHyperfixationDaysRemaining();
						return `This interest may shift in ${days} day${days === 1 ? "" : "s"}.`;
					},
				},
				{
					name: () => `<mouse class='tooltip red'>${autismOverloadForm() === "shutdown" ? "Shutdown" : "Meltdown"}
						<span class='tooltiptext'>
							Comes from Autism Spectrum. A meltdown or shutdown can happen when both stress and Load become very high.
							<br><br>
							Modifiers:
							<ul>
								<li class='red'>-35% gains to all activities.</li>
								<li class='red'>Abrupt changes and prolonged practice cause trauma instead of stress.</li>
								<li class='green'>Your current interest can still lower stress and Load.</li>
								<li class='green'>The overload ends when stress falls to 70% or lower.</li>
							</ul>
							Calming activities can help lower your stress.
						</span>
					</mouse>`,
					colour: "red",
					has: playerHasAutismSpectrum() && autismInMeltdown(),
					text: "You are overwhelmed. Other activities are much harder until your stress comes down.",
				},
				{
					name: "Green Thumb",
					colour: "green",
					has: $backgroundTraits.includes("greenthumb"),
					text: "More bountiful crops and no decay when using fertiliser.",
				},
				{
					name: () => V.submissive <= 850 ? "Dendrophile" : "Plant Lover",
					colour: "lewd",
					has: $backgroundTraits.includes("plantlover"),
					text: "Plants are everything to you. Plantpeople and plant-based tentacles no longer require hallucinations to encounter. You get a bonus to tending as your trauma increases.",
				},
				{
					name: "Nectar Addict",
					colour: "red",
					has: $backgroundTraits.includes("plantlover"),
					text: () =>
						"You're more vulnerable to aphrodisiacs and alcohol. You draw nourishment from nectar. Drinking it invigorates your body, improving physique and reducing stress. Failing to consume nectar for an extended period will take its toll on your body and eventually cause this trait and the <<if $submissive lte 850>><span class='lewd'>Dendrophile</span><<else>><span class='lewd'>Plant Lover</span><</if>> trait to disappear." +
						(wearingTidebloomRing()
							? " <span class='green'>The tidebloom ring keeps the trait active while you wear it.</span>"
							: "") +
						"<span class='hidden'></span>",
				},
				{
					name: () => {
						return "Ear slime focus: " + $earSlime.focus;
					},
					colour: "lewd",
					has: $earSlime.focus and $earSlime.focus isnot "none",
					text: () => {
						let result;
						switch ($earSlime.focus) {
							case "pregnancy":
								result = "You chose the path of pregnancy, causing the ear slime to amplify traits related to becoming pregnant, while weakening other traits.";
								break;
							case "mixed":
								result = "You chose to walk the path between pregnancy and impregnation, causing the ear slime to amplify traits related to both, to a lesser degree.";
								break;
							case "impregnation":
								result = "You chose the path of impregnation, causing the ear slime to amplify traits related to impregnating others, while weakening other traits.";
								break;
						}
						let parasites = [];
						if ($parasite.breasts and $parasite.breasts.name is "parasite") {
							if ($player.breastsize gte 1) {
								parasites.push("breasts");
							} else {
								parasites.push("chest");
							}
						}
