:: Avery Mod Widgets [widget]
<<widget "averyMasturbateOption">>
	<<if $awareness gte 0>>
		<<icon "avery-bedroom.png">><<link [[Masturbate in bed|Mansion Bedroom Masturbate]]>><<set $masturbationstart to 1>><<unset $finish>><<unset $sexstart>><<unset $fightstart>><<unset $timer>><<unset $timerMax>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "averydatewage">>
	<<set _averyRate to (_args[0] is "low") ? 1 : 10>>
	<<set _averyEndear to Number.isFinite($endear) ? $endear : 0>>
	<<set _averyPay to C.npc.Avery.love * _averyRate + _averyEndear * _averyRate + 10>>
	<<set _averyPay *= (1 + Math.clamp((($fame && Number.isFinite($fame.model)) ? $fame.model : 0) / 1000, 0, 4))>>
	<<set _averyPay to Math.max(1, Math.round(_averyPay))>>
	<<if _args[1] is "pay">><<money `_averyPay * 100` "avery">><</if>>
<</widget>>

<<widget "avery_saved_swallow">>
	/* Saved route: Avery masters <<his>> temper at the last second instead of lashing out */
	<<set $avery_mansion.rage.timer to 30>>
	<<set $avery_mansion.rage.assess to 0>>
	<<if !$avery_passage>><<set $avery_passage to "Mansion Garage">><</if>>
	<<His>> jaw tightens. <<His>> hand snaps up between you, fingers spreading wide... and stops.
	<br><br>
	<<speechresolve>>
	<<if $speech_attitude_avery>>
		<<set _speechAttitudeResolved to "meek">>
	<</if>>
	<<if _speechAttitudeResolved is "meek">>
		You flinch back with a small, broken whimper, throwing your hands up to shield your face. "P-Please don't...!"
	<<elseif _speechAttitudeResolved is "shy">>
		You shrink away and squeeze your eyes shut, bracing for the blow.
	<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
		You go very still, holding your composure even as your breath catches in your throat.
	<<elseif _speechAttitudeResolved is "docile">>
		You lower your gaze and go quiet, waiting to accept whatever <<he>> decides.
	<<elseif _speechAttitudeResolved is "confident">>
		You don't flinch. You hold <<his>> gaze, steady, waiting to see what <<he>>'ll actually do.
	<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
		You lift your chin and glare right back, daring <<him>> to go through with it.
	<<else>>
		You tense, but stand your ground and meet <<his>> eyes.
	<</if>>
	<br><br>
	<<He>> freezes there for a few seconds. Then <<he>> clenches <<his>> hand and breathes out through <<his>> nose.
	Whatever was about to break in <<him>> drains away.<<lllarage>><<npcincr Avery rage -21>><<npcincr Avery love 1>>
	<br><br>
	<<if $bodysize gte 2>>
		Without a word, <<he>> steps in and hugs you into <<his>> arms, <<his>> chin coming to rest atop your head. <<He>> holds you a moment longer than you expect, then lets go and walks away in silence.
	<<else>>
		Without a word, <<he>> rests a hand atop your head and gives it two slow, careful pats. Then <<he>> turns and walks away in silence.
	<</if>>
	<br><br>
	<<link [[Next|$avery_passage]]>><<endevent>><</link>>
	<br>
<</widget>>