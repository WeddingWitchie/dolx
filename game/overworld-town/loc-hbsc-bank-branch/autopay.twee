/* The "away" standing orders (farm tower guard + gambling-ring upkeep) are
   settled once per week from weekPassed() in time.js, which calls
   setup.hbsc.runStandingOrders() just before xchangeWeeklyCheck(). */
:: HBSC Bank Standing Orders
<<effects>>
<<set _level to $hbsc.account.level>><<set _deposit to $hbsc.account.deposit>>

<<if _level < 1>>
	<<speechresolve>>
	"Can you set up automatic payments for me? Something that handles my regular bills?" you ask.
	<br><br>
	The teller gives an apologetic smile. "Standing orders are tied to a savings account, I'm afraid. Open one with us first and we can route your recurring payments straight from your balance."
	<br><br>
	<<hbscOptions>>
<<else>>
	<<speechresolve>>
	<<if ((_speechAttitudeResolved is "meek") or (_speechAttitudeResolved is "shy") or (_speechAttitudeResolved is "docile"))>>
		"Could you help me with regular weekly payments, please?" you ask quietly.
	<<elseif ((_speechAttitudeResolved is "polite") or (_speechAttitudeResolved is "flamboyant"))>>
		"I was wondering if you could help me set up some recurring payments?" you ask.
	<<elseif (_speechAttitudeResolved is "confident")>>
		"I want to set up automatic payments for my regular bills," you say.
	<<elseif ((_speechAttitudeResolved is "bratty") or (_speechAttitudeResolved is "cruel"))>>
		"Set up my regular payments so I don't have to deal with them," you say.
	<<else>>
		"Can you help me with weekly payments? The ones that keep coming back?" you ask.
	<</if>>
	<br><br>
	"Of course," the teller says brightly. "We call those <i>standing orders</i>. 
    You tell me which regular payments to cover, and whenever one falls due we draw it straight from your savings balance. No need to carry the cash or be there in person."
	<br><br>

	<<set _hbscCancelled to $hbsc.notices.filter(n => n and n.type is "autoPayCancelled")>>
	<<if _hbscCancelled.length > 0>>
		<div class="hbsc-brochure">
			<span class="red">Recently cancelled, due to insufficient savings:</span><br>
			<<for _i, _c range _hbscCancelled>>
				&bull; <<print _c.label>><br>
			<</for>>
		</div>
		<br>
		<<run $hbsc.notices = $hbsc.notices.filter(n => !(n and n.type is "autoPayCancelled"))>>
	<</if>>

	<div class="hbsc-brochure">
		<span class="gold">How a standing order works</span><br>
		&bull; The payment is taken from your savings balance.<br>
		&bull; It only goes through if your balance covers the full amount when it falls due.<br>
		&bull; If your savings can't cover it when it's due, the order is cancelled automatically.<br>
		&bull; You can switch any order on or off, free of charge.
	</div>
	<br>

	<span class="gold">Your savings balance:</span> <<printmoney _deposit>>
	<br><br>

	/* ---------------------------------------------------------------
	   AVAILABILITY GATE
       These are wired to the real save flags; adjust only if the build renames them.
	   --------------------------------------------------------------- */
	<<set _apAvail to {
		bailey:       (def $rentmoney and $rentmoney gt 0 and $tutorial isnot 0),
		farmGuard:    (def $farm and $farm.tower_guard),
		gamblingRing: (def $xchange and $xchange.pubGamblingEnabled)
	}>>

	<<set _anyShown to false>>
	<<for _i, _bill range setup.hbsc.AUTOPAY_BILLS>>
		<<if _apAvail[_bill.id]>>
			<<set _anyShown to true>>
			<<set _on to setup.hbsc.isAutoPayEnabled(_bill.id)>>
			<span class="teal"><<print _bill.label>></span>:
			<<if _on>><span class="green">On</span><<else>><span class="red">Off</span><</if>>
			<br>
			<i><<print _bill.blurb>></i>
			<br>
			<<capture _bill>>
				<<if _on>>
					<<link "Cancel this standing order" "HBSC Bank Standing Orders">><<run setup.hbsc.setAutoPay(_bill.id, false)>><</link>>
				<<else>>
					<<link "Set up this standing order" "HBSC Bank Standing Orders">><<run setup.hbsc.setAutoPay(_bill.id, true)>><</link>>
				<</if>>
			<</capture>>
			<br><br>
		<</if>>
	<</for>>

	<<if not _anyShown>>
		The teller checks the system. "It doesn't look like you have any regular payments we can take on right now. Come back if that changes."
		<br><br>
	<</if>>

	<<hbscOptions>>
<</if>>
