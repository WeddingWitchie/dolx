		<<saveNPC 0 "dice_npc_1">>
		<<saveNPC 1 "dice_npc_2">>
		<<saveNPC 2 "dice_npc_3">>
		<<endevent>>
		<<loadNPC 0 `"dice_npc_"+_lastNPC`>>
	<</link>>
	<br>

:: Pub Dice Minigame Kiss Resist
