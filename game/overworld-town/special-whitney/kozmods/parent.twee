:: Whitney's Parent Widgets [widget]

<<widget "police_sergeant">><<silently>>
	<<set _text_output to $per_npc.police_sergeant.name>>
<</silently>><span class="police"><<print _text_output>></span><</widget>>

<<widget "generatePoliceSergeant">>
	<<if _args[0]>>
		<<set $_id to _args[0]>>
	<<else>>
		<<set $_id to 0>>
	<</if>>

	<<if $per_npc.police_sergeant>>
		<<loadNPC $_id "police_sergeant">>
	<<else>>
		<<generateRole $_id 0 "police sergeant">>
		<<set $NPCList[$_id].name_known to 1>>
		<<saveNPC $_id "police_sergeant">>
	<</if>>
<</widget>>

<<widget "policeSergeantLove">>
	<<if Number.isFinite(_args[0])>>
		<<set $policeSergeantLove to Math.clamp(($policeSergeantLove || 0) + _args[0], -50, 200)>>
	<</if>>
<</widget>>