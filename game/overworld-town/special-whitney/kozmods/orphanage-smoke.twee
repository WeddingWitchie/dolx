:: PC Smoke
<<effects>>
<<if $whitney_smoke is undefined>><<set $whitney_smoke to 0>><</if>>
<<set $cigarettes -= 1>><<pass 5>><<wearProp "cigarette">>
<<switch $smokePlace>>
	<<case "eden">>
		You step around the side of the cabin and lean against the timber wall, keeping out of sight. Eden doesn't need to smell smoke on you.
	<<case "wolfcave">>
		You carefully make your way to the cave entrance and crouch on the cold stone. The pack watches from the darkness behind you, their eyes catching the light. You light a cigarette near the entrance, where the breeze carries the smoke outside.
	<<case "farm">>
		You walk to the edge of the field and lean on the fence, choosing a spot where Alex won't see you smoking.
	<<case "school">>
		You hide in the quiet corner of the rear courtyard and keep the cigarette low whenever you hear movement near the doors.
	<<case "park">>
		You sit at the quiet end of the park and lean back on the bench, watching people go by while you light up.
	<<default>>
		You find a quiet spot out of the way and light up.
<</switch>>
<br><br>
<<if $whitney_smoke lt 3>>
	You struggle to light it at first. Once it is burning, you try to take a small puff, but accidentally inhale too much smoke. Your throat reacts and you almost cough, but you stop yourself.
<<elseif $whitney_smoke lt 7>>
	You shield the lighter from the wind, light the cigarette, and take a puff. The smoke burns your throat a little, but the feeling passes quickly, so you take another puff.
<<else>>
	You light up, take the first drag, then settle where you are with the cigarette resting between your fingers.
<</if>>
<<smokeApply>>
<br><br>
<<if _smokeOutcome is "passout">>
	You light another cigarette almost immediately. Then the nicotine hits you hard. You become dizzy, start sweating, and your legs feel too weak to support you.
	<br><br>
	<span class="red">You've overdone it.</span><<gggstress>>
	<br><br>
	<<link [[Next|Loft Smoke Passout]]>><</link>>
	<br>
<<else>>
	<<switch $smokePlace>>
		<<case "eden">>
			You smoke down to the filter, press the stub under your heel, then scatter the ash so Eden is less likely to find it.
		<<case "wolfcave">>
			You finish the cigarette by the cave entrance and put the stub out against the stone before leaving it outside.
		<<case "farm">>
			You finish the cigarette and press the stub against the fence post until the ember dies, careful not to leave anything burning near the dry grass.
		<<case "school">>
			You finish quickly, put the stub out against the wall, then wave the last smoke away from your clothes before anyone comes outside.
		<<case "park">>
			You take your time finishing it, put the stub out, then drop it into the nearest bin on your way back.
		<<default>>
			You finish the cigarette and put the stub out before moving on.
	<</switch>>
	<br><br>
	<<if _smokeOutcome is "woozy">>
		Taking two so close together makes you feel dizzy and slightly sick. You're a bit less tired, but you still feel restless.
		<<gstress>><<ltiredness>><<ghallucinogens>>
	<<else>>
		By the last drag, your hands have stopped fidgeting. You're still tired, but you feel calmer and can think about something other than whatever was stressing you out.<<lstress>><<ltiredness>><<ghallucinogens>>
	<</if>>
	<br><br>
	<<if ($daily.cigarettesSmoked ?? 0) gte 5>>
		<span class="blue">That's five today. Any more and your chest would punish you for it; you've had enough.</span>
		<br>
	<<elseif $cigarettes gte 1>>
		<<smokeicon>><<link [[Light another|PC Smoke]]>><</link>> | <span class="gold">(<<= $cigarettes>> left)</span>
		<br>
	<<else>>
		<span class="blue">That was your last one.</span>
		<br>
	<</if>>
	<<getouticon>><<link "Stub it out and move on" $smokeReturn>><</link>>
	<br>
<</if>>

:: Widgets Smoke [widget]
<<widget "loftSmokeCaption">>
	<<if $cigaretteAddiction and ($timeSinceCigarette ?? 0) gte 1440>>
		<div id="loftSmokeCaption" @title="'No cigarette in ' + Math.floor(($timeSinceCigarette ?? 0) / 60) + 'h'">
			<span class="pink">You crave a cigarette.</span>
		</div>
	<</if>>
<</widget>>

/* Shared dependence tracker for every smoking route. Kept separate from smokeApply because Whitney's scenes provide their own immediate stat effects. */
<<widget "smokeDependence">>
	<<set $timeSinceCigarette to 0>>
	<<if !$cigaretteAddiction>>
		<<set $cigaretteAddictionProgress to Math.clamp((Number($cigaretteAddictionProgress) || 0) + 1, 0, 20)>>
		<<if $cigaretteAddictionProgress gte 20>><<set $cigaretteAddiction to true>><</if>>
	<</if>>
<</widget>>

/* Shared smoking mechanic: chain (back-to-back under an hour), daily cap counter, addiction, and the resulting effects.
   Sets _smokeOutcome to "passout" / "woozy" / "calm" for the calling passage to narrate.
   Used by the loft flow and every quick-smoke spot so the numbers stay identical. */
<<widget "smokeApply">>
	<<if $whitney_smoke is undefined>><<set $whitney_smoke to 0>><</if>>
	<<if ($timeSinceCigarette ?? 999) lt 60>>
		<<set $cigaretteChain to ($cigaretteChain ?? 0) + 1>>
	<<else>>
		<<set $cigaretteChain to 1>>
	<</if>>
	<<smokeDependence>>
	<<set $daily.cigarettesSmoked to ($daily.cigarettesSmoked ?? 0) + 1>>
	<<if $cigaretteChain gte 3>>
		<<set _smokeOutcome to "passout">><<stress 20>>
	<<elseif $cigaretteChain is 2>>
		<<set _smokeOutcome to "woozy">><<hallucinogen 20>><<stress 6>><<tiredness -3>>
	<<else>>
		<<set _smokeOutcome to "calm">><<hallucinogen 20>><<stress -8>><<tiredness -3>>
	<</if>>
<</widget>>

/* Gated "smoke here" link for non-loft spots. _args[0] = place key, _args[1] = return passage. */
<<widget "smokeHere">>
	<<if ($whitney_smoke gte 1 or $loft_whitney gte 1) and $cigarettes gte 1 and ($daily.cigarettesSmoked ?? 0) lt 5 and !(playerIsPregnant() and playerAwareTheyArePregnant())>>
		<<set _sp to _args[0]>><<set _sr to _args[1]>>
		<<capture _sp, _sr>>
			<<smokeicon>><<link [[Smoke a cigarette|PC Smoke]]>><<set $smokePlace to _sp>><<set $smokeReturn to _sr>><</link>> | <span class="gold">(<<= $cigarettes>> left)</span>
		<</capture>>
		<br>
	<</if>>
<</widget>>
