:: Bike Depot Lock

<<set $outside to 0>><<effects>><<set $lock to 300>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		You think you'd be able to pick the lock, <span class="blue">if your arms weren't bound.</span>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">The lock looks easy to pick.</span>
		<br><br>

		<<lockicon "pick">><<link [[Pick it (0:10)|Bike Depot]]>><<pass 10>><<crimeUp 5 "trespassing">><</link>><<crime "trespassing">>
	<</if>>
	<br>
<<else>>
	<span class="red">The lock looks beyond your ability to pick.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>
<<getouticon>><<link [[Leave|Shopping Centre]]>><</link>>

:: Bike Depot
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

You are in the Bike Depot. It has a quite the stock of bikes.
<br><br>
<<if $phase is 5>>
	You purchase a repair kit, making your current carried amount <span class="yellow"><<print $bicycle.durability.repair>></span>. You <<if $bicycle.durability.repair lt 5>>think you can carry <<print (5 - $bicycle.durability.repair)>><<else>> can't carry<</if>> more.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 4>>
	<<set _repairAmount to Math.round($bicycle.durability.max / 4)>>
	<<set $bicycle.durability.current to Math.min($bicycle.durability.current + _repairAmount, $bicycle.durability.max)>>
	Your bike has been given a tune-up, restoring _repairAmount minutes of usage time.
	<br><br>
	<<set $phase to 0>><<unset _repairAmount>>
<<elseif $phase is 3>>
	Your high-end bike has been purchased and put outside of the shopping centre.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 2>>
	Your intermediate bike has been purchased and put outside of the shopping centre.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 1>>
	Your basic bike has been purchased and put outside of the shopping centre.
	<br><br>
	<<set $phase to 0>>
<</if>>

<<if Time.dayState is "night">>
	You are alone in the darkness.
	<br><br>
<<elseif $exposed gte 1>>
	You hide behind a rack of bikes to protect your dignity.
	<br><br>
<</if>>

<<if $stress gte $stressmax>>
	<<passoutshop>>
<<else>>
	<<if Time.hour is 21>>
		It's closing time. Security is herding everyone outside.
		<<if $exposed gte 1>>
			Panic swells within you as you realise how embarrassed you'll be should security find you exposed like this.
		<</if>>
		<br><br>
		<<if $exposed lte 0>>
			<<highicon>><<link [[Go outside|High Street]]>><</link>>
			<br>
		<<else>>
			<<ind>><<link [["Hide until it's over (1:00)"|Bike Depot]]>><<pass 1 hour>><</link>>
		<</if>>
	<<else>>
		<<if Time.dayState is "night" and Time.hour isnot 21 and !$weekly.theft.bikeDepot>>
			<<shopicon "register">><<link [[Examine the cash register|Bike Depot Register]]>><</link>>
			<br><br>
		<</if>>
		<<if $exposed lte 0 and Time.dayState is "night" and Time.hour isnot 21>>
			You could leave money for a bike before taking it.
			<br><br>
			<<if !$bicycle.own or $bicycle.quality lt 3>>
				<<bikeDepotTrespassPayment "a high-end bike" 250000 3 4800>>
			<<else>>
				<span class="black">You already have a high-end bike.</span>
				<br>
			<</if>>
			<<if !$bicycle.own or $bicycle.quality lt 2>>
				<<bikeDepotTrespassPayment "an intermediate bike" 100000 2 2400>>
			<<elseif $bicycle.quality is 2>>
				<span class="black">You already have an intermediate bike.</span>
				<br>
			<</if>>
			<<if !$bicycle.own>>
				<<bikeDepotTrespassPayment "a basic bike" 50000 1 800>>
			<<elseif $bicycle.quality is 1>>
				<span class="black">You already have a basic bike.</span>
				<br>
			<</if>>
			<br>
		<<elseif $exposed lte 0 and Time.dayState isnot "night" and Time.hour isnot 21>>
			<<if !$bicycle.own or $bicycle.quality lt 3>>
				<<if $money gte (setup.inflation ? setup.inflation.price(250000) : 250000)>>
					<<bikeicon>><<link [[Purchase a high-end bike (<<printprice 250000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 3>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 3>><<set $bicycle.durability.current to 4800>><<set $bicycle.durability.max to 4800>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -250000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">You don't have <<printprice 250000>> to purchase a high-end bike.</span>
				<</if>>
				<br>
			<<else>>
				<span class="black">You already have a high-end bike.</span>
				<br>
			<</if>>
			<<if !$bicycle.own or $bicycle.quality lt 2>>
				<<if $money gte (setup.inflation ? setup.inflation.price(100000) : 100000)>>
					<<bikeicon>><<link [[Purchase an intermediate bike (<<printprice 100000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 2>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 2>><<set $bicycle.durability.current to 2400>><<set $bicycle.durability.max to 2400>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -100000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">You don't have <<printprice 100000>> to purchase an intermediate bike.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 2>>
				<span class="black">You already have an intermediate bike.</span>
				<br>
			<</if>>
			<<if !$bicycle.own>>
				<<if $money gte (setup.inflation ? setup.inflation.price(50000) : 50000)>>
					<<bikeicon>><<link [[Purchase a basic bike (<<printprice 50000>> 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 1>><<set $bicycle.own to true>><<set $bicycle.stolen to false>><<set $bicycle.quality to 1>><<set $bicycle.durability.current to 800>><<set $bicycle.durability.max to 800>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -50000 "bikeDepot">><</link>>
				<<else>>
					<span class="red">You don't have <<printprice 50000>> to purchase a basic bike.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 1>>
				<span class="black">You already have a basic bike.</span>
				<br>
			<</if>>
			<<if $bicycle.theftEnabled && $bicycle.security lt 0.99>>
				<<bikeicon>><<link [[Browse through the security gear (0:05)|Bike Depot Security Gear]]>><<pass 5>><</link>>
				<br>
			<</if>>
			<<if ($bicycle.own && ($bicycle.durability.current lt $bicycle.durability.max))>>
				<<if $bicycle.durability.repair is undefined>><<generate1>><<person1>>
					<<if currentSkillValue('skulduggery') gte 600 || currentSkillValue('science') gte 600>>
						<<set $bicycle.durability.repair to 1>>
						<br>
						The employee lingering at the register studies you and your beat up bike for a moment.
						<br><br>
						"You look like you might know your way around a tool or two. How about I sell you some kits so you can make small repairs yourself whenever you need them?"
						<br><br>
						<<He>> hands you a small bundle before you can respond, "Here's a freebie on the house. Don't waste it."
						<br><br>
						<span class="blue">The employees recognize your skill and have decided selling tools to you wouldn't be the biggest mistake in the world. Don't make them regret it.</span>
						<br><br>
					<<else>>
						<br>
						The <<personsimple>> lingering at the register studies you and your beat up bike for a moment.
						<br><br>
						<<He>> appears unimpressed and continues working. <span class="blue">You might impress if you knew more about science, or were more deft with your hands.</span>
					<</if>>
					<br><br>
					<<endevent>>
				<</if>>
				<<if $money gte (setup.inflation ? setup.inflation.price(35000) : 35000)>>
					<<bikeicon>><<link [[Repair your bike (<<printprice 35000>> 0:20)|Bike Depot]]>><<pass 20>><<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">><<money -35000 "bikeDepot">><<set $phase to 4>><</link>>
				<<else>>
					<span class="red">You don't have <<printprice 35000>> to repair your bike.</span>
				<</if>>
			<</if>>
			<<if $bicycle.durability.repair isnot undefined>>
				<br>
				<<if $bicycle.durability.repair lt 5>>
					<<if $money gte (setup.inflation ? setup.inflation.price(5000) : 5000)>>
						<<birdicon "tools">><<link [[Purchase a repair kit (<<printprice 5000>> 0:05)|Bike Depot]]>><<pass 5>><<money -5000 "bikeDepot">><<set $bicycle.durability.repair++>><<set $phase to 5>><</link>>
					<<else>>
						<span class="red">You don't have <<printprice 5000>> to buy a repair kit.</span>
					<</if>>
					<br>
				<</if>>
			<</if>>
			<br>
		<</if>>
		<br>
		<<getouticon>><<link [[Leave|Shopping Centre]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Bike Depot Security Gear
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

You browse through the selection of security gears.
<br><br>

<<if $bicycle.security lt 0.99>>
	<<if $money gte (setup.inflation ? setup.inflation.price(100000) : 100000)>>
		<<link [[Purchase U-Lock with Alarm (<<printprice 100000>>)|Bike Depot]]>><<money -100000 "bikeDepot">><<set $bicycle.security to 0.99>><</link>><<note "99% theft prevention">>
	<<else>>
		<span class="red">You don't have <<printprice 100000>> to purchase a U-Lock with Alarm.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.99>>
	You already have a U-Lock with Alarm.
	<br>
<</if>>
<<if $bicycle.security lt 0.8>>
	<<if $money gte (setup.inflation ? setup.inflation.price(75000) : 75000)>>
		<<link [[Purchase U-Lock (<<printprice 75000>>)|Bike Depot]]>><<money -75000 "bikeDepot">><<set $bicycle.security to 0.8>><</link>><<note "80% theft prevention">>
	<<else>>
		<span class="red">You don't have <<printprice 75000>> to purchase a U-Lock.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.8>>
	You already have a U-Lock.
	<br>
<</if>>
<<if $bicycle.security lt 0.5>>
	<<if $money gte (setup.inflation ? setup.inflation.price(50000) : 50000)>>
		<<link [[Purchase Heavy-Duty Chain Lock with Hardened Steel (<<printprice 50000>>)|Bike Depot]]>><<money -50000 "bikeDepot">><<set $bicycle.security to 0.5>><</link>><<note "50% theft prevention">>
	<<else>>
		<span class="red">You don't have <<printprice 50000>> to purchase a heavy-duty chain lock with hardnened steel.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.5>>
	You already have a Heavy-Duty Chain Lock with Hardened Steel.
	<br>
<</if>>
<<if $bicycle.security lt 0.3>>
	<<if $money gte (setup.inflation ? setup.inflation.price(25000) : 25000)>>
		<<link [[Purchase Standard Chain Lock (<<printprice 25000>>)|Bike Depot]]>><<money -25000 "bikeDepot">><<set $bicycle.security to 0.3>><</link>><<note "30% theft prevention">>
	<<else>>
		<span class="red">You don't have <<printprice 25000>> to purchase a standard chain lock.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.3>>
	You already have a Standard Chain Lock.
	<br>
<</if>>
<<if $bicycle.security lt 0.1>>
	<<if $money gte (setup.inflation ? setup.inflation.price(10000) : 10000)>>
		<<link [[Purchase Wheel Lock (<<printprice 10000>>)|Bike Depot]]>><<money -10000 "bikeDepot">><<set $bicycle.security to 0.1>><</link>><<note "10% theft prevention">>
	<<else>>
		<span class="red">You don't have <<printprice 10000>> to purchase a wheel lock.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.1>>
	You already have a Wheel Lock.
	<br>
<</if>>
<br>
<<getouticon>><<link [[Back|Bike Depot]]>><</link>>

<<widget "bikeDepotTrespassPayment">>
	<<set _bikeName to _args[0]>>
	<<set _bikePrice to _args[1]>>
	<<set _bikeLevel to _args[2]>>
	<<set _bikeDurability to _args[3]>>
	<<set _bikeCost to (setup.inflation ? setup.inflation.price(_bikePrice) : _bikePrice)>>
	<<set _bikeExtraBase to Math.ceil(_bikePrice * 1.25)>>
	<<set _bikeExtraCost to (setup.inflation ? setup.inflation.price(_bikeExtraBase) : _bikeExtraBase)>>
	<<if $money gte _bikeCost>>
		<<bikeicon>><<link [["Leave exact change for " + _bikeName + " (0:05)"|Shop Trespass Payment Result]]>>
			<<pass 5>>
			<<set $phase to _bikeLevel>>
			<<set $bicycle.own to true>><<set $bicycle.stolen to false>>
			<<set $bicycle.quality to _bikeLevel>>
			<<set $bicycle.durability.current to _bikeDurability>><<set $bicycle.durability.max to _bikeDurability>>
			<<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">>
			<<shopTrespassPayment _bikePrice "bikeDepot" false "Bike Depot" _bikeName>>
		<</link>><<crime "trespassing">>
	<<else>>
		<span class="red">You don't have enough to leave exact change for _bikeName.</span>
	<</if>>
	<br>
	<<if $money gte _bikeExtraCost>>
		<<bikeicon>><<link [["Leave extra for " + _bikeName + " (0:05)"|Shop Trespass Payment Result]]>>
			<<pass 5>>
			<<set $phase to _bikeLevel>>
			<<set $bicycle.own to true>><<set $bicycle.stolen to false>>
			<<set $bicycle.quality to _bikeLevel>>
			<<set $bicycle.durability.current to _bikeDurability>><<set $bicycle.durability.max to _bikeDurability>>
			<<set $bicycle.location to "high">><<set $bicycle.locationRegion to "commercial">>
			<<shopTrespassPayment _bikePrice "bikeDepot" true "Bike Depot" _bikeName>>
		<</link>><<crime "trespassing">>
		<br>
	<</if>>
<</widget>>
