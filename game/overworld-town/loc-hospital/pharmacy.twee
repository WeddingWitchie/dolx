		<br>
		<<pillicon "xchangeBlue">><<link [[X-Change Hyper Fertility|Pharmacy Sale]]>><<set $pharmacyItem to clone(setup.pharmacyItems["xchange_blue_bull"])>><<set $pharmacyItem.name to "X-Change Blue Hyper Fertility">><<set $pharmacyItem.type to "X-Change Blue Hyper Fertility">><</link>>
		<br>
		<<pillicon "xchangeBlue">><<link [[X-Change Innocence|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_blue_innocence"]>><</link>>
