	<br>
	<<pillicon "breastReduce">><<link [[Pack of 14 breast reduction|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["breast_reduction"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["breast reduction"].owned>></span>
	<br>
	<<pillicon "breastEnlarge">><<link [[Pack of 14 breast growth|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["breast_growth"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["breast growth"].owned>></span>
	<br>
	<<pillicon "breastBlock">><<link [[Pack of 14 breast growth blocker|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["breast_blocker"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["breast blocker"].owned>></span>
	<br><br>

	Butt Enhancement Pills:
	<br>
	<<pillicon "bottomReduce">><<link [[Pack of 14 butt reduction|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["bottom_reduction"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["bottom reduction"].owned>></span>
	<br>
	<<pillicon "bottomEnlarge">><<link [[Pack of 14 butt growth|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["bottom_growth"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["bottom growth"].owned>></span>
	<br>
