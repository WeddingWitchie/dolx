		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple Xtra Strength|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_xtra"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple Continue|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_continue"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple Resistance|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_resistance"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple Breeder|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_breeder"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple Bull|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_bull"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Hyper Fertility|Pharmacy Sale]]>><<set $pharmacyItem to clone(setup.pharmacyItems["xchange_purple_breeder"])>><<set $pharmacyItem.name to "X-Change Purple Hyper Fertility">><<set $pharmacyItem.type to "X-Change Purple Hyper Fertility">><</link>>
		<br><br>
	<<elseif $pharmacyXChangeView is "support">>
		See other variants: <<link [[Gray|Pharmacy]]>><<set $pharmacyXChangeView to "gray">><</link>> | <<link [[Pink|Pharmacy]]>><<set $pharmacyXChangeView to "pink">><</link>> | <<link [[Blue|Pharmacy]]>><<set $pharmacyXChangeView to "blue">><</link>> | <<link [[Purple|Pharmacy]]>><<set $pharmacyXChangeView to "purple">><</link>>
		<br>
		<<pillicon "pillcure">><<link [[X-Change Antidote|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_antidote"]>><</link>>
		<br>
		<<pillicon "pillcure">><<link [[X-Change Antidote Forte|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_antidote_forte"]>><</link>>
		<br>
		<<pregnancytesticon>><<link [[X-Change Test|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_test"]>><</link>>
		<br><br>
	<<elseif $pharmacyXChangeView is "gray">>
		<<run setup.ensureGrayPharmacyItems()>>
		See other variants: <<link [[Pink|Pharmacy]]>><<set $pharmacyXChangeView to "pink">><</link>> | <<link [[Blue|Pharmacy]]>><<set $pharmacyXChangeView to "blue">><</link>> | <<link [[Purple|Pharmacy]]>><<set $pharmacyXChangeView to "purple">><</link>> | <<link [[Antidotes & Tests|Pharmacy]]>><<set $pharmacyXChangeView to "support">><</link>>
		<br>
		<<pillicon "xchangeGray">><<link [[X-Change Resistance|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to setup.pharmacyItems["xchange_gray_resistance"]>><</link>>
		<br>
		<<pillicon "xchangeGray">><<link [[X-Change Continue|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to setup.pharmacyItems["xchange_gray_continue"]>><</link>>
		<br>
		<<pillicon "xchangeGray">><<link [[X-Change Weekly Extension|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to setup.pharmacyItems["xchange_gray_extension"]>><</link>>
		<br><br>
		/* Weekly picks built in plain JS (dense array; also self-heals a corrupt stored value such as the old sparse "[empty x 2]"). */
		<<run (function () {
			var w = State.variables.weekly; var cur = w.pharmacyGrayStock; var valid = Array.isArray(cur) && cur.filter(function (k) { return typeof k === "string"; }).length === 2; if (valid) { return; }
			var pool = ["xchange_gray_breeder", "xchange_gray_bull", "xchange_gray_hyper_fertility", "xchange_gray_fertility", "xchange_gray_xtend"];
			for (var i = pool.length - 1; i > 0; i--) {var j = Math.floor(Math.random() * (i + 1)); var t = pool[i]; pool[i] = pool[j]; pool[j] = t;}
			w.pharmacyGrayStock = [pool[0], pool[1]];
		})()>>
		This week's special stock:
		<br>
		<<for _grayKey range $weekly.pharmacyGrayStock>>
			<<set _grayLabel to setup.pharmacyItems[_grayKey].name>>
			<<capture _grayKey _grayLabel>>
				<<pillicon "xchangeGray">><<link _grayLabel "Pharmacy Sale">><<set $phase2 to "pills">><<set $pharmacyItem to setup.pharmacyItems[_grayKey]>><</link>>
				<br>
			<</capture>>
		<</for>>
		<<socialiseicon "ask">><<link [[Ask why the gray selection is so limited|Pharmacy Gray Ask]]>><</link>>
		<br><br>
	<</if>>

	Under Trials:
	<br>
	<<pillicon "premium">><<link [[X-Change Clone: Whitney|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_clone_whitney"]>><</link>><br>
	<br>

	<<if $player.penisExist>>
		Penis Enhancement Pills:
		<br>
		<<pillicon "penisReduce">><<link [[Pack of 14 penis reduction|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["penis_reduction"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["penis reduction"].owned>></span>
		<br>
		<<pillicon "penisEnlarge">><<link [[Pack of 14 penis growth|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["penis_growth"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["penis growth"].owned>></span>
		<br>
		<<pillicon "penisBlock">><<link [[Pack of 14 penis growth blocker|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["penis_blocker"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["penis blocker"].owned>></span>
		<br><br>
	<</if>>

