		<br>
		<<pillicon "xchangePurple">><<link [[Pack of 3 X-Change Purple Basics|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_basic"]>><</link>>
		<br>
		<<pillicon "xchangePurple">><<link [[X-Change Purple NOW|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_purple_now"]>><</link>>
