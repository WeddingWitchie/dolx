	<br><br>

	Parasite Prevention:
	<br>
	<<procedureicon "parasite">><<link [[Tube of anti-parasite cream|Pharmacy Sale]]>><<set $phase2 to "parasite cream">><<set $pharmacyItem to clone(setup.pharmacyItems["Anti-Parasite Cream"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["Anti-Parasite Cream"].owned>></span>
	<br><br>

	Personal Care:
	<br>
	<<schoolicon "infirmary">><<link [[Pack of 14 painkillers|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["painkillers"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills.painkillers?.owned || 0>></span>
	<br>
	<<pillicon "pill">><<link [[Pack of 14 anti-anxiety tablets|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems.calmoryl)>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["anti-anxiety tablets"]?.owned || 0>></span>
	<br>
	<<icon "sharks-teeth.png">><<link [[Pack of 14 sleeping pills|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems.sleeping_pills)>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["sleeping pills"]?.owned || 0>></span>
	<br>
	<<icon "cream.png">><<link [[Buy sensitivity cream|Pharmacy Sensitivity Cream]]>><</link>>
	<br>
	<<icon "hairgel.png">><<link [[Tube of lube|Pharmacy Sale]]>><<set $phase2 to "hairgel">><<set $pharmacyItem to clone(setup.pharmacyItems["lube_tube"])>><</link>> | Owned: <span class="gold"><<= $player.inventory.sextoys["lube tube"]?.length || 0>></span>
	<br><br>

	<<if $prescriptions and ($prescriptions.painkiller or $prescriptions.sleep or $prescriptions.antidepressant)>>
		Prescription Counter:
		<br>
		<<if $prescriptions.painkiller>>
			<<if $prescriptions.collected.painkiller>>
				<<ind>><span class="blue">You've collected the painkillers on this prescription.</span>
				<br>
			<<else>>
				<<schoolicon "infirmary">><<link [[Collect your painkillers|Pharmacy Prescription Collect]]>><<set $prescriptionCollect to "painkiller">><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["prescription painkillers"]?.owned || 0>></span>
				<br>
			<</if>>
			<<ind>><span class="gold">Painkiller prescription: <<= prescriptionDaysLeft("painkiller")>> day<<if prescriptionDaysLeft("painkiller") isnot 1>>s<</if>> left.</span>
			<br>
		<</if>>
		<<if $prescriptions.sleep>>
			<<if $prescriptions.collected.sleep>>
				<<ind>><span class="blue">You've collected the sleeping pills on this prescription.</span>
				<br>
			<<else>>
				<<icon "pill-strong.png">><<link [[Collect your sleeping pills|Pharmacy Prescription Collect]]>><<set $prescriptionCollect to "sleep">><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["prescription sleeping pills"]?.owned || 0>></span>
				<br>
			<</if>>
			<<ind>><span class="gold">Sleeping pill prescription: <<= prescriptionDaysLeft("sleep")>> day<<if prescriptionDaysLeft("sleep") isnot 1>>s<</if>> left.</span>
			<br>
		<</if>>
		<<if $prescriptions.antidepressant>>
			<<if $prescriptions.collected.antidepressant>>
				<<ind>><span class="blue">You've collected Doctor Harper's prescription with the antidepressant added.</span>
				<br>
			<<else>>
				<<pillicon "pill">><<link [[Collect your antidepressant prescription|Pharmacy Prescription Collect]]>><<set $prescriptionCollect to "antidepressant">><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["Dr Harper's prescription"]?.owned || 0>></span>
				<br>
			<</if>>
			<<ind>><span class="gold">Antidepressant prescription: <<= prescriptionDaysLeft("antidepressant")>> day<<if prescriptionDaysLeft("antidepressant") isnot 1>>s<</if>> left.</span>
			<br>
		<</if>>
		<br>
	<</if>>

	Family Planning:
	<br>
	<<sextoysicon "pump">><<link [[Breast pump|Pharmacy Sale]]>><<set $phase2 to "breast pump">><<set $pharmacyItem to clone(setup.pharmacyItems["breast_pump"])>><</link>> | Owned: <span class="gold"><<= $player.inventory.sextoys["breast pump"]?.length || 0>></span>
	<br>
	<<pregnancytesticon>><<link [[Pack of 2 pregnancy tests|Pharmacy Sale]]>><<unset $phase2>><<set $pharmacyItem to clone(setup.pharmacyItems["pregnancy_test"])>><</link>> | Owned: <span class="gold"><<= $pregnancyTest || 0>></span>
	<br>
	<<pillicon "fertility">><<link [[Pack of 14 fertility pills|Pharmacy Sale]]>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["fertility_pills"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["fertility booster"].owned>></span>
	<br><br>

	Contraceptives:
	<br>
	<<if $brothelVending and $brothelVending.status is "set" and $brothelVending.products % 2 and $brothelVending.condomsToRefill gte 10 and $settings.condomLevel gte 1>>
		<<condomicon>><<link [[Buy condoms for the brothel (0:10)|Pharmacy Buy Condoms in Bulk]]>><<unset $phase2>><<pass 10>><</link>>
		<br>
	<</if>>
	<<if $settings.condomLevel gte 1>>
		<<condomicon>><<link [[Pack of 3 condoms|Pharmacy Sale]]>><<set $phase2 to "condom">><<set $pharmacyItem to clone(setup.pharmacyItems["condoms"])>><</link>> | Owned: <span class="gold"><<= $condoms || 0>></span>
		<br>
	<</if>>
	<<pillicon "contraceptive">><<link [[Pack of 14 contraceptive pills|Pharmacy Sale]]>><<unset $phase2>><<set $phase2 to "pills">><<set $pharmacyItem to clone(setup.pharmacyItems["contraceptive_pills"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["contraceptive"].owned>></span>
	<br>
	<<pillicon "morningAfter">><<link [[Ask for the morning-after-pill|Pharmacy Morning After pill]]>><<unset $phase2>><<set $pharmacyItem to clone(setup.pharmacyItems["Morning_After_pill"])>><</link>>
	<br><br>

	Contacts:
	<br>
	<<cosmeticsicon "contacts">><<link [[Take a look at the contact lenses display|Pharmacy Lenses]]>><<unset $phase2>><</link>>
	<<if !($daily.pharm.impatient gte 3) and $lenses_ordered.length gt 0>>
		<br>
		<<cosmeticsicon "contacts">><<link [[Ask if your custom contact lenses arrived|Pharmacy Ask If Lenses Delivered]]>><<unset $phase2>><</link>>
	<</if>>
	<br><br>
	<<getouticon>><<link [[Return to foyer|Hospital Foyer]]>><<endevent>><<unset $pharmacyXChangeView>><</link>>
<</if>>

:: Pharmacy Lenses
An assortment of colourful contact lenses is displayed behind the glass. You can purchase lenses to change the colour of your eyes.
<<if $makeup.owned.eyelenses.length + $makeup.owned.custom_eyelenses.length gt 0>>
	<br>
	You already own lenses of the following colours:
	<span style="display: inline-block;">
	<<set _lenses to []>>
	<<run $makeup.owned.eyelenses.forEach(colour => {
		const colourClass = colour.replace(/ /g, '-')
		_lenses.push(`<span @class="'eye-${colourClass}'"><span class="left-iris" style="color:#6E4E11;">${colour}</span></span>`);
	})>>
	<<if ($makeup.owned.custom_eyelenses.length gt 0)>>
		<<set _uniqueCustomLenses to [...new Set($makeup.owned.custom_eyelenses)]>> /* Filter out non-unique lenses */
		<<run _uniqueCustomLenses.forEach(lens => {
			const colour = window.colorNameTranslate(lens, "spaced name");
			const colourClass = nullable(nullable($custom_eyecolours.find(c => c.name is colour)).canvasfilter).blend; /* nullable fix to be removed when we can use ?. again */
			if (colourClass){
				_lenses.push(`<span class="eye-custom"><span @style="'color:${colourClass}'">${colour}</span></span>`);
			}
		})>>
	<</if>>

	<<print _lenses.join(", ")>>. /* Print the list */
	</span>
<</if>>
<br><br>

<<set _availableColours = ["dark blue", "light blue", "purple", "hazel", "amber", "green", "light green", "lime green", "grey", "light grey", "red", "pink", "brown", "black"].filter(x => !$makeup.owned.eyelenses.includes(x))>>
<<if _availableColours.length == 0>>
	You have collected all available colours of contact lenses. There's nothing left for you to buy.
	<br><br>
<<else>>
	Each pair of lenses costs <<printprice 20000>>.
	<br>
	<<set _lensChoice = _availableColours[0]>>
	<<for _i, _colour range _availableColours>>
		<label><span @class="'eye-' + _colour.replace(/ /g, '-')"><span class="colour-eye" style="color:#6E4E11;">_colour</span></span>&nbsp;<<print '<<radiobutton "_lensChoice" "'+_colour+'" ' + (_lensChoice is _colour ? "checked" : "") + '>>'>></label> |
	<</for>>

	<br><br>

	<<if setup.inflation.canAfford(20000, "pharmacyContacts")>>
		<<link [[Buy and send home|Pharmacy Lenses]]>><<money -20000 "pharmacyContacts">><<set $makeup.owned.eyelenses.push(_lensChoice)>><</link>>
		<br>
		<<link [[Buy and wear|Pharmacy]]>><<money -20000 "pharmacyContacts">><<set $makeup.owned.eyelenses.push(_lensChoice)>><<set $makeup.eyelenses = {"left":_lensChoice, "right":_lensChoice}>><</link>>
		<br>
	<<else>>
		<span class="purple">You can't afford the purchase.</span>
		<br>
	<</if>>
<</if>>
<<link [[Ask for custom-coloured contact ones|Pharmacy Ask Custom Lenses]]>><</link>>
<br>
<<link [[Go back|Pharmacy]]>><</link>>

:: Pharmacy Ask Custom Lenses
<<if $daily.pharm.impatient gt 2>>
	"Who do we have here," says the nurse, a rictus on <<his>> face. "Get out, you wasted enough of my time already. Try again tomorrow if you're done with your little game."
	<br><br><<getouticon>><<link [[Leave|Pharmacy Lenses]]>><</link>>
<<else>>
	<<if $custom_lenses_already_ordered is 1>>
		"I hope the ones you ordered last time please you," the nurse says. "You know the prices, <<printprice 45000>> for the product, plus <<printprice 5000>> for the delivery. <<printprice 95000>> total if you pick two different colours for each eye."
	<<else>>
		"Not pleased with the ones available?" the nurse asks.
		"I could place an order for ones with a colour of your choosing, but this will double the cost. Count about <<printprice 45000>> for the product, plus <<printprice 5000>> for the delivery which takes about a day. If you wish to choose two different colours for each eye, it will be <<printprice 95000>> total."
	<</if>>
	<br><br>
	<<if setup.inflation.canAfford(50000, "pharmacyContacts")>>
		<<ind>><<link [[Choose your custom colour|Pharmacy Select Custom Lenses]]>><<set $pharmacy_order_colours to 1>><</link>>
		<br>
	<<else>>
		<span class="purple">You can't afford the purchase.</span>
		<br>
	<</if>>
	<<if setup.inflation.canAfford(95000, "pharmacyContacts")>>
		<<ind>><<link [[Choose a different colour for each eye|Pharmacy Select Custom Lenses]]>><<set $pharmacy_order_colours to 2>><</link>>
		<br>
	<<elseif setup.inflation.canAfford(50000, "pharmacyContacts")>>
		<span style="color:#566a9b; cursor:pointer">Choose a different colour for each eye</span> <span class="purple">You can't afford the purchase.</span>
		<br>
	<</if>>
	<<getouticon>><<link [[Go back|Pharmacy Lenses]]>><</link>>
<</if>>

:: Pharmacy Select Custom Lenses
"Here," <<he>> says, handing you a tablet. "You can use the colour palette to help you. Pick any colour you like and I'll place the order for you."
<br><br><br>
<<if $pharmacy_order_colours is 2>>
	<div style="display:inline-block; text-align:center; margin-right:2em; vertical-align:top;">
		Left eye
		<div id="picker0"></div>
	</div>
	<div style="display:inline-block; text-align:center; vertical-align:top;">
		Right eye
		<div id="picker1"></div>
	</div>
<<else>>
	<div id="picker0"></div>
<</if>>
<<set _color_lenses_temp>> <!-- used inside colorWheelContactLenses() -->
<<run colorWheelContactLenses()>>
<br><br>
<<link [[Order it|Pharmacy Order Custom Lenses]]>>
	<<money -50000 "pharmacyContacts">>
	<<set $custom_lenses_already_ordered to 1>>
	<<run $lenses_ordered.push([window.colorNamer(_color_lenses_temp[0].hexString), Time.monthDay.toString() + Time.month + Time.year.toString(), [_color_lenses_temp[0].hexString, _color_lenses_temp[0].hsl["l"] / 500]])>>
	<<if $pharmacy_order_colours is 2>>
		<<money -45000 "pharmacyContacts">>
		<<run $lenses_ordered.push([window.colorNamer(_color_lenses_temp[1].hexString), Time.monthDay.toString() + Time.month + Time.year.toString(), [_color_lenses_temp[1].hexString, _color_lenses_temp[1].hsl["l"] / 500]])>>
	<</if>>
<</link>>
<br>
<<link [[Go back|Pharmacy]]>><</link>>

:: Pharmacy Order Custom Lenses
"Here is your receipt," the nurse adds, handing you the ticket. "It's likely to arrive by tomorrow, you come back anytime with your receipt and whoever is on duty that day will hand it over to you."
<br><br>
<<link [[Next|Pharmacy]]>><</link>>

:: Pharmacy Ask If Lenses Delivered
<<if $daily.pharm.impatient is 1>>
	"Hello how can I he—" <<He>> frowns. "Don't you think I forgot last time. It's not cool; you can't just send me looking for your package and just leave. Don't do that again, please."
	<br>You apologise, and <<he>> then goes to check if your package arrived.
<<elseif $daily.pharm.impatient is 2>>
	"Who do we have here?" says the nurse, a rictus on <<his>> face. "Get out, you wasted enough of my time already. Try again tomorrow if you're done with your little game."
	<<set $daily.pharm.impatient to 3>>
<<else>>
	"How can I h—" <<He>> stops. "Oh, you're the one who ordered the contact lenses. Hold on a second sweetheart, I'll check if we received them already." You watch as <<he>> disappears in a back room.
<</if>>
<br><br>
<<if !($daily.pharm.impatient gte 2)>>
	<<loitericon>><<link [[Wait (0:15)|Pharmacy Ask If Lenses Delivered 2]]>><<set $daily.pharm.impatient to 0>><<pass 15>><</link>>
	<br>
<</if>>
<<getouticon>><<link [[Leave|Pharmacy]]>><<set $daily.pharm.impatient to ($daily.pharm.impatient + 1) || 1>><</link>>

:: Pharmacy Ask If Lenses Delivered 2
<<set _received to 0>>
<<set _tmp_length to clone($lenses_ordered.length)>>
<<for _i = 0; _i < $lenses_ordered.length; _i++>>
	<<if Time.monthDay.toString() + Time.month + Time.year.toString() != $lenses_ordered[_i][1]>>
		<<set _received += 1>>
		<<set _spaced_colour_name = window.colorNameTranslate($lenses_ordered[_i][0], "spaced name")>>
		<<run $makeup.owned.custom_eyelenses.push(clone($lenses_ordered[_i][0]))>>
		<<run $custom_eyecolours.push({
			variable: $lenses_ordered[_i][0],
			name: _spaced_colour_name,
			name_cap: _spaced_colour_name.toUpperFirst(),
			csstext: $lenses_ordered[_i][0],
			natural: false,
			lens: true,
			canvasfilter: {
				blend: $lenses_ordered[_i][2][0],
				brightness: +$lenses_ordered[_i][2][1]
			}
		})>>
		<<run $lenses_ordered.deleteAt(_i)>>
		<<run _i-->>
	<</if>>
<</for>>
<<if _received > 0>>
	<<run window.initCustomLenses()>>	/* push custom eyelenses inside setup.colours.eyes */
	<<if _received isnot _tmp_length>>
		<<He>> returns a little while later, noticeably panting. "We received the <<if _received > 1>><<print _received>><</if>> contact lenses you ordered, but for the other <<print (_tmp_length - _received == 1) ? 'one' : _tmp_length - _received>> you'll have to try again tomorrow," <<he>> says while handing you the package.
	<<else>>
		You see the nurse coming back from the room, with a small package in the hands, "Here it is," <<he>> says handing it to you.
		<br>
		"If anything's wrong you just come back here sweetie, and we'll sort a solution out."
	<</if>>
	<br><br>

	<span class="gold">You pick up the package containing your contact lenses.</span>
<<else>>
	A few moments later <<he>> returns, "It hasn't arrived yet, sorry honey. Try again tomorrow. I'm sure it'll have arrived by then."
<</if>>
<br><br>
<<getouticon>><<link [[Leave|Pharmacy]]>><</link>>

:: Pharmacy Prescription Collect
<<set $outside to 0>><<set $location to "hospital">><<effects>>
<<if "pharmNurse" in $per_npc>><<loadNPC 0 "pharmNurse">><<person1>><</if>>
<<set _collected to collectPrescriptionBox($prescriptionCollect)>>
<<if _collected gt 0>>
	<<He>> checks your prescription on the screen, then fetches a box from the locked shelf behind the counter.
	<<if $prescriptionCollect is "painkiller">>
		"Ten doses. These are much stronger than the ones on the shelf, so no more than two in a day."
	<<elseif $prescriptionCollect is "sleep">>
		"Ten tablets. One before bed, never two. Using them too often will make it harder to sleep without them."
	<<else>>
		"Ten doses of Doctor Harper's usual tablets, with the antidepressant added. Take one each day."
	<</if>>
	<br><br>

	<<He>> slides the box across. "No charge, it's on your prescription. That's your lot until next week."
	<br><br>

	<<set _prescriptionName to $prescriptionCollect is "painkiller" ? "prescription painkillers" : ($prescriptionCollect is "sleep" ? "prescription sleeping pills" : "doses of Doctor Harper's prescription")>>
	<span class="green">You collected <<print _collected>> <<print _prescriptionName>>.</span>
	<br><br>
<<else>>
	<<He>> checks the screen and shakes <<his>> head. "Nothing due on that prescription right now."
	<br><br>
<</if>>
<<unset $prescriptionCollect>>
<<link [[Go back|Pharmacy]]>><</link>>

:: Pharmacy Sensitivity Cream
<<set $outside to 0>><<set $location to "hospital">><<effects>>
<<if "pharmNurse" in $per_npc>><<loadNPC 0 "pharmNurse">><<person1>><</if>>
The nurse sets aside the book. "What kind of cream are you looking for? Something to increase sensitivity, or something to decrease it?"
<br><br>
<<link [[Sensitivity-increasing cream|Pharmacy Sale]]>><<set $phase2 to "parasite cream">><<set $pharmacyItem to clone(setup.pharmacyItems["sensitivity_stimulant"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["sensitivity-increasing cream"].owned>></span>
<br>
<<link [[Sensitivity-decreasing cream|Pharmacy Sale]]>><<set $phase2 to "parasite cream">><<set $pharmacyItem to clone(setup.pharmacyItems["sensitivity_suppressant"])>><</link>> | Owned: <span class="gold"><<= $sexStats.pills.pills["sensitivity-decreasing cream"].owned>></span>
<br><br>

<<getouticon>><<link [[Never mind|Pharmacy]]>><</link>>

:: Pharmacy Sale
<<set $outside to 0>><<set $location to "hospital">><<effects>>
<<wearProp $phase2>>
The <<person>> looks at the <<print $pharmacyItem.name>> you're holding.
<<set _displayPrice to setup.inflation ? setup.inflation.price($pharmacyItem.price) : $pharmacyItem.price>>
<<formatmoney _displayPrice>>
<<switch $pharmacyItem.type>>
	<<case "penis reduction">>
		"That'll be _printmoney.<<if !$daily.pharm.seductionResult>> So is it too big, or do you just want it to be tiny?<</if>>"
	<<case "penis growth">>
		"That'll be _printmoney.<<if !$daily.pharm.seductionResult>> So you think yours is too small?<</if>>"
	<<case "penis blocker">>
		"_printmoney please.<<if !$daily.pharm.seductionResult>> I wonder how big you are.<</if>>"
	<<case "breast reduction">>
		"_printmoney please. The effects will vary."
	<<case "breast growth">>
		"_printmoney please. The effects will vary."
	<<case "breast blocker">>
		"_printmoney please."
	<<case "bottom reduction">>
		"_printmoney please. The effects will vary."
	<<case "bottom growth">>
		"_printmoney please. The effects will vary."
	<<case "bottom blocker">>
		"_printmoney please."
	<<case "sensitivity-decreasing cream">>
		"_printmoney please. The tube contains 14 applications. Each will dampen sensation throughout your body for 16 hours. Don't apply it more than once per day."
	<<case "sensitivity-increasing cream">>
		"_printmoney please. The tube contains 14 applications. Each will heighten sensation throughout your body for 16 hours. Don't apply it more than once per day."
	<<case "Anti-Parasite Cream">>
		"_printmoney please. The tube should last for about 2 weeks, depending on where you need to apply it."
	<<case "painkillers">>
		"_printmoney please. There are 14 doses in the pack. Take them when you need them, but be aware that they may make you drowsy. More than three doses in one day can be dangerous."
	<<case "sleeping pills">>
		"_printmoney please. There are 14 tablets. Take one shortly before bed and no more than one a night. They're mild, so they may not help much if pain or stress is keeping you awake."
	<<case "anti-anxiety tablets">>
		"_printmoney please. There are 14 tablets. Take no more than one a day. Two can make you ill. Three or more can leave you dazed and unable to function. Five can make you pass out. Each extra tablet will make the effects last longer."
	<<case "lube tube">>
		"_printmoney please. It's a smaller tube, so you should get about 3 uses out of it."
	<<case "Breast Pump">>
		"_printmoney please."
	<<case "condoms">>
		"_printmoney please." <<He>> looks you over.
		<<if $player.gender_appearance is "m">>
			"Glad to see people playing it safe. Your girl is lucky."
		<</if>>
	<<case "pregnancy test">>
		"_printmoney please." <<He>> looks you over.
		<<if $player.gender_appearance is "m">>
			"Your girl is lucky.
		<<else>>
			"Hope you get the result you're after.
		<</if>>
		They're somewhat inaccurate right after conception, so just give it some time, or take another test a couple of days later."
		<<if $pregnancyTest is undefined>><<set $pregnancyTest to 0>><</if>>
	<<case "fertility booster">>
		"_printmoney please." <<He>> looks you over.
		<<if $player.gender_appearance is "m">>
			"Trying to get your girl knocked up? Good luck.
		<<else>>
			"Oh, who's gonna be the lucky father?
			<!-- ^ This reads kinda weirdly -->
		<</if>>
		Take one per day, try to normalise the time."
	<<case "contraceptive">>
		"_printmoney please.
		<<if $player.gender_appearance is "m">>
			Glad to see people playing it safe. Your girl is lucky.
		<</if>>
		Take one per day, and try to normalise the time. You still need to be careful, though. The only sure way to be safe is to be abstinent."
	<<case "X-Change Pink Hyper Fertility">>
		"_printmoney please. Effects last for a week. Beware that this is an extreme fertility pill. It also accelerates any pregnancy already in progress."
	<<case "X-Change Blue Hyper Fertility">>
		"_printmoney please. The effects last for a week. It greatly increases fertility and sperm production."
	<<case "X-Change Purple Hyper Fertility">>
		"_printmoney please. The effects last for a week. It gives you both a working womb and fertile sperm, and greatly increases fertility. Any existing pregnancy will also progress faster."
	<<case "X-Change Pink Basic" "X-Change Blue Basic" "X-Change Purple Basic">>
		"These are under a special promotion. Only _printmoney for a pack of 3 pills. Effects last for a day."
	<<case "X-Change Pink NOW" "X-Change Blue NOW" "X-Change Purple NOW">>
		"_printmoney please. Effects last for about 6 hours."
	<<case "X-Change Pink Weekly" "X-Change Blue Weekly" "X-Change Purple Weekly" "X-Change Pink CumCure" "X-Change Blue CumCure">>
		"_printmoney please. Effects last for about 7 days."
	<<case "X-Change Pink Xtra Strength" "X-Change Blue Xtra Strength" "X-Change Purple Xtra Strength">>
		"_printmoney please. Effects last 30 days."
	<<case "X-Change Pink Continue" "X-Change Blue Continue" "X-Change Purple Continue">>
		"_printmoney please. Effects last for 3 days, but duration may be extended with every climax."
	<<case "X-Change Pink Resistance" "X-Change Blue Resistance" "X-Change Purple Resistance">>
		"_printmoney please. Effects last for a day, but may become permanent with every climax."
	<<case "X-Change X-Tend">>
		"_printmoney please. Effects last for about 7 days..." <<He>> draws in a massive breath before dropping a big sigh as if preparing for something <<he>> dreads. 
		<br><br>
		As you ponder what is going in <<his>> head, <<he>> begins to spout all once: "Taking in sperm from superior virile members into your womb will allow you to grow in size yourself once you turn back. However, be advised that orgasming at any point of its duration will forfeit any gains as well as cause a significant reduction to your genital size. You've been warned."
		<br><br>
		<<He>> puts the box back on the counter. "Make sure you understand that before you take it."
	<<case "X-Change Pink Breeder" "X-Change Purple Breeder">>
		"_printmoney please. Effects last for a week. Beware that this is a very high fertility pill."
	<<case "X-Change Pink Innocence" "X-Change Blue Innocence">>
		"_printmoney please. Effects last for only a day."
	<<case "X-Change Blue Bull" "X-Change Purple Bull">>
		"_printmoney please. The effects last for a week. It greatly increases your virility."
	<<case "X-Change Clone: Whitney" "X-Change Sissy" "X-Change Butch" "X-Change Pink Swell" "X-Change Blue Swell" "X-Change Pink Bimbo" "X-Change Blue Himbo">>
		"_printmoney please. Effects last for only a day."
	<<case "X-Change Antidote">>
		"_printmoney please. It shortens your current X-Change effect by 24 hours, but causes severe pain."
	<<case "X-Change Antidote Forte">>
		"_printmoney please. It shortens your current X-Change effect by 7 days, but causes severe pain and stress."
	<<case "X-Change Test">>
		"_printmoney please. It identifies your current X-Change effects and gives a better estimate of how long they will last."
	<<case "X-Change Breeder" "X-Change Bull" "X-Change Swell" "X-Change Hyper Fertility" "X-Change Fertility" "X-Change Passion" "X-Change Innocence" "X-Change Bimbo" "X-Change CumCure" "X-Change Dumb-Bitch" "X-Change X-Tend (Gray)" "X-Change Resistance" "X-Change Continue" "X-Change Weekly Extension" "X-Change Portal">>
		"_printmoney please. It contains one X-Change effect and will not change your sex on its own."
	<<default>>
		<<run throw new Error(`Missing pharmacyItem type! ${V.pharmacyItem.type}`)>>
<</switch>>
<br><br>

<<if setup.inflation.canAfford($pharmacyItem.price, "pharmacy")>>
