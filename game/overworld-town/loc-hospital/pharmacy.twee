		<br>
		<<pillicon "xchangePink">><<link [[X-Change CumCure|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_pink_cumcure"]>><</link>>
		<br>
		<<pillicon "xchangePink">><<link [[X-Change Sissy|Pharmacy Sale]]>><<set $pharmacyItem to setup.pharmacyItems["xchange_sissy"]>><</link>>
		<br>
