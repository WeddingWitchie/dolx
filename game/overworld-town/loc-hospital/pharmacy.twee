<</widget>>

:: Widgets pharmacyAddOwned [widget]
<<widget "pharmacyAddOwned">>
	<<set _amount to Number(_args[0])>>
	<<if !Number.isFinite(_amount) or _amount lte 0>>
		<<run throw new Error(`[Pharmacy] Invalid owned increment for ${V.pharmacyItem?.type}: ${_args[0]}`)>>
	<</if>>
	<<if $pharmacyItem is undefined or $pharmacyItem.type is undefined>>
		<<run throw new Error("[Pharmacy] Missing pharmacyItem while trying to add owned stock.")>>
	<</if>>
	<<if $sexStats is undefined>><<set $sexStats to {}>><</if>>
	<<if $sexStats.pills is undefined>><<set $sexStats.pills to {}>><</if>>
	<<if $sexStats.pills.pills is undefined>><<set $sexStats.pills.pills to {}>><</if>>
	<<if $sexStats.pills.pills[$pharmacyItem.type] is undefined>>
		<<run console.warn(`[Pharmacy] Creating missing pill inventory slot for ${V.pharmacyItem.type}.`)>>
		<<set $sexStats.pills.pills[$pharmacyItem.type] to { owned: 0 }>>
	<<elseif !Number.isFinite($sexStats.pills.pills[$pharmacyItem.type].owned)>>
		<<run throw new Error(`[Pharmacy] Invalid owned count for ${V.pharmacyItem.type}: ${V.sexStats?.pills?.pills?.[V.pharmacyItem.type]?.owned}`)>>
	<</if>>
	<<set $sexStats.pills.pills[$pharmacyItem.type].owned += _amount>>
<</widget>>

