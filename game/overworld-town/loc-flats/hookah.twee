	<br><br>
	<<speechresolve>>
	<<if ((_speechAttitudeResolved is "meek") or (_speechAttitudeResolved is "shy"))>>
		"Welcome to the hookah parlour," you say, a little quietly. "It's £50 for an hour on the hookah."
	<<elseif _speechAttitudeResolved is "docile">>
		"Welcome to the hookah parlour," you say gently. "It's £50 for an hour on the hookah."
	<<elseif ((_speechAttitudeResolved is "polite") or (_speechAttitudeResolved is "flamboyant"))>>
		"Welcome to the hookah parlour," you say with practised courtesy. "It's £50 for an hour on the hookah."
	<<elseif _speechAttitudeResolved is "confident">>
		"Welcome to the hookah parlour," you say with easy assurance. "It's £50 for an hour on the hookah."
	<<elseif _speechAttitudeResolved is "cruel">>
