		<<default>>
			<<ggreb>><<prison_reb 4>>
	<</switch>>
	<br><br>
	<<clotheson>>
	<<endcombat>>
	<<prison_revolt_options>>
<<else>>
	<<if $finish is 1>><<encounterEndViolence>><</if>>
