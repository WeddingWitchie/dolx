:: Widgets MMA Gym Avery Whitney Split Events [widget]
<<widget "mmaGymAveryWhitneyInit">>
	<<if $mmaGymAveryGymStage is undefined>><<set $mmaGymAveryGymStage to 0>><</if>>
	<<if $mmaGymAveryGymPool is undefined>><<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymWhitneyGymStage is undefined>><<set $mmaGymWhitneyGymStage to 0>><</if>>
	<<if $mmaGymWhitneyGymPool is undefined>><<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymAveryWhitneyClashStage is undefined>><<set $mmaGymAveryWhitneyClashStage to 1>><</if>>
	<<if $mmaGymAveryWhitneyClashPool is undefined>><<set $mmaGymAveryWhitneyClashPool to [1, 2]>><</if>>
<</widget>>

<<widget "mmaGymAveryGymAvailable">>
	<<set _mmaAWAveryOk to false>>
	<<if C.npc.Avery isnot undefined and C.npc.Avery.init is 1 and C.npc.Avery.state is "active">>
		<<set _mmaAWAveryOk to true>>
	<</if>>
	<<if $avery_mansion and $avery_fate is undefined>>
		<<set _mmaAWAveryOk to false>>
	<</if>>
	<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
		<<set _mmaAWAveryOk to false>>
	<</if>>
<</widget>>

<<widget "mmaGymWhitneyGymAvailable">>
	<<set _mmaAWWhitneyOk to false>>
	<<if C.npc.Whitney isnot undefined and C.npc.Whitney.init is 1 and C.npc.Whitney.state isnot "dungeon" and C.npc.Whitney.state isnot "pillory" and !isInPark("whitney")>>
		<<set _mmaAWWhitneyOk to true>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryGymResetPool">>
	<<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymAveryGymStage to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymResetPool">>
	<<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymWhitneyGymStage to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashResetPool">>
	<<set $mmaGymAveryWhitneyClashPool to [1, 2]>>
	<<set $mmaGymAveryWhitneyClashStage to 1>>
<</widget>>

<<widget "mmaGymAveryGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "avery">>

	<<if $mmaGymAveryGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymAveryGymStage to 1>>
	<<else>>
		<<if $mmaGymAveryGymPool is undefined or $mmaGymAveryGymPool.length is 0>>
			<<mmaGymAveryGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymAveryGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymAveryGymPool to $mmaGymAveryGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymAveryGymPool.length is 0>>
			<<set $mmaGymAveryGymStage to 1>>
		<<else>>
			<<set $mmaGymAveryGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "whitney">>

	<<if $mmaGymWhitneyGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymWhitneyGymStage to 1>>
	<<else>>
		<<if $mmaGymWhitneyGymPool is undefined or $mmaGymWhitneyGymPool.length is 0>>
			<<mmaGymWhitneyGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymWhitneyGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymWhitneyGymPool to $mmaGymWhitneyGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymWhitneyGymPool.length is 0>>
			<<set $mmaGymWhitneyGymStage to 1>>
		<<else>>
			<<set $mmaGymWhitneyGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymWhitneySeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "clash">>

	<<if $mmaGymAveryWhitneyClashPool is undefined or $mmaGymAveryWhitneyClashPool.length is 0>>
		<<mmaGymAveryWhitneyClashResetPool>>
	<</if>>

	<<set _mmaAWPick to $mmaGymAveryWhitneyClashPool.random()>>
	<<set $mmaGymAWEventCurrent to _mmaAWPick>>
	<<set $mmaGymAveryWhitneyClashPool to $mmaGymAveryWhitneyClashPool.filter(n => n !== _mmaAWPick)>>

	<<if $mmaGymAveryWhitneyClashPool.length is 0>>
		<<set $mmaGymAveryWhitneyClashStage to 1>>
	<<else>>
		<<set $mmaGymAveryWhitneyClashStage += 1>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
	<<set $daily.mmaGymWhitneySeen to 1>>
	<<set $daily.mmaGymAveryWhitneyClashSeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyHook">>
	<<mmaGymAveryWhitneyInit>>
	<<mmaGymAveryGymAvailable>>
	<<mmaGymWhitneyGymAvailable>>
	<<set _mmaAWChoices to []>>

	<<if !$daily.mmaGymAveryWhitneyHook and Time.hour gte 8 and Time.hour lt 21 and $exposed lt 1 and $leftarm isnot "bound" and $rightarm isnot "bound">>
	<<set $daily.mmaGymAveryWhitneyHook to true>>	
		<<if _mmaAWAveryOk and $daily.mmaGymAverySeen isnot 1>>
			<<if $mmaGymAveryGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["avery"])>>
			<</if>>
		<</if>>

		<<if _mmaAWWhitneyOk and $daily.mmaGymWhitneySeen isnot 1>>
			<<if $mmaGymWhitneyGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["whitney"])>>
			<</if>>
		<</if>>

		<<if _mmaAWAveryOk and _mmaAWWhitneyOk and $daily.mmaGymAverySeen isnot 1 and $daily.mmaGymWhitneySeen isnot 1 and $daily.mmaGymAveryWhitneyClashSeen isnot 1 and $mmaGymAveryGymStage isnot 0 and $mmaGymWhitneyGymStage isnot 0>>
			<<if random(1, 100) lte 6>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["clash"])>>
			<</if>>
		<</if>>

		<<if _mmaAWChoices.length gt 0>>
			<<set _mmaAWChoice to _mmaAWChoices.random()>>
			<<if _mmaAWChoice is "avery">>
				<<distracticon "green">><<link [[Notice Avery at the gym (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "whitney">>
				<<distracticon "green">><<link [[Notice Whitney at the gym (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymWhitneyGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "clash">>
				<<distracticon>><<link [[Hear an argument by the mirrors (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryWhitneyClashPick>><<pass 5>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryWhitneyClear">>
	<<unset $mmaGymAWEventType>><<unset $mmaGymAWEventCurrent>><<unset $mmaGymAWChoice>><<unset $mmaGymAWChoice2>>
<</widget>>

:: MMA Gym Avery Whitney Event
<<endevent>>
<<set $outside to 0>><<set $location to "mma_gym">><<effects>>
<<speechresolve>>
<<set _mmaAWCustomExit to false>>

<<if $mmaGymAWEventType is "avery">>
	<<npc Avery>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		The front row is lined with new treadmills under bright ceiling lights. Avery is using the machine in the centre, directly below an air-conditioning vent.
		The incline is steep and the belt is moving fast, but <<he>> keeps the same steady pace. A white towel covers part of the console, with <<his>> initials facing outward.
		<br><br>
		You look over for a little too long. Avery notices you in the wall mirror, taps the screen, and slows the treadmill before stepping off. <<He>> wipes <<his>> forehead, then looks from your face to your clothes and shoes.
		<br><br>
		"Well," <<he>> says with a small smile. "I can't say I expected to see you here. Did someone leave a side door open, or did you actually pay to come in?"
		<br><br>
		<<link [[Let Avery correct your form (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "form">><</link>>
		<br>
		<<link [[Ask what Avery thinks of the gym (0:05)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "status">><</link>>
		<br>
		<<link [[Say you are here to train (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "train">><</link>>
		<<if C.npc.Avery.love gte 40 or C.npc.Avery.lust gte 10 or ($allure isnot undefined and $allure gte 250)>>
			<br>
			<<link [[Watch Avery run a little longer (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "watch">><</link>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		Avery stands near the cable machines while another gym member pulls the handle down too fast. The weight stack slams back into place after every repetition.
		After the fourth crash, Avery looks at you and smiles.
		<br><br>
		"Being loud doesn't make the exercise harder, usually it means someone has no idea what they're doing."
		<<He>> turns away from the other gym member and looks at how you are holding your own machine. "All right. Let's see what you're doing wrong."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			"I'll try to do it properly," you say as you adjust your grip.
		<<elseif _speechAttitudeResolved is "docile">>
			"Show me what I'm doing wrong," you say, moving closer to the machine.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"All right. You can check my form," you say.
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"Try not to look disappointed if you can't find anything wrong," you say.
		<<else>>
			"Go ahead," you say, tightening your grip.
		<</if>>
		<br><br>
		<<link [[Follow Avery's instructions (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "obey">><</link>>
		<br>
		<<link [[Correct your form without letting Avery touch you (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "independent">><</link>>
		<br>
		<<link [[Tell Avery to worry about <<himself>> (0:05)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "snap">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		Avery is beside the floor mats with one hand against the wall, stretching one leg. <<He>> stays in the same position while <<his>> breathing remains slow.
		<br><br>
		When <<he>> notices you in the mirror, <<he>> keeps stretching.
		"Most people can force themselves through ten seconds of something unpleasant. They struggle with ten minutes of doing the boring part properly."
		<br><br>
		<<if C.npc.Avery.dom gte 50>>
			<<He>> points to the empty mat beside <<him>>. "Sit down. If you're going to watch, you may as well learn how to stretch properly."<<npcincr Avery dom 1>><<gdom>>
		<<else>>
			<<He>> changes legs and repeats the stretch. The muscles in <<his>> thigh begin to shake, but <<he>> stays in position. "This is the part people skip."<<stress -3>><<lstress>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		Avery sprays a weight bench and wipes the seat before sitting down. The bench already looks clean, but <<he>> wipes the backrest as well.
		<br><br>
		A sweaty gym regular waiting nearby shoots <<him>> an impatient glare. Avery doesn't rush.
		<<He>> simply pauses and meets their eyes with a thin smile. The regular actually walks away.
		<br><br>
		"Shared equipment tells you a great deal about people," Avery says as <<he>> throws the used paper towel into the bin. "They stop caring the second something doesn't belong to them."
		<br><br>
		<<He>> puts the spray bottle back on the rack, lining it up with the other bottles before sitting down. "I don't understand why basic hygiene is difficult."

	<<elseif $mmaGymAWEventCurrent is 4>>
		<<set _mmaAWCustomExit to true>>
		Avery is running another interval on the treadmill. The incline is steep, and each step lands at the same pace.
		As you pass the row of machines, <<he>> lowers the speed to a fast walk and reaches for <<his>> water bottle.
		<br><br>
		"I know that look," <<he>> says. "You're wondering whether you could keep up with me."<<npcincr Avery dom 1>><<gdom>>
		<br><br>
		<<He>> takes a drink, then points at the empty treadmill beside <<him>>. "You're welcome to find out."
		<br><br>
		<<link [[Match Avery's pace (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "match">><</link>>
		<br>
		<<link [[Let Avery set the pace (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "follow">><</link>>
		<br>
		<<link [[Refuse the challenge (0:05)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 5>>
		Avery finishes a set, presses two fingers against the side of <<his>> neck, then checks <<his>> smartwatch with the other hand.
		You watch the numbers change on the screen. Avery notices and lowers <<his>> hand.
		<br><br>
		"I track the numbers," <<he>> says. "Progress is easier to judge when you measure it. Feeling tired tells you very little."
		<br><br>
		<<if C.npc.Avery.love gte 50>>
			<<He>> turns <<his>> wrist so you can see the graph. "My heart rate returns to normal twelve seconds faster than it did last week."
			<br><br>
			<<He>> looks at the screen again, then gives you a small smile.
		<<else>>
			<<He>> turns the screen away from you. "Most people stop when exercise starts becoming uncomfortable. That's usually when they finally begin doing useful work."
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 6>>
		Avery walks over to the machine beside you, then looks down at your shoes.
		<<He>> studies them for several seconds before looking back at you. "Those are not training shoes."
		<br><br>
		<<He>> taps the side of one shoe with the toe of <<his>> own. "There is almost no support in these. Keep training in them and your ankles are going to hurt. Buy a proper pair."<<stress 4>><<gstress>>

	<<elseif $mmaGymAWEventCurrent is 7>>
		<<set _mmaAWCustomExit to true>>
		Avery comes out of the VIP lounge carrying two tall cups of thick green smoothie. <<He>> walks over and holds one out to you.
		<br><br>
		When you do not take it immediately, <<he>> presses the cold cup against your hands until you grab it.
		<br><br>
		"Protein, electrolytes, and actual food," <<he>> says before taking a sip from <<his>> own cup. "There's no cheap syrup in it, so try not to look disgusted."
		<br><br>
		<<link [[Accept the drink (0:10)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "accept">><</link>>
		<br>
		<<link [[Ask how much it cost (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "cost">><</link>>
		<br>
		<<link [[Refuse the drink (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 8>>
		Avery is using the rowing machine. <<He>> pushes back with <<his>> legs, pulls the handle to <<his>> ribs, then slides forward before repeating the movement.
		<br><br>
		You stop nearby. Avery finishes another repetition, puts the handle back, and sits still while <<he>> takes several slow breaths. Sweat has darkened the collar of <<his>> shirt.
		<br><br>
		"Don't look so surprised," <<he>> says as <<he>> wipes <<his>> forehead. "I don't pay other people to do every difficult thing for me."
		<br><br>
		<<if C.npc.Avery.lust gte 50>>
			<<He>> rests <<his>> elbows on <<his>> knees, looks down your body, then back at your face with a smile.
			"Some things are more enjoyable when I do them myself."<<npcincr Avery lust 3>><<glust>>
		<<else>>
			<<He>> picks the handle up again and starts another set, ending the conversation.
		<</if>>
	<</if>>

<<elseif $mmaGymAWEventType is "whitney">>
	<<npc Whitney>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		The free-weight area is busy, but nobody is standing close to the largest mirror. Whitney is in the middle of the open space with a dumbbell in each hand.
		<br><br>
		<<He>> curls one weight, turns slightly, then checks <<his>> arm and stomach in the mirror. When <<he>> notices your reflection behind <<him>>, <<he>> quickly lowers both dumbbells and drops them onto the rubber mat.
		<<His>> cheeks turn red. <<He>> walks towards you before you can say anything.
		<br><br>
		"What the fuck are you staring at, <<slut>>?" Whitney says. "Didn't think they let little shits like you in here. You taking notes or something?"
		<br><br>
		<<link [[Tease Whitney about the weights (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "tease">><</link>>
		<br>
		<<link [[Compliment Whitney's body (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "compliment">><</link>>
		<br>
		<<link [[Ask if Whitney is done with the bench (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "bench">><</link>>
		<br>
		<<link [[Look away and pretend you saw nothing (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "ignore">><</link>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		Whitney is back in front of the mirror, curling a pair of heavy dumbbells. <<He>> notices you approaching in the reflection and keeps watching you while <<he>> lifts.
		<br><br>
		At the top of the next repetition, <<he>> bends <<his>> arm farther and turns it towards the mirror so <<his>> biceps stand out.
		<br><br>
		"You need something, or are you just here to drool again, slut?" <<he>> says while lowering the weight.
		<br><br>
		<<link [[Say the mirror is doing most of the work (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "mirror">><</link>>
		<br>
		<<link [[Tell Whitney the curl looks good (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "praise">><</link>>
		<br>
		<<link [[Pick up your own weights beside <<him>> (0:10)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "share">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		Whitney is doing crunches on a mat directly in front of the mirror. At the top of each repetition, <<he>> looks at <<his>> stomach in the glass before lowering <<his>> shoulders again.
		<br><br>
		After twenty, <<he>> stays halfway up and uses one hand to push a loose piece of hair away from <<his>> forehead.
		You step near the edge of the mat. Whitney immediately looks at you.
		<br><br>
		"What?!" <<he>> says. "You counting my reps? Fucking weirdo."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			"I wasn't counting," you say, looking away.
		<<elseif _speechAttitudeResolved is "docile">>
			"Sorry. I was watching, but I wasn't trying to bother you," you say, taking a step back.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"Twenty," you answer. "You're welcome."
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"You want applause too, or can you count by yourself?" you ask.
		<<else>>
			"You were on twenty," you say.
		<</if>>
		<br><br>
		<<if C.npc.Whitney.love gte 30>>
			Whitney lowers <<his>> shoulders to the mat and gives you a quick grin. "I lost count anyway. Your fault."<<npcincr Whitney love 1>><<glove>>
		<<else>>
			Whitney lies back, starts again from one, and says every number loudly so you can hear <<him>>.
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		<<set _mmaAWCustomExit to true>>
		The only empty weight bench has Whitney's things all over it. <<His>> towel covers the backrest, <<his>> gym bag sits on the seat, and <<his>> water bottle is on the floor in front of it.
		<br><br>
		Whitney is not using the bench. <<He>> stands beside the rack drinking water, watching anyone who comes near <<his>> things.
		When <<he>> sees you looking at the bench, <<he>> lowers the bottle and steps in front of the seat.
		<br><br>
		"Got a problem?" <<he>> asks.
		<br><br>
		<<link [[Tell Whitney to move <<his>> stuff (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "move">><</link>>
		<br>
		<<link [[Ask if you can use the bench (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "ask">><</link>>
		<br>
		<<link [[Find somewhere else (0:05)|MMA Gym Whitney Bench Finish]]>><<set $mmaGymAWChoice to "leave">><</link>>

	<<elseif $mmaGymAWEventCurrent is 4>>
		Whitney is hitting one of the heavy punching bags with bare fists.
		<br><br>
		<<He>> throws one hard punch after another without paying much attention to technique. The bag swings away after each hit, then comes back towards <<him>> before the next punch lands.
		<br><br>
		Whitney notices you and stops. <<He>> wipes sweat from <<his>> upper lip before stepping away from the bag.
		<br><br>
		"Got a problem, slut?" <<he>> says. "You wanna hold the bag for me, or should I hit your face instead?"
		<<if C.npc.Whitney.dom gte 25>>
			<<He>> laughs and points at you. "Nah. One hit and you'd be on the floor."<<stress 4>><<gstress>>
		<<else>>
			You keep looking at <<him>>. Whitney stops smiling, turns away, then tightens the straps around <<his>> wrists.
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 5>>
		Whitney tries to throw <<his>> towel over one shoulder, but the wet end hits the back of <<his>> neck instead.
		<<He>> flinches, reaches behind <<his>> neck, then notices you in the mirror. <<His>> face turns red.
		<br><br>
		"Say one fucking word, slut, and see what fucking happens," <<he>> says, pointing at you.
		<br><br>
		<<set _mmaAWWhitneyThreat to false>>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			You cover your mouth, but a small laugh still escapes.
			<<set _mmaAWWhitneyThreat to true>>
		<<elseif _speechAttitudeResolved is "docile">>
			"I didn't say anything," you answer before looking away.
			<br><br>
			"Then keep your mouth shut and we'll be fine." Whitney pushes the towel into <<his>> gym bag. "Guess your tiny brain does have some common sense."
			<<npcincr Whitney dom 1>><<gdom>>
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			"Are you all right?" you ask while trying not to smile.
			<<set _mmaAWWhitneyThreat to true>>
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			"Nice throw, idiot," you say.
			<<set _mmaAWWhitneyThreat to true>>
		<<else>>
			"That looked painful," you say with a smile.
			<<set _mmaAWWhitneyThreat to true>>
		<</if>>
		<<if _mmaAWWhitneyThreat>>
			<br><br>
			"Don't fucking start, or I will hit you," Whitney says as <<he>> takes a step towards you.
		<</if>>
		<<unset _mmaAWWhitneyThreat>>

	<<elseif $mmaGymAWEventCurrent is 6>>
		<<set _mmaAWCustomExit to true>>
		Whitney is alone at the dumbbell rack. None of <<his>> usual friends are nearby, and nobody is watching <<him>> exercise.
		<br><br>
		<<He>> pulls a dumbbell from the rack too quickly and knocks it against the metal frame. When <<he>> notices you walking past, <<he>> puts the weight down and leans against the rack.
		"Gym's fucking dead today. Nobody here is worth messing with except maybe you."
		<br><br>
		<<He>> scans you from head to toe, <<his>> expression shifting into something more predatory. 
		"Well. Almost nobody."
		<br><br>
		<<link [[Tell Whitney <<he>> looks lonely (0:05)|MMA Gym Whitney Alone Finish]]>><<set $mmaGymAWChoice to "lonely">><</link>>
		<br>
