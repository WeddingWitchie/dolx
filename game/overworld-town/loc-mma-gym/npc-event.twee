:: Widgets MMA Gym Avery Whitney Split Events [widget]
<<widget "mmaGymAveryWhitneyInit">>
	<<if $mmaGymAveryGymStage is undefined>><<set $mmaGymAveryGymStage to 0>><</if>>
	<<if $mmaGymAveryGymPool is undefined>><<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymWhitneyGymStage is undefined>><<set $mmaGymWhitneyGymStage to 0>><</if>>
	<<if $mmaGymWhitneyGymPool is undefined>><<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>><</if>>

	<<if $mmaGymAveryWhitneyClashStage is undefined>><<set $mmaGymAveryWhitneyClashStage to 1>><</if>>
	<<if $mmaGymAveryWhitneyClashPool is undefined>><<set $mmaGymAveryWhitneyClashPool to [1, 2]>><</if>>
<</widget>>

<<widget "mmaGymAveryGymAvailable">>
	<<set _mmaAWAveryOk to false>>
	<<if C.npc.Avery isnot undefined and C.npc.Avery.state is "active">>
		<<set _mmaAWAveryOk to true>>
	<</if>>
	<<if $avery_mansion and $avery_fate is undefined>>
		<<set _mmaAWAveryOk to false>>
	<</if>>
	<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
		<<set _mmaAWAveryOk to false>>
	<</if>>
<</widget>>

<<widget "mmaGymWhitneyGymAvailable">>
	<<set _mmaAWWhitneyOk to false>>
	<<if C.npc.Whitney isnot undefined and C.npc.Whitney.state isnot "dungeon" and C.npc.Whitney.state isnot "pillory">>
		<<set _mmaAWWhitneyOk to true>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryGymResetPool">>
	<<set $mmaGymAveryGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymAveryGymStage to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymResetPool">>
	<<set $mmaGymWhitneyGymPool to [1, 2, 3, 4, 5, 6, 7, 8]>>
	<<set $mmaGymWhitneyGymStage to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashResetPool">>
	<<set $mmaGymAveryWhitneyClashPool to [1, 2]>>
	<<set $mmaGymAveryWhitneyClashStage to 1>>
<</widget>>

<<widget "mmaGymAveryGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "avery">>

	<<if $mmaGymAveryGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymAveryGymStage to 1>>
	<<else>>
		<<if $mmaGymAveryGymPool is undefined or $mmaGymAveryGymPool.length is 0>>
			<<mmaGymAveryGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymAveryGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymAveryGymPool to $mmaGymAveryGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymAveryGymPool.length is 0>>
			<<set $mmaGymAveryGymStage to 1>>
		<<else>>
			<<set $mmaGymAveryGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
<</widget>>

<<widget "mmaGymWhitneyGymPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "whitney">>

	<<if $mmaGymWhitneyGymStage is 0>>
		<<set $mmaGymAWEventCurrent to 0>>
		<<set $mmaGymWhitneyGymStage to 1>>
	<<else>>
		<<if $mmaGymWhitneyGymPool is undefined or $mmaGymWhitneyGymPool.length is 0>>
			<<mmaGymWhitneyGymResetPool>>
		<</if>>

		<<set _mmaAWPick to $mmaGymWhitneyGymPool.random()>>
		<<set $mmaGymAWEventCurrent to _mmaAWPick>>
		<<set $mmaGymWhitneyGymPool to $mmaGymWhitneyGymPool.filter(n => n !== _mmaAWPick)>>

		<<if $mmaGymWhitneyGymPool.length is 0>>
			<<set $mmaGymWhitneyGymStage to 1>>
		<<else>>
			<<set $mmaGymWhitneyGymStage += 1>>
		<</if>>
	<</if>>

	<<set $daily.mmaGymWhitneySeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyClashPick">>
	<<mmaGymAveryWhitneyInit>>
	<<set $mmaGymAWEventType to "clash">>

	<<if $mmaGymAveryWhitneyClashPool is undefined or $mmaGymAveryWhitneyClashPool.length is 0>>
		<<mmaGymAveryWhitneyClashResetPool>>
	<</if>>

	<<set _mmaAWPick to $mmaGymAveryWhitneyClashPool.random()>>
	<<set $mmaGymAWEventCurrent to _mmaAWPick>>
	<<set $mmaGymAveryWhitneyClashPool to $mmaGymAveryWhitneyClashPool.filter(n => n !== _mmaAWPick)>>

	<<if $mmaGymAveryWhitneyClashPool.length is 0>>
		<<set $mmaGymAveryWhitneyClashStage to 1>>
	<<else>>
		<<set $mmaGymAveryWhitneyClashStage += 1>>
	<</if>>

	<<set $daily.mmaGymAverySeen to 1>>
	<<set $daily.mmaGymWhitneySeen to 1>>
	<<set $daily.mmaGymAveryWhitneyClashSeen to 1>>
<</widget>>

<<widget "mmaGymAveryWhitneyHook">>
	<<mmaGymAveryWhitneyInit>>
	<<mmaGymAveryGymAvailable>>
	<<mmaGymWhitneyGymAvailable>>
	<<set _mmaAWChoices to []>>

	<<if !$daily.mmaGymAveryWhitneyHook and Time.hour gte 8 and Time.hour lt 21 and $exposed lt 1 and $leftarm isnot "bound" and $rightarm isnot "bound">>
	<<set $daily.mmaGymAveryWhitneyHook to true>>	
		<<if _mmaAWAveryOk and $daily.mmaGymAverySeen isnot 1>>
			<<if $mmaGymAveryGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["avery"])>>
			<</if>>
		<</if>>

		<<if _mmaAWWhitneyOk and $daily.mmaGymWhitneySeen isnot 1>>
			<<if $mmaGymWhitneyGymStage is 0 or random(1, 100) gte 75>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["whitney"])>>
			<</if>>
		<</if>>

		<<if _mmaAWAveryOk and _mmaAWWhitneyOk and $daily.mmaGymAverySeen isnot 1 and $daily.mmaGymWhitneySeen isnot 1 and $daily.mmaGymAveryWhitneyClashSeen isnot 1 and $mmaGymAveryGymStage isnot 0 and $mmaGymWhitneyGymStage isnot 0>>
			<<if random(1, 100) lte 6>>
				<<set _mmaAWChoices to _mmaAWChoices.concat(["clash"])>>
			<</if>>
		<</if>>

		<<if _mmaAWChoices.length gt 0>>
			<<set _mmaAWChoice to _mmaAWChoices.random()>>
			<<if _mmaAWChoice is "avery">>
				<<distracticon "green">><<link [[Notice Avery at the gym (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "whitney">>
				<<distracticon "green">><<link [[Notice Whitney at the gym (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymWhitneyGymPick>><<pass 5>><</link>>
				<br>
			<<elseif _mmaAWChoice is "clash">>
				<<distracticon>><<link [[Hear an argument by the mirrors (0:05)|MMA Gym Avery Whitney Event]]>><<mmaGymAveryWhitneyClashPick>><<pass 5>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "mmaGymAveryWhitneyClear">>
	<<unset $mmaGymAWEventType>><<unset $mmaGymAWEventCurrent>><<unset $mmaGymAWChoice>><<unset $mmaGymAWChoice2>>
<</widget>>


:: MMA Gym Avery Whitney Event
<<endevent>>
<<set $outside to 0>><<set $location to "mma_gym">><<effects>>
<<speechresolve>>
<<set _mmaAWCustomExit to false>>

<<if $mmaGymAWEventType is "avery">>
	<<npc Avery>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		The gym's front row is blindingly lit, packed with sleek new treadmills. The oversized touchscreens glare back, doing their best to justify the high membership fees. 
		<br><br>
		Avery has staked out the dead-center machine, directly under the best AC vent. Of course <<he>> has.
		<br><br>
		The belt whirs loudly at a brutal incline. Anyone else would be gasping at this pace, but Avery maintains a smooth, irritatingly perfect stride.
		<<His>> designer activewear is barely damp, and a white towel hangs over the console with the monogram facing outward.
		<br><br>
		You hesitate, realizing a second too late that Avery's eyes have already locked onto yours in the massive wall mirror. You were staring, and <<he>> knows it.
		With a tap to the screen, the treadmill comes to a halt. Avery steps down, lightly dabs <<his>> forehead with the towel, and gives you a slow, judging look from head to toe.
		<br><br>
		"Well," <<he>> says, a faint smirk forming. "I can't say I expected to see you here. Did someone leave a side door propped open, or did you just wander in from outside?"
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			You duck your head, suddenly aware of how loud your shoes sound on the floor.
		<<elseif _speechAttitudeResolved is "docile">>
			You stand where <<he>> can see you, hands still, waiting for <<him>> to decide what comes next.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			You give <<him>> a neat little smile, pretending the insult missed you completely.
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			You glance at the treadmill screen, then back at Avery, making no effort to hide your amusement.
		<<else>>
			You hold <<his>> stare and let the comment pass, as if you were invited here on purpose.
		<</if>>
		<br><br>
		<<link [[Let Avery correct your form (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "form">><</link>>
		<br>
		<<link [[Ask if this place is good enough for Avery (0:05)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "status">><</link>>
		<br>
		<<link [[Say you are here to train (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "train">><</link>>
		<<if C.npc.Avery.love gte 40 or C.npc.Avery.lust gte 10 or ($allure isnot undefined and $allure gte 250)>>
			<br>
			<<link [[Watch Avery's stamina a little too closely (0:10)|MMA Gym Avery First Response]]>><<set $mmaGymAWChoice to "watch">><</link>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		Avery stands a safe distance from the cable machines, watching another patron completely butcher a set. Someone grunts aggressively, yanks the handle down, and lets the heavy weight stack slam freely back into place. 
		<br><br>
		By the fourth crash, Avery is smiling.
		<br><br>
		With every loud metallic crash, Avery's expression grows more amused.
		<br><br>
		"Volume isn't effort," <<he>> murmurs, stepping close so you can hear <<him>> over the gym noise. "It's usually just an apology for terrible technique."
		<br><br>
		<<He>> turns <<his>> back on the noisy lifter, focusing entirely on you. <<His>> eyes drop to the grip you have on your own machine.
		"Alright, then," <<he>> says, raising an expectant eyebrow. "Let's see if your form is just as offensive."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			You adjust your grip before <<he>> can criticise it, hoping that spares you the worst of <<his>> look.
		<<elseif _speechAttitudeResolved is "docile">>
			You shift closer to the machine at once, already trying to copy the shape of <<his>> posture.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			You straighten up and offer <<him>> your best gym-floor manners. It only seems to amuse <<him>> more.
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			You tighten your grip and give <<him>> a look that dares <<him>> to find fault.
		<<else>>
			You set your feet and prepare to prove <<him>> wrong without wasting breath on it.
		<</if>>
		<br><br>
		<<link [[Follow Avery's instructions (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "obey">><</link>>
		<br>
		<<link [[Correct your form without letting Avery touch you (0:15)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "independent">><</link>>
		<br>
		<<link [[Tell Avery to worry about <<himself>> (0:05)|MMA Gym Avery Form Finish]]>><<set $mmaGymAWChoice to "snap">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		Avery is over by the floor mats, pressing one palm flat against the mirrored wall and leaning into a deep leg stretch.
		There is no bouncing or rushing. <<He>> holds the uncomfortable position far past the point where a normal person would give up.
		<br><br>
		Catching your gaze in the mirror, Avery doesn't break the stretch.
		<br><br>
		"People are perfectly willing to push themselves for ten seconds," <<he>> says, keeping <<his>> breathing slow and controlled.
		"It's the ten minutes of boring, uncomfortable discipline they can't stomach."
		<br><br>
		<<if C.npc.Avery.dom gte 50>>
			<<He>> nods at the empty mat beside <<him>>, turning the gesture into an outright command.
			"Sit. If you insist on staring, you may as well learn how to do this properly."<<npcincr Avery dom 1>><<gdom>>
		<<else>>
			<<He>> smoothly switches legs to mirror the stretch. The muscles in <<his>> thigh tremble slightly under the tension,
			but <<his>> expression remains completely indifferent. "That is where the difference shows."<<stress -3>><<lstress>>
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		Avery grabs a spray bottle and wipes down a bench before even considering sitting on it.
		The vinyl already looks completely spotless, but that doesn't stop <<him>> from going over it a second time,
		scrubbing with an expression of deep, personal offense.
		<br><br>
		A sweaty gym regular waiting nearby shoots <<him>> an impatient glare. Avery doesn't rush.
		<<He>> simply pauses and meets their eyes with a thin smile. The regular actually walks away.
		<br><br>
		"Shared facilities tell you everything you need to know about the general public," Avery remarks, tossing the damp paper towel into the bin.
		"Most people are utterly careless with things they don't personally own."
		<br><br>
		<<He>> finally sits down, setting the spray bottle back on the rack and aligning it perfectly with the edge.
		"It's quite revealing, really."

	<<elseif $mmaGymAWEventCurrent is 4>>
		<<set _mmaAWCustomExit to true>>
		Avery is deep into a set of treadmill intervals. The heavy, rhythmic thud of <<his>> stride echoes over the motor, the incline set impossibly steep.
		Despite the punishing speed, <<his>> breathing is controlled.
		<br><br>
		As you walk past the row of machines, Avery taps the console, dropping the belt to a brisk recovery walk.
		<<He>> reaches for <<his>> water bottle, catching your eyes in the mirror as you pass.
		<br><br>
		"I know that expression," <<he>> says, unscrewing the cap.
		"That's the face of someone quietly wondering if they could keep up with me."<<npcincr Avery dom 1>><<gdom>>
		<br><br>
		<<He>> takes a drink, then gestures to the empty, powered-down treadmill right beside <<him>>. "By all means. Prove it."
		<br><br>
		<<link [[Match Avery's pace (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "match">><</link>>
		<br>
		<<link [[Let Avery set the pace (0:20)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "follow">><</link>>
		<br>
		<<link [[Refuse the bait (0:05)|MMA Gym Avery Treadmill Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 5>>
		Avery finishes a set and immediately presses two fingers to <<his>> jugular,
		<<his>> other hand tapping the screen of <<his>> smartwatch.
		It's a rare moment where <<he>> is entirely focused on <<himself>>, tuning out the rest of the room.
		<br><br>
		You watch for a second too long, and <<his>> eyes go up, catching yours.
		<br><br>
		"Data," Avery says, dropping <<his>> hand from <<his>> neck.
		"Progress is a lot easier to trust when you can actually measure it. The body lies when it's tired. The numbers don't."
		<br><br>
		<<if C.npc.Avery.love gte 50>>
			Surprisingly, <<he>> turns <<his>> wrist to let you see the small, glowing graph on the screen.
			"My heart rate recovery is twelve seconds faster than last week."
			<br><br>
			<<He>> tries to keep <<his>> tone flat, but there's a distinct edge of pride in <<his>> voice.
		<<else>>
			<<He>> subtly turns <<his>> wrist inward, blocking the screen from your view.
			"Most people quit the moment their heart rate spikes. Which is exactly the point where the workout actually begins."
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 6>>
		Avery steps up to the machine next to yours, but <<his>> gaze immediately drops straight to your feet.
		<<He>> stares in silence. The look of profound disappointment on <<his>> face makes you want to instinctively hide your feet under the bench.
		<br><br>
		"Those are not training shoes," <<he>> finally says, voice flat.
		<br><br>
		Without warning, Avery steps into your space and nudges the side of your shoe with the toe of <<his>> sneaker.
		"Zero arch support. You are going to destroy your ankles, and I refuse to be subjected to watching it happen. Buy a new pair."
		<<stress 4>><<gstress>>

	<<elseif $mmaGymAWEventCurrent is 7>>
		<<set _mmaAWCustomExit to true>>
		The heavy, frosted glass door to the VIP lounge swings open, letting out a blast of over-conditioned air that smells faintly of eucalyptus and fresh ginger.
		<br><br>
		Avery steps out holding two tall plastic cups filled with a thick green smoothie. <<He>> doesn't ask if you're thirsty.
		<<He>> simply walks over and presses the cup directly against your chest until you take it.
		<br><br>
		"Protein, electrolytes, and actual nutrients," <<he>> says, taking a measured sip of <<his>> own.
		"No cheap syrups or artificial sugar. Try not to gag."
		<br><br>
		<<link [[Accept the drink (0:10)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "accept">><</link>>
		<br>
		<<link [[Ask how much it cost (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "cost">><</link>>
		<br>
		<<link [[Refuse to be bought a drink (0:05)|MMA Gym Avery Lounge Finish]]>><<set $mmaGymAWChoice to "refuse">><</link>>

	<<elseif $mmaGymAWEventCurrent is 8>>
		Avery is on the rowing machine. The fan whirs violently with every stroke,
		but <<his>> form is irritatingly flawless with legs driving back, handle pulled sharply to <<his>> ribs,
		seat sliding forward in a steady rhythm. <<His>> sleeves are pushed up, exposing the tight flex of <<his>> forearms.
		<br><br>
		You pause to watch, and it doesn't take long for <<him>> to notice.
		Avery finishes a hard pull and lets the handle rest against the catch, <<his>> chest heaving as <<he>> fights to control <<his>> breathing.
		<<His>> skin is flushed, and the collar of <<his>> wildly expensive athletic shirt is completely soaked.
		<br><br>
		"Don't look so surprised," <<he>> pants, swiping the back of <<his>> hand across <<his>> forehead.
		"I don't outsource every physical exertion."
		<br><br>
		<<if C.npc.Avery.lust gte 50>>
			<<He>> leans forward, resting <<his>> elbows on <<his>> knees. <<His>> gaze drops down your body,
			taking you in before meeting your eyes again with a smirk.
			<br><br>
			"Some things," <<he>> says, catching <<his>> breath, "are much better handled personally."<<npcincr Avery lust 3>><<glust>>
		<<else>>
			Without another word, <<he>> tightens <<his>> grip on the handle, drives <<his>> legs back,
			and the loud roar of the machine's fan immediately shuts down the conversation.
		<</if>>

<</if>>

<<elseif $mmaGymAWEventType is "whitney">>
	<<npc Whitney>><<person1>>
	<<if $mmaGymAWEventCurrent is 0>>
		<<set _mmaAWCustomExit to true>>
		The free weight area is packed, but a wide semi-circle has been awkwardly cleared out in front of the largest mirror. 
		<br><br>
		Whitney has claimed the dead center, wearing a shredded cut-off shirt that barely counts as clothing.
		<<He>> is curling a pair of mid-sized dumbbells that <<he>> can focus entirely on watching <<his>> own biceps flex in the glass.
		<br><br>
		At the top of a rep, <<he>> subtly twists <<his>> torso, admiring how the harsh overhead light hits <<his>> abs.
		That's when <<his>> eyes lock onto your reflection. 
		<br><br>
		An embarrassed blush flares across <<his>> cheeks for a second. To cover it up, <<he>> immediately drops the dumbbells,
		letting them slam into the rubber floor mat with a crash.
		<br><br>
		"The fuck are you staring at, <<slut>>?" Whitney snaps, aggressively closing the distance between you.
		"Didn't think they let little twerps like you in here. What, taking notes?"
		<br><br>
		<<link [[Tease Whitney about the weights (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "tease">><</link>>
		<br>
		<<link [[Compliment Whitney's body (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "compliment">><</link>>
		<br>
		<<link [[Ask if Whitney is done with the bench (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "bench">><</link>>
		<br>
		<<link [[Look away and pretend you saw nothing (0:05)|MMA Gym Whitney First Response]]>><<set $mmaGymAWChoice to "ignore">><</link>>

	<<elseif $mmaGymAWEventCurrent is 1>>
		<<set _mmaAWCustomExit to true>>
		Whitney is back in front of the mirror, the heavy dumbbells clanking with each repetition.
		This time, <<he>> is watching the reflection like a hawk. 
		<<His>> eyes lock onto yours before you're even within five feet of <<him>>.
		<br><br>
		<<He>> doesn't stop the set. Instead, <<he>> holds your gaze in the glass,
		slowly raising the right dumbbell in an exaggerated flex, clearly meant to intimidate you.
		<br><br>
		"You need something, or are you just here to drool again, <<slut>>?" <<he>> grunts, pushing through the rep.
		<br><br>
		<<link [[Say the mirror is doing most of the work (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "mirror">><</link>>
		<br>
		<<link [[Tell Whitney the curl looks good (0:05)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "praise">><</link>>
		<br>
		<<link [[Pick up your own weights beside <<him>> (0:10)|MMA Gym Whitney Mirror Finish]]>><<set $mmaGymAWChoice to "share">><</link>>

	<<elseif $mmaGymAWEventCurrent is 2>>
		Whitney is grinding out crunches on a mat placed dead center in front of the mirror.
		It is the best spot on the floor, but <<he>> is entirely focused on watching <<his>>
		own abdominal muscles tense in the glass.
		<br><br>
		<<He>> hits twenty reps, then literally pauses at the top of the crunch,
		hovering in mid-air just to fix a stray piece of hair.
		<br><br>
		You accidentally step a little too close to the edge of <<his>> mat.
		<br><br>
		"What?" <<he>> barks, staying locked in the half-curled position. "You counting my reps? Fucking weirdo."
		<br><br>
		<<if (_speechAttitudeResolved is "meek" or _speechAttitudeResolved is "shy")>>
			You look away too late. Whitney catches it and looks disgustingly pleased with <<himself>>.
		<<elseif _speechAttitudeResolved is "docile">>
			You stay quiet, counting along in your head because saying anything feels dangerous.
		<<elseif (_speechAttitudeResolved is "polite" or _speechAttitudeResolved is "flamboyant")>>
			You tell <<him>> not bad. Whitney acts like you just handed <<him>> a trophy.
		<<elseif (_speechAttitudeResolved is "bratty" or _speechAttitudeResolved is "cruel")>>
			You ask if <<he>> wants applause for every rep or only the ones <<he>> survives.
		<<else>>
			You keep watching long enough for <<him>> to lose count.
		<</if>>
		<br><br>
		<<if C.npc.Whitney.love gte 30>>
			<<He>> drops <<his>> shoulders back to the mat, flashing you a quick, smug grin.
			"I lost count anyway. Your fault."<<npcincr Whitney love 1>><<glove>>
		<<else>>
			<<He>> drops <<his>> shoulders back to the mat and aggressively starts over from one,
			shouting the numbers unnecessarily loud to prove <<he>> can.
		<</if>>

	<<elseif $mmaGymAWEventCurrent is 3>>
		<<set _mmaAWCustomExit to true>>
		The only available weight bench is completely buried under Whitney's stuff.
		<<His>> damp towel is draped over the backrest, <<his>> gym bag is taking up the seat,
		and a half-empty water bottle and a single sneaker are tossed on the floor exactly where you need to stand.
		<br><br>
		Whitney isn't even using the equipment. <<He>> is leaning against the rack next to it,
