	<<case 3>>
		<<link [[Step in hard and try to bully space from Riley|MMA Riley Challenge 2]]>><<set $mmaRileyLastAction to "You step in hard, trying to bully some space out of Riley before Riley can settle.">><<set $mmaRileyLastScore to -3>><<set $mmaRileyScore -= 3>><<set $mmaRileyWaveScore -= 3>><</link>>
		<br>
		<<link [[Stay patient and keep your guard high|MMA Riley Challenge 2]]>><<set $mmaRileyLastAction to "You hold your guard high and refuse to chase the first opening Riley offers.">><<set $mmaRileyLastScore to 3>><<set $mmaRileyScore += 3>><<set $mmaRileyWaveScore += 3>><</link>>
		<br>
		<<link [[Circle and probe with your feet first|MMA Riley Challenge 2]]>><<set $mmaRileyLastAction to "You circle first and watch Riley's feet, probing for something cleaner than a blind entry.">><<set $mmaRileyLastScore to 1>><<set $mmaRileyScore += 1>><<set $mmaRileyWaveScore += 1>><</link>>
	<<case 4>>
		<<link [[Step in hard and try to bully space from Riley|MMA Riley Challenge 2]]>><<set $mmaRileyLastAction to "You step in hard, trying to bully some space out of Riley before Riley can settle.">><<set $mmaRileyLastScore to -3>><<set $mmaRileyScore -= 3>><<set $mmaRileyWaveScore -= 3>><</link>>
