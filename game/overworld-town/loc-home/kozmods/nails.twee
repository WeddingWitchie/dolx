:: Nail Trim
<<effects>>
<<set _exit to $bathroomExit or "Bathroom">>
<<if $leftarm is "bound" and $rightarm is "bound">>
	<span class="red">Both of your arms are bound</span>, and you can't get hold of the clippers.
	<br><br>
	<<link [[Next|_exit]]>><<endevent>><<canvas-model-override "clear">><<run delete $bathroomExit>><</link>>
	<<exitAll>>
<<elseif $leftarm is "bound" or $rightarm is "bound">>
	<span class="red">One of your arms is bound</span>, and you can't manage the clippers with just one free hand.
	<br><br>
	<<link [[Next|_exit]]>><<endevent>><<canvas-model-override "clear">><<run delete $bathroomExit>><</link>>
	<<exitAll>>
<</if>>
<<if ($nailsgrowth ?? 0) lt 3>>
	Your fingernails are already short, there's nothing to trim.
<<else>>
	<<if $nailsgrowth gte 14>>
		You fetch the clippers from the cabinet and work down each finger. The crescents you'd been growing fall away in dry slivers, leaving your nails blunt and short again. You file the rough corners smooth before stepping back from the basin.
	<<elseif $nailsgrowth gte 7>>
		You fetch the clippers from the cabinet and even out each fingernail, taking the white tips down close to the quick. You file the corners smooth. Your hands look neat again.
	<<else>>
		You fetch the clippers and snip off the soft edges of each fingernail, tidying the few that had started to catch on things.
	<</if>>
	<<set $nailsgrowth to 0>>
	<<set $nailslevel to 0>>
	<<wash_hands>>
<</if>>
<br><br>
<<link [[Next|_exit]]>><<endevent>><<canvas-model-override "clear">><<run delete $bathroomExit>><</link>>


:: Nails [widget]
<<widget "nailtext">>
	<<playerClawType>>
	<<if _clawType is "cat">>
		Your fingertips look ordinary, though you can feel sharp claws sheathed beneath the pads, ready to extend at your will.
	<<elseif _clawType is "wolf">>
		Thick, blunt claws cap each finger, more suited to digging than fine work.
	<<elseif _clawType is "fox">>
		Slender, sharp claws tip your fingers, light enough not to get in the way.
	<<elseif _clawType is "bear">>
		Heavy, curved claws extend from your fingers, better suited to tearing than careful work.
	<<elseif _clawType is "waterdragon">>
		Hard, translucent claws curve from your fingers, smooth but sharp at the tips.
	<<elseif def $nailslevel and $nailslevel gte 3>>
		Your fingernails have grown into hard, sharp points, enough to leave marks when you scratch.
	<<elseif def $nailslevel and $nailslevel gte 2>>
		Your fingernails have grown long, the tips arching past your fingertips.
	<<elseif def $nailslevel and $nailslevel gte 1>>
		Your fingernails are kept neat, with a slim white edge to each one.
	<<else>>
		Your fingernails are short and neatly trimmed.
	<</if>>
<</widget>>

<<widget "playerClawType">>
	/* Single source of truth for "does the player have functional animal claws,
	   and from which TF?" Returns:
	     _clawTypes — every available claw TF
	     _clawType — the chosen claw TF, falling back to the first available type
	     _hasClaws — boolean convenience (true if _clawType isnot "")
	   Land animals count as clawed when awakened (gte 6); water dragons use
	   their final level or the active aquatic trait.
	   Claws are retractable/always-present: a clawed PC scratches at claw tier
	   regardless of natural nail length. */
	<<set _clawTypes to []>>
	<<if effectiveTransformationLevel("cat") gte 6>>
		<<run _clawTypes.push("cat")>>
	<</if>>
	<<if effectiveTransformationLevel("wolf") gte 6>>
		<<run _clawTypes.push("wolf")>>
	<</if>>
	<<if effectiveTransformationLevel("fox") gte 6>>
		<<run _clawTypes.push("fox")>>
	<</if>>
	<<if effectiveTransformationLevel("bear") gte 6>>
		<<run _clawTypes.push("bear")>>
	<</if>>
	<<if effectiveTransformationLevel("waterdragon") gte 7 or Transformations.partActive("traits", "aquatic")>>
		<<run _clawTypes.push("waterdragon")>>
	<</if>>
	<<set _clawType to _clawTypes.includes($clawType) ? $clawType : (_clawTypes[0] || "")>>
	<<set _hasClaws to (_clawType isnot "")>>
<</widget>>

<<widget "scratchDamageProfile">><<silently>>
	<<set _scratchTier to ((_hasClaws or (def _effectiveNailLevel and _effectiveNailLevel gte 3)) ? "claw" : "scratch")>>
	<<set _scratchBaseFlat to (_scratchTier is "claw" ? 6 : 3)>>
	<<set _scratchDef to (_scratchTier is "claw" ? (_args[0] is "dual" ? 1.25 : 0.5) : (_args[0] is "dual" ? 0.8 : 0.35))>>

	<<if $consensual is 1>>
		/* gentle: fixed, no body scaling */
		<<set _scratchFlat to _scratchBaseFlat>>
	<<else>>
		/* deadly: inverse body-size multiplier (mirrors dodge ladder) */
		<<if $bodysize lte 0>>
			<<set _bodyMult to 4.0>>
		<<elseif $bodysize is 1>>
			/* Small bodies use scratch as their hand-strike equivalent too. */
			<<set _bodyMult to 4.0>>
		<<elseif $bodysize is 2>>
			<<set _bodyMult to 2.0>>
		<<elseif $bodysize is 2.5>>
			<<set _bodyMult to 1.5>>
		<<elseif $bodysize is 3>>
			<<set _bodyMult to 1.0>>
		<<else>>
			/* bodysize 4+ (giant) */
			<<set _bodyMult to 0.5>>
		<</if>>
		<<set _scratchFlat to Math.max(1, Math.round(_scratchBaseFlat * _bodyMult))>>

		/* Brawling boost: lets miniature, tiny and small fighters scale scratch like their hand-strike equivalent. */
		<<if $bodysize lt 2 and $combatExtended.brawlingToggle is 1>>
			<<set _brawlingMax to (1000 * (($AMCTraits && Number.isFinite(Number($AMCTraits.brawling))) ? Number($AMCTraits.brawling) : 1))>>
			<<set _brawlingNow to Math.clamp(combatExtendedSkillValue("brawling"), 0, _brawlingMax)>>
			<<set _brawlingBonus to (_brawlingMax > 0 ? (1 + (_brawlingNow / _brawlingMax)) : 1)>>
			<<set _scratchFlat to Math.max(1, Math.round(_scratchFlat * _brawlingBonus))>>
		<</if>>
	<</if>>

	/* Match punch's two-handed combination bonus in hostile fights.
	   "dual" is passed only by the both-hands scratch path in effects.twee. */
	<<if _args[0] is "dual">>
		<<set _scratchFlat to Math.max(1, Math.round(_scratchFlat * ($consensual is 1 ? 2 : 2.5)))>>
	<</if>>

	/* Consensual scratches deal half damage so play-fights don't end prematurely. */
	<<if $consensual is 1>>
		<<set _scratchFlat to Math.max(1, Math.round(_scratchFlat * 0.5))>>
	<</if>>
<</silently>><</widget>>

<<widget "playerNailsNoticeable">>
	<<playerClawType>>
	<<set _nailsNoticeable to (
		!_hasClaws and (
			(def $nailslevel and $nailslevel gte 2)
			or ($beautyBoost and $beautyBoost.nails and $beautyBoost.nails.amount > 0)
		)
	)>>
<</widget>>

<<widget "scratchFlatDamage">><<silently>>
	<<set _sfdHpBefore to Number(_args[0])>>
	<<set _sfdTarget to _args[1]>>
	<<set _sfdNpcHpBefore to _args[2]>>
	<<set _sfdFlat to Number(_args[3])>>
	<<if Number.isFinite(_sfdHpBefore) and Number.isFinite(_sfdFlat)>>
		<<set $enemyhealth to Math.max(0, _sfdHpBefore - _sfdFlat)>>
	<</if>>
	<<if _sfdTarget isnot undefined and $NPCList and $NPCList[_sfdTarget] and Number.isFinite(Number(_sfdNpcHpBefore))>>
		<<set $NPCList[_sfdTarget].health to Math.max(0, Number(_sfdNpcHpBefore) - _sfdFlat)>>
	<</if>>
<</silently>><</widget>>

<<widget "actionsscratch">>
	<<playerClawType>>
	/* _hand is substituted into every flavor sentence below,
	so per-animal claw descriptors here give each TF distinct combat text for free. */
	<<if _clawType is "wolf">>
		<<set _hand to "blunt claws">>
	<<elseif _clawType is "fox">>
		<<set _hand to "needle-sharp claws">>
	<<elseif _clawType is "bear">>
		<<set _hand to "heavy claws">>
	<<elseif _clawType is "cat">>
		<<set _hand to "long claws">>
	<<elseif _clawType is "waterdragon">>
		<<set _hand to "glassy claws">>
	<<elseif def $nailslevel and $nailslevel gte 3>>
		<<set _hand to "claws">>
	<<else>>
		<<set _hand to "nails">>
	<</if>>
	<<if _args[0] is "both">>
		<<set $_target to $lefttarget>>
	<<else>>
		<<if _args[0] isnot undefined>>
			<<set $_target to _args[0]>>
		<<else>>
			<<set $_target to 0>>
		<</if>>
	<</if>>
	<<if $combatExtended.enemyDodgeSuccess gte 1 or $combatExtended.enemyCounterSuccess gte 1>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					`You try to rake your <span class="red">${_hand}</span> across the <<beasttype>> but they`,
					`You swipe at the <<beasttype>> with your <span class="red">${_hand}</span> but they`
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					`You fight through pain and try to rake the <<beasttype>> with your <span class="red">${_hand}</span> but they`,
					`Gritting through the pain, you slash at the <<beasttype>> with your <span class="red">${_hand}</span> but they`
				)>>
			<<else>>
				<<= either(
					`Pained and terrified, you claw wildly with your <span class="red">${_hand}</span> at the <<beasttype>> but they`,
					`Panicked and hurting, you lash out with your <span class="red">${_hand}</span> but they`
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					`You try to rake <<someone $_target>> with your <span class="red">${_hand}</span> but they`,
					`You swipe at <<someone $_target>> with your <span class="red">${_hand}</span> but they`
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					`You fight through the pain and try to rake at <<someone $_target>> with your <span class="red">${_hand}</span> but they`,
					`Forcing yourself through the pain, you slash at <<someone $_target>> with your <span class="red">${_hand}</span> but they`
				)>>
			<<else>>
				<<= either(
					`Pained and terrified, you claw wildly with your <span class="red">${_hand}</span> in self-defence but they`,
					`Scared and hurting, you lash out with your <span class="red">${_hand}</span> in self-defence but they`
				)>>
			<</if>>
		<</if>>
		<<if $combatExtended.enemyCounterSuccess is 2>>
			<span class="red">counter</span>
		<<elseif $combatExtended.enemyDodgeSuccess is 2>>
			<span class="red">dodge</span>
		<<elseif $combatExtended.enemyCounterSuccess is 1>>
			<span class="red">partially counter</span>
		<<else>>
			<span class="blue">partially dodge</span>
		<</if>>.
	<<else>>
		<<if $enemytype is "beast">>
			<<if $pain lte 20>>
				<<= either(
					`You rake your <span class="red">${_hand}</span> across the <<beasttype>>.`,
					`You swipe at the <<beasttype>> with your <span class="red">${_hand}</span>.`
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					`You fight through pain and rake the <<beasttype>> with your <span class="red">${_hand}</span>.`,
					`You grit through the pain and slash at the <<beasttype>> with your <span class="red">${_hand}</span>.`
				)>>
			<<else>>
				<<= either(
					`Pained and terrified, you claw wildly with your <span class="red">${_hand}</span> at the <<beasttype>>.`,
					`Panicked, you thrash at the <<beasttype>> with your <span class="red">${_hand}</span>.`
				)>>
			<</if>>
		<<else>>
			<<if $pain lte 20>>
				<<= either(
					`You rake <<someone $_target>> with your <span class="red">${_hand}</span>, <span class="red">leaving red lines where they pass</span>.`,
					`You swipe at <<someone $_target>> with your <span class="red">${_hand}</span>.`
				)>>
			<<elseif $pain lte 60>>
				<<= either(
					`You fight through the pain and rake <<someone $_target>> with your <span class="red">${_hand}</span>.`,
					`Through the pain, you slash at <<someone $_target>> with your <span class="red">${_hand}</span>.`
				)>>
			<<else>>
				<<= either(
					`Pained and terrified, you claw wildly with your <span class="red">${_hand}</span> in self-defence.`,
					`In a panic, you lash out with your <span class="red">${_hand}</span>.`
				)>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>
