:: Widgets Rent [widget]
<<widget "rentdue">>
	<<npc Bailey>><<person1>>
	<<set $_robinWasInRoom to _args[0]>><<set $baileyRefusedToPay to 0>>

	"Time to pay up," <<he>> says.
	<<if $baileydefeatedchain gte 3 or ($robinpaid is 1 and $robinStand?.selfSufficient isnot 1 and $bus is "home" and $robinfirstrentfight isnot 1 and ($rentTime lte -14 or $rentThug?.anger gte 4))>>
		<<generateRole 1 0 "thug">><<generateRole 2 0 "thug">>
		A rough-looking <<person2>><<person>> and <<person3>><<person>> stand next to <<person1>><<him>>.
		The <<person2>><<person>> cracks <<his>> knuckles, and the <<person3>><<person>> grins darkly.
	<<elseif $baileydefeatedchain gte 1>>
		<<generateRole 1 0 "thug">>
		A rough-looking <<person2>><<person>> stands next to <<person1>><<him>>.
		<<person2>><<He>> cracks <<his>> knuckles.
	<</if>>
	<br><br>

	<<rent_avery>>

	<<if $_robinWasInRoom is 1>>
		You look around, but Robin is nowhere to be found.
		<br><br>

		"Don't bother, <<nnpc_hes "Robin">> being kept for safe keeping," Bailey sneers at you.
		<br><br>
	<</if>>

	<<person1>>
	<<if $baileyOfficeSeduced is 1>>
		<<unset $baileyOfficeSeduced>>
		<<set $_rentSeduce to true>>
	<</if>>

	<<if robinStandSelfSufficiencyReady() and $_robinWasInRoom isnot 1 and getRobinLocation() is "orphanage">>
		/* Robin's stand now earns far more than the rent: they take their debt back from the player. */
		Before you can respond, footsteps hurry down the hall. <span class="purple">It's Robin</span>, clutching a worn envelope.
		<br><br>
		"Wait!" <<nnpc_he "Robin">> says, stepping between you and Bailey. "You're not taking <<pher "Robin">> money for me.
		I'll be paying my own way from now on."
		<br><br>
		Bailey frowns. <<nnpc_He "Bailey">> looks Robin up and down, unamused, and for a moment says nothing at all.
		<br><br>
		Robin holds out the envelope. It's thick. Bailey grabs it and skims the notes inside, scoffs, then pockets it.
		"The lemonade brat, all grown up," <<nnpc_he "Bailey">> says.
		"Fine. But if you're ever short, even once, I'll take it out of both of you. And I won't be polite about it."
		<br><br>
		<<run robinStandBecomeSelfSufficient()>>
		<<nnpc_He "Bailey">> turns back to you. "Don't look so pleased. Your own rent is still due: <span class="gold"><<printmoney $rentMoney>></span>."
		<br><br>
		Robin catches your eye and hugs you, heedless of Bailey watching. "We'll talk later," <<nnpc_he "Robin">> whispers.
		"About the stand. About sharing what it makes. You've earned that and more." <span class="green">You no longer pay Robin's share of the rent.</span>
		<br><br>
	<</if>>

	<<if $babyIntros and $babyIntros.Bailey and $babyIntros.Bailey.length gt 0>>
		<<set _homeBabyRent to true>>
		<<homeBabyIntro>>
	<</if>>
	<<babyRent>>
	<<baileyRentFlavour>>
	<<rentInflationNotice>>
	<<loanRentNotice>>
	<<bratTaxCalc>>
	<<if $bailey_brat and $bailey_brat.points gt 0>>
		"And you've been a pain this week," <<he>> adds. "That's <<printmoney $bratTax "pink">> extra. Don't argue."
		<br><br>
		You think Bailey is mad because <<bratReasonList>>.
		<br><br>
	<</if>>
	<<autism-bailey>>
	<<set _rentTotal to ($rentMoney + ($babyRent or 0) + ($bratTax or 0) + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0))>>
	<<if ($baileyDeposit or 0) gte _rentTotal or setup.hbsc.canAutoPay("bailey", _rentTotal)>>
		<<rentpay "bank">>
		<<link [[Next|Rent Pay Auto]]>><<set $phase to $_robinWasInRoom>><</link>>
	<<else>>
		<<if setup.hbsc.cancelIfShort("bailey", _rentTotal)>>
			<span class="red">Your HBSC standing order couldn't cover the rent, so it's been cancelled.</span><br>
		<</if>>
		<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
		<<if setup.inflation and setup.inflation.baileyAggressive()>>
			<<baileyGripDemand>>
			<<link [[Pay|Rent Pay]]>><<set $phase to $_robinWasInRoom>><</link>>
			<br>
			<<if $syndromebailey isnot true>>
				<<link [[Refuse|Rent Refuse]]>><<def 1>><</link>>
				<br>
			<</if>>
		<<else>>
			<<link [[Pay|Rent Pay]]>><<set $phase to $_robinWasInRoom>><</link>>
			<br>
			<<link [[Refuse|Rent Refuse]]>><<def 1>><</link>>
			<br>
		<</if>>
		<<if !(setup.inflation and setup.inflation.baileyAggressive()) and $baileyseduced isnot 1>>
			<<if hasSexStat("promiscuity", 2)>>
				<<link [[Seduce|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 3>><</link>><<promiscuous2>><<gtrauma>>
				<br>
			<<elseif $uncomfortable.prostituting is false>>
				<<set _desperateaction to 1>>
				<<link [[Seduce|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 12>><<set $desperateaction to _desperateaction>><</link>><<promiscuous2>><<ggtrauma>>
				<br>
			<</if>>
		<</if>>
		/* Keep Stockholm progression available under aggressive rent demands; bank debt still requires money. */
		<<if ($syndromebaileybuild gte 1 or $baileydefeated gte 5) and ($syndromebailey isnot true or !(setup.inflation and setup.inflation.baileyAggressive())) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
			<span class="bailey-red bailey-stockholm"><<link "Offer yourself" "Bailey Offer Yourself">><</link>></span>
			<br>
		<</if>>
	<<else>>
		<<speechresolve>>
		<<person1>>
		<<switch _speechAttitudeResolved>>
			<<case "bratty">>
				You stare at <<him>> in open defiance. "I don't have your money. And I wouldn't give it to you if I did."
			<<case "meek" "shy">>
				You hang your head, unable to pay and dreading what's to come. The words die in your throat before they can form.
			<<case "polite" "flamboyant">>
				"I'm sorry," you say. But the apology sounds thin the moment it leaves your lips. "I don't have it."
			<<case "docile">>
				"I... I don't have it." The admission comes softly, almost as though speaking any louder might make things worse. You lower your gaze at once. 
			<<case "confident">>
				"I don't have your money," you say, meeting <<his>> eyes. "Threatening me won't change that."
			<<case "cruel">>
				You look <<him>> over with open contempt. "No money. Shame. You came all this way for nothing."
			<<default>>
				"I don't have it," you say, with a tightness in your chest that makes each word feel heavier than it should.
		<</switch>>
		<br><br>

		<<rentnopay true>>
		<</if>>
	<</if>>
	<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>
<</widget>>

<<widget "thugrentdue">>
	<<set $phase2 to "thug">><<set $baileyRefusedToPay to 0>>
	<<npc Bailey>><<loadNPC 1 "rent_thug">><<person1>>
	"I see you've finally found your way back. Though it seems you needed some assistance," <<he>> sneers.
	<<if $baileydefeatedchain gte 3 or $rentTime lte -7 or $rentThug.anger gte 4>>
		<<generate3>><<generate4>>
		<<He>> is flanked on both sides by a <<person3>><<person>> and <<person4>><<person>>.
	<<elseif $baileydefeatedchain gte 1 or $rentTime lte -3 or $rentThug.anger gte 2>>
		<<generate3>>
		With <<him>> is a <<person3>><<person>>.
	<</if>>
	<br><br>
	<<if $worn.face.type.includes("gag")>>
		"Looks like you had some difficulties returning," Bailey says while looking at your gag. "A good tool to keep a brat in check," <<person1>><<he>> snidely remarks, "but it's not needed anymore." <<He>> snaps <<his>> fingers, and the <<person2>><<person>> removes it from your mouth.<<person1>>
		<<set $worn.face.type.push("broken")>><<faceruined>>
	<<else>>
		<<person1>><<He>> looks at you coldly. "You better not keep me waiting next time, unless you want another rough escort back.
	<</if>>
	<br><br>

	"Now then, you've had more than enough time to scrounge up what you owe," Bailey says. "So pay up."
	<br><br>

	<<if $babyIntros and $babyIntros.Bailey and $babyIntros.Bailey.length gt 0>>
		<<set _homeBabyRent to true>>
		<<homeBabyIntro>>
	<</if>>
	<<babyRent>>
	<<if $money gte $rentMoney + ($babyRent or 0)>>
		<<link [[Pay|Rent Pay]]>><</link>>
		<br>
		<<link [[Refuse|Rent Refuse]]>><<def 1>><</link>>
		<br>
		<<if $baileyseduced isnot 1 and !isPregnancyEnding()>>
			<<if hasSexStat("promiscuity", 2)>>
				<<link [[Seduce|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 3>><</link>><<promiscuous2>><<gtrauma>>
				<br>
			<<elseif $uncomfortable.prostituting is false>>
				<<set _desperateaction to 1>>
				<<link [[Seduce|Rent Seduce]]>><<set $phase to ($_rentSeduce ? 1 : 0)>><<trauma 12>><<set $desperateaction to _desperateaction>><</link>><<promiscuous2>><<ggtrauma>>
				<br>
			<</if>>
		<</if>>
		<<if isPregnancyEnding()>>
			<<link [[Tell <<him>> your waters have broken|Rent Pregnant]]>><<set $rentPregInterruption to "told">><</link>>
			<br>
		<</if>>
	<<else>>
		<<if isPregnancyEnding()>><<set $rentPregInterruption to "broke">><</if>>
		<<if $speech_attitude is "bratty">>
			You stare <<him>> down defiantly. "Well, guess what? I still don't have enough money for you. Deal with it," you scoff.
		<<elseif $speech_attitude is "meek">>
			You know you don't have enough money, but admitting that in this situation is too much for you. You look down at your feet shamefully.
		<<else>>
			"I... couldn't make enough money," you cautiously admit, afraid of how <<he>> will react.
		<</if>>
		<br><br>

		For a moment, Bailey stares at you with cold indifference before speaking again.
		<<if $phase is "willing">>
			<<rentnopay true>>
		<<else>>
			<<rentnopay>>
		<</if>>
	<</if>>
	<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>
<</widget>>

<<widget "rentduerobin">>
	<<set $_robinInRoom to _args[0]>><<set $baileyRefusedToPay to 0>>
	<<npc Bailey>><<person1>>
	/*<<set $baileyRefusedToPayTotal += $rentMoney + ($babyRent || 0)>>
	<<set $baileyRefusedToPayTotalStat += $rentMoney + ($babyRent || 0)>>*/

	"Time to pay up," <<he>> says.
	<<if $baileydefeatedchain gte 3>>
		<<generateRole 1 0 "thug">><<generateRole 2 0 "thug">><<generateRole 3 0 "thug">>
		A rough-looking <<person2>><<person>> and <<person3>><<person>> stand next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			Behind them, a third <<person4>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
		<<else>>
			Behind them, a third <<person4>><<person>> stands, bringing Robin in with <<him>>. Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
		The <<person2>><<person>> cracks <<his>> knuckles, and the <<person3>><<person>> grins darkly.
	<<elseif $baileydefeatedchain gte 1>>
		<<generateRole 1 0 "thug">><<generateRole 2 0 "thug">>
		A rough-looking <<person2>><<person>> and <<person3>><<person>> stand next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			The <<person3>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
			The <<person2>><<person>> cracks <<his>> knuckles.
		<<else>>
			The <<person2>><<person>> cracks <<his>> knuckles, and the <<person3>><<person>> grins darkly, bringing Robin in with <<him>>.
			Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
	<<else>>
		<<generateRole 1 0 "thug">>
		A rough-looking <<person2>><<person>> stands next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			The <<person2>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
		<<else>>
			The <<person2>><<person>> brings Robin in with <<him>>. Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
	<</if>>
	<br><br>

	<<person1>>
	<<if $baileyOfficeSeduced is 1>>
		<<unset $baileyOfficeSeduced>>
	<</if>>
	<<if $babyIntros?.Bailey?.length gt 0>>
		<<set _homeBabyRent to true>>
		<<homeBabyIntro>>
	<</if>>
	<<babyRent>>
	<<baileyRentFlavour>>
	<<rentInflationNotice>>
	<<loanRentNotice>>
	<<bratTaxCalc>>
	<<if $bailey_brat and $bailey_brat.points gt 0>>
		"And you've been a pain this week," <<he>> adds. "That's <<printmoney $bratTax "pink">> extra. Don't argue."
		<br><br>
		You think Bailey is mad because <<bratReasonList>>.
		<br><br>
	<</if>>
	<<autism-bailey>>
	<<set _rentTotal to ($rentMoney + ($babyRent or 0) + ($bratTax or 0) + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0))>>
	<<if ($baileyDeposit or 0) gte _rentTotal or setup.hbsc.canAutoPay("bailey", _rentTotal)>>
		<<rentpay "bank">>
		<<link [[Next|Rent Pay Auto]]>><<if $inRobinsRoom>><<set $inRobinsRoom to true>><</if>><</link>>
	<<else>>
		<<if setup.hbsc.cancelIfShort("bailey", _rentTotal)>>
			<span class="red">Your HBSC standing order couldn't cover the rent, so it's been cancelled.</span><br>
		<</if>>
		<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
			<<if setup.inflation and setup.inflation.baileyAggressive()>>
				<<baileyGripDemand>>
				<<if $syndromebailey isnot true>>
					<<link [[Refuse|Rent Refuse Robin]]>><<def 1>><</link>>
					<br>
					<<if ($syndromebaileybuild gte 1 or $baileydefeated gte 5) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
						<span class="bailey-red bailey-stockholm"><<link "Offer yourself" "Bailey Offer Yourself">><</link>></span>
						<br>
					<</if>>
				<</if>>
				<<if $inRobinsRoom>>
					<<link [[Pay|Rent Pay Robin]]>><<set $inRobinsRoom to true>><</link>>
				<<else>>
					<<link [[Pay|Rent Pay Robin]]>><</link>>
				<</if>>
				<br>
			<<else>>
				<<if $inRobinsRoom>>
					<<link [[Pay|Rent Pay Robin]]>><<set $inRobinsRoom to true>><</link>>
				<<else>>
					<<link [[Pay|Rent Pay Robin]]>><</link>>
				<</if>>
				<br>
				<<link [[Refuse|Rent Refuse Robin]]>><<def 1>><</link>>
				<br>
				/* Already inside the non-relentless branch; only the bank's claim needs excluding here. */
				<<if ($syndromebaileybuild gte 1 or $baileydefeated gte 5) and !setup.hbsc.hasLoan() and !(setup.inflation and setup.inflation.isEnabled() and ["extreme", "parody"].includes(setup.inflation.tierForWealth()?.id))>>
					<span class="bailey-red bailey-stockholm"><<link "Offer yourself" "Bailey Offer Yourself">><</link>></span>
					<br>
				<</if>>
			<</if>>
		<<else>>
		<<set $baileypaychain to 0>>
		<<speechresolve>>
		<<switch _speechAttitudeResolved>>
			<<case "bratty">>
				You stare at <<him>> in defiance. "I don't have your money. And I wouldn't give it to you if I did. Leave Robin out of this."
			<<case "meek" "shy">>
				You hang your head, unable to pay and terrified of what's to come. "I'm sorry, Robin."
				<br><br>
				"I-it's not your fault," Robin interjects.
			<<case "polite" "flamboyant">>
				"I'm sorry," you say quickly. "I don't have it. Please, leave Robin out of this."
				<br><br>
				Robin looks at you with wide, frightened eyes.
			<<case "docile">>
				"I don't have it..." The words come small and earnest, as though gentleness alone might soften Bailey. "Please don't drag Robin into this." 
				<br><br>
				Robin swallows hard.
			<<case "confident">>
				"I don't have your money," you say. "This is between you and me, so leave Robin out of it."
				<br><br>
				Robin still looks terrified.
			<<case "cruel">>
				You narrow your eyes. "No money. Pick on someone who can actually pay you, and leave Robin alone."
				<br><br>
				Robin flinches at Bailey's smile.
			<<default>>
				"I don't have it," you say. "Please... leave Robin out of this."
				<br><br>
				Robin looks terrified.
		<</switch>>
		<br><br>

		"That's okay," <<he>> says, smiling. "I've already made arrangements. I don't know what they intend for you two, and frankly I don't care."
		<<He>> produces a hood and length of rope. "Hold still."
		<br><br>

		<<if isPregnancyEnding()>>
			<<set $phase to 1>><<set $rentPregInterruption to "broke">><<include "Rent Pregnant">>
		<<else>>
			<<link [[Submit|Rent Intro]]>><<endevent>><<set $phase to 1>><</link>>
			<br>
			<<if $bus is "hospital">>
				<<link [[Fight|Rent Hospital Fight Robin]]>><<set $fightstart to 1>><</link>>
				<br>
			<<else>>
				<<link [[Fight|Rent Robin Fight]]>><<set $fightstart to 1>><</link>>
				<br>
			<</if>>
		<</if>>
	<</if>>
	<</if>>
	<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>
<</widget>>

<<widget "thugrentduerobin">>
	<<set $_robinInRoom to _args[0]>><<set $baileyRefusedToPay to 0>>
	/*<<set $baileyRefusedToPayTotal += $rentMoney + ($babyRent || 0)>>
	<<set $baileyRefusedToPayTotalStat += $rentMoney + ($babyRent || 0)>>*/

	<<set $phase2 to "thug">>
	<<npc Bailey>><<loadNPC 1 "rent_thug">><<person1>>
	"I see you've finally found your way back. Though it seems you needed some assistance," <<he>> sneers.
	<<if $baileydefeatedchain gte 3 or $rentThug.anger gte 4>>
		<<generateRole 2 0 "thug">><<generateRole 3 0 "thug">><<generateRole 4 0 "thug">>
		A rough-looking <<person3>><<person>> and <<person4>><<person>> stand next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			Behind them, a third <<person5>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
		<<else>>
			Behind them, a third <<person5>><<person>> stands, bringing Robin in with <<him>>. Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
		The <<person3>><<person>> cracks <<his>> knuckles, and the <<person4>><<person>> grins darkly.
	<<elseif $baileydefeatedchain gte 1 or $rentThug.anger gte 2>>
		<<generateRole 2 0 "thug">><<generateRole 3 0 "thug">>
		A rough-looking <<person3>><<person>> and <<person4>><<person>> stand next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			The <<person4>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
			The <<person3>><<person>> cracks <<his>> knuckles.
		<<else>>
			The <<person3>><<person>> cracks <<his>> knuckles, and the <<person4>><<person>> grins darkly, bringing Robin in with <<him>>.
			Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
	<<else>>
		<<generateRole 2 0 "thug">>
		A rough-looking <<person3>><<person>> stands next to <<person1>><<him>>.
		<<if $_robinInRoom>>
			The <<person3>><<person>> walks in with a length of rope and rushes Robin. Robin tries to resist, but it's no use.
		<<else>>
			The <<person3>><<person>> brings Robin in with <<him>>. Robin has restraints on <<nnpc_his "Robin">> hands.
		<</if>>
	<</if>>
	<br><br>
	<<person1>>
	<<if $worn.face.type.includes("gag")>>
		"Looks like you had some difficulties returning," Bailey says while looking at your gag. "A good tool to keep a brat in check," <<he>> snidely remarks, "but it's not needed anymore."
		<<He>> snaps <<his>> fingers, and the <<person2>><<person>> removes it from your mouth.
		<<set $worn.face.type.push("broken")>><<faceruined>><<person1>>
	<<else>>
		<<He>> looks at you coldly. "You better not keep me waiting next time, unless you want another rough escort back.
	<</if>>
	<br><br>

	"Now then, you've had more than enough time to scrounge up what you owe," Bailey says. "So pay up."
	<br><br>

	<<if $baileyOfficeSeduced is 1>>
		<<unset $baileyOfficeSeduced>>
	<</if>>
	<<if $babyIntros and $babyIntros.Bailey and $babyIntros.Bailey.length gt 0>>
		<<set _homeBabyRent to true>>
		<<homeBabyIntro>>
	<</if>>
	<<babyRent>>
	<<if $money gte $rentMoney + ($babyRent or 0)>>
		<<link [[Pay|Rent Pay Robin]]>><</link>>
		<br>
		<<link [[Refuse|Rent Refuse Robin]]>><<def 1>><</link>>
		<br>
		<<if isPregnancyEnding()>>
			<<link [[Tell <<him>> your waters have broken|Rent Pregnant]]>><<set $rentPregInterruption to "told">><</link>>
			<br>
		<</if>>
	<<else>>
		<<set $baileypaychain to 0>>
		<<if $speech_attitude is "bratty">>
			You stare <<him>> down defiantly. "Well, guess what? I still don't have enough money for you. Do what you want with me, but leave Robin out of this."
		<<elseif $speech_attitude is "meek">>
			You know you don't have enough money, but admitting that in this situation is too much for you. You look at Robin and shake your head apologetically.
		<<else>>
			"I... couldn't make enough money," you shamefully admit. "Punish me however you want, just don't hurt Robin."
		<</if>>
		<br><br>

		For a moment, Bailey stares at you with cold indifference before speaking again.
		<br><br>

		"Oh well," <<he>> says, now smiling. "I've already made arrangements. I don't know what they intend for you two, and frankly I don't care."
		<<He>> produces a hood and length of rope. "Hold still."
		<br><br>

		<<if isPregnancyEnding()>>
			<<set $phase to 1>><<set $rentPregInterruption to "broke">><<include "Rent Pregnant">>
		<<else>>
			<<link [[Submit|Rent Intro]]>><<endevent>><<set $phase to 1>><</link>>
			<br>
			<<link [[Fight|Rent Robin Fight]]>><<set $fightstart to 1>><<set $phase to 0>><</link>>
			<br>
		<</if>>
	<</if>>
	<<if !isPregnancyEnding()>><<set $rentTime to 7>><</if>>
<</widget>>

<<widget "rentnopay">>
	<<set $baileypaychain to 0>>
	<<set $_seduceAllowed to _args[0]>>
	<<set $baileyRefusedToPayTotal += $rentMoney + ($babyRent || 0)>>
	<<set $baileyRefusedToPayTotalStat += $rentMoney + ($babyRent || 0)>>
	<<if $robinpaid is 1 and $robinStand?.selfSufficient isnot 1 and $bus is "home" and $robinfirstrentfight isnot 1 and ($baileydefeatedchain gte 3 or $rentTime lte -14)>>
		<<set $robinfirstrentfight to 1>>
		Bailey is silent for a few seconds, before shrugging. "That's okay," <<person1>><<he>> says.
		"I've learned my lesson. Trying to get value out of you directly is fruitless."
		<br><br>

		<<if $phase2 is "thug">>
			On an unseen signal, the thugs advance on you.
			You prepare to avoid them, but the <<person2>><<person>> behind you quickly grabs hold of you. You try to shake <<him>> off, but by then the <<person3>><<person>> and <<person4>><<person>> have already reached you.
			They easily take hold of your arms and pin you in place.
		<<else>>
			On an unseen signal, the thugs advance on you.
			The <<person3>><<person>> reaches for you. You duck under <<his>> arm, but the <<person2>><<person>> grabs yours.
			The <<person3>><<person>> grabs your other arm, and they hold you there.
		<</if>>
		<br><br>

		<<link [[Next|Rent First Robin Fight]]>><<set $fightstart to 1>><<set $combatPhase to "talk">><<set $robinRentEvent to 1>><<set $timer to 5>><</link>>
	<<else>>
		<<person1>>
		<<if $phase2 is "thug">>
			"Oh well," <<he>> says, now smiling.
		<<else>>
			"That's okay," <<he>> says, smiling.
		<</if>>
		"I've already made arrangements. I don't know what they intend for you, and frankly I don't care."
		<<He>> produces a hood and length of rope. "Hold still."
		<br><br>

		<<if isPregnancyEnding()>>
			<<set $phase to 1>><<include "Rent Pregnant">>
		<<else>>
			<<link [[Submit|Rent Intro]]>><<endevent>><</link>>
			<br>
			<<if $bus is "hospital">>
				<<link [[Fight|Rent Hospital Fight]]>><<set $fightstart to 1>><</link>>
				<br>
			<<else>>
				<<link [[Fight|Rent Fight]]>><<set $fightstart to 1>><</link>>
				<br>
			<</if>>
			<<if $baileyseduced isnot 1 and $_seduceAllowed>>
				<<if hasSexStat("promiscuity", 2)>>
					<<link [[Seduce|Rent Seduce]]>><<trauma 3>><</link>><<promiscuous2>><<gtrauma>>
					<br>
				<<elseif $uncomfortable.prostituting is false>>
					<<set _desperateaction to 1>>
					<<link [[Seduce|Rent Seduce]]>><<trauma 12>><<set $desperateaction to _desperateaction>><</link>><<promiscuous2>><<ggtrauma>>
					<br>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "babyRentDisplay">>
<<babyRent true>><<if $babyRent>><<print _args[0]>><<printmoney $babyRent _args[2]>><<print _args[1]>><</if>>
<</widget>>

<<widget "babyRent">><<silently>>
	<<set _skipReductions to _args[0]>>
	<<set $_childrenRentCount to getChildrenAt("home").reduce((prev, curr) => {
		if(!(curr.development.interactions >= 6)) {
			if (!T.skipReductions) curr.development.interactions = 0;
			return prev + 1;
		}
		if (!T.skipReductions) curr.development.interactions = 0;
		return prev;
	}, 0)>>
	<<set $_milkRentReduction to Math.clamp(Math.floor($pregnancyStats.orphanageMilkBottles / 7), 0, Math.min(Math.floor($pregnancyStats.orphanageMilkBottles / 7), $_childrenRentCount))>>

	<<set $_childrenRentCount -= $_milkRentReduction>>
	<<if !_skipReductions>>
		<<set $pregnancyStats.orphanageMilkBottles -= $_milkRentReduction * 7>>
	<</if>>

	<<set $babyRent to $_childrenRentCount * 10000>>
<</silently>><</widget>>

<<widget "rentmod">>
	<<set $rentMoney to Math.floor($rentMoney * $settings.rentCostModifier)>>
	<<if $robinpaid is 1 and $robinStand?.selfSufficient isnot 1>>
		<<set $rentMoney *= 2>>
	<</if>>
	/* Wealth-driven rent pressure is applied here, but advanced only after rent is paid. */
	<<if setup.inflation>>
		<<set $rentMoney to setup.inflation.applyToRent($rentMoney)>>
	<</if>>
<</widget>>

<<widget "rentpay">>
	/* The bank deduction is committed here so payment + bookkeeping stay atomic. "thug" marks a thug-escorted visit, not a payment method. */
	<<set _payVia to (_args[0] is "bank" ? "bank" : "cash")>>
	/* Overdue HBSC loan: Bailey collects a weekly surcharge on top of rent. */
	<<set _loanSurcharge to (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0)>>
	/* Recompute here rather than trusting $bratTax: not every path into rentpay runs a demand passage first, and the tax must match what was announced before $rentMoney rolls over below. */
	<<bratTaxCalc>>
	<<set _rentDue to ($rentMoney + ($babyRent or 0) + ($bratTax or 0) + _loanSurcharge)>>
	<<set _depositPay to Math.min(Math.max($baileyDeposit or 0, 0), _rentDue)>>
	<<if _depositPay gt 0>>
		<<set $baileyDeposit -= _depositPay>>
		<<set _rentDue -= _depositPay>>
		<<if _rentDue lte 0>><<set _payVia to "deposit">><</if>>
	<</if>>
	<<set $rentLastPaidVia to _payVia>>
	<<if _rentDue lte 0>>
		/* Nothing left to hand over. */
	<<elseif _payVia is "bank">>
		<<set _bankPay to setup.hbsc.tryAutoPay("bailey", _rentDue)>>
		<<if not _bankPay.paid>>
			<<if $money lt _rentDue>><<baileyBankDraw `_rentDue - $money`>><</if>>
			<<money `-_rentDue` "baileyRent">>
			<<set _payVia to "cash">><<set $rentLastPaidVia to "cash">>
		<</if>>
	<<else>>
		<<if $money lt _rentDue>><<baileyBankDraw `_rentDue - $money`>><</if>>
		<<money `-_rentDue` "baileyRent">>
	<</if>>
	<<if _loanSurcharge gt 0>><<run setup.hbsc.collectLoanFromRent(_loanSurcharge)>><</if>>
	<<if setup.inflation and setup.inflation.advanceRentPressure>><<run setup.inflation.advanceRentPressure()>><</if>>
	<<set $rentMoney to [10000,30000,50000,70000,100000,150000,200000][Math.clamp($rentStage,1,6)]>> <!-- note: clamping to 1 is intentional -->
	<<rentmod>>

	<<if _payVia is "deposit">>
		Bailey holds out <<nnpc_his "Bailey">> hand, then checks <<nnpc_his "Bailey">> notes and remembers the money you paid <<nnpc_him "Bailey">> in advance. <<nnpc_He "Bailey">> takes this week out of it. "Hm. Paid up.
	<<elseif _payVia is "bank">>
		Bailey goes to demand the cash, then glances at <<nnpc_his "Bailey">> phone. Seems your HBSC standing order has already cleared. <<nnpc_He "Bailey">> gives a short grunt, almost disappointed at the lack of fuss. "Hm. Paid up.
	<<else>>
		Bailey snatches the money from your hand and starts counting. "Good," <<nnpc_he "Bailey">> says, satisfied. "You came through.
	<</if>>
	<<if $rentStage is 1>>
		Next week I want <<printmoney $rentMoney "pink">><<babyRentDisplay " plus " " if you don't look after your children" "pink">>. You didn't think it would get any easier, did you?"
	<<else>>
		Next week I want <<printmoney $rentMoney "pink">><<babyRentDisplay " plus " " if you don't look after your children" "pink">>."
	<</if>>
	<<if _args[0] is "thug">>
		<br><br>
		By the time <<nnpc_hes "Bailey">> done counting the money, the <<print $event.buffer.length gte 3 ? "thugs that were with <<nnpc_him 'Bailey'>> have" : "thug that was with <<nnpc_him 'Bailey'>> has">> already vanished.<<thuganger -5>><<lllthuganger>>
	<</if>>
	<<if _loanSurcharge gt 0>>
		<br><br>
		"And before you ask," <<nnpc_he "Bailey">> adds, "<<printmoney _loanSurcharge "red">> of that's going to the bank. They came to me about the money you owe them. Take it up with them if you don't like it."
	<</if>>
	<<if $bratTax gt 0>>
		<br><br>
		<<nnpc_He "Bailey">> counts out the extra <<printmoney $bratTax "pink">> separately and pockets it with a thin smile. "That's for the trouble you've caused me. Behave and it won't happen again."
	<</if>>
	<<set $bailey_rent_seen to ($bailey_rent_seen || {})>>
	<<if $fame.good gte 1000 and !$bailey_rent_seen.good3>>
		<br><br>
		"The whole town's talking about you." <<nnpc_He "Bailey">> pockets the rent. "Don't let it go to your head."<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 2>><<gglust "Bailey">><<set $bailey_rent_seen.good3 to true>>
	<<elseif $fame.good gte 600 and !$bailey_rent_seen.good2>>
		<br><br>
		"You've been making friends." <<nnpc_He "Bailey">> pockets the rent. "Good. Keep it up."<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 1>><<glust "Bailey">><<set $bailey_rent_seen.good2 to true>>
	<<elseif $fame.good gte 400 and !$bailey_rent_seen.good1>>
		<br><br>
		"People speak well of you." <<nnpc_He "Bailey">> pockets the rent. "That reflects on me, you know."<<npcincr Bailey love 1>><<glove "Bailey">><<set $bailey_rent_seen.good1 to true>>
	<<elseif $fame.prostitution gte 1000 and !$bailey_rent_seen.prost3>>
		<br><br>
		"The town knows your rates now." <<nnpc_He "Bailey">> pockets the rent. <<nnpc_He "Bailey">> almost smiles. "Good."<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 2>><<gglust "Bailey">><<set $bailey_rent_seen.prost3 to true>>
	<<elseif $fame.prostitution gte 600 and !$bailey_rent_seen.prost2>>
		<br><br>
		"You've been fucking your way around town and earning your keep." <<nnpc_He "Bailey">> pockets the rent. "Keep it up."<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 1>><<glust "Bailey">><<set $bailey_rent_seen.prost2 to true>>
	<<elseif $fame.prostitution gte 400 and !$bailey_rent_seen.prost1>>
		<br><br>
		"Word gets around. I hear you spread your legs for anyone." <<nnpc_He "Bailey">> pockets the rent. "At least you know what you're worth."<<npcincr Bailey love 1>><<glove "Bailey">><<set $bailey_rent_seen.prost1 to true>>
	<<elseif $fame.exhibitionism gte 1000 and !$bailey_rent_seen.exhib3>>
		<br><br>
		"Your photos." <<nnpc_He "Bailey">> pockets the rent. "I've seen them. Valuable, aren't you?"<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 2>><<gglust "Bailey">><<set $bailey_rent_seen.exhib3 to true>>
	<<elseif $fame.exhibitionism gte 600 and !$bailey_rent_seen.exhib2>>
		<br><br>
		"Half the town's seen you naked." <<nnpc_He "Bailey">> pockets the rent. "Advertising, are we?"<<npcincr Bailey love 1>><<glove "Bailey">><<npcincr Bailey lust 1>><<glust "Bailey">><<set $bailey_rent_seen.exhib2 to true>>
	<<elseif $fame.exhibitionism gte 400 and !$bailey_rent_seen.exhib1>>
		<br><br>
		"You've been getting around." <<nnpc_He "Bailey">> pockets your rent. "Good industry. But keep it off the orphanage doorstep."<<npcincr Bailey love 1>><<glove "Bailey">><<set $bailey_rent_seen.exhib1 to true>>
	<</if>>
	<<if $syndromebaileybuild gte 1 and $exposed lt 1 and $allure gte (6000 * $settings.allureModifier) and !$bailey_rent_seen.allure2>>
		<br><br>
		<<nnpc_His "Bailey">> eyes move over you slowly. <<nnpc_He "Bailey">> doesn't look away.<<npcincr Bailey lust 2>><<gglust "Bailey">><<set $bailey_rent_seen.allure2 to true>>
	<<elseif $syndromebaileybuild gte 1 and $exposed lt 1 and $allure gte (3000 * $settings.allureModifier) and !$bailey_rent_seen.allure1>>
		<br><br>
		<<nnpc_His "Bailey">> eyes linger on you a moment longer than usual before <<nnpc_he "Bailey">> looks away.<<npcincr Bailey lust 1>><<glust "Bailey">><<set $bailey_rent_seen.allure1 to true>>
	<</if>>
	<<if $exposed gte 2>>
		<br><br>
		<<if C.npc.Bailey.dom gte 70>>
			<<nnpc_His "Bailey">> eyes move over your exposed body. <<nnpc_He "Bailey">> takes <<nnpc_his "Bailey">> time. "Get dressed."
		<<elseif C.npc.Bailey.dom gte 30>>
			<<nnpc_His "Bailey">> gaze drops over your body. <<nnpc_He "Bailey">> looks away with a sneer. "Get dressed."
		<<else>>
			<<nnpc_He "Bailey">> glances at you. "Put some clothes on."
		<</if>>
		<<if $syndromebaileybuild gte 1>><<npcincr Bailey lust 2>><<gglust "Bailey">><</if>>
	<<elseif $exposed gte 1>>
		<br><br>
		<<nnpc_His "Bailey">> eyes flick down over your body, then back up. "Get dressed."
		<<if $syndromebaileybuild gte 1>><<npcincr Bailey lust 1>><<glust "Bailey">><</if>>
	<</if>>
	<br><br>

	<<set $baileydefeatedchain to 0>>
	<<set $baileyRefusedToPay to 0>><<set $bailey_brat to { points: 0, reasons: [] }>><<set $bratTax to 0>>
	<<set $baileypaychain to ($baileypaychain || 0) + 1>>
	<<unset $bailey_encroach>>
	<<set $rentStage += 1>>
	<<if $robinpaid>>
		<<npcincr Robin trauma -7>>
	<</if>>
	<<if $bailey_confiscation>>
		<<run baileyConfiscationRestore()>>
		<span class="blue">Bailey has returned your confiscated belongings to you.</span>
		<br><br>
	<</if>>
<</widget>>

<<widget "rentRobinPunishment">>
	You journey for some time until you feel that you're walking on grass. A small breeze flows by you. Another set of footsteps approach.

	<<if !$robinPunishments.includes("docks") and $debug>>/* locked behind debug until further improvements */
		<<generate2>><<generate3>>
		"Oh, <<nnpc_hes "Robin">> cute. A perfect little travel companion," an unfamiliar <<person2>><<personssimple>> voice says.
		<<if C.npc.Robin.pronoun is $player.gender_appearance>>
			You're not sure who they're referring to.
		<</if>>

		"Hand over the cash," Bailey demands.
		<br><br>

		"Can't believe you're making me do this when we're about to sail," a second <<person3>><<personssimple>> voice says.
		<<robinPunishment "docks">>
	<<else>>
		"Hand over the cash," Bailey demands.
		<br><br>

		There is no response, save for the rustling of clothes.
		<br><br>

		"Just hand it over already." Bailey sounds slightly unnerved.
		<<robinPunishment "landfill">>
	<</if>>
	<br><br>

	You hear a rustle of paper.
	<<if _robin.dom gte 60>>
		"Let go of me!" Robin yells. <<if $robinromance is 1>>"<<pShe "Robin">> <<pverb "needs" "need" "Robin">> me, stop it!"<<else>>"<<pShes "Robin">> my friend! You can't do this!"<</if>>
		<br><br>

		The sounds of Robin's protests fade off into the distance.
	<<else>>
		"No, no!" Robin shrieks. "Let me go!"
		<br><br>

		The sounds of Robin crying fade off into the distance.
	<</if>>
	You're pulled elsewhere by Bailey.
<</widget>>

<<widget "rentEdenTrade">>
	<<npc Eden>><<person1>>
	You aren't left hanging there for long.
	Your hood is yanked off your head as a<<if $syndromeeden gte 1>> familiar<</if>> <<personssimple>> voice appears beside you.

	<<if $edenCagedEscape or edenFreedomStatus() gte 2>>
		"I told you I'd find you again," Eden growls as <<he>> pulls you to the ground. <<He>> doesn't untie you. "This time the lesson better stick."
		<br><br>

		You're roughly led through the woods, helpless to resist, until you finally reach the cabin. "Welcome home," Eden sneers.
		<<He>> drags you towards the sleeping area, where a metal cage awaits.
		<br><br>

		<<link [[Next (0:30)|Eden Caged Intro]]>><<pass 30>><<set $phase to 2>><</link>>
		<br>
	<<elseif edenFreedomStatus() gte 1>>
		"I trusted you," Eden says as <<he>> cuts your bindings. You fall to the floor in a heap.
		"This is what happens if you don't obey me. It's for your own protection." <<He>> pulls you to your feet. "Let's go home."
		<br><br>

		<<link [[Next (0:30)|Eden Recaptured]]>><<pass 30>><</link>>
		<br>
	<<elseif edenFreedomStatus() is 0>>
		"I knew you'd end up like this. The town is dangerous," Eden says, cutting your bindings. <<He>> catches you as you fall. "Let's go home."
		<br><br>

		<<He>> takes you back to <<his>> cabin.
		<br><br>
		<<endevent>>
		<<link [[Next (0:30)|Eden Cabin]]>><<pass 30>><</link>>
		<br>
	<<else>>
		<<badEndTracking "Eden" { reason: "soldBailey" }>>
		<<if $hunterintro is 1>>
			"I knew I'd get you back."
		<<else>>
			"I'm not used to my prey being so helpless. Not that I'm complaining."
		<</if>>
		<<He>> crept up on you without making a sound.
		<br><br>

		<<endevent>>

		<<link [[Next|Forest Hunter Intro]]>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "rentGwylanTrade">>
	<<npc Gwylan>><<person1>>
	You aren't left hanging there for long. Your hood is gingerly lowered, and a <<personssimple>> gentle voice wistfully appears beside you. "Oh, <<pcpetname "Gwylan">>."
	<br><br>

	<<if $gwylan.taken>>
		/* ToDo: Gwylan - soft bad end */
		<span class="red">It's Gwylan.</span>. <<He>> steps around you, revealing <<his>> sad smile.
		<br><br>

		"Do you have any idea how worried I was?" <<He>> hugs you. "Naughty little runaway. Come, a warm bed is waiting for us at home." <<He>> raises <<his>> hand, and your leash appears in it.
		You're led into the forest, and to Gwylan's shop.
		<br><br>

		<<link [[Next|Forest Shop Entrance]]>><<endevent>><<pass 15>><</link>>
		<br>
	<<else>>
		<span class="forest-green">It's Gwylan.</span> <<He>> steps around you, revealing <<his>> bright smile.
		<br><br>

		"You're lucky you still have your collar, otherwise I wouldn't have found you." <<He>> hugs you. "Let's go, before someone sees."
		You're led into the forest, and to Gwylan's shop.
		<br><br>

		<<link [[Next|Forest Shop Entrance]]>><<endevent>><<pass 15>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "homeBabyIntro">>
	<<set _fatherEvent to !!$babyIntros.Bailey.find(child => child.mother !== "pc")>>
	<<set _motherEvent to !!$babyIntros.Bailey.find(child => child.mother === "pc")>>
	<<set $_newChildrenCount to $babyIntros.Bailey.reduce((prev, curr) => prev + curr.children, 0)>>
	<<set _playerBornChildren to []>>
	<<set _playerChildrenBirthLocations to []>>
	<<set _playerFatheredChildren to []>>
	<<set _birthIds to $babyIntros.Bailey.reduce((prev, curr) => {
		prev.pushUnique(curr.mother + curr.birthId);
		return prev;
	}, [])>>
	<<run getBornChildren().forEach(child => {
		const carrier = getPregnancyOf(child).carrier;
		if(T.birthIds.includes(carrier + child.pregnancyId)){
			if(carrier === "pc"){
				T.playerBornChildren.push(child.childId);
				T.playerChildrenBirthLocations.pushUnique(child.development.birthLocation);
			} else {
				T.playerFatheredChildren.push(child.childId);
			}
			child.development.interactionsTotal = 0;
			child.development.interactions = 7 - Math.clamp(V.rentTime, 0, 7);
		}
	})>>
	<<person1>>
	<<if _homeBabyRent>>
		"Before we begin, I have news for you." <<He>> pulls out a piece of paper, and looks back to you.
	<<else>>
		<<He>> pulls out a piece of paper, and looks back to you.
	<</if>>
	<<if $babyIntros.Bailey.length gte 5>>
		"You've been fucking busy. Or busy fucking. Congratulations
	<<else>>
		"First of all, congratulations
	<</if>>
	<<if _fatherEvent and _motherEvent>>
		<span class="lewd">on being both a mother and a father</span>. <span class="green"><<childrenNames _playerBornChildren>> got here safely from the <<print formatList(_playerChildrenBirthLocations, "and", true)>></span>."
	<<elseif _fatherEvent>>
		<span class="lewd">on being a father</span>."
	<<else>>
		on being a mother. <span class="green"><<childrenNames _playerBornChildren>> arrived safely from the <<print formatList(_playerChildrenBirthLocations, "and", true)>></span>."
	<</if>>
	<<if _fatherEvent>>
		<<earnFeat "First Fatherhood">>
		<<set _impregFame to (_playerFatheredChildren.length * 5)>>
		<<fameimpreg _impregFame>>
		<br><<He>> looks back to the paper.<br><br>
		<<for _key, _value range $babyIntros.Bailey.filter(child => child.mother !== "pc")>>
			<<run setKnowsCarrier(_value.birthId, "pc"); setKnowsDonor(_value.birthId, "pc")>>
			<<if _value.description>><<set $pregnancies[_value.birthId].carrierDescription to _value.description>><</if>>
			<!--
			<<set _childIds to []>>
			<<run getBornChildren().forEach(child => {
				if(getPregnancyOf(child).carrier === T.value.mother && child.pregnancyId === T.value.birthId){T.childIds.push(child.childId)}
			})>> -->
			<<switch _value.children>>
				<<case 1>><<set _childrenText to "a brat">>
				<<case 2>><<set _childrenText to "a pair of brats">>
				<<default>><<set _childrenText to "a trio of brats">>
			<</switch>>
			<<if _continues>>
				<br><<He>> continues.
			<</if>>
			<<if _value.mother is "Robin">>
				"That waif popped out <<print _childrenText>>, and insists that they're yours. I'm inclined to believe <<nnpc_him "Robin">> with how much time you two spend together."
			<<elseif _value.mother is "Alex">>
				<<if pregnancyCountBetweenParents("Alex","pc") is 1 or pregnancyCountBetweenParents("pc","Alex")>>
					<<if C.npc.Alex.pregnancy.selfKnowledge or C.npc.Alex.pregnancy.pcKnowledge>>
						"I got word that you knocked up some <<if C.npc.Alex.pronoun is "f">>bitch<<else>>slut<</if>> outside town. I paid <<nnpc_him "Alex">> a little visit and saw that that farm's no place for a brat. I did you the favour of bringing your spawn back here, where it belongs."
					<<else>>
						"I've paid a little visit to that farmer <<nnpc_gendery "Alex">>. You should have done the same. Anyway, <<nnpc_he "Alex">> popped out <<print _childrenText>>, and I already know it's yours."
					<</if>>
				<<else>>
					"You're a careless little fuck, you know that? Making me drive all the way there again just because you don't know how to assume your own responsibilities, instead, making more and more," <<he>> says.
					<br><br>
					"It's from that farmer <<nnpc_gendery "Alex">>, again."
				<</if>>
			<<elseif modLISelected("Poppy") and _value.mother is "Poppy">>
				"Poppy came by with <<print _childrenText>> and a paternity test. Seems <<nnpc_he "Poppy">> expected me to be moved by the whole thing. I wasn't, but the paperwork had your name on it."
			<<elseif $NPCNameList.includes(_value.mother)>>
				"Someone named _value.mother dropped off <<print _childrenText>>, and a paternity test with your name on it to match."
			<<else>>
				"A <<print _value.description or _value.mother>> dropped off <<print _childrenText>>, and a paternity test with your name on it."
			<</if>>
			<<set _continues to true>>
		<</for>>
	<</if>>
	<br><br>

	"They're in the ward already.
	<<set _knownPregnancyCount to knowsAboutChildrenTotal("pc","Bailey","home")>>
	<<if _knownPregnancyCount is 1 or !$ward_unlocked>>
		You're responsible for your offspring's care," <<he>> says. "If I have to intervene, it'll cost you an extra <span class="red">£100</span> a week, starting now. They don't leave the nursery. Ever."
	<<elseif _knownPregnancyCount lte 4>>
		You already know that you're responsible for your offspring's care," <<he>> says. "If I have to intervene, it'll cost you an extra <span class="red">£100</span> a week, each."
	<<else>>
		You're an irresponsible slut," <<he>> says. "Remember that if I have to intervene in the care of your offspring, it'll cost you an extra <span class="red">£100</span> a week, each."
		<<npcincr Bailey love -1>><<llove "Bailey">>
	<</if>>
	<<if $baileydefeatedchain gte 3>>
		You see <<him>> sneer, but only for a brief instant. "I'd rather not make someone else take care of your twerps, but if you keep being a difficult little shit, don't think you'll be allowed to see them again."
		<<npcincr Bailey love -1>><<llove "Bailey">>
	<<elseif _homeBabyRent>>
		You see <<his>> face soften for a moment, but it was so slight that you might have imagined it. "And if you want the luxury of being able to take care of them, you'll pay up."
	<</if>>
	<br><br>

	<<if !$ward_unlocked>>
		<span class="gold">You can now access the youth ward, and the nursery.</span>
		<br><br>
	<</if>>
	<<set $ward_unlocked to true>><<run delete $babyIntros.Bailey>>
<</widget>>

<<widget "rent_avery">>
	<<if $avery_mansion>>
		<<if $avery_fate is "fallen" or $avery_fate is "kicked">>
			<<if !$avery_mansion.fallen_bailey_message>>
				<<set $avery_mansion.fallen_bailey_message to true>>
				<<if !$avery_mansion_rent_confront>>
					<<set $avery_mansion_rent_confront to 1>>
				<</if>>
				<span class="black">Avery has fallen.</span> Because of that, <span class="red"><<nnpc_he "Avery">> can no longer pay Bailey for you</span>.
				<br><br>
			<</if>>
		<<elseif !$avery_mansion.bailey_message>>
			<<set $avery_mansion.bailey_message to true>>
			<span class="red">"That idiot on Danube Street is refusing to pay,"</span> Bailey says. "So it falls to you. If that's a problem, take it up with <<nnpc_him Avery>>."
			<br><br>
			<i>Avery will refuse to pay Bailey if you don't show up at the mansion, or fail to adequately please <<nnpc_him Avery>>.</i>
			<br><br>
		<</if>>
	<</if>>
<</widget>>

:: Rent Pay
<<effects>>

<<rentpay $phase2>>
<<if $bus isnot "hospital">><<perfumeryMoment "Bailey" "rent" 30>><</if>>
<<set $bailey_office_seduced_this_cycle to false>>

<<if $phase2 is "thug">>
	You're left alone in the main hall.
	<br><br>

	<<link [[Next|Orphanage]]>><<endevent>><</link>>
<<else>>
	<<if $bus is "hospital">>
		<<if crimeSumCurrent() gte 1000>>
			<<link [[Next|Hospital Arrest]]>><<pass 10>><<endevent>><</link>>
		<<else>>
			<<link [[Next|Hospital front]]>><<pass 10>><<endevent>><</link>>
		<</if>>
	<<else>>
		<<if $phase is 1>>
			<<endevent>>
			<<npc Robin>><<person1>>
			You see Robin run up to you from around a corner as you exit <<his>> room. "You're okay!" <<He>> tackles you into a hug.
			"Bailey took me away last night and I thought something awful was going to happen," <<he>> says before calming down.
			<br><br>

			You return the embrace before returning to your room.
			<br><br>

		<</if>>
		<<link [[Next|Bedroom]]>><<endevent>><</link>>
	<</if>>
<</if>>
<br>

:: Rent Pay Robin
<<effects>>

<<rentpay $phase2>>

<<endevent "phaseless">>
<<npc "Robin">><<person1>>
<<if $phase2 is "thug">>
	You're left in the hall with Robin. <<He>> hugs you softly after Bailey leaves. "I'm so sorry," <<he>> says.
	<br><br>

	After a brief hug, <<he>> walks back to <<his>> room. "If you need anything, just let me know."
	<br><br>

	<<link [[Next|Orphanage]]>><<endevent>><</link>>
<<else>>
	Robin hugs you softly after Bailey leaves. "I'm so sorry," <<he>> says.

	<<if $bus is "hospital">>
		<br><br>

		<<set $companion to "Robinrent">>
		<<if crimeSumCurrent() gte 1000>>
			<<link [[Next|Hospital Arrest]]>><<pass 10>><<endevent>><</link>>
		<<else>>
			<<link [[Next|Hospital front]]>><<pass 10>><<endevent>><</link>>
		<</if>>
	<<else>>
		<<if $inRobinsRoom>>
			<<He>> sits down on <<his>> bed. "That was scary."
			<br><br>

			After a moment to make sure Robin is okay, you leave the room and go back to the main hall.
			<br><br>

			<<link [[Next|Orphanage]]>><<endevent>><</link>>
		<<else>>
			<<He>> eventually leaves your bedroom. "If you need anything, just let me know."
			<br><br>

			<<link [[Next|Bedroom]]>><<endevent>><</link>>
		<</if>>
	<</if>>
	<<unset $inRobinsRoom>>
<</if>>
<br>

:: Rent Refuse
<<effects>><<speechresolve>>
<<person1>>

<<switch _speechAttitudeResolved>>
	<<case "bratty">>
		You stare at <<him>> in defiance. "I'm not paying you. I don't care what you do to me."
	<<case "meek" "shy">>
		"N-no," you stutter, startled by your own nerve. "I-I won't."
	<<case "polite" "flamboyant">>
		"No," you say, with strained courtesy. "I won't pay you."
	<<case "docile">>
		You draw in a small breath. "No... I won't pay you."
	<<case "confident">>
		"No," you say, holding <<his>> gaze. "I'm not paying you."
	<<case "cruel">>
		You let out a dry little laugh. "I'm not paying you. You'll have to do better than loom in my doorway." 
	<<default>>
		"The money isn't yours," you say. "I'm keeping it."
<</switch>>
<br><br>
<<rentnopay>>

:: Rent Refuse Robin
<<effects>><<set $baileypaychain to 0>><<speechresolve>>
<<set $baileyRefusedToPayTotal += $rentMoney + ($babyRent || 0)>>
<<set $baileyRefusedToPayTotalStat += $rentMoney + ($babyRent || 0)>>
<<person1>>
<<switch _speechAttitudeResolved>>
	<<case "bratty">>
		You stare at <<him>> in defiance. "I'm not paying you. I don't care what you do to me, but leave Robin out of this."
	<<case "meek" "shy">>
		"N-no," you stutter, shocked by your own bravery. "I-I won't let you hurt either of us..."
	<<case "polite" "flamboyant">>
		"No," you say. "Do what you want to me, but leave Robin out of this." 
	<<case "docile">>
		You shake your head. "Please don't involve Robin. Do what you want with me, but leave <<nnpc_him "Robin">> alone."
	<<case "confident">>
		"Punish me if you like," you say. "But Robin stays out of this." 
	<<case "cruel">>
		You look Bailey up and down. "You're pathetic, dragging Robin into this because you can't get what you want from me." 
	<<default>>
		"The money isn't yours," you say. "Punish me however you want, but leave <<nnpc_him "Robin">> out of this."
<</switch>>
<br><br>

<<if $phase2 is "thug">>
	"You came all this way just to act like a selfish brat?" Bailey scoffs. <<He>> stares at you with cold indifference before speaking again.
	<br><br>

	"Oh well," <<he>> says, now smiling.
<<else>>
	"That's okay," <<he>> says, smiling.
<</if>>
"I've already made arrangements. I don't know what they intend for you two, and frankly I don't care."
<<He>> produces a hood and length of rope. "Hold still."
<br><br>

<<if isPregnancyEnding()>>
	<<set $phase to 1>><<set $rentPregInterruption to "refused">><<include "Rent Pregnant">>
<<else>>
	<<link [[Submit|Rent Intro]]>><<set $phase to 1>><<endevent "phaseless">><</link>>
	<br>
	<<if $bus is "hospital">>
		<<link [[Fight|Rent Hospital Fight Robin]]>><<set $fightstart to 1>><</link>>
		<br>
	<<else>>
		<<link [[Fight|Rent Robin Fight]]>><<set $fightstart to 1>><</link>>
		<br>
	<</if>>
<</if>>

:: Rent Seduce
<<effects>><<speechresolve>>
<<set $baileyseduced to 1>>
<<set _loanSurcharge to (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0)>>
<<bratTaxCalc>>
<<set _rentTotal to ($rentMoney + ($babyRent or 0) + ($bratTax or 0) + _loanSurcharge)>>

<<switch _speechAttitudeResolved>>
	<<case "meek" "shy">>
		"P-Please, <<sir>>," you plead. "Can't I p-pay you some other way?" 
	<<case "polite" "flamboyant">>
		"Perhaps we can come to some other arrangement," you say, trying for a sweeter tone. "I'll make it worth your while."
	<<case "docile">>
		"Please," you murmur, letting your hands drift over your body. "Couldn't I pay you another way?"
	<<case "confident">>
		"There are other ways to settle this," you say. "I can make it worth your time."
	<<case "bratty">>
		"You know," you say, running your hands over your body, "I could pay you in a different way. A much better way." 
	<<case "cruel">>
		"Surely a greedy thing like you can be distracted," you say, touching yourself. "Or do you need me to spell it out?"
	<<default>>
		"Can't I pay you some other way?" you ask, licking your lips. "I'll make it worth it."
<</switch>>
<<promiscuity2>>

<<if $phase is 1>>
	Bailey smirks. <<His>> cold hand snakes over your shoulder, around the back of your head, and <<he>> begins to stroke your hair.
	<br>
	<<person1>>Then, without warning, <<he>> grabs a fistful of your hair and yanks you close, your face inches from <<his>> own.<<npcincr Bailey dom 1>><<gdom "Bailey">><<npcincr Bailey lust 1>><<glust "Bailey">>
	<br>
	"Nice try," <<he>> hisses. "But that's not going to save your ass. Not this time."
	<<if activeInsanityTrait()>>
		<br><br>
		With Bailey still gripping your hair, you start laughing into <<his>> face. You try to speak, but another burst of laughter interrupts you.
		<<if $worn.face.type.includes("gag")>>
			Your laughter comes muffled through your $worn.face.name. <span class="lustful">"Mmhff...hAhAhAHA!!!"</span>
		<<else>>
			<span class="lustful">"HaHAHahAhAHA!!!</span>
			<<speechresolve>>
			<<switch _speechAttitudeResolved>>
				<<case "polite" "docile">>
					You really expect that to frighten me, Bailey?!"
				<<case "bratty">>
					Oh, go on! Say it again! Maybe I'll be scared this time!!"
				<<case "flamboyant">>
					What a performance! Do you practise that in the mirror?!"
				<<case "cruel">>
					You had to pull me closer to make sure I heard that pathetic threat?!"
				<<default>>
					You think that will scare me?!"
			<</switch>>
		<</if>>
		<br><br>
		Bailey's fingers tighten in your hair. "Something funny?" <<he>> asks. You keep laughing, and <<he>> frowns. "Keep it up. You still owe me."
	<</if>>
	<br><br>

	<<He>> releases you and presses <<his>> hand on your chest, shoving you. You stumble backwards as Bailey takes a menacing step towards you
	<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
		with <<his>> palm open expectantly. "Your payment. Now."
		<br><br>

		<<link [[Pay|Rent Pay]]>><</link>>
		<br>
		<<if $syndromebailey isnot true or !(setup.inflation and setup.inflation.baileyAggressive())>>
			<<link [[Refuse|Rent Refuse]]>><<def 1>><</link>>
			<br>
		<</if>>
	<<else>>
		and begins unwinding the rope. "Don't worry," <<he>> taunts. "I'll put in a good word for you."
		<br><br>

		<<link [[Submit|Rent Intro]]>><<endevent>><</link>>
		<br>
		<<if $bus is "hospital">>
			<<link [[Fight|Rent Hospital Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<<else>>
			<<link [[Fight|Rent Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<<else>>
	"You can pay me," <<person1>><<he>> sneers. "With money. <<printmoney _rentTotal "pink">>. <span class="red">That's what your body's worth.</span>"
	<<npcincr Bailey lust 1>><<glust "Bailey">>
	<br><br>

	<<if $baileydefeatedchain gte 1 and $phase2 isnot "thug">>
		<<person2>>"I'll take that as payment," the <<person>> beside <<nnpc_him Bailey>> says.
		<br><br>

		Bailey cows <<him>> with a glare, and <<he>> looks away.
		<<person1>>
		<br><br>
	<</if>>
	It's too late to negotiate with Bailey. <<He>> wants <<his>> payment.

	<<if ((setup.inflation ? setup.inflation.rentPayable() : $money) + ($baileyDeposit or 0)) gte _rentTotal>>
		<<He>> holds out <<his>> hand.
		<br><br>


		<<link [[Pay|Rent Pay]]>><</link>>
		<br>
		<<if $syndromebailey isnot true or !(setup.inflation and setup.inflation.baileyAggressive())>>
			<<link [[Refuse|Rent Refuse]]>><<def 1>><</link>>
			<br>
		<</if>>

	<<else>>
		"Now like I said." <<He>> brandishes the rope at you. "Hold still."
		<br><br>

		<<link [[Submit|Rent Intro]]>><<endevent>><</link>>
		<br>
		<<if $bus is "hospital">>
			<<link [[Fight|Rent Hospital Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<<else>>
			<<link [[Fight|Rent Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<</if>>

:: Rent Pregnant
<<if $phase is 1>><<silently>><<effects>><</silently>><<else>><<effects>><</if>>
<<endevent "phaseless">><<npc Bailey>><<generateyv2>><<person1>>
<<set $rentPregCount to ($rentPregCount or 0) + 1>>
<<earnFeat "Pregnant Pause">>
<<switch $speech_attitude>>
	<<case "meek">>"Wai..." You clutch your <<bellyDescription>>, sweating and heaving between words. "Wait! Please... <<if playerAwareTheyArePregnant()>>My baby!<<else>>It hurts!<</if>> Please..."
	<<case "bratty">>"Are you bloody daft?" you yell through gritted teeth, feeling lightheaded. "Can't you see <<if playerAwareTheyArePregnant()>>I'm in labour<<else>>something's wrong with me<</if>>?!"
	<<default>>"Stop! Wait..." You wince as a jolt of pain shoots through you. "<<if playerAwareTheyArePregnant()>>My baby<<else>>It hurts<</if>>... I need to get to the hospital!"
<</switch>>
<br><br>

Bailey steps forward with a cold expression.
<<if $rentPregCount gte 3>>
	"Is this a joke?" <<he>> sneers. "You've gotten way too comfortable doing this."
	<br><br>
	<<He>> looks you over just to be sure. Just like before, the realisation that you're telling the truth finally hits <<him>>.
<<else>>
	"<<if playerAwareTheyArePregnant()>>Right, figures you'd pull something like that<<else>>I don't have time for your excuses<</if>>," <<he>> sneers.
	<<if $phase is 1>>
		"You're not getting out of this that easily. Now I won't ask again. Hold. Still."
	<<else>>
		"Am I to assume then that you're not paying? That's fine too." <<He>> produces a hood and length of rope. "Hold still."
	<</if>>
	<br><br>
	<<He>> continues to approach you with the rope,
	<<if $rentPregCount gte 2>>
		then <<he>> looks you over and shakes <<his>> head.
	<<else>>
		but hesitates for a moment as <<his>> gaze meets yours. <<His>> eyes squint as <<he>> looks you over one more time, before they suddenly go wide.
	<</if>>
<</if>>
<br><br>
<<switch $rentPregCount>>
	<<case 1>>"Shit."
	<<case 2>>"Fuck, again?"
	<<case 3 4>>"For fuck's sake."
	<<case 5 6>>"For <i>fuck's</i> sake."
	<<case 7 8 9>>"You just don't know when to quit..."
	<<default>>But <<he>> says nothing, having already resigned <<himself>> to this depraved routine of yours.
<</switch>>
<br><br>
The next thing you know, you're being grabbed by your shoulders and rushed through the main hall. You spot orphans left and right, all turning to look at the commotion. "Move," you hear as a <<person2>><<personsimple>> who stood a bit too close gets shoved to the floor.
<br><br>
You're led outside to Bailey's car. <<He>> yanks open the door and pushes you into the front seat before throwing the seatbelt over you. With heavy eyes, you stare out the window as <<he>> circles around to the driver's side.
<br><br>
Then, there are only the fading sounds of an engine to lull you into darkness.
<br><br>
<<link [[Everything fades to black...|Pregnancy Birth Hospital]]>><<endevent>><<pass 15>><<set $phase to 1>><</link>>
<br>

:: Rent Pregnant Return
<<effects>>
<<npc Bailey>><<person1>>

Bailey finally drags <<his>> gaze from the nursery back to you.
<<if !$rentPregInterruption>>
	"Now, time to pay up."
<<else>>
	"Now that this little 'incident' of yours has been taken care of,
	<<if $rentPregInterruption is "told">>
		it's time to pay up."
	<<elseif $rentPregInterruption is "refused">>
		I'm going to give you one last chance to pay up."
	<<elseif $rentPregInterruption is "broke">>
		it's about time we resume where we'd left off."
	<</if>>
<</if>>
<<if $baileydefeatedchain gte 3 or ($robinpaid is 1 and $bus is "home" and $robinfirstrentfight isnot 1 and ($rentTime lte -14 or $rentThug?.anger gte 4))>>
	<<generateRole 1 0 "thug">><<generateRole 2 0 "thug">>
	Two thugs flank <<him>> on either side.
<<elseif $baileydefeatedchain gte 1>>
	<<generateRole 1 0 "thug">>
	A thug silently approaches you both.
<</if>>
<br><br>
<<if $rentPregInterruption is "broke">>
	<<if $robinfirstrentfight is 1>>
		<<He>> smiles as <<he>> produces a hood and length of rope. "Hold still."
		<br><br>

		<<link [[Submit|Rent Intro]]>><<set $phase to 1>><<endevent "phaseless">><</link>>
		<br>
		<<link [[Fight|Rent Robin Fight]]>><<set $fightstart to 1>><</link>>
		<br>
	<<else>>
		<<if $robinpaid is 1 and $bus is "home" and $robinfirstrentfight isnot 1 and ($baileydefeatedchain gte 3 or $rentTime lte -14 or $rentThug?.anger gte 4)>>
			<<set $robinfirstrentfight to 1>>
			"I've learned my lesson. Trying to get value out of you directly is fruitless."
			<br><br>

			On an unseen signal, the thugs advance on you.
			The <<person3>><<person>> reaches for you. You duck under <<his>> arm, but the <<person2>><<person>> grabs yours.
			The <<person3>><<person>> grabs your other arm, and they hold you there.
			<br><br>

			<<link [[Next|Rent First Robin Fight]]>><<set $fightstart to 1>><<set $combatPhase to "talk">><<set $robinRentEvent to 1>><<set $timer to 5>><</link>>
		<<else>>
			<<He>> smiles as <<he>> produces a hood and length of rope. "Hold still."
			<br><br>

			<<link [[Submit|Rent Intro]]>><<endevent>><</link>>
			<br>
			<<link [[Fight|Rent Fight]]>><<set $fightstart to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<<else>>
	You look back at Bailey, confused and still somewhat dazed from the whole experience.
	<br><br>
	"What? You didn't think popping out some <<pluralise $litter_size "brat">> was going to get you out of your obligations, did you? You still owe me, and I intend to collect."
	<br><br>
	You had almost forgotten all about that. A silent moment passes between you before <<he>> rolls <<his>> eyes and drops <<his>> voice.
	<<endevent>><<rentdue>>
<</if>>
<<unset $litter_size>><<unset $rentPregInterruption>>

:: Rent Intro
<<set _baileySellKickIncluded to false>>
<<set _robin to statusCheck("Robin")>>
<<set _robinIsPresent to ($phase is 1)>>
<<set _andRobin to (_robinIsPresent ? "and Robin" : "")>>
<<npc Bailey 1>>

