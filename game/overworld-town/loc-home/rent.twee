:: Rent First Robin Fight
<<if $fightstart is 1>>
	<<set $fightstart to 0>>
	<<set $enemyno to 1>>
	<<set $head to "grappled">>
	<<set $leftarm to "grappled">><<set $rightarm to "grappled">><<set $NPCList[1].lefthand to "arms">><<set $NPCList[2].righthand to "arms">>
	<<neutral 1>>

	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
<</if>>

<<effects>><<effectsman>>
<br>
<<person1>>
<<if $combatPhase is "talk">>
	<<switch $timer>>
		<<case 4>>
			Bailey stares at you.
		<<case 3>>
			Bailey turns and walks away.
		<<case 2>>
			Bailey walks down the hall and turns a corner, out of sight.
		<<case 1>>
			You hear Bailey say something, <span class="purple">followed by a <<nnpc_gendery "Robin">> screaming</span>.
		<<default>>
			Bailey walks back from the hallway, <span class="red">dragging Robin by <<nnpc_his "Robin">> hair</span>.
			<<set $combatPhase to "Robin">><<set $timer to 2>><<set $baileySpoke to 0>>
	<</switch>>
	<br>
	<span class="red">The <<person2>><<person>> and <<person3>><<person>> hold you firm.</span>
<<elseif $combatPhase is "Robin">>
	<<if $timer gte 1>>
		<<switch $baileySpoke>>
			<<case 2>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechScreamForHelp is 1 or $speechDemand is 1 or $speechApologiseUnforgiving is 1>>
					"Save your breath," Bailey says. "If you really want to save <<nnpc_him "Robin">>, it's not too late to pay."
				<<else>>
					"I told you, all that time ago," Bailey says. "Get me my money... or I'll find a way to extract value from you."
				<</if>>
			<<case 1>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechApologiseUnforgiving is 1>>
					Bailey rolls <<his>> eyes. "If you'd paid me on time, maybe you wouldn't be crying your eyes out now."
					<<set $baileySpoke++>>
				<<elseif $speechScreamForHelp is 1 or $speechDemand is 1>>
					"You think you're going to convince me with shouting?" Bailey sneers.
					<<set $baileySpoke++>>
				<<else>>
					"Don't know why you took this waif's debt in the first place if you weren't ready to pay it," Bailey sneers.
				<</if>>
			<<default>>
				<<if $speechPlead is 1 or $speechApologiseRejected is 1 or $speechApologiseUnforgiving is 1>>
					Bailey scoffs at you. "Oh, now you're sorry? Now that there's consequences?"
					<<set $baileySpoke++>>
				<<elseif $speechScreamForHelp is 1 or $speechDemand is 1>>
					"Shut up," Bailey snaps at you. "You didn't pay the price, so <<nnpc_he "Robin">> will."
					<<set $baileySpoke++>>
				<<else>>
					"You see?" Bailey says, looking at Robin. "<<pShe "Bailey">> didn't pay the price, so you will."
				<</if>>
		<</switch>>
		<<if C.npc.Robin.trauma gte 20 or C.npc.Robin.dom lte 30>>
			<<print either("Robin stares at you with teary eyes.","Robin sniffles.","Robin feebly struggles in Bailey's grip.","Robin reaches for you.")>>
		<<else>>
			<<print either("Robin holds a brave face.","Robin grits <<nnpc_his \"Robin\">> teeth.","Robin struggles in Bailey's grip.","Robin almost wrenches <<nnpc_himself \"Robin\">> from Bailey's grasp.")>>
		<</if>>
	<<else>>
		"You want to keep <<nnpc_him "Robin">> safe?" Bailey asks. "Say it to me. Tell me you'll pay me from now on."
		<<if C.npc.Robin.trauma gte 1 or C.npc.Robin.dom lte 30>>
			Robin hiccups.
		<<else>>
			Robin shakes <<nnpc_his "Robin">> head.
		<</if>>
		<<set $combatPhase to "pay">><<set $timer to 2>>
	<</if>>
	<br>
	<span class="red">The <<person2>><<person>> and <<person3>><<person>> hold you firm.</span>
<<elseif $combatPhase is "pay">>
	<<if $speechPay is 1>>
		"There," Bailey sneers. "Was that so hard?" <<He>> gestures to <<his>> thugs, and they let go of your arms.
		<<set _fin to 1>>
	<<elseif $speechPay is -1>>
		"Well, isn't that a shame," Bailey sneers. "But I'm feeling generous. You can still save <<nnpc_him "Robin">>. Just stay still."
		<br>
		Robin desperately shakes <<nnpc_his "Robin">> head.
		<<set $combatPhase to "still">><<set $timer to 2>>
	<<elseif $timer is 1>>
		Bailey pretends to check <<his>> watch. "I'm a busy <<personsimple>>. If you won't <i>pay up</i>, I'm leaving."
		<br>
		<span class="red">The <<person2>><<person>> and <<person3>><<person>> hold you firm.</span>
	<<else>>
		"I'm done here," Bailey scoffs. "If you didn't want to pay for <<nnpc_him "Robin">>, you shouldn't have wasted my time in the first place."
		<<set $finish to 1>><<set _fin to 1>>
	<</if>>
<<elseif $combatPhase is "still">>
	<<if _defiance is undefined>>
		"Good," Bailey says, nodding to the thugs. <<He>> nods to the thugs holding your arms, and they march you out of the orphanage.
		<br><br>
		<span class="red">Robin shouts your name through tears as you're led out.</span>
		<<set _fin to 1>>
	<<elseif $timer is 1>>
		"Did you hear me?" Bailey growls. "If you don't want <<nnpc_him "Robin">> to get it, <i>don't struggle</i>. Just stay still."
		<br>
		<span class="red">The <<person2>><<person>> and <<person3>><<person>> hold you firm.</span> The <<person2>><<persons>> grip tightens.
	<<else>>
		Bailey scowls. "I'm done here. If you didn't want to pay for <<nnpc_him "Robin">>, you shouldn't have wasted my time in the first place."
		<<set $finish to 1>><<set _fin to 1>>
	<</if>>
<</if>>
<br><br>
<<if _fin isnot 1>>
	<<actionsman>>
<</if>>

<<if $combatPhase is "pay" and $speechPay is 1>>
	<span id="next"><<link [[Next|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "pay">><</link>></span><<nexttext>>
<<elseif $combatPhase is "still" and _defiance is undefined>>
	<span id="next"><<link [[Next|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "still">><</link>></span><<nexttext>>
<<elseif $finish is 1>>
	<span id="next"><<link [[Next|Rent First Robin Fight Finish]]>><<endevent>><<set $phase to "finish">><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Rent First Robin Fight]]>><</link>></span><<nexttext>>
<</if>>
<<turnend>>

:: Rent First Robin Fight Finish
<<effects>><<speechresolve>>
<<unset $robinRentEvent>>
<<set _robin to statusCheck("Robin")>>
<<npc Robin 1>><<person1>>

<<if $phase is "pay">>
	Bailey lets go of Robin, who runs up to and embraces you. <<He>> sobs softly.
	<br><br>
	<<rentpay>>

	Bailey walks off, and Robin continues clinging to you.
	<<if _robin.trauma gte 40>>
		"I th-thought..." <<He>> chokes up and holds you tighter.
	<<else>>
		"I thought I was going to lose you," <<he>> says after a long moment.
	<</if>>
	<br><br>

	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			You gently hold <<his>> hand, then <<if $robinromance is 1>>press a comforting kiss to <<his>> forehead<<else>>rest your other arm around <<his>> shoulder<</if>>.
		<<case "polite" "flamboyant">>
			You smooth Robin's hand between both of yours and <<if $robinromance is 1>>kiss <<his>> forehead with tenderness<<else>>hold <<him>> steady until <<his>> breathing evens out<</if>>.
		<<case "confident" "bratty" "cruel">>
			You pull Robin in close first, then <<if $robinromance is 1>>tip <<his>> face up enough to place a reassuring kiss on <<his>> forehead<<else>>wrap an arm around <<his>> shoulder and keep <<him>> there<</if>>.
		<<default>>
			You gently hold <<his>> hand, and <<if $robinromance is 1>>give <<him>> a comforting kiss on the forehead<<else>>wrap your other arm around <<his>> shoulder comfortingly<</if>>.
	<</switch>>
	<<takeHandholdingVirginity "Robin">>
	<br><br>

	Robin manages to calm down, the tears ebbing away.
	<<if _robin.dom gte 30>>
		"I need to become stronger..." <<he>> whispers under <<his>> breath, shaking <<his>> head.
	<</if>>
	"Thank you. For everything," <<he>> says. <<He>> eventually releases <<his>> embrace and goes back towards <<his>> room.
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[Next|Orphanage]]>><</link>>
<<elseif $phase is "still">>
	The thugs drag you away. You hear Robin crying for you. <<His>> cries eventually fade away as you leave the orphanage.
	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			Each step away feels final, and by the time Bailey stops you your legs have gone weak.
		<<case "polite" "flamboyant">>
			You try not to let Bailey see how badly the sound rattles you, but the effort only makes your chest ache more.
		<<case "confident" "bratty" "cruel">>
			You cling to anger on the walk out, because it is easier to carry than the guilt threatening to swallow you whole.
		<<default>>
			By the time Bailey stops you, Robin's voice feels far away and no less awful for it.
	<</switch>>
	You are met face to face with Bailey.
	<br><br>

	<<npc Bailey 2>><<person2>>
	"Now was that so hard?" Bailey sneers as <<he>> covers your head and binds your arms. "You saved your little friend. This time."
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[Next|Rent Intro]]>><</link>>
<<else>>
	<<robinPunishment "mansion">>
	Bailey drags Robin away. You struggle against the thugs' grip, but can't break free.
	<<switch _speechAttitudeResolved>>
		<<case "meek" "shy" "docile">>
			Helplessness settles over you.
		<<case "polite" "flamboyant">>
			You call after Robin once, then bite the rest back when you realise Bailey wants to hear you break.
		<<case "confident" "bratty" "cruel">>
			You fight hard enough to make the thugs curse, though it changes nothing except the ache in your arms.
		<<default>>
			All you can do is watch them go.
	<</switch>>
	<br><br>

	Eventually Bailey returns, and sneers at you. "Since I'm so generous, this will be a warning. Get me my money, or <<he>>'ll pay the price."
	<br><br>

	<<robinRentUnsafeMessage>>

	<<endcombat>><<clotheson>>

	<<link [[Next|Orphanage]]>><</link>>
<</if>>

:: Thug Rent
<<set $location to "home">><<effects>>

<<if $phase is "unwilling">>
	After some time, the car comes to a stop in front of the orphanage. "We're here. Don't even think about running, it's way too late for that," the <<person1>><<person>> says.
	<<if $exposed gte 1>>
		<<He>> eyes over your exposed body. "Cover yourself, we don't want any onlookers getting the wrong idea," <<he>> says, tossing you a towel. You wrap it around yourself.
		<<towelup>>
	<</if>>
	<<switch $event.buffer.length>>
		<<case 1>><<He>> roughly pulls you out of the car and leads you into the orphanage.
		<<case 2>><<He>> roughly pulls you out of the car while the <<person2>><<person>> keeps a close eye on you. <<He>> watches the <<person1>><<person>> lead you all the way to the front door before getting back into the car.
		<<case 3>><<He>> roughly pulls you out of the car while the <<person2>><<person>> and <<person3>><<person>> keep a close eye on you. They watch the <<person1>><<person>> lead you all the way to the front door before getting back into the car.
	<</switch>>
	<br><br>
	You see Bailey waiting for you in the main hall<<if $robinfirstrentfight is 1>> along with a tied-up Robin<</if>>.
<<elseif $phase is "willing">>
	After some time, the car comes to a stop in front of the orphanage. "We're here. Get going, you've kept <<nnpc_him "Bailey">> waiting long enough," the <<person1>><<person>> says.
	<<if $exposed gte 1>>
		<<He>> eyes over your exposed body. "Can't have you looking like that in front of the boss," <<he>> says, tossing you a towel. You wrap it around yourself.
		<<towelup>>
	<</if>>
	<<switch $event.buffer.length>>
		<<case 1>>You step out of the car and are led into the orphanage.
		<<case 2>>You step out of the car and are led into the orphanage under the watchful eye of the <<person2>><<person>>. Once you make it to the front door, <<he>> gets back into the car.
		<<case 3>>You step out of the car and are led into the orphanage under the watchful eye of the <<person2>><<person>> and <<person3>><<person>>. Once you make it to the front door, they get back into the car.
	<</switch>>
	<br><br>
	You see Bailey is already waiting for you in the main hall<<if $robinfirstrentfight is 1>> with a tied-up Robin<</if>>.
<<elseif $phase is "unwilling van">>
	After some time, the van comes to a stop. "Looks like we've arrived," the <<person1>><<person>> says, putting away <<his>> phone. "Get up. And don't even think about running, it's way too late for that."
	<<if $exposed gte 1>>
		<<He>> eyes over your exposed body. "Cover yourself, we don't want any onlookers getting the wrong idea," <<he>> says, tossing you a towel. You wrap it around yourself.
		<<towelup>>
	<</if>>
	<br><br>
	All of them walk you to the orphanage door, but only you and the <<person>> enter. You see Bailey is already waiting for you in the main hall<<if $robinfirstrentfight is 1>> with a tied-up Robin<</if>>.
<</if>>
<<saveNPC 0 "rent_thug">><<endevent>>

<<if $robinfirstrentfight is 1>>
	<<thugrentduerobin>>
<<else>>
	<<thugrentdue>>
<</if>>

:: Tutorial Bailey
<<set $outside to 1>><<set $location to "town">><<effects>>
<<npc Bailey 1>>

You feel someone put their hand on your shoulder, turning you see it's Bailey.
<br><br>
"Welcome to the outside world, I hope you learned your lesson after not doing anything all week," <<he>> says, "I expect you to try harder this week, you're not going to like to see what happens if you fail to pay me again."
<br><br>
You're escorted by Bailey back to your bedroom and left alone.
<br><br>

<<link [[Next|Bedroom]]>><<endevent>><</link>>

:: Widgets Bailey Confiscation [widget]
/* Bailey Confiscation System */

<<widget "baileyConfiscationList">>
	<<set _list to baileyConfiscationParts()>><<if _list.length is 0>>your things<</if>><<for _p range _list>><<print _p.sep>><<if _p.kind is "furniture">><<if _p.icon>><<furnitureicon _p.icon>> <</if>><<elseif _p.kind is "clothing">><<clothingicon _p.item _p.slot>> <</if>><<print _p.name>><</for>>
<</widget>>

<<widget "baileyConfiscationListFull">>
	<<set _list to baileyConfiscationGrouped()>><<if _list.length is 0>>your things<</if>><<for _p range _list>><<print _p.sep>><<if _p.count gt 1>><<print _p.count>>× <</if>><<if _p.kind is "furniture">><<if _p.icon>><<furnitureicon _p.icon>> <</if>><<elseif _p.kind is "clothing">><<clothingicon _p.item _p.slot>> <</if>><<print _p.name>><</for>>
<</widget>>

<<widget "baileyRentConfiscation">>
	<<babyRent true>>
	<<set _weekRent to $rentMoney + ($babyRent || 0)>>
	<<set _bundle to baileyConfiscationBundle(_weekRent)>>
	<<if _bundle.items.length is 0>>
		A hand rests on your shoulder from behind. <span class="red">It's Bailey.</span>
		<<if $robinfirstrentfight and ($baileypaychain lt 2 or $rentTime lte -1) and _robinAtOrphanage>>
			<<rentduerobin 0>>
		<<else>>
			<<rentdue 0>>
		<</if>>
	<<else>>
		<<npc Bailey>><<person1>>
		<<run baileyConfiscationApply(_bundle)>>

		You step into the orphanage and see someone leaning against the hallway outside your room. <span class="red">It's Bailey.</span>
		<br><br>

		Across from <<him>>, you see a few goons carrying your <<baileyConfiscationList>> out of your room.	<span class="red">They're taking your belongings!</span> Bailey watches them work, unbothered.
		<br><br>

		"You've been dodging rent for weeks," <<he>> says. "Did you think I'd just let that slide?"
		<br><br>

		The goons start filing past you, whisking your stuff away without sparing you a glance.
		<br><br>

		"You have one week to pay up properly in my office before I pawn off your junk." <<He>> turns away from you, tossing a hand over <<his>> shoulder dismissively. "Don't make me come looking again."
		<br><br>

		<<set $rentTime to 7>><<set $baileyRefusedToPay to 0>>
		<<link [[Don't fight|Orphanage]]>><<endevent>><</link>>
		<br>
		<<link [[Fight|Bailey Confiscation Fight]]>><<set $fightstart to 1>><<generateRole 1 0 "thug">><<generateRole 2 0 "thug">><<generateRole 3 0 "thug">><</link>><<dangerousText>>
		<br>
	<</if>>
<</widget>>

<<widget "baileyRentReclaimOption">>
	<<if $bailey_confiscation>>
		<<babyRent true>><<bratTaxCalc>>
		<<set _owed to Math.max(0, $rentMoney + ($babyRent or 0) + ($bratTax or 0) + (setup.hbsc and setup.hbsc.loanRentSurcharge ? setup.hbsc.loanRentSurcharge() : 0) - ($baileyDeposit or 0))>>
		<<if (setup.inflation ? setup.inflation.rentPayable() : $money) gte _owed>>
			<<highicon>><<link [[Reclaim your confiscated things|Bailey Rent Reclaim]]>><</link>> (<<printmoney _owed>>)
			<br>
		<<else>>
			<span class="blue">Reclaim your confiscated things <<printmoney _owed>> (You can't afford it)</span>
			<br>
		<</if>>
	<</if>>
<</widget>>

<<widget "baileyConfiscationNotice">>
	<<if $bailey_confiscation_lost is 1>>
		<<set $bailey_confiscation_lost to 0>>
		<span class="red">You didn't pay Bailey in time to get your things back.</span> <<nnpc_He "Bailey">> has probably pawned them off.
		<br><br>
	<</if>>
<</widget>>

:: Bailey Rent Reclaim
<<effects>>
<<npc Bailey>><<person1>>
<<set $rentTime to 7>>
<<babyRent>>

<<rentpay>>

<<link [[Next|Orphanage]]>><<endevent>><</link>>

:: Bailey Confiscation Fight
<<if $fightstart is 1>>
	<<set $enemyno to 4>>
	<<set $enemynomax to 4>>
	<<set $fightstart to 0>>
	<<neutral 1>>
	<<maninit>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
	"You'll pay up one way or the other." Bailey says.
	<br><br>
	<<set $phase to 1>>
<</if>>

<<effects>>
<<effectsman>>
<<man>>

<<if $phase is 1>>
	<<set $phase to 2>>
	Orphans arrive to watch the fight, drawn by the noise.
	<br><br>
<</if>>

<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[Next|Bailey Confiscation Fight Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Bailey Confiscation Fight]]>><</link>></span><<nexttext>>
<</if>>

:: Bailey Confiscation Fight Finish
<<effects>>

<<if $enemypleasure gte $enemypleasuremax>>
	<<ejaculation "short">><<set $baileydefeatedlewd += 1>><<set $baileydefeatedchain += 1>><<earnFeat "Bailey's Trouble Maker">>

	<<person1>>One of the watching orphans giggles. Bailey spins to find the culprit, but another laughs behind <<him>>.
	Soon the whole room is filled with laughter. <<He>> looks back at you. "You'll pay for this," <<he>> says, before storming from the room.
	<br><br>

	The <<person2>><<person>> drops your stuff. The <<person3>><<person>> follows Bailey out and the <<person4>><<person>> slinks out after them.
	<br><br>

	The orphans watching cheer loudly over your victory. They help you gather your belongings back into the room.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>>
	<br><br>

	<<run baileyConfiscationRestore()>>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Bedroom]]>><</link>>
<<elseif $enemyhealth lte 0>>
	<<set $baileydefeated += 1>><<set $baileydefeatedchain += 1>>

	<<person1>><<He>> backs off for a moment, surprised by your aggression and nursing a bruise.
	<<He>> notices the crowd formed around the hall. "You'll pay for this. Mark my words." <<He>> storms out.
	<br><br>

	The <<person2>><<person>> drops your stuff. The <<person3>><<person>> follows Bailey out and the <<person4>><<person>> slinks out after them.
	<br><br>

	The orphans watching cheer loudly over your victory. They help you gather your belongings back into the room.
	<<greb>><<ghope>><<reb 1>><<hope 1>><<ltrauma>><<lstress>><<trauma -6>><<stress -12>>
	<br><br>

	<<run baileyConfiscationRestore()>>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Bedroom]]>><</link>>
<<else>>
	<<set $baileydefeatedchain to 0>>
	<<unset $bailey_encroach>>

	You fall to the ground, too hurt to move.
	<<lreb>><<reb -1>>
	<br><br>

	<<set $upperoff to 0>>
	<<set $loweroff to 0>>
	<<set $underloweroff to 0>>
	<<set $underupperoff to 0>>
	<<endcombat>>

	<<link [[Next|Rent Intro]]>><</link>>
<</if>>
