	<</if>>
<</if>>
<<effects>>
<<effectsman>>
<<if $alarm is 1>>
	<<set $alarm to 0>>
	/* Shouting on a stage reaches an audience that paid to hear it. */
	<<switch $undergroundbrothelcontract.masterTrait>>
		<<case "relaxed">>
			Your <<= $per_npc.contract_master?.pronoun is "f" ? "mistress" : "master">> does not move from the edge of the light. The audience decides the noise was part of it.
		<<case "sociable">>
			"There it is," your <<= $per_npc.contract_master?.pronoun is "f" ? "mistress" : "master">> announces, to a roar from the front rows. "I said <<pshe stranger>> had opinions."
		<<case "brooding">>
			Nobody on the stage reacts. Your handler watches from beyond the lights, and keeps watching.
		<<case "lecher">>
			Your handler laughs somewhere behind you, close enough that <<he>> must have come back onto the boards to hear it better.
	<</switch>>
	<br><br>
<</if>>
<<man>>
<<audience>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
	<span id="next"><<link [[Next|Underground Brothel Contract Show Finish]]>><</link>></span><<nexttext>>
