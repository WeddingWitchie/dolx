:: Underground Brothel Contract Widgets [widget]

<<widget "undergroundBrothelContractOffer">>
	<<endevent>>
	<<set _broker to _args[0]>>
	<<if _broker is "Bailey">>
		<<npc Bailey>><<person1>>
		Bailey rests <<his>> elbows on the desk. "You wanted money. I know somewhere that'll pay well for a guaranteed worker."
		<br><br>
		"Same underground brothel you crawled out of," <<he>> says. "This time there'd be a date on the deal. They keep you until then, and you get paid when they let you go. Walk out early and you get nothing."
	<<else>>
		<<npc Briar>><<person1>>
		Briar taps a pen against <<his>> desk. "There's a place below town that pays for longer bookings. Not a show. They'd own your time until the contract ends."
		<br><br>
		"You already know what they're like," <<he>> says. "They won't become gentle because you volunteered. Stay until the agreed date and they'll pay you. Escape early and the agreement is void."
	<</if>>
	<br><br>
	/* Fee quoted at current prices then fixed, so a long booking keeps the value it had when signed. */
	<<brothelicon>><<link [[Discuss one week|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 7, pay: setup.inflation.price(250000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 250000>></span>
	<br>
	<<brothelicon>><<link [[Discuss two weeks|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 14, pay: setup.inflation.price(600000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 600000>></span>
	<br>
	<<brothelicon>><<link [[Discuss one month|Underground Brothel Contract Terms]]>><<set $undergroundbrothelcontract to {broker: _broker, end: Time.days + 30, pay: setup.inflation.price(1500000), penalty: 0, obedience: 0}>><</link>> | <span class="green">+<<printprice 1500000>></span>
	<br><br>
	<<if _broker is "Bailey">>
		<<link [[Refuse|Bailey's Office]]>><<endevent>><</link>>
	<<else>>
		<<link [[Refuse|Briar's Office]]>><<endevent>><</link>>
	<</if>>
	<br>
<</widget>>

<<widget "undergroundBrothelContractPenalty">>
	<<if $undergroundbrothelcontract>>
		<<set $undergroundbrothelcontract.end += 1>>
		<<set $undergroundbrothelcontract.penalty += 1>>
		<<set $undergroundbrothelcontract.obedience to Math.max(-3, $undergroundbrothelcontract.obedience - 1)>>
	<</if>>
<</widget>>

/* The brothel's collar is equipped cursed, so it has to be marked broken before it can be taken off the same two-step <<remove_shackle>> and <<leash>> use.
   A cursed "familiar collar" is left alone, because "Underground Brothel Contract Arrival" never replaces one. */
<<widget "undergroundBrothelContractUncollar">>
	<<if $worn.neck.name is "collar with leash">>
		<<set $worn.neck.type.push("broken")>>
		<<neckruined>>
	<</if>>
<</widget>>

/* Frees the arms and nothing else. <<unbind>> and <<unbindtemp>> both call <<remove_shackle>>, which
   would take the brothel's ankle cuffs off with the rope. The carry flags have to be cleared too, or
   <<bindings>> ties the arms straight back on the next <<effects>>. */
<<widget "undergroundBrothelContractUntie">>
	<<set $leftboundcarry to 0>>
	<<set $rightboundcarry to 0>>
	<<set $leftarm to 0>>
	<<set $rightarm to 0>>
	<<if $head is "bound">>
		<<set $head to 0>>
	<</if>>
<</widget>>

<<widget "undergroundBrothelContractWakeRoll">>
	<<if $undergroundbrothelcontract and !$contractWake>>
		<<set _contractObedience to $undergroundbrothelcontract.obedience>>
		/* ~3% an hour at the top of the scale, ~11% at the bottom. */
		<<if random(1, 100) lte 8 - _contractObedience>>
			<<set _contractWakePool to []>>
			<<set _contractStaffBed to $passage is "Underground Brothel Contract Master Bed Sleep">>
			<<set _contractWakeTrait to $undergroundbrothelcontract.masterTrait>>
			<<if _contractObedience lte -2>>
				<<run _contractWakePool.push("punish", "punish", "punish", "punish")>>
			<<elseif _contractObedience lte 0>>
				<<run _contractWakePool.push("punish")>>
			<</if>>
			<<if _contractStaffBed>>
				/* Chained beside your handler, so nothing reaches you but the handler. */
				<<run _contractWakePool.push("master", "master", "master")>>
				<<if _contractWakeTrait is "sociable">><<run _contractWakePool.push("group", "group")>><</if>>
			<<else>>
				/* The worse your standing, the more of your nights get sold to patrons. */
				<<for _contractSold to 0; _contractSold lt Math.clamp(3 - _contractObedience, 1, 6); _contractSold++>>
					<<run _contractWakePool.push("patron")>>
				<</for>>
				<<switch _contractWakeTrait>>
					<<case "lecher">><<run _contractWakePool.push("master", "master", "master", "master")>>
					<<case "sociable">><<run _contractWakePool.push("group", "group", "group")>>
					<<default>><<run _contractWakePool.push("trait", "trait", "trait")>>
				<</switch>>
			<</if>>
			<<if _contractWakePool.length>>
				<<set $contractWake to _contractWakePool.random()>>
				<<set _sleepinterrupt to 1>>
			<</if>>
		<</if>>
	<</if>>
<</widget>>

<<widget "undergroundBrothelContractStatus">>
	<<set _contractDaysLeft to Math.max(0, $undergroundbrothelcontract.end - Time.days)>>
	<span class="gold">Your contract has <<= _contractDaysLeft>> <<= _contractDaysLeft is 1 ? "day" : "days">> remaining.</span>
	<<if $undergroundbrothelcontract.penalty gte 1>>
		<span class="red"> <<= $undergroundbrothelcontract.penalty>> unpaid <<= $undergroundbrothelcontract.penalty is 1 ? "day has" : "days have">> been added.</span>
	<</if>>
<</widget>>

:: Underground Brothel Contract Bailey
<<set $outside to 0>><<set $location to "home">><<effects>>
<<undergroundBrothelContractOffer "Bailey">>

:: Underground Brothel Contract Briar
<<set $outside to 0>><<set $location to "brothel">><<effects>>
<<undergroundBrothelContractOffer "Briar">>

:: Underground Brothel Contract Terms
/* Still sat in whichever office made the offer. */
<<endevent>>
<<set $outside to 0>><<set $location to $undergroundbrothelcontract.broker is "Bailey" ? "home" : "brothel">><<effects>>
<<set _contractLength to $undergroundbrothelcontract.end - Time.days>>
<<if $undergroundbrothelcontract.broker is "Bailey">>
	<<npc Bailey>><<person1>>
	Bailey slides a single sheet across the desk. Most of the page concerns the payment. The rest is written in blunt, cramped lines.
<<else>>
	<<npc Briar>><<person1>>
	Briar turns the paper around so you can read it. The payment is printed in large type. The conditions beneath it are not.
<</if>>
<br><br>
For <<= _contractLength>> <<= _contractLength is 1 ? "day" : "days">>, the underground brothel can make you perform for its patrons at any hour.
Protection is not promised. Neither is gentle treatment. Refusing work, attacking staff, or trying to escape can add unpaid days. If you go into labour,
they will take you to hospital and collect you again after the birth. You are only paid if you remain until the final date.
<br><br>
<<if $undergroundbrothelcontract.broker is "Bailey">>
	"Don't pretend you weren't warned," Bailey says. "If you sign, they'll hold you to every word."
<<else>>
	"You've survived the place once," Briar says. "That doesn't make this safe. It only means you know what you're choosing."
<</if>>
<br><br>
<<agreeicon>><<link [[Sign the contract|Underground Brothel Contract Departure]]>><<endevent>><</link>>
<br>
<<if $undergroundbrothelcontract.broker is "Bailey">>
	<<link [[Put the pen down|Bailey's Office]]>><<unset $undergroundbrothelcontract>><<endevent>><</link>>
<<else>>
	<<link [[Put the pen down|Briar's Office]]>><<unset $undergroundbrothelcontract>><<endevent>><</link>>
<</if>>
<br>

:: Underground Brothel Contract Complete
<<set $outside to 0>><<set $location to "underground">>
<<if $passage is "Underground Brothel Contract Complete">><<effects>><</if>>
<<undergroundBrothelContractMaster>>
The lock turns at an unusual hour. Your <<= _contractMasterTitle>> enters carrying your clothes and an envelope.
<br><br>
"Your time's up." <<He>> removes the shackles and collar, then waits while you dress.<<if $undergroundbrothelcontract.penalty gte 1>> <<He>> taps the <<= $undergroundbrothelcontract.penalty is 1 ? "extra day" : $undergroundbrothelcontract.penalty + " extra days">>
marked in red on your contract. "Those weren't paid. The original price hasn't changed."<</if>>
<br><br>
<<unbind>><<undergroundBrothelContractUncollar>>
<<storeon "underground_contract">><<specialClothesUnlock "set" "underground_brothel">>
The envelope contains <<printmoney `divineTfIncome($undergroundbrothelcontract.pay, "undergroundBrothelContract")`>>.
<br><br>
You're hooded for the journey back. When it's removed, the car is already pulling away from Domus Street. The orphanage stands a short walk ahead. For the first time since you signed, no one tries to stop you.
<br><br>
<<link [[Next|Domus Street]]>>
	<<income $undergroundbrothelcontract.pay "undergroundBrothelContract">>
	<<badEndTrackingEnd "Underground Dungeon" { reason: "uDungeonContractServed" }>>
	<<dungeonescape "contractServed">>
	<<unset $litter_size>><<unset $first_birth>><<unset $bornChildrenIds>>
	<<endevent>>
<</link>>
<br>

:: Underground Brothel Contract Hospital Return
<<set $outside to 0>><<set $location to "hospital">><<effects>>
<<undergroundBrothelContractMaster>>
A hospital worker brings your discharge papers. Your <<= _contractMasterTitle>> is waiting beside the door in a dark coat, your contract folded beneath one arm.
<br><br>
"Your contract kept running while you were here," <<he>> says. "The children are going to the orphanage. You're coming with me."
<br><br>
<<set $ward_unlocked to true>>
<<if $first_birth>>
	<span class="gold">You can now access the youth ward, and the nursery.</span>
	<br><br>
<</if>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<link [[Leave the hospital|Underground Brothel Contract Complete]]>><<unset $litter_size>><<unset $first_birth>><<unset $bornChildrenIds>><<endevent>><</link>>
<<else>>
	You're hooded in the hospital car park. By the time it comes off, you're standing in the brothel's service corridor. The handler checks your collar and shackles, then marches you back to your room.
	<br><br>
	<<link [[Return underground|Underground Brothel Contract Quarters]]>><<unset $litter_size>><<unset $first_birth>><<unset $bornChildrenIds>><<endevent>><</link>>
<</if>>
<br>

:: Underground Brothel Contract Door Sneak
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<include "Underground Brothel Contract Complete">>
<<elseif isPregnancyEnding()>>
	<<pregnancyPassout "dungeon">>
<<else>>
	<<skulduggerycheck>>
	<<if $skulduggerysuccess is 1>>
	The lock gives a soft click. You catch the door before it can swing open and slip into the corridor.<<skulduggeryuse>>
	<br><br>
	<<link [[Sneak onward|Underground Brothel Contract Corridor]]>><</link>>
	<<else>>
	The lock chirps. Your improvised tool slips from your fingers and clatters against the floor.
	<br><br>
	<<if Time.hour gte 6 and Time.hour lt 22>>
		<<undergroundBrothelContractMaster>>
		<<if Time.hour lt 10>>
			The sound interrupts your <<= _contractMasterTitle>>'s morning rounds. <<He>> reaches your door before you can hide the tool.
		<<elseif Time.hour lt 18>>
			Your <<= _contractMasterTitle>> leaves the contract desk and follows the noise to your room.
		<<else>>
			Your <<= _contractMasterTitle>> abandons the performance floor and strides down the corridor towards you.
		<</if>>
		<br><br>
		<<link [[Next|Underground Brothel Contract Caught]]>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(one unpaid day added)</span>
	<<elseif random(1, 2) is 1>>
		A night handler calls out. You hear keys and hurried footsteps approaching.
		<br><br>
		<<link [[Next|Underground Brothel Contract Caught]]>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(one unpaid day added)</span>
	<<else>>
		You freeze, waiting for someone to investigate. The corridor remains quiet. <span class="green">It seems no one heard.</span>
		<br><br>
		<<link [[Try to sleep|Underground Brothel Contract Quarters]]>><</link>>
	<</if>>
	<</if>>
<</if>>
<br>

:: Underground Brothel Contract Corridor
<<set $outside to 0>><<set $location to "underground">><<effects>>
You crouch in the service corridor. One way leads back to the performance rooms. The other climbs towards a heavy outer door. Staff voices drift from a room between you and the stairs.
<br><br>
<<if Time.hour gte 18 or Time.hour lt 2>>
	The brothel is busy. Handlers cross the corridor often, but the noise gives you cover.
<<else>>
	The corridor is quiet enough that every movement of your shackles sounds dangerously loud.
<</if>>
<br><br>
<<lockicon "pick">><<link [[Try the outer door (0:05)|Underground Brothel Contract Exit Sneak]]>><<set $skulduggerydifficulty to 1000>><<pass 5>><</link>><<skulduggerydifficulty>>
<br>
<<getouticon>><<link [[Return before you're noticed|Underground Brothel Contract Quarters]]>><</link>>
<br>

:: Underground Brothel Contract Exit Sneak
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<include "Underground Brothel Contract Complete">>
<<elseif isPregnancyEnding()>>
	<<pregnancyPassout "dungeon">>
<<else>>
	<<skulduggerycheck>>
	<<if $skulduggerysuccess is 1>>
	The outer lock yields. Cold air spills down the stairs. Beyond the door, trees crowd beneath the night sky.
	You can still return and finish the contract. If you run, the payment is forfeit.
	<br><br>
	<<link [[Run|Underground Brothel Contract Escape]]>><<skulduggeryuse>><</link>>
	<br>
	<<link [[Lock the door and go back|Underground Brothel Contract Quarters]]>><<set $undergroundbrothelcontract.obedience to Math.max(-3, $undergroundbrothelcontract.obedience - 1)>><</link>>
	<<else>>
	The pick slips from the mechanism. Metal strikes stone with a sharp click.
	<br><br>
	<<if Time.hour gte 6 and Time.hour lt 22>>
		<<undergroundBrothelContractMaster>>
		<<if Time.hour lt 10>>
			Your <<= _contractMasterTitle>> looks up from the morning reports at the desk below. <<He>> is already climbing the stairs when you turn.
		<<elseif Time.hour lt 18>>
			A handler shouts. Your <<= _contractMasterTitle>> emerges from the performance corridor and blocks the only way back.
		<<else>>
			<<switch _contractMasterTrait>>
				<<case "relaxed">>
					Your <<= _contractMasterTitle>> opens one eye from the couch below. The lazy look vanishes as <<he>> sees you beside the outer door.
				<<case "sociable">>
					Your <<= _contractMasterTitle>> stops mid-conversation. "Excuse me," <<he>> tells the patrons, then starts up the stairs.
				<<case "brooding">>
					Your <<= _contractMasterTitle>> is already watching from beside the performance window. <<He>> meets your gaze and silently points back down the stairs.
				<<case "lecher">>
					Your <<= _contractMasterTitle>> switches off the performance feed. "So that's what you were doing while my back was turned."
			<</switch>>
		<</if>>
		<br><br>
		<<link [[Next|Underground Brothel Contract Caught]]>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(one unpaid day added)</span>
	<<elseif random(1, 2) is 1>>
		A night handler pushes away from the desk below. The beam of a torch climbs the stairwell and catches you against the locked door.
		<br><br>
		<<link [[Next|Underground Brothel Contract Caught]]>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(one unpaid day added)</span>
	<<else>>
		You hold still and listen. The handler below mutters at the performance monitor, oblivious. <span class="green">No one heard.</span>
		<br><br>
		<<lockicon "pick">><<link [[Try the lock again (0:05)|Underground Brothel Contract Exit Sneak]]>><<set $skulduggerydifficulty to 1000>><<pass 5>><</link>><<skulduggerydifficulty>>
		<br>
		<<getouticon>><<link [[Retreat to your room|Underground Brothel Contract Quarters]]>><</link>>
	<</if>>
	<</if>>
<</if>>
<br>

:: Underground Brothel Contract Caught
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<undergroundBrothelContractMaster>>
Your <<= _contractMasterTitle>> drags you back by your collar and throws you against the wall outside your room.
<br><br>
"You signed for a release date," <<he>> says, showing you the contract. A fresh day has been written beneath it in red. "Now you have a new one."
<br><br>
<<link [[Submit to the punishment|Underground Brothel Contract Punishment Submit]]>><<set $sexstart to 1>><<sub 3>><</link>><<submissivetext>>
<br>
<<link [[Fight back|Underground Brothel Contract Punishment Fight]]>><<set $molestationstart to 1>><</link>>
<br>

:: Underground Brothel Contract Escape
<<set $outside to 1>><<set $location to "forest">><<effects>>
<<set _contractCollar to $worn.neck.name is "collar with leash">>
You pull the door closed and run into the trees. Branches claw at your skin and the shackles shorten your stride, but no one catches you before the music fades behind you.
<br><br>
At the edge of a stream you stop long enough to try the fastenings. The ankle cuffs don't give<<if _contractCollar>>, and there's no seam in the collar that your fingers can find<</if>>. Whatever opens them is still underground, in a drawer you never saw.
<br><br>
The contract is gone. You are not.
<br><br>
<span class="blue">You are still wearing the brothel's <<if _contractCollar>>collar and cuffs<<else>>cuffs<</if>>. You'll have to find someone in town willing to take <<if _contractCollar>>them<<else>>them<</if>> off.</span>
<br><br>
<<badEndTrackingEnd "Underground Dungeon" { reason: "uDungeonSneak" }>>
<<dungeonescape>><<specialClothesUnlock "set" "underground_brothel">>
<<link [[Keep running|Forest]]>><<set $forest to 40>><<set $stress -= 1000>><<endevent>><</link>>

:: Underground Brothel Contract Quarters
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<include "Underground Brothel Contract Complete">>
<<elseif isPregnancyEnding()>>
	<<pregnancyPassout "dungeon">>
<<else>>
	<<undergroundBrothelContractMaster>>
	You are in the room assigned to the brothel's contracted workers. The walls and floor are cold stone, but a narrow strip of pink light leaks beneath the door.
	<br>
	<<undergroundBrothelContractStatus>>
	<br><br>
	<<if Time.hour gte 22 or Time.hour lt 6>>
		The music beyond the wall has quietened. Your <<= _contractMasterTitle>> is in <<his>> private bedroom across the common room, leaving the night handlers to watch the corridor.
	<<elseif Time.hour gte 18>>
		Music and applause shake dust from the ceiling. Your <<= _contractMasterTitle>> is supervising the evening performances.
	<<elseif Time.hour gte 10>>
		Your <<= _contractMasterTitle>> moves between the contract desk and performance rooms while staff hurry through the corridor.
	<<else>>
		The brothel is quieter in the morning. Your <<= _contractMasterTitle>> is making <<his>> rounds.
	<</if>>
	<br><br>
	<<brothelicon>><<link [[Report for work (1:00)|Underground Brothel Contract Work]]>><<pass 1 hour>><</link>>
	<br>
	<<bedicon "zzz">><<link [[Lie on the mattress|Underground Brothel Contract Bed]]>><</link>>
	<br>
	<<socialiseicon "ask">><<link [[Think about your <<= _contractMasterTitle>>|Underground Brothel Contract Master]]>><</link>>
	<br>
	<<if Time.hour gte 6 and Time.hour lt 22>>
		<<investigateicon>><<link [[Wait for inspection|Underground Brothel Contract Master Inspection]]>><</link>>
		<br>
	<</if>>
	<<if $undergroundbrothelcontract.obedience gte 2>>
		<<bathroomicon>><<link [[Ask to use the washroom (0:20)|Underground Brothel Contract Washroom]]>><<pass 20>><</link>>
		<br>
		<<dooricon>><<link [[Ask to use the common room|Underground Brothel Contract Main Room]]>><</link>>
		<br>
	<<else>>
		The door to the corridor is <span class="red">locked</span>.
		<br>
	<</if>>
	<<ind>><<link [[Curl up on the floor (1:00)|Underground Brothel Contract Floor Rest]]>><<pass 1 hour>><<tiredness -6>><</link>><<ltiredness>>
	<br>
	<<if $leftarm is "bound" or $rightarm is "bound">>
		<<undobindingsicon>><<link [[Undo your bindings (0:10)|Underground Brothel Contract Quarters]]>><<pass 10>><<undergroundBrothelContractUntie>><</link>>
		<br>
	<<elseif $worn.face.cursed is 1>>
		<<undobindingsicon>><<link [[Break off your $worn.face.name (0:10)|Underground Brothel Contract Quarters]]>><<pass 10>><<set $worn.face.type.push("broken")>><<faceruined>><</link>>
		<br>
	<</if>>
	<<if $undergroundbrothelcontract.obedience lt 2>>
		<<if $leftarm is "bound" and $rightarm is "bound">>
			<span class="blue">You might be able to pick the lock if your arms were free.</span>
		<<else>>
			<<lockicon "pick">><<link [[Work on the door lock (0:05)|Underground Brothel Contract Door Sneak]]>><<set $skulduggerydifficulty to 600>><<pass 5>><</link>><<skulduggerydifficulty>>
		<</if>>
	<</if>>
<</if>>
<br>

:: Underground Brothel Contract Washroom
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<include "Underground Brothel Contract Complete">>
<<elseif isPregnancyEnding()>>
	<<pregnancyPassout "dungeon">>
<<else>>
	<<undergroundBrothelContractMaster>>
	Your <<= _contractMasterTitle>> fastens a leash to your collar and walks you to a tiled washroom. There are no stalls and no lock on the door. <<He>> remains outside, close enough that you can see <<his>> shadow.
	<br><br>
	The water is warm. For a few minutes, you can wash away the sweat, makeup, and traces left by patrons.<<wash>><<stress -6>><<trauma -4>><<lstress>><<ltrauma>>
	<br><br>
	<<link [[Return to your room|Underground Brothel Contract Quarters]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><</link>>
	<br>
	<<if $leftarm isnot "bound" or $rightarm isnot "bound">>
		<<link [[Slip into the service corridor|Underground Brothel Contract Corridor]]>><</link>>
	<</if>>
<</if>>
<br>

:: Underground Brothel Contract Work
<<set $outside to 0>><<set $location to "underground">><<effects>>
<<if Time.days gte $undergroundbrothelcontract.end>>
	<<include "Underground Brothel Contract Complete">>
<<elseif isPregnancyEnding()>>
	<<pregnancyPassout "dungeon">>
<<else>>
	/* The brothel's own shifts are always on the schedule. Your handler adds the theatre show, where
	   your standing is settled in front of the house, and puts you on it more often the worse it is. */
	<<set _contractShiftPool to ["dance", "presentation", "stage", "film", "hunt"]>>
	<<for _contractShiftSlot to 0; _contractShiftSlot lt Math.clamp(4 - $undergroundbrothelcontract.obedience, 1, 6); _contractShiftSlot++>>
		<<run _contractShiftPool.push("show")>>
	<</for>>
	<<set _contractShift to _contractShiftPool.random()>><<undergroundBrothelContractMaster>>
	The light above the door turns pink. Your <<= _contractMasterTitle>> enters, clips a leash to your collar, and leads you through the brothel.
	<br><br>
	<<switch _contractShift>>
	<<case "dance">>
		The main hall is packed. "Dance until someone pays for you," your <<= _contractMasterTitle>> says. "If no one does, the audience gets you."
		<br><br>
		<<link [[Go quietly|Underground Dance Intro]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><<endevent>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<<case "presentation">>
		<<He>> takes you towards a private presentation room. You can hear patrons bidding on the other side of the curtain.
		<br><br>
		<<link [[Go quietly|Underground Presentation]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><<endevent>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<<case "stage">>
		The stage equipment is already waiting. Your <<= _contractMasterTitle>> points to the centre beneath the lights.
		<br><br>
		<<link [[Go quietly|Underground Stage Intro]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><<endevent>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<<case "film">>
		<<He>> leads you past a camera crew and into the filming room. "They've paid for a full scene," <<he>> says.
		<br><br>
		<<link [[Go quietly|Underground Film Intro]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><<endevent>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<<case "show">>
		<<He>> doesn't hand your leash to anyone. The corridor <<he>> takes bends towards the theatre, and you can hear a room filling up beyond it.
		<br><br>
		<<if $undergroundbrothelcontract.obedience gte 3>>
			"My show tonight," <<he>> says. "You're on it because you've been worth putting on it."
		<<elseif $undergroundbrothelcontract.obedience gte 0>>
			"My show tonight," <<he>> says. "The house wants to see what it's renting."
		<<else>>
			"My show tonight," <<he>> says, and taps the red lines on your contract. "The house wants to see what these cost you."
		<</if>>
		<br><br>
		<<link [[Go quietly|Underground Brothel Contract Show]]>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<<default>>
		Your <<= _contractMasterTitle>> takes you upstairs. Cool forest air reaches you through an open door, along with the sound of dogs.
		<br><br>
		<span class="blue">The hunt takes place above ground. Outrunning it would put you outside the brothel's doors, and that would void your contract.</span>
		<br><br>
		<<link [[Go quietly|Underground Hunt Intro]]>><<set $undergroundbrothelcontract.obedience to Math.min(5, $undergroundbrothelcontract.obedience + 1)>><<endevent>><</link>>
		<br>
		<<link [[Refuse|Underground Brothel Contract Punishment Refusal]]>><<set $molestationstart to 1>><<undergroundBrothelContractPenalty>><</link>> <span class="red">(adds one unpaid day)</span>
	<</switch>>
<</if>>
<br>
