					<<tiredness -6>><<stress -24>>
				<<else>>
					<<stress 3>>
				<</if>>
				<<set _valueFood.used to true>><<set _valueFood.dirty to 1>>
			<</if>>
		<</link>>
		<<if _valueFood.name is "stolen fruit">>
			<<lstress>>
		<<elseif _valueFood.name isnot "prison gruel">>
			<<llstress>><<ltiredness>>
		<<else>>
			<<gstress>>
		<</if>>
		<br>
	<</capture>>
<</for>>


:: Hopeless Cycle Cell Food Together 3
<<set _thermoDisable to true>><<effects>>
<<hopelessCycleEffects>>
<<if !$prisonerEvents.includes("eatTogether")>>
	<span class="narration">Never underestimate how humanising it is to simply share a meal with someone.</span>
	<br><br>

	<<if $prisoner.state is "asleep">>
		<<set $prisoner.state to "awake">><<set $prisoner.awakeTimer to 3>>
		You gently shake <<= $prisoner.name>> awake. <<worldFemale 'She' 'He'>> rubs <<worldFemale 'her' 'his'>> eye as <<worldFemale 'she' 'he'>> sits up.
		<br><br>
	<</if>>

	You place down the $hcFood in front of <<worldFemale 'her' 'him'>>, and sit down across from <<worldFemale 'her' 'him'>>.
	<br><br>

	<<worldFemale 'She' 'He'>> blinks at you.
	<br><br>

	You motion for <<worldFemale 'her' 'him'>> to start.

	<<if $hc.daily.fed and $hcFood isnot "stolen fruit">>
		<<worldFemale 'She' 'He'>> looks surprised at getting another portion, but graciously accepts.
	<</if>>

	<<worldFemale 'She' 'He'>> hesitantly takes the first bite. This is clearly a level of mutual respect <<worldFemale 'she' 'he'>> isn't used to.
	<br><br>

	<<if $hcFood is "prison gruel">>
		<<set $prisoner.love += 1>>
		<<if $prisonerEvents.includes("tongue")>>
			<<worldFemale 'She' 'He'>> doesn't complain. You suppose <<worldFemale 'she' 'he'>> can't taste it anyways.
		<<else>>
			<<worldFemale 'She' 'He'>> doesn't complain, which you find admirable. You'd never eat that.
		<</if>>
	<<elseif $hcFood is "stolen fruit">>
		<<set $prisoner.love += 2>>
		<<set $hc.daily.fruit ||= 0>>
		<<switch $hc.daily.fruit>>
			<<case 0>>
				<<worldFemale 'She' 'He'>> bites into the fruit, and looks pleased.
				<<if $prisonerEvents.includes("tongue")>>
					You wonder if <<worldFemale 'she' 'he'>> can taste it despite <<worldFemale 'her' 'his'>> missing tongue.
				<</if>>
			<<case 1>>
				<<worldFemale 'She' 'He'>> quickly bites into it and wipes <<worldFemale 'her' 'his'>> mouth. <<worldFemale 'She' 'He'>> seems to really like these.
			<<case 2>>
				<<worldFemale 'She' 'He'>> devours the fruit quickly. Juice has started to run down <<worldFemale 'her' 'his'>> chin from all the fruits you've given <<worldFemale 'her' 'him'>> today.
				<<if $prisoner.love gte 45>>
					You can't help but laugh. You help <<worldFemale 'her' 'him'>> clean up, which prompts <<worldFemale 'her' 'him'>> to pout at you.
				<</if>>
			<<case 3>>
				<<worldFemale 'She' 'He'>> messily devours yet another fruit. You hope no one notices the missing harvest.
			<<case 4>>
				<<worldFemale 'She' 'He'>> keeps eye contact with you while eating yet another fruit. <<worldFemale 'She' 'He'>> looks at you expectantly.
			<<case 5>>
				This is getting a bit ridiculous. How can <<worldFemale 'she' 'he'>> even eat this many? <<worldFemale 'She' 'He'>> takes a deep breath, and shoots a fruit seed at you from <<worldFemale 'her' 'his'>> mouth. It sticks to your face.
				<<worldFemale 'She' 'He'>> giggles and picks it off for you. <<stress -12>><<lstress>>
			<<default>>
				<<worldFemale 'She' 'He'>> eats it quietly.
		<</switch>>
		<<set $hc.daily.fruit++>>
	<<elseif $hcFood is "stolen food">>
		<<set $prisoner.love += 3>>
		You can tell <<worldFemale 'she' 'he'>>'s trying to hide <<worldFemale 'her' 'his'>> happiness at being given a real meal.
		<<if $prisoner.love gte 45>>
			<<worldFemale 'She' 'He'>> pulls you into a hug, and eats quietly. <<stress -24>><<purity -1>><<llstress>><<lpurity>>
		<<else>>
			<<worldFemale 'She' 'He'>> nods <<worldFemale 'her' 'his'>> gratitude, and eats quietly.
		<</if>>
	<</if>>
	<br><br>

	<<if $hcFood is "prison gruel" and !$prisoner.hasEaten.includes("prison gruel")>>
		<span class="blue">The gruel given to prisoners is plain. It'll keep <<worldFemale 'her' 'him'>> nourished, but won't do much to improve <<worldFemale 'her' 'his'>> health.</span>
		<br><br>
	<<elseif $hcFood is "stolen fruit" and !$prisoner.hasEaten.includes("stolen fruit")>>
		<span class="teal">The fruit from the garden is known to be revitalising. It'll be better for <<worldFemale 'her' 'him'>> than the gruel normally saved for prisoners.</span>
		<br><br>
	<<elseif $hcFood is "stolen food" and !$prisoner.hasEaten.includes("stolen food")>>
		<span class="green">The food normally saved for the temple's warriors, such as yourself, is quite nourishing. Feeding it to <<worldFemale 'her' 'him'>> will surely improve <<worldFemale 'her' 'his'>> health.</span>
		<br><br>
	<</if>>
	<<set $prisoner.hasEaten.pushUnique($hcFood)>>
	<<if $hcFood is "stolen food">>
		<span class="pink">You should clean and return the stolen dish to avoid raising suspicion.</span>
		<br><br>
	<</if>>

	It's... enjoyable. Even without words, you feel like you understand <<worldFemale 'her' 'him'>> a little more. You should do this again. <<lltrauma>>
	<br><br>

	<<set $prisonerEvents.pushUnique("eatTogether")>>
	<<link [[Next|Hopeless Cycle Cell]]>><<set $hc.daily.fed to true>><<unset $hcFood>><<endevent>><</link>>
	<br>
<<else>>
	<<if $prisoner.state is "asleep">>
		<<set $prisoner.state to "awake">><<set $prisoner.awakeTimer to 3>>
		You gently shake <<= $prisoner.name>> awake. <<worldFemale 'She' 'He'>> rubs <<worldFemale 'her' 'his'>> eye as <<worldFemale 'she' 'he'>> sits up.
		<br><br>
	<</if>>

	<<if $prisoner.love gte 30>>
		You place the $hcFood in <<worldFemale 'her' 'his'>> hands.
	<<else>>
		You place the $hcFood down in front of <<worldFemale 'her' 'him'>>.
	<</if>>
	<<if $hc.daily.fed and $hcFood isnot "stolen fruit">>
		<<worldFemale 'She' 'He'>> looks surprised at getting another portion, but graciously accepts.
	<</if>>
	<<if $hcFood is "prison gruel">>
		<<set $prisoner.love += 1>>
		<<if $prisonerEvents.includes("tongue")>>
			<<worldFemale 'She' 'He'>> doesn't complain. You suppose <<worldFemale 'she' 'he'>> can't taste it anyways.
		<<else>>
			<<worldFemale 'She' 'He'>> doesn't complain, which you find admirable. You'd never eat that.
		<</if>>
	<<elseif $hcFood is "stolen fruit">>
		<<set $prisoner.love += 2>>
		<<set $hc.daily.fruit ||= 0>>
		<<switch $hc.daily.fruit>>
			<<case 0>>
				<<worldFemale 'She' 'He'>> bites into the fruit, and looks pleased.
				<<if $prisonerEvents.includes("tongue")>>
					You wonder if <<worldFemale 'she' 'he'>> can taste it despite <<worldFemale 'her' 'his'>> missing tongue.
				<</if>>
			<<case 1>>
				<<worldFemale 'She' 'He'>> quickly bites into it and wipes <<worldFemale 'her' 'his'>> mouth. <<worldFemale 'She' 'He'>> seems to really like these.
			<<case 2>>
				<<worldFemale 'She' 'He'>> devours the fruit quickly. Juice has started to run down <<worldFemale 'her' 'his'>> chin from all the fruits you've given <<worldFemale 'her' 'him'>> today.
				<<if $prisoner.love gte 45>>
					You can't help but laugh. You help <<worldFemale 'her' 'him'>> clean up, which prompts <<worldFemale 'her' 'him'>> to pout at you.
				<</if>>
			<<case 3>>
				<<worldFemale 'She' 'He'>> messily devours yet another fruit. You hope no one notices the missing harvest.
			<<case 4>>
				<<worldFemale 'She' 'He'>> keeps eye contact with you while eating yet another fruit. <<worldFemale 'She' 'He'>> looks at you expectantly.
			<<case 5>>
				This is getting a bit ridiculous. How can <<worldFemale 'she' 'he'>> even eat this many? <<worldFemale 'She' 'He'>> takes a deep breath, and shoots a fruit seed at you from <<worldFemale 'her' 'his'>> mouth. It sticks to your face.
				<<worldFemale 'She' 'He'>> giggles and picks it off for you. <<stress -12>><<lstress>>
			<<default>>
				<<worldFemale 'She' 'He'>> eats it quietly.
		<</switch>>
		<<set $hc.daily.fruit++>>
	<<elseif $hcFood is "stolen food">>
		<<set $prisoner.love += 3>>
		You can tell <<worldFemale 'she' 'he'>>'s trying to hide <<worldFemale 'her' 'his'>> happiness at being given a real meal.
		<<if $prisoner.love gte 45>>
			<<worldFemale 'She' 'He'>> pulls you into a hug, and eats quietly. <<stress -24>><<purity -1>><<llstress>><<lpurity>>
		<<else>>
			<<worldFemale 'She' 'He'>> nods <<worldFemale 'her' 'his'>> gratitude, and eats quietly.
		<</if>>
	<</if>>
	<br><br>

	<<set $hc.daily.fed to true>>

	<<if $prisoner.love gte 30 and (Time.hour gte 18 or Time.hour lte 3)>>
		You sit next to <<worldFemale 'her' 'him'>> and share the meal with <<worldFemale 'her' 'him'>>. <<worldFemale 'She' 'He'>> smiles at you warmly.
		<br><br>

		Once you're done, you just sit there, enjoying each other's presence.
		<br><br>

		Until you feel a sharp jolt from <<worldFemale 'her' 'his'>> direction, followed by a familiar weakness. You flinch, and look over. <<worldFemale 'She' 'He'>>'s resting <<worldFemale 'her' 'his'>> head on your shoulder, and seems to be dozing off. <<lpurity>><<gtrauma>><<arousal 200>><<garousal>>
		<br><br>

		<<link [[Shake <<worldFemale 'her' 'him'>> off|Hopeless Cycle Cell Food Together Shake Off]]>><</link>>
		<br>
		<<link [[Let <<worldFemale 'her' 'him'>> stay there (0:30)|Hopeless Cycle Cell Food Together Let]]>><<pass 30>><<set $prisoner.love += 3>><<purity -10>><<stress -24>><<trauma 24>><<tiredness -12>><</link>><<lpurity>><<llstress>><<gtrauma>><<hopelessCycleLove 1>>
		<br>
		<<if $prisoner.love gte 45 and !(Time.lastDayOfMonth is $hc.day)>>
