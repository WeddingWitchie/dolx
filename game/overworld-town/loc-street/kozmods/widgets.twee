:: Widgets X-Change Events [widget]

<<widget "street-resistance-whoring">>
	<<rng>>
	<<set _targetsex to $player.sex is "m"? "f": "m">>
	<<set _npcPronoun to ($rng lte maleChance(_targetsex) ? "m" : "f")>>
	<<generateNPC 1 a _npcPronoun>>
	
    <<person1>>A car pulls up alongside you. The driver, a <<person>>, waves a wad of cash along with a pill at you. "<span class="pink">That's a Resistance</span>. Let me fuck you and I'll pay you <<printmoney 100000>>. Get in."
	<br><br>

	<<if $awarelevel lt 2>>
		<span class="purple">You're blissfully unaware of what <<he>> means by a "Resistance". A Resistance what? What does that do?...</span><br><br>
	<</if>>

	<<if $earSlime.growth gt 50 and ($earSlime.growth gte 80 - ($earSlime.promiscuity * 10))>>
		<span class="lewd">You feel the slime in your head command you to get in the car and give yourself to <<him>>.</span> It promises rewards if you comply, and threatens consequences if you do not.
		<br><br>

		<<link [[Obey|XChange Street Car Slime Obey]]>>
			<<corruption 1>><<pain -4>><<stress -6>><<trauma -12>><<sub 2>>
			<<if $promiscuity lte 14>><<set $desperateaction to "the ear slime commanded you to do it">><</if>>
		<</link>><<promiscuous2>><<gcorruption>><<lpain>><<lltrauma>><<lstress>>
		<br>
		<<link [[Defy|XChange Street Car Slime Defy]]>><<corruption -1>><<pain 8>><<stress 6>><<trauma 6>><<def 1>><</link>><<lcorruption>><<ggpain>><<ggtrauma>><<ggstress>>
		<br>
	<<else>>
		<<if $promiscuity lte 14>>
			<<if $uncomfortable.prostituting>>
				You are not promiscuous enough to take up <<his>> offer.
			<<else>>
				<<His>> offer repulses you, but you need the money.
			<</if>>
			<br><br>
		<</if>>

		<<if $promiscuity gte 15>>
			<<if $rng lte 15 and (crimeSumCurrent() gte 1000 or $fame.prostitution gte 400)>>
				<<link [[Get in|XChange Street Car]]>><<set $phase to 10>><</link>><<promiscuous2>>
				<br>
			<<else>>
				<<link [[Get in|XChange Street Car]]>><<set $phase to 1>><</link>><<promiscuous2>>
				<br>
			<</if>>
		<</if>>

		<<if $promiscuity lte 14 and $uncomfortable.prostituting is false>>
			<<if $rng lte 15 and (crimeSumCurrent() gte 1000 or $fame.prostitution gte 400)>>
				<<link [[Reluctantly get in|XChange Street Car]]>><<set $desperateaction to 1>><<set $phase to 10>><</link>><<promiscuous2>>
				<br>
			<<else>>
				<<link [[Reluctantly get in|XChange Street Car]]>><<set $desperateaction to 1>><<set $phase to 1>><</link>><<promiscuous2>>
				<br>
			<</if>>
		<</if>>
		<<link [[Refuse|XChange Street Car]]>><<set $phase to 2>><</link>><<gstress>>
	<</if>>
	<br>
<</widget>>
