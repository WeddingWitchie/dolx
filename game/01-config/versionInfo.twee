:: Widgets Version Info [widget]
<<widget "versioninfo">>
	<h3><<print StartConfig.version>></h3>

	<<if StartConfig.versionName>>
		<h4><<print StartConfig.versionName>></h4>
	<</if>>

	<<if StartConfig.sneaky>>
		<h4 class="orange">SNEAKY BUILD</h4>
	<</if>>
<</widget>>

<<widget "linkinformation">>
	<div class="m-2">
		<p class="gold m-0">Official Vanilla Sites</p>
		[[vrelnir.com|"https://www.vrelnir.com"]]
		[[vrelnir.blogspot.com|"https://vrelnir.blogspot.com"]]
	</div>

	<div class="m-2">
		<p class="gold m-0">Support development</p>
		[[Akoz|"https://ko-fi.com/akozofbliss"]],
		[[Frostberg| "https://www.patreon.com/DegreesofLewdityPlus"]],
		[[Vrelnir|"https://subscribestar.adult/vrelnir"]]
	</div>

	<<if StartConfig.sourceLinkEnabled>>
		<div class="m-2">
			<p class="gold m-0">Source code</p>
			[[gitgud.io/Akoz|"https://gitgud.io/Akoz/dol-xchange"]]
		</div>
	<</if>>

	<<if StartConfig.socialMediaEnabled>>
		<div class="m-2">
			<p class="gold m-0">Official Discord Servers</p>
			[[Vanilla Server|"https://discord.gg/VznUtEh"]]
			<br>
			[[DoLP/DoLX Server| "https://discord.gg/H8PRRw8ZvN"]]
			<br>
			[[General Modding| "https://discord.gg/mGpRSn9qMF"]]
		</div>
	<</if>>
<</widget>>
