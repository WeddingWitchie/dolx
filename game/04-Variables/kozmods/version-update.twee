	<<if ndef $xchange.savedNpcBodies>>
		<<set $xchange.savedNpcBodies to {}>>
	<</if>>

	<<if ndef $options.NnpcDisplaySystem>>
		<<set $options.NnpcDisplaySystem to "vanilla">>
	<</if>>

	<<if ndef $xchange.timesTaken>>
		<<set $xchange.timesTaken to {
			player: 0,
		}>>
		<<for _n to 0; _n lt $NPCName.length; _n++>>
			<<set $xchange.timesTaken[$NPCNameList[_n]] to 0>>
		<</for>>
	<</if>>

<</widget>>

<<widget "xchange-init2">>
	<<if Object.keys($customColors.presets).length lt 10>>
		<<for _i to 1; _i lte 10; _i++>>
			<<set $customColors.presets["custom"+_i] to {
				ver: 3,
				color: 0,
				value: 0,
				brightness: 0,
				saturation: 0,
				contrast: 1,
			}>>
		<</for>>
	<</if>>

	<<if ndef $xchange.baseStats>>
		<<set $xchange.baseStats to {}>>
		<<if playerIsXChanged()>>
			<<set _ogbody to $xchange.pill.originalBody>>
			<<set _physiquesizes to [6000, 10000, 12000, 16000]>>
			<<set $xchange.baseStats.physique to $physique * _physiquesizes[_ogbody.bodysize] / $physiquesize>>
			<<set $xchange.baseStats.physiquesize to _physiquesizes[_ogbody.bodysize]>>
		<<else>>
			<<set $xchange.baseStats.physique to $physique>>
			<<set $xchange.baseStats.physiquesize to $physiquesize>>
		<</if>>
	<</if>>

	<<for _n to 0; _n lt $NPCName.length; _n++>>
		<<if ndef $NPCName[_n].startingSex>>
			<<set $NPCName[_n].startingSex to $NPCName[_n].gender>>
		<</if>>
		<<if ndef $xchange.savedNpcBodies[$NPCNameList[_n]]>>
			<<set $xchange.savedNpcBodies[$NPCNameList[_n]] to {}>>
			<<set $xchange.savedNpcBodies[$NPCNameList[_n]].original to {}>>
			<<set $xchange.savedNpcBodies[$NPCNameList[_n]].genderswap to {}>>
			<<set $xchange.savedNpcBodies[$NPCNameList[_n]].herm to {}>>
		<</if>>
	<</for>>
<</widget>>

<<widget "xchange-modupdate">>
<!-- Preflight for vanilla/old saves: ensure expected object shapes exist -->
<<if $AMCTraits is undefined or $AMCTraits is null or typeof $AMCTraits isnot "object" or Array.isArray($AMCTraits)>>
	<<set $AMCTraits to {}>>
	<<run console.warn("DoLX: $AMCTraits missing/invalid (likely vanilla/old save). Initialising defaults.")>>
<</if>>
<<set _amcKeys to [
	"beauty","physique",
	"seductionskill","oralskill","vaginalskill","analskill","handskill","feetskill","bottomskill","thighskill","chestskill","penileskill",
	"milk","semen","willpower",
	"english","maths","science","history",
	"skulduggery","swimming","dancing","athletics","tending","housekeeping",
	"brawling","footwork","striking","kicking",
	"sexFame","prostitutionFame","rapeFame","bestialityFame","exhibitionismFame","pregnancyFame","impregFame","scrapFame","goodFame","businessFame","socialFame","modelFame"
]>>
<<for _k range _amcKeys>>
	<<if $AMCTraits[_k] is undefined>>
		<<set $AMCTraits[_k] to 1>>
	<</if>>
<</for>>
<<if $background is undefined or $background is null>>
	<<set $background to {}>>
<</if>>
<<if typeof $background is "string">>
	<<set _bgStr to $background>>
	<<set $background to {}>>
	<<set $background.type to _bgStr>>
	<<set $background.id to _bgStr>>
	<<run console.warn(`DoLX: Migrated $background from string "${_bgStr}" to object.`)>>
<</if>>
<<if $background.genderAnxious is undefined>>
	<<set $background.genderAnxious to false>>
<</if>>
/* combatExtended: clamp reads subfields */
<<if $combatExtended is undefined or $combatExtended is null or typeof $combatExtended isnot "object">>
	<<set $combatExtended to {}>>
<</if>>
<<set _combatKeys to ["brawling","footwork","striking","kicking"]>>
<<for _k range _combatKeys>>
	<<if $combatExtended[_k] is undefined>>
		<<set $combatExtended[_k] to 0>>
	<</if>>
<</for>>
<!-- end preflight -->

	<<xchange-init>>
	<<xchange-init2>>

	<<if $xchangePill isnot undefined>>
		<<set $xchange.pill to $xchangePill>>
		<<unset $xchangePill>>
	<</if>>
	
	<<if $xchange.impuritySensitivityBonus is undefined>>
		<<set $xchange.impuritySensitivityBonus to 1>>
	<</if>>
	<<if $xchange.pillSensitivityChange is undefined>>
		<<set $xchange.pillSensitivityChange to 1>>
	<</if>>
	<<if $xchange.willpowerPoints is undefined>>
		<<set $xchange.willpowerPoints to Math.max($willpower, 200)>>
	<</if>>

	<<set _pills to [
		"X-Change Pink Basic",
		"X-Change Pink Xtra Strength",
		"X-Change Blue Xtra Strength",
		"X-Change Pink Continue",
		"X-Change X-Tend",
		"X-Change Pink Resistance",
		"X-Change Blue Resistance",
		"X-Change Test",
		"X-Change Pink NOW",
		"X-Change Clone: Whitney",
		"X-Change Pink Weekly",
		"X-Change Pink Breeder",
		"X-Change Pink CumCure",
		"X-Change Blue CumCure",
		"X-Change Antidote",
		"X-Change Choice (F)",
		"X-Change Sissy",
		"X-Change Blue Bull",
		"X-Change Purple Basic",
		"X-Change Purple Breeder",
		"X-Change Pink Innocence",
		"X-Change Blue Innocence",
		"X-Change Pink Swell",
		"X-Change Blue Swell",
		"X-Change Premium",
		"X-Change Pink Bimbo",
		"X-Change Blue Himbo",
		"SWP Anti-breeder Pill",
		"SWP Anti-swell Pill",
		"SWP Anti-innocence Pill",
		"SWP Anti-bimbo Pill",
		"SWP Anti-cumcure Pill",
	]>>

	<<for _pill range _pills>>
		<<if $sexStats and $sexStats.pills and $sexStats.pills.pills and $sexStats.pills.pills[_pill] is undefined>>
			<<physicalAdjustmentsInit>>
			<<break>>
		<</if>>
	<</for>>

	<!-- Safety guards (prevents hard-crash on migrated/partial saves) -->
	<<if $xchange is undefined or $xchange is null>>
		<<set $xchange to {}>>
	<</if>>
	<<if $xchange.errorLog is undefined or $xchange.errorLog is null>>
		<<set $xchange.errorLog to []>>
	<</if>>
	<<if $xchange.pill is undefined or $xchange.pill is null>>
		<<set $xchange.pill to {}>>
	<</if>>
	<<if $xchange.pill.originalBody is undefined or $xchange.pill.originalBody is null>>
		<<set $xchange.pill.originalBody to {}>>
	<</if>>
	<<if $xchange.pill.changedBody is undefined or $xchange.pill.changedBody is null>>
		<<if $xchange.pill.active>>
			<<run console.warn("X-Change: pill is active but changedBody is missing on load (migration/corruption).")>>
			<<set $xchange.errorLog.push("Pill was active but changedBody was missing on load. Some effects may be inconsistent; please export/save+report if you see issues.")>>
		<</if>>
		<<set $xchange.pill.changedBody to {}>>
	<</if>>
	<<if $xchange.backComp is undefined or $xchange.backComp is null>>
		<<set $xchange.backComp to {}>>
	<</if>>
	<<if $xchange.expectedGenderBy is undefined or $xchange.expectedGenderBy is null>>
		<<set $xchange.expectedGenderBy to {}>>
	<</if>>
	<<if $genderknown is undefined or $genderknown is null>>
		<<set $genderknown to []>>
	<</if>>
	<!-- end guards -->

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.fame is undefined>>
		<<set $xchange.pill.changedBody.fame to {
			bestiality: 0,
			business: 0,
			exhibitionism: 0,
			good: 0,
			impreg: 0,
			model: 0,
			pimp: 0,
			pregnancy: 0,
			prostitution: 0,
			rape: 0,
			scrap: 0,
			sex: 0,
			social: 0,
		}>>
	<</if>>
	
	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.fame is undefined>>
		<<set $xchange.pill.originalBody.fame to $fame>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.promiscuity is undefined>>
		<<set $xchange.pill.originalBody.promiscuity to $promiscuity>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.exhibitionism is undefined>>
		<<set $xchange.pill.originalBody.exhibitionism to $exhibitionism>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.deviancy is undefined>>
		<<set $xchange.pill.originalBody.deviancy to $deviancy>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.promiscuity is undefined>>
		<<set $xchange.pill.changedBody.promiscuity to 0>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.exhibitionism is undefined>>
		<<set $xchange.pill.changedBody.exhibitionism to 0>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.deviancy is undefined>>
		<<set $xchange.pill.changedBody.deviancy to 0>>
	<</if>>

	<<if $xchangeStatSplit is undefined>>
		<<set $xchangeStatSplit to false>>
	<</if>>

	<<if $xchangeStatsMerged is undefined>>
		<<set $xchangeStatsMerged to false>>
	<</if>>

	<<if $xchange.awareness is undefined>>
		<<set $xchange.awareness to 0>>
	<</if>>

	<<if $xchange.heat is undefined>>
		<<set $xchange.heat to {}>>
	<</if>>

	<<if $xchange.heat.bypassAsk is undefined>>
		<<set $xchange.heat.bypassAsk to false>>
	<</if>>

	<<if $xchange.heat.systemOn is undefined>>
		<<set $xchange.heat.systemOn to false>>
	<</if>>

	<<if $xchange.heat.message is undefined>>
		<<set $xchange.heat.message to false>>
	<</if>>

	<<if $xchange.breederOrgasmLock is undefined>>
		<<set $xchange.breederOrgasmLock to false>>
	<</if>>

	<<if $xchange.known is undefined>>
		<<set $xchange.known to []>>
	<</if>>

	<<if $xchange.bottomsize is undefined>>
		<<set $xchange.bottomsize to $bottomsizemin>>
	<</if>>

	<<if $xchange.breastsize is undefined>>
		<<set $xchange.breastsize to $breastsizemin>>
	<</if>>

	<<if $xchange.penissize is undefined>>
		<<set $xchange.penissize to $penissizemin>>
	<</if>>

	<<if $xchange.science is undefined>>
		<<set $xchange.science to 1>>
	<</if>>

	<<if $xchange.math is undefined>>
		<<set $xchange.math to 1>>
	<</if>>

	<<if $xchange.english is undefined>>
		<<set $xchange.english to 1>>
	<</if>>

	<<if $xchange.history is undefined>>
		<<set $xchange.history to 1>>
	<</if>>

	<<if $xchangeknown isnot undefined>>
		<<set $xchange.known to $xchangeknown>>
		<<unset $xchangeknown>>
	<</if>>
	
	<<for _npc range $genderknown>>
		<<set $xchange.expectedGenderBy[_npc] to $player.gender>>
	<</for>>

	<<if $xchange.pill.clone is undefined>>
		<<set $xchange.pill.clone to "none">>
		<<set $xchange.pill.clonedBody to {}>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 and $xchange.pill.changedBody.haircolour is undefined>>
		<<set $xchange.pill.changedBody.leftEyeColour = $leftEyeColour>>
		<<set $xchange.pill.changedBody.rightEyeColour = $rightEyeColour>>
		<<set $xchange.pill.changedBody.haircolour = $haircolour>>
		<<set $xchange.pill.changedBody.hairfringecolour = $hairfringecolour>>
		<<set $xchange.pill.changedBody.hairtype to $hairtype>>
		<<set $xchange.pill.changedBody.fringetype to $fringetype>>
		<<set $xchange.pill.changedBody.hairposition to $hairposition>>
		<<set $xchange.pill.changedBody.earposition to $earposition>>
		<<set $xchange.pill.changedBody.skinColor to $skinColor.natural>>
		<<set $xchange.pill.changedBody.hairtype to $hairtype>>
		<<set $xchange.pill.changedBody.fringetype to $fringetype>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.haircolour is undefined>>
		<<set $xchange.pill.originalBody.leftEyeColour = $leftEyeColour>>
		<<set $xchange.pill.originalBody.rightEyeColour = $rightEyeColour>>
		<<set $xchange.pill.originalBody.haircolour = $haircolour>>
		<<set $xchange.pill.originalBody.hairfringecolour = $hairfringecolour>>
		<<set $xchange.pill.originalBody.hairtype to $hairtype>>
		<<set $xchange.pill.originalBody.fringetype to $fringetype>>
		<<set $xchange.pill.originalBody.hairposition to $hairposition>>
		<<set $xchange.pill.originalBody.earposition to $earposition>>
		<<set $xchange.pill.originalBody.skinColor to $skinColor.natural>>
		<<set $xchange.pill.originalBody.hairtype to $hairtype>>
		<<set $xchange.pill.originalBody.fringetype to $fringetype>>
	<</if>>

	<<if $xchange.postPermanenceFertilityReset is undefined>>
		<<set $xchange.postPermanenceFertilityReset to 1>>
	<</if>>

	<<if $xchange.disregardGender is undefined>>
		<<set $xchange.disregardGender to 0>>
	<</if>>

	<<if $xchange.genderIdentityEnabled is undefined>>
		<<set $xchange.genderIdentityEnabled to 1>>
	<</if>>

	<<if $schoolevent gt 2>><<set $schoolevent to 0>><</if>>

	<<if $recentmolest is -1>><<set $recentmolest to Math.max($moleststat - Time.days, 0)>><</if>>
	<<if $recentrape is -1>><<set $recentrape to Math.max($rapestat - Time.days, 0)>><</if>>

	/* pubtimer: keep undefined when inactive; DO NOT default to 0 */
	<<if $xchange is undefined>>
		<<set $xchange to {}>>
	<</if>>
	<<if $xchange.pubtimer isnot undefined and (!Number.isFinite(Number($xchange.pubtimer)) or Number($xchange.pubtimer) lt 1)>>
		<<run delete State.variables.xchange.pubtimer>>
	<</if>>
	<<if $xchange.machine isnot undefined>>
		<<set $machineVaginalBought to $xchange.machine.vaginalBought? $xchange.machine.vaginalBought : 0>>
		<<set $machineAnalBought to $xchange.machine.analBought? $xchange.machine.analBought : 0>>
		<<unset $xchange.machine>>
	<</if>>

	<<if $portalPantiesEnabled is undefined>>
		<<set $portalPantiesEnabled to 1>>
	<</if>>

