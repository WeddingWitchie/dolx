:: Widgets X-Change Variable Updates [widget]

<<widget "xchange-init">>
	
	<<if $xchange is undefined>>
		<<set $xchange to {
			nonconEnabled: 1,
			pillPermanence: 1,
			disregardGender: 0,
			femininePhysiqueChangePercent: 100,
			masculinePhysiqueChangePercent: 100,
			hermPhysiqueChangePercent: 100,
			impuritySensitivityBonus: 1,
			pillSensitivityChange: 1,
			postPermanenceFertilityReset: 1,
			willpowerPoints: Math.max(200,$willpower),
			known: [],
		}>>
	<</if>>
	<<if $xchangePill is undefined>>
		<<set $xchangePill to {
			active: false,
			duration: 0,
			testPending: false,
			effectsKnown: false,
			breederEffect: false,
			continueEffect: false,
			resistanceEffect: false,
			resistanceChance: 100,
			originalBody: {},
			changedBody: {},
			clone: "none",
			clonedBody: {},
		}>>
	<</if>>
	<<if $genderidentity is undefined>>
		<<set $genderidentity to 1000>>
		<<set $genderidentitymax to 1000>>
	<</if>>
	<<if $xchange_fame is undefined>>
		<<set $xchange_fame to 0>>
	<</if>>
	<<if $hourlyFemininity is undefined>>
		<<set $hourlyFemininity to 0>>
	<</if>>

	<<if $xchange.willpowerSystemEnabled is undefined>>
		<<set $xchange.willpowerSystemEnabled to 1>>
		<<set $xchange.willpowerSuccessCost to 50>>
		<<set $xchange.willpowerFailureCost to 5>>
	<</if>>

	<<if $xchange.supporterCode is undefined>>
		<<set $xchange.supporterCode to "">>
	<</if>>

	<<if $xchange.expectedGenderBy is undefined>>
		<<set $xchange.expectedGenderBy to {}>>
	<</if>>

	
<</widget>>

<<widget "xchange-modupdate">>
	<<xchange-init>>
	
	<<if $xchange.impuritySensitivityBonus is undefined>>
		<<set $xchange.impuritySensitivityBonus to 1>>
	<</if>>
	<<if $xchange.pillSensitivityChange is undefined>>
		<<set $xchange.pillSensitivityChange to 1>>
	<</if>>
	<<if $xchange.willpowerPoints is undefined>>
		<<set $xchange.willpowerPoints to Math.max($willpower, 200)>>
	<</if>>

	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Basic"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Xtra Strength"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Blue Xtra Strength"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Continue"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Resistance"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Blue Resistance"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Test"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink NOW"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Clone: Whitney"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Weekly"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Breeder"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>

	<<if Object.keys($xchangePill.changedBody).length gt 0 && $xchangePill.changedBody.fame is undefined>>
		<<set $xchangePill.changedBody.fame to {
			bestiality: 0,
			business: 0,
			exhibitionism: 0,
			good: 0,
			impreg: 0,
			model: 0,
			pimp: 0,
			pregnancy: 0,
			prostitution: 0,
			rape: 0,
			scrap: 0,
			sex: 0,
			social: 0,
		}>>
	<</if>>
	
	<<if Object.keys($xchangePill.originalBody).length gt 0 && $xchangePill.originalBody.fame is undefined>>
		<<set $xchangePill.originalBody.fame to $fame>>
	<</if>>

	<<if $xchange.known is undefined>>
		<<set $xchange.known to []>>
	<</if>>

	<<if $xchangeknown isnot undefined>>
		<<set $xchange.known to $xchangeknown>>
		<<unset $xchangeknown>>
	<</if>>
	
	<<for _npc range $genderknown>>
		<<set $xchange.expectedGenderBy[_npc] to $player.gender>>
	<</for>>

	<<if $xchangePill.clone is undefined>>
		<<set $xchangePill.clone to "none">>
		<<set $xchangePill.clonedBody to {}>>
	<</if>>

	<<if $xchangePill.changedBody.length gt 0 and $xchangePill.changedBody.haircolour is undefined>>
		<<set $xchangePill.changedBody.leftEyeColour = $leftEyeColour>>
		<<set $xchangePill.changedBody.rightEyeColour = $rightEyeColour>>
		<<set $xchangePill.changedBody.haircolour = $haircolour>>
		<<set $xchangePill.changedBody.hairfringecolour = $hairfringecolour>>
		<<set $xchangePill.changedBody.hairtype to $hairtype>>
		<<set $xchangePill.changedBody.fringetype to $fringetype>>
		<<set $xchangePill.changedBody.hairposition to $hairposition>>
		<<set $xchangePill.changedBody.earposition to $earposition>>
		<<set $xchangePill.changedBody.skinColor to $skinColor.natural>>
		<<set $xchangePill.changedBody.hairtype to $hairtype>>
		<<set $xchangePill.changedBody.fringetype to $fringetype>>
	<</if>>

	<<if $xchangePill.originalBody.length gt 0 and $xchangePill.originalBody.haircolour is undefined>>
		<<set $xchangePill.originalBody.leftEyeColour = $leftEyeColour>>
		<<set $xchangePill.originalBody.rightEyeColour = $rightEyeColour>>
		<<set $xchangePill.originalBody.haircolour = $haircolour>>
		<<set $xchangePill.originalBody.hairfringecolour = $hairfringecolour>>
		<<set $xchangePill.originalBody.hairtype to $hairtype>>
		<<set $xchangePill.originalBody.fringetype to $fringetype>>
		<<set $xchangePill.originalBody.hairposition to $hairposition>>
		<<set $xchangePill.originalBody.earposition to $earposition>>
		<<set $xchangePill.originalBody.skinColor to $skinColor.natural>>
		<<set $xchangePill.originalBody.hairtype to $hairtype>>
		<<set $xchangePill.originalBody.fringetype to $fringetype>>
	<</if>>

	<<if $xchange.postPermanenceFertilityReset is undefined>>
		<<set $xchange.postPermanenceFertilityReset to 1>>
	<</if>>

	<<if $xchange.disregardGender is undefined>>
		<<set $xchange.disregardGender to 0>>
	<</if>>

<</widget>>
