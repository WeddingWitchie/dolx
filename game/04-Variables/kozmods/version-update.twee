	<<for _cr range Object.keys(setup.crimeNames)>>
		<<if ndef $crime[_cr]>>
			<<set $crime[_cr] to {
				current: 		0, 
				history: 		0, 
				daily: 			0, 
				count: 			0, 
				countHistory: 	0}>>
			<<set $xchange.errorLog.push(`Crime "${_cr}" data was found wiped, so has been reset.`)>>
		<</if>>
