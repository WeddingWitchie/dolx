:: Widgets X-Change Variable Updates [widget]

<<widget "xchange-init">>
	<<if $xchangeknown is undefined>>
		<<set $xchangeknown to []>>
	<</if>>
	<<if $xchange is undefined>>
		<<set $xchange to {
			nonconEnabled: 1,
			pillPermanence: 1,
			disregardGender: 1,
			femininePhysiqueChangePercent: 100,
			masculinePhysiqueChangePercent: 100,
			hermPhysiqueChangePercent: 100,
			impuritySensitivityBonus: 1,
			pillSensitivityChange: 1,
			willpowerPoints: Math.max(200,$willpower),
		}>>
	<</if>>
	<<if $xchangePill is undefined>>
		<<set $xchangePill to {
			active: false,
			duration: 0,
			testPending: false,
			effectsKnown: false,
			breederEffect: false,
			continueEffect: false,
			resistanceEffect: false,
			resistanceChance: 100,
			originalBody: {},
			changedBody: {},
		}>>
	<</if>>
	<<if $genderidentity is undefined>>
		<<set $genderidentity to 1000>>
		<<set $genderidentitymax to 1000>>
	<</if>>
	<<if $xchange_fame is undefined>>
		<<set $xchange_fame to 0>>
	<</if>>
	<<if $hourlyFemininity is undefined>>
		<<set $hourlyFemininity to 0>>
	<</if>>
<</widget>>

<<widget "xchange-modupdate">>
	<<xchange-init>>
	
	<<if $xchange.impuritySensitivityBonus is undefined>>
		<<set $xchange.impuritySensitivityBonus to 1>>
	<</if>>
	<<if $xchange.pillSensitivityChange is undefined>>
		<<set $xchange.pillSensitivityChange to 1>>
	<</if>>
	<<if $xchange.willpowerPoints is undefined>>
		<<set $xchange.willpowerPoints to Math.max($willpower, 200)>>
	<</if>>

	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Basic"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Xtra Strength"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Blue Xtra Strength"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Continue"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink Resistance"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Blue Resistance"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Test"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["X-Change Pink NOW"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>

	<<if Object.keys($xchangePill.changedBody).length gt 0 && $xchangePill.changedBody.fame is undefined>>
		<<set $xchangePill.changedBody.fame to {
			bestiality: 0,
			business: 0,
			exhibitionism: 0,
			good: 0,
			impreg: 0,
			model: 0,
			pimp: 0,
			pregnancy: 0,
			prostitution: 0,
			rape: 0,
			scrap: 0,
			sex: 0,
			social: 0,
		}>>
	<</if>>
	
	<<if Object.keys($xchangePill.originalBody).length gt 0 && $xchangePill.originalBody.fame is undefined>>
		<<set $xchangePill.originalBody.fame to $fame>>
	<</if>>
	
<</widget>>
