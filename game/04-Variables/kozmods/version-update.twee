	<<for _pill range _pills>>
		<<if $sexStats and $sexStats.pills and $sexStats.pills.pills and $sexStats.pills.pills[_pill] is undefined>>
			<<physicalAdjustmentsInit>>
			<<break>>
		<</if>>
	<</for>>

	<!-- Safety guards (prevents hard-crash on migrated/partial saves) -->
	<<if $xchange is undefined or $xchange is null>><<set $xchange to {}>><</if>>
	<<if $xchange.errorLog is undefined or $xchange.errorLog is null>><<set $xchange.errorLog to []>><</if>>
	<<if $xchange.pill is undefined or $xchange.pill is null>><<set $xchange.pill to {}>><</if>>
	<<if $xchange.pill.originalBody is undefined or $xchange.pill.originalBody is null>><<set $xchange.pill.originalBody to {}>><</if>>
	<<if $xchange.backComp is undefined or $xchange.backComp is null>><<set $xchange.backComp to {}>><</if>>
	<<if $xchange.expectedGenderBy is undefined or $xchange.expectedGenderBy is null>><<set $xchange.expectedGenderBy to {}>><</if>>
	<<if $genderknown is undefined or $genderknown is null>><<set $genderknown to []>><</if>>
	<<if $xchange.pill.changedBody is undefined or $xchange.pill.changedBody is null>>
		<<if $xchange.pill.active>>
			<<run console.warn("X-Change: pill is active but changedBody is missing on load (migration/corruption).")>>
			<<set $xchange.errorLog.push("Pill was active but changedBody was missing on load. Some effects may be inconsistent; please export/save+report if you see issues.")>>
		<</if>>
		<<set $xchange.pill.changedBody to {}>>
	<</if>>
	<!-- end guards -->

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.fame is undefined>>
		<<set $xchange.pill.changedBody.fame to {
			bestiality: 0,
			business: 0,
			exhibitionism: 0,
			good: 0,
			impreg: 0,
			model: 0,
			pimp: 0,
			pregnancy: 0,
			prostitution: 0,
			rape: 0,
			scrap: 0,
			sex: 0,
			social: 0,
		}>>
	<</if>>
	
	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.fame is undefined>>
		<<set $xchange.pill.originalBody.fame to $fame>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.promiscuity is undefined>>
		<<set $xchange.pill.originalBody.promiscuity to $promiscuity>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.exhibitionism is undefined>>
		<<set $xchange.pill.originalBody.exhibitionism to $exhibitionism>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 && $xchange.pill.originalBody.deviancy is undefined>>
		<<set $xchange.pill.originalBody.deviancy to $deviancy>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.promiscuity is undefined>>
		<<set $xchange.pill.changedBody.promiscuity to 0>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.exhibitionism is undefined>>
		<<set $xchange.pill.changedBody.exhibitionism to 0>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 && $xchange.pill.changedBody.deviancy is undefined>>
		<<set $xchange.pill.changedBody.deviancy to 0>>
	<</if>>

	<<if $xchangeStatSplit is undefined>>
		<<set $xchangeStatSplit to false>>
	<</if>>

	<<if $xchangeStatsMerged is undefined>>
		<<set $xchangeStatsMerged to false>>
	<</if>>

	<<if $xchange.heat.message is undefined>>
		<<set $xchange.heat.message to false>>
	<</if>>

	<<if $xchange.bottomsize is undefined>>
		<<set $xchange.bottomsize to $bottomsizemin>>
	<</if>>

	<<if $xchange.breastsize is undefined>>
		<<set $xchange.breastsize to $breastsizemin>>
	<</if>>

	<<if $xchange.penissize is undefined>>
		<<set $xchange.penissize to $penissizemin>>
	<</if>>

	<<if $xchange.science is undefined>>
		<<set $xchange.science to 1>>
	<</if>>

	<<if $xchange.math is undefined>>
		<<set $xchange.math to 1>>
	<</if>>

	<<if $xchange.english is undefined>>
		<<set $xchange.english to 1>>
	<</if>>

	<<if $xchange.history is undefined>>
		<<set $xchange.history to 1>>
	<</if>>

	<<if $xchangeknown isnot undefined>>
		<<set $xchange.known to $xchangeknown>>
		<<unset $xchangeknown>>
	<</if>>
	
	<<for _npc range $genderknown>>
		<<set $xchange.expectedGenderBy[_npc] to $player.gender>>
	<</for>>

	<<if $xchange.pill.clone is undefined>>
		<<set $xchange.pill.clone to "none">>
		<<set $xchange.pill.clonedBody to {}>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 and $xchange.pill.changedBody.haircolour is undefined>>
		<<set $xchange.pill.changedBody.leftEyeColour = $leftEyeColour>>
		<<set $xchange.pill.changedBody.rightEyeColour = $rightEyeColour>>
		<<set $xchange.pill.changedBody.haircolour = $haircolour>>
		<<set $xchange.pill.changedBody.hairfringecolour = $hairfringecolour>>
		<<set $xchange.pill.changedBody.hairtype to $hairtype>>
		<<set $xchange.pill.changedBody.fringetype to $fringetype>>
		<<set $xchange.pill.changedBody.hairposition to $hairposition>>
		<<set $xchange.pill.changedBody.earposition to $earposition>>
		<<set $xchange.pill.changedBody.skinColor to $skinColor.natural>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.haircolour is undefined>>
		<<set $xchange.pill.originalBody.leftEyeColour = $leftEyeColour>>
		<<set $xchange.pill.originalBody.rightEyeColour = $rightEyeColour>>
		<<set $xchange.pill.originalBody.haircolour = $haircolour>>
		<<set $xchange.pill.originalBody.hairfringecolour = $hairfringecolour>>
		<<set $xchange.pill.originalBody.hairtype to $hairtype>>
		<<set $xchange.pill.originalBody.fringetype to $fringetype>>
		<<set $xchange.pill.originalBody.hairposition to $hairposition>>
		<<set $xchange.pill.originalBody.earposition to $earposition>>
		<<set $xchange.pill.originalBody.skinColor to $skinColor.natural>>
	<</if>>

	<<if $xchange.postPermanenceFertilityReset is undefined>>
		<<set $xchange.postPermanenceFertilityReset to 1>>
	<</if>>

	<<if $xchange.disregardGender is undefined>>
		<<set $xchange.disregardGender to 0>>
	<</if>>

	<<if $schoolevent gt 2>><<set $schoolevent to 0>><</if>>

	<<if $recentmolest is -1>><<set $recentmolest to Math.max($moleststat - Time.days, 0)>><</if>>
	<<if $recentrape is -1>><<set $recentrape to Math.max($rapestat - Time.days, 0)>><</if>>

	<<if $xchange.machine isnot undefined>>
		<<set $machineVaginalBought to $xchange.machine.vaginalBought? $xchange.machine.vaginalBought : 0>>
		<<set $machineAnalBought to $xchange.machine.analBought? $xchange.machine.analBought : 0>>
		<<unset $xchange.machine>>
	<</if>>

	<<if $portalPanties and $portalPanties.state and $portalPanties.state.mouth isnot undefined>>
		<<unset $portalPanties.state.mouth>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.facestyle is undefined>>
		<<set $xchange.pill.originalBody.facevariant to "default">>
		<<set $xchange.pill.originalBody.facestyle to "default">>
		<<if Object.keys($xchange.pill.changedBody).length gt 0 and $xchange.pill.changedBody.facestyle is undefined>>
			<<set $xchange.pill.changedBody.facevariant to $player.gender is "m"? "catty" : "aloof">>
			<<set $xchange.pill.changedBody.facestyle to "default">>
		<</if>>
	<</if>>

	<<set _amcFames to ["sexFame","prostitutionFame","rapeFame","bestialityFame","exhibitionismFame","pregnancyFame","impregFame","scrapFame","goodFame","businessFame","socialFame","modelFame"]>>

	<<for _fame range _amcFames>>
		<<if $AMCTraits[_fame] isnot 1>><<set $AMCTraits[_fame] to 1>><</if>>
	<</for>>

	<!-- Attempt to fix bad initialisation of these variables -->
	<<if isNaN($beingPenetratedOrgasmStat)>>
		<<set $beingPenetratedOrgasmStat to $orgasmstat / 2>>
	<</if>>
	<<if isNaN($penetratingOrgasmStat)>>
		<<set $penetratingOrgasmStat to $orgasmstat / 2>>
	<</if>>

	<<master-audio-update>>

	<<if $xchange.pill.genderflipEffect is undefined>>
		<<if $xchange.pill.active>>
			<<set $xchange.pill.genderflipEffect to true>>
		<<else>>
			<<set $xchange.pill.genderflipEffect to false>>
		<</if>>
	<</if>>

	<<if Object.keys($xchange.pill.changedBody).length gt 0 and $xchange.pill.changedBody.naturalhaircolour is undefined>>
		<<set $xchange.pill.changedBody.naturalhaircolour to $naturalhaircolour>>
		<<set $xchange.pill.changedBody.hairColourGradient to $hairColourGradient>>
		<<set $xchange.pill.changedBody.hairColourStyle to $hairColourStyle>>
		<<set $xchange.pill.changedBody.hairFringeColourGradient to $hairFringeColourGradient>>
		<<set $xchange.pill.changedBody.hairFringeColourStyle to $hairFringeColourStyle>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.naturalhaircolour is undefined>>
		<<set $xchange.pill.originalBody.naturalhaircolour to $naturalhaircolour>>
		<<set $xchange.pill.originalBody.hairColourGradient to $hairColourGradient>>
		<<set $xchange.pill.originalBody.hairColourStyle to $hairColourStyle>>
		<<set $xchange.pill.originalBody.hairFringeColourGradient to $hairFringeColourGradient>>
		<<set $xchange.pill.originalBody.hairFringeColourStyle to $hairFringeColourStyle>>
	<</if>>

	<<set _map to {
		"default": "default",
		"masc": "aloof",
		"fem": "catty"
	}>>
	<<if $facestyle is "fem" or $facestyle is "masc">>
		<<set $facevariant to _map[$facestyle]>>
		<<set $facestyle to "default">>
	<</if>>
	
	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.facevariant is undefined>>
		<<set $xchange.pill.originalBody.facevariant to _map[$xchange.pill.originalBody.facestyle]>>
		<<set $xchange.pill.originalBody.facestyle to "default">>
		<<if Object.keys($xchange.pill.changedBody).length gt 0>>
			<<set $xchange.pill.changedBody.facevariant to _map[$xchange.pill.changedBody.facestyle]>>
			<<set $xchange.pill.changedBody.facestyle to "default">>
		<</if>>
	<</if>>

	<!-- Repairing corrupted variables -->
	<<if isNaN(V.arousal)>><<set V.arousal to 0>><</if>>
	<<if isNaN(V.xchange.willpowerPoints)>><<set V.xchange.willpowerPoints to V.willpower>><</if>>
	<<if V.trackedArousal.includes(NaN)>><<set V.trackedArousal to [0]>><</if>>
	<<if isNaN(V.vaginaArousalWetness)>><<set V.vaginaArousalWetness to 1>><</if>>
	<<if isNaN(V.vaginaWetness)>><<set V.vaginaWetness to 1>><</if>>
	<<if isNaN($combatExtended.brawling)>><<set $combatExtended.brawling to 0>><</if>>

	<<if $xchange.pill.breederEffect and $xchange.pill.breederEdgingStress is undefined>>
		<<set $xchange.pill.breederEdgingStress to 100>>
	<</if>>

	<<if $xchange.blackmail and $xchange.blackmail.questsCompleted is undefined>>
		<<set $xchange.blackmail.questsCompleted to 0>>
	<</if>>

	<<if playerIsXChanged() and $xchange.pill.countdown is undefined>>
		<<set $xchange.pill.countdown to $xchange.pill.duration>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.semen_amount is undefined>>
		<<set $xchange.pill.originalBody.semen_amount to 0>>
		<<set $xchange.pill.originalBody.milk_amount to 0>>
		<<if Object.keys($xchange.pill.changedBody).length gt 0>>
			<<set $xchange.pill.changedBody.semen_amount to 0>>
			<<set $xchange.pill.changedBody.milk_amount to 0>>
		<</if>>
	<</if>>

	<<if $combat is 1 and $enemypleasure is undefined>>
		<<set $enemypleasure to 0>>
	<</if>>
	<<if $combat is 1 and $enemypleasuremax is undefined>>
		<<set $enemypleasuremax to 500>>
	<</if>>

	<<if $neckTucked is undefined>><<set $neckTucked to false>><</if>>

	<<if $player.gender is "m" and $xchange.femininePhysiqueChangePercent isnot undefined>>
		<<set $xchange.physiqueChangePercent to $xchange.femininePhysiqueChangePercent>>
		<<unset $xchange.femininePhysiqueChangePercent>>
	<</if>>

	<<if $player.gender is "f" and $xchange.masculinePhysiqueChangePercent isnot undefined>>
		<<set $xchange.physiqueChangePercent to $xchange.masculinePhysiqueChangePercent>>
		<<unset $xchange.masculinePhysiqueChangePercent>>
	<</if>>

	<<unset $xchange.hermPhysiqueChangePercent>>

	<<if $xchange.backComp["250824"] is undefined>>
		<<set $xchange.backComp["250824"] to true>>
		<<if playerIsXChanged()>>
			<<set $breastsensitivity = Math.clamp($breastsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 6)>>
			<<set $bottomsensitivity = Math.clamp($bottomsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 3)>>
			<<set $genitalsensitivity = Math.clamp($genitalsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 10)>>
		<</if>>
	<</if>>

	<<for _cr range Object.keys(setup.crimeNames)>>
		<<if ndef $crime[_cr]>>
			<<set $crime[_cr] to {
				current: 		0, 
				history: 		0, 
				daily: 			0, 
				count: 			0, 
				countHistory: 	0}>>
			<<set $xchange.errorLog.push(`Crime "${_cr}" data was found wiped, so has been reset.`)>>
		<</if>>
	<</for>>

	<<if isNaN($innocencetrauma) or isNaN($trauma)>>
		<<set $innocencetrauma to 0>>
		<<set $trauma to 0>>
	<</if>>

	<<if !["m","f"].includes($player.gender) or !["m","f"].includes($player.sex)>>
		<<set $effectsmessage to 1>>
		<<set $hermSaveWarningMessage to 1>>
		<<set $player.gender to "m">>
		<<set $player.sex to "m">>
		<<set $vaginause to "none">>
		<<set $vaginastate to "none">>
		<<set $penisuse to 0>>
		<<set $penisstate to 0>>
		<<set $player.ballsExist to true>>
		<<set $player.penisExist to true>>
		<<set $player.vaginaExist to false>>
		<<set $sexStats.vagina.menstruation.running = false>>
		<<set $xchange.saveWasLoadedAsHerm to 1>>
	<</if>>

	<<if $xchange.saveWasLoadedAsHerm>>
		<<run console.warn("WARNING: This save featured a non-DoLX herm at some point! This bug report may be invalid!")>>
	<</if>>

	<<if $beauty gt 18600>>
		<<set $beauty to 20000>>
	<</if>>

	<<if $identity.init lt 2>>
		<<set $effectsmessage to 1>>
		<<set $identityWarningMessage to 1>>
	<</if>>

	<<if $averytimespilled is undefined>>
		<<set $averytimespilled to 0>>
	<</if>>

	<<if $xchange.spikerates["dumb-bitch"] is undefined>>
		<<set $xchange.spikerates["dumb-bitch"] to $xchange.spikerates["dumbbitch"]>>
		<<unset $xchange.spikerates["dumbbitch"]>>
	<</if>>

	<<if $xchange.removerPillCatalogue>>
		<<for _i to 0; _i lt $xchange.removerPillCatalogue.length; _i++>>
			<<if $xchange.removerPillCatalogue[_i] is "dumbbitch">>
				<<set $xchange.removerPillCatalogue[_i] to "dumb-bitch">>
			<</if>>
		<</for>>
	<</if>>
	<<clamp>>
<</widget>>

<<widget "xchange-sanity">>
	/* NOTE: All checks below are already performed by <<xchange-init>>.
	   This widget exists as a lightweight per-passage safety net.
	   If <<xchange-init>> is guaranteed to have run, this is a no-op. */
	<<if $xchange is undefined>><<set $xchange to {}>><</if>>
	<<if $xchange.known is undefined>><<set $xchange.known to []>><</if>>
	<<if $xchange.pill is undefined>><<set $xchange.pill to {}>><</if>>
	<<if $xchange.pill.clone is undefined or $xchange.pill.clone is "" or $xchange.pill.clone is null>><<set $xchange.pill.clone to "none">><</if>>
	<<if $xchange.pill.clonedBody is undefined or $xchange.pill.clonedBody is null>><<set $xchange.pill.clonedBody to {}>><</if>>
	<<if $sexStats.pills.pills[_premiumPillName] is undefined>><<set $sexStats.pills.pills[_premiumPillName] to {owned: 0, doseTaken: 0, overdose: 0}>><</if>>
	
	<<if $pregnancyStats.aftermorningpills is undefined>>
		<<set $pregnancyStats.aftermorningpills to 0>>
	<<elseif !Number.isFinite($pregnancyStats.aftermorningpills)>>
		<<run console.warn("[Morning After pill] pregnancyStats.aftermorningpills is invalid; resetting:", V.pregnancyStats?.aftermorningpills)>>
		<<set $pregnancyStats.aftermorningpills to 0>>
	<</if>>

	/* pubtimer: must be a number >= 1, otherwise delete it (inactive). */
	<<run (function () { var x = State.variables.xchange; if (!x) { return; } var n = Number(x.pubtimer);
		if (x.pubtimer !== undefined && (!Number.isFinite(n) || n < 1)) { delete x.pubtimer; }
	})()>>

	<<run (function () {
		if (typeof window.C !== "object" || window.C === null) return;
		if (typeof C.tiredness !== "object" || C.tiredness === null) C.tiredness = {};
		if (!Number.isFinite(C.tiredness.max)) C.tiredness.max = 2000;
		if (typeof C.physique !== "object" || C.physique === null) C.physique = {};
		if (!Number.isFinite(C.physique.max)) C.physique.max = 30000;
	})()>>
<</widget>>

<<widget "ensureStatOverlayData">>
	/* police / misc */
	<<if $stat_police is undefined>><<set $stat_police to { community: 0, pillory: 0, prison: 0 }>><</if>>
	<<if $schoolLessonsMissed is undefined>><<set $schoolLessonsMissed to { science: 0, maths: 0, housekeeping: 0, english: 0, history: 0, swimming: 0 }>><</if>>
	<<if $fertiliser is undefined>><<set $fertiliser to {current:0,used:0}>><</if>>
	<<if $brothelVending is undefined>><<set $brothelVending to { total: 0 }>><</if>>
	<<if $wraith is undefined>><<set $wraith to { possessCount: 0 }>><</if>>

	/* gambling */
	<<if $estatePersistent is undefined>>
		<<set $estatePersistent to {
			totalGamesPlayed: 0,
			totalGamesPlayedWithBetting: 0,
			totalRoundsWon: 0,
			totalRoundsLost: 0,
			totalRoundsTied: 0,
			totalBetRoundsWon: 0,
			totalBetRoundsLost: 0,
			totalBetRoundsTied: 0,
			totalCaughtCheating: 0,
			winStreakHighScore: 0
		}>>
	<</if>>
	<<if $estatePersistent.totalGamesPlayed is undefined>><<set $estatePersistent.totalGamesPlayed to 0>><</if>>
	<<if $estatePersistent.totalGamesPlayedWithBetting is undefined>><<set $estatePersistent.totalGamesPlayedWithBetting to 0>><</if>>
	<<if $estatePersistent.totalRoundsWon is undefined>><<set $estatePersistent.totalRoundsWon to 0>><</if>>
	<<if $estatePersistent.totalRoundsLost is undefined>><<set $estatePersistent.totalRoundsLost to 0>><</if>>
	<<if $estatePersistent.totalRoundsTied is undefined>><<set $estatePersistent.totalRoundsTied to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsWon is undefined>><<set $estatePersistent.totalBetRoundsWon to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsLost is undefined>><<set $estatePersistent.totalBetRoundsLost to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsTied is undefined>><<set $estatePersistent.totalBetRoundsTied to 0>><</if>>
	<<if $estatePersistent.totalBetMoneyMade is undefined>><<set $estatePersistent.totalBetMoneyMade to 0>><</if>>
	<<if $estatePersistent.totalBetMoneyLost is undefined>><<set $estatePersistent.totalBetMoneyLost to 0>><</if>>
	<<if $estatePersistent.totalMoneyConfiscated is undefined>><<set $estatePersistent.totalMoneyConfiscated to 0>><</if>>
	<<if $estatePersistent.totalTipMoneyMade is undefined>><<set $estatePersistent.totalTipMoneyMade to 0>><</if>>
	<<if $estatePersistent.totalCaughtCheating is undefined>><<set $estatePersistent.totalCaughtCheating to 0>><</if>>
	<<if $estatePersistent.winStreakHighScore is undefined>><<set $estatePersistent.winStreakHighScore to 0>><</if>>

	/* dates */
	<<if $dateCount is undefined>>
		<<set $dateCount to {
			Total: 0,
			Robin: 0,
			Whitney: 0,
			Kylar: 0,
			Eden: 0,
			Avery: 0,
			BlackWolfHunts: 0,
			GreatHawkHunts: 0,
			GreatHawkCasual: 0,
			Alex: 0,
			Sydney: 0,
			Gwylan: 0,
			GwylanBeast: 0,
			GwylanSex: 0
		}>>
	<</if>>
	<<if $dateCount.Total is undefined>><<set $dateCount.Total to 0>><</if>>
	<<if $dateCount.Robin is undefined>><<set $dateCount.Robin to 0>><</if>>
	<<if $dateCount.Whitney is undefined>><<set $dateCount.Whitney to 0>><</if>>
	<<if $dateCount.Kylar is undefined>><<set $dateCount.Kylar to 0>><</if>>
	<<if $dateCount.Eden is undefined>><<set $dateCount.Eden to 0>><</if>>
	<<if $dateCount.Avery is undefined>><<set $dateCount.Avery to 0>><</if>>
	<<if $dateCount.BlackWolfHunts is undefined>><<set $dateCount.BlackWolfHunts to 0>><</if>>
	<<if $dateCount.GreatHawkHunts is undefined>><<set $dateCount.GreatHawkHunts to 0>><</if>>
	<<if $dateCount.GreatHawkCasual is undefined>><<set $dateCount.GreatHawkCasual to 0>><</if>>
	<<if $dateCount.Alex is undefined>><<set $dateCount.Alex to 0>><</if>>
	<<if $dateCount.Sydney is undefined>><<set $dateCount.Sydney to 0>><</if>>
	<<if $dateCount.Gwylan is undefined>><<set $dateCount.Gwylan to 0>><</if>>
	<<if $dateCount.GwylanSex is undefined>><<set $dateCount.GwylanSex to 0>><</if>>

	/* pregnancy */
	<<if $pregnancyStats is undefined>>
		<<set $pregnancyStats to {
			playerChildren:0,
			humanChildren:0,
			wolfChildren:0,
			npcChildren:0,
			npcChildrenUnrelatedToPlayer:0,
			npcTotalBirthEvents:0,
			humanToysUnlocked: false,
			wolfToysUnlocked: false,
			hawkToysUnlocked: false,
			mother: 0,
			aftermorningpills: 0,
			pregnancyTestsTaken: 0,
			parasiteBook: 0,
			parasiteDoctorEvents: 0,
			awareOfBirthId: {},
		}>>
	<</if>>
	<<if $pregnancyStats.awareOfBirthId is undefined>><<set $pregnancyStats.awareOfBirthId to {}>><</if>>
	<<if $pregnancyStats.talkedAboutPregnancy is undefined>><<set $pregnancyStats.talkedAboutPregnancy to {}>><</if>>
	<<if $pregnancyStats.morningSicknessWaking is undefined>><<set $pregnancyStats.morningSicknessWaking to 0>><</if>>
	<<if $pregnancyStats.morningSicknessGeneral is undefined>><<set $pregnancyStats.morningSicknessGeneral to 0>><</if>>
	<<if $pregnancyStats.heatStillEnabled is undefined>><<set $pregnancyStats.heatStillEnabled to true>><</if>>
	<<if $pregnancyStats.playerVirginBirths is undefined>><<set $pregnancyStats.playerVirginBirths to []>><</if>>
	<<if $pregnancyStats.playerChildren is undefined>><<set $pregnancyStats.playerChildren to 0>><</if>>
	<<if $pregnancyStats.npcChildren is undefined>><<set $pregnancyStats.npcChildren to 0>><</if>>
	<<if $pregnancyStats.totalDaysPregnancyKnown is undefined>><<set $pregnancyStats.totalDaysPregnancyKnown to 0>><</if>>
	<<if $pregnancyStats.humanChildren is undefined>><<set $pregnancyStats.humanChildren to 0>><</if>>
	<<if $pregnancyStats.wolfChildren is undefined>><<set $pregnancyStats.wolfChildren to 0>><</if>>
	<<if $pregnancyStats.hawkChildren is undefined>><<set $pregnancyStats.hawkChildren to 0>><</if>>
	<<if $pregnancyStats.childInteractions is undefined>><<set $pregnancyStats.childInteractions to 0>><</if>>
	<<if $pregnancyStats.orphanageMilkBottlesTotal is undefined>><<set $pregnancyStats.orphanageMilkBottlesTotal to 0>><</if>>
	<<if $pregnancyStats.pregnancyTestsTaken is undefined>><<set $pregnancyStats.pregnancyTestsTaken to 0>><</if>>
	<<if $children is undefined>><<set $children to {}>><</if>>
	<<if $babyIntros is undefined>><<set $babyIntros to {}>><</if>>
<</widget>>

	<<widget "ensureSexStatsForPhysicalAdjustments">>
		/* Root */
		<<if $sexStats is undefined or $sexStats is null>>
			<<set $sexStats to {
				"breasts": { "playedWith": 0 },
				"creampie": { "self": { "anus":0, "mouth":0, "vagina":0 }, "npc":{ "anus":0, "mouth":0, "vagina":0 } },
				"pills":{
					"pills":{
						'bottom reduction':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'bottom growth':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'bottom blocker':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'breast reduction':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'breast growth':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'breast blocker':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'penis reduction':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'penis growth':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'penis blocker':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'fertility booster':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'contraceptive':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'asylum\'s prescription':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'Dr Harper\'s prescription':{autoTake: false, doseTaken: 0, owned: 0, overdose: 0},
						'Anti-Parasite Cream': { autoTake: false, doseTaken: 0, owned: 0, overdose: 0 },
					},
					"boughtOnce": false,
					"lastTaken":{"bottom":'', "breast":'', "penis":'', "pregnancy":''},
					"mostTaken":{"bottom":'', "breast":'', "penis":'', "pregnancy":''}
				} }>>
		<</if>>

		/* Breasts */
		<<if $sexStats.breasts is undefined or $sexStats.breasts is null>><<set $sexStats.breasts to {}>><</if>>
		<<if $sexStats.breasts.playedWith is undefined>><<set $sexStats.breasts.playedWith to 0>><</if>>

		/* Creampie buckets */
		<<if $sexStats.creampie is undefined or $sexStats.creampie is null>><<set $sexStats.creampie to {}>><</if>>
		<<if $sexStats.creampie.self is undefined or $sexStats.creampie.self is null>><<set $sexStats.creampie.self to {}>><</if>>
		<<if $sexStats.creampie.npc is undefined or $sexStats.creampie.npc is null>><<set $sexStats.creampie.npc to {}>><</if>>
		<<if $sexStats.creampie.self.anus is undefined>><<set $sexStats.creampie.self.anus to 0>><</if>>
		<<if $sexStats.creampie.self.mouth is undefined>><<set $sexStats.creampie.self.mouth to 0>><</if>>
		<<if $sexStats.creampie.self.vagina is undefined>><<set $sexStats.creampie.self.vagina to 0>><</if>>
		<<if $sexStats.creampie.npc.anus is undefined>><<set $sexStats.creampie.npc.anus to 0>><</if>>
		<<if $sexStats.creampie.npc.mouth is undefined>><<set $sexStats.creampie.npc.mouth to 0>><</if>>
		<<if $sexStats.creampie.npc.vagina is undefined>><<set $sexStats.creampie.npc.vagina to 0>><</if>>

		/* Vagina / Anus + pregnancy chain */
		<<if $sexStats.vagina is undefined or $sexStats.vagina is null>>
			<<set _baseDays to random(24,38)>>
			<<if _baseDays lt 26>><<set _baseDaysRng to random(0,4)>><<elseif _baseDays gte 30>><<set _baseDaysRng to random(-4,0)>><<else>><<set _baseDaysRng to random(-2,2)>><</if>>
			<<set _currentDaysMax to _baseDays + random(0, _baseDaysRng)>>
			<<set $sexStats.vagina to {
				"pregnancy": { "fetus": [], "givenBirth": 0, "parasiteBirthEvents": 0, "totalBirthEvents": 0, "motherStatus": 0, "waterBreaking": false, "type": null, "timer": null, "timerEnd": null, "awareOf": null, "potentialFathers": [], },
				"menstruation":{ "baseDays": _baseDays, "baseDaysRng": _baseDaysRng, "currentDay": random(0, _baseDays + random(0,_baseDaysRng)), "lastDaysMax": _currentDaysMax, "currentDaysMax": _currentDaysMax, "currentState": "normal", "recoveryTime": null, "recoveryTimeStart": null, "recoveryStage": null, "periodEnabled": true, "running": false, "stages": [0, 0, 0, 0], },
				"sperm":[]
			}>>
			<<set _menstruation to $sexStats.vagina.menstruation>>
			<<set _stage2 to Math.round(_menstruation.currentDaysMax * 0.17)>>
			<<if _stage2 gte 4>><<set _stage2-->><</if>>
			<<set _stage3 to Math.round(_menstruation.currentDaysMax * 0.5)>>
			<<if _stage3 lt 13>><<set _stage3++>><<elseif _stage3 gte 18>><<set _stage3-->><</if>>
			<<set _menstruation.stages to [0, _stage2, _stage3, _stage3 + random(1,2) * 0.5]>>
			<<if $player.vaginaExist>><<set $sexStats.vagina.menstruation.running = true>><</if>>
		<</if>>
		<<if $sexStats.vagina.pregnancy is undefined or $sexStats.vagina.pregnancy is null>><<set $sexStats.vagina.pregnancy to {}>><</if>>
		<<if $sexStats.vagina.pregnancy.fetus is undefined>><<set $sexStats.vagina.pregnancy.fetus to []>><</if>>
		<<if $sexStats.vagina.pregnancy.potentialFathers is undefined>><<set $sexStats.vagina.pregnancy.potentialFathers to []>><</if>>
		<<if $sexStats.vagina.pregnancy.parasiteFeltMovement is undefined>><<set $sexStats.vagina.pregnancy.parasiteFeltMovement to false>><</if>>
		<<if $sexStats.vagina.pregnancy.timeEnd is undefined>><<set $sexStats.vagina.pregnancy.timeEnd to null>><</if>>
		<<if $sexStats.anus.pregnancy is undefined or $sexStats.anus.pregnancy is null>><<set $sexStats.anus.pregnancy to {}>><</if>>	
		<<if $sexStats.vagina.pregnancy.parasiteBirthEvents is undefined>>
			<<set $sexStats.vagina.pregnancy.parasiteBirthEvents to 0>>
			<<set $sexStats.vagina.pregnancy.parasiteFeltMovement to false>>
			<<set $sexStats.vagina.pregnancy.timerEnd to null>>
			<<run delete $sexStats.vagina.pregnancy.beastMotherStatus>>
			<<run delete $sexStats.vagina.pregnancy.ultrasoundDone>>
			<<run delete $sexStats.vagina.pregnancy.morningSicknessWaking>>
			<<run delete $sexStats.vagina.pregnancy.morningSicknessGeneral>>
			<<run delete $sexStats.vagina.pregnancy.bellySize>>
			<<run delete $sexStats.vagina.pregnancy.timerStart>>
		<</if>>
		<<if $sexStats.anus is undefined or $sexStats.anus is null>><<set $sexStats.anus to { "pregnancy": { fetus: [], givenBirth: 0, parasiteBirthEvents: 0, motherStatus: 0, type: null, awareOf: null, timer: null, timerEnd: null, type: null, potentialFathers: [], totalBirthEvents: 0, }, "sperm":[], }>><</if>>
		<<if $sexStats.anus.pregnancy.fetus is undefined>>
			<<set $sexStats.anus.pregnancy.fetus to []>>
			<<for $_i to 0; $_i lt 4; $_i++>>
				<<if $sexStats.anus.pregnancy[$_i] isnot null>>
					<<run $sexStats.anus.pregnancy.fetus.push(clone($sexStats.anus.pregnancy[$_i]))>>
					<<if $sexStats.anus.pregnancy.fetus.last().stats.gender is "Futa">>
						<<set $sexStats.anus.pregnancy.fetus.last().stats.gender to "Hermaphrodite">>
					<</if>>
					<<set $sexStats.anus.pregnancy.type to "parasite">>
				<</if>>
				<<run delete $sexStats.anus.pregnancy[$_i]>>
			<</for>>
			<<if !$sexStats.anus.pregnancy.parasiteBirthEvents>>
				<<set $sexStats.anus.pregnancy.parasiteBirthEvents to clone($sexStats.anus.pregnancy.givenBirth)>>
				<<set $sexStats.anus.pregnancy.parasiteFeltMovement to clone($sexStats.anus.pregnancy.feltMovement)>>
				<<set $sexStats.anus.pregnancy.givenBirth to 0>>
			<</if>>
			<<pregnancyVar>> <!--In case it's not been ran before -->
			<<if $sexStats.anus.pregnancy.seenDoctor>><<set $pregnancyStats.parasiteDoctorEvents to clone($sexStats.anus.pregnancy.seenDoctor)>><</if>>
			<<if $sexStats.anus.pregnancy.book>><<set $pregnancyStats.parasiteBook to clone($sexStats.anus.pregnancy.book)>><</if>>
			<<if $sexStats.anus.pregnancy.typesSeen>><<set $pregnancyStats.parasiteTypesSeen to clone($sexStats.anus.pregnancy.typesSeen)>><</if>>
			<<if $sexStats.anus.pregnancy.variantsSeen>><<set $pregnancyStats.parasiteVariantsSeen to clone($sexStats.anus.pregnancy.variantsSeen)>><</if>>

			/*Vagina Parity Variables*/
			<<set $sexStats.anus.pregnancy.awareOf to null>>
			<<set $sexStats.anus.pregnancy.timer to null>>
			<<set $sexStats.anus.pregnancy.timerEnd to null>>
			<<set $sexStats.anus.pregnancy.timerEnd to null>>
			<<set $sexStats.anus.pregnancy.waterBreaking to false>>
			<<set $sexStats.anus.pregnancy.potentialFathers to []>>
			<<set $sexStats.anus.pregnancy.totalBirthEvents to 0>>

			<<set $sexStats.anus.sperm to []>>

			<<run delete $sexStats.anus.pregnancy.maxCount>>
			<<run delete $sexStats.anus.pregnancy.count>>
			<<run delete $sexStats.anus.pregnancy.lowestDaysLeft>>
			<<run delete $sexStats.anus.pregnancy.lowestTimeLeft>>
			<<run delete $sexStats.anus.pregnancy.feltMovement>>
			<<run delete $sexStats.anus.pregnancy.fertile>>
			<<run delete $sexStats.anus.pregnancy.fertilised>>
			<<run delete $sexStats.anus.pregnancy.namesChildren>>
			<<run delete $sexStats.anus.pregnancy.seenDoctor>>
			<<run delete $sexStats.anus.pregnancy.book>>
			<<run delete $sexStats.anus.pregnancy.typesSeen>>
			<<run delete $sexStats.anus.pregnancy.variantsSeen>>
			<<run delete $sexStats.anus.pregnancy.autoRepairDone>>
		<</if>>
		<<if $sexStats.anus.pregnancy.potentialFathers is undefined>><<set $sexStats.anus.pregnancy.potentialFathers to []>><</if>>
		<<if $sexStats.anus.pregnancy.parasiteBirthEvents is undefined>><<set $sexStats.anus.pregnancy.parasiteBirthEvents to 0>><</if>>
		<<if $sexStats.anus.pregnancy.parasiteFeltMovement is undefined>><<set $sexStats.anus.pregnancy.parasiteFeltMovement to false>><</if>>
		<<if $sexStats.anus.pregnancy.timeEnd is undefined>><<set $sexStats.anus.pregnancy.timeEnd to null>><</if>>

		/* Pills structures used by physicalAdjustments */
		<<if $sexStats.pills is undefined or $sexStats.pills is null>><<set $sexStats.pills to {}>><</if>>
		<<if $sexStats.pills.mostTaken is undefined or $sexStats.pills.mostTaken is null>><<set $sexStats.pills.mostTaken to {}>><</if>>
		<<if $sexStats.pills["pills"] is undefined or $sexStats.pills["pills"] is null>><<set $sexStats.pills["pills"] to {}>><</if>>

		<<if $sexStats.pills.mostTaken["breast"] is undefined>><<set $sexStats.pills.mostTaken["breast"] to "">><</if>>
		<<if $sexStats.pills.mostTaken["penis"] is undefined>><<set $sexStats.pills.mostTaken["penis"] to "">><</if>>
		<<if $sexStats.pills.mostTaken["bottom"] is undefined>><<set $sexStats.pills.mostTaken["bottom"] to "">><</if>>

		<<if $sexStats.pills["pills"]["breast growth"] is undefined>><<set $sexStats.pills["pills"]["breast growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["breast reduction"] is undefined>><<set $sexStats.pills["pills"]["breast reduction"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["penis growth"] is undefined>><<set $sexStats.pills["pills"]["penis growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["penis reduction"] is undefined>><<set $sexStats.pills["pills"]["penis reduction"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["bottom growth"] is undefined>><<set $sexStats.pills["pills"]["bottom growth"] to {doseTaken:0, overdose:0}>><</if>>
		<<if $sexStats.pills["pills"]["bottom reduction"] is undefined>><<set $sexStats.pills["pills"]["bottom reduction"] to {doseTaken:0, overdose:0}>><</if>>
	<</widget>>