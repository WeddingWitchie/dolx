		<<set $xchange.pill.changedBody.hairColourGradient to $hairColourGradient>>
		<<set $xchange.pill.changedBody.hairColourStyle to $hairColourStyle>>
		<<set $xchange.pill.changedBody.hairFringeColourGradient to $hairFringeColourGradient>>
		<<set $xchange.pill.changedBody.hairFringeColourStyle to $hairFringeColourStyle>>
	<</if>>

	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.naturalhaircolour is undefined>>
		<<set $xchange.pill.originalBody.naturalhaircolour to $naturalhaircolour>>
		<<set $xchange.pill.originalBody.hairColourGradient to $hairColourGradient>>
		<<set $xchange.pill.originalBody.hairColourStyle to $hairColourStyle>>
		<<set $xchange.pill.originalBody.hairFringeColourGradient to $hairFringeColourGradient>>
		<<set $xchange.pill.originalBody.hairFringeColourStyle to $hairFringeColourStyle>>
	<</if>>

	<<set _map to {
		"default": "default",
		"masc": "aloof",
		"fem": "catty"
	}>>
	<<if $facestyle is "fem" or $facestyle is "masc">>
		<<set $facevariant to _map[$facestyle]>>
		<<set $facestyle to "default">>
	<</if>>
	
	<<if Object.keys($xchange.pill.originalBody).length gt 0 and $xchange.pill.originalBody.facevariant is undefined>>
		<<set $xchange.pill.originalBody.facevariant to _map[$xchange.pill.originalBody.facestyle]>>
		<<set $xchange.pill.originalBody.facestyle to "default">>
