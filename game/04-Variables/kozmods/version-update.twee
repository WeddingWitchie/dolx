		<<set $xchange.pill.originalBody.milk_amount to 0>>
		<<if Object.keys($xchange.pill.changedBody).length gt 0>>
			<<set $xchange.pill.changedBody.semen_amount to 0>>
			<<set $xchange.pill.changedBody.milk_amount to 0>>
		<</if>>
	<</if>>

	<<if $combat is 1 and $enemypleasure is undefined>>
		<<set $enemypleasure to 0>>
	<</if>>
	<<if $combat is 1 and $enemypleasuremax is undefined>>
		<<set $enemypleasuremax to 500>>
	<</if>>

	<<if $neckTucked is undefined>><<set $neckTucked to false>><</if>>

	<<if $player.gender is "m" and $xchange.femininePhysiqueChangePercent isnot undefined>>
		<<set $xchange.physiqueChangePercent to $xchange.femininePhysiqueChangePercent>>
		<<unset $xchange.femininePhysiqueChangePercent>>
	<</if>>

	<<if $player.gender is "f" and $xchange.masculinePhysiqueChangePercent isnot undefined>>
		<<set $xchange.physiqueChangePercent to $xchange.masculinePhysiqueChangePercent>>
		<<unset $xchange.masculinePhysiqueChangePercent>>
	<</if>>

	<<unset $xchange.hermPhysiqueChangePercent>>

	<<if $xchange.backComp["250824"] is undefined>>
		<<set $xchange.backComp["250824"] to true>>
		<<if playerIsXChanged()>>
			<<set $breastsensitivity = Math.clamp($breastsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 6)>>
			<<set $bottomsensitivity = Math.clamp($bottomsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 3)>>
			<<set $genitalsensitivity = Math.clamp($genitalsensitivity+($player.sex is "f"? -1 : 1) * V.xchange.pillSensitivityChange, 0.25, 10)>>
		<</if>>
