				<<else>>
					<<if random(1, 100) lte $blackchance>>
						<<set $NPCList[$_s].skincolour to "black">>
					<<else>>
						<<set $NPCList[$_s].skincolour to "white">>
					<</if>>
				<</if>>
			<</if>>
		<</for>>
	<</if>>

