	/* DoLP/modUpdate owns old $background migration.
	Keep this here instead of X-Change version-update so legacy string backgrounds can be converted with their matching $backgroundTraits entry. */
	<<if $backgroundTraits is undefined or !Array.isArray($backgroundTraits)>>
		<<set $backgroundTraits to []>>
	<</if>>
	<<if typeof $background is "string" or $background is undefined or $background is null or typeof $background isnot "object" or Array.isArray($background)>>
		<<unset _tmp>>
		<<if $background is "nerd">>
			<<set _tmp to "nerd">>
		<</if>>
		<<if $background is "athlete">>
			<<set _tmp to "athlete">>
		<</if>>
		<<if $background is "delinquent">>
			<<set _tmp to "delinquent">>
		<</if>>
