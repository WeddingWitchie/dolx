		<</if>>
		<<if $background is "lustful">>
			<<set _tmp to "lustful">>
		<</if>>
		<<if $background is "plantlover">>
			<<set _tmp to "plantlover">>
		<</if>>

		<<unset $background>>
		<<set $background to {}>>
		<<if _tmp isnot undefined>>
			<<set $background[_tmp] to true>>
			<<if !$backgroundTraits.includes(_tmp)>>
				<<set $backgroundTraits.push(_tmp)>>
			<</if>>
			<<unset _tmp>>
		<</if>>
	<</if>>

