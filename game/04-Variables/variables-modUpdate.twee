		<<set $loveInterest.senary to "None">>
	<</if>>

	<<if $foodstuff is undefined>>
		<<set $foodstuff to {}>>
	<</if>>
	<<set _food_keys to Object.keys(setup.foodstuff)>>
	<<for _i to 0; _i lt _food_keys.length; _i++>>
		<<set $_type to _food_keys[_i]>>
		<<if $foodstuff[$_type] is undefined>>
			<<set $foodstuff[$_type] to {"amount": 0}>>
		<<elseif $foodstuff[$_type].amount is undefined>>
			<<set $foodstuff[$_type].amount to 0>>
		<</if>>

		/* Preserve old pre-foodstuff plant inventory amounts without silently resetting them. */
		<<if $plants isnot undefined and $plants[$_type] isnot undefined and typeof $plants[$_type].amount is "number" and $plants[$_type].amount gt $foodstuff[$_type].amount>>
			<<set $foodstuff[$_type].amount to $plants[$_type].amount>>
			<<run console.warn("[DoLX modUpdate] Migrated old $plants amount into $foodstuff.", { type: $_type, amount: $foodstuff[$_type].amount })>>
		<</if>>
	<</for>>
	/* Drop foodstuff entries other mods baked into the save; unknown keys crash shop/kitchen/tending lookups. */
	<<run pruneFoodstuff()>>

	<<if $baileyDeposit is undefined>>
		<<set $baileyDeposit to 0>>
	<</if>>

	<<if $depositMax is undefined>>
		<<set $depositMax to 0>>
	<</if>>

	<<if $depositWithdrawalFee is undefined>>
		<<set $depositWithdrawalFee to 10>>
	<</if>>

	<<set _rentstage to $rentstage - 1>>
	<<set _baileyDepositMax to 0>>
	<<for _i to 1; _i <= $depositMax; _i++>>
		<<set $rentmoney to [10000,30000,50000,70000,100000,150000,200000][Math.clamp(_rentstage,0,6)]>>
		<<rentmod>>
		<<set _rentstage += 1>>
		<<set _baileyDepositMax += $rentmoney + ($babyRent or 0)>>
	<</for>>

	<<if $factoryUpgrades is undefined>>
		<<set $factoryUpgrades to {}>>
	<</if>>

	<<if $rightArmPosition is undefined>>
		<<set $rightArmPosition to "below">>
	<</if>>

	<<set $parasiteCapMult to Math.clamp(Number($parasiteCapMult) || 1, 1, 10)>>

	/* Backfill transformation parts for saves that already had these objects before the keys existed. */
	<<if $transformationParts.waterdragon.horns is undefined>>
		<<if $waterdragon gte 3 or $waterdragontf is 1>>
			<<set $transformationParts.waterdragon.horns to "default">>
		<<else>>
			<<set $transformationParts.waterdragon.horns to "disabled">>
		<</if>>
	<</if>>
	<<if $transformationParts.waterdragon.ears is undefined>>
		<<if $waterdragon gte 4 or $waterdragontf is 1>>
			<<set $transformationParts.waterdragon.ears to "default">>
		<<else>>
			<<set $transformationParts.waterdragon.ears to "disabled">>
		<</if>>
	<</if>>
	<<if $transformationParts.waterdragon.tail is undefined>>
		<<if $waterdragon gte 7 or $waterdragontf is 1>>
			<<set $transformationParts.waterdragon.tail to "default">>
		<<else>>
			<<set $transformationParts.waterdragon.tail to "disabled">>
		<</if>>
	<</if>>

	<<if $stressBeauty isnot undefined>>
		<<unset $stressBeauty>>
	<</if>>
	<<if $beautyMult isnot undefined>>
		<<unset $beautyMult>>
	<</if>>
	<<if $fame.undefined isnot undefined>>
		<<run delete $fame.undefined>>
	<</if>>

	<<if $wingslayer is undefined>>
		<<set $wingslayer to "back">>
	<</if>>

	<<if $harpytf is 1 or $angeltf is 1 or $fallenangeltf is 1 or $fallenangelplustf is 1 or $demontf is 1>>
		<<set $birdGlide to 1>>
	<</if>>

	<<if $harpytf is 1 or $birdFlyUnlocked is 1 or ($bird.syndrome isnot undefined and $bird.lock is undefined)>>
		<<set $birdFly to 1>>
	<</if>>

	<<if $combatExtended.standingFightsType is undefined>>
		<<set $combatExtended.standingFightsType to "normal">>
	<</if>>

	<<if $orphanageLocked is undefined>>
		<<set $orphanageLocked to 0>>
	<</if>>

	<<if $orphanageWindowLocked is undefined>>
		<<set $orphanageWindowLocked to 0>>
	<</if>>

	<<if $farmCottageLocked is undefined>>
		<<set $farmCottageLocked to 0>>
	<</if>>

	<<if $transformationParts.okami is undefined>>
		<<set $transformationParts.okami to {ears:"disabled", tail:"disabled", wings:"disabled", misc:"disabled"}>>
	<</if>>

	<<if $transformationParts.seraphim is undefined>>
		<<set $transformationParts.seraphim to {wings:"disabled", plumage:"disabled", eyes:"disabled"}>>
	<</if>>

	<<if $transformationParts.kitsune is undefined>>
		<<set $transformationParts.kitsune to {ears:"disabled", tail:"disabled", cheeks:"disabled", misc:"disabled"}>>
	<</if>>

	<<if $produce_yield_factor is undefined>>
		<<set $produce_yield_factor to 100>>
	<</if>>

	<<if $beastGroupFight is undefined>>
		<<set $beastGroupFight to 0>>
	<</if>>

	<<if $beastMultiOrgasmToggle is undefined>>
		<<set $beastMultiOrgasmToggle to 0>>
	<</if>>

	<<if $furniture>>
		<<if $furniture.bedroom.chair is undefined>>
			<<set $furniture.bedroom.chair to {id: "chair"}>>
		<</if>>
	<</if>>

	<<if $combatExtended.footwork is undefined>>
		<<set $combatExtended.footwork to 0>>
	<</if>>

	<<if $combatExtended.striking is undefined>>
		<<set $combatExtended.striking to 0>>
	<</if>>

	<<if $combatExtended.kicking is undefined>>
		<<set $combatExtended.kicking to 0>>
	<</if>>

	<<if $combatExtended.footworkToggle is undefined>>
		<<set $combatExtended.footworkToggle to 0>>
	<</if>>

	<<if $combatExtended.strikingToggle is undefined>>
		<<set $combatExtended.strikingToggle to 0>>
	<</if>>

	<<if $combatExtended.kickingToggle is undefined>>
		<<set $combatExtended.kickingToggle to 0>>
	<</if>>

	<<if $combatExtended.enemyMartialArts is undefined>>
		<<set $combatExtended.enemyMartialArts to 0>>
	<</if>>

	<<if $combatExtended.enemyMartialArtsScaling is undefined>>
		<<set $combatExtended.enemyMartialArtsScaling to "random">>
	<</if>>

	<<if $combatExtended.enemyMartialArtsBadass is undefined>>
		<<set $combatExtended.enemyMartialArtsBadass to 0>>
	<</if>>

	<<if $combatExtended.enemyMartialArtsLevelScalingMult is undefined>>
		<<set $combatExtended.enemyMartialArtsLevelScalingMult to 50>>
	<</if>>

	<<if $combatExtended.enemyBaseDodgeChance is undefined>>
		<<set $combatExtended.enemyBaseDodgeChance to 1>>
	<</if>>

	<<if $combatExtended.enemyBaseDodgeChanceMult is undefined>>
		<<set $combatExtended.enemyBaseDodgeChanceMult to 2>>
	<</if>>

	<<if Object.keys($feats.allSaves).count("Ten in a Row") gte 1>>
		<<set $feats.allSaves["Nine in a Row"] to $feats.allSaves["Ten in a Row"]>>
		<<set $feats.allSaves["Seven in a Row"] to $feats.allSaves["Ten in a Row"]>>
	<</if>>

	<<if $mathsTraitBuffs.aphrodisiacPhials is undefined>>
		<<set $mathsTraitBuffs.aphrodisiacPhials to 0>>
	<</if>>

	<<if $DoLPTFTempTolerance is undefined>>
		<<set $DoLPTFTempTolerance to 0>>
	<</if>>

	<<if $uncomfortable.underwearPublic is undefined>>
		<<set $uncomfortable.underwearPublic to true>>
	<</if>>

	<<if $uncomfortable.nudePublic is undefined>>
		<<set $uncomfortable.nudePublic to true>>
	<</if>>

	<<if $furniture isnot undefined>>
		<<if $furniture.cottage is undefined>>
			<<set $furniture.cottage = {}>>
		<</if>>

		<<if $furniture.cottage.bed is undefined>>
			<<set $furniture.cottage.bed = { id: "singlebed"}>>
		<</if>>

		<<if $furniture.cottage.wardrobe is undefined>>
			<<set $furniture.cottage.wardrobe = { id: "organiser"}>>
		<</if>>

		<<if $furniture.cottage.desk is undefined>>
			<<set $furniture.cottage.desk = { id: "desk"}>>
		<</if>>

		<<if $furniture.cottage.chair is undefined>>
			<<set $furniture.cottage.chair = { id: "chair"}>>
		<</if>>
	<</if>>

	<<if $furnitureShopTarget is undefined>>
		<<set $furnitureShopTarget = "bedroom">>
	<</if>>

	<<if $furnitureMovePrice isnot undefined>>
		<<unset $furnitureMovePrice>>
	<</if>>

	<<if $foodstuff.ghost_orchid.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.ghost_orchid isnot undefined and $stall_stats.ghost_orchid.sold.amount gte 1)>>
		<<earnFeat "Phantom Bloom">>
	<</if>>
	<<if $foodstuff.hen_of_the_woods.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.hen_of_the_woods isnot undefined and $stall_stats.hen_of_the_woods.sold.amount gte 1)>>
		<<earnFeat "Whispering Fungi">>
	<</if>>
	<<if $foodstuff.red_helleborine.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.red_helleborine isnot undefined and $stall_stats.red_helleborine.sold.amount gte 1)>>
		<<earnFeat "Crimson Veil">>
	<</if>>
	<<if $foodstuff.lady_orchid.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.lady_orchid isnot undefined and $stall_stats.lady_orchid.sold.amount gte 1)>>
		<<earnFeat "Noble Harvest">>
	<</if>>
	<<if $foodstuff.fly_agaric.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.fly_agaric isnot undefined and $stall_stats.fly_agaric.sold.amount gte 1)>>
		<<earnFeat "Fabled Cap">>
	<</if>>
	<<if $foodstuff.spiked_rampion.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.spiked_rampion isnot undefined and $stall_stats.spiked_rampion.sold.amount gte 1)>>
		<<earnFeat "Thorned Crown">>
	<</if>>
	<<if $foodstuff.cloudberry.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.cloudberry isnot undefined and $stall_stats.cloudberry.sold.amount gte 1)>>
		<<earnFeat "Amber Harvest">>
	<</if>>
	<<if $foodstuff.scottish_bog_myrtle.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.scottish_bog_myrtle isnot undefined and $stall_stats.scottish_bog_myrtle.sold.amount gte 1)>>
		<<earnFeat "Scent of the Highlands">>
	<</if>>
	<<if $foodstuff.bog_orchid.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.bog_orchid isnot undefined and $stall_stats.bog_orchid.sold.amount gte 1)>>
		<<earnFeat "Bog Whisperer">>
	<</if>>
	<<if $foodstuff.marsh_saxifrage.amount gte 1 or ($stall_stats isnot undefined and $stall_stats.marsh_saxifrage isnot undefined and $stall_stats.marsh_saxifrage.sold.amount gte 1)>>
		<<earnFeat "Marshlight">>
	<</if>>
	/* fly_agaric plural is now static setup.foodstuff metadata. */

	<<if $specialTransform is 1 and ($angel is 0 and $fallenangel is 0 and $demon is 0)>>
		<<set $specialTransform to 0>>
	<</if>>
	
	<<if $specialClothesEffects isnot undefined and $specialClothesEffects.bimbo.progress is undefined>>
		<<set $specialClothesEffects to {
			bimbo: { progress: $specialClothesEffects.bimbo, total: $specialClothesEffects.bimboTotal, message: $specialClothesEffects.bimboMessage },
			pimp: { progress: 0, total: 0, message: 0 }
		}>>
	<</if>>

	<<if $options.showUiBar is undefined>>
		<<set $options.showUiBar to true>>
	<</if>>

	<<if $bedroomUI is undefined>>
		<<set $bedroomUI to {
			orphanage: {
				radio: true,
				console: true,
				lock: true,
				project: true,
				homeStudy: true,
				christmas: true,
				largeBearPlushie: true,
				masturbation: true,
				lts: true,
				sexMachine: true,
				parasiteContainer: true
			},
			cottage: {
				radio: true,
				console: true,
				lock: true,
				project: true,
				homeStudy: true,
				largeBearPlushie: true,
				masturbation: true,
				lts: true,
				sexMachine: true,
			},
		}>>
	<</if>>

	/* Back-compat: ensure the console UI flag exists on saves made before it was added. */
	<<if $bedroomUI isnot undefined and $bedroomUI.orphanage isnot undefined and $bedroomUI.orphanage.console is undefined>>
		<<set $bedroomUI.orphanage.console to true>>
	<</if>>
	<<if $bedroomUI isnot undefined and $bedroomUI.cottage isnot undefined and $bedroomUI.cottage.console is undefined>>
		<<set $bedroomUI.cottage.console to true>>
	<</if>>

	<<if $featsBoosts is undefined>>
		<<set $featsBoosts to {}>>
	<</if>>

	<<if $featsBoosts.upgrades is undefined>>
		<<set $featsBoosts.upgrades to {}>>
	<</if>>

	<<if $featsBoosts.upgrades.transcend is undefined>>
		<<set $featsBoosts.upgrades.transcend to 0>>
	<</if>>

	<<if $featsBoosts.upgrades.adaptiveGenes is undefined>>
		<<set $featsBoosts.upgrades.adaptiveGenes to 0>>
	<</if>>

	<<if $options.thermometerDisplay is undefined>>
		<<set $options.thermometerDisplay to "">>
	<</if>>

	<<if $options.nnpcDisplay is undefined>>
		<<set $options.nnpcDisplay to 0>>
	<</if>>

	<<if $options.nnpcDisplayLayer is undefined>>
		<<set $options.nnpcDisplayLayer to "front">>
	<</if>>

	<<if $options.nnpcDisplaySlot is undefined>>
		<<set $options.nnpcDisplaySlot to 1>>
	<</if>>

	<<if $combat is 1 and $enemytype is "tentacles">>
		<<for _i to 0; _i lt $tentacles.max; _i++>>
			<<if $tentacles[_i] isnot undefined and (Number.isNaN($tentacles[_i].tentaclehealth))>>
				<<set $tentacles[_i].tentaclehealth to $tentacles[_i].tentaclehealthstart>>
			<</if>>
		<</for>>
	<</if>>

	<<if $tentacleHealthMult is undefined>>
		<<set $tentacleHealthMult to 100>>
	<</if>>

	<<if $struggleHealthMult is undefined>>
		<<set $struggleHealthMult to 100>>
	<</if>>

	<<if $options.lowerHalo is undefined>>
		<<set $options.lowerHalo to true>>
	<</if>>

	<<if $options.autoNNPCDisplay is undefined>>
		<<set $options.autoNNPCDisplay to {
			enabled: true
		}>>
	<</if>>

	/* Repair a bad key created by older settingsExitFunction code. */
	<<if $options.autoNNPCDisplay["night monster"] isnot undefined>>
		<<if $options.autoNNPCDisplay.night_monster is undefined>>
			<<set $options.autoNNPCDisplay.night_monster to clone($options.autoNNPCDisplay["night monster"])>>
		<<else>>
			<<run Object.entries(V.options.autoNNPCDisplay["night monster"]).forEach(([key, value]) => {
				if (V.options.autoNNPCDisplay.night_monster[key] === undefined) {
					V.options.autoNNPCDisplay.night_monster[key] = value;
				}
			})>>
		<</if>>
		<<run delete V.options.autoNNPCDisplay["night monster"]>>
	<</if>>

	/* DoLP NNPC display data belongs here, not in settingsExitFunction.
	   Build keys consistently so multi-word NNPCs use underscores, e.g. Black Wolf -> black_wolf and Night Monster -> night_monster. */
	<<for _name range setup.NPCNameList>>
		<<set _nameReal to _name>>
		<<set _nnpcKey to _name.toLowerCase().split(" ").join("_")>>

		<<if $options.autoNNPCDisplay[_nnpcKey] is undefined>>
			<<set $options.autoNNPCDisplay[_nnpcKey] to {
				slot: 1,
				layer: "front"
			}>>
		<</if>>

		<<if $options.autoNNPCDisplay[_nnpcKey].genderOverride is undefined>>
			<<set $options.autoNNPCDisplay[_nnpcKey].genderOverride to false>>
		<</if>>

		<<if $options.autoNNPCDisplay[_nnpcKey].gender is undefined or $options.autoNNPCDisplay[_nnpcKey].gender is "">>
			<<if C.npc[_nameReal] and C.npc[_nameReal].pronoun is "m">>
				<<set $options.autoNNPCDisplay[_nnpcKey].gender to "male">>
			<<else>>
				<<set $options.autoNNPCDisplay[_nnpcKey].gender to "female">>
			<</if>>
		<</if>>
	<</for>>

	<<if $options.autoNNPCDisplay.others is undefined>>
		<<set $options.autoNNPCDisplay.others to {
			genderOverride: false,
			gender: ""
		}>>
	<</if>>

	<<if $options.nnpcDisplayGender is undefined>>
		<<set $options.nnpcDisplayGender to "male">>
	<</if>>

	<<if $options.nnpcDisplaySkin is undefined>>
		<<set $options.nnpcDisplaySkin to "pale">>
	<</if>>

	<<if $nnpcHealthMult is undefined>>
		<<set $nnpcHealthMult to 100>>
	<</if>>
	<<if $nnpcArousalMult is undefined>>
		<<set $nnpcArousalMult to 100>>
	<</if>>

	<<if $school_desk_dolp is undefined>>
		<<set $school_desk_dolp to -1>>
	<</if>>

	<<if $book_rent_timer > 0>>
		<<unset $bookOverdue>>
	<</if>>

	<<if $combat is 1 and $combatExtended.stabilityLost is 1>>
		<<reversenpcidlegenitals>>
	<</if>>

	<<if $releaseBoobs isnot undefined>>
		<<unset $releaseBoobs>>
	<</if>>

	<<if $options.bigCanvas is undefined>>
		<<set $options.bigCanvas to false>>
	<</if>>

	<<if $pubfameMoney is undefined>>
		<<set $pubfameMoney to 0>>
	<</if>>

	<<if $options.statNerf is undefined>>
		<<set $options.statNerf to 100>>
	<</if>>

	<<if $options.bodySizeScaling is undefined>>
		<<set $options.bodySizeScaling to false>>
	<</if>>

	/* Poppy LI data migration. Use the save's NPC index rather than the static alias index. */
	<<if $objectVersion.poppyLIData is undefined or $objectVersion.poppyLIData lt 2>>
		<<if $daily is undefined or $daily is null or typeof $daily isnot "object" or Array.isArray($daily)>><<set $daily to {}>><</if>>
		<<if $daily.poppy is undefined or $daily.poppy is null or typeof $daily.poppy isnot "object" or Array.isArray($daily.poppy)>><<set $daily.poppy to {}>><</if>>
		<<if !Array.isArray($poppySeen)>>
			<<if $poppySeen isnot undefined>><<set $poppySeen_legacy to $poppySeen>><</if>>
			<<set $poppySeen to []>>
		<</if>>
		<<set _poppyIndex to (Array.isArray($NPCNameList) ? $NPCNameList.indexOf("Poppy") : -1)>>
		<<if _poppyIndex gte 0 and $NPCName[_poppyIndex]>>
			<<set _poppy to $NPCName[_poppyIndex]>>
			<<if _poppy.timer is undefined or _poppy.timer is null or typeof _poppy.timer isnot "object" or Array.isArray(_poppy.timer)>><<set _poppy.timer to {}>><</if>>
			<<if _poppy.timer.lastInteraction is undefined or _poppy.timer.lastInteraction is "">><<set _poppy.timer.lastInteraction to Time.date.timeStamp>><</if>>
			<<if _poppy.timer.lastPatienceDecay is undefined or _poppy.timer.lastPatienceDecay is "">><<set _poppy.timer.lastPatienceDecay to Time.date.timeStamp>><</if>>
			<<if typeof _poppy.patience isnot "number" or Number.isNaN(_poppy.patience)>><<set _poppy.patience to 100>><</if>>
			<<if _poppy.pregnancy is undefined or _poppy.pregnancy is null or typeof _poppy.pregnancy isnot "object" or Array.isArray(_poppy.pregnancy)>>
				<<set _poppy.pregnancy to { fetus: [], enabled: true, type: null }>>
			<<else>>
				<<if !Array.isArray(_poppy.pregnancy.fetus)>><<set _poppy.pregnancy.fetus to []>><</if>>
				<<if typeof _poppy.pregnancy.enabled isnot "boolean">><<set _poppy.pregnancy.enabled to true>><</if>>
				<<if _poppy.pregnancy.type is "none" or _poppy.pregnancy.type is undefined>><<set _poppy.pregnancy.type to null>>
				<<elseif _poppy.pregnancy.type and !_poppy.pregnancy.fetus.length and !_poppy.pregnancy.timerEnd>><<set _poppy.pregnancy.type to null>><</if>>
			<</if>>
			<<set $objectVersion.poppyPregnancy to 1>>
			<<set $objectVersion.poppyLIData to 2>>
		<</if>>
	<</if>>

	/* One-time heal for saves corrupted by the old migration that forced Poppy's pregnancy.type to "human".
	   Runs regardless of the gates above, since corrupted saves already have poppyLIData set to 2. */
	<<if $objectVersion.poppyPhantomPregnancyFix is undefined>>
		<<set _poppyFixIndex to (Array.isArray($NPCNameList) ? $NPCNameList.indexOf("Poppy") : -1)>>
		<<if _poppyFixIndex gte 0 and $NPCName[_poppyFixIndex] and $NPCName[_poppyFixIndex].pregnancy and typeof $NPCName[_poppyFixIndex].pregnancy is "object" and !Array.isArray($NPCName[_poppyFixIndex].pregnancy)>>
			<<set _poppyFixPreg to $NPCName[_poppyFixIndex].pregnancy>>
			<<if !Array.isArray(_poppyFixPreg.fetus)>><<set _poppyFixPreg.fetus to []>><</if>>
			<<if _poppyFixPreg.type is "none">><<set _poppyFixPreg.type to null>>
			<<elseif _poppyFixPreg.type and !_poppyFixPreg.fetus.length and !Number.isFinite(Number(_poppyFixPreg.timerEnd))>><<set _poppyFixPreg.type to null>><</if>>
		<</if>>
		<<set $objectVersion.poppyPhantomPregnancyFix to 1>> /* delete later */
	<</if>>

	<<run pruneNPCName()>>

	<<set $robinmoney to Math.round($robinmoney)>>

	<<if $robinDebtOverheard is undefined>>
		<<set $robinDebtOverheard to 0>>
	<</if>>
	<<if $robinGivenTotal is undefined>>
		<<set $robinGivenTotal to 0>>
	<</if>>
	/* Robin's stand economy state; backfills missing keys on every load. */
	<<run ensureRobinStand()>>

	<<if $godClothes is undefined>>
    	<<set $godClothes to 0>>
	<</if>>

	<!-- Avery saved route: ability to grow your own crops in the mansion garden -->
	<<if $avery_mansion and $avery_mansion.crops is undefined>>
		<<set $avery_mansion.crops to 0>>
	<</if>>

	<<if $whitneyFamiliarCollarKnown is undefined>>
		<<set $whitneyFamiliarCollarKnown to 0>>
	<</if>>

	<<if $stat_police is undefined>>
		<<set $stat_police to { community: 0, pillory: 0, prison: 0 }>>
	<</if>>
	<<if $brothelVending is undefined>>
		<<set $brothelVending to { total: 0 }>>
	<</if>>
	<<if $estatePersistent is undefined>>
		<<set $estatePersistent to {
			totalGamesPlayed: 0,
			totalGamesPlayedWithBetting: 0,
			totalRoundsWon: 0,
			totalRoundsLost: 0,
			totalRoundsTied: 0,
			totalBetRoundsWon: 0,
			totalBetRoundsLost: 0,
			totalBetRoundsTied: 0,
			totalCaughtCheating: 0,
			winStreakHighScore: 0
		}>>
	<</if>>

	<<if $estatePersistent.totalGamesPlayed is undefined>><<set $estatePersistent.totalGamesPlayed to 0>><</if>>
	<<if $estatePersistent.totalGamesPlayedWithBetting is undefined>><<set $estatePersistent.totalGamesPlayedWithBetting to 0>><</if>>
	<<if $estatePersistent.totalRoundsWon is undefined>><<set $estatePersistent.totalRoundsWon to 0>><</if>>
	<<if $estatePersistent.totalRoundsLost is undefined>><<set $estatePersistent.totalRoundsLost to 0>><</if>>
	<<if $estatePersistent.totalRoundsTied is undefined>><<set $estatePersistent.totalRoundsTied to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsWon is undefined>><<set $estatePersistent.totalBetRoundsWon to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsLost is undefined>><<set $estatePersistent.totalBetRoundsLost to 0>><</if>>
	<<if $estatePersistent.totalBetRoundsTied is undefined>><<set $estatePersistent.totalBetRoundsTied to 0>><</if>>
	<<if $estatePersistent.totalBetMoneyMade is undefined>><<set $estatePersistent.totalBetMoneyMade to 0>><</if>>
	<<if $estatePersistent.totalBetMoneyLost is undefined>><<set $estatePersistent.totalBetMoneyLost to 0>><</if>>
	<<if $estatePersistent.totalMoneyConfiscated is undefined>><<set $estatePersistent.totalMoneyConfiscated to 0>><</if>>
	<<if $estatePersistent.totalTipMoneyMade is undefined>><<set $estatePersistent.totalTipMoneyMade to 0>><</if>>
	<<if $estatePersistent.totalCaughtCheating is undefined>><<set $estatePersistent.totalCaughtCheating to 0>><</if>>
	<<if $estatePersistent.winStreakHighScore is undefined>><<set $estatePersistent.winStreakHighScore to 0>><</if>>
	<<if $settings.npcColossalPenisChance is undefined>><<set $settings.npcColossalPenisChance to 0>><</if>>

	/* DoLX doesn't have herm */
	<<set $fhermchance to 0>>
	<<set $mhermchance to 0>>

	/* Leftover from the removed mirror broken-vow repair fallback */
	<<if $fallenMirrorRepairNotice isnot undefined>>
		<<unset $fallenMirrorRepairNotice>> /* delete later */
	<</if>>

	<<modNewNamedNPCs>>
	<<modParasiteCapUpdate>>
	<<modWardrobeUpdate>>
	<<amcTraitsUpdate>>
	<<if !$bikeUpdate>>
		<<bikeUpdate>>
	<<elseif $bikeUpdate is 1>>
		<<bikeUpdate2>>
	<</if>>
	<<clamp>>
<</widget>>

<<widget "amcTraitsUpdate">>
	<<if $AMCTraits is undefined or $AMCTraits is null or typeof $AMCTraits isnot "object" or Array.isArray($AMCTraits)>>
		<<set $AMCTraits to {}>>
	<</if>>
	<<if $AMCTraits.halfGain is undefined>>
		<<set $AMCTraits.halfGain to 0>>
	<</if>>
	/* X-Change intentionally uses a beauty trait of 2; DoLX owns $AMCTraits.beauty.
	   Default it here so it is defined on the new-game (Start) path too, since version-update only runs on save load. */
	<<if $AMCTraits.beauty is undefined>>
		<<set $AMCTraits.beauty to 2>>
	<</if>>
	<<if $AMCTraits.physique is undefined>>
		<<set $AMCTraits.physique to 1>>
	<</if>>
	<<if $AMCTraits.willpower is undefined>>
		<<set $AMCTraits.willpower to 1>>
	<</if>>
	<<if $AMCTraits.skulduggery is undefined>>
		<<set $AMCTraits.skulduggery to 1>>
	<</if>>
	<<if $AMCTraits.dancing is undefined>>
		<<set $AMCTraits.dancing to 1>>
	<</if>>
	<<if $AMCTraits.swimming is undefined>>
		<<set $AMCTraits.swimming to 1>>
	<</if>>
	<<if $AMCTraits.athletics is undefined>>
		<<set $AMCTraits.athletics to 1>>
	<</if>>
	<<if $AMCTraits.tending is undefined>>
		<<set $AMCTraits.tending to 1>>
	<</if>>
	<<if $AMCTraits.housekeeping is undefined>>
		<<set $AMCTraits.housekeeping to 1>>
	<</if>>
	<<if $AMCTraits.brawling is undefined>>
		<<set $AMCTraits.brawling to 1>>
	<</if>>
	<<if $AMCTraits.science is undefined>>
		<<set $AMCTraits.science to 1>>
	<</if>>
	<<if $AMCTraits.maths is undefined>>
		<<set $AMCTraits.maths to 1>>
	<</if>>
	<<if $AMCTraits.english is undefined>>
		<<set $AMCTraits.english to 1>>
	<</if>>
	<<if $AMCTraits.history is undefined>>
		<<set $AMCTraits.history to 1>>
	<</if>>
	<<if $AMCTraits.seductionskill is undefined>>
		<<set $AMCTraits.seductionskill to 1>>
	<</if>>
	<<if $AMCTraits.oralskill is undefined>>
		<<set $AMCTraits.oralskill to 1>>
	<</if>>
	<<if $AMCTraits.chestskill is undefined>>
		<<set $AMCTraits.chestskill to 1>>
	<</if>>
	<<if $AMCTraits.handskill is undefined>>
		<<set $AMCTraits.handskill to 1>>
	<</if>>
	<<if $AMCTraits.bottomskill is undefined>>
		<<set $AMCTraits.bottomskill to 1>>
	<</if>>
	<<if $AMCTraits.penileskill is undefined>>
		<<set $AMCTraits.penileskill to 1>>
	<</if>>
	<<if $AMCTraits.vaginalskill is undefined>>
		<<set $AMCTraits.vaginalskill to 1>>
	<</if>>
	<<if $AMCTraits.analskill is undefined>>
		<<set $AMCTraits.analskill to 1>>
	<</if>>
	<<if $AMCTraits.thighskill is undefined>>
		<<set $AMCTraits.thighskill to 1>>
	<</if>>
	<<if $AMCTraits.feetskill is undefined>>
		<<set $AMCTraits.feetskill to 1>>
	<</if>>
	<<if $AMCTraits.milk is undefined>>
		<<set $AMCTraits.milk to 1>>
	<</if>>
	<<if $AMCTraits.semen is undefined>>
		<<set $AMCTraits.semen to 1>>
	<</if>>

	<<set $beautymax to 10000>>
	<<set $willpowermax to 1000>>
	<<set $skulduggerymax to 1000>>
	<<set $dancingmax to 1000>>
	<<set $swimmingmax to 1000>>
	<<set $athleticsmax to 1000>>
	<<set $tendingmax to 1000>>
	<<set $housekeepingmax to 1000>>
	<<set $brawlingmax to 1000>>
	<<set $seductionskillmax to 1000>>
	<<set $oralskillmax to 1000>>
	<<set $chestskillmax to 1000>>
	<<set $handskillmax to 1000>>
	<<set $bottomskillmax to 1000>>
	<<set $penileskillmax to 1000>>
	<<set $vaginalskillmax to 1000>>
	<<set $analskillmax to 1000>>
	<<set $thighskillmax to 1000>>
	<<set $feetskillmax to 1000>>
	<<if $AMCTraits.oral>>
		<<set $AMCTraits.oralskill to $AMCTraits.oral>>
		<<unset $AMCTraits.oral>>
	<</if>>
	<<if $AMCTraits.chest>>
		<<set $AMCTraits.chestskill to $AMCTraits.chest>>
		<<unset $AMCTraits.chest>>
	<</if>>
	<<if $AMCTraits.hands>>
		<<set $AMCTraits.handskill to $AMCTraits.hands>>
		<<unset $AMCTraits.hands>>
	<</if>>
	<<if $AMCTraits.buttocks>>
		<<set $AMCTraits.bottomskill to $AMCTraits.buttocks>>
		<<unset $AMCTraits.buttocks>>
	<</if>>
	<<if $AMCTraits.penile>>
		<<set $AMCTraits.penileskill to $AMCTraits.penile>>
		<<unset $AMCTraits.penile>>
	<</if>>
	<<if $AMCTraits.vaginal>>
		<<set $AMCTraits.vaginalskill to $AMCTraits.vaginal>>
		<<unset $AMCTraits.vaginal>>
	<</if>>
	<<if $AMCTraits.anal>>
		<<set $AMCTraits.analskill to $AMCTraits.anal>>
		<<unset $AMCTraits.anal>>
	<</if>>
	<<if $AMCTraits.thighs>>
		<<set $AMCTraits.thighskill to $AMCTraits.thighs>>
		<<unset $AMCTraits.thighs>>
	<</if>>
	<<if $AMCTraits.feet>>
		<<set $AMCTraits.feetskill to $AMCTraits.feet>>
		<<unset $AMCTraits.feet>>
	<</if>>
	<<if $AMCTraits.seduction>>
		<<set $AMCTraits.seductionskill to $AMCTraits.seduction>>
		<<unset $AMCTraits.seduction>>
	<</if>>

	/* DoLX does not use AMC fame progression; keep these compatibility flags unlocked. */
	<<set _amcFames to ["sexFame","prostitutionFame","rapeFame","bestialityFame","exhibitionismFame","pregnancyFame","impregFame","scrapFame","goodFame","businessFame","socialFame","modelFame"]>>
	<<for _fame range _amcFames>>
		<<if $AMCTraits[_fame] isnot 1>><<set $AMCTraits[_fame] to 1>><</if>>
	<</for>>

	<<if $AMCTraits.footwork is undefined>>
		<<set $AMCTraits.footwork to 1>>
	<</if>>

	<<if $AMCTraits.striking is undefined>>
		<<set $AMCTraits.striking to 1>>
	<</if>>

	<<if $AMCTraits.kicking is undefined>>
		<<set $AMCTraits.kicking to 1>>
	<</if>>

	/* HBSC gala load compatibility. Keep the sudden invitation separate from the guest it delays. */
	<<if $avery_mansion>>
		<<if $avery_mansion.hbsc_gala_seen is undefined>><<set $avery_mansion.hbsc_gala_seen to false>><</if>>
		<<if $avery_mansion.hbsc_gala_cooldown is undefined>><<set $avery_mansion.hbsc_gala_cooldown to 0>><</if>>
		<<if $avery_mansion.hbsc_gala_pending is undefined>><<set $avery_mansion.hbsc_gala_pending to false>><</if>>
		<<if $avery_mansion.guest is "HBSC Gala">>
			<<run const previousGuest = V.avery_mansion.party_guests_seen && V.avery_mansion.party_guests_seen.last();
			const rotation = {
				Bailey: "Quinn",
				Quinn: "Remy",
				Remy: "Briar",
				Briar: "Harper",
				Harper: V.avery_mansion.jordan_intro ? "Jordan" : "Quinn",
				Jordan: "Quinn",
			};
			V.avery_mansion.guest = rotation[previousGuest] || "Quinn";
			if (V.avery_mansion.party_state !== "started" && V.avery_mansion.fox?.task === "HBSC Gala") {
				delete V.avery_mansion.fox.task;
				delete V.avery_mansion.fox.task_complete;
				delete V.avery_mansion.fox.task_detail;
			}
			V.avery_mansion.hbsc_gala_pending = true;>>
		<</if>>
	<</if>>

	<<run if (typeof applyPermanentInsanityTalents === "function") applyPermanentInsanityTalents()>>
<</widget>>

<<widget "modWardrobeUpdate">>
	<<if $wardrobes is undefined>><<set $wardrobes to {}>><</if>>

	<<if $dolpRingsEarringsVersion is undefined or $dolpRingsEarringsVersion lt 1>>
		<<modRingsEarrings>>
		<<set $dolpRingsEarringsVersion to 1>>
	<</if>>

	<<if $passage isnot "Start">>
		<<set _furniture to Furniture.get("wardrobe", "bedroom")>>
		<<if _furniture and _furniture.type and _furniture.type.includes("organiser")>>
			<<set $wardrobe.space to 40 * $wardrobeMult>>
		<<elseif _furniture and _furniture.type and _furniture.type.includes("spacious")>>
			<<set $wardrobe.space to 30 * $wardrobeMult>>
		<<else>>
			<<set $wardrobe.space to 20 * $wardrobeMult>>
		<</if>>
	<</if>>

	<<if $wardrobes.alexFarm is undefined>><<set $wardrobes.alexFarm to {}>><</if>>
	<<if $wardrobes.asylum is undefined>><<set $wardrobes.asylum to {}>><</if>>
	<<if $wardrobes.avery_mansion is undefined>><<set $wardrobes.avery_mansion to {}>><</if>>
	<<if $wardrobes.birdTower is undefined>><<set $wardrobes.birdTower to {}>><</if>>
	<<if $wardrobes.brothel is undefined>><<set $wardrobes.brothel to {}>><</if>>
	<<if $wardrobes.changingRoom is undefined>><<set $wardrobes.changingRoom to {}>><</if>>
	<<if $wardrobes.edensCabin is undefined>><<set $wardrobes.edensCabin to {}>><</if>>
	<<if $wardrobes.officeBuilding is undefined>><<set $wardrobes.officeBuilding to {}>><</if>>
	<<if $wardrobes.pirate is undefined>><<set $wardrobes.pirate to {}>><</if>>
	<<if $wardrobes.prison is undefined>><<set $wardrobes.prison to {}>><</if>>
	<<if $wardrobes.schoolBoys is undefined>><<set $wardrobes.schoolBoys to {}>><</if>>
	<<if $wardrobes.schoolGirls is undefined>><<set $wardrobes.schoolGirls to {}>><</if>>
	<<if $wardrobes.stripClub is undefined>><<set $wardrobes.stripClub to {}>><</if>>
	<<if $wardrobes.temple is undefined>><<set $wardrobes.temple to {}>><</if>>

	<<set $wardrobes.alexFarm.space to 40 * $wardrobeMult>>
	<<set $wardrobes.asylum.space to 5 * $wardrobeMult>>
	<<set $wardrobes.avery_mansion.space to 80 * $wardrobeMult>>
	<<set $wardrobes.birdTower.space to 15 * $wardrobeMult>>
	<<set $wardrobes.brothel.space to 10 * $wardrobeMult>>
	<<set $wardrobes.changingRoom.space to 5 * $wardrobeMult>>
	<<set $wardrobes.edensCabin.space to 10 * $wardrobeMult>>
	<<set $wardrobes.officeBuilding.space to 5 * $wardrobeMult>>
	<<set $wardrobes.pirate.space to 5 * $wardrobeMult>>
	<<set $wardrobes.prison.space to 5 * $wardrobeMult>>
	<<set $wardrobes.schoolBoys.space to 5 * $wardrobeMult>>
	<<set $wardrobes.schoolGirls.space to 5 * $wardrobeMult>>
	<<set $wardrobes.stripClub.space to 10 * $wardrobeMult>>
	<<set $wardrobes.temple.space to 20 * $wardrobeMult>>

	<<if $tryOn is undefined>>
		<<set $tryOn to {}>>
	<</if>>

	<<if $tryOn.tryingOn is undefined>>
		<<set $tryOn.tryingOn to {}>>
	<</if>>

	<<if $tryOn.tryingOn.rings is undefined>>
		<<set $tryOn.tryingOn.rings to null>>
		<<set $tryOn.tryingOn.earrings to null>>
	<</if>>
<</widget>>

<<widget "modParasiteCapUpdate">>
	<<if $container>>
		<<if $container.home.upgrades.capacity is 0>>
			<<set $container.home.maxCount to 1 * $parasiteCapMult>>
		<<elseif $container.home.upgrades.capacity is 1>>
			<<set $container.home.maxCount to 2 * $parasiteCapMult>>
		<<elseif $container.home.upgrades.capacity is 2>>
			<<set $container.home.maxCount to 3 * $parasiteCapMult>>
		<<elseif $container.home.upgrades.capacity is 3>>
			<<set $container.home.maxCount to 4 * $parasiteCapMult>>
		<<elseif $container.home.upgrades.capacity is 4>>
			<<set $container.home.maxCount to 5 * $parasiteCapMult>>
		<</if>>
		<<if $container.farm.upgrades.capacity is 0>>
			<<set $container.farm.maxCount to 5 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 1>>
			<<set $container.farm.maxCount to 7 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 2>>
			<<set $container.farm.maxCount to 9 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 3>>
			<<set $container.farm.maxCount to 11 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 4>>
			<<set $container.farm.maxCount to 14 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 5>>
			<<set $container.farm.maxCount to 17 * $parasiteCapMult>>
		<<elseif $container.farm.upgrades.capacity is 6>>
			<<set $container.farm.maxCount to 20 * $parasiteCapMult>>
		<</if>>
	<</if>>

			<!--DecoMod Stuff -->
	<<if $foreground_image1 is undefined>>
		<<set $foreground_image1 to "none">>
	<</if>>

	<<if $background_image1 is undefined>>
		<<set $background_image1 to "none">>
	<</if>>

	<<if $foreground_image2 is undefined>>
		<<set $foreground_image2 to "none">>
	<</if>>

	<<if $background_image2 is undefined>>
		<<set $background_image2 to "none">>
	<</if>>

<</widget>>

<<widget "modNewNamedNPCs">>
	<<if $dolpNpcListVersion is undefined>>
		<<set _newNNPCs to {"riley": {nam : "Riley", title: "MMA coach", insecurity: "skill", adult: 1}}>>
		<<for _npc range Object.keys(_newNNPCs)>>
			<<if !$NPCNameList.includes(_newNNPCs[_npc].nam)>>
				<<newNamedNpc _newNNPCs[_npc]>>
				<<set _npcsAdded to true>>
			<</if>>
		<</for>>
		<<if _npcsAdded is true>>
			<<generateNPCNameHairAndEyeColors>>
		<</if>>
		<<set $dolpNpcListVersion to 1>>
	<</if>>
	<<set _rileyIndex to $NPCNameList.indexOf("Riley")>>
	<<if _rileyIndex gte 0>>
		<<if $NPCName[_rileyIndex].description is "Riley" and $NPCName[_rileyIndex].title is undefined>>
			<<set $NPCName[_rileyIndex].title to "MMA coach">>
			<<set $NPCName[_rileyIndex].insecurity to "skill">>
		<</if>>
	<</if>>
<</widget>>

<<widget "modRingsEarrings">>
	<<if $wear_earrings is undefined>>
		<<set $worn.earrings to clone(setup.clothes.earrings[0])>>
		<<set $carried.earrings to clone(setup.clothes.earrings[0])>>
		<<set $wardrobe.earrings to []>>
		<<set $store.earrings to []>>
		<<set $wear_earrings to "none">>
		<<set $ears_pierced to 0>>
	<</if>>

	<<if $wear_rings is undefined>>
		<<set $worn.rings to clone(setup.clothes.rings[0])>>
		<<set $carried.rings to clone(setup.clothes.rings[0])>>
		<<set $wardrobe.rings to []>>
		<<set $store.rings to []>>
		<<set $wear_rings to "none">>
	<</if>>

	<<for $_i to 0; $_i lt $outfit.length; $_i++>>
		<<if $outfit[$_i].earrings is undefined>>
			<<set $outfit[$_i].earrings to "naked">>
		<</if>>
		<<if $outfit[$_i].rings is undefined>>
			<<set $outfit[$_i].rings to "naked">>
		<</if>>
		<<if $outfit[$_i].colors and !$outfit[$_i].colors.earrings>>
			<<set $outfit[$_i].colors.earrings to [0, 0]>>
		<</if>>
		<<if $outfit[$_i].colors and !$outfit[$_i].colors.rings>>
			<<set $outfit[$_i].colors.rings to [0, 0]>>
		<</if>>
	<</for>>

	<<script>>
		if (V.wardrobes && typeof V.wardrobes === "object") {
			for (const i of Object.keys(V.wardrobes)) {
				if (i === "shopReturn" || i === "wardrobe") continue;
				if (!V.wardrobes[i] || typeof V.wardrobes[i] !== "object") continue;
				if (V.wardrobes[i].earrings === undefined) 	{V.wardrobes[i].earrings = [];}
				if (V.wardrobes[i].rings 	=== undefined)	{V.wardrobes[i].rings = [];}
			}
		}
	<</script>>

	/* Directly unlock antique special clothes if museum is complete */
	<<if $museumAntiques isnot undefined and $museumAntiques.museumCount is $museumAntiques.maxCount>>
		<<for _sc range $specialClothes>>
			<<if (_sc.name.includes("antique") or _sc.name.includes("ancient")) and _sc.unlocked lt 3>>
				<<set _sc.unlocked to 3>>
			<</if>>
		<</for>>
	<</if>>

	/* Persist unlocked sets to localStorage so feat boosters reflect them */
	<<if $feats isnot undefined and $feats.allSaves isnot undefined>>
		<<updateFeats>>
	<</if>>

	/* Jewellery worn-slots repair */
	<<script>>window.dolxRepairMissingJewelleryWornSlots?.();<</script>>
<</widget>>

/* Guarantee every transformation-trait key exists.
Reads across the game test `X isnot "disabled"` (and `!["disabled","hidden"].includes(X)`), which treat a MISSING key as active
so an undefined key shows phantom traits (Dragon Eyes, Predatory Animal...) and triggers their effects (e.g. the dragonEyes always-hallucinate check).
Trait keys are added to the schema over time, and the backfills for them live in the version-gated <<modupdate>>,
so a same-version save that predates a key never gets it.

This runs every load (via xchange-modupdate) to fill only the missing keys with TF-appropriate defaults, leaving any value the player already set untouched. */
<<widget "ensureTransformationTraits">>
	<<if $transformationParts is undefined>><<setupTransformationPiecesObject>><</if>>
	<<if $transformationParts.traits is undefined>><<set $transformationParts.traits to {}>><</if>>
	<<set _traits to $transformationParts.traits>>
	<<if _traits.fangs is undefined>><<set _traits.fangs to (($wolfgirl gte 2 or $cat gte 2 or $fox gte 2) ? "default" : "disabled")>><</if>>
	<<if _traits.sharpEyes is undefined>><<set _traits.sharpEyes to (($cat gte 2 or $harpy gte 2 or $fox gte 2 or $waterdragon gte 2) ? "default" : "disabled")>><</if>>
	<<if _traits.dragonEyes is undefined>><<set _traits.dragonEyes to (($waterdragon gte 2 or $waterdragontf is 1 or $waterdragonCosmeticUnlocked is 1) ? "default" : "disabled")>><</if>>
	<<if _traits.mateForLife is undefined>><<set _traits.mateForLife to (($fox gte 3 or $harpy gte 3) ? "default" : "disabled")>><</if>>
	<<if _traits.chase is undefined>><<set _traits.chase to "disabled">><</if>>
	<<if _traits.flaunting is undefined>><<set _traits.flaunting to "disabled">><</if>>
	<<if _traits.ironWill is undefined>><<set _traits.ironWill to (effectiveTransformationLevel("fallen") gte 4 ? "default" : "disabled")>><</if>>
	<<if _traits.strongFeet is undefined>><<set _traits.strongFeet to ($bunny gte 2 ? "default" : "disabled")>><</if>>
	<<if _traits.tempTolerance is undefined>><<set _traits.tempTolerance to "disabled">><</if>>
	<<if _traits.aquatic is undefined>><<set _traits.aquatic to (($waterdragon gte 7 or $waterdragontf is 1) ? "default" : "disabled")>><</if>>
	<<if _traits.leviathan is undefined>><<set _traits.leviathan to "disabled">><</if>>
	/* Part keys share the flaw: isPartEnabled(undefined) is true, so a missing key renders undefined.png layers. */
	<<script>>window.dolxEnsureTransformationParts?.();<</script>>
	/* predatoryAnimal/preyAnimal are derived from current TF levels, never authored recompute them. */
	<<recomputePredatorPrey>>
<</widget>>

<<widget "bikeUpdate">>
	<<set $bicycle to {}>>
	<<set $bicycle.quality to ($bike || 0)>>
	/* Only saves that actually had a bike own one after migration. */
	<<set $bicycle.own to $bike gte 1>>
	<<if $location is "town" || $location is "plains" || $location is "forest" || $location is "industrial">>
		<<set $bicycle.location to $sublocation>>
	<<else>>
		<<set $bicycle.location to $location>>
	<</if>>
	/* Only real parking spots are valid; a save migrated anywhere else has the bike waiting at home.
	Region must be set here too: the hourly theft check reads it before the first <<bike>> render, and an unknown region counts as maximum risk. */
	<<if !["domus", "barb", "danube", "wolf", "connudatus", "cliff", "high", "starfish", "oxford", "nightingale", "mer", "elk", "harvest", "lake", "alex_farm"].includes($bicycle.location)>>
		<<set $bicycle.location to "domus">>
	<</if>>
	<<bikeSetRegion>>
	<<set $bicycle.durability to {
		current: 0,
		max: 0
	}>>
	<<switch $bicycle.quality>>
		<<case 1>>
			<<set $bicycle.durability.max to 800>>
		<<case 2>>
			<<set $bicycle.durability.max to 2400>>
		<<case 3>>
			<<set $bicycle.durability.max to 4800>>
		<<default>>
			<<set $bicycle.durability.max to 0>>
	<</switch>>
	<<if $bikeBroken isnot undefined>>
		<<set $bicycle.durability.current to 0>>
	<<else>>
		<<set $bicycle.durability.current to Math.clamp($bikeDurability || 0, 0, $bicycle.durability.max)>>
	<</if>>
	/* DoLX has no off-road upgrade shop; the field stays as an empty array for compatibility. */
	<<set $bicycle.upgrades to []>>
	<<switch $bikeSecurityGear>>
		<<case 5>>
			<<set $bicycle.security to 0.99>>
		<<case 4>>
			<<set $bicycle.security to 0.8>>
		<<case 3>>
			<<set $bicycle.security to 0.5>>
		<<case 2>>
			<<set $bicycle.security to 0.3>>
		<<case 1>>
			<<set $bicycle.security to 0.1>>
		<<default>>
			<<set $bicycle.security to 0>>
	<</switch>>
	<<if !$bikeStolen>>
		<<set $bicycle.stolen to false>>
		<<set $bicycle.securityStolen to false>>
	<<else>>
		<<set $bicycle.stolen to true>>
		<<set $bicycle.own to false>>
		<<set $bicycle.securityStolen to true>>
		<<set $bicycle.upgrades to []>>
	<</if>>
	<<if $bikeSecurityGearStolen isnot undefined>>
		<<set $bicycle.securityStolen to true>>
		<<set $bicycle.security to 0>>
	<</if>>
	/* Treat missing legacy toggles as off: saves that never touched the old bike system get the safe defaults. */
	<<if $bikePersistentLocation is 1>>
		<<set $bicycle.persistentLocation to true>>
	<<else>>
		<<set $bicycle.persistentLocation to false>>
	<</if>>
	<<if $bikeSecurity is 1>>
		<<set $bicycle.theftEnabled to true>>
	<<else>>
		<<set $bicycle.theftEnabled to false>>
	<</if>>
	<<set $bicycle.travel to {}>>
	<<set $bicycle.roughTerrain to 0>>
	<<set $bicycle.gains to {}>>
	/* Passages the broken-bike walk can strand you at; only the town districts are used. */
	<<set $bicycle.destinations to {
		Residential: ["Barb Street", "Domus Street", "Danube Street", "Wolf Street"],
		Commercial: ["High Street", "Connudatus Street", "Cliff Street", "Nightingale Street", "Oxford Street", "Starfish Street"],
		Industrial: ["Elk Street", "Harvest Street", "Mer Street"],
	}>>

	<<unset $bikeBrakes, $bikeGrips, $bikePedals, $bikeSuspension, $bikeTires, $bikeTubeless, $bikeSecurityGear, $bikeSecurityGearStolen, $bikeDestination, $bikeEndCategory, $bikeStartCategory, $bike>>

	/* increment this whenever you need to i guess */
	<<set $bikeUpdate to 2>>
<</widget>>

<<widget "bikeUpdate2">>
	/* One-time fixup for saves migrated by the first bikeUpdate pass:
	rescale durability to the DoLX 800/2400/4800 balance and clear phantom ownership on bikeless saves. */
	<<if $bicycle is undefined>>
		<<bikeUpdate>>
	<<else>>
		<<if $bicycle.quality lte 0 or $bicycle.quality is undefined>>
			<<set $bicycle.own to false>>
			<<set $bicycle.quality to 0>>
		<</if>>
		/* First pass could park the bike at a non-parking spot and left the theft region unset (unknown region = maximum theft risk). */
		<<if !["domus", "barb", "danube", "wolf", "connudatus", "cliff", "high", "starfish", "oxford", "nightingale", "mer", "elk", "harvest", "lake", "alex_farm"].includes($bicycle.location)>>
			<<set $bicycle.location to "domus">>
		<</if>>
		<<bikeSetRegion>>
		<<switch $bicycle.quality>>
			<<case 1>><<set _bikeMax to 800>>
			<<case 2>><<set _bikeMax to 2400>>
			<<case 3>><<set _bikeMax to 4800>>
			<<default>><<set _bikeMax to 0>>
		<</switch>>
		<<if $bicycle.durability is undefined>>
			<<set $bicycle.durability to { current: 0, max: 0 }>>
		<</if>>
		/* The first-pass depot repair could corrupt durability into NaN; the player paid for those repairs, so restore a full bar. */
		<<if !Number.isFinite($bicycle.durability.current)>>
			<<set $bicycle.durability.current to _bikeMax>>
			<<set $bicycle.durability.max to _bikeMax>>
		<<elseif $bicycle.durability.max isnot _bikeMax>>
			<<set $bicycle.durability.current to Math.round(_bikeMax * ($bicycle.durability.max gt 0 ? Math.clamp($bicycle.durability.current / $bicycle.durability.max, 0, 1) : 0))>>
			<<set $bicycle.durability.max to _bikeMax>>
		<</if>>
		<<set $bikeUpdate to 2>>
	<</if>>
<</widget>>
