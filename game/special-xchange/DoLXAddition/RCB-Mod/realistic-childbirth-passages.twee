:: Childbirth

/* Safety gate: validate $birth and migrate old versions before running the birth.
   Heavy logic lives in realistic-childbirth-init.js (setup.rcbBirthSafetyCheck). */
<<set _rcb to setup.rcbBirthSafetyCheck()>>
<<if _rcb.action is "eject">>
	/* $birth was missing or from an unsupported version, so the birth minigame can't run safely.
	Wind the encounter down through the normal end routing for the deduced location instead of leaving the player soft-locked. */
	<<goto "Childbirth End">>
<<else>>

<<if $childbirthstart is 1 or $birth.filters is undefined or setup.birthPrompts is undefined or setup.birthDialog is undefined>>
	<<set _birthRebuildRuntime to ($childbirthstart is 1 or $birth.filters is undefined or setup.birthDialog is undefined)>>
	<!-- setup caches are not saved, so rebuilding them must not rewind an in-progress birth. -->
	<<if $childbirthstart is 1 or $birth.filters is undefined>>
	<<set $birth["version"] to setup.RCB_BIRTH_VERSION>>
	<<if $waterDragonBirthContext>>
		<<set $birth["fetuscount"] to $waterDragonBirthContext.count>>
		<<set $birth["father"] to $waterDragonBirthContext.fertilised ? "unknown" : "none">>
		<<set $birth["type"] to "hawk">>
		/* The caller already worked out which hole the clutch is coming from (an omega carries in the anus even with a vagina present). Only guess when it didn't say. */
		<<if !["vagina", "anus"].includes($birth.genital)>>
			<<if $player.vaginaExist>><<set $birth.genital to "vagina">><<else>><<set $birth.genital to "anus">><</if>>
		<</if>>
	<<elseif playerIsPregnant()>>
		<<set [_pregnancy,$birth.genital] to getPlayerPregnancyForBirth(true)>>
		<<if childBaseSpecies(_pregnancy.donorSpecies) is "hawk">>
			<<set $birth["fetuscount"] to getChildrenOf(_pregnancy.pregnancyId).length>>
			<<set $birth["father"] to "Great Hawk">>
			<<set $birth["type"] to "hawk">>
		<<else>>
			<<set $birth["fetuscount"] to getChildrenOf(_pregnancy.pregnancyId).length>>
			<<set $birth["father"] to _pregnancy.donor>>
			<<set $birth["type"] to childBaseSpecies(_pregnancy.donorSpecies)>>
		<</if>>
	<<else>>
		<<set $birth["fetuscount"] to $harpyEggs.count>>
		<<set $birth["father"] to "none">>
		<<set $birth["type"] to "hawk">>
		<<if $player.vaginaExist>>
			<<set $birth.genital to "vagina">>
		<<else>>
			<<set $birth.genital to "anus">>
		<</if>>
	<</if>>
	<<set $combat to 1>>
	<<set $birth["filters"] to {"dynamic":{},"static":{},"partner":{}}>>
	<<set _tagsToUpdate to []>>
	<<set $enemytype to "childbirth">>
	<<if $birth.stage is undefined>>
		<<set $birth["stage"] to 1>>
	<</if>>
	<<set $birth["stagechange"] to 1>>
	<<set $birth["progressrng"] to 1>>
	<<set $birth["stageprogress"] to 0>>
	<<set $birth["pace"] to 0>>
	<<set $birth["pushurge"] to 0>>
	<<set $birth["waveCeiling"] to 25>>
	<<set $birth["waveCount"] to 0>>
	<<set $birth["totalWaveCount"] to 0>>
	<<set $birth["stageWaveCount"] to 0>>
	<<set $birth["fetusmovement"] to 0>>
	<<set $birth["contractions"] to 0>>
	<<set $birth["delivered"] to 0>>
	<<if $childbirthstart is 1>>
		<!-- Early labour hurts and rattles the nerves, but it shouldn't wipe out a rested player on turn one. Raise pain to a floor and add to fatigue/stress instead of overwriting them. -->
		<<set $pain to Math.min(Number($painmax) || 200, Math.max(Number($pain) || 0, 100))>>
		<<set $tiredness to Math.min(Number($tirednessmax) || 2000, (Number($tiredness) || 0) + 500)>>
		<<set $stress to Math.min(Number($stressmax) || 10000, (Number($stress) || 0) + 1200)>>
		<span class="red">The first proper contraction catches you off guard, squeezing across your belly and into your back. It passes, but the ache it leaves behind tells you this is the real thing.</span><<gggpain>><<ggstress>><<gtiredness>><br><br>
	<</if>>
	<<set $birth.movementodds to [[60,75,90,94,96,99,200,200],[50,70,85,90,93,96,200,200],[40,60,80,85,90,95,200,200],[30,40,50,70,80,90,200,200],[30,40,50,70,80,90,200,200],[30,40,50,70,80,90,200,200],[20,35,50,65,75,85,200,200],[0,0,0,0,0,0,200,200],[1,1,1,1,1,1,200,200],[1,1,1,1,1,1,200,200]]>>
	<<if $birth.inlobby is undefined>>
		<<switch $birth.location>>
		<<case "asylum" "wolf cave" "forest shop" "bedroom" "tower" "waterdragon_nest" "waterdragon_lab">>
			<<set $birth["inlobby"] to "">>
		<<case "hospital">>
			<<if ["Alex","Avery","Eden","Robin","Sydney","Whitney","Kylar","Poppy"].includes($birth.father) and knowsAboutPregnancy("pc", $birth.father)>>
				<<set $birth["inlobby"] to $birth.father>>
			<<else>>
				<<set $birth["inlobby"] to "">>
			<</if>>
		<<case "cottage">>
			<<set $birth["inlobby"] to "Alex">>
		<<case "prison">>
			<<if $birth.father is "Kylar" and $prison.kylar is "active">>
				<<set $birth["inlobby"] to "Kylar">>
			<<else>>
				<<set $birth["inlobby"] to "">>
			<</if>>
		<</switch>>
	<</if>>
	<<if $birth.partner is undefined>>
		<<set $birth["partner"] to "Alone">>
	<</if>>
	<<if $birth.calledPartner is undefined>>
		<<set $birth["calledPartner"] to 0>>
	<</if>>
	<<if $birth.epidural is undefined>>
		<<set $birth["epidural"] to 0>>
	<</if>>
	<<if $birth.type is "hawk">>
		<<set $position to "doggy">>
	<<else>>
		<<set $position to "missionary">>
		<<set $thighuse to "penis">>
		<<set $worn.lower.vagina_exposed to $worn.lower.anus_exposed>>
	<</if>>
	<</if>>
	<!--modloader commented out-->
	<!--modloader dummy dialog/prompts left disabled. Static childbirth text now lives in setup, not $birth.-->
	<!--Release note: setup.birthDialog and setup.birthPrompts are cached on setup. After changing childbirth prompt or dialog content, refresh the browser before continuing an in-progress birth.-->
	<<if setup.birthDialog is undefined or _birthRebuildRuntime>>
	<<run setup.birthDialog = {"randomFull":[
