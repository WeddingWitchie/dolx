[[{"Location":"cottage","Partner":"Alex","Speech":"Bratty"},{},{},{"AlexWantsKids":1}],[["Harper starts to talk, \"It's recommended to wait-\" before you cut <<nnpc_him \"Harper\">> off in an unusual fit of rage, \"Hey, 'Partner'? How about you quiet down and focus on this one first?\""],["default"]],{},1,0],
[[{"Location":"cottage","Partner":"Alex","Speech":"Meek"},{},{},{"AlexWantsKids":1}],[["Harper starts to talk, \"It's recommended to wait 4 to 6 weeks to have sex again, and longer if you plan for more children.\" You ask Alex, \"Is that okay?\""],["default"]],{},1,0],
[[{"Location":"cottage","Partner":"Alex","Speech":"Neutral"},{},{},{"AlexWantsKids":1}],[["Harper starts to talk, \"It's recommended to wait-\" before you cut <<nnpc_him \"Harper\">> off, \"Focus! this one first.\" you say between groans."],["default"]],{},1,0],
[[{"Location":"cottage","Partner":"Alex","Epidural":"Too expensive"},{},{},{}],[["\"Doc, don't worry about it, I will cover it for <<phim>>.\" You smile through some pain, \"Thank you, really.\"","This will help with the pain."],["default","green"]],{"Epidural":1},1,0],
[[{"Location":"hospital","Partner":"Alone","PartnerCalled":1},{"ArrivedTogether":1},{"PartnerArrived":1},{}],[[$birth.inlobby + " appears in the doorway, looking around the room, then at you. <<nnpc_He \"" + $birth.inlobby + "\">> stands there for an awkward moment, clearly taking in what is happening."],["default"]],{},1,1],
[[{"Location":"hospital","Partner":"Alone","PartnerCalled":1},{},{"ArrivedTogether":1},{"PartnerArrived":1}],[["<<nnpc_He \"" + $birth.inlobby + "\">> finally steps into the room, but goes straight to the doctor. \"Is this normal?\""],["default"]],{},1,0]
	]}>>
	<</if>>
	<<if setup.birthPrompts is undefined or _birthRebuildRuntime>>
	<<run setup.birthPrompts = {"mouthaction":{
    "finished":[["You pant profusely, catching your breath."],["default"]],
    "groan":[
        [["You grit your teeth and groan."],["default"]],
        [["A low groan slips out before you can swallow it."],["default"]],
        [["You groan through the pressure, jaw tight."],["default"]],
        [["A rough sound escapes you as the contraction drags on."],["default"]]
    ],
    "groanWeak":[["You utter sounds that are a mix of groans and whimpers."],["default"]],
    "moan":[["You moan as your " + ($birth.genital is "vagina" ? "uterus" : "anus") + " spasms. You can't tell if it's from an orgasm or contraction."],["default"]],
    "askEpiduralHospitalTooLate":[["You beg the midwife for pain relief. The midwife looks to Harper, who shakes <<nnpc_his \"Harper\">> head. The midwife looks to you apologetically, \"Sorry hun, you're almost done, ","it won't help in time.\""],["default","red"]],
    "askEpiduralHospitalSuccess":[["You beg the midwife for pain relief, knowing you'll need it soon. The midwife looks at Harper, who nods. They fetch the medicine already prepped nearby and hand Harper the epidural."," This will make the discomfort much more bearable."],["default","green"]],
    "askEpiduralHospitalTooExpensive":[["You beg the midwife for pain relief. The midwife gives you a pitying look. \"I'm really sorry, but that's not covered. If you can't afford it, ","you'll just have to bear the pain.\""],["default","red"]],
    "askEpiduralCottageTooLate":[["You beg Harper for pain relief. Harper shakes <<nnpc_his \"Harper\">> head rigidly. ","\"There's no point. "," You'll be done soon.\""],["default","red","default"]],
    "askEpiduralCottageSuccess":[["You beg Harper for pain relief, knowing you'll need it soon. Harper nods, \"It will cost you, but that's fine.\" <<nnpc_He \"Harper\">> turns to the tray of medicine already prepped nearby and grabs the epidural.","This will make the discomfort much more bearable."],["default","green"]],
    "askEpiduralCottageTooExpensive":[["You beg Harper for pain relief. <<nnpc_He \"Harper\">> looks at you in pity, \"That costs extra, if you can't afford it ","you will have to just bear with the pain.\""],["default","red"]],
    "askEpiduralWolfCaveHallucinate":[["You beg the " + $birth.partner + " for pain relief. A wolfboy shouts from outside the cave \"I help!\" and runs off to go forage for something."],["default"]],
    "askEpiduralWolfCave":[["You beg the " + $birth.partner + " for pain relief. Another wolf outside seems to understand and barks in response before running off."],["default"]],
    "askEpiduralWolfCaveSuccess":[["They come back with a red mushroom. You know this particular mushroom wont help the pain, but hope it ","speeds up the process."],["default","green"]],
    "askEpiduralWolfCaveFail":[["They come back with a pink mushroom. ","You know this is poisonous to wolves",", and feel terrible at the thought of consuming something that could harm your pups."],["default","red","default"]],
    "askEpiduralBedroomSuccess":[["You ask Robin for something to help with the pain. <<nnpc_he \"Robin\">> hesitates, then hurries off and comes back with painkillers."," This will make the discomfort a little more bearable."],["default","green"]],
    "askEpiduralBedroomFail":[["You ask Robin for something to help with the pain. <<nnpc_he \"Robin\">> wrings <<nnpc_his \"Robin\">> hands, unsure if it's safe to give you anything without a doctor here."," You'll have to bear with it."],["default","red"]],
    "askPartnerBedroomFail":[["There's no one else to call. Whoever's already with you isn't leaving your side now, and if you're on your own, there's no one nearby to send for."],["default"]],
    "askPartnerHospitalSuccess":[["The midwife motions to a nurse on standby. They leave to go get the father from the lobby."],["default"]],
    "askPartnerHospitalFail":[["The midwife asks you \"Is the father nearby?\" Between pants, you tell the midwife they aren't. The midwife asserts \"You're gonna deliver before long, hun. I will do the best I can to make sure you're fine\""],["default"]],
    "askPartnerWolfCaveHallucinate":[["The Black Wolf barks loudly towards the pack outside, \"Where is the father!?\""],["default"]],
    "askPartnerWolfCave":[["The Black Wolf barks repeatedly, getting the attention of the pack."],["default"]],
    "askPartnerPrisonSuccess":[["The guard motions to one standing in the doorway nearby, \"Grab the inmate. It's the least we can do.\""],["default"]],
    "askPartnerPrisonFail":[["The guard looks at you confused, \"We can't even get a doctor here for you in time, let alone the father.\""],["default"]],
    "askPartnerCottageSuccess":[["Harper acknowledges your request and quickly walks to the door, and shouts \"Alex! Your presence is requested!\""],["default"]],
    "askPartnerCottageFail":[["Harper looks at you quizzically, \"There's no one besides Alex within miles, let alone the father.\""],["default"]],
    "restSuccess":[
        [["You take deep, calm breaths."],["default"]],
        [["You breathe in slowly, then let it out before panic can catch."],["default"]],
        [["You steady yourself with a careful breath."],["default"]],
        [["You manage to keep your breathing even for a moment."],["default"]]
    ],
    "restFail":[
        [["You lose the rhythm of your breathing and groan."],["red"]],
        [["Your breath catches, turning into a strained groan."],["red"]],
        [["You try to breathe evenly, but the next sound comes out ragged."],["red"]],
        [["The contraction steals your careful breathing and leaves you panting."],["red"]]
    ]
},



"pelvisaction":{
    "finished":[["You rest your sore pelvis."],["default"]],
    "push":[
        [["You push hard with your "+($birth.genital is "vagina" ? "vagina." : "anus.")],["default"]],
        [["You bear down, trying to work with the pressure instead of fighting it."],["default"]],
        [["You brace yourself and push when your body demands it."],["default"]],
        [["You force yourself to push, breath catching as the pressure bears down."],["default"]]
