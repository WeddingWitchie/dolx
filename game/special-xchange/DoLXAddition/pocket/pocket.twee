:: Widgets Pocket [widget]

<<widget "titlePocket">>
	<<setupTabs>>
	<div id="overlayTabs" class="tab">
		<<closeButtonMobile>>
		<<button "Bag">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<pocketBagTab>><</replace>>
		<</button>>
		<<button "Hand Mirror">>
			<<toggleTab>>
			<<replace #customOverlayContent>><<pocketMirrorTab>><</replace>>
		<</button>>
		<<if PocketMusic.available()>>
			<<button "Music">>
				<<toggleTab>>
				<<replace #customOverlayContent>><<pocketMusicControls>><</replace>>
			<</button>>
		<</if>>
	</div>
	<<closeButton>>
<</widget>>

/* Entry point used by the sidebar button. Everything past the gate assumes the PC can reach their things. */
<<widget "pocketMain">>
	<<set _pocketLock to pocketLockReason()>>
	<<if _pocketLock isnot "">>
		<div class="pocket-locked">
			<span class="gold">Pocket</span>
			<br><br>
			<span class="red"><<= _pocketLock>></span>
		</div>
	<<else>>
		<<pocketBagTab>>
	<</if>>
<</widget>>

/* The name of the carried container, including the PC's own pocket when they have no bag. */
<<widget "bagname">><<print pocketBagName()>><</widget>>

/* Hand mirror */

/* The real mirror, held in the hand. */
<<widget "pocketMirrorTab">>
	<<set _pocketLock to pocketLockReason()>>
	<<if _pocketLock isnot "">>
		<span class="red"><<= _pocketLock>></span>
	<<else>>
		<<run pocketEnsure()>>
		<<if !$pocket.mirror>>
			<div class="pocket-empty">
				You don't own a hand mirror. The cosmetics store in the shopping centre sells them.
			</div>
		<<elseif Weather.bloodMoon>>
			<div class="pocket-locked">
				<span class="red">You have a feeling something bad will happen if you check the mirror now.</span>
				<<if !$daily.pocketMirrorBloodMoon>>
					<<set $daily.pocketMirrorBloodMoon to true>>
					<<awareness 5>><<ggawareness>>
					/* Overlay writes don't reach the save until a passage commits them. */
					<<run pocketCommit()>>
				<</if>>
			</div>
		<<else>>
			<<preMirror>>
			<<unset $mirrorMenu>>
			/* Tagged "pocket" so the hand mirror's sub-menu doesn't carry over to a real mirror. */
			<<mirror "" "pocket">>
		<</if>>
	<</if>>
<</widget>>

/* Bag */

/* Read-only by design: things go into the bag where they live. */
<<widget "pocketBagTab">>
	<<set _pocketLock to pocketLockReason()>>
	<<if _pocketLock isnot "">>
		<span class="red"><<= _pocketLock>></span>
	<<else>>
		<<run pocketSyncBag()>>
		<<run pocketCheckSpoilage()>>
		<div id="pocketPane"><<pocketBagContents>></div>
	<</if>>
<</widget>>

<<widget "pocketBagContents">>
	<<set _personalSlots to $pocket.bag.slots.filter(slot => slot.location is "pocket")>>
	<<set _bagSlots to $pocket.bag.slots.filter(slot => slot.location is "bag")>>
	<div class="small-description">Each kind of thing takes one slot, however many of it you pack. Pack things where you keep them: the kitchen, the medicine drawer, the toy cupboard, the bait shop.</div>
	<br>
	<<if bloatedActive()>>
		<div class="red">You feel bloated. Eating anything will keep you bloated for another 10 hours.</div><br>
	<<elseif pocketFoodFullness() gte 5>>
		<div class="gold">You're feeling quite full.</div><br>
	<</if>>
	<div id="pocketUseReport"></div>

	<section class="pocket-section">
		<header class="pocket-section-header">
			<span>Pocket</span>
			<span @class="_personalSlots.length ? 'red' : 'blue'"><<= _personalSlots.length>>/1 slot</span>
		</header>
		<<if _personalSlots.length>>
			<div class="pocket-slots">
				<<for _slot range _personalSlots>><<pocketSlotRow _slot>><</for>>
			</div>
		<<else>>
			<div class="pocket-empty">Your pocket is empty.</div>
		<</if>>
	</section>

	<<if pocketBagItem()>>
		<section class="pocket-section">
			<header class="pocket-section-header">
				<span><<= pocketBagName().toLocaleUpperFirst()>></span>
				<span @class="_bagSlots.length gte pocketBagCapacity() ? 'red' : 'blue'"><<= _bagSlots.length>>/<<= pocketBagCapacity()>> slots</span>
			</header>
			<<if _bagSlots.length>>
				<div class="pocket-slots">
					<<for _slot range _bagSlots>><<pocketSlotRow _slot>><</for>>
				</div>
			<<else>>
				<div class="pocket-empty">The bag is empty.</div>
			<</if>>
		</section>
	<</if>>
<</widget>>

<<widget "pocketSlotRow">>
	<<set _rowSlot to _args[0]>>
	<div class="pocket-slot">
		<<switch _rowSlot.kind>>
			<<case "food">>
				<div @class="$options.images is 1 ? 'pocket-item-row pocket-item-row-icon' : 'pocket-item-row'">
					<<if $options.images is 1>><span class="pocket-item-icon"><<foodstufficon _rowSlot.key>></span><</if>>
					<span class="pocket-item-name">
						<span class="teal"><<= setup.foodstuff[_rowSlot.key].name.toLocaleUpperFirst()>></span>
						<span class="gold">(<<= foodBatchCount(_rowSlot.key)>>)</span>
					</span>
					<span class="pocket-item-actions">
						<<capture _rowSlot>>
							<<if bloatedActive()>><span class="red">Keeps you bloated</span><br>
							<<elseif foodWouldBloat(_rowSlot.key)>><span class="red">Will make you bloated</span><br><</if>>
							<<if foodTags(_rowSlot.key).includes("drink")>>
								<<link [[Drink|Pocket Eat Food]]>><<run pocketEatFoodFromMenu(_rowSlot.key)>><</link>>
							<<else>>
								<<link [[Eat|Pocket Eat Food]]>><<run pocketEatFoodFromMenu(_rowSlot.key)>><</link>>
							<</if>>
							<<if typeof Menagerie isnot "undefined" and Menagerie.carried()>>
								|
								<<link [[Feed to pet|Pocket Feed Pet]]>><<run Menagerie.feedFromPocket(_rowSlot.key)>><</link>>
							<</if>>
							|
							<<link "Take out">>
								<<run pocketSlotToggle("food", _rowSlot.key)>>
								<<replace #pocketPane>><<pocketBagContents>><</replace>>
							<</link>>
						<</capture>>
					</span>
				</div>
			<<case "pill">>
				<<set _rowPill to pocketPillSetup(_rowSlot.key)>>
				<div @class="$options.images is 1 ? 'pocket-item-row pocket-item-row-icon' : 'pocket-item-row'">
					<<if $options.images is 1>><span class="pocket-item-icon pocket-pill-icon"><<= pocketPillIcon(_rowSlot.key)>></span><</if>>
					<span class="pocket-item-name">
						<span class="teal"><<= _rowSlot.key.toLocaleUpperFirst()>></span>
						<span class="gold">(<<= pocketPillOwned(_rowSlot.key)>>)</span>
					</span>
					<span class="pocket-item-actions">
						<<capture _rowSlot _rowPill>>
							<<if _rowPill and _rowPill.take_condition() isnot 0>>
								<<link "Take one">>
									<<set _pillTaken to pocketTakePill(_rowSlot.key)>>
									/* Nothing to redraw when the pill sent the PC off to an overdose passage. */
									<<if _pillTaken and !_pillTaken.navigated>>
										<<replace #pocketPane>><<pocketBagContents>><</replace>>
										<<if _pillTaken.message>>
											<<replace #pocketUseReport>><span class="purple"><<= _pillTaken.message>></span><</replace>>
										<</if>>
									<</if>>
								<</link>>
								|
							<<else>>
								<span class="grey" @title="pocketPillBlockedReason(_rowSlot.key)">Can't take one now</span> |
							<</if>>
							<<link "Take out">>
								<<run pocketSlotToggle("pill", _rowSlot.key)>>
								<<replace #pocketPane>><<pocketBagContents>><</replace>>
							<</link>>
						<</capture>>
					</span>
				</div>
			<<case "bait">>
				<div @class="$options.images is 1 ? 'pocket-item-row pocket-item-row-icon' : 'pocket-item-row'">
					<<if $options.images is 1>><span class="pocket-item-icon"><<icon `pocketBaitIconPath(_rowSlot.key)`>></span><</if>>
					<span class="pocket-item-name">
						<<if _rowSlot.key is "worm_can">>
							<span class="teal"><<= wormCanLabel()>></span>
						<<else>>
							<span class="teal"><<= pocketBaitName(_rowSlot.key)>></span>
							<span class="gold">(<<= pocketBaitDetail(_rowSlot.key)>>)</span>
						<</if>>
					</span>
					<span class="pocket-item-actions">
						<<capture _rowSlot>>
							<<if _rowSlot.key is "worm_can">>
								<<if canEatWorm()>>
									<<link [[Eat one|Pocket Eat Bait]]>><<run pocketEatBaitFromMenu("bait_worm")>><</link>><<if effectiveTransformationLevel("bird") gte 3>><<harpy>><</if>> |
								<<else>>
									<span class="grey">Empty</span> |
								<</if>>
							<<elseif canEatBaitFish(_rowSlot.key)>>
								<<link [[Eat|Pocket Eat Bait]]>><<run pocketEatBaitFromMenu(_rowSlot.key)>><</link>><<fishEatingTf>> |
							<</if>>
							<<link "Take out">>
								<<run pocketSlotToggle("bait", _rowSlot.key)>>
								<<replace #pocketPane>><<pocketBagContents>><</replace>>
							<</link>>
						<</capture>>
					</span>
				</div>
			<<case "toy">>
				/* No group heading: every row already names the toy. */
				<div class="pocket-toy-list">
					<<for _toyItem range pocketToyItems(_rowSlot.key)>>
						<div @class="'pocket-item-row pocket-toy-row' + ($options.images is 1 ? ' pocket-item-row-icon' : '')">
							<<if $options.images is 1>><span class="pocket-item-icon pocket-toy-icon"><<= pocketToyIcon(_toyItem.category, _toyItem.index)>></span><</if>>
							<span class="pocket-item-name">
								<span class="teal"><<= _toyItem.setupToy ? _toyItem.setupToy.name.toLocaleUpperFirst() : _toyItem.toy.name.toLocaleUpperFirst()>></span>
								<<if _toyItem.count gt 1>><span class="gold">(<<= _toyItem.count>>)</span><</if>>
								<<if _toyItem.worn>><span class="green">(worn)</span><</if>>
							</span>
							<span class="pocket-item-actions">
								<<capture _toyItem>>
									<<if _toyItem.stacked>>
										<span class="grey"><<= _toyItem.uses>> use<<if _toyItem.uses isnot 1>>s<</if>></span>
									<<elseif !_toyItem.wearableKind>>
										<span class="grey">In hand</span>
									<<elseif _toyItem.canWear>>
										<<link _toyItem.wearLabel>>
											<<set _toyNotice to pocketToyWear(_toyItem.category, _toyItem.index)>>
											<<replace #pocketPane>><<pocketBagContents>><</replace>>
											<<if _toyNotice>><<replace #pocketUseReport>><span class="red"><<= _toyNotice>></span><</replace>><</if>>
										<</link>>
									<<else>>
										<span class="grey">Can't wear it now</span>
									<</if>>
									|
									<<link "Take out">>
										<<if _toyItem.stacked>><<run pocketSlotToggle("toy", _toyItem.category)>><<else>><<run pocketToyPack(_toyItem.category, _toyItem.index, false)>><</if>>
										<<replace #pocketPane>><<pocketBagContents>><</replace>>
									<</link>>
								<</capture>>
							</span>
						</div>
					<</for>>
				</div>
			<<case "outfit">>
				/* One folded serving outfit. Each garment is the only copy: see pocket-outfit.js. */
				<div class="pocket-toy-list">
					<<for _outfitIndex to 0; _outfitIndex lt $pocket.outfit.pieces.length; _outfitIndex++>>
						<<capture _outfitIndex>>
							<<set _outfitPiece to $pocket.outfit.pieces[_outfitIndex]>>
							<div class="pocket-item-row pocket-toy-row">
								<span class="pocket-item-name">
									<span class="teal"><<= pocketOutfitPieceName(_outfitPiece.slot, _outfitPiece.item).toLocaleUpperFirst()>></span>
								</span>
								<span class="pocket-item-actions">
									<<link "Take out">>
										<<run pocketOutfitUnpack(_outfitIndex)>>
										<<replace #pocketPane>><<pocketBagContents>><</replace>>
									<</link>>
								</span>
							</div>
						<</capture>>
					<</for>>
				</div>
		<</switch>>
	</div>
<</widget>>

<<widget "pocketPackOutfitList">>
	<div class="small-description">The whole outfit takes one slot. Maid, butler and waiting clothes only, and only what's in this wardrobe.</div>
	<br>
	<<if $pocket.outfit.pieces.length gt 0>>
		<span class="teal">Folded up:</span>
		<div class="pocket-arrange">
			<<for _packedIndex to 0; _packedIndex lt $pocket.outfit.pieces.length; _packedIndex++>>
				<<capture _packedIndex>>
					<<set _packedPiece to $pocket.outfit.pieces[_packedIndex]>>
					<div class="pocket-arrange-row">
						<span class="pocket-arrange-name"><<= pocketOutfitPieceName(_packedPiece.slot, _packedPiece.item).toLocaleUpperFirst()>></span>
						<<link [[Put back|Pocket Pack Outfit]]>><<run pocketOutfitUnpack(_packedIndex)>><</link>>
					</div>
				<</capture>>
			<</for>>
		</div>
		<br>
	<</if>>
	<<set _outfitBlocked to pocketOutfitPackBlocked()>>
	<<set _outfitCandidates to pocketOutfitCandidates()>>
	<<if _outfitCandidates.length is 0>>
		<div class="pocket-empty">There's nothing in here a maid or a butler would wear.</div>
	<<else>>
		<div class="pocket-arrange">
			<<for _outfitOption range _outfitCandidates>>
				<<capture _outfitOption>>
					<div class="pocket-arrange-row">
						<span class="pocket-arrange-name"><<= _outfitOption.name.toLocaleUpperFirst()>></span>
						<<if _outfitBlocked isnot "">>
							<span class="grey"><<= _outfitBlocked>></span>
						<<else>>
							<<link [[Fold up|Pocket Pack Outfit]]>><<run pocketOutfitPack(_outfitOption.slot, _outfitOption.index)>><</link>>
						<</if>>
					</div>
				<</capture>>
			<</for>>
		</div>
	<</if>>
<</widget>>

<<widget "pocketEatReport">>
	<<set _report to _args[0]>>
	<<if _report>>
		<<set _drink to foodTags(_report.key).includes("drink")>>
		You <<if _drink>>drink<<else>>eat<</if>> <<= setup.foodstuff[_report.key].word or "a">> <<= setup.foodstuff[_report.key].singular>>.<<if _report.own>> <span class="teal"><<if _drink>>You made it yourself.<<else>>Your own cooking.<</if>></span><</if>>
		<br><span><<if _report.stale>>It is past its date, so it only fills you up.<</if>><<if !_report.stale>><<= foodEffectText(_report.key)>><</if>></span>
		<<pocketStatArrows _report.effects>>
		<<if _report.transformation>>
			<br><span class="pink"><<= setup.foodTransformText[_report.transformation]>></span>
		<</if>>
		<<if _report.willpowerRested gt 0>>
			<br><span class="green">The break steadies you.</span>
		<</if>>
	<</if>>
<</widget>>

/* Journal > Foods. Every separately cooked batch keeps its own date. */
<<widget "pocketFoodJournal">>
	<<set _spoiledFood to pocketSpoiledNotice()>>
	<<if _spoiledFood.length>>
		<div class="pocket-spoiled">
			<<for _gone range _spoiledFood>>
				<span class="red">
					<<= _gone.amount>> <<= _gone.amount is 1 ? setup.foodstuff[_gone.key].singular : setup.foodstuff[_gone.key].plural>> went off and <<if _gone.amount is 1>>was<<else>>were<</if>> thrown away today.
				</span><br>
			<</for>>
		</div>
	<</if>>
	<<set _journalFoods to [...new Set(pocketFoodList().concat(refrigeratorFoodList()))]>>
	<<if _journalFoods.length is 0>>
		<div class="pocket-empty">You have no cooked food stored.</div>
	<<else>>
		<div class="food-journal">
			<<for _foodKey range _journalFoods>>
				<<set _storedFoodRows to refrigeratorFoodRows(_foodKey)>>
				<div @class="$options.images is 1 ? 'food-journal-row food-journal-row-icon' : 'food-journal-row'">
					<<if $options.images is 1>><span class="food-journal-icon"><<foodstufficon _foodKey>></span><</if>>
					<div class="food-journal-body">
						<div class="food-journal-name">
							<span class="teal"><<= setup.foodstuff[_foodKey].name.toLocaleUpperFirst()>></span>
							<span class="gold">(<<= foodBatchCount(_foodKey) + _storedFoodRows.reduce((sum, row) => sum + row.amount, 0)>>)</span>
						</div>
						<div class="food-journal-batches">
							<<for _foodBatch range foodExpiryRows(_foodKey)>>
								<div class="food-journal-batch">
									<span><<= _foodBatch.amount>> <<= _foodBatch.amount is 1 ? "serving" : "servings">></span>
									<<if !$foodSpoilage and _foodBatch.daysLeft lte 0>><span class="grey">Past its date</span>
									<<elseif !$foodSpoilage and _foodBatch.daysLeft lte 1>><span class="gold">Effects end overnight</span>
									<<elseif !$foodSpoilage>><span class="green">Effects for <<= Math.floor(_foodBatch.daysLeft)>> more days</span>
									<<elseif !isFinite(_foodBatch.daysLeft)>><span class="grey">Does not spoil</span>
									<<elseif _foodBatch.daysLeft lte 1>><span class="red">Goes off overnight</span>
									<<elseif _foodBatch.daysLeft lte 3>><span class="red"><<= Math.floor(_foodBatch.daysLeft)>> days left</span>
									<<elseif _foodBatch.daysLeft lte 7>><span class="gold"><<= Math.floor(_foodBatch.daysLeft)>> days left</span>
									<<else>><span class="green"><<= Math.floor(_foodBatch.daysLeft)>> days left</span><</if>>
								</div>
							<</for>>
							<<for _storedBatch range _storedFoodRows>>
								<div class="food-journal-batch food-journal-batch-stored">
									<span><<= _storedBatch.amount>> <<= _storedBatch.amount is 1 ? "serving" : "servings">></span>
									<span class="food-journal-stored">
										<span class="blue">Stored · <<= _storedBatch.location>></span><br>
										<<if !isFinite(_storedBatch.daysLeft)>><span class="grey">Does not spoil</span>
										<<elseif _storedBatch.daysLeft lte 0>><span class="grey">Past its date · no effects</span>
										<<elseif !$foodSpoilage>><span class="green">Effects for <<= Math.floor(_storedBatch.daysLeft)>> <<pluralise Math.floor(_storedBatch.daysLeft) "day">> after removal</span>
										<<elseif _storedBatch.daysLeft lte 1>><span class="red">Goes off overnight after removal</span>
										<<elseif _storedBatch.daysLeft lte 3>><span class="red"><<= Math.floor(_storedBatch.daysLeft)>> days after removal</span>
										<<elseif _storedBatch.daysLeft lte 7>><span class="gold"><<= Math.floor(_storedBatch.daysLeft)>> days after removal</span>
										<<else>><span class="green"><<= Math.floor(_storedBatch.daysLeft)>> days after removal</span><</if>>
									</span>
								</div>
							<</for>>
						</div>
					</div>
				</div>
			<</for>>
		</div>
	<</if>>
<</widget>>

/* Packing, shown where the things are kept */
/* The kitchen's packing panel. The PC always has one personal slot, even without a bag. */
<<widget "pocketPackFood">>
	<<run pocketSyncBag()>>
	<div id="basket">
		<span class="gold bold">Pack food to your pocket<<if pocketBagItem()>> or <<bagname>><</if>>:</span>
		<div class="mobileOnly">
			<<link "Close">>
				<<addclass "#altSection, #mobileCloser" "mobileHidden">>
			<</link>>
			<br><br>
		</div>
	</div>
	<div id="basketItems" class="info">
		<<pocketPackFoodList>>
	</div>
<</widget>>

<<widget "pocketPackFoodList">>
	<<set _packCapacity to pocketCarryCapacity()>>
	<<set _packUsed to $pocket.bag.slots.length>>
	<span @class="_packUsed gte _packCapacity ? 'red' : 'blue'"><<= _packUsed>>/<<= _packCapacity>> slots used.</span>
	<div class="small-description">Each dish takes one slot, however many servings you have of it.</div>
	<br>
	<<set _packFoodKeys to pocketFoodList()>>
	<<if _packFoodKeys.length is 0>>
		<div class="pocket-empty">You've no cooked food to pack.</div>
	<<else>>
		<div class="pocket-arrange">
			<<for _packKey range _packFoodKeys>>
				<div class="pocket-arrange-row">
					<span class="pocket-arrange-name">
						<<if $options.images is 1>><<foodstufficon _packKey>><</if>>
						<<= setup.foodstuff[_packKey].name.toLocaleUpperFirst()>>
						<span class="gold">(<<= foodBatchCount(_packKey)>>)</span>
					</span>
					<<capture _packKey>>
						<<if pocketCarrying("food", _packKey)>>
							<<link "Take out">>
								<<run pocketSlotToggle("food", _packKey)>>
								<<replace #basketItems>><<pocketPackFoodList>><</replace>>
							<</link>>
						<<elseif _packUsed gte _packCapacity>>
							<span class="grey"><<= pocketBagName().toLocaleUpperFirst()>> full</span>
						<<else>>
							<<link "Pack">>
								<<run pocketSlotToggle("food", _packKey)>>
								<<replace #basketItems>><<pocketPackFoodList>><</replace>>
							<</link>>
						<</if>>
					<</capture>>
				</div>
			<</for>>
		</div>
	<</if>>
<</widget>>

:: Pocket Eat Food
<<effects>>
<<set _pocketFoodDestination to $pocketFoodReturn or "Bedroom">>
<<if $pocketFoodResult>>
	<<pocketEatReport $pocketFoodResult>>
	<br><br>
	<<link [[Next|_pocketFoodDestination]]>>
		<<unset $pocketFoodResult $pocketFoodReturn>>
	<</link>>
<<else>>
	You have nothing to eat.
	<br><br>
	<<link [[Next|_pocketFoodDestination]]>><<unset $pocketFoodReturn>><</link>>
<</if>>

:: Pocket Pack Outfit [exitCheckBypass]
<<effects>>
<<run pocketOutfitEnsure()>>
<<run pocketSyncBag()>>
<<set _outfitReturn to $pocketOutfitReturn or "Wardrobe">>
<span class="gold bold">Fold an outfit set into your <<if pocketBagItem()>><<bagname>><<else>>pocket<</if>>.</span>
<br><br>
<<pocketPackOutfitList>>
<br>
<<link "Done" _outfitReturn>><<unset $pocketOutfitReturn>><</link>>
<br>
