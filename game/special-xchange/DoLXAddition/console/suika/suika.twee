:: Home Console Suika
<<set $outside to 0>>
<<if $location isnot "home" and $location isnot "alex_cottage">><<set $location to "home">><</if>>
<<effects>>
<<furnitureicon "controller">>You start the fruit game. Drop fruit into the jar, and two of the same fruit merge into a bigger one.
<br><br>
<<nobr>><div id="suika" class="suika no-numberify">
	<div class="suika-play">
		<div class="suika-modes" role="group" aria-label="Game mode">
			<button type="button" class="suika-btn suika-mode" data-mode="classic" aria-pressed="true">Classic</button>
			<button type="button" class="suika-btn suika-mode" data-mode="arcade" aria-pressed="false">Arcade</button>
			<button type="button" class="suika-btn suika-mode" data-mode="zen" aria-pressed="false">Zen</button>
		</div>
		<div class="suika-goal" hidden>
			<span class="suika-goal-name"></span>
			<span class="suika-goal-text"></span>
			<div class="suika-goal-bar" role="progressbar" aria-label="Goal progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden></div>
		</div>
		<div class="suika-tip" role="region" aria-label="Tutorial" hidden></div>
		<div class="suika-hud">
			<span class="tama-stat"><span class="tama-k">Score</span><span class="tama-v suika-score">0</span></span>
			<span class="tama-stat"><span class="tama-k suika-best-label">Best</span><span class="tama-v suika-best"><<print $suikaBest or 0>></span></span>
			<span class="tama-stat suika-next"><span class="tama-k">Next</span><span class="tama-v"><canvas class="suika-next-dot" aria-hidden="true"></canvas><span class="suika-next-name"></span></span></span>
		</div>
		<div class="suika-board" data-gesture-owner="fruit">
			<canvas class="suika-canvas" tabindex="0" aria-label="Fruit game jar. Left and right arrows aim, Space drops, P pauses."></canvas>
			<div class="suika-toast" role="status" hidden></div>
			<div class="suika-overlay" role="dialog" aria-labelledby="suika-overlay-title" hidden>
				<span class="suika-overlay-title" id="suika-overlay-title"></span>
				<span class="suika-overlay-text"></span>
				<ul class="suika-overlay-extra" hidden></ul>
				<div class="suika-overlay-buttons">
					<button type="button" class="suika-btn suika-overlay-btn"></button>
					<button type="button" class="suika-btn suika-overlay-btn2" hidden></button>
				</div>
			</div>
		</div>
		<canvas class="suika-legend" role="img" aria-label="Fruit order, smallest to largest: Cherry, Strawberry, Grape, Dekopon, Persimmon, Apple, Pear, Peach, Pineapple, Melon, Watermelon."></canvas>
		<div class="suika-abilities" role="group" aria-label="Arcade power-ups" hidden></div>
		<div class="suika-controls">
			<button type="button" class="suika-btn suika-pause">Pause</button>
			<button type="button" class="suika-btn suika-menu" aria-haspopup="true">Menu</button>
			<button type="button" class="suika-btn suika-restart">Restart</button>
		</div>
	</div>
	<div class="suika-panel" role="region" hidden></div>
	<div class="suika-status suika-sr" aria-live="polite"></div>
</div><</nobr>>
<<run setup.suika.open()>>
<br>
<<getouticon>><<link [[Back to the console|Home Console]]>><<run setup.suika.leave()>><</link>>
<br>
