	<br><br>

	<<link [[Next|Asylum]]>><<endevent>><</link>>
	<br>
<<else>>
	<<if $tiredness gte C.tiredness.max>>
		<span class="blue">You're too tired to dance right now.</span>
		<br>
	<<else>>
		<<link [[Keep dancing (0:20)|Asylum Depths Mirror Dance]]>><<set $phase to 1>><<pass 20>><<tiredness 6>><<danceskill 1>><</link>><<gtiredness>><<gdanceskill>>
