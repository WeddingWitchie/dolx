<</if>>

:: Racecourse Rig Bribe Rider End
<<effects>>
<<set _horse to setup.horserace.getHorse($horserace.rigTargetId)>>
<<if $enemypleasure gte $enemypleasuremax>>
	<<He>> lets out a breath and leans back against the horsebox.
	<br><br>
	"All right," <<he>> says, still breathing heavily. "I'll do everything I can to help <<print _horse.name>> win today. I promise."<<if $face isnot "covered">><<famesex 6>><</if>>
	<<run setup.horserace.resolveRigAction("bribe_sex", _horse.id, true)>>
<<else>>
	<<if $finish is 1>><<encounterEndViolence>><</if>>
	<<He>> fixes <<his>> clothes, then looks at the stopwatch again without meeting your eyes. "I listened to your offer. That doesn't mean I agreed."<<gstress>><<stress 6>>
	<br><br>
	<<run setup.horserace.resolveRigAction("bribe_sex", _horse.id, false)>>
	<<tearful>> you climb to your feet.
	<br><br>
<</if>>
<<endcombat>>
<<riggingFooter>>


:: Widgets Horse Rigging [widget]
<<widget "racehorse">><<print setup.horserace.kind()>><</widget>>
<<widget "racehorses">><<print setup.horserace.kind(true)>><</widget>>
<<widget "raceit">><<print setup.horserace.it(_args[0])>><</widget>>

<<widget "riggingFooter">>
	<span class="orange">Suspicion is now <<print $horserace.suspicion>>%.</span>
	<<if $horserace.suspicion gte 60>>
		The race officials are <span class="red">checking the bets more carefully</span> now.
	<</if>>
	<br><br>
	<<link [[Stay in the yard|Racecourse Rigging]]>><<endcombat>><</link>>
	<br>
	<<link [[Back to the rail|Racecourse Rigging Leave]]>><<endcombat>><</link>>
<</widget>>
