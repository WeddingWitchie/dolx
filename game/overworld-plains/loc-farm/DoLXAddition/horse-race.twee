	<<set $skulduggerydifficulty to _action.difficulty>>
	<<skulduggerycheck "silent">>
	<<set _success to $skulduggerysuccess is 1>>
	<<if _success>>
		<<He>> looks you over, then glances back towards the stable row to check nobody is coming.
		"I'm listening," <<he>> says.
		<br><br>
		<<link "Offer yourself" "Racecourse Rig Bribe Rider Sex">><<set $sexstart to 1>><</link>>
	<<else>>
		<<He>> laughs and shakes <<his>> head. "Not worth the risk," <<he>> says,
		and walks off before you can say anything else.<<gstress>><<stress 6>>
		<br><br>
		<<run setup.horserace.resolveRigAction("bribe_sex", _horse.id, false)>>
		<<riggingFooter>>
	<</if>>
<</if>>

:: Racecourse Rig Bribe Rider Sex
<<if $sexstart is 1>>
	<<set $sexstart to 0>>
	<<consensual>>
	<<set $consensual to 1>>
	<<neutral 1>>
	<<maninit>>
	<<promiscuity4>>
	<<npcoral>>
	<<set $enemytrust -= 40>>
<</if>>
<<effects>>
<<effectsman>>
<<man>>
<<stateman>>
<br><br>
<<actionsman>>
<<if _combatend>>
	<span id="next"><<link [[Next|Racecourse Rig Bribe Rider End]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Racecourse Rig Bribe Rider Sex]]>><</link>></span><<nexttext>>
<</if>>

:: Racecourse Rig Bribe Rider End
<<effects>>
<<set _horse to setup.horserace.getHorse($horserace.rigTargetId)>>
<<if $enemypleasure gte $enemypleasuremax>>
	<<He>> lets out a breath and leans back against the horsebox.
	<br><br>
	"Alright," <<he>> says, still catching <<his>> breath. "<<print _horse.name>> wins today.
	You have my word."<<if $face isnot "covered">><<famesex 6>><</if>>
	<<run setup.horserace.resolveRigAction("bribe_sex", _horse.id, true)>>
<<else>>
	<<He>> straightens <<his>> clothes and checks <<his>> stopwatch again, like nothing happened.
	"I said I'm listening. I didn't say yes yet."<<gstress>><<stress 6>>
	<br><br>
	<<run setup.horserace.resolveRigAction("bribe_sex", _horse.id, false)>>
<</if>>
<<silently>><<endcombat>><</silently>>
<<riggingFooter>>


:: Widgets Horse Rigging [widget]
<<widget "riggingFooter">>
	<span class="orange">Suspicion is now <<print $horserace.suspicion>>%.</span>
	<<if $horserace.suspicion gte 60>>
		<span class="red">The stewards are watching the board closely now.</span>
	<</if>>
	<br>
	<span class="teal">Chance your horse gets round without being pulled up: <<print setup.horserace.cleanRunChance()>>%.</span>
	<br><br>
	<<link [[Stay in the yard|Racecourse Rigging]]>><<endcombat>><</link>>
	<br>
	<<link [[Back to the rail|Racecourse Rigging Leave]]>><<endcombat>><</link>>
<</widget>>
