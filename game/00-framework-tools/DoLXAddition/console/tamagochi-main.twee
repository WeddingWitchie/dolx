:: Home Console
<<set $outside to 0>><<unset $consoleAction, $trainType>><<effects>>
<<set _ret to ($location is "alex_cottage" ? "Farm Bedroom" : "Bedroom")>>
/* Elixirs (from Robin's arcade-date booster packs) let a dead virtual pet be revived once each. Stored globally so they survive hatching a new pet. */
<<if $petElixirs is undefined>><<set $petElixirs to 0>><</if>>
/* Dungeon keys won from minibosses; each opens one dungeon run for the virtual pet. */
<<if $petKeys is undefined>><<set $petKeys to 0>><</if>>

<<furnitureicon "controller">>You switch on your console. What would you like to play?
<br><br>

<<icon "/furniture/tfplushes.png">><<link [[Virtual pet|Home Console Pet]]>><</link>>
<<if Tamagotchi.exists()>>
	<<run Tamagotchi.sync()>>
	<<if Tamagotchi.isAlive()>><<set _t to Tamagotchi.status()>>
		<<if _t.pendingAttack>>
			<span class="red">(!) under attack</span>
		<<elseif _t.pendingSkillChoice>>
			<span class="gold">(new skill)</span>
		<<elseif _t.sick or _t.hunger gte 80 or _t.poops gt 0>>
			<span class="red">(!)</span>
		<</if>>
	<</if>>
<</if>>
<br>
/* More games can be added here as further links. */
<br>
<<if $location is "alex_cottage">>
	<<if Tamagotchi.isAlive() and Time.dayState isnot "night" and $farm_stage gte 7 and !$weekly.alexConsole>>
		<<robinicon "controller">><<link [[Invite Alex to play (0:05)|Alex Console Visit]]>><<set $weekly.alexConsole to true>><<pass 5>><</link>>
	<</if>>
<<else>>
	<<if $robinromance is 1 or $robinbreakup is 1>>
		<<run getRobinLocation()>>
		<<if _robin_location is "orphanage" and !$weekly.robinConsole>>
			<<robinicon "controller">><<link [[Invite Robin to play (0:05)|Robin Console Visit]]>><<set $weekly.robinConsole to true>><<pass 5>><</link>>
		<</if>>
	<</if>>
<</if>>
<br>
<<getouticon>><<link "Turn it off" _ret>><<unset $consoleAction, $trainType>><</link>>

:: Home Console Pet
<<set $outside to 0>><<effects>>
<<set _ret to ($location is "alex_cottage" ? "Farm Bedroom" : "Bedroom")>>
<<furnitureicon "controller">>You open the virtual pet game.
<br><br>
<<run Tamagotchi.sync()>>
<<if not Tamagotchi.exists()>>
	The screen shows a speckled egg. As it hatches, the game asks you to pick your starter.
	<br><br>
	What will you name it?
	<br>
	<<textbox "_petname" "Pixel">>
	<br><br>
	<<for _sp range Tamagotchi.listSpecies()>>
		<<capture _sp>>
			<<link [["Choose " + _sp.name|Home Console Pet]]>><<run Tamagotchi.hatch(_petname, _sp.id)>><</link>>| <span class="teal">_sp.typeLabel</span> type. <i>_sp.blurb</i>
		<</capture>>
		<br>
	<</for>>
	<br>
	<<link "Turn it off" _ret>><<unset $consoleAction, $trainType>><</link>>

<<elseif not Tamagotchi.isAlive()>>
	<<set _t to Tamagotchi.status()>>
	The screen displays a small headstone. <span class="blue">_t.name</span>
	<<if _t.deathCause is "battle">>
		was struck down defending itself, and didn't survive.
	<<elseif _t.deathCause is "boss">>
		was hunted down by the blood-moon boss you never faced.
	<<elseif _t.deathCause is "abandoned">>
		was overwhelmed by an attacker you never came back to fend off.
	<<elseif _t.deathCause is "illness">>
		passed away from an untreated illness.
	<<else>>
		passed away from hunger and neglect.
	<</if>>
	<br><br>
	You feel a pang of guilt.<<stress 4>><<gstress>>
	<br><br>
	<<if _t.elixirs gt 0>>
		<span class="green">You have _t.elixirs <<= _t.elixirs is 1 ? "Elixir" : "Elixirs">> from Robin. You could use one to bring <span class="blue">_t.name</span> back.</span>
		<br>
		<<link [[Use an Elixir to revive it|Home Console Pet]]>><<run Tamagotchi.reviveWithElixir()>><</link>>
		<br><br>
	<</if>>
	<<if _t.backupAlive>>
		<span class="green">Your other pet, <span class="blue">_t.backup.name</span>, is still with you.</span>
		<br>
		<<link [[Continue with _t.backup.name|Home Console Pet]]>><<run Tamagotchi.promoteBackup()>><</link>>
		<br><br>
	<</if>>
	<<link [[Lay it to rest and start over|Home Console Pet]]>><<run Tamagotchi.bury()>><</link>>
	<br>
	<<link "Turn it off" _ret>><</link>>

<<else>>
	<<set _t to Tamagotchi.status()>>
	<<if Tamagotchi.ackWoke()>>
		<span class="green"><<= _t.name>> has woken from its nap, fully rested but ravenous, and it's left a mess.</span>
		<br>
	<</if>>
	You check in on <span class="blue">_t.name</span>.
	<<if _t.sleeping>> <span class="teal">It's fast asleep.</span><</if>>
	<<if _t.sick>> <span class="red">It looks ill.</span><</if>>
	<<if _t.poops gt 0>> There <<= _t.poops is 1 ? "is a mess" : "are messes">> on the screen that <<= _t.poops is 1 ? "needs" : "need">> cleaning.<</if>>
	<br>

	<<= Tamagotchi.statusHtml()>>

	<<if _t.pendingAttack>>
		<<if _t.bossDue>>
			<span class="red">A monstrous boss has risen under the blood moon and stalks <<= _t.name>>!
			Beat it within _t.bossDaysLeft <<= _t.bossDaysLeft is 1 ? "day" : "days">>, or it will kill your pet.</span>
		<<else>>
			<span class="red">An enemy is attacking <<= _t.name>> right now! You have to defend it!</span>
		<</if>>
		<<if _t.backupAlive>>
			<br><span class="green">Both your pets stand together! If one falls in battle, the other charges in.</span>
		<</if>>
		<br>
		<<link [[Defend your pet!|Home Console Pet Battle]]>><<run Tamagotchi.startWeeklyBattle()>><<pass 5>><</link>>
		<br><br>
		<<if _t.bossDue>>
			<<link "Turn it off (the boss will keep hunting)" _ret>><<unset $consoleAction, $trainType>><</link>>
		<<else>>
			<<link "Step away (risky)" _ret>><<unset $consoleAction, $trainType>><</link>>
		<</if>>
	<<elseif _t.sleeping>>
		<span class="teal"><<= _t.name>> is curled up asleep and can't be disturbed for about _t.sleepHoursLeft
		<<= _t.sleepHoursLeft is 1 ? "hour" : "hours">>. Come back once it's rested.</span>
		<br><br>
		<<link "Turn it off" _ret>><<unset $consoleAction, $trainType>><</link>>
	<<else>>
		<<if _t.pendingSkillChoice>>
			<span class="gold"><<= _t.name>> has trained enough to learn a new skill!</span>
			<br>
			<<link [[Choose a new skill|Home Console Pet Skill Pick]]>><</link>>
			<br><br>
		<<else>>
			<span class="small-description"><i>The next challenger will arrive in about _t.nextAttackDays
			<<= _t.nextAttackDays is 1 ? "day" : "days">>.</i></span>
			<br><br>
		<</if>>

		<<link [[Feed it (0:05)|Home Console Do]]>><<set $consoleAction to "feed">><<pass 5>><</link>>
		<br>
		<<link [[Play with it (0:15)|Home Console Do]]>><<set $consoleAction to "play">><<pass 15>><</link>>
		<br>
		<<if _t.poops gt 0>>
			<<link [[Clean up the mess (0:05)|Home Console Do]]>><<set $consoleAction to "clean">><<pass 5>><</link>>
			<br>
		<</if>>
		<<if _t.sick>>
			<<link [[Give it medicine (0:05)|Home Console Do]]>><<set $consoleAction to "cure">><<pass 5>><</link>>
			<br>
		<</if>>
		<<link [[Let it sleep|Home Console Do]]>><<set $consoleAction to "rest">><</link>>
		<br><br>
		<<set _ct to Tamagotchi.canTrain()>>
		<<if _ct.ok>>
			<<link [[Train your pet|Home Console Pet Train]]>><</link>>
		<<else>>
			<span class="grey">Train your pet</span>, <i>_ct.reason</i>
		<</if>>
		<br><br>
		<<if _t.canEvolve>>
			<span class="gold"><<= _t.name>> trembles with pent-up power.
			It could evolve, sacrificing _t.evolveCost of its skills to transform!</span>
			<br>
			<<link [[Evolve your pet|Home Console Pet Evolve]]>><</link>>
			<br><br>
		<</if>>
		<<if _t.inDungeon>>
			<<furnitureicon "controller">><<link [[Resume your dungeon run|Home Console Dungeon Walk]]>><</link>>
			<br><br>
		<<elseif _t.keys gt 0>>
			<<furnitureicon "controller">><<link [[Enter the dungeon|Home Console Dungeon Enter]]>><</link>> <i>(_t.keys <<= _t.keys is 1 ? "key" : "keys">>)</i>
			<br><br>
		<</if>>
		<<if _t.hasBackup and _t.backupAlive>>
			<span class="small-description"><i>Your other pet:
			<span class="blue">_t.backup.name</span><<if _t.backup.needsCare>>
			<span class="red">(needs care)</span><</if>>.</i></span>
			<br>
			<<link [[Switch to your other pet|Home Console Pet]]>><<run Tamagotchi.switchActive()>><</link>>
			<br><br>
		<<elseif _t.hasBackup>>
			<span class="red">Your other pet, <span class="blue">_t.backup.name</span>, has passed away.</span>
			<br>
			<<link [[Lay your other pet to rest|Home Console Pet]]>><<unset $petBackup>><</link>>
			<br><br>
		<<elseif _t.atCap>>
			<span class="gold"><<= _t.name>> has grown as strong as it possibly can and can't get any stronger.
			You could adopt a second pet to raise alongside it.</span>
			<br>
			<<link [[Adopt another pet|Home Console Pet Adopt]]>><</link>>
			<br><br>
		<</if>>
		<<getouticon>><<link "Turn it off" _ret>><<unset $consoleAction, $trainType>><</link>>
	<</if>>
<</if>>

:: Home Console Do
<<set $outside to 0>><<effects>>
<<set _ret to ($location is "alex_cottage" ? "Farm Bedroom" : "Bedroom")>>

<<set _action to $consoleAction>><<unset $consoleAction>>
<<switch _action>>
	<<case "feed">><<set _result to Tamagotchi.feed()>>
	<<case "play">><<set _result to Tamagotchi.play()>>
	<<case "clean">><<set _result to Tamagotchi.clean()>>
	<<case "cure">><<set _result to Tamagotchi.cure()>>
	<<case "rest">><<set _result to Tamagotchi.rest()>>
	<<default>><<set _result to "invalid">>
<</switch>>
<<set _t to Tamagotchi.status()>>

<<switch _result>>
	<<case "fed">>
		You feed <span class="blue">_t.name</span>. It gobbles the food down happily.
	<<case "overfed">>
		<span class="blue">_t.name</span> turns its nose up at more food. It's already full.
	<<case "played">>
		You play a quick minigame with <span class="blue">_t.name</span>. It bounces with delight.<<stress -10>><<lstress>>
	<<case "tooTired">>
		<span class="blue">_t.name</span> is too tired to play. It needs to rest first.
	<<case "cleaned">>
		You wipe the screen clean. <span class="blue">_t.name</span> looks much more comfortable.
	<<case "alreadyClean">>
		There's nothing to clean.
	<<case "sleeping">>
		You dim the screen and <span class="blue">_t.name</span> curls up to sleep. It'll nap for about 6 hours and can't be disturbed until it wakes.
	<<case "alreadyAsleep">>
		<span class="blue">_t.name</span> is already fast asleep.
	<<case "asleep">>
		<span class="blue">_t.name</span> is asleep and can't be disturbed right now.
	<<case "cured">>
		You give <span class="blue">_t.name</span> some medicine. The colour returns to its little face.
	<<case "notSick">>
		<span class="blue">_t.name</span> isn't sick.
	<<case "dead">>
		The screen is dark. There's nothing more you can do.
	<<default>>
		You fiddle with the console.
<</switch>>
<br><br>
<<link [[Back|Home Console Pet]]>><</link>>


:: Home Console Pet Train
<<set $outside to 0>><<effects>>
<<set _t to Tamagotchi.status()>>

<<set _ct to Tamagotchi.canTrain()>>
<<if not _ct.ok>>
	You can't train right now| <i>_ct.reason</i>.
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	How will you train <span class="blue">_t.name</span> today? It can train once per day.
	<br><br>
	<<for _tr range Tamagotchi.trainingTypes()>>
		<<capture _tr>>
			<<link [[_tr.name (1:30)|Home Console Pet Train Do]]>><<set $trainType to _tr.id>><<pass 90>><</link>>
		<</capture>>
		| <i>_tr.desc</i>
		<br>
	<</for>>
<</if>>
<br>

:: Home Console Pet Train Do
<<set $outside to 0>><<effects>>

<<set _trainType to $trainType>><<unset $trainType>>
<<set _r to Tamagotchi.train(_trainType)>>
<<if not _r.ok>>
	You can't train right now| <i>_r.reason</i>.
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	<<set _t to Tamagotchi.status()>>
	<<switch _r.type>>
		<<case "strength">>
			You set <span class="blue">_t.name</span> to smashing little training blocks. It huffs and puffs, and looks stronger for it.
		<<case "endurance">>
			You run <span class="blue">_t.name</span> through lap after lap. It's worn out, but its stamina is clearly growing.
		<<case "agility">>
			You guide <span class="blue">_t.name</span> through an obstacle course. It darts about, getting quicker with each run.
		<<case "defense">>
			You drill <span class="blue">_t.name</span> on bracing and blocking. It learns to stand its ground.
		<<case "focus">>
			You sit <span class="blue">_t.name</span> down to meditate. It calms, and its mind feels sharper.
		<<default>>
			<span class="blue">_t.name</span> finishes its training session.
	<</switch>>
	<<= " <span class='green'>(+" + _r.gain + " " + _r.stat + ")</span>">>
	<br><br>
	<<if _r.unlocked>>
		<span class="gold"><<= _t.name>> has trained enough to learn a new skill!</span>
		<br>
		<<link [[Choose a new skill|Home Console Pet Skill Pick]]>><</link>>
		<br>
	<</if>>
	<<link [[Back|Home Console Pet]]>><</link>>
<</if>>

:: Home Console Pet Skill Pick
<<set $outside to 0>><<effects>>
<<set _t to Tamagotchi.status()>>
<<set _offer to Tamagotchi.skillOfferList()>>

<<if _offer.length is 0>>
	There's no new skill to choose right now.
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	Choose a new skill for <span class="blue">_t.name</span>. You can pick one:
	<br><br>
	<<for _s range _offer>>
		<<capture _s>>
			<<link [[_s.name|Home Console Pet]]>><<run Tamagotchi.chooseSkill(_s.id)>><</link>>
		<</capture>>
		| <span class="teal">_s.typeLabel</span><<if _s.passive>>, passive | Revives once per battle<<elseif _s.heal>>, restores HP, _s.mp MP<<else>>, Power _s.power, _s.mp MP<</if>>
		<br>
	<</for>>
<</if>>

:: Home Console Pet Battle
<<set $outside to 0>><<effects>>
<<set _b to Tamagotchi.battleState()>>
<<set _t to Tamagotchi.status()>>

<<if _b is null>>
	The battle is over.
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	<<= Tamagotchi.battleHtml()>>

	<div class="tama-log">
	<<for _line range _b.log>>
		_line<br>
	<</for>>
	</div>

	<<if _b.over>>
		<<link [[Continue|Home Console Pet Battle Result]]>><</link>>
	<<else>>
		Your move:
		<br>
		<<link [[Attack|Home Console Pet Battle]]>><<run Tamagotchi.battleAttack()>><</link>> <i>(basic, free)</i>
		<br>
		<<link [[Guard|Home Console Pet Battle]]>><<run Tamagotchi.battleGuard()>><</link>> <i>(halve next hit, recover MP)</i>
		<br>
		<<link [[Rest|Home Console Pet Battle]]>><<run Tamagotchi.battleRest()>><</link>> <i>(recover HP &amp; MP)</i>
		<br>
		<<if _t.autoRevive and not _b.reviveUsed>>
			<span class="green"><i>Revive is ready: your pet will get back up once if it falls this battle.</i></span>
			<br>
		<</if>>
		<<for _s range Tamagotchi.battleSkills()>>
			<<capture _s>>
				<<if _b.mp gte _s.mp>>
					<<link [[_s.name|Home Console Pet Battle]]>><<run Tamagotchi.battleSkill(_s.id)>><</link>>
				<<else>>
					<span class="grey">_s.name</span>
				<</if>>
			<</capture>>
			| <span class="teal">_s.typeLabel</span><<if _s.heal>>, heal<<else>>, Pow _s.power<</if>>, _s.mp MP
			<br>
		<</for>>
	<</if>>
<</if>>

:: Home Console Pet Battle Result
<<set $outside to 0>><<effects>>
<<set _sum to Tamagotchi.endBattle()>>

<<if _sum.result is "win">>
	<<if _sum.boss>>
		Your pet vanquished the <span class="green"><<= _sum.enemy>></span> beneath the blood moon!<<stress -10>><<lllstress>>
		<br><span class="green">The monthly threat is over... until the next blood moon.</span>
	<<elseif _sum.keyGained>>
		Your pet smashed through the <span class="green"><<= _sum.enemy>></span>!<<stress -8>><<llstress>>
		<br><span class="gold">It dropped a dungeon key! You now hold <<= _sum.keys>>.</span>
	<<elseif _sum.dungeon>>
		Your pet cut down the <span class="green"><<= _sum.enemy>></span> deeper in the dungeon.<<stress -4>><<lstress>>
	<<else>>
		Your pet drove off the wild <span class="green"><<= _sum.enemy>></span>!<<stress -8>><<llstress>>
		<br><span class="green">It's survived another week. The next challenger will be tougher.</span>
	<</if>>
	<<if _sum.teammateRevived>>
		<br><span class="green">Your fallen teammate is helped back to its feet, exhausted but alive.</span>
	<</if>>
	<<if _sum.statBoost>>
		<br>
		<span class="gold">Victory has made it stronger!
		<<= "(+" + _sum.hpBoost + " max HP, +" + _sum.statBoost + " to ATK, DEF, SPD and max MP)">></span>
	<</if>>
	<<if _sum.capped>>
		<br><span class="gold">It has reached its limits and can grow no further.</span>
	<</if>>
<<elseif _sum.result is "lose">>
	Your pet fought bravely, but the <span class="purple"><<= _sum.enemy>></span> was too strong. <span class="red">It didn't survive.</span><<stress 6>><<gstress>>
<<else>>
	The battle ends.
<</if>>
<br><br>
<<if _sum.dungeon and _sum.result is "win">>
	<<run Tamagotchi.dungeonMobCleared()>>
	<<link [[Press on|Home Console Dungeon Walk]]>><</link>>
<<else>>
	<<if _sum.dungeon>><<run Tamagotchi.dungeonEnd()>><</if>>
	<<link [[Back|Home Console Pet]]>><</link>>
<</if>>

:: Home Console Pet Evolve
<<set $outside to 0>><<effects>>
<<set _t to Tamagotchi.status()>>
<<if $evoPick is undefined>><<set $evoPick to []>><</if>>
<<if not _t.canEvolve>>
	<<= _t.name>> can't evolve right now.
	<<unset $evoPick>>
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	The screen glows as <span class="blue">_t.name</span> stands ready to evolve. The transformation multiplies every stat tenfold, but you must <span class="red">choose _t.evolveCost of its skills to sacrifice</span> in the ritual.
	<br><br>
	<span class="gold"><<= $evoPick.length>> / _t.evolveCost selected.</span>
	<br>
	<<for _s range Tamagotchi.learnedSkills()>>
		<<capture _s>>
			<<if $evoPick.includes(_s.id)>>
				<<link [[(x) _s.name|Home Console Pet Evolve]]>><<set $evoPick to $evoPick.filter(id => id !== _s.id)>><</link>> <span class="red">to be sacrificed</span>
			<<elseif $evoPick.length lt _t.evolveCost>>
				<<link [[( ) _s.name|Home Console Pet Evolve]]>><<run $evoPick.push(_s.id)>><</link>>
			<<else>>
				<span class="grey">( ) _s.name</span>
			<</if>>
			| <span class="teal">_s.typeLabel</span><<if _s.passive>>, passive<<elseif _s.heal>>, heal<<else>>, Pow _s.power<</if>>
		<</capture>>
		<br>
	<</for>>
	<br>
	<<if $evoPick.length is _t.evolveCost>>
		<<link [[Evolve!|Home Console Pet Evolve Do]]>><</link>>
	<<else>>
		<span class="grey">Select exactly _t.evolveCost skills to evolve.</span>
	<</if>>
	<br>
	<<link [[Cancel|Home Console Pet]]>><<unset $evoPick>><</link>>
<</if>>

:: Home Console Pet Evolve Do
<<set $outside to 0>><<effects>>
<<set _evo to Tamagotchi.evolve($evoPick)>>
<<unset $evoPick>>
<<set _t to Tamagotchi.status()>>

<<if not _evo or not _evo.ok>>
	Nothing happens.
<<else>>
	You sacrifice <span class="red"><<= _evo.sacrificed.join(", ")>></span>.
	<br>

	Light floods the little screen. When it fades, <span class="blue">_t.name</span>
	has evolved from <span class="teal"><<= _evo.from>></span> into <span class="gold"><<= _evo.to>></span>!
	<<stress -10>><<lllstress>>
	<br><br>
	<<= Tamagotchi.statusHtml()>>
	<<if _evo.capped>>
		<br><span class="gold"><<= _t.name>> is already as strong as it can ever be.</span>
	<</if>>
<</if>>
<br><br>
<<link [[Back|Home Console Pet]]>><</link>>

:: Home Console Pet Adopt
<<set $outside to 0>><<effects>>
<<set _t to Tamagotchi.status()>>
<<if _t.hasBackup or not _t.atCap>>
	You can't adopt another pet right now.
	<br><br>
	<<link [[Back|Home Console Pet]]>><</link>>
<<else>>
	A second egg appears on the screen, ready to hatch alongside <span class="blue">_t.name</span>. It won't be the same kind as <span class="blue">_t.name</span>. What will you name it?
	<br>
	<<textbox "_petname" "Pixel">>
	<br><br>
	<<for _sp range Tamagotchi.adoptableSpecies()>>
		<<capture _sp>>
			<<link [["Choose " + _sp.name|Home Console Pet]]>><<run Tamagotchi.adopt(_petname, _sp.id)>><</link>>|
			<span class="teal">_sp.typeLabel</span> type. <i>_sp.blurb</i>
		<</capture>>
		<br>
	<</for>>
	<br>
	<<link [[Back|Home Console Pet]]>><</link>>
<</if>>
