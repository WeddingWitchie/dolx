:: Dye Harder Settings Widgets [widget]

<<widget "dhmCfgDoll">>
	<<switch _args[0]>>
		<<case "saved">>
			<<set _hairopt to "tmp0">>
		<<case "tmp">>
			<<set _hairopt to "tmp1">>
		<<default>>
			<<set _hairopt to "tmp0">>
	<</switch>>

	<div class="mannequin-inner" @style="'transform: translateX('+ $dhmod.movedoll + 'px);'">
		<<selectmodel "main" "preset1">>
		<<set _modeloptions.tanningEnabled to false>>
		<<set _modeloptions.mannequin to true>>
		<<set _modeloptions.hair_colour to _hairopt>>
		<<set _modeloptions.hair_fringe_colour to _hairopt>>
		<<set _modeloptions.show_face to false>>
		<<rendermodel "canvas-mannequin">>
	</div>
<</widget>>

<<widget "dhmCfgDollUpdate">>
	<<if _args[0] isnot undefined>>
		<<set _id to _args[0]>>
	<<else>>
		<<set _id to "saved">>
	<</if>>

	<<replace `'#presetman-mannequin-' + _id`>><<dhmCfgDoll _id>><</replace>>
<</widget>>

<!--
-- options
-- stolen —- i mean, borrowed from clothing store
-- game/overworld-town/loc-shop/clothing-v2.twee 
