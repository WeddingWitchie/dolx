:: Dye Harder Startup [widget]
<<widget "dhmInit">>
	<<run window.dhmUtils.dhmStateFixup()>>

	<<if $dhmod.version is undefined>>
		<<set $dhmod.version to 0.20>>
		<<run window.dhmUtils.versionUpdate()>>
	<</if>>

	<<if $dhmod.cfg is undefined>>
		<<set $dhmod.cfg to {}>>
	<</if>>

	<<if $dhmod.cfg.ui is undefined>>
		<<set $dhmod.cfg.ui to true>>
	<</if>>

	<<if $dhmod.cfg.prices is undefined>>
		<<set $dhmod.cfg.prices to true>>
	<</if>>

	<<if $dhmod.cfg.overwrite is undefined>>
		<<set $dhmod.cfg.overwrite to false>>
	<</if>>

	<<if $dhmod.hair is undefined>>
		<<set $dhmod.hair to { colors: [], is_custom: false }>>
	<</if>>

	<<if $dhmod.fringe is undefined>>
		<<set $dhmod.fringe to { colors: [], is_custom: false }>>
	<</if>>

	<<if $dhmod.userPresets is undefined>>
		<<set $dhmod.userPresets to {}>>
	<</if>>

	<<if $dhmod.movedoll is undefined>>
		<<if $ccmod isnot undefined and $ccmod.movedoll isnot undefined>>
			<<set $dhmod.movedoll to $ccmod.movedoll>>
		<<else>>
			<<set $dhmod.movedoll to -75>>
		<</if>>
	<</if>>

	<<run window.dhmUtils.colorMapGen()>>
	<<run window.dhmUtils.colorCache()>>
<</widget>>