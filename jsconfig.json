{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Node",
		"target": "ES2021",
		"lib": ["ES2021", "DOM"],
		"jsx": "react",
		"allowImportingTsExtensions": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"allowJs": true
	},
	"exclude": ["node_modules", "**/node_modules/*"]
}
